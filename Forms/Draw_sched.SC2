	ENDPROC

	PROCEDURE save_log
		*ThisForm.Save_Log()
		PRIVATE cMachine, nLot
		cMachine	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Machine',10)
		nLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'Lot',-3)
		*ThisForm.txtAng1.Value	= PrepareSQLnum(tmp_DS.Ang1,'Ang',-1)
		PRIVATE nStartDia, nDia1, nDia2, nDia3, nDia4, nDia5, nDia6, nDia7, nDia8, nDia9
		nStartDia = PrepareSQLnum(ThisForm.txtStartDia.Value,'StartDia',4,3)
		nDia1 = PrepareSQLnum(ThisForm.txtDia1.Value,'Dia',4,3)
		nDia2 = PrepareSQLnum(ThisForm.txtDia2.Value,'Dia',4,3)
		nDia3 = PrepareSQLnum(ThisForm.txtDia3.Value,'Dia',4,3)
		nDia4 = PrepareSQLnum(ThisForm.txtDia4.Value,'Dia',4,3)
		nDia5 = PrepareSQLnum(ThisForm.txtDia5.Value,'Dia',4,3)
		nDia6 = PrepareSQLnum(ThisForm.txtDia6.Value,'Dia',4,3)
		nDia7 = PrepareSQLnum(ThisForm.txtDia7.Value,'Dia',4,3)
		nDia8 = PrepareSQLnum(ThisForm.txtDia8.Value,'Dia',4,3)
		nDia9 = PrepareSQLnum(ThisForm.txtDia9.Value,'Dia',4,3)
		
		PRIVATE nAng1, nAng2, nAng3, nAng4, nAng5, nAng6, nAng7, nAng8, nAng9
		nAng1 = PrepareSQLnum(ThisForm.txtAng1.Value,'Angle',-1)
		nAng2 = PrepareSQLnum(ThisForm.txtAng2.Value,'Angle',-1)
		nAng3 = PrepareSQLnum(ThisForm.txtAng3.Value,'Angle',-1)
		nAng4 = PrepareSQLnum(ThisForm.txtAng4.Value,'Angle',-1)
		nAng5 = PrepareSQLnum(ThisForm.txtAng5.Value,'Angle',-1)
		nAng6 = PrepareSQLnum(ThisForm.txtAng6.Value,'Angle',-1)
		nAng7 = PrepareSQLnum(ThisForm.txtAng7.Value,'Angle',-1)
		nAng8 = PrepareSQLnum(ThisForm.txtAng8.Value,'Angle',-1)
		nAng9 = PrepareSQLnum(ThisForm.txtAng9.Value,'Angle',-1)
		
		
		PRIVATE nCW1, nCW2, nCW3, nCW4, nCW5, nCW6, nCW7, nCW8, nCW9
		nCW1 = PrepareSQLnum(ThisForm.txtCW1.Value,'CW',3,1)
		nCW2 = PrepareSQLnum(ThisForm.txtCW2.Value,'CW',3,1)
		nCW3 = PrepareSQLnum(ThisForm.txtCW3.Value,'CW',3,1)
		nCW4 = PrepareSQLnum(ThisForm.txtCW4.Value,'CW',3,1)
		nCW5 = PrepareSQLnum(ThisForm.txtCW5.Value,'CW',3,1)
		nCW6 = PrepareSQLnum(ThisForm.txtCW6.Value,'CW',3,1)
		nCW7 = PrepareSQLnum(ThisForm.txtCW7.Value,'CW',3,1)
		nCW8 = PrepareSQLnum(ThisForm.txtCW8.Value,'CW',3,1)
		nCW9 = PrepareSQLnum(ThisForm.txtCW9.Value,'CW',3,1)
		
		PRIVATE lbAnn1, lbAnn2, lbAnn3, lbAnn4, lbAnn5, lbAnn6, lbAnn7, lbAnn8, lbAnn9
		lbAnn1 = PrepareSQLchk(ThisForm.chkAnn1.Value,'Check')
		lbAnn2 = PrepareSQLchk(ThisForm.chkAnn2.Value,'Check')
		lbAnn3 = PrepareSQLchk(ThisForm.chkAnn3.Value,'Check')
		lbAnn4 = PrepareSQLchk(ThisForm.chkAnn4.Value,'Check')
		lbAnn5 = PrepareSQLchk(ThisForm.chkAnn5.Value,'Check')
		lbAnn6 = PrepareSQLchk(ThisForm.chkAnn6.Value,'Check')
		lbAnn7 = PrepareSQLchk(ThisForm.chkAnn7.Value,'Check')
		lbAnn8 = PrepareSQLchk(ThisForm.chkAnn8.Value,'Check')
		lbAnn9 = PrepareSQLchk(ThisForm.chkAnn9.Value,'Check')
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = ''
		
		IF ThisForm.IsAdding
			*INSERT
			
			IF USED("tmp_INS_DS")
				USE IN tmp_INS_DS
			ENDIF
			SELECT 0
			
			nID = -1	  &&GO TOP
			 
			cSQL = "INSERT INTO dbo.Draw_Sched "
			cSQL = cSQL + "(Machine, Lot, [StartDia],[Dia1],[CW1],[Ann1],[Ang1]"
		   	cSQL = cSQL + ",[Dia2],[CW2],[Ann2],[Ang2]"
		   	cSQL = cSQL + ",[Dia3],[CW3],[Ann3],[Ang3]"
		    cSQL = cSQL + ",[Dia4],[CW4],[Ann4],[Ang4]"
		    cSQL = cSQL + ",[Dia5],[CW5],[Ann5],[Ang5]"
		    cSQL = cSQL + ",[Dia6],[CW6],[Ann6],[Ang6]"
		    cSQL = cSQL + ",[Dia7],[CW7],[Ann7],[Ang7]"
		    cSQL = cSQL + ",[Dia8],[CW8],[Ann8],[Ang8]"
		    cSQL = cSQL + ",[Dia9],[CW9],[Ann9],[Ang9]"
			cSQL = cSQL + ") VALUES ("
		
			cSQL = cSQL + " '"+cMachine+"'"
			cSQL = cSQL + ","+STR(nLot)
			      
			cSQL = cSQL + ","+STR(nStartDia,6,3)   
			cSQL = cSQL + ","+STR(nDia1,6,3)+","+STR(nCW1,4,1)+","+IIF(lbAnn1,"1","0")+","+STR(nAng1)
			cSQL = cSQL + ","+STR(nDia2,6,3)+","+STR(nCW2,4,1)+","+IIF(lbAnn2,"1","0")+","+STR(nAng2)
			cSQL = cSQL + ","+STR(nDia3,6,3)+","+STR(nCW3,4,1)+","+IIF(lbAnn3,"1","0")+","+STR(nAng3)
			cSQL = cSQL + ","+STR(nDia4,6,3)+","+STR(nCW4,4,1)+","+IIF(lbAnn4,"1","0")+","+STR(nAng4)
			cSQL = cSQL + ","+STR(nDia5,6,3)+","+STR(nCW5,4,1)+","+IIF(lbAnn5,"1","0")+","+STR(nAng5)
			cSQL = cSQL + ","+STR(nDia6,6,3)+","+STR(nCW6,4,1)+","+IIF(lbAnn6,"1","0")+","+STR(nAng6)
			cSQL = cSQL + ","+STR(nDia7,6,3)+","+STR(nCW7,4,1)+","+IIF(lbAnn7,"1","0")+","+STR(nAng7)
			cSQL = cSQL + ","+STR(nDia8,6,3)+","+STR(nCW8,4,1)+","+IIF(lbAnn8,"1","0")+","+STR(nAng8)
			cSQL = cSQL + ","+STR(nDia9,6,3)+","+STR(nCW9,4,1)+","+IIF(lbAnn9,"1","0")+","+STR(nAng9)
		
			cSQL = cSQL + "); "	
			cSQL = cSQL + " SELECT @@IDENTITY AS nIDENTITY; "
		*	
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_INS_DS" )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, "tmp_INS_DS" )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_INS_DS")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_INS_DS")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				IF USED("tmp_INS_DS")
					nID = PrepareSQLnum(tmp_INS_DS.nIDENTITY,'ID',-3)
					ThisForm.nSched_ID = nID 
					USE IN tmp_INS_DS
				ENDIF		
				ThisForm.IsAdding = .F.
				ThisForm.IsEditing = .F.
				
				WAIT WINDOW 'Saved!' NOWAIT
				
				ThisForm.cmdAdd.Visible = .T.
				ThisForm.cmdAddCopy.Visible = .T.
				ThisForm.cmdSave.Visible = .F.
				ThisForm.cmdSaveCopy.Visible = .F.
				ThisForm.cmdPrint.Visible = .T.
				ThisForm.cmdReturn.Enabled = .T.
				
				ThisForm.cmdEdit.Caption = 'Edit'
						
				ThisForm.Load_Log(nID)
			ENDIF
		
		ELSE
			*Update
			nID = PrepareSQLnum(tmp_DS.ID,'ID',-3)
			
			cSQL = "UPDATE dbo.Draw_Sched SET "
			
			cSQL = cSQL + " [Machine]= '"+cMachine+"'"
			cSQL = cSQL + ",[Lot]="+STR(nLot)
			cSQL = cSQL + ",[StartDia]="+STR(nStartDia,6,3) 
			
			cSQL = cSQL + ",[Dia1]="+STR(nDia1,6,3)
			cSQL = cSQL + ",[CW1]="+STR(nCW1,4,1)
			cSQL = cSQL + ",[Ann1]="+IIF(lbAnn1,'1','0')
			cSQL = cSQL + ",[Ang1]="+STR(nAng1)
			
		   	cSQL = cSQL + ",[Dia2]="+STR(nDia2,6,3)
		   	cSQL = cSQL + ",[CW2]="+STR(nCW2,4,1)
		   	cSQL = cSQL + ",[Ann2]="+IIF(lbAnn2,"1","0")
		   	cSQL = cSQL + ",[Ang2]="+STR(nAng2)
		   	
		   	cSQL = cSQL + ",[Dia3]="+STR(nDia3,6,3)
		   	cSQL = cSQL + ",[CW3]="+STR(nCW3,4,1)
		   	cSQL = cSQL + ",[Ann3]="+IIF(lbAnn3,"1","0")
		   	cSQL = cSQL + ",[Ang3]="+STR(nAng3)
		   	
		    cSQL = cSQL + ",[Dia4]="+STR(nDia4,6,3)
		    cSQL = cSQL + ",[CW4]="+STR(nCW4,4,1)
		    cSQL = cSQL + ",[Ann4]="+IIF(lbAnn4,"1","0")
			cSQL = cSQL + ",[Ang4]="+STR(nAng4)
			
		    cSQL = cSQL + ",[Dia5]="+STR(nDia5,6,3)
		    cSQL = cSQL + ",[CW5]="+STR(nCW5,4,1)
		    cSQL = cSQL + ",[Ann5]="+IIF(lbAnn5,"1","0")
		    cSQL = cSQL + ",[Ang5]="+STR(nAng5)
		    
		    cSQL = cSQL + ",[Dia6]="+STR(nDia6,6,3)
		    cSQL = cSQL + ",[CW6]="+STR(nCW6,4,1)
		    cSQL = cSQL + ",[Ann6]="+IIF(lbAnn6,"1","0")
		    cSQL = cSQL + ",[Ang6]="+STR(nAng6)
		    
		    cSQL = cSQL + ",[Dia7]="+STR(nDia7,6,3)
		    cSQL = cSQL + ",[CW7]="+STR(nCW7,4,1)
		    cSQL = cSQL + ",[Ann7]="+IIF(lbAnn7,"1","0")
		    cSQL = cSQL + ",[Ang7]="+STR(nAng7)
		    
		    cSQL = cSQL + ",[Dia8]="+STR(nDia8,6,3)
		    cSQL = cSQL + ",[CW8]="+STR(nCW8,4,1)
		    cSQL = cSQL + ",[Ann8]="+IIF(lbAnn8,"1","0")
		    cSQL = cSQL + ",[Ang8]="+STR(nAng8)
		    
		    cSQL = cSQL + ",[Dia9]="+STR(nDia9,6,3)
		    cSQL = cSQL + ",[CW9]="+STR(nCW9,4,1)
		    cSQL = cSQL + ",[Ann9]="+IIF(lbAnn9,"1","0")
		    cSQL = cSQL + ",[Ang9]="+STR(nAng9)
		    
			cSQL = cSQL + " WHERE ID= "+STR(nID)			
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "" )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, "" )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				ThisForm.IsAdding = .F.
				ThisForm.IsEditing = .F.
				
				WAIT WINDOW 'Saved!' NOWAIT		
						
				ThisForm.cmdAdd.Visible = .T.
				ThisForm.cmdAddCopy.Visible = .T.
				ThisForm.cmdSave.Visible = .F.
				ThisForm.cmdSaveCopy.Visible = .F.
				ThisForm.cmdPrint.Visible = .T.
				ThisForm.cmdReturn.Enabled = .T.
				
				ThisForm.cmdEdit.Caption = 'Edit'
				
				ThisForm.nSched_ID = nID
				ThisForm.Load_Log(nID)
		
			ENDIF		
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle)
		
		RETURN ThisForm.nSched_ID
	ENDPROC

	PROCEDURE Check10.Valid
		ThisForm.AddRow(1)
		This.Value = This.Value - 1
		
	ENDPROC

	PROCEDURE Check10.When
		RETURN ThisForm.IsEditing
	ENDPROC

	PROCEDURE Check11.Valid
		ThisForm.RemoveRow(2)
		
	ENDPROC

	PROCEDURE Check11.When
		RETURN ThisForm.IsEditing
	ENDPROC

	PROCEDURE Check12.Valid
		ThisForm.RemoveRow(3)
		
	ENDPROC

	PROCEDURE Check12.When
		RETURN ThisForm.IsEditing
	ENDPROC

	PROCEDURE Check13.Valid
		ThisForm.RemoveRow(4)
		
	ENDPROC

	PROCEDURE Check13.When
		RETURN ThisForm.IsEditing
	ENDPROC

	PROCEDURE Check14.Valid
		ThisForm.RemoveRow(5)
		
	ENDPROC

	PROCEDURE Check14.When
