	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			**GetMachine_Init GetMachine_Caption GetMachine_LogList GetMachine_Log Get_ID_Mach_Lot
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		IF NOT "PROC_DRAW" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Draw ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE load_log
		PARAMETERS pID
		*ThisForm.Load_Log()
		
		IF VARTYPE(pID)!="N"
			pID = 0
		ENDIF
		
		
		*ThisForm.Load_Log()
		IF USED('tmp_DS')	
			ThisForm.grd_DS.RecordSource = ''
			
			USE IN tmp_DS
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Draw_Sched "
		*" WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_DS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_DS')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_DS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_DS")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmp_DS')
			RETURN .F.
		ELSE
			SELECT tmp_DS
			
		*	INDEX ON LOT TAG LOT
		*	SET ORDER TO TAG LOT
		*	ThisForm.lSeeAll = .F.
			ThisForm.grd_DS.RecordSource = 'tmp_DS'
		ENDIF
		
		IF pID = 0
			GO TOP
		ELSE
			IF pID = -1
				GO BOTTOM
			ELSE
				LOCATE FOR ID = pID
			ENDIF
		ENDIF
		
		*ThisForm.grd_DS.Refresh()
		ThisForm.Refresh_Log()
	ENDPROC

