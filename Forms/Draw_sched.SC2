	PROCEDURE removerow
		PARAMETERS nCurrRow
		*ThisForm.RemoveRow()
		PRIVATE nUpSide
		nUpSide = 10 - nCurrRow
		
		IF nCurrRow = 1
			ThisForm.txtDia1.Value	= PrepareSQLnum(ThisForm.txtDia2.Value,'Dia',5,3)
			ThisForm.txtCW1.Value	= PrepareSQLnum(ThisForm.txtCW2.Value,'CW',3,1)
