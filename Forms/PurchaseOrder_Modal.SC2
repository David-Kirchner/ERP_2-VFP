	*<DefinedPropArrayMethod>
		*m: addressscreen
		*m: deletecontactid
		*m: editpo		&& EditPO
		*m: editposcreen		&& 0 for No, 1 for Yes
		*m: formsrefresh
		*m: getpurchaseorders
		*m: getvendorcontacts
		*m: receivepo		&& ReceivePO( purchaseorders.poitem )
		*m: refreshedittab
		*m: refreshforms		&& Refresh fields when Form changes.
		*m: refreshstocklsttab
		*m: refresh_gawo_detail
		*m: reloadpurchaseorder
		*m: showduenotes
		*m: showwo		&& Makes WO or WOD fields Visible.
		*m: showwod		&& Makes WO or WOD fields Visible.
		*m: showwo_wodetail
		*m: showwo_wod_window		&& Displays WO and WO_Detail atached to PO,  Inivisble if not needed.
		*m: stocklstdetail
		*m: stocklstmaster
		*p: allrecordsretrieved
		*p: cc		&& Condition Code
		*p: cl		&& Condition Level
		*p: contactid
		*p: findtext
		*p: icompany		&& Inital Company for Interactive Search
		*p: itemnumber		&& Used by EditSalesOrder
		*p: ncmbfind
		*p: nconnhandle
		*p: newpo		&& GetPO.click Sets NewPO = .T.,When saveing make sure it is still Available to save PO num.
		*p: oledate		&& Date holder for OleCalendar
		*p: poeditmode		&& Combined EditMode and POediting
		*p: salesnum		&& Used by EditSalesOrder
		*p: soitemtot		&& Used in frmPO
		*p: stocklstmasterid
		*p: updatecustid		&& used in cmdEditAddr
		*p: vendcode
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoRelease = .T.
		cc = ''
		cl = ''
		DataSession = 2
		Icon = graphics\earth-globe.ico
		itemnumber = 0
		Name = "PurchaseOrder"
		salesnum = 0
		soitemtot = 0
		WindowType = 1
	*</PropValue>

