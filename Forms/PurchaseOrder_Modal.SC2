	PROCEDURE frmWO.txtFPOitem.Click
		*!*	PRIVATE cPOitem, nHPAPO
		*!*	cPOitem = ThisForm.txtPOitem.Value
		*!*	IF Proper_PO_item(cPOitem) = Proper_PO_item("")
		*!*		RETURN .F.
		*!*	ENDIF
		*!*	nHPAPO = VAL(cPOitem)
		
		*!*	DO FORM forms\purchaseorder26.scx WITH nHPAPO 
		*!*	RETURN
		
		
		
		
		*!*	*Set cPOitem
		*!*	PRIVATE cSQL, nSQLEXEC
		
		*!*		**INIT first POitem
		*!*		IF USED('tmpPoItemDetail')
		*!*			USE IN tmpPoItemDetail
		*!*		ENDIF
		*!*		SELECT 0
		*!*		
		*!*		cSQL = "SELECT PoItem FROM dbo.PurchaseOrder "
		*!*		cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		*!*		
		*!*		*cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+SalesQuote.SoItem_A+"')"
		*!*		*cSQL = cSQL + " OR ( SalesNum = "+STR(SalesQuote.SalesNum_A)
		*!*		*cSQL = cSQL + " AND Item="+ALLTRIM(STR(SalesQuote.Item_A))+")"
		*!*		cSQL = cSQL + " ORDER BY PoItem DESC " 
		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail' )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
