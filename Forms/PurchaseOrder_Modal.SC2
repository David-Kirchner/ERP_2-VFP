	PROCEDURE frmPOMaint.cmdView.cmdPastDue.Click
		PRIVATE currec1
		WAIT WINDOW 'Please wait while selecting records.' NOWAIT
		SELECT PurchaseOrder
		currec1 = RECNO()
		
		
		REPORT FORM reports\POLate PREVIEW FOR !PurchaseOrder.Delivered AND !PurchaseOrder.Services ;
			AND TTOD(GetLatestDate( PurchaseOrder.due_min, PurchaseOrder.due_max )) < DATE();
			AND !EMPTY(PurchaseOrder.OrderDate) AND (!PurchaseOrder.Cancelled OR ISNULL(PurchaseOrder.Cancelled))
			
		** If no shipdate entered and the due date is present
		** and duedate is past (less than) todays date
		** and Not Cancelled AND NOT DELETED()
		IF currec1 > 0 AND currec1 < RECCOUNT()
			GOTO (currec1)
		ENDIF
		
	ENDPROC

