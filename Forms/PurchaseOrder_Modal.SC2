	PROCEDURE frmPOMaint.pf1.pgStockLst.cmdInventory.Click
		IF NOT USED('tmpStockLst_Master')
			RETURN .f.
		ENDIF
		
		IF NOT EMPTY(tmpStockLst_Master.ID)
			nSalesNum = 0
			cSOitem =''
			cHeatLot = ALLTRIM(PrepareSQLtxt(tmpStockLst_Master.Heat,'Heat',50))
			*tmpStockLst_Master.TBL
			ThisForm.AlwaysOnTop = .F.
			DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",tmpStockLst_Master.TBL,tmpStockLst_Master.Alloy, tmpStockLst_Master.Form,tmpStockLst_Master.CC,tmpStockLst_Master.CL;
				,tmpStockLst_Master.Size,tmpStockLst_Detail.Dim2,tmpStockLst_Detail.Dim3,cSOitem,nSalesNum	,tmpStockLst_Detail.PC;
				,tmpStockLst_Master.MWeight,cHeatLot,tmpStockLst_Detail.S_QTY,tmpStockLst_Detail.RandLen,tmpStockLst_Master.PO_item
			ThisForm.AlwaysOnTop = .T.
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgStockLst.cmdMasterDelete.Click
		PRIVATE cSQL_Delete, cSQL, nSQLEXEC
		PRIVATE nNextID,nID,lCancel
		nNextID = 0
		nID = tmpStockLst_Master.ID
		lCancel = PrepareSQLlogic(This.parent.lblCancel.Visible,'Cancel')
		
		IF MESSAGEBOX("Are you sure you want to 'Delete'? "+CHR(13)+"Delete Detail first.",4+32,"Delete")= 7	
			RETURN
		ENDIF
		
		
		IF NOT EOF('tmpStockLst_Master')
			SELECT tmpStockLst_Master
			
			SKIP 1 IN tmpStockLst_Master
			nNextID = tmpStockLst_Master.ID
			SKIP -1 IN tmpStockLst_Master
		ENDIF
				
		IF EMPTY(tmpStockLst_Master.ID)
			MESSAGEBOX("Cannot Delete",0,"No record")
			RETURN
		ENDIF
		
		IF USED('tmpCountDetail')
			USE IN tmpCountDetail
		ENDIF
		
		IF tmpStockLst_Master.TBL = "S"
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Detail WHERE ID = "+ STR(nID)
		ELSE
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.BrokerLst_Detail WHERE ID = "+ STR(nID)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountDetail' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountDetail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountDetail')
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
			RETURN .F.
		ENDIF
						
		IF tmpCountDetail.cnt > 1
			MESSAGEBOX("Found "+ALLTRIM(STR( tmpCountDetail.cnt ))+" Detail records that belong to this Master."+CHR(13)+"Please remove details first!"+CHR(13)+"Not Allowed to delete a master when it has many details.",0+16,"Cannot Delete")
			
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
		
		ELSE
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
		
			PRIVATE cReason
			cReason = ""
			ThisForm.AlwaysOnTop = .F.
			DO FORM Forms\AnswerForm WITH "Why do you want to Delete?","PO Cancelled", 100 TO cReason
			ThisForm.AlwaysOnTop = .T.
			
			IF TYPE("cReason") = "C"
				cReason = ALLTRIM(cReason)
			ELSE
				cReason = ""
			ENDIF
			
			IF Remove_Lst_ID(tmpStockLst_Master.TBL,tmpStockLst_Master.ID,ThisFormSet.nConnHandle,.T.,'',cReason) &&Proc_ERP
				ThisFormSet.RefreshStockLstTAB()
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgStockLst.cmdReceiveStock.Click
		ThisFormSet.frmPOMaint.Visible = .F.
		ThisFormSet.ReceivePO( PurchaseOrder.poitem ) 
