	PROCEDURE frmPOMaint.cmdEdit.Click
		
		*ThisFormSet.POeditMode = .T.
		
		*ThisFormSet.AddressScreen("DISABLE")
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,'POitem',12)
		IF cPOitem != Proper_PO_item('')
			ThisFormSet.EditPO(PurchaseOrder.POitem)
			ThisFormSet.frmPO.pgfPO.ActivePage = 1
		ELSE
			MESSAGEBOX("Empty POitem",48,"Cannot Edit")
		ENDIF
		
	ENDPROC

	PROCEDURE frmPOMaint.cmdEdit.When
		*RETURN !ThisFormSet.POeditMode
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			RETURN !ThisFormSet.frmPO.POEditing
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.cmdPrintPO.Click
		PRIVATE nRecNo
		SELECT PurchaseOrder
		nRecNo = RECNO('PurchaseOrder')
		
		**Get POShipAddr **
		PRIVATE nPOShipAddr
		nPOShipAddr = PrepareSQLnum(PurchaseOrder.POShipAddr,'POShipAddr',-3)
		IF EMPTY(nPOShipAddr)
			MESSAGEBOX("Please Enter a 'Ship To Address'."+CHR(13)+"Please remember to add the address.",0,"")
			RETURN .F.
		ENDIF
		
		**Get VendorContact **
		PRIVATE nContactID
		nContactID = PrepareSQLnum(PurchaseOrder.ContactID,'ContactID',-3)
		IF NOT SelectVendorContact(nContactID,ThisFormSet.nConnHandle)
			MESSAGEBOX("Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),16,"Cannot proceed")
			TrackError("Error","Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),"PurchaseOrder:cmdPrintPO.Click",LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE nHpaPo,lClosePO
		nHpaPo = PrepareSQLnum(PurchaseOrder.HpaPo,'HPAPO',-3)
		lClosePO = .F.
		
		***************************
		***************************
		IF nHpaPo > 0
		
			MESSAGEBOX("You will be asked to Print/Preview twice"+CHR(13)+"and then asked to Email this PDF."+CHR(13)+CHR(13)+"PO: '"+ALLTRIM(STR(nHPAPO))+CHR(13)+"Use the Print in the Previw window."+CHR(13)+"Click the door to Exit the preview window.",0+32,"Any key to continue.") 
			
			ThisFormSet.VISIBLE = .F.
			ThisFormSet.frmPO.PrintPO(nHpaPo,lClosePO)
			ThisFormSet.VISIBLE = .T.
			
		ENDIF
		
		IF nRecNo <> RECNO('PurchaseOrder')
			SELECT PurchaseOrder
			GOTO (nRecNo)
		ENDIF
		
		RETURN
		***************************
		***************************
		
		
		*!*	PRIVATE lPrintSheetPk, lPrintEvenCancelled
		*!*	lPrintSheetPk = .F.
		*!*	lPrintEvenCancelled = .T.
		
		*!*	PRIVATE nPOShipAddr
		*!*	nPOShipAddr = PrepareSQLnum(PurchaseOrder.POShipAddr,'POShipAddr',-3)
		
		*!*	IF EMPTY(nPOShipAddr)
		*!*		MESSAGEBOX("Please Enter a 'Ship To Address'."+CHR(13)+"Please remember to add the address.",0,"")
		*!*	ENDIF
		
		*!*	PRIVATE cSafety
		*!*	cSafety = SET('SAFETY')
		*!*	SET SAFETY OFF
		*!*	SELECT PurchaseOrder
		*!*	SET ORDER TO VALPOitem
		*!*	SET SAFETY &cSafety
		
		*!*	PRIVATE nSalesNum
		*!*	nSalesNum= PrepareSQLnum(PurchaseOrder.SalesNum,'SalesNum',-3)
		*!*	IF TYPE("nSalesNum") != "N"
		*!*		nSalesNum = 0
		*!*	ENDIF
		
		*!*	PRIVATE nContactID
		*!*	nContactID = PrepareSQLnum(PurchaseOrder.ContactID,'ContactID',-3)
		
		*!*	PRIVATE nCntPOitem 
		*!*	nCntPOitem = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle, 'Cancelled' )
		
		*!*	IF nCntPOitem > 0
		*!*		IF MESSAGEBOX("Do you want the Cancelled item"+IIF(nCntPOitem>1,"'s",'')+" to be printed ?",4+32,"Found Cancelled item"+IIF(nCntPOitem>1,"'s",'')+" in this PO")= 6
		*!*			lPrintEvenCancelled = .T.
		*!*		ELSE
		*!*			lPrintEvenCancelled = .F.
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle, 'Sheet_PK' ) > 0
		*!*		lPrintSheetPk = .T.
		*!*	ENDIF
		
		
		*!*	SELECT PurchaseOrder
		*!*	PRIVATE cSalesP
		*!*	cSalesP = PrepareSQLtxt(PurchaseOrder.SalesP,'SalesP',1)
		*!*			
		*!*	PRIVATE lFoundVendor
		*!*	lFoundVendor = SelectVendor(PurchaseOrder.VendCode, PurchaseOrder.Company, ThisFormSet.nConnHandle)
		
		*!*	PRIVATE cSQL, nSQLEXEC
		*!*	**Get ShipAddr **
		*!*	IF USED('ShipAddr')
		*!*		USE IN ShipAddr
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT * FROM dbo.ShipAddr "
		*!*	IF nPOShipAddr < 1
		*!*		cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0"
		*!*	ELSE
		*!*		cSQL = cSQL + " WHERE ShipCode = "+STR(nPOShipAddr)
		*!*	ENDIF
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle)
		*!*	ENDIF
		
		*!*	**Get VendorContact **
		*!*	IF NOT SelectVendorContact(nContactID,ThisFormSet.nConnHandle)
		*!*		MESSAGEBOX("Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),16,"Cannot proceed")
		*!*		TrackError("Error","Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),"PurchaseOrder:cmdPrintPO.Click",LINENO(1))
		*!*		RETURN .F.
		*!*	ENDIF
		
		*!*	IF nHpaPo > 0
		*!*		ThisFormSet.VISIBLE = .F.
		*!*		IF MESSAGEBOX("Do You want to Print/Preview this?",4+32,'You must preview to print.') = 6
		*!*	*		? Get_PU_Price_String(PurchaseOrder.Order_PU, PurchaseOrder.Order_Qty, PurchaseOrder.Order_P)+"A"
		*!*			
		*!*			SELECT PurchaseOrder
		
		*!*			IF NOT lPrintSheetPk
		*!*				*do NOT Print Sheet Packing Instructions
		*!*				*NC is to Not print Cancelled items
		
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('reports\PurchaseOrder26.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo PREVIEW
		*!*						PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							SELECT PurchaseOrder
		*!*							REPORT FORM reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo TO PRINTER Prompt
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26' not found" NOWAIT
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('reports\PurchaseOrder26nc.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo  AND !PurchaseOrder.cancelled PREVIEW
		*!*						PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							SELECT PurchaseOrder
		*!*							REPORT FORM reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo AND !PurchaseOrder.cancelled TO PRINTER PROMPT
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26nc' not found" NOWAIT
		*!*					ENDIF
		*!*				ENDIF
		*!*			ELSE
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('reports\PurchaseOrder26_sheet.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo PREVIEW
		*!*						PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							SELECT PurchaseOrder
		*!*							REPORT FORM reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo TO PRINTER PROMPT
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheet' not found" NOWAIT
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('reports\PurchaseOrder26_sheetNC.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26_sheetNC.FRX FOR HpaPo = nHpaPo AND !PurchaseOrder.cancelled PREVIEW
		*!*						PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							SELECT PurchaseOrder
		*!*							REPORT FORM reports\PurchaseOrder26_sheetNC.FRX FOR HpaPo = nHpaPo AND !PurchaseOrder.cancelled TO PRINTER PROMPT
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheetNC' not found" NOWAIT
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		
		*!*		ENDIF
		*!*	*!*		IF MESSAGEBOX("Do You want to Fax this?",4+32,'') = 6
		*!*	*!*			WAIT WINDOW 'Fax routine done' NOWAIT
		*!*	*!*		ENDIF
		*!*		
		*!*		
		*!*		CLEAR TYPEAHEAD
		*!*		PRIVATE cEmailTo, cEmailFrom, cFileName,  cSubject, cMessage, cNewPDFName
		*!*		PRIVATE cEmail 
		
		*!*		IF MESSAGEBOX("Do you want to Email?",4+32,"Print PO") = 6
		*!*			IF FILE('reports\PurchaseOrder26.FRX')
		*!*				
		*!*				
		*!*				PRIVATE cEmail,	cEmailTo,cFileName2
		*!*				PRIVATE nPrinters,lWinFax,CT
		*!*				cEmailFrom = ""		
		*!*				cEmailTo = ""
		*!*				IF nContactID = 0
		*!*					MESSAGEBOX("No Vendor Email Address!"+CHR(13)+"Vendor Contact was not saved to PO!",48,"Need Email address.")
		*!*					ThisForm.AlwaysOnTop = .F.
		*!*					DO FORM Forms\GetNumber WITH cPOCompany,"EMAIL" TO cEmailTo
		*!*					ThisForm.AlwaysOnTop = .T.
		*!*				ELSE
		*!*					cEmailTo = VendorContactEmail_ContactID(nContactID,ThisFormSet.nConnHandle)
		*!*				ENDIF
		*!*				IF EMPTY(cEmailTo)
		*!*					MESSAGEBOX("Did not get Vendor Email Address!"+CHR(13)+"Vendor Contact may not have been saved to PO!",48,"Need Email address.")
		*!*					ThisForm.AlwaysOnTop = .F.
		*!*					DO FORM Forms\GetNumber WITH cPOCompany,"EMAIL" TO cEmailTo
		*!*					ThisForm.AlwaysOnTop = .T.
		*!*				ENDIF
		
		*!*				IF EMPTY(cEmailTo)
		*!*					MESSAGEBOX("No Email Address",0+16,"Cannot procede")
		*!*					RETURN .F.
		*!*				ENDIF
		*!*				
		*!*				PRIVATE cHPARep
		*!*				cHPARep = AppSetup_Get_UserName(cSalesP)
		*!*				IF EMPTY(cHPARep)
		*!*					*cHPARep = RIGHT(SYS(0),AT("#",SYS(0))-1)
		*!*					cHPARep = RIGHT(SYS(0),LEN(SYS(0))-AT("#",SYS(0))-1 )
		*!*				ENDIF
		*!*				
		*!*				cEmailFrom	= ALLTRIM(AppSetup_Get_Email( cHPARep ))
		
		*!*				IF EMPTY(cEmailFrom)
		*!*					MESSAGEBOX("There is no Email Address for user:"+cHPARep+CHR(13)+"PO Sales Initial is:"+cSalesP+CHR(13)+"Using "+get_Server_Email()+" as Sender Address!",0+64,"No Send From Address!")
		*!*					TRACKMESS("There is no Email Address for user:"+cHPARep+CHR(13)+"PO Sales Initial is:"+cSalesP+CHR(13)+"Using "+get_Server_Email()+" as Sender Address!"+CHR(13)+"No Send From Address!"+CHR(13)+"Print PO:"+ALLTRIM(STR(nHpaPo)))
		*!*					cEmailFrom = get_Server_Email()
		*!*				ENDIF
		*!*				cFileName = EmailFileName("HPA_PO.PDF")
		*!*				
		*!*				cNewPDFName	= "PO_"+ALLTRIM(STR(nHpaPo))+".pdf"
		*!*				cSubject	= "PO# "+ALLTRIM(STR(nHpaPo))+" from Space Alloys USA."
		*!*				
		*!*				cMessage = CreateHTML_VendorPOConf(nHpaPo,ThisFormSet.nConnHandle)
		*!*				
		*!*				ThisForm.AlwaysOnBottom = .T.
		*!*				
		*!*				*****************************
		*!*				DO WHILE FILE(cFileName)
		*!*					nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+cFileName+" already exists"+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
		*!*					IF nMess = 7 &&No
		*!*						DELETE FILE (cFileName)
		*!*					ENDIF
		*!*				ENDDO
		*!*				*****************************
		*!*				Local loListener As "PdfListener" Of "Pdfx.vcx"
		
		*!*				loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
		*!*				loListener.cCodePage="CP1252" &&CodePage
		*!*				loListener.cTargetFileName = cFileName
		*!*				loListener.QuietMode=.F.
		*!*				loListener.lCanPrint=.T.
		*!*				loListener.lCanEdit=.F.
		*!*				loListener.lCanCopy=.T.
		*!*				loListener.lCanAddNotes=.F.
		*!*				loListener.lEncryptDocument=.F.
		*!*				loListener.cMasterPassword=''
		*!*				loListener.cUserPassword=''
		*!*				loListener.lOpenViewer=.F.
		*!*						
		*!*				ThisFormSet.Visible = .F.
		
		*!*				SELECT PurchaseOrder
		*!*				IF lPrintSheetPk
		*!*					IF lPrintEvenCancelled
		*!*						IF FILE('reports\PurchaseOrder26_sheet.FRX')
		*!*							*REPORT FORM \reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER 
		*!*							REPORT FORM reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo Object loListener
		*!*							PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						ELSE
		*!*							WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheet' not found" NOWAIT
		*!*						ENDIF
		*!*					ELSE
		*!*						IF FILE('reports\PurchaseOrder26_sheetnc.FRX')
		*!*							*REPORT FORM \reports\PurchaseOrder26_sheetnc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*							REPORT FORM reports\PurchaseOrder26_sheetNC.FRX FOR HpaPo = nHpaPo AND !PurchaseOrder.cancelled Object loListener
		*!*							PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						ELSE
		*!*							WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheetnc' not found" NOWAIT
		*!*						ENDIF
		*!*					ENDIF
		*!*				ELSE
		*!*					IF lPrintEvenCancelled
		*!*						IF FILE('reports\PurchaseOrder26.FRX')
		*!*							*REPORT FORM \reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*							REPORT FORM reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo Object loListener
		*!*							PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						ELSE
		*!*							WAIT WINDOW "Report form 'reports\PurchaseOrder26' not found" NOWAIT
		*!*						ENDIF
		*!*					ELSE
		*!*						IF FILE('reports\PurchaseOrder26nc.FRX')
		*!*							*REPORT FORM \reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*							REPORT FORM reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo AND !PurchaseOrder.cancelled Object loListener
		*!*							PO_No_SetPrinted( nHpaPo, ThisFormSet.nConnHandle )
		*!*						ELSE
		*!*							WAIT WINDOW "Report form 'reports\PurchaseOrder26nc' not found" NOWAIT
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*				
		*!*				
		*!*				
		*!*				ThisFormSet.Visible = .T.
		*!*				
		*!*				RELEASE loListener
		*!*				
		*!*				ThisForm.AlwaysOnBottom = .F.
		*!*				ThisForm.ALWAYSONTOP = .T.
		*!*				ThisForm.ALWAYSONTOP = .F.
		
		*!*				SET PRINTER OFF
		*!*				SET PRINTER TO DEFAULT
		*!*				
		*!*				****
		*!*				IF FILE(cFileName)
		*!*					MESSAGEBOX(+cFileName+" exists",0+48,"Good...")
		*!*				ELSE
		*!*					MESSAGEBOX(+cFileName+" does NOT exists",0+48,"Bad...")
		*!*				ENDIF
		*!*				***
		*!*				PRIVATE cAns
		*!*				IF MESSAGEBOX("Do you Still want to Send?"+CHR(13)+"with 'Confirm Receive' statement"+CHR(13)+"Answer (No) here stop Send.",4+64,"With HTML Confirm?") = 6
		*!*					cAns = Send_HTML_Email_Attach(cEmailTo, cEmailFrom, cSubject, cMessage, cFileName, cNewPDFName, ThisFormSet.nConnHandle, .T., .T.)
		*!*					*cAns = SendPDFEmail(         cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, gnConnHandle, cNewPDFName)
		*!*				ELSE
		*!*					cAns = ''
		*!*				ENDIF
		*!*				
		*!*				DO CASE
		*!*				CASE "Mail queued" $ cAns
		*!*					WAIT WINDOW "Mail queued." NOWAIT
		*!*					TrackMess("PO "+ALLTRIM(STR(nHpaPo))+" Purchase Order was Emailed to ("+cEmailTo+") on ("+DTOC(DATE())+")"  )
		*!*				CASE NOT EMPTY(cAns)
		*!*					MESSAGEBOX( cANS,0,"SQL Returned Message!")
		*!*				OTHERWISE
		*!*					WAIT WINDOW "Email Complete" NOWAIT
		*!*					TrackMess("Purchase Order "+ALLTRIM(STR(nHpaPo))+" was Emailed to ("+cEmailTo+") on ("+DTOC(DATE())+")"  )
		*!*				ENDCASE
		*!*				
		*!*			ELSE
		*!*				WAIT WINDOW "Report form 'reports\PurchaseOrder26.FRX' not found" TIMEOUT 4
		*!*			ENDIF
		
		*!*		ENDIF
		
		*!*		ThisFormSet.VISIBLE = .T.
		*!*		
		*!*	ELSE
		*!*		MESSAGEBOX("No ERP PO Number!!!")
		*!*	ENDIF
		
		*!*	*keep PurchaseOrder open!
		*!*	IF USED('PurchaseOrder')
		*!*		IF nRecNo <> RECNO('PurchaseOrder')
		*!*			SELECT PurchaseOrder
		*!*			GOTO (nRecNo)
		*!*		ENDIF
		*!*		*USE IN PurchaseOrder
		*!*	ENDIF
		
		*!*	IF USED("ShipAddr")
		*!*		USE IN ShipAddr
		*!*	ENDIF
		*!*	IF USED('Vendor')
		*!*		USE IN Vendor
		*!*	ENDIF
		
		
		
	ENDPROC

