	PROCEDURE refreshstocklsttab
		*thisformSet.RefreshStockLstTAB()
		PRIVATE cSQL, nSQLEXEC, cSQLD
		
		ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdInventory.Caption = "Browse List"
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblReconciled.Visible = .F.
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblCancel.Visible = .F.
		
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblDeliv.Visible = .F.
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblConvServ.Visible = .F.
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblEquipment.Visible = .F.
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblServices.Visible = .F.
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblPrinted.Visible = .F.
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,'POitem',12)
		
		IF NOT cPOitem = Proper_PO_item("")
			cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Master WITH(NOLOCK) WHERE PO_item = '"+cPOitem+"'"
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT *,'B' AS TBL FROM dbo.BrokerLst_Master WITH(NOLOCK) WHERE PO_item = '"+cPOitem+"'"
		ELSE
			*Get blanks if not POitem
			cSQL = "SELECT * FROM dbo.StockLst_Master WITH(NOLOCK) WHERE 0>0"
		ENDIF
		
		IF USED("tmpStockLst_Master")
			SELECT tmpStockLst_Master
		ELSE 
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
			ThisFormSet.frmPOMaint.pf1.pgStockLst.txtPOitem.Value = ''
			ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditMaster.Enabled = .F.
			ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditDetail.Enabled = .F.
			ThisFormSet.StockLstMasterID = 0
		ELSE
			IF RECCOUNT('tmpStockLst_Master') = 0
			
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblALLOY1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblSIZE1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblSPECS1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblHeaT1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblLoT1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.LBLWEIGHT1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblMILL1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.LblTable.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblNUM1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lbl_ID.Visible = .F.
				
				ThisFormSet.frmPOMaint.pf1.pgStockLst.txtPOitem.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblID.Caption = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Alloy1.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Form1.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Cond1.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Size1.Value = 0
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Paid1.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.MWeight1.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.specs1.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Heat1.Value = ''
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Lot1.Value = ''
