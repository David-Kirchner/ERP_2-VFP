	PROCEDURE frmPO.pgfPO.pgPODesc.lblSalesnum.Click
		*record Current data
		PRIVATE nSalesNum,nSalesItem
		nSalesNum  = PrepareSQLnum(This.parent.TXTSALESNUM.Value,'SalesNum',-3)
		nSalesItem = PrepareSQLnum(This.parent.txtItem.Value,'SalesItem',2,0)
		
		PRIVATE cSOitem, lRemoveSO, nMess
		cSOitem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nSalesItem,2,0))
		lRemoveSO = .F.
		
		IF nSalesNum > 0
			IF nSalesItem > 0
				*Check for the SOitem
				nMess = MESSAGEBOX("Do you wish to remove SOitem:'"+ALLTRIM(cSOitem)+"' from this POitem?"+CHR(13)+"Answer No to see other Options.",4+32,"Remove SO")
				IF nMess = 6
					lRemoveSO = .T.
				ENDIF
			ENDIF
		ENDIF
		
		IF lRemoveSO
			This.parent.txtSALESNUM.Value = 0
			This.parent.txtItem.Value = 0
		ELSE
			DODEFAULT()
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = ThisForm.cPOitem
		
		
		PRIVATE cSOitem2,cSQL,nSQLEXEC
		cSQL = ''
		PRIVATE nSalesNum2,nSalesItem2
		nSalesNum2  = PrepareSQLnum(This.parent.TXTSALESNUM.Value,'SalesNum',-3)
		nSalesItem2 = PrepareSQLnum(This.parent.txtItem.Value,'SalesItem',2,0)
		
		IF nSalesNum2 = 0
			IF nSalesNum = 0
				*No Change!
			ELSE
				*Drop Sales
				IF Remove_SOi_FROM_POi(cSOitem,cPOitem,ThisFormSet.nConnHandle)
					*--runs UPDATE dbo.PurchaseOrder SET SalesNum = 0
					*--runs DELETE FROM dbo.PO_SOdist 
					*--runs EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem+"'"
					*--runs TrackMess("POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem+"'")		
					
					Save_SOitem_Status(cSOitem, nSalesNum, 'PO', "POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem+"'",ThisFormSet.nConnHandle)
					
					*ThisForm.pgfPO.pgPODesc.cmbStock.VALUE = "No Stock"
					PRIVATE lStockLst,cStock
					cStock		= PrepareSQLtxt(ThisForm.pgfPO.pgPOdesc.cmbStock.VALUE,'Stock',13,.F.)
					lStockLst	= isForStock(cStock)
		
					*All for Stock,Mostly Stock,Some Stock,No Stock,Not 2 HPA
					IF cStock = "All for Stock"
						*Good
					ELSE
						IF lStockLst
							MESSAGEBOX("PO was changed to list as 'All for Stock'"+CHR(13)+"'"+cStock+"' is not allowed.",0+48,"PO needs to be Saved.")
							ThisForm.pgfPO.pgPOdesc.cmbStock.VALUE = "All for Stock"
						ELSE
							MESSAGEBOX("PO propably needs to be changed to list as 'All for Stock'"+CHR(13)+"'"+cStock+"' is not allowed unless this is Service or Equipment PO.",0+48,"PO needs to be Saved.")
							ThisForm.pgfPO.pgPOdesc.cmbStock.VALUE = "All for Stock"
						ENDIF
						
					ENDIF
				ENDIF
				
			ENDIF
		ELSE
			IF nSalesNum = 0
				*Added Sales
				
				cSOitem2 = Proper_SO_Item(STR(nSalesNum2)+"-"+STR(nSalesItem2,2,0))
				cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem2+"'"		
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
				ELSE
					TrackMess("POitem:'"+cPOitem+"' was changed to be used for SOitem:'"+cSOitem2+"'")
					Save_SOitem_Status(cSOitem2, nSalesNum2, 'PO', "POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem2+"'",ThisFormSet.nConnHandle)
				ENDIF
		
			ELSE
				IF nSalesNum = nSalesNum2
					IF nSalesItem = nSalesItem2 
						*No Change!
					ELSE
						*No chage with SalesNo, Changed Item!
						cSOitem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nSalesItem,2,0))
						cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem+"'"
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
						ELSE
							Save_SOitem_Status(cSOitem, nSalesNum, 'PO', "POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem+"'",ThisFormSet.nConnHandle)
							TrackMess("POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem+"'")
						ENDIF
		
						cSOitem2 = Proper_SO_Item(STR(nSalesNum2)+"-"+STR(nSalesItem2,2,0))
						cSQL = cSQL + "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem2+"'"		
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
						ELSE
							Save_SOitem_Status(cSOitem2, nSalesNum2, 'PO', "POitem:'"+cPOitem+"' was changed to be used for SOitem:'"+cSOitem2+"'",ThisFormSet.nConnHandle)
							TrackMess("POitem:'"+cPOitem+"' was changed to be used for SOitem:'"+cSOitem2+"'")
						ENDIF
					ENDIF
				ELSE
					*Changed Sales
					cSOitem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nSalesItem,2,0))
					cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem+"'"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
					ELSE
						Save_SOitem_Status(cSOitem, nSalesNum, 'PO', "POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem+"'",ThisFormSet.nConnHandle)
						TrackMess("POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem+"'")
					ENDIF
		
					cSOitem2 = Proper_SO_Item(STR(nSalesNum2)+"-"+STR(nSalesItem2,2,0))
					cSQL = cSQL + "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem2+"'"		
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
					ELSE
						Save_SOitem_Status(cSOitem2, nSalesNum2, 'PO', "POitem:'"+cPOitem+"' was changed to be used for SOitem:'"+cSOitem2+"'",ThisFormSet.nConnHandle)
						TrackMess("POitem:'"+cPOitem+"' was changed to be used for SOitem:'"+cSOitem2+"'")
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtMisc_purch.GotFocus
		ThisFormset.frmPONotes.edtMisc_Purch.Value = This.Value
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtMisc_purch.LostFocus
		ThisFormset.frmPONotes.edtMisc_Purch.Value = This.Value
