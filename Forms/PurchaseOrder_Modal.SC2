	PROCEDURE frmPO.cmdPOAdd.Click
		DODEFAULT()
		*ADD
		*ThisFormSet.POeditMode = .T.
		
		*ThisForm.PO_NewAdd = .T.
		*ThisForm.POEditing = .T.
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			IF NOT ThisFormSet.FrmPO.POediting
				RETURN
			ENDIF
		ELSE
			RETURN
		ENDIF
		
		IF ThisFormSet.FrmPO.PO_NewAdd
			ThisForm.pgfPO.pgPODesc.txtItemPo.VALUE=1
		*	ThisForm.pgfPO.pgPODesc.txtSalesP.VALUE=SalesQuote.SalesP  &&SalesQuote is not available in PurchaseOrder26
			ThisForm.pgfPO.pgPODesc.txtCompany.Value = ''
			ThisForm.pgfPO.pgPODesc.lblVendCode.Caption = ''
			ThisForm.pgfPO.pgPODesc.lblPeachID.Caption	= ''
		
		*!*	SalesQuote is not present in PourchaseOrder14.scx	
		*!*		IF SalesQuote.StartStock 
		*!*			PRIVATE cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
		*!*			cssAlloy	= ''
		*!*			cssForm		= ''
		*!*			cssCC		= ''
		*!*			nssPieces	= 0
		*!*			nssThck		= 0
		*!*			nssSz2		= 0
		*!*			nssSz3		= 0
		*!*			nssWeight	= 0
		*!*			DO GetStartingStock WITH Quotes.ID,ThisForm.nConnHandle,cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
		*!*		
		*!*			ThisForm.pgfPO.pgPODesc.txtPieces.VALUE		= nssPieces
		*!*			ThisForm.pgfPO.pgPODesc.txtAlloy.VALUE		= cssAlloy
		*!*			ThisForm.pgfPO.pgPODesc.cmbForm.VALUE		= cssFORM
		*!*			ThisForm.pgfPO.pgPODesc.lblPerUnit.Caption	= FormUnitCaption(cssForm,.F.,.F.,ThisForm.nConnHandle)
		*!*			ThisForm.pgfPO.pgPODesc.cmbCC.VALUE			= cssCC
		*!*			ThisForm.pgfPO.pgPODesc.txtThck.VALUE		= nssThck
		*!*			ThisForm.pgfPO.pgPODesc.txtStandSize.VALUE	= getStandardSize(nssThck, ThisForm.nConnHandle)
		*!*			ThisForm.pgfPO.pgPODesc.txtSz2.VALUE		= nssSz2
		*!*			ThisForm.pgfPO.pgPODesc.txtSz3.VALUE		= nssSz3
		*!*			ThisForm.pgfPO.pgPODesc.txtOrder_Qty.Value 	= nssWeight
		*!*			
		*!*			IF cssFORM = "40" AND nssThck < .13
		*!*				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 1
		*!*			ELSE
		*!*				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 0
		*!*			ENDIF
		*!*		ELSE	
		*!*			ThisForm.pgfPO.pgPODesc.txtPieces.VALUE	=SalesQuote.Pieces
		*!*			ThisForm.pgfPO.pgPODesc.txtAlloy.VALUE	=SalesQuote.Alloy
		*!*			ThisForm.pgfPO.pgPODesc.cmbForm.VALUE	=SalesQuote.FORM
		*!*			ThisForm.pgfPO.pgPODesc.lblPerUnit.Caption	= FormUnitCaption(SalesQuote.Form,.F.,.F.,ThisForm.nConnHandle)
		*!*			ThisForm.pgfPO.pgPODesc.cmbCC.VALUE		=SalesQuote.CC
		*!*			ThisForm.pgfPO.pgPODesc.txtThck.VALUE	=SalesQuote.Thck
		*!*			ThisForm.pgfPO.pgPODesc.txtStandSize.VALUE=getStandardSize(SalesQuote.Thck, ThisForm.nConnHandle)
		*!*			ThisForm.pgfPO.pgPODesc.txtSz2.VALUE	=SalesQuote.Sz2
		*!*			ThisForm.pgfPO.pgPODesc.txtSz3.VALUE	=SalesQuote.Sz3
		*!*			
		*!*			
		*!*			IF SalesQuote.FORM = "40" AND SalesQuote.Thck < .13
		*!*				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 1
		*!*			ELSE
		*!*				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 0
		*!*			ENDIF
		*!*		ENDIF
		
		*!*	ThisForm.pgfPO.pgPODesc.txtJobNumber.VALUE=STR(SalesQuote.SalesNum_a)
			ThisForm.pgfPO.pgPODesc.txtOrderDate.VALUE=DATE()
			ThisForm.pgfPO.pgPODesc.cmbStock.VALUE = "No Stock"
			m.Stock="No Stock"
			
		*!*		IF PrepareSQLchk(SalesQuote.Metric,'Metric',.F.)
		*!*			ThisForm.pgfPO.pgPODesc.chkMetric.Value = 1
		*!*			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Value = PrepareSQLtxt(SalesQuote.Sz1orig,'Sz1Orig',20)
		*!*			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Value = PrepareSQLtxt(SalesQuote.Sz2orig,'Sz2Orig',20)
		*!*			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Value = PrepareSQLtxt(SalesQuote.Sz3orig,'Sz3Orig',20)
		*!*			
		*!*		ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.cmdPODelete.Click
		
		*Delete or Cancel
		PRIVATE lPOEditMode 
		lPOEditMode = ThisFormSet.frmPO.POEditing
		
		IF This.Caption = "Cancel"
			DODEFAULT()
			
			IF lPOEditMode AND NOT ThisFormSet.frmPO.POEditing
				*Cancel
		
				ThisFormSet.EditPOScreen(.F.)
				
				ThisFormSet.frmPO.POScreen("CLEAR")
		*		ThisFormSet.AddressScreen("ENABLE")
				
				ThisFormset.frmPOMaint.pf1.pgEdit.SetFocus()
				ThisFormset.frmPOMaint.pf1.pgEdit.Click
				ThisFormSet.frmPOMaint.pf1.ActivePage = 2
			ELSE
				*Delete or Missed Cancel
				
			ENDIF
		ELSE
			*Delete
			
			*ThisFormset.frmPOMaint.pf1.pgEdit.cmdDelete.Click
			PRIVATE cPOitem
			cPOitem = PurchaseOrder.POitem
			IF MESSAGEBOX("Are you sure you want to delete PO Item "+ALLTRIM(cPOitem)+" ?",4+48,"Delete PO Item?") = 6
		
				WAIT WINDOW "Trying to Delete!" NOWAIT
				IF PurchaseOrder_POitem_Delete( PurchaseOrder.POitem, ThisFormSet.nConnHandle ) 
					ThisFormSet.EditPOScreen(.F.)
					ThisFormSet.frmPO.POScreen("CLEAR")
				
					ThisFormSet.ReloadPurchaseOrder()
		*			ThisFormSet.AddressScreen("ENABLE")
					WAIT WINDOW "Deleted." NOWAIT
				ELSE
					WAIT WINDOW "Failed to deleted." NOWAIT
				ENDIF
			ENDIF
		
			
			ThisFormset.frmPOMaint.pf1.pgEdit.SetFocus()
			ThisFormset.frmPOMaint.pf1.pgEdit.Click
			
		ENDIF
	ENDPROC

	PROCEDURE frmPO.cmdPOEdit.Click
		*Edit or Save
		
		PRIVATE cPOitem, lAdd, lPOEditMode
		cPOitem = ThisForm.cPOitem
		lAdd = ThisFormSet.FrmPO.PO_NewAdd
		*lPOEditMode = ThisformSet.POeditMode
		lPOEditMode = ThisFormSet.frmPO.POEditing
		
		DODEFAULT()
		
		IF lPOEditMode = ThisFormSet.frmPO.POEditing
			*Nothing Changed!
			RETURN
		ENDIF
		
		*POEditMode is changed in CLASS purchaseorder at DoDefault()
		IF ThisFormSet.frmPO.POEditing
		*IF ThisformSet.POeditMode
		*	ThisFormSet.POeditMode = .T.
			*show Edits
			ThisFormSet.EditPOScreen(.F.)
			ThisFormSet.frmPO.POScreen("ENABLE")
		*	ThisFormSet.AddressScreen("DISABLE") &&ThisFormSet.Address_Screen("OrderToEdit")
		ELSE
		*	ThisFormSet.POeditMode = .F.
			*Save Edits
			ThisFormSet.EditPOScreen(.F.)
			ThisFormSet.frmPO.POScreen("DISABLE")
		*	ThisFormSet.AddressScreen("ENABLE")
			IF lAdd 
				*Go to NEW PO
				ThisFormSet.ReloadPurchaseOrder(cPOitem)
			ELSE
				*Go back to edited POitem
				ThisFormSet.ReloadPurchaseOrder(cPOitem)
			ENDIF
			
			ThisFormSet.frmPO.Visible = .F.
			ThisFormset.frmPOMaint.pf1.pgEdit.SetFocus()
			ThisFormSet.RefreshEditTab()
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPO.cmdPoNext.Click
		*Not visible within PurchaseOrder
	ENDPROC

	PROCEDURE frmPO.cmdPoPrev.Click
		*Not visible within PurchaseOrder
	ENDPROC

	PROCEDURE frmPO.cmdPrintPO.Click
		*DODEFAULT()
		TrackError("User clicked Print PO in PurchaseOrder frmPO screen. This should not be an option.","How was this ABLE?","PurchaseOrder:frmPO.cmdPrintPO.Click",LINENO(1))
		*There is a windows active problem from here!! --Last tried to fix on 12/13/18
		
		PRIVATE nRecNo
		SELECT PurchaseOrder
		nRecNo = RECNO('PurchaseOrder')
		
		**Get POShipAddr **
		PRIVATE nPOShipAddr
		nPOShipAddr = PrepareSQLnum(PurchaseOrder.POShipAddr,'POShipAddr',-3)
		IF EMPTY(nPOShipAddr)
			MESSAGEBOX("Please Enter a 'Ship To Address'."+CHR(13)+"Please remember to add the address.",0,"")
			RETURN .F.
		ENDIF
		
		**Get VendorContact **
		PRIVATE nContactID
		nContactID = PrepareSQLnum(PurchaseOrder.ContactID,'ContactID',-3)
		IF NOT SelectVendorContact(nContactID,ThisFormSet.nConnHandle)
			MESSAGEBOX("Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),16,"Cannot proceed")
			TrackError("Error","Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),"PurchaseOrder:frmPO.cmdPrintPO.Click",LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE nHpaPo,lClosePO
		nHpaPo = PrepareSQLnum(PurchaseOrder.HpaPo,'HPAPO',-3)
		lClosePO = .F.
		
		***************************
		***************************
		IF nHpaPo > 0
		
			MESSAGEBOX("You will be able to Print/Preview twice and then Email this."+CHR(13)+"PO: '"+ALLTRIM(STR(nHPAPO))+CHR(13)+"Use the Print in the Previw window."+CHR(13)+"Click the door to Exit the preview window.",0+32,"Any key to continue.") 
			
			ThisForm.Visible = .F.
			ThisFormSet.VISIBLE = .F.
			ThisFormSet.frmPO.PrintPO(nHpaPo,lClosePO)
			ThisFormSet.VISIBLE = .T.
			ThisForm.Visible = .T.
			
		ENDIF
		
		IF nRecNo = RECNO('PurchaseOrder')
			SELECT PurchaseOrder
			GOTO (nRecNo)
		ENDIF
		
		RETURN
	ENDPROC

