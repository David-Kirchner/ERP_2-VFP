				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblSPECS1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblHeaT1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblLoT1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.LBLWEIGHT1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblMILL1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.LblTable.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblNUM1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lbl_ID.Visible = .T.
				
				ThisFormSet.frmPOMaint.pf1.pgStockLst.txtPOitem.Value = cPOitem
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblID.Caption = ALLTRIM(STR(tmpStockLst_Master.ID))
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Alloy1.Value = tmpStockLst_Master.Alloy
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Form1.Value = tmpStockLst_Master.Form
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Cond1.Value = tmpStockLst_Master.Cond
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Size1.Value = tmpStockLst_Master.Size
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Paid1.Value = tmpStockLst_Master.Paid
				ThisFormSet.frmPOMaint.pf1.pgStockLst.MWeight1.Value = tmpStockLst_Master.MWeight
				ThisFormSet.frmPOMaint.pf1.pgStockLst.specs1.Value = tmpStockLst_Master.specs
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Heat1.Value = tmpStockLst_Master.Heat
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Lot1.Value = tmpStockLst_Master.Lot
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Mill1.Value = tmpStockLst_Master.Mill
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Num1.Value = tmpStockLst_Master.Num
				ThisFormSet.frmPOMaint.pf1.pgStockLst.TBL1.Value = tmpStockLst_Master.TBL
				
				ThisFormSet.frmPOMaint.pf1.pgStockLst.lblID.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Alloy1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Form1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Cond1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Size1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Paid1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.MWeight1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.specs1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Heat1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Lot1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Mill1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Num1.Visible = .T.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.TBL1.Visible = .T.
				
				*ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditMaster.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdInventory.Visible = .T.
				DO CASE
				CASE tmpStockLst_Master.TBL = "S"
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdInventory.Caption = "Browse Stock List"
				CASE tmpStockLst_Master.TBL = "B"
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdInventory.Caption = "Browse Broker List"
				CASE tmpStockLst_Master.TBL = "W"
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdInventory.Caption = "Browse WIP List"
				ENDCASE
				
				IF PrepareSQLlogic(PurchaseOrder.Cancelled,'Cancelled')
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdMasterDelete.Visible = .T.
				ENDIF
			ENDIF
			
			IF tmpStockLst_Master.ID > 0
				ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditMaster.Enabled = .T.
				ThisFormSet.StockLstMasterID = tmpStockLst_Master.ID
			ELSE
				ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditMaster.Enabled = .F.
				ThisFormSet.StockLstMasterID = 0
			ENDIF
			
			*
			
			ThisFormSet.frmPOMaint.pf1.pgStockLst.lblReconciled.Visible	= PurchaseOrder.Reconciled
			ThisFormSet.frmPOMaint.pf1.pgStockLst.lblCancel.Visible		= PurchaseOrder.Cancelled
			ThisFormSet.frmPOMaint.pf1.pgStockLst.lblDeliv.Visible		= PurchaseOrder.Delivered
			ThisFormSet.frmPOMaint.pf1.pgStockLst.lblConvServ.Visible	= PurchaseOrder.ConvServ
			ThisFormSet.frmPOMaint.pf1.pgStockLst.lblEquipment.Visible	= PurchaseOrder.Equipment
			ThisFormSet.frmPOMaint.pf1.pgStockLst.lblServices.Visible	= PurchaseOrder.Services
			ThisFormSet.frmPOMaint.pf1.pgStockLst.lblPrinted.Visible 	= PurchaseOrder.Printed
			
			*Detail
			IF tmpStockLst_Master.TBL = "S"
				cSQLD = "SELECT * FROM dbo.StockLst_Detail WHERE ID = "+ALLTRIM(STR(tmpStockLst_Master.ID)) +""
			ELSE
				cSQLD = "SELECT * FROM dbo.BrokerLst_Detail WHERE ID = "+ALLTRIM(STR(tmpStockLst_Master.ID)) +""
			ENDIF
			
			IF USED("tmpStockLst_Detail")
				SELECT tmpStockLst_Detail
			ELSE 
				SELECT 0
			ENDIF
			
			ThisFormSet.frmPOMaint.pf1.pgStockLst.grdStockLst_Detail.RecordSource = ""
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, 'tmpStockLst_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, 'tmpStockLst_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLD,ThisFormSet.nConnHandle)
				ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditDetail.Enabled = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.grdStockLst_Detail.Visible = .F.
				
			ELSE
				IF RECCOUNT('tmpStockLst_Detail') = 0
					ThisFormSet.frmPOMaint.pf1.pgStockLst.grdStockLst_Detail.Visible = .F.
				ELSE
					ThisFormSet.frmPOMaint.pf1.pgStockLst.grdStockLst_Detail.Visible = .T.
					ThisFormSet.frmPOMaint.pf1.pgStockLst.grdStockLst_Detail.RecordSourceType = 1
					ThisFormSet.frmPOMaint.pf1.pgStockLst.grdStockLst_Detail.RecordSource = "tmpStockLst_Detail"
					ThisFormSet.frmPOMaint.pf1.pgStockLst.grdStockLst_Detail.Refresh
				ENDIF
				
				IF tmpStockLst_Detail.ID_Detail > 0
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditDetail.Enabled = .T.
					*ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditDetail.Visible = .T.
					
					IF tmpStockLst_Master.TBL = "B"
						ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdDelDetail.Enabled = .T.
						*ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdDelDetail.Visible = .T.
					ENDIF
				ELSE
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditDetail.Enabled = .F.
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdEditDetail.Visible = .F.
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdDelDetail.Enabled = .F.
					ThisFormSet.frmPOMaint.pf1.pgStockLst.cmdDelDetail.Visible = .F.
				ENDIF
		
			ENDIF
		ENDIF
		
		ThisFormSet.frmPOMaint.pf1.pgStockLst.lblCntReceive.Caption = STR(Count_POitem_Receiving(PurchaseOrder.POitem,ThisFormSet.nConnHandle,''))
		
		IF USED("tmpStockLst_Master")
		*	USE IN tmpStockLst_Master
			*use in StockLst_SQL_Quotes 'Inventory'
		ENDIF
		
		ThisFormSet.frmPO.cPOitem = PurchaseOrder.POitem
		ThisFormSet.frmPO.cSOitem = PurchaseOrder.SOitem
		
	ENDPROC

	PROCEDURE refresh_gawo_detail
		*ThisFormSet.Refresh_gaWO_Detail()
		
		
		IF VARTYPE(gaWO_Detail)="U"
			PUBLIC gaWO_Detail(1)
			gaWO_Detail(1) = 0
		ENDIF
		
		IF NOT USED('PurchaseOrder')
			RETURN .F.
		ENDIF
		cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,'POitem',12)
		
		PRIVATE cSQL, nSQLEXEC 
		************************************
		PRIVATE nWO_Detail,nWO,cPOitem
		nWO = 0 
		nWO_Detail = 0
		
		IF USED("tmpPOWO")	
			USE IN tmpPOWO
		ENDIF
		SELECT 0
		
		cSQL = "SELECT WO,WO_Detail FROM dbo.PurchaseOrder WHERE POitem='"+cPOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPOWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOWO')
		ELSE
			IF USED('tmpPOWO')
				IF RECCOUNT('tmpPOWO') > 0
					nWO		= PrepareSQLnum(tmpPOWO.WO,'WO',-3)
					nWO_Detail = PrepareSQLnum(tmpPOWO.WO_Detail,'WO_Detail',-3)
				ENDIF
			ENDIF
		ENDIF
		
		
		IF nWO <> PrepareSQLnum(PurchaseOrder.WO,'WO',-3)
			*Refresh the table PurchaseOrder
			ThisFormSet.ReloadPurchaseOrder("ALL")
		ENDIF
		
		************************************
		IF NOT USED('tmpWO_Detail') AND nWO > 0
		
			IF USED("tmpWO_Detail")	
				USE IN tmpWO_Detail
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * FROM dbo.WorkOrder_Detail WHERE WO="+ALLTRIM(STR(nWO))
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
			ELSE
				IF USED('tmpWO_Detail')
					IF RECCOUNT('tmpWO_Detail') > 0
						IF nWO_Detail = 0  &&might already have!!!! - at least table tmpWO_Detail is upto date
							nWO_Detail = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF nWO_Detail = 0
				IF USED('tmpWO_Detail') 
					nWO_Detail = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
				ENDIF
			ENDIF
		ENDIF
		
		***************************
		
		IF USED('tmpWO_Detail')
			*IF RECCOUNT('tmpWO_Detail') > 0
			
			SELECT WO_Detail FROM tmpWO_Detail INTO ARRAY gaWO_Detail
			
			ThisFormSet.frmWO.lstWO_Detail.NumberOfElements = ALEN(gaWO_Detail,1)
		
			SELECT tmpWO_Detail 
			GO TOP
			
			IF nWO_Detail > 0
				LOCATE FOR WO_Detail = nWO_Detail 
			ENDIF
			
			ThisFormSet.frmWO.lstWO_Detail.Value = tmpWO_Detail.WO_Detail 
			ThisFormSet.frmWO.txtWO_Detail.Value = tmpWO_Detail.WO_Detail 
						
			ThisFormSet.ShowWO_WODetail(tmpWO_Detail.WO_Detail)
			
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE reloadpurchaseorder
		PARAMETERS pHow
		*ThisFormSet.ReloadPurchaseOrder()
		*"ALL" or cPOitem
		
		PRIVATE cPOitem
		cPOitem = ''
		
		IF VARTYPE(pHow) != "C"
			pHow = ""
		ENDIF
		
		*IF Proper_PO_Item(pHow) = Proper_PO_Item("ALL")
		IF LEN(pHow) > 0
			IF pHow = "ALL"
				*Good
			ELSE
				cPOitem = Proper_PO_Item(pHow)
				pHow = "PO_ITEM"
			ENDIF
		ENDIF
		
		ThisFormSet.frmPOMaint.pf1.pgEdit.grdPO1.RecordSource = ''
		ThisFormSet.frmPOMaint.pf1.pgBrowse.GridBR.RecordSource = ''
		ThisFormSet.frmPOMaint.pf1.pgStockLst.GridSOi.RecordSource = ''
		
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.PurchaseOrder WITH(NOLOCK) "
		   
		*IF pHow = "ALL"
			*All
		*	ThisFormSet.AllRecordsRetrieved = .T.
		
		IF NOT ThisFormSet.AllRecordsRetrieved
			cSQL = cSQL + " WHERE OrderDate >= '"+DTOC( DATE()-720 )+"'"
			ThisFormSet.AllRecordsRetrieved = .F.
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
		ENDIF
		***
		IF NOT USED('PurchaseOrder')
			*try again
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
			ENDIF
		ENDIF
		
		***
		
		IF NOT USED('PurchaseOrder')
			MESSAGEBOX("Could not get the PurchaseOrder Table!",16,"DATA ERROR")
			RETURN .F.
		ENDIF
		***
		SET SAFETY OFF
		
		SELECT PurchaseOrder
		INDEX ON POitem TAG POitem
		SET ORDER TO POItem
		INDEX ON ValPOitem(POitem) TAG VALPOitem
		SET ORDER TO VALPOitem
		
		GO Bottom
		
		DO CASE
		CASE EMPTY(pHow) 
			SKIP -3
		CASE pHow = "ALL"
			SKIP -3
			WAIT WINDOW 'All records are now shown' NOWAIT
		CASE pHow = "PO_ITEM"
			SEEK cPOitem ORDER TAG POitem IN PurchaseOrder
		OTHERWISE
			*pHow is POitem to goto after update
			SEEK pHow ORDER TAG POitem IN PurchaseOrder
		ENDCASE
		
		ThisFormSet.frmPOMaint.pf1.pgEdit.grdPO1.RecordSource = 'PurchaseOrder'
		ThisFormSet.frmPOMaint.pf1.pgBrowse.GridBR.RecordSource = 'PurchaseOrder'
		ThisFormSet.frmPOMaint.pf1.pgStockLst.GridSOi.RecordSource = 'PurchaseOrder'
		
		
	ENDPROC

	PROCEDURE showduenotes
		*ThisFormSet.ShowDueNotes()
		
		*********************************
		PRIVATE 	dDue_Min,dDue_Max,dHPA_Due_Min,dHPA_Due_Max, dReceived, dOrderDate
		
		dDue_Min		= PrepareSQLdate(PurchaseOrder.Due_Min,'Due_Min',.F.,.T.)
		dDue_Max		= PrepareSQLdate(PurchaseOrder.Due_Max,'Due_Max',.F.,.T.)
		dHPA_Due_Min	= PrepareSQLdate(PurchaseOrder.HPA_Due_Min,'HPA_Due_Min',.F.,.T.)
		dHPA_Due_Max	= PrepareSQLdate(PurchaseOrder.HPA_Due_Max,'HPA_Due_Max',.F.,.T.)
		
		dReceived		= PrepareSQLdate(PurchaseOrder.Received,'Received',.F.,.T.)
		dOrderDate		= PrepareSQLdate(PurchaseOrder.OrderDate,'OrderDate',.F.,.T.)	
		
		PRIVATE dHPA_Date_Update 
		dHPA_Date_Update = CTOD('')
		
		IF NOT EMPTY(dReceived)
			dHPA_Date_Update = dReceived
		ELSE
			IF NOT EMPTY(dHPA_Due_Max)
				dHPA_Date_Update = dHPA_Due_Max
			ELSE
				IF NOT EMPTY(dHPA_Due_Min)
					dHPA_Date_Update = dHPA_Due_Min
				ELSE
					IF NOT EMPTY(dDue_Max)
						dHPA_Date_Update = dDue_Max
					ELSE
						IF NOT EMPTY(dHPA_Due_Min)
							dHPA_Date_Update = dDue_Min
						ELSE
							IF NOT EMPTY(dOrderDate)
								dHPA_Date_Update = dOrderDate
							ELSE
								dHPA_Date_Update = CTOD('')
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		IF NOT EMPTY(dHPA_Date_Update )
			ThisFormSet.frmEditDelivery.txtHPA_Due_Max.Value = dHPA_Date_Update 
		ELSE
			ThisFormSet.frmEditDelivery.txtHPA_Due_Max.Value = DATE()
		ENDIF
		
		****************************************
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,'POitem',12)
		
		PRIVATE cProcessNotes
		cProcessNotes = ""
				
		IF USED('tmpProcessNotes')
			USE IN tmpProcessNotes
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Notes FROM dbo.PO_ProcessNotes "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProcessNotes')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpProcessNotes' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProcessNotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProcessNotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpProcessNotes')
		ELSE
			IF USED('tmpProcessNotes')
				IF RECCOUNT('tmpProcessNotes') > 0
					cProcessNotes = ShowSQLtxt(tmpProcessNotes.Notes,'Notes',-3)
				ENDIF
				USE IN tmpProcessNotes
			ENDIF
		ENDIF
		
		ThisFormSet.frmEditDelivery.edtNotes.Value = cProcessNotes 
		
		****************************************
	ENDPROC

