	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgStockLst.cmdDelDetail.Click
		*ThisFormSet.StockLstDetail( "ADD", ThisFormSet.StockLstMasterID ) 
		PRIVATE cSQL_Delete, cSQL, nSQLEXEC
		
		IF EMPTY(tmpStockLst_Detail.ID_Detail)
			MESSAGEBOX("Cannot Delete",0,"No record")
		ELSE
			*Check for Process before Allowing Delete
			IF USED('tmpCountProcess')
				USE IN tmpCountProcess
			ENDIF
			SELECT 0
			*IF ThisForm.Lst = "StockLst"
			IF tmpStockLst_Master.TBL = "S"
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Process WHERE ID_Detail = "+ STR(tmpStockLst_Detail.ID_Detail)
			ELSE
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.BrokerLst_Process WHERE ID_Detail = "+ STR(tmpStockLst_Detail.ID_Detail)
			ENDIF
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountProcess' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountProcess' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountProcess")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountProcess")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountProcess')
			ENDIF
		
			IF USED('tmpCountProcess')
				IF tmpCountProcess.CNT > 0
					MESSAGEBOX("A process record is dependant on this Detail record."+CHR(13)+;
						"You must remove the process record first.",0,"You cannot delete!")
				ELSE
					IF MESSAGEBOX("Are you sure you want to delete this Detail Record?",4+32,"Confirm Delete") = 6
						
						PRIVATE cReason
						cReason = ""
						ThisForm.AlwaysOnTop = .F.
						DO FORM Forms\AnswerForm WITH "Why do you want to Delete?","Not Found", 100 TO cReason
						ThisForm.AlwaysOnTop = .T.
						
						IF TYPE("cReason") = "C"
							cReason = ALLTRIM(cReason)
						ELSE
							cReason = ""
						ENDIF
						
						
						IF Remove_Lst_Detail_by_ID_Detail(tmpStockLst_Master.TBL,tmpStockLst_Detail.ID_Detail,ThisFormSet.nConnHandle,.T.,cReason) &&Proc_ERP
							ThisFormSet.RefreshStockLstTAB()
						ENDIF
					ENDIF
		
				ENDIF
				USE IN tmpCountProcess
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgStockLst.cmdEditDetail.Click
		ThisFormSet.StockLstDetail( "EDIT", tmpStockLst_Detail.ID_Detail ) 
	ENDPROC

