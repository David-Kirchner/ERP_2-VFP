	PROCEDURE frmPOMaint.pf1.pgEdit.cmdSaveNotes.Click
		*Save
		PRIVATE cPOItem, cReceipt
		cPOitem = PurchaseOrder.POitem
		cReceipt = PrepareSQLtxt(This.Parent.edtReceipt.Value,'Receipt',-3)
		
		PRIVATE cSQLu, nSQLEXEC 
		cSQLu = "UPDATE dbo.PurchaseOrder SET "
		cSQLu = cSQLu + " [Receipt]='"+cReceipt+"'"
		cSQLu = cSQLu + " WHERE PurchaseOrder.POItem = '"+cPOItem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
			lPOSaveOK = .F.
		ELSE
			TrackMess( "Updateded POitem:"+ALLTRIM(cPOitem)+" Edited Receipt Notes from PurchaseOrder screen.")
		ENDIF
		
		ThisFormSet.ReloadPurchaseOrder(cPOItem)
		
		This.Visible = .F.
		This.Parent.cmdEditNotes.Caption = "Edit Notes"
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmdSendPOconf.Click
		PRIVATE cPOitem, nHPAPO, lClosePO
		cPOitem = PurchaseOrder.POitem
		nHPAPO	= PurchaseOrder.HPAPO
		lClosePO = .F.
		
		IF nHPAPO = 0
			RETURN .F.
		ENDIF
		
		PRIVATE cEmailTo, cSalesP, nContactID
		cEmailTo = ""
		cSalesP = PrepareSQLtxt(PurchaseOrder.SalesP,'SalesP',1)
		nContactID = ContactID_PO(nHPAPO,ThisFormSet.nConnHandle)
		IF nContactID = 0
			MESSAGEBOX("No Vendor Email Address!"+CHR(13)+"Vendor Contact was not saved to PO!",48,"Need Email address.")
			ThisForm.AlwaysOnTop = .F.
			DO FORM Forms\GetNumber WITH PurchaseOrder.Company,"EMAIL" TO cEmailTo
			ThisForm.AlwaysOnTop = .T.
		ELSE
			cEmailTo = VendorContactEmail_ContactID(nContactID,ThisFormSet.nConnHandle)
		ENDIF
		IF EMPTY(cEmailTo)
			MESSAGEBOX("Did not get Vendor Email Address!"+CHR(13)+"Vendor Contact may not have been saved to PO!",48,"Need Email address.")
			ThisForm.AlwaysOnTop = .F.
			DO FORM Forms\GetNumber WITH PurchaseOrder.Company,"EMAIL" TO cEmailTo
			ThisForm.AlwaysOnTop = .T.
		ENDIF
		
		IF EMPTY(cEmailTo)
			MESSAGEBOX("No Email Address",0+16,"Cannot procede")
			RETURN .F.
		ENDIF
		
		PRIVATE cEmailFrom
		cEmailFrom	= ALLTRIM(SalesPEmail(cSalesP) )
		
		IF EMPTY(cEmailFrom)
			PRIVATE cUserName
			*cUserName = RIGHT(SYS(0),AT("#",SYS(0))-1)
			cUserName = RIGHT( SYS(0) ,LEN(SYS(0))-AT("#",SYS(0))-1 )
			cEmailFrom	= ALLTRIM(AppSetup_Get_Email(cUserName))  
			IF NOT EMPTY(cEmailFrom)
				IF MESSAGEBOX("Did not find an Email for the SalesP '"+cSalesP+"'."+CHR(13)+"Do you want to send?"+CHR(13)+"Receipt Conformation request as"+CHR(13)+cUserName+" "+cEmailFrom+"?",4+32,"Send as You?") = 6
					*Good
				ELSE
					cEmailFrom = get_Server_Email()
				ENDIF
			ELSE
				cEmailFrom = get_Server_Email()
			ENDIF
		ENDIF
		
		PRIVATE m.MsgNoteHTML
		m.MsgNoteHTML = CreateHTML_VendorPOConf(nHPAPO,ThisFormSet.nConnHandle)  &&Proc_Quotes
		
		PRIVATE m.MsgSubject 
		m.MsgSubject = "Purchase Order "+CompanyReport_ShortName()+" #"+ALLTRIM(STR(nHPAPO))
		
		IF MESSAGEBOX("Are you sure want to Email this request for PO Confirmation?",4,"Send Email?") = 6
			Send_HTML_Email(cEmailTo, cEmailFrom, MsgSubject, m.MsgNoteHTML, ThisFormSet.nConnHandle, .T., .T.)   &&Proc_SQL
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmdWorkOrder.Click
		
		PRIVATE cPOitem, lReturn
		cPOitem = PurchaseOrder.POitem
		
		
		PRIVATE cPOitem, nWO, nWOD, lReturn
		cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,'POitem',12)
		cSOitem = PrepareSQLtxt(PurchaseOrder.SOitem,'SOitem',10)
		nWO		= PrepareSQLnum(PurchaseOrder.WO,'WO',-3)
		nWOD	= PrepareSQLnum(PurchaseOrder.WO_Detail,'WO_Detail',-3)
		
		IF nWO	> 0
			ThisForm.AlwaysOnTop = .F.
			DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWOD,cPOitem,cSOitem,'' 
		
		ELSE
			IF nWOD > 0
				*MESSAGEBOX("This PO is attached to a WordOrder Detail"+CHR(13)+"No WorkOrder number."+CHR(13)+"Edit by the WO Detail Number!"+CHR(13)+"Use the [WO Detail] button.",48,"No WorkOrder Found")
				*RETURN .F.
				DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWOD,cPOitem,cSOitem,''
			ELSE
				PRIVATE nMess
			*	nMess = MESSAGEBOX("Is this PO for Starting or Finishing WO?"+CHR(13)+"Answer (Y) for Starting."+CHR(13)+"(N) for Finishing Detail.",3+32,"Starting ?")
				nMess = MESSAGEBOX("Is this PO for Starting or Finishing WO?"+CHR(13)+"Answer (Y) for Starting - Buying staring stock."+CHR(13)+"(N) for Finishing - PO is going to Converter."+CHR(13)+"",3+32,"PO is for Starting Material?")
				IF nMess = 6
					*Starting
					ThisForm.AlwaysOnTop = .F.
					*DO FORM Forms\WorkOrder WITH "ADD_PO-Start",nWO,cPOitem,cSOitem,0 TO lReturn
					DO FORM Forms\WorkOrder WITH "ADD_PO-Start",nWO,nWOD,cPOitem,cSOitem,''
					*PARAMETERS pWhat,pWO,pPOitem,pSOitem,pWhatEver
					
				ENDIF
				IF nMess = 7
					*Finishing Detail
					ThisForm.AlwaysOnTop = .F.
					*DO FORM Forms\WorkOrder_Detail WITH "ADD_PO-Finish",nWOD,nWO,cPOitem,cSOitem,0 TO lReturn
					*DO FORM Forms\WorkOrder_Detail WITH "ADD_PO-Finish",nWOD,nWO,cPOitem,cSOitem,0
					DO FORM Forms\WorkOrder WITH "ADD_PO-Finish",nWO,nWOD,cPOitem,cSOitem,''
					*PARAMETERS pWhat,pWO,pPOitem,pSOitem,pWhatEver
		
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF nWO=0
			*Look for new WO and refresh Data
			
			IF USED('tmpWO')
				USE IN tmpWO
			ENDIF
			SELECT 0
		
			cSQL = "SELECT WO FROM dbo.WorkOrder WHERE POitem = '"+cPOitem+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWO' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpWO')
			ELSE
				IF USED('tmpWO')
					IF RECCOUNT('tmpWO') > 0
						ThisFormSet.ReloadPurchaseOrder()
						ThisFormSet.RefreshEditTab()
						SEEK cPOitem ORDER TAG POitem IN PurchaseOrder
						
					ENDIF
					USE IN tmpWO
				ENDIF
			ENDIF	
		ENDIF
		
		IF nWOD =0
			*Look for new WOD and refresh Data
			
			IF USED('tmpWO')
				USE IN tmpWO
			ENDIF
			SELECT 0
		
			cSQL = "SELECT WO_Detail FROM dbo.WorkOrder_Detail WHERE fPOitem = '"+cPOitem+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWO' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpWO')
			ELSE
				IF USED('tmpWO')
					IF RECCOUNT('tmpWO') > 0
						ThisFormSet.ReloadPurchaseOrder()
						ThisFormSet.RefreshEditTab()
						SEEK cPOitem ORDER TAG POitem IN PurchaseOrder
					ENDIF
					USE IN tmpWO
				ENDIF
			ENDIF	
		ENDIF
		
		
		
	ENDPROC

