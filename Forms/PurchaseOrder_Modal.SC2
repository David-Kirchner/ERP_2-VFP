	PROCEDURE addressscreen
		PARAMETERS pWhat
		*ThisFormSet.AddressScreen("ENABLE")
		
		DO CASE
		CASE pWhat = "DISABLE"
			ThisFormSet.frmPOMaint.cmdView.Enabled = .F.
			ThisFormSet.frmPOMaint.cmdPrintPO.Enabled = .F.
			ThisFormSet.frmPOMaint.cmdEdit.Enabled = .F.
			ThisFormSet.frmPOMaint.cmdSeeAll.Enabled = .F.
			ThisFormSet.frmPOMaint.cmdQuit.Enabled = .F.
			
			ThisFormSet.frmPOMaint.pf1.pgEdit.Enabled = .F.
			ThisFormSet.frmPOMaint.pf1.pgBrowse.Enabled = .F.
			ThisFormSet.frmPOMaint.pf1.pgFind.Enabled = .F.
			ThisFormSet.frmPOMaint.pf1.pgStockLst.Enabled = .F.
			
			ThisFormset.frmPONotes.edtMisc_Purch.ReadOnly = .F.
			
		CASE pWhat = "ENABLE"
			ThisFormset.frmPOMaint.cmdView.Enabled = .T.
			ThisFormset.frmPOMaint.cmdPrintPO.Enabled = .T.
			ThisFormset.frmPOMaint.cmdEdit.Enabled = .T.
			ThisFormset.frmPOMaint.cmdSeeAll.Enabled = .T.
			ThisFormset.frmPOMaint.cmdQuit.Enabled = .T.
			
			ThisFormSet.frmPOMaint.pF1.pgEdit.Enabled = .T.
			ThisFormSet.frmPOMaint.pF1.pgBrowse.Enabled = .T.
			ThisFormSet.frmPOMaint.pF1.pgFind.Enabled = .T.
			ThisFormSet.frmPOMaint.pF1.pgStockLst.Enabled = .T.
			
			ThisFormset.frmPONotes.edtMisc_Purch.ReadOnly = .T.
		ENDCASE
		
	ENDPROC

	PROCEDURE deletecontactid
		PARAMETERS nContactID
		*ThisFormSet.DeleteContactID(nContactID)
		
		IF VARTYPE(nContactID)!="N"
			MESSAGEBOX("No ContactID in DeleteContactID",16,"Error")
			RETURN .F.
		ENDIF
		IF nContactID < 1
			MESSAGEBOX("No ContactID in DeleteContactID",16,"Error")
			RETURN .F.
		ENDIF
		
		PRIVATE lOKtoDelete,lSaveOK 
		lOKtoDelete = .T.
		lSaveOK 	= .T.
		
		PRIVATE cSQL, nSQLEXEC
		
		*************************
		*Quality Contact
		IF USED('cntVendorContact')	
			USE IN cntVendorContact
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.VendorContact WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
		cSQL = cSQL + " AND Quality = 1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorContact')
			IF cntVendorContact.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorContact
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in VendorContact table as a QA Contact!",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		
		*************************
		*QASurveyContactID
		IF USED('cntVendorContact')	
			USE IN cntVendorContact
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.Vendor WHERE QASurveyContactID= "+ALLTRIM(STR(nContactID)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorContact')
			IF cntVendorContact.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorContact
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in Vendor table as the QA Contact!",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		
		*************************
		*ContactID use in another PO
		
		PRIVATE nHpaPo
		nHpaPo	= PrepareSQLnum(ThisFormSet.frmPO.pgfPO.pgPODesc.txtHPApo.VALUE,'ERP PO',-3,0)
		
		IF USED('cntVendorContact')	
			USE IN cntVendorContact
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.PurchaseOrder WHERE ContactID= "+ALLTRIM(STR(nContactID)) 
		cSQL = cSQL +" AND HPAPO <>"+ALLTRIM(STR(nHPAPO))
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorContact')
			IF cntVendorContact.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorContact
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in another Purchase Order!",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		*************************
		
		cSQL = "DELETE FROM dbo.VendorContact "
		cSQL = cSQL + " WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			lSaveOK = .F.
		ELSE
			TrackMess( "Deleted Vendor ContactID:"+ALLTRIM(STR(nContactID)) )
			ThisFormSet.GetVendorContacts(0)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			ThisFormSet.frmPO.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmEoP) = "O"
			ThisFormSet.frmEoP.Release
		ENDIF
		*IF VARTYPE(ThisFormSet.frmPONotes) = "O"
		*	ThisFormSet.frmPONotes.Release
		*ENDIF
		IF VARTYPE(ThisFormSet.frmEO) = "O"
			ThisFormSet.frmEO.Release
		ENDIF
		*IF VARTYPE(ThisFormSet.frmStartingStock) = "O"
		*	ThisFormSet.frmStartingStock.Release
		*ENDIF
		IF VARTYPE(ThisFormSet.frmPOMaint) = "O"
			ThisFormSet.frmPOMaint.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmPORecv) = "O"
			ThisFormSet.frmPORecv.Release
		ENDIF
		
		IF VARTYPE(ThisFormSet.frmWO) = "O"
			ThisFormSet.frmWO.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmWOD) = "O"
			ThisFormSet.frmWOD.Release
		ENDIF
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
		IF "PURCHASEORDER" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\PURCHASEORDER"
		ENDIF
	ENDPROC

	PROCEDURE editpo		&& EditPO
		PARAMETERS pPOitem
		*ThisFormSet.EditPO(cPOitem)
		
		*!*	PRIVATE cPOitem
		*!*	cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,"POitem",13)
		
		IF TYPE("pPOitem") != "C"
			*Error
			MESSAGEBOX("EditPO did not receive the POitem",48,"Procedure Error")
			TrackError("Error","EditPO did not receive the parameter POitem","PurchaseOrder:EditPO",LINENO(1))
			RETURN .F.
		ENDIF
		
		
		IF EMPTY(pPOitem)
			MESSAGEBOX("EditPO did not receive the POitem",48,"Procedure Error")
			TrackError("Error","EditPO did not receive the parameter POitem - Empty.","PurchaseOrder:EditPO",LINENO(1))
			RETURN .F.
		ENDIF
		PRIVATE cPOitem
		cPOitem = Proper_PO_item( pPOitem )
		
		IF NOT PurchaseOrder_Allow_Cancel( pPOitem, ThisFormSet.nConnHandle )
			RETURN .F.
		ENDIF
		IF Proper_PO_item( cPOitem ) = Proper_PO_item( '' )
			MESSAGEBOX("No POitem to Edit",16,"Error")
			RETURN .F.
		ENDIF
		
		*************************************
		*Code from Edit button in EditOrder
		ThisFormSet.frmPO.ShowPOitem(cPOitem)
		ThisFormSet.EditPOScreen(.T.)
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			ThisFormSet.frmPO.PO_NewAdd = .F.
			ThisFormSet.frmPO.POEditing = .T.
			ThisFormSet.frmPO.POScreen("ENABLE")
			ThisFormSet.frmPO.PO_VALID("EDIT")
		
			*ThisFormSet.frmPO.RefreshPOForms(ThisFormset.frmPO.pgfPO.pgPODesc.cmbForm.Value )
		
			ThisFormSet.frmPO.Visible = .T.
			ThisFormSet.frmPOMaint.pf1.ActivePage = 1
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtCompany.SetFocus()
		ENDIF
	ENDPROC

	PROCEDURE editposcreen		&& 0 for No, 1 for Yes
		PARAMETERS pShow
		*ThisFormSet.EditPOScreen(lShowEdit)
		
		PRIVATE lShowEdit
		lShowEdit = .F.
		
		IF VARTYPE(pShow) = 'N'
			IF pShow = 0
				lShowEdit = .F.
			ENDIF
			IF pShow = 1
				lShowEdit = .T.
			ENDIF
		ELSE
			IF VARTYPE(pShow) = 'L'
				lShowEdit = pShow
			ELSE
				MESSAGEBOX("PurchaseOrder.EditPOScreen()",16,"Bad Parameter")
			ENDIF
		ENDIF
		
		IF lShowEdit
			ThisFormSet.frmPO.POScreen("ENABLE")
			ThisFormSet.AddressScreen("DISABLE")
		*	ThisFormset.frmPONotes.edtMisc_Purch.ReadOnly = .F.
		ELSE
			ThisFormSet.frmPO.POScreen("DISABLE")
			ThisFormSet.AddressScreen("ENABLE")
		*	ThisFormset.frmPONotes.edtMisc_Purch.ReadOnly = .T.
		ENDIF
	ENDPROC

	PROCEDURE formsrefresh
		*ThisFormSet.FormsRefresh()
		
		PRIVATE cForm
		cForm = '10'
		
		IF ThisFormSet.frmWO.Visible
			cForm = PrepareSQLtxt(ThisFormSet.frmWO.txtForm.Value,'Form',2)	
			
			IF NOT EMPTY(cForm)
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWO.lblThck1.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWO.lblSz21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWO.lblSz21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWO.lblSz31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWO.lblSz31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWO.txtSz3.Visible 		= tmpFormCaptions.use3rdDim
						*ThisFormSet.frmWO.txtSz3.Enabled 		= tmpFormCaptions.Sz3Enable	&&Do not edit here!
						ThisFormSet.frmWO.lblsz41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWO.lblsz41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
			***************************************
			cForm = PrepareSQLtxt(ThisFormSet.frmWO.txtFForm.Value,'Form',2)	
			
			IF NOT EMPTY(cForm)
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWO.lblFThck.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWO.lblFSz2.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWO.lblFSz2.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWO.lblFSz3.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWO.lblFSz3.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWO.txtFSz3.Visible 		= tmpFormCaptions.use3rdDim
						*ThisFormSet.frmWO.txtFSz3.Enabled 		= tmpFormCaptions.Sz3Enable 	&&Do not edit here!
						ThisFormSet.frmWO.lblFSz4.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWO.lblFSz4.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		********
		********
		********
		********
		IF ThisFormSet.frmWOD.Visible
			cForm = PrepareSQLtxt(ThisFormSet.frmWOD.txtForm.Value,'Form',2)	
			
			IF NOT EMPTY(cForm)
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWOD.lblThck1.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWOD.lblSz21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWOD.lblSz21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWOD.lblSz31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWOD.lblSz31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWOD.txtSz3.Visible 	= tmpFormCaptions.use3rdDim
						*ThisFormSet.frmWOD.txtSz3.Enabled 	= tmpFormCaptions.Sz3Enable	&&Do not edit here!
						ThisFormSet.frmWOD.lblsz41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWOD.lblsz41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
			***************************************
			cForm = PrepareSQLtxt(ThisFormSet.frmWOD.txtFForm.Value,'Form',2)	
			
			IF NOT EMPTY(cForm)
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWOD.lblFThck.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWOD.lblFSz2.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWOD.lblFSz2.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWOD.lblFSz3.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWOD.lblFSz3.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWOD.txtFSz3.Visible 		= tmpFormCaptions.use3rdDim
						*ThisFormSet.frmWOD.txtFSz3.Enabled 		= tmpFormCaptions.Sz3Enable	&&Do not edit here!
						ThisFormSet.frmWOD.lblFSz4.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWOD.lblFSz4.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
				
		RETURN
		
	ENDPROC

	PROCEDURE getpurchaseorders
		PARAMETERS pWhat
		*ThisFormSet.GetPurchaseOrders()
		
		PRIVATE nDays, lAll
		nDays = 0
		lAll = .F.
		
		
		IF VARTYPE(pWhat) = "N"
			nDays = pWhat
			ThisFormSet.AllRecordsRetrieved = .F.
		ENDIF
		IF VARTYPE(pWhat) = "C"
			IF pWhat = 'ALL'
				lAll = .T.
				ThisFormSet.AllRecordsRetrieved = .T.
				nDays = 0
			ENDIF
		ENDIF
		
		IF ThisFormSet.AllRecordsRetrieved 
			lAll = .T.
		ENDIF
		
		IF nDays <> -720  &&Used in INIT
			ThisFormSet.frmPOMaint.pf1.pgEdit.grdPO1.RecordSource = ''
			ThisFormSet.frmPOMaint.pf1.pgBrowse.GridBR.RecordSource = ''
			ThisFormSet.frmPOMaint.pf1.pgStockLst.GridSOi.RecordSource = ''
		ENDIF
		
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.PurchaseOrder WITH(NOLOCK) "
		IF nDays <> 0
			cSQL = cSQL + " WHERE OrderDate >= '"+DTOC( DATE()+nDays )+"'"
		ENDIF
		
		*!*	1SELECT [POitem]
		*!*	2      ,[HPApo]
		*!*	3      ,[ItemPO]
		*!*	4      ,[SOitem]
		*!*	5      ,[SalesNum]
		*!*	6      ,[Item]
		*!*	7      ,[SalesP]
		*!*	8      ,[Company]
		*!*	9      ,[Alloy]
		*!*	10      ,[Form]
		*!*	11      ,[CC]
		*!*	12      ,[Order_QTY]
		*!*	13      ,[Pieces]
		*!*	14      ,[Thck]
		*!*	15      ,[Sz2]
		*!*	16      ,[Sz3]
		*!*	17      ,[p_lb]
		*!*	18      ,[p_pc]
		*!*	19      ,[p_ft]
		*!*	20      ,[lotp]
		*!*	21      ,[OtherP]
		*!*	22      ,[OtherFld]
		*!*	23      ,[OrderDate]
		*!*	24      ,[Due_Min]
		*!*	25      ,[Due_Max]
		*!*	26      ,[Received]
		*!*	27      ,[Cond_Spec]
		*!*	28      ,[Misc_Purch]
		*!*	29      ,[Heat]
		*!*	30      ,[Cert]
		*!*	31      ,[ReceivedBy]
		*!*	32      ,[Receipt]
		*!*	33      ,[Delivered]
		*!*	34      ,[Cancelled]
		*!*	35      ,[POSalesP]
		*!*	36      ,[ShipVia]
		*!*	37      ,[JobNumber]
		*!*	38      ,[Services]
		*!*	39      ,[ConvServ]
		*!*	40      ,[Equipment]
		*!*	41      ,[Stock]
		*!*	42      ,[Sheet_pk]
		*!*	43      ,[ShipWhere]
		*!*	44      ,[POshipaddr]
		*!*	45      ,[POpayaddr]
		*!*	46      ,[Randlen]
		*!*	47      ,[Metric]
		*!*	48      ,[Sz1Orig]
		*!*	49      ,[Sz2Orig]
		*!*	50      ,[Sz3Orig]
		*!*	51      ,[DispAlloy]
		*!*	52      ,[StandSize]
		*!*	53      ,[Amendment]
		*!*	54      ,[Printed]
		*!*	55      ,[VendCode]
		*!*	56      ,[ContactID]
		*!*	57      ,[Terms]
		*!*	58      ,[FOB]
		*!*	59      ,[HPA_Due_Min]
		*!*	60      ,[HPA_Due_Max]
		*!*	61      ,[First_Due_Max]
		*!*	62      ,[Reconciled]
		*!*	63      ,[ReconcileTotal]
		*!*	64      ,[StockLst_QTY]
		*!*	65      ,[StockLst_P]
		*!*	66      ,[Order_P]
		*!*	67      ,[Order_PU]
		*!*	68      ,[Pounds]
		*!*	69      ,[BMScheck]
		*!*	70      ,[ShipLocation]
		*!*	71      ,[VendorPOConf]
		*!*	72      ,[Melt]
		*!*	73      ,[WO]
		*!*	74      ,[Cover]
		*!*	75      ,[WO_Detail]
		*!*	76      ,[IntP]
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
		ENDIF
		
		SELECT PurchaseOrder
		INDEX ON POitem TAG POitem
		SET ORDER TO POItem
		INDEX ON ValPOitem(POitem) TAG VALPOitem
		SET ORDER TO VALPOitem
		
		GO BOTTOM
		
		IF RECNO('PurchaseOrder') > 10
			SKIP -2
		ENDIF
		
		
		IF nDays <> -720  &&Used in INIT
			ThisFormSet.frmPOMaint.pf1.pgEdit.grdPO1.RecordSource = 'PurchaseOrder'
			ThisFormSet.frmPOMaint.pf1.pgBrowse.GridBR.RecordSource = 'PurchaseOrder'
			ThisFormSet.frmPOMaint.pf1.pgStockLst.GridSOi.RecordSource = 'PurchaseOrder'
		ENDIF
		
	ENDPROC

	PROCEDURE getvendorcontacts
		PARAMETERS nContactID
		*ThisFormSet.GetVendorContacts(nContactID)
		
		IF VARTYPE(nContactID)!="N"
			nContactID = 0
		ENDIF
		
		PRIVATE nVendCode 
		nVendCode = ThisFormSet.frmPO.nVendCode
		
		IF USED('VendorContacts')
		*	ThisFormSet.frmPOMaint.pf1.pg_po.pgfPO.pgVendorContact.lstContactID.RowSource = ''
			USE IN VendorContacts
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.VendorContact WITH(NOLOCK) "
		cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'VendorContacts')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'VendorContacts' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "VendorContacts")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "VendorContacts")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'VendorContacts' )
		ENDIF
		
		IF USED('VendorContacts')
			SELECT VendorContacts
			INDEX ON ContactID TAG ContactID
			SET ORDER TO ContactID
		
			SELECT ContactID FROM VendorContacts INTO ARRAY gaContactIDs
			GO TOP
		
			IF RECCOUNT('VendorContacts') < 1
				DIMENSION gaContactIDs(1)
				gaContactIDs(1) = 0
			ENDIF
		
			ThisFormSet.frmPO.pgfPO.pgVendorContact.lstContactID.NumberOfElements = ALEN(gaContactIDs,1)
			ThisFormSet.frmPO.pgfPO.pgVendorContact.lstContactID.RowSourceType = 5
			ThisFormSet.frmPO.pgfPO.pgVendorContact.lstContactID.RowSource = 'gaContactIDs'
			ThisFormSet.frmPO.pgfPO.pgVendorContact.lstContactID.Refresh
			*ThisFormSet.frmPO.pgfPO.pgVendorContact. ThisFormSet.frmPOMaint.pf1.pgAdd.pfAdd.pgVendorContact
			IF nContactID = 0
				nContactID = VendorContacts.ContactID
			ENDIF
		
			ThisFormSet.ShowVendorContact(nContactID)
		ELSE
			PRIVATE cBody
			cBody = "PurchaseOrder:GetVendorContacts(nContactID) "+ALLTRIM(STR(nContactID))+"<br/>"
			cBody = cBody + "Could not open table 'VendorContacts'."+"<br/>"
			cBody = cBody + HTML_VendCode(nVendCode,.T.)+"<br/>"
			cBody = cBody + cSQL 
			Send_HTML_Email("VFP_Alert@SpaceAlloysUSA.com", get_Server_Email(), "ThisFormSet.GetVendorContacts(nContactID)", cBody, ThisFormSet.nConnHandle, .T., .T.)   &&Proc_SQL
			
			MESSAGEBOX("Could not open table 'VendorContacts'.",16,"Error")
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pPOnum, cWhat
		*ThisForm.AlwaysOnTop = ..
		*DO FORM "c:\program files (x86)\hpa\forms\purchaseorder26.scx" WITH 502994
		*DO FORM Forms\purchaseorder26 WITH 12345, "EDIT"
		*DO FORM Forms\purchaseorder26 WITH 12345, "SHOW"
		
		PRIVATE nHPApo
		nHPApo = 0
		
		IF VARTYPE(pPOnum) = "N"
			ThisFormset.frmPOMaint.pf1.pgEdit.txtFindText.Value = STR(pPOnum)
			*ThisFormset.frmPOMaint.pf1.pgEdit.cmdFind.Click
			nHPApo = pPOnum
		ENDIF
		
		ThisFormSet.frmPO.nVendCode = 0
		ThisFormSet.OleDate = DATE()
		ThisFormSet.ncmbFind = 1
		ThisFormSet.FindText = 0
		
		*ThisFormSet.frmEoP.
		
		ThisFormSet.frmPoRecv.Top	= ThisFormSet.frmPOMaint.Top + ThisFormSet.frmPOMaint.Height + 30
		ThisFormSet.frmPoRecv.Left	= ThisFormSet.frmPOMaint.Left 
		&&+ ThisFormSet.frmPOMaint.Width + 10
		
		ThisFormSet.frmEditDelivery.Top		= ThisFormSet.frmPOMaint.Top + ThisFormSet.frmPOMaint.Height + 30
		ThisFormSet.frmEditDelivery.Left	= ThisFormSet.frmPOMaint.Left 
		
		ThisFormSet.frmPONotes.Top	= ThisFormSet.frmPOMaint.Top + ThisFormSet.frmPOMaint.Height + 30
		ThisFormSet.frmPONotes.Left	= ThisFormSet.frmPOMaint.Left + ThisFormSet.frmPOMaint.Width - ThisFormSet.frmPONotes.Width 
		
		ThisFormSet.frmPO.Visible = .F.
		ThisFormSet.frmPO.Left	= ThisFormSet.frmPOMaint.Left+6
		ThisFormSet.frmPO.Top	= ThisFormSet.frmPOMaint.Top + 60
		
		ThisFormSet.frmWO.Left	= ThisFormSet.frmPOMaint.Left+ThisFormSet.frmPOMaint.Width +15
		ThisFormSet.frmWO.Top	= ThisFormSet.frmPOMaint.Top - 2
		
		ThisFormSet.frmWOD.Left	= ThisFormSet.frmPOMaint.Left+ThisFormSet.frmPOMaint.Width +15
		ThisFormSet.frmWOD.Top	= ThisFormSet.frmPOMaint.Top + ThisFormSet.frmWO.Height + 20
		
		IF VARTYPE(cWhat) = "C"
			IF cWhat = "EDIT"
				
				PRIVATE cPOitem
				IF VARTYPE(pPOnum) = "N"
					cPOitem = PrepareSQLtxt(STR(pPOnum,9)+"-01",'POitem',12)
					
					IF cPOitem != Proper_PO_item('')
						ThisFormSet.EditPO(cPOitem)
						ThisFormSet.frmPO.pgfPO.ActivePage = 1
						
					ENDIF
				ENDIF
				
			ENDIF
			IF cWhat = "SHOW"
				SELECT PurchaseOrder
				LOCATE FOR HPAPo = nHPApo
				ThisFormset.frmPOMaint.pf1.pgEdit.grdPO1.Refresh
				ThisFormSet.RefreshEditTab()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		*IF TYPE("gcSalesp") = "U"
		*	PUBLIC gcSalesp
		*ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		ENDIF
		
		ThisFormSet.GetPurchaseOrders(-720)
		
		SET SAFETY OFF
	ENDPROC

	PROCEDURE receivepo		&& ReceivePO( purchaseorders.poitem )
		PARAMETER pPOitem
		*ReceivePO( PurchaseOrder.poitem ) 
		
		PRIVATE cPOitem
		IF TYPE('pPoItem') = "C"
			cPOitem = pPoItem
		ELSE
			cPOitem = "-"
		ENDIF
		cPOitem = Proper_PO_item( cPOitem )
		
				
		************************** StockLst SQL
		PRIVATE nStkMastCnt, cSQL_Master_PO, cSQL_Master_Update, cSQL_Master_Insert
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		cSQL ="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Master WITH(NOLOCK) WHERE PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle)
			nStkMastCnt = 0
		ELSE
			nStkMastCnt = StkMastCnt.counted
		ENDIF
		
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		
		IF nStkMastCnt > 0
			*This.FrmPO.AlwaysOnTop = .F.
			*This.frmPOMaint.Visible = .F.
			*ThisForm.AlwaysOnTop = .F.
		*	DO FORM forms\PORecvStock WITH pPOitem, pTableName, pnReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master, pnWO_Detail
			DO FORM Forms\PORecvStock WITH cPOitem,'StockLst' ,             0,            0,           0,    '',           0,     0
			*ThisForm.AlwaysOnTop = .T.
			*This.frmPOMaint.Visible = .T.
			*This.FrmPO.AlwaysOnTop = .T.
			
			*PARAMETER pPOitem, pnConn, pLst, pnReceivingID
		ELSE
			************************** StockLst SQL
		
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			cSQL ="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle)
				nStkMastCnt = 0
			ELSE
				nStkMastCnt = StkMastCnt.counted
			ENDIF
		
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
		
			IF nStkMastCnt > 0
				ThisForm.AlwaysOnTop = .F.
		*		DO FORM forms\PORecvStock WITH pPOitem, pTableName, pnReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master, pnWO_Detail
				DO FORM Forms\PORecvStock WITH cPOitem,'BrokerLst' ,             0,            0,           0,    '',           0,     0
		
				ThisForm.AlwaysOnTop = .T.
				*PARAMETER pPOitem, pnConn, pLst, pnReceivingID
			ELSE
				MESSAGEBOX( "No stock to mark as 'RECEIVED'",0,"Not found in SQL")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refreshedittab
		*ThisFormSet.RefreshEditTab()
		*Show when View grid after change, Any PO movement.
		*ThisFormSet.frmPOMaint.pf1.pgEdit is actually caption View!!!
		
		ThisFormSet.frmPO.cPOitem = PurchaseOrder.POitem
		ThisFormSet.frmPO.cSOitem = PurchaseOrder.SOitem
		
		DO CASE
		CASE IIF(ISNULL(PurchaseOrder.Order_PU),0,PurchaseOrder.Order_PU) = 1
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Lb"
		CASE IIF(ISNULL(PurchaseOrder.Order_PU),0,PurchaseOrder.Order_PU) = 2
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Ft"
		CASE IIF(ISNULL(PurchaseOrder.Order_PU),0,PurchaseOrder.Order_PU) = 3
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Pc"
		CASE IIF(ISNULL(PurchaseOrder.Order_PU),0,PurchaseOrder.Order_PU) = 4
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Lot"
		*---------------- depricate
		CASE PurchaseOrder.p_lb> 0 
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Lb"
		CASE PurchaseOrder.p_pc> 0 
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Pc"
		CASE PurchaseOrder.p_Ft> 0 
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Ft"
		CASE PurchaseOrder.LotP> 0 
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = "Lot"
		OTHERWISE
			ThisFormSet.frmPOMaint.pf1.pgEdit.lblUnit.Caption = ""
		ENDCASE
		
		**************
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtPoitem.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtSOitem.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtSalesp.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtPieces.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtAlloy.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtForm.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtThck.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtSz2.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtSz3.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtCompany.Refresh
		
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtReceived.Refresh 
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtQshipped.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtReceivedBy.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.txtHeat.Refresh
		
		ThisFormSet.frmPOMaint.pf1.pgEdit.edtCond_Spec.Refresh
		
		ThisFormSet.frmPOMaint.pf1.pgEdit.edtReceipt.Value = PrepareSQLtxt(PurchaseOrder.Receipt,'Receipt',-1)
		ThisFormSet.frmPOMaint.pf1.pgEdit.edtReceipt.Refresh
		ThisFormSet.frmPOMaint.pf1.pgEdit.edtMisc_Purch.Refresh
		
		**************
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkLab_Service.Value 	= PrepareSQLchk(PurchaseOrder.Services,'Services')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkConvServ.Value		= PrepareSQLchk(PurchaseOrder.ConvServ,'ConvServ')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkEquipment.Value	= PrepareSQLchk(PurchaseOrder.Equipment,'Equipment')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkComplete.Value		= PrepareSQLchk(PurchaseOrder.Delivered,'Delivered')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkReconciled.Value	= PrepareSQLchk(PurchaseOrder.Reconciled,'Reconciled')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkCert.Value			= PrepareSQLchk(PurchaseOrder.Cert,'Cert')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkCancel.Value		= PrepareSQLchk(PurchaseOrder.Cancelled,'Cancelled')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkIntP.Value			= PrepareSQLchk(PurchaseOrder.IntP,'IntP')
		ThisFormSet.frmPOMaint.pf1.pgEdit.chkVendorPOConf.Value	= PrepareSQLchk(PurchaseOrder.VendorPOConf,'VendorPOConf')
		
		
		IF NOT EMPTY(PurchaseOrder.Misc_Purch)
			ThisFormSet.frmPONotes.Visible = .T.
			ThisFormSet.frmPONotes.edtMisc_Purch.Value = PurchaseOrder.Misc_Purch
		ELSE
			ThisFormSet.frmPONotes.Visible = .F.
			ThisFormSet.frmPONotes.edtMisc_Purch.Value = ''		
		ENDIF		
		
		****************************************
		ThisFormSet.frmPORecv.Visible = .F.
		
		PRIVATE cTmpRecMess 
		cTmpRecMess = ''
			
		IF USED('tmpRecvPOitem')
			USE IN tmpRecvPOitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID,Received,BillW,R_QTY,ID_Master, StockTable, RejectPC, RMA_No "
		cSQL = cSQL + " FROM dbo.Receiving "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisFormSet.frmPO.cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecvPOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRecvPOitem' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpRecvPOitem')
		ELSE
			IF USED('tmpRecvPOitem')
				IF RECCOUNT('tmpRecvPOitem') > 0
					ThisFormSet.frmPORecv.Visible = .T.
					SCAN
						IF NOT EMPTY(cTmpRecMess)
							cTmpRecMess = cTmpRecMess +CHR(13)
						ENDIF
						cTmpRecMess = cTmpRecMess + "ID:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.ID,'ID',-3)))
						cTmpRecMess = cTmpRecMess + " Received:"+DTOC(PrepareSQLdate(tmpRecvPOitem.Received,'Received',.F.,.T.))+CHR(13)
						cTmpRecMess = cTmpRecMess + " BillW:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.BillW,'BillW',-3)))+"#"+CHR(13)
						cTmpRecMess = cTmpRecMess + " AcctQTY:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.R_QTY,'QTY',-3)))+"QTY "+CHR(13)
						cTmpRecMess = cTmpRecMess + " StockTable:"+PrepareSQLtxt(tmpRecvPOitem.StockTable,'StockTable',1)+CHR(13)
						cTmpRecMess = cTmpRecMess + " ID_Master:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.ID_Master,'ID_Master',-3)))+CHR(13)
						cTmpRecMess = cTmpRecMess + " RejectPC:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.RejectPC,'RejectPC',-3)))+CHR(13)
						cTmpRecMess = cTmpRecMess + " RMA_No :"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.RMA_No ,'RMA_No',-3)))+CHR(13)
						cTmpRecMess = cTmpRecMess + " ----------------------------------------"+CHR(13)
						
					ENDSCAN
					
					ThisFormSet.frmPORecv.edtPO_Recv.Value = cTmpRecMess 
					
				ENDIF
				USE IN tmpRecvPOitem
			ENDIF
		ENDIF
		
		ThisFormSet.ShowWO_WOD_Window()
		
		ThisFormSet.ShowDueNotes()
		
		*ThisFormSet.frmPOMaint.pf1.pgEdit.chkDeleted.Value = DELETED()
		*ThisFormSet.frmPOMaint.pf1.pgEdit.chkDeleted.Refresh
		
		*ThisFormSet.frmPOMaint.pf1.pgEdit.Vcr1.EnableDisableButtons()
		
	ENDPROC

	PROCEDURE refreshforms		&& Refresh fields when Form changes.
		PARAMETER pForm
		*ThisFormSet.RefreshForms(Form)
		*********************************************************************************
		** CHANGES HERE MUST BE REPLICATED TO PurchaseOrder, EnterOrder and PackingSlip
		** Form Changes must be made to Proc_Quotes.prg **
		*********************************************************************************
		
		DO CASE
		*10,Bar,11,Flat Bar,12,Hex Bar,13,Square Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,
		*40,Plate/Sheet,51,Strip,60,Tube,
		*65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,
		*75,Fastener,80,Disk,90,Machined
		CASE pForm = "10" &&Bar
		
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLTHCK1.Caption = "Dia:"
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ21.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ21.Caption = "X"
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ31.Visible = .F.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ31.Caption = ""
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ3.Visible = .F.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ41.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ41.Caption = "Bar"
		CASE pForm = "11" &&Flat Bar
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLTHCK1.Caption = "Bar:"
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ21.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ21.Caption = "X"
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ31.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ31.Caption = "  X"
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ3.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ41.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ41.Caption = "Flat Bar"
		CASE pForm = "12" &&Hex Bar
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLTHCK1.Caption = "Hex:"
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ21.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ21.Caption = "X"
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ31.Visible = .F.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ31.Caption = ""
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSZ3.Visible = .F.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ41.Visible = .T.
			ThisFormSet.frmPO.pgfPO.pgPODesc.LBLSZ41.Caption = "Hex Bar"
		CASE pForm = "20" &&Wire Spool
