	PROCEDURE frmPOMaint.pf1.pgEdit.chkIntP.Valid
		PRIVATE lThisVal,cPOitem, cSQL, nSQLEXEC
		cPOitem = PurchaseOrder.POitem
		
		IF VARTYPE(This.Value) = "L"
			lThisVal = This.Value
		ELSE
			IF VARTYPE(This.Value) = "N"
				lThisVal = (This.Value=1)
			ENDIF
		ENDIF
		
		IF lThisVal
		
			*Check lIntP
			PRIVATE cSOItem, lIsForStock, cStock
			cSOitem = PrepareSQLtxt(PurchaseOrder.SOitem,'SOitem',10)
			cStock	= PrepareSQLtxt(PurchaseOrder.Stock,'Stock',13)
			lIsForStock = isForStock(cStock)
			
			DO CASE
			CASE cSOItem = "ConvertSVC"
				MESSAGEBOX("PO Item cannot be a 'Conversion Service' and an 'Internal Production' at the same time.",16,"Cannot Save! - Retry Save.")
				This.Value = !lThisVal 
				RETURN .F.
			CASE cSOItem = "Equipment"
		*		MESSAGEBOX("PO Item cannot be a 'Equipment' and an 'Internal Production' at the same time.",16,"Cannot Save! - Retry Save.")
		*		This.Value = !lThisVal 
		*		RETURN .F.
			CASE cSOItem = "LabService"
				MESSAGEBOX("PO Item cannot be a 'Lab Service' and an 'Internal Production' at the same time.",16,"Cannot Save! - Retry Save.")
				This.Value = !lThisVal 
				RETURN .F.		
			ENDCASE
			
			IF NOT lIsForStock 
				MESSAGEBOX("This Item produced must all be declared as 'All for Stock'!",16,"Cannot Save! - Retry Save.")
				This.Value = !lThisVal 
				RETURN .F.
			ENDIF
			*IF UPPER(cStock) !=  "ALL FOR STOCK"
			*	cStock = "All for Stock"
			*ENDIF
		
		
			IF MESSAGEBOX("Are you sure you want to mark POitem:"+ALLTRIM(cPOitem)+" as 'Internal Production'?"+CHR(13)+"used to place Produced Material into Stock!",4+32,"Mark as Internal Production?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [IntP] = 1"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as 'Internal Production' for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					SELECT PurchaseOrder
					IF VARTYPE(PurchaseOrder.IntP) = "L"
						*PurchaseOrder.Services = .T.
						REPLACE IntP WITH .T.
					ELSE
						REPLACE IntP WITH 1
					ENDIF
				ENDIF
			ELSE
				This.Value = !lThisVal 
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark POitem:"+ALLTRIM(cPOitem)+" as 'Internal Production'?",4+32,"Mark as NOT Internal Production?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [IntP] = 0"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT 'Internal Production' for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					SELECT PurchaseOrder
					IF VARTYPE(PurchaseOrder.IntP) = "L"
						REPLACE PurchaseOrder.IntP WITH .F.
					ELSE
						REPLACE PurchaseOrder.IntP WITH 0
					ENDIF
				ENDIF
			ELSE
				*This.Value = IIF(lThisVal,0,1) &&Reverse
				This.Value = !lThisVal 
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdPO1.Refresh
		This.Parent.grdPO1.Setfocus
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.chkReconciled.Valid
		PRIVATE lThisVal
		IF VARTYPE(This.Value) = "L"
			lThisVal = This.Value
		ELSE
			IF VARTYPE(This.Value) = "N"
				lThisVal = (This.Value=1)
			ENDIF
		ENDIF
		
		IF NOT HavePermission('ReconcilePO')
			This.Value = IIF(lThisVal,0,1)
			RETURN .F.
		ENDIF
		
		PRIVATE cPOitem, cSQL, nSQLEXEC
		cPOitem = PurchaseOrder.POitem
		
		PRIVATE cTmpRecMess
		cTmpRecMess = ''
		
		IF lThisVal
			IF MESSAGEBOX("Are you sure you want to mark POitem:"+ALLTRIM(cPOitem)+" as Reconciled?",4+32,"Mark as Reconciled?") = 6
				*This.Value = 1
				**
				MESSAGEBOX("Not allowed to change here!"+CHR(13)+"Must change in Purchase Finalize Program.",0+64,"No change!")
				This.Value = 0 
				RETURN .F.
				*REPLACE Reconciled WITH .T. IN PurchaseOrder
				**
			ELSE
				This.Value = 0 
				RETURN .F.
			ENDIF
		
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark POitem:"+ALLTRIM(cPOitem)+" as Reconciled?",4+32,"Mark as NOT Reconciled?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Reconciled] = 0"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT Reconciled for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					***
					
					cSQL = "DELETE FROM dbo.Vendor_Invoice_Detail "
					cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
					ENDIF
					
					***
					*MESSAGEBOX("Marked as NOT Reconciled for POitem="+ALLTRIM(cPOitem),64,"Marked as NOT Reconciled")
					REPLACE Reconciled WITH .F. IN PurchaseOrder
					This.Value = 0
				ENDIF
			ELSE
				This.Value = 1
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdPO1.Refresh
		This.Parent.grdPO1.Setfocus
		RETURN .T.
		
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.chkLab_Service.Click
		PRIVATE lThisVal,cPOitem, cSQL, nSQLEXEC
		cPOitem = PurchaseOrder.POitem
		
		IF VARTYPE(This.Value) = "L"
			lThisVal = This.Value
		ELSE
			IF VARTYPE(This.Value) = "N"
				lThisVal = (This.Value=1)
			ENDIF
		ENDIF
		
		IF lThisVal
			IF MESSAGEBOX("Are you sure you want to mark POitem:"+ALLTRIM(cPOitem)+" as 'Service Only'?",4+32,"Mark as Service?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Services] = 1"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as 'Service Only' for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					SELECT PurchaseOrder
					IF VARTYPE(PurchaseOrder.Services) = "L"
						*PurchaseOrder.Services = .T.
						REPLACE Services WITH .T.
					ELSE
						REPLACE Services WITH 0
					ENDIF
				ENDIF
			ELSE
				This.Value = IIF(lThisVal,0,1) &&Reverse
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark POitem:"+ALLTRIM(cPOitem)+" as 'Service Only'?",4+32,"Mark as NOT Service?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Services] = 0"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT 'Service Only' for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					SELECT PurchaseOrder
					IF VARTYPE(PurchaseOrder.Services) = "L"
						REPLACE Services WITH .F.
					ELSE
						REPLACE Services WITH 0
					ENDIF
				ENDIF
			ELSE
				This.Value = IIF(lThisVal,0,1) &&Reverse
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdPO1.Refresh
		This.Parent.grdPO1.Setfocus
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.chkVendorPOConf.Valid
		PRIVATE lThisVal, nHPAPO, cSQL, nSQLEXEC, cPOitem
		nHPAPO	= PurchaseOrder.HPAPO
		cPOitem = PurchaseOrder.POitem
		
		IF VARTYPE(This.Value) = "L"
			lThisVal = This.Value
		ELSE
			IF VARTYPE(This.Value) = "N"
				lThisVal = (This.Value=1)
			ENDIF
		ENDIF
		
		IF lThisVal
			IF MESSAGEBOX("Are you sure you want to mark PO:"+ALLTRIM(STR(nHPAPO))+CHR(13)+" as Receipt is Confirmed?",4+32,"Mark as Confirmed?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [VendorPOConf] = 1"
				cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as VendorPOConf for HPAPO:"+STR(nHPAPO)+" in PurchaseOrder" )
					*MESSAGEBOX("Changes will not show until you restart this program."+CHR(13)+"Restart to refresh data.",0+64,"Saved as Delivered!")
					
					ThisFormSet.ReloadPurchaseOrder(cPOItem)
		
				ENDIF
				
			ELSE
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark PO:"+ALLTRIM(STR(nHPAPO))+CHR(13)+" as Receipt Confirmed?",4+32,"Mark as NOT received?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [VendorPOConf] = 0"
				cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT receipt confirmed for HPAPO:"+ALLTRIM(STR(nHPAPO))+" in PurchaseOrder" )
		
					ThisFormSet.ReloadPurchaseOrder(cPOItem)
		
				ENDIF
						
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdPO1.Refresh
		This.Parent.grdPO1.Setfocus
		
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.Click
		SELECT PurchaseOrder
		*SET ORDER TO POItem
