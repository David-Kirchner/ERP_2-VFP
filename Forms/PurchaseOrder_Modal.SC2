		ThisFormSet.ncmbFind = This.Value
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgFind.cmbFind.Valid
		PRIVATE IntcmbFind
		IntcmbFind = INT(This.Value)
		DO CASE
		CASE IntcmbFind = 1
			*HPAPO n,9
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		CASE IntcmbFind = 2
			*Salesnum n,7
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999"
		CASE IntcmbFind = 3
			*Company c,30
			ThisFormSet.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 4
			*SOitem c,10
			ThisFormSet.FindText = SPACE(10)
			This.Parent.txtFindText.InputMask =	"99999-99"
		CASE IntcmbFind = 5
			*WO n,4
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999"
		CASE IntcmbFind = 6
			*WOD n,4
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999"
		ENDCASE
		This.Parent.txtFindText.Refresh
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgFind.cmdFind.Valid
		PRIVATE IntcmbFind,ncomp
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace ThisFormSet.FindText
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		IntcmbFind = INT(ThisFormSet.ncmbFind)
		*Purchase Order,Sales Order,Customer,SalesOrder-Item
		*SET EXACT OFF
		SELECT PurchaseOrder
		DO CASE
		CASE IntcmbFind = 1
			*HPApo n,9
			SELECT COUNT(*) FROM PurchaseOrder WHERE HPApo = lnText2Find INTO ARRAY anFound
			IF anFound(1) > 0
				BROW for HPApo = lnText2Find TITLE "ESC to close this find window." NOEDIT NOAPPEND
			ELSE
				MESSAGEBOX("HPApo ="+ALLTRIM(STR(lnText2Find))+CHR(10)+CHR(10)+"Click 'See All' to search beyond past 2 years.",0,"Not Found")
			ENDIF
		CASE IntcmbFind = 2
			SELECT COUNT(*) FROM PurchaseOrder WHERE SalesNum = lnText2Find INTO ARRAY anFound
			IF anFound(1) > 0
				*SalesNum n,7
				BROWSE for (SalesNum) = lnText2Find TITLE "ESC to close this find window." NOEDIT NOAPPEND
			ELSE
				MESSAGEBOX("SalesNum ="+ALLTRIM(STR(lnText2Find))+CHR(10)+CHR(10)+"Click 'See All' to search beyond past 2 years.",0,"Not Found")
			ENDIF	
		CASE IntcmbFind = 3
			*Company c,30
			COUNT TO ncomp for UPPER(Company) = UPPER(lcText2Find)
			IF ncomp > 0
				BROW for UPPER(Company) = UPPER(lcText2Find) TITLE "ESC to close this find window." NOEDIT NOAPPEND
			ELSE
				COUNT TO ncomp for LEFT(UPPER(Company),4) = LEFT(UPPER(lcText2Find ),4)
				IF ncomp > 0
					BROW for LEFT(UPPER(Company),4) = LEFT(UPPER(lcText2Find ),4) TITLE "ESC to close. Matched first 4 letters." NOEDIT NOAPPEND
				ELSE
					COUNT TO ncomp for LEFT(UPPER(Company),2) = LEFT(UPPER(lcText2Find ),2)
					IF ncomp > 0
						BROW for LEFT(UPPER(Company),2) = LEFT(UPPER(lcText2Find ),2) TITLE "ESC to close. Matched first 2 letters." NOEDIT NOAPPEND
					ELSE
						BROW for LEFT(UPPER(Company),1) = LEFT(UPPER(lcText2Find ),1) TITLE "ESC to close. Matched first 1 letter only." NOEDIT NOAPPEND
					ENDIF
				ENDIF
			ENDIF
		CASE IntcmbFind = 4
			cSOitem = Proper_SO_item( lcText2Find )
			SELECT COUNT(*) FROM PurchaseOrder WHERE SOitem = cSOitem INTO ARRAY anFound
			IF anFound(1) > 0
				*SOitem c,10
				BROWSE for SOitem = cSOitem TITLE "ESC to close this find window." NOEDIT NOAPPEND
			ELSE
				MESSAGEBOX("SOitem ='"+cSOitem+"'"+CHR(10)+CHR(10)+"Click 'See All' to search beyond past 2 years." ,0,"Not Found")
			ENDIF	
		CASE IntcmbFind = 5
			SELECT COUNT(*) FROM PurchaseOrder WHERE WO = lnText2Find INTO ARRAY anFound
			IF anFound(1) > 0
				*WO n,4
				BROWSE for (WO) = lnText2Find TITLE "ESC to close this find window." NOEDIT NOAPPEND
			ELSE
				MESSAGEBOX("WO ="+ALLTRIM(STR(lnText2Find))+CHR(10)+CHR(10)+"Click 'See All' to search beyond past 2 years.",0,"Not Found")
			ENDIF
		CASE IntcmbFind = 6
			SELECT COUNT(*) FROM PurchaseOrder WHERE WO_Detail = lnText2Find INTO ARRAY anFound
			IF anFound(1) > 0
				*WOD n,4
				BROWSE for (WO_Detail) = lnText2Find TITLE "ESC to close this find window." NOEDIT NOAPPEND
			ELSE
				MESSAGEBOX("WO_Detail ="+ALLTRIM(STR(lnText2Find))+CHR(10)+CHR(10)+"Click 'See All' to search beyond past 2 years.",0,"Not Found")
			ENDIF
		ENDCASE
		*SET EXACT ON
	ENDPROC

