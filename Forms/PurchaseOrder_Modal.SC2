	PROCEDURE showwo_wodetail
		PARAMETERS nWO_Detail
		*ThisFormSet.ShowWO_WODetail(tmpWO.WO_Detail)
		
		IF VARTYPE(nWO_Detail) != "N"
			MESSAGEBOX("Bad Parameter",0,"No nWO_Detail")
			RETURN .F.
		ENDIF
		
		
		*Get WOs from Choose
		
		
		IF USED('tmpWO_Detail')
		
			SELECT tmpWO_Detail
			LOCATE FOR WO_Detail = nWO_Detail
			
			IF FOUND('tmpWO_Detail')
				
				ThisFormset.frmWO.txtFPieces.Value	= PrepareSQLnum(tmpWO_Detail.fPieces,'Pieces',-3)
				ThisFormset.frmWO.txtFAlloy.Value	= PrepareSQLtxt(tmpWO_Detail.fAlloy,'Alloy',12)
				ThisFormset.frmWO.txtFForm.Value		= PrepareSQLtxt(tmpWO_Detail.fForm,'Form',2)
				*ThisFormSet.RefreshFForms(tmpWO_Detail.fForm)
				ThisFormset.frmWO.txtFcc.Value		= PrepareSQLtxt(tmpWO_Detail.fCC,'CC',1)
				ThisFormset.frmWO.txtFThck.Value		= PrepareSQLnum(tmpWO_Detail.fThck,'Thck',10,4)
				ThisFormset.frmWO.txtFSz2.Value		= PrepareSQLnum(tmpWO_Detail.fSz2,'Sz2',9,3)
				ThisFormset.frmWO.txtFSz3.Value		= PrepareSQLnum(tmpWO_Detail.fSz3,'Sz3',9,3)
				ThisFormset.frmWO.txtFWeight.Value 	= PrepareSQLnum(tmpWO_Detail.fWeight,'Weight',9,1)
		
				ThisFormSet.frmWO.txtFID_Detail.Value = PrepareSQLnum(tmpWO_Detail.fID_Detail,'ID_Detail',-3)
				ThisFormSet.frmWO.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWO_Detail.fID_Detail_Process,'ID_Detail_Process',-3)
				ThisFormSet.frmWO.txtFSOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fSOitem,'SOitem',10)
				ThisFormSet.frmWO.txtFPOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fPOitem,'POitem',12)
				ThisFormSet.frmWO.txtFDescript.Value	= PrepareSQLtxt(tmpWO_Detail.fDescript,'Descript',100)
				ThisFormSet.frmWO.txtFDueDate.Value	= PrepareSQLdate(tmpWO_Detail.fDueDate,'DueDate')
				ThisFormSet.frmWO.chkDetail_Complete.Value	= PrepareSQLchk(tmpWO_Detail.fCmplt,'Cmplt')
				
		
		*!*		IF ThisFormSet.CheckFinish_ID_Detail()
		*!*		ENDIF
		*!*		IF ThisFormSet.CheckFinish_ID_Detail_Process()
		*!*		ENDIF
					
			ELSE
				MESSAGEBOX("Could not find WO_Detail:"+ALLTRIM(STR(nWO_Detail)),0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showwo_wod_window		&& Displays WO and WO_Detail atached to PO,  Inivisble if not needed.
		*ThisFormSet.ShowWO_WOD_window()
		
		ThisFormSet.ShowWOD('WONotVisible')
		ThisFormSet.ShowWOD('WODNotVisible')
		ThisFormSet.ShowWO('WONotVisible')
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(PurchaseOrder.WO,'WO',-3)
		nWO_Detail	= PrepareSQLnum(PurchaseOrder.WO_Detail,'WO_Detail',-3) 
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF nWO > 0
			
			IF USED('tmpWO')
				USE IN tmpWO
			ENDIF
			SELECT 0
		
			PRIVATE cSQL, nSQLEXEC 
		
			cSQL = "SELECT * FROM dbo.WorkOrder "
			cSQL = cSQL + " WHERE WO = "+STR(nWO)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
			ELSE
				IF USED('tmpWO')
					*ThisFormSet.ShowWO('WOVisible')
					ThisFormSet.frmWO.Visible = .T.
						
					ThisFormset.frmWO.txtWO.Value 		= tmpWO.WO
					*ThisFormset.frmWO.txtWO_Detail.Value 		= &&Filled later ShowWO_WODetail(nWO_Detail)
					ThisFormset.frmWO.txtPieces.Value	= tmpWO.sPieces
					ThisFormset.frmWO.txtAlloy.Value	= tmpWO.sAlloy
					ThisFormset.frmWO.txtForm.Value		= tmpWO.sForm
					*ThisFormSet.RefreshForms(tmpWO.sForm)
					ThisFormset.frmWO.txtCC.Value		= tmpWO.sCC
					ThisFormset.frmWO.txtThck.Value		= tmpWO.sThck
					ThisFormset.frmWO.txtSz2.Value		= tmpWO.sSz2
					ThisFormset.frmWO.txtSz3.Value		= tmpWO.sSz3
					ThisFormset.frmWO.txtWeight.Value	= tmpWO.sWeight
					ThisFormSet.frmWO.txtID_Detail.Value = tmpWO.sID_Detail
					ThisFormSet.frmWO.txtID_Detail_Process.Value = tmpWO.sID_Detail_Process
					ThisFormset.frmWO.txtStartDate.Value	= tmpWO.StartDate
					ThisFormset.frmWO.txtDescript.Value	= tmpWO.Descript
					ThisFormSet.frmWO.txtSOitem.Value	= PrepareSQLtxt(tmpWO.SOitem,'SOitem',10)
					*ThisFormSet.frmWO.txtPOitem.Value	= PrepareSQLtxt(tmpWO.POitem,'POitem',12)
					ThisFormset.frmWO.txtSalesRep.Value	= tmpWO.SalesRep
					
					ThisFormset.frmWO.txtFPieces.Value	= 0
					ThisFormset.frmWO.txtFAlloy.Value	= ''
					ThisFormset.frmWO.txtFForm.Value	= ''
					ThisFormset.frmWO.txtFcc.Value		= ''
					ThisFormset.frmWO.txtFThck.Value	= 0
					ThisFormset.frmWO.txtFSz2.Value		= 0
					ThisFormset.frmWO.txtFSz3.Value		= 0
					ThisFormset.frmWO.txtFWeight.Value 	= 0
		
					ThisFormSet.frmWO.txtFID_Detail.Value 	= 0
					ThisFormSet.frmWO.txtFID_Detail_Process.Value = 0
					ThisFormSet.frmWO.txtFSOitem.Value		= ''
					ThisFormSet.frmWO.txtFPOitem.Value		= ''
					
					ThisFormSet.frmWO.txtFDescript.Value	= ''
					ThisFormSet.frmWO.txtFDueDate.Value		= CTOD('')
					ThisFormSet.frmWO.chkDetail_Complete.Value	= 0
					
					************************
					IF NOT USED('tmpWO_Detail')
		
						PRIVATE cSQL, nSQLEXEC 
		
						IF USED("tmpWO_Detail")	
							USE IN tmpWO_Detail
						ENDIF
						SELECT 0
		
						cSQL = "SELECT * FROM dbo.WorkOrder_Detail WHERE WO="+ALLTRIM(STR(nWO))
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
						ELSE
							IF USED('tmpWO_Detail')
								IF RECCOUNT('tmpWO_Detail') > 0
									*IF nWO_Detail = 0
										nWO_Detail = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
									*ENDIF
								ENDIF
							ENDIF
						ENDIF
					ELSE
						nWO_Detail = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
					ENDIF
		
					DIMENSION gaWO_Detail(1)
					gaWO_Detail(1) = 0
					****************************
					IF nWO_Detail > 0
					
						SELECT WO_Detail FROM tmpWO_Detail INTO ARRAY gaWO_Detail
						*ThisFormSet.frmWO.lstWO.NumberOfElements = ALEN(gaWO_Detail,1)
						ThisFormSet.frmWO.lstWO_Detail.NumberOfElements = ALEN(gaWO_Detail,1)
		
						SELECT tmpWO_Detail 
						GO TOP
						ThisFormSet.frmWO.lstWO_Detail.Value = tmpWO_Detail.WO_Detail 
						ThisFormSet.frmWO.txtWO_Detail.Value = tmpWO_Detail.WO_Detail 
						
						ThisFormSet.ShowWO_WODetail(nWO_Detail)
					ELSE
						ThisFormSet.frmWO.lstWO_Detail.NumberOfElements = 0
					ENDIF
					
					USE IN tmpWO
				ENDIF
			ENDIF
		ELSE
			ThisFormSet.frmWO.Visible = .F.
		ENDIF
		
		*Do not use the nWO_Detail found from nWO, Only use from PurchaseOrder
		nWO_Detail	= PrepareSQLnum(PurchaseOrder.WO_Detail,'WO_Detail',-3) 
		IF nWO_Detail > 0
		
			IF USED("tmpWO_WO_Detail")	
				USE IN tmpWO_WO_Detail
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * FROM dbo.WorkOrder_Detail WOD "
			cSQL = cSQL + " INNER JOIN dbo.WorkOrder WO ON WO.WO = WOD.WO "
			cSQL = cSQL + " WHERE WOD.WO_Detail="+ALLTRIM(STR(nWO_Detail))
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_WO_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_WO_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_WO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_WO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_WO_Detail')
			ENDIF
		
			*Get WOs from Choose
			IF USED('tmpWO_WO_Detail')
				IF RECCOUNT('tmpWO_WO_Detail') > 0
					*ThisFormSet.ShowWOD('WODVisible')
					ThisFormSet.frmWOD.Visible = .T.								
					
					ThisFormset.frmWOD.txtWO.Value 			= tmpWO_WO_Detail.WO
					ThisFormset.frmWOD.txtWO_Detail.Value 	= tmpWO_WO_Detail.WO_Detail
					ThisFormset.frmWOD.txtPieces.Value		= tmpWO_WO_Detail.sPieces
					ThisFormset.frmWOD.txtAlloy.Value		= tmpWO_WO_Detail.sAlloy
					ThisFormset.frmWOD.txtForm.Value		= tmpWO_WO_Detail.sForm
					*ThisFormSet.RefreshForms(tmpWO_WO_Detail.sForm)
					ThisFormset.frmWOD.txtCC.Value			= tmpWO_WO_Detail.sCC
					ThisFormset.frmWOD.txtThck.Value		= tmpWO_WO_Detail.sThck
					ThisFormset.frmWOD.txtSz2.Value			= tmpWO_WO_Detail.sSz2
					ThisFormset.frmWOD.txtSz3.Value			= tmpWO_WO_Detail.sSz3
					ThisFormset.frmWOD.txtWeight.Value		= tmpWO_WO_Detail.sWeight
					ThisFormSet.frmWOD.txtID_Detail.Value	= tmpWO_WO_Detail.sID_Detail
					ThisFormSet.frmWOD.txtID_Detail_Process.Value = tmpWO_WO_Detail.sID_Detail_Process
					ThisFormset.frmWOD.txtStartDate.Value	= tmpWO_WO_Detail.StartDate
					ThisFormset.frmWOD.txtDescript.Value	= tmpWO_WO_Detail.Descript
					ThisFormSet.frmWOD.txtSOitem.Value		= PrepareSQLtxt(tmpWO_WO_Detail.SOitem,'SOitem',10)
					ThisFormSet.frmWOD.txtPOitem.Value		= PrepareSQLtxt(tmpWO_WO_Detail.POitem,'POitem',12)
					ThisFormset.frmWOD.txtSalesRep.Value	= tmpWO_WO_Detail.SalesRep
					***
					ThisFormset.frmWOD.txtFPieces.Value		= PrepareSQLnum(tmpWO_WO_Detail.fPieces,'Pieces',-3)
					ThisFormset.frmWOD.txtFAlloy.Value		= PrepareSQLtxt(tmpWO_WO_Detail.fAlloy,'Alloy',12)
					ThisFormset.frmWOD.txtFForm.Value		= PrepareSQLtxt(tmpWO_WO_Detail.fForm,'Form',2)
					ThisFormset.frmWOD.txtFcc.Value			= PrepareSQLtxt(tmpWO_WO_Detail.fCC,'CC',1)
					ThisFormset.frmWOD.txtFThck.Value		= PrepareSQLnum(tmpWO_WO_Detail.fThck,'Thck',10,4)
					ThisFormset.frmWOD.txtFSz2.Value		= PrepareSQLnum(tmpWO_WO_Detail.fSz2,'Sz2',9,3)
					ThisFormset.frmWOD.txtFSz3.Value		= PrepareSQLnum(tmpWO_WO_Detail.fSz3,'Sz3',9,3)
					ThisFormset.frmWOD.txtFWeight.Value 	= PrepareSQLnum(tmpWO_WO_Detail.fWeight,'Weight',9,1)
		
					ThisFormSet.frmWOD.txtFID_Detail.Value 	= PrepareSQLnum(tmpWO_WO_Detail.fID_Detail,'ID_Detail',-3)
					ThisFormSet.frmWOD.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWO_WO_Detail.fID_Detail_Process,'ID_Detail_Process',-3)
					ThisFormSet.frmWOD.txtFSOitem.Value		= PrepareSQLtxt(tmpWO_WO_Detail.fSOitem,'SOitem',10)
					ThisFormSet.frmWOD.txtFPOitem.Value		= PrepareSQLtxt(tmpWO_WO_Detail.fPOitem,'POitem',12)
		
					ThisFormSet.frmWOD.txtFDescript.Value	= PrepareSQLtxt(tmpWO_WO_Detail.fDescript,'Descript',100)
					ThisFormSet.frmWOD.txtFDueDate.Value		= PrepareSQLdate(tmpWO_WO_Detail.fDueDate,'DueDate')
					ThisFormSet.frmWOD.chkDetail_Complete.Value	= PrepareSQLchk(tmpWO_WO_Detail.fCmplt,'Cmplt')
					
				ENDIF
				USE IN tmpWO_WO_Detail
			ENDIF
		ELSE
			ThisFormSet.frmWOD.Visible = .F.
		ENDIF
		
		ThisFormSet.FormsRefresh()
	ENDPROC

	PROCEDURE stocklstdetail
		PARAMETER pWhat, pStockLstDetail
		
		
		PRIVATE nStkMastCnt, cSQL, nMaster_ID
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		cSQL ="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Detail WHERE ID_Detail = "+STR(pStockLstDetail)
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle)
			nStkMastCnt = 0
		ELSE
			nStkMastCnt = StkMastCnt.counted
		ENDIF
		
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		
		IF nStkMastCnt > 0
			ThisFormSet.frmPOMaint.AlwaysOnTop = .F.
			DO FORM Forms\StockLst_Detail WITH "EDIT", pStockLstDetail, 0, 0
			ThisFormSet.frmPOMaint.AlwaysOnTop = .T.
			ThisFormSet.RefreshStockLstTab()
		ELSE
			MESSAGEBOX( "No Detail stock to edit.",0,"Not found in SQL")
		ENDIF
	ENDPROC

	PROCEDURE stocklstmaster
		PARAMETER pStockLstID
		*
		
		PRIVATE nStkMastCnt, cSQL_Master_PO, cSQL_Master_Update, cSQL_Master_Insert, nMaster_ID
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		cSQL ="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Master WHERE ID = "+STR(pStockLstID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StkMastCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkMastCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle)
			nStkMastCnt = 0
		ELSE
			nStkMastCnt = StkMastCnt.counted
		ENDIF
		
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		
		IF nStkMastCnt > 0
			ThisFormSet.frmPOMaint.AlwaysOnTop = .F.
			DO FORM Forms\StockLst_Master WITH "EDIT", pStockLstID, 'StockLst'
			ThisFormSet.frmPOMaint.AlwaysOnTop = .T.
			ThisFormSet.RefreshStockLstTab()
		ELSE
			MESSAGEBOX( "No master stock to edit.",0,"Not found in SQL")
		ENDIF
	ENDPROC

	PROCEDURE Unload
		
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder 
		ENDIF
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		
		
		= SQLDISCONNECT( ThisFormSet.nConnHandle )
		
		
	ENDPROC

	PROCEDURE frmEditDelivery.cmdEdit.Click
		IF This.Caption = "Edit"
			*Put in edit Mode
			ThisForm.edtNotes.ReadOnly = .F.
			ThisForm.txtHPA_Due_Max.Enabled = .T.
			This.Caption = "Save"
			ThisForm.cmdReturn.Caption = "Cancel"
			ThisForm.cmdReturn.Visible = .T.
			
		ELSE
			*Save and set Read only.
			PRIVATE cPOitem
			cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,'POitem',12)
			
			****************************************
			PRIVATE cSQL2, cSQL, nSQLEXEC 
			cSQL2 = ''
			
			PRIVATE dHPA_Date_Update
			dHPA_Date_Update = PrepareSQLdate(ThisForm.txtHPA_Due_Max.Value,'HPA_Due_Max')
			
			cSQL = "UPDATE dbo.PurchaseOrder "
			cSQL = cSQL + " SET HPA_Due_Max = '"+DTOC(dHPA_Date_Update)+"'" 
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
			ELSE
				TrackMess( cSQL +" in PurchaseOrder, Edit due date." )
			ENDIF
			****************************************
			
			PRIVATE cProcessNotes
			cProcessNotes = PrepareSQLtxt(ThisForm.edtNotes.Value,'Notes',-3)
			
			
			IF LEN(cProcessNotes) > 0	
				IF USED('tmpProcessNotes')
					USE IN tmpProcessNotes
				ENDIF
				SELECT 0
		
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PO_ProcessNotes "
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProcessNotes')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpProcessNotes' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProcessNotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProcessNotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpProcessNotes')
				ELSE
					IF USED('tmpProcessNotes')
						IF RECCOUNT('tmpProcessNotes') > 0
							IF tmpProcessNotes.CNTD > 0
								*Update
								cSQL2 = "UPDATE dbo.PO_ProcessNotes "
								cSQL2 = cSQL2 + " SET Notes = '"+cProcessNotes +"'"
								cSQL2 = cSQL2 + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
							ELSE
								*Insert
								cSQL2 = "INSERT INTO dbo.PO_ProcessNotes "
								cSQL2 = cSQL2 + " ( POitem,Notes ) VALUES "
								cSQL2 = cSQL2 + " (  '"+cPOitem+"'"
								cSQL2 = cSQL2 + ",'"+cProcessNotes+"' )"
							ENDIF
						ENDIF
						USE IN tmpProcessNotes
					ENDIF
				ENDIF
				
				IF NOT EMPTY(cSQL2)
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL2 )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL2 )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL2, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL2, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL2, ThisFormSet.nConnHandle,'')
					ELSE
						TrackMess( cSQL2 +" in PurchaseOrder, Edit Due Notes." )
						WAIT WINDOW 'Saved!' NOWAIT
					ENDIF
				
				ENDIF
			ENDIF && LEN(cProcessNotes)
			****************************************
			
			ThisForm.edtNotes.ReadOnly = .T.
			ThisForm.txtHPA_Due_Max.Enabled = .F.
			This.Caption = "Edit"
			ThisForm.cmdReturn.Caption = "Return"
			ThisForm.cmdReturn.Visible = .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEditDelivery.cmdReturn.Click
		IF This.Caption = "Cancel"
			*place in ReadOnly mode, refresh data
			
			ThisForm.edtNotes.ReadOnly = .T.
			ThisForm.txtHPA_Due_Max.Enabled = .F.
			ThisForm.cmdEdit.Caption = "Edit"
			This.Caption = "Return"
			This.Visible = .F.
		ELSE
		
			ThisForm.cmdEdit.Caption = "Edit"
		
			*ThisForm.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmEditDelivery.lblDatePicker.Click
		IF ThisForm.cmdEdit.Caption = "Edit"
			RETURN .F.
		ENDIF
		
		PRIVATE dDate1,dDate2
		dDate1 = ThisForm.txtHPA_Due_Max.Value
		
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		ThisForm.txtHPA_Due_max.Value = dDate2
		ThisForm.txtHPA_Due_max.Refresh
		ThisForm.txtHPA_Due_max.SetFocus
	ENDPROC

