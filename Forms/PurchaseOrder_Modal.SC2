	PROCEDURE frmWOD.cmdEditWO.Click
		PRIVATE nWO_D,nWO,cPOitem,cSOitem,cInqNumP,lReturn
		nWO_D = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		cInqNumP = ''
		
		*DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWO_D,cPOitem,cSOitem,cInqNumP TO lReturn
		*DO FORM Forms\WorkOrder_Detail WITH "EDIT",nWO_Detail,nWO,cPOitem,cSOitem,cInqNumP TO lReturn
		DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWO_D,cPOitem,cSOitem,cInqNumP
	ENDPROC

	PROCEDURE frmWOD.Label4.Click
		*!*	PRIVATE nHPAPO, cPoItem
		*!*	cPoItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		*!*	nHPAPO = VAL(cPoItem)
		
		*!*	IF nHPAPO = 0
		*!*		DO FORM Forms\SelectPO_item TO cPoItem
		*!*	ELSE
		*!*		DO FORM Forms\ChoosePOitem WITH nHPAPO TO cPoItem
		*!*	ENDIF
		
		*!*	IF VARTYPE(cPoItem) = "C"
		*!*		IF Proper_PO_item(cPoItem) = Proper_PO_item('')
		*!*			ThisForm.txtPOitem.Value = ''
		*!*		ELSE
		*!*			ThisForm.txtPOitem.Value = cPOitem
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.txtPOitem.Value = ''
		*!*	ENDIF
		
		*!*	IF Proper_PO_item(cPoItem) != Proper_PO_item('')
		*!*		IF MESSAGEBOX("Do you want this PO to fill in Alloy, Form, Etc...?",4+32,"Overwrite WO with PO info?") = 6
		*!*			ThisFormSet.AddbyPOitem(cPOitem)
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE frmWOD.lblChooseF_SOitem.Click
		*!*	PRIVATE nSalesNum, cSOItem
		*!*	cSOItem = PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		*!*	nSalesNum = VAL(cSoItem)
		
		*!*	PRIVATE lSelectedTheOnlySOitem
		*!*	lSelectedTheOnlySOitem = .F.
		
		*!*	IF nSalesNum = 0
		*!*		DO FORM Forms\SalesOrder_Select WITH "ChooseSO" TO nSalesNum
		*!*		IF nSalesNum > 0
		*!*			IF Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, '') = 1
		*!*				lSelectedTheOnlySOitem = .T.		
		*!*				cSOItem = Proper_SO_item(STR(nSalesNum,7)+"-01")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF nSalesNum > 0 AND NOT lSelectedTheOnlySOitem
		*!*		DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
		*!*	ENDIF
		
		*!*	IF VARTYPE(cSoItem) = "C"
		*!*		IF Proper_SO_item(cSoItem) = Proper_SO_item('')
		*!*			ThisForm.txtFSOitem.Value = ''
		*!*		ELSE
		*!*			ThisForm.txtFSOitem.Value = cSOItem
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.txtFSOitem.Value = ''
		*!*	ENDIF
	ENDPROC

