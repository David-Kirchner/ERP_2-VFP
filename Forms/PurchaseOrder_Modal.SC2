	PROCEDURE frmPONotes.edtMisc_Purch.LostFocus
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			IF ThisFormSet.frmPOMaint.pf1.ActivePage = 1
				ThisFormset.frmPO.pgfPO.pgPODesc.txtMisc_Purch.Value = This.Value
			ENDIF
			IF ThisFormSet.frmPOMaint.pf1.ActivePage = 2
				IF ThisFormSet.frmPO.POEditing
					ThisFormset.frmPO.pgfPO.pgPODesc.txtMisc_Purch.Value = This.Value
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

