	PROCEDURE frmPOMaint.pf1.pgEdit.chkCancel.Valid
		
		PRIVATE cPOitem, lCancelled, lPOSaveOK 
		cPOitem = PurchaseOrder.POitem
		
		lCancelled = PrepareSQLchk(This.Value,'Cancelled')
		
		*AllowAdminPODelete
		*HaveVendorApprovedPermission
		*HavePODeletePermission
		
		IF !lCancelled
			IF MESSAGEBOX("Are you sure you want to UNCANCEL this record."+CHR(13)+"POitem:"+ALLTRIM(cPOitem),4+32,"UN Cancel") = 6
			
				PRIVATE cSQLu, nSQLEXEC 
				cSQLu = "UPDATE dbo.PurchaseOrder SET "
				cSQLu = cSQLu + " [cancelled]="+IIF(lCancelled,'1','0')
				cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = '"+cPOItem+"'"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
					lPOSaveOK = .F.
				ELSE
					TrackMess( "Updateded POitem:"+ALLTRIM(cPOitem)+" Set as UNCancelled from PurchaseOrder screen.")
				ENDIF
				
				ThisFormSet.EditPO(cPOitem)
				MESSAGEBOX( "You are in Edit mode for this PO."+CHR(13)+"Please Save the PO."+CHR(13)+"The SAVE routine will check and Add stock if needed.",0+64,"Save PO to complete the 'Uncancel")
		
		*		ThisFormSet.frmPOMaint.pf1.pgAdd.pfAdd.ActivePage = 1
				ThisFormSet.frmPO.pgfPO.ActivePage = 1
			ELSE
				This.Value = IIF(lCancelled,0,1) &&Reverse	
			ENDIF
		ELSE
		******************************************************************
			IF MESSAGEBOX("Are you sure you want to cancel this PO?"+CHR(13)+"POitem:"+ALLTRIM(cPOitem),4+32,"Cancel") = 6
		
				lPOSaveOK = .T.
				lPOSaveOK = PurchaseOrder_Allow_Cancel( cPOitem, ThisFormSet.nConnHandle ) 
				IF lPOSaveOK 
					lPOSaveOK = PurchaseOrder_POitem_Cancel( cPOitem, ThisFormSet.nConnHandle, .F.) 
				ENDIF
				
		*!*			PRIVATE cSQLu, nSQLEXEC 
		*!*			cSQLu = "UPDATE dbo.PurchaseOrder SET "
		*!*			cSQLu = cSQLu + " [cancelled]="+IIF(lCancelled,'1','0')
		*!*			cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = '"+cPOItem+"'"
		
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDD
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
		*!*				lPOSaveOK = .F.
		*!*			ELSE
		*!*				TrackMess( "Updateded POitem:"+ALLTRIM(cPOitem)+" Set as Cancelled from PurchaseOrder screen.")
		*!*			ENDIF
		
				IF lPOSaveOK 
		
					
					ThisFormSet.ReloadPurchaseOrder(cPOItem)
					
					This.Parent.grdPO1.Refresh
					This.Parent.grdPO1.Setfocus
					
		
				ENDIF
			ELSE
				This.Value = IIF(lCancelled,0,1) &&Reverse	
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.chkCert.Valid
		This.Parent.grdPO1.Refresh
		This.Parent.grdPO1.Setfocus
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.chkComplete.Valid
		PRIVATE lThisVal, cPOitem, cSQL, nSQLEXEC
		cPOitem = PurchaseOrder.POitem
		
		IF VARTYPE(This.Value) = "L"
			lThisVal = This.Value
		ELSE
			IF VARTYPE(This.Value) = "N"
				lThisVal = (This.Value=1)
			ENDIF
		ENDIF
		
		PRIVATE cTmpRecMess
		cTmpRecMess = ''
		
		IF lThisVal
			
			IF USED('tmpRecvPOitem')
				USE IN tmpRecvPOitem
			ENDIF
			SELECT 0
			
			cSQL = "SELECT ID,Received,BillW,R_QTY, ID_Master, StockTable, RejectPC, RMA_No "
			cSQL = cSQL + " FROM dbo.Receiving "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecvPOitem')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRecvPOitem' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPOitem")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpRecvPOitem')
			ELSE
				IF USED('tmpRecvPOitem')
					IF RECCOUNT('tmpRecvPOitem') > 0
						SCAN
							IF NOT EMPTY(cTmpRecMess)
								cTmpRecMess = cTmpRecMess +CHR(13)
							ENDIF
							cTmpRecMess = cTmpRecMess + "ID:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.ID,'ID',-3)))
							cTmpRecMess = cTmpRecMess + " Received:"+DTOC(PrepareSQLdate(tmpRecvPOitem.Received,'Received'))+CHR(13)
							cTmpRecMess = cTmpRecMess + " BillW:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.BillW,'BillW',-3)))+"#"+CHR(13)
							cTmpRecMess = cTmpRecMess + " AcctQTY:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.R_QTY,'QTY',-3)))+"QTY "+CHR(13)
							cTmpRecMess = cTmpRecMess + " StockTable:"+PrepareSQLtxt(tmpRecvPOitem.StockTable,'StockTable',1)+CHR(13)
							cTmpRecMess = cTmpRecMess + " ID_Master:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.ID_Master,'ID_Master',-3)))+CHR(13)
							cTmpRecMess = cTmpRecMess + " RejectPC:"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.RejectPC,'RejectPC',-3)))+CHR(13)
							cTmpRecMess = cTmpRecMess + " RMA_No :"+ALLTRIM(STR(PrepareSQLnum(tmpRecvPOitem.RMA_No ,'RMA_No',-3)))+CHR(13)
							cTmpRecMess = cTmpRecMess + " ----------------------------------------"+CHR(13)
						ENDSCAN
						
					ENDIF
					USE IN tmpRecvPOitem
				ENDIF
			ENDIF
			
			PRIVATE lFoundRecv
			lFoundRecv = .F.
			IF NOT EMPTY(cTmpRecMess)
				MESSAGEBOX(cTmpRecMess,64,'Found in Receiving:')
				lFoundRecv = .T.
			ENDIF
			
			IF MESSAGEBOX("Are you sure you want to mark POitem:"+ALLTRIM(cPOitem)+" as Delivered?"+CHR(13)+"PO-Item Complete?"+IIF(lFoundRecv,'',CHR(13)+CHR(13)+"No Receiving record found!"),4+32,"Mark as Complete/Delivered?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Delivered] = 1"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
		
					
					IF NOT EMPTY(cTmpRecMess)
						TrackMess( "Marked as Delivered for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder Receiving record was good!"+" "+CHR(13)+cTmpRecMess )
					ELSE
						TrackMess( "Marked as Delivered for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder -No Receiving record!" )
					ENDIF
					*MESSAGEBOX("Changes will not show until you restart this program."+CHR(13)+"Restart to refresh data.",0+64,"Saved as Delivered!")
					
					*Update Trigger removed the 'INCOMING' 'Not2HPA' process from Stock or Broker List.
					ThisFormSet.ReloadPurchaseOrder(cPOItem)
		
				ENDIF
				
			ELSE
				This.Value = IIF(lThisVal,0,1) &&Reverse
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark POitem:"+ALLTRIM(cPOitem)+" as Delivered?",4+32,"Mark as NOT Complete/Delivered?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Delivered] = 0"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT Delivered for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					MESSAGEBOX("Edit this PO now and Save so the 'INCOMING' Stock list Process is relisted!.",0+64,"Un marked Delivered!")
					This.Value=0
					ThisForm.cmdEdit.Click
		*!*				ThisFormSet.POeditMode = .T.
		*!*				ThisFormSet.AddressScreen("DISABLE")
		*!*				ThisFormSet.EditPO(PurchaseOrder.POitem)
		*!*				ThisFormSet.frmPO.pgfPO.ActivePage = 1
				ENDIF
						
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdPO1.Refresh
		This.Parent.grdPO1.Setfocus
		
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.chkConvServ.Click
		PRIVATE lThisVal,cPOitem, cSQL, nSQLEXEC
		cPOitem = PurchaseOrder.POitem
		
		IF VARTYPE(This.Value) = "L"
			lThisVal = This.Value
		ELSE
			IF VARTYPE(This.Value) = "N"
				lThisVal = (This.Value=1)
			ENDIF
		ENDIF
		
		IF lThisVal
			IF MESSAGEBOX("Are you sure you want to mark POitem:"+ALLTRIM(cPOitem)+" as 'Metal Conversion Service'?",4+32,"Mark as Conversion?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [ConvServ] = 1"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as 'Metal Conversion Service' for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					SELECT PurchaseOrder
					IF VARTYPE(PurchaseOrder.ConvServ) = "L"
						*PurchaseOrder.Services = .T.
						REPLACE ConvServ WITH .T.
					ELSE
						REPLACE ConvServ WITH 1
					ENDIF
				ENDIF
			ELSE
				This.Value = IIF(lThisVal,0,1) &&Reverse
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark POitem:"+ALLTRIM(cPOitem)+" as 'Metal Conversion Service'?",4+32,"Mark as NOT Conversion?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [ConvServ] = 0"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT 'Metal Conversion Service' for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					SELECT PurchaseOrder
					IF VARTYPE(PurchaseOrder.ConvServ) = "L"
						REPLACE PurchaseOrder.ConvServ WITH .F.
					ELSE
						REPLACE PurchaseOrder.ConvServ WITH 0
					ENDIF
				ENDIF
			ELSE
				This.Value = IIF(lThisVal,0,1) &&Reverse
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdPO1.Refresh
		This.Parent.grdPO1.Setfocus
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.chkConvServ.InteractiveChange
		PRIVATE lServicesPO,lConvServ,lEquipment
		lServicesPO = PrepareSQLchk( This.Value, 'ServicesPO',.F. )
