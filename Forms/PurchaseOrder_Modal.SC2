				ThisFormSet.frmPOMaint.pf1.pgStockLst.Heat1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Lot1.Visible = .F.
				ThisFormSet.frmPOMaint.pf1.pgStockLst.Mill1.Visible = .F.
