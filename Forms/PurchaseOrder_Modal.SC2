		*RETURN !ThisFormSet.POeditMode
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			RETURN !ThisFormSet.frmPO.POEditing
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.cmdView.cmdRptBadStock.Click
		PRIVATE currec1
		WAIT WINDOW 'Please wait while selecting records.' NOWAIT
		SELECT PurchaseOrder
		currec1 = RECNO()
		
		PRIVATE cSQL, nSQLEXEC
		IF NOT USED('BrokerLst_Master')
			SELECT 0
			cSQL = "SELECT * FROM dbo.BrokerLst_Master"
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'BrokerLst_Master')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'BrokerLst_Master' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "BrokerLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "BrokerLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'BrokerLst_Master' )
			ENDIF
		ENDIF
		
		IF NOT USED('StockLst_Master')
			SELECT 0
			cSQL = "SELECT * FROM dbo.StockLst_Master"
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Master')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StockLst_Master' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Master' )
			ENDIF
		ENDIF
		
		SELECT 0
		SELECT PO.* FROM PurchaseOrder PO LEFT OUTER JOIN BrokerLst_Master bm ON bm.po_item = po.poitem LEFT OUTER JOIN StockLst_Master sm ON sm.po_item = po.poitem WHERE !po.Delivered AND (!PO.Cancelled OR ISNULL(PO.Cancelled)) AND PO.Stock != 'No Stock' AND ( ISNULL(BM.ID) AND ISNULL(SM.ID) ) INTO CURSOR tmpPO
		
		REPORT FORM reports\PODueIn HEADING 'Incoming material that should have stock list entry, but dont.' PREVIEW 
			
		*!*	SELECT BM.ID,SM.ID,PO.Services,PO.* FROM PurchaseOrder PO
		*!*	LEFT OUTER JOIN BrokerLst_Master bm ON bm.po_item = po.poitem
		*!*	LEFT OUTER JOIN StockLst_Master sm ON sm.po_item = po.poitem
		*!*	WHERE LEN(PO.poitem) > 1
		*!*	AND ISNULL(po.Delivered,0) = 0
		*!*	AND ISNULL(PO.Cancelled,0) = 0
		*!*	AND PO.Stock != 'No Stock'
		*!*	AND ISNULL(BM.ID,0)+ISNULL(SM.ID,0) = 0
		
		IF USED('tmpPO')
			USE IN tmpPO
		ENDIF	
		
		
		IF USED('BrokerLst_Master')
			USE IN BrokerLst_Master
		ENDIF	
			
		IF USED('StockLst_Master')
			USE IN StockLst_Master
		ENDIF
		
		SELECT PurchaseOrder
		
		IF currec1 > 0 AND currec1 < RECCOUNT()
			GOTO (currec1)
		ENDIF
		
	ENDPROC

