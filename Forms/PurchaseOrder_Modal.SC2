	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.cmdEditVendors.Click
		*ThisForm.AlwaysOnTop = .F.
		DODEFAULT()   &&DO FOrm forms\vendor11 WITH 
		*ThisForm.AlwaysOnTop = .T.
