	PROCEDURE frmPOMaint.pf1.pgEdit.cmbFind.InteractiveChange
		ThisFormSet.ncmbFind = This.Value
		
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmbFind.Valid
		PRIVATE IntcmbFind
		IntcmbFind = INT(This.Value)
		*Purchase Order,Sales Order,Customer,SalesOrder-Item
		DO CASE
		CASE IntcmbFind = 1
			*HPApo n,9
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		CASE IntcmbFind = 2
			*HPAPO N,7
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999"
		CASE IntcmbFind = 3
			*Company c,30
			ThisFormSet.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 4
			*SOitem c,10
			ThisFormSet.FindText = SPACE(10)
			This.Parent.txtFindText.InputMask =	"99999-99"
		CASE IntcmbFind = 5
			*WO n,4
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999"
		CASE IntcmbFind = 6
			*WOD n,4
			ThisFormSet.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999"
		ENDCASE
		This.Parent.txtFindText.Refresh
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmdClonePO.Click
		ThisFormSet.EditPOScreen(.T.)
		*ThisFormSet.AddressScreen("DISABLE")
		
		*ThisFormSet.frmPO.POScreen("CLEAR")
		ThisFormSet.frmPO.Left		= ThisFormSet.frmPOMaint.Left + 6
		ThisFormSet.frmPO.pgfPO.Left = 1
		ThisFormSet.frmPO.Visible = .T.
		ThisForm.pF1.ActivePage = 1
		ThisFormSet.frmPO.pgfPO.ActivePage = 1
		
		IF NOT USED('PurchaseOrder')
			MESSAGEBOX("Lost contact with PurchaseOrder table",16,"SQL Error")
		ELSE
			ThisFormSet.frmPO.ShowPOitem(PurchaseOrder.POitem)
			*PrepareSQLtxt(PurchaseOrder.POitem,"POitem",13)
		
			ThisFormSet.frmPO.MakeNewPOitem(PurchaseOrder.POitem,.T.,.F.)&&(POitem, MakeNewPO, MakeNewPOitem)
		
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtSalesnum.Value = 0
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtItem.Value = 0
			ThisFormSet.frmPO.SalesNum = 0
			ThisFormSet.frmPO.itemNumber = 0
		
			ThisFormSet.frmPOMaint.pf1.ActivePage = 1
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtCompany.SetFocus()
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmdDelete.Click
		
		PRIVATE cPOitem
		cPOitem = PurchaseOrder.POitem
		IF MESSAGEBOX("Are you sure you want to delete PO Item "+ALLTRIM(cPOitem)+" ?",4+48,"Delete PO Item?") = 6
		
			WAIT WINDOW "Trying to Delete!" NOWAIT
			IF PurchaseOrder_POitem_Delete( PurchaseOrder.POitem, ThisFormSet.nConnHandle ) 
			
				ThisFormSet.ReloadPurchaseOrder()
				WAIT WINDOW "Deleted." NOWAIT
			ELSE
				WAIT WINDOW "Failed to deleted." NOWAIT
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmdEditNotes.Click
		IF This.Caption = "Edit Notes"
			*Enable Edit
			
			*This.parent.edtReceipt.Enabled
			This.Caption = "Abort"
			This.Parent.cmdSaveNotes.Visible = .T.
		ELSE
			*Abort edit
			This.Parent.cmdSaveNotes.Visible = .F.
			This.Caption = "Edit Notes"
			
			PRIVATE cPOItem, cReceipt
			cPOitem = PurchaseOrder.POitem
			*cReceipt = PrepareSQLtxt(This.Parent.edtReceipt.Value,'Receipt',-3)
			
			IF USED('tmpPOreceipt')
				USE IN tmpPOreceipt
			ENDIF
			
			SELECT 0
			
			cSQL = "SELECT Receipt FROM dbo.PurchaseOrder"
			cSQL = cSQL + " WHERE PurchaseOrder.POItem = '"+cPOItem+"'"
			   
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOreceipt')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOreceipt' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOreceipt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOreceipt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOreceipt' )
			ENDIF
			***
			IF USED('tmpPOreceipt')
				IF RECCOUNT('tmpPOreceipt') > 0
					cReceipt = tmpPOreceipt.Receipt 
					This.Parent.edtReceipt.Value = cReceipt 
				ENDIF
				USE IN tmpPOreceipt
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmdFindcmbText.Click
		PRIVATE nINTcmbFind, recb4find, nBestFind
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.FindText
		
		SET SAFETY OFF
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		lnText2Find = INT(lnText2Find )
		
		nINTcmbFind = INT(ThisFormSet.ncmbFind)
		recb4find = 0
		recb4find = RECNO('PurchaseOrder')
		*Purchase Order,Sales Order,Customer,SalesOrder-Item
		SELECT PurchaseOrder
		DO CASE
		CASE nINTcmbFind = 1
			*HPApo n,9
			INDEX ON HPAPO TAG HPAPO
			SET ORDER TO HPAPO
			SEEK lnText2Find  IN PurchaseOrder ORDER HPAPO
		CASE nINTcmbFind = 2
			*HPAPO n,7
			INDEX ON SalesNum TAG SalesNum
			SET ORDER TO Salesnum
			SEEK lnText2Find IN PurchaseOrder ORDER Salesnum
		CASE nIntcmbFind = 3
			*Company c,30
			INDEX ON UPPER(Company) TAG UppCompany
			SET ORDER TO UppCompany
			SEEK UPPER(lcText2Find) IN PurchaseOrder ORDER UppCompany
		CASE nINTcmbFind = 4
			*SOitem c,10
			INDEX ON SOitem TAG SOitem
			SET ORDER TO SOitem
			cSOitem = Proper_SO_item( lcText2Find )
			SEEK cSOitem IN PurchaseOrder ORDER SOitem
		CASE nINTcmbFind = 5
			*WO n,4
			INDEX ON WO TAG WO
			SET ORDER TO WO
			SEEK lnText2Find IN PurchaseOrder ORDER WO
		CASE nINTcmbFind = 6
			*WOD n,4
			INDEX ON WO_Detail TAG WO_Detail
			SET ORDER TO WO_Detail
			SEEK lnText2Find IN PurchaseOrder ORDER WO_Detail
		ENDCASE
		
		
		IF NOT FOUND('PurchaseOrder') AND NOT ThisFormSet.AllRecordsRetrieved 
			
			WAIT WINDOW "Getting the complete Pourchase Order History. Please wait." NOWAIT
			
			ThisFormSet.AllRecordsRetrieved  = .T.
			ThisFormSet.GetPurchaseOrders('ALL')
			
			SELECT PurchaseOrder
			DO CASE
			CASE nINTcmbFind = 1
				*HPApo n,9
				INDEX ON HPAPO TAG HPAPO
				SET ORDER TO HPAPO
				SEEK lnText2Find  IN PurchaseOrder ORDER HPAPO
			CASE nINTcmbFind = 2
				*HPAPO n,7
				INDEX ON SalesNum TAG SalesNum
				SET ORDER TO Salesnum
				SEEK lnText2Find IN PurchaseOrder ORDER Salesnum
			CASE nIntcmbFind = 3
				*Company c,30
				INDEX ON UPPER(Company) TAG UppCompany
				SET ORDER TO UppCompany
				SEEK UPPER(lcText2Find) IN PurchaseOrder ORDER UppCompany
			CASE nINTcmbFind = 4
				*SOitem c,10
				INDEX ON SOitem TAG SOitem
				SET ORDER TO SOitem
				cSOitem = Proper_SO_item( lcText2Find )
				SEEK cSOitem IN PurchaseOrder ORDER SOitem
			CASE nINTcmbFind = 5
				*WO n,4
				INDEX ON WO TAG WO
				SET ORDER TO WO
				SEEK lnText2Find IN PurchaseOrder ORDER WO
			CASE nINTcmbFind = 6
				*WOD n,4
				INDEX ON WO_Detail TAG WO_Detail
				SET ORDER TO WO_Detail
				SEEK lnText2Find IN PurchaseOrder ORDER WO_Detail
				ENDCASE
		ENDIF
		
		IF NOT FOUND('PurchaseOrder')
			nBestFind = RECNO(0)
			IF nBestFind > 0 AND nBestFind <= RECCOUNT("PurchaseOrder")
				GOTO nBestFind 
			ENDIF
			IF EOF('PurchaseOrder')
				WAIT WINDOW 'Not Found' NOWAIT
				IF recb4find > 0 AND recb4find <= RECCOUNT("PurchaseOrder")
					GO recb4find
				ENDIF
			ELSE
				WAIT WINDOW 'closest match' NOWAIT
			ENDIF
		ENDIF
		
		This.Parent.grdPO1.Refresh
		
		
		ThisFormSet.RefreshEditTab()
		
		This.Parent.grdPO1.Setfocus
	ENDPROC

	PROCEDURE frmPOMaint.pf1.pgEdit.cmdNewItem.Click
		ThisFormSet.EditPOScreen(.T.)
		*ThisFormSet.AddressScreen("DISABLE")
		
		*ThisFormSet.frmPO.POScreen("CLEAR")
		ThisFormSet.frmPO.Left		= ThisFormSet.frmPOMaint.Left + 6
		ThisFormSet.frmPO.pgfPO.Left = 1
		ThisFormSet.frmPO.Visible = .T.
		*ThisForm.pF1.ActivePage = 1
		ThisFormSet.frmPO.pgfPO.ActivePage = 1
		
		IF Proper_PO_item( PurchaseOrder.POitem ) = Proper_PO_item( '' )
			MESSAGEBOX("No POitem to Show",16,"Error")
			RETURN .F.
		ENDIF
		
		
		*ThisFormSet.EditPO(PurchaseOrder.POitem)
		ThisFormSet.frmPO.ShowPOitem(PurchaseOrder.POitem)
		*PrepareSQLtxt(PurchaseOrder.POitem,"POitem",13)
		
		ThisFormSet.frmPO.MakeNewPOitem(PurchaseOrder.POitem,.F.,.T.)
		*MakeNewPOitem(POitem, ClonePO, ClonePOitem )
		
		ThisFormSet.frmPOMaint.pf1.ActivePage = 1
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtCompany.SetFocus()
	ENDPROC

