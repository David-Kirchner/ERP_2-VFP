	PROCEDURE Init
		ThisForm.grdCompany.RecordSource = "tmpQcompany"
	ENDPROC

	PROCEDURE Load
			
		IF !USED('tmpQcompany')
		
			PRIVATE cSQL, nSQLEXEC 
		
			cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
			cSQL = cSQL + " FROM dbo.QuickCompany "
		*	cSQL = cSQL + " WHERE Company = '"+(cQIDComp)+"'"
		*	cSQL = cSQL + " AND Name = '"+(cQIDName)+"'"
			cSQL = cSQL + " ORDER BY Company, Name "
		
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
			ENDIF
		
			*Not Found
		
		ENDIF 
	ENDPROC

	PROCEDURE Unload
		RETURN THISFORM.Pcust
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.Pcust = Space(30)+Space(25)
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdDelete.Click
		ThisForm.QName	= tmpQcompany.Name 
		ThisForm.QComp	= tmpQcompany.Company 
		
		PRIVATE nID
		nID = tmpQcompany.ID
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF MESSAGEBOX("Are you sure you want to remove this from the Quick List?",4+48,"Remove record from the Quick List") = 6
			cSQL = "DELETE FROM dbo.QuickCompany "
			cSQL = cSQL + " WHERE ID = "+STR(nID)
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC )
				RETURN .F.
			ENDIF
		
		
			***Code from frmQuotes cmdSeekCompany.Click
		
			IF USED('tmpQcompany')
				ThisForm.grdCompany.RecordSource = ''
				USE IN tmpQcompany
			ENDIF
		
			cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
			cSQL = cSQL + " FROM dbo.QuickCompany "
			cSQL = cSQL + " WHERE Company LIKE '"+ThisForm.QComp+"%'"
		
			*cSQL = cSQL + " AND Name = '"+(ThisForm.QName)+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
			ENDIF
		
			IF USED('tmpQcompany')
				ThisForm.grdCompany.RecordSource = 'tmpQcompany'
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdReturnCompanyOnly.Click
		PRIVATE cCompany, cName
		cCompany	= PrepareSQLtxt(tmpQcompany.Company,'Company',30,.T.,.F.)
		cName		= PrepareSQLtxt(tmpQcompany.Name,'Name',25,.T.,.F.)
		
		ThisForm.Pcust = cCompany+cName+'  keepname'
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdReturnOnly.Click
		ThisForm.Pcust = Space(30)+Space(25)
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdReturnPerson.Click
		PRIVATE cCompany, cName
		cCompany	= PrepareSQLtxt(tmpQcompany.Company,'Company',30,.T.,.F.)
		cName		= PrepareSQLtxt(tmpQcompany.Name,'Name',25,.T.,.F.)
		
		ThisForm.Pcust = cCompany+cName
		ThisForm.Release
	ENDPROC

