	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		WAIT WINDOW 'Customer_List' NOWAIT
		ThisForm.Refresh_Customer_List()
		WAIT WINDOW 'QuickCompany' NOWAIT
		ThisForm.Refresh_QuickCompany()
		WAIT WINDOW 'ShipAddr' NOWAIT
		ThisForm.Refresh_ShipAddr()
		WAIT WINDOW 'SoldAddr' NOWAIT
		ThisForm.Refresh_SoldAddr()
		WAIT CLEAR
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE quickcompany_dynamic_back_color
		PRIVATE nColor
		*QuickCompany_Dynamic_Back_Color()
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		*IIF(ISNULL(QuickCompany.CustomerID),RGB( 255, 255, 255 ),RGB( 128,255,128 ))
		
		IF NOT ISNULL(QuickCompany.CustomerID)
			nColor = RGB( 128,255,128 ) &&Green
		ELSE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDIF
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE refreshquickcompanynotes
		PARAMETERS pcCustomer
		*ThisForm.RefreshQuickCompanyNotes()
		
		ThisForm.QuickCompanyNotes.Visible = .F.
		
		PRIVATE nID
		nID = 0
		
		IF VARTYPE(pcCustomer) != 'C'
			IF VARTYPE(pcCustomer) = 'N'
				nID = pcCustomer
			ENDIF
			pcCustomer = ''
		ENDIF
		
		IF USED('QuickCompanyNotes')
			USE IN QuickCompanyNotes
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT QuickCompany.Notes"
		cSQL = cSQL + " FROM dbo.QuickCompany "
		IF nID > 0
			cSQL = cSQL + " WHERE ID = "+STR(nID)
		ELSE
			PRIVATE cCustomer 
			cCustomer = PrepareSQLtxt(pcCustomer,'Customer',20)
			cSQL = cSQL + " WHERE Customer = '"+ALLTRIM(pcCustomer)+"'"
		ENDIF
		cSQL = cSQL + " AND Notes IS NOT NULL"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompanyNotes')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'QuickCompanyNotes' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompanyNotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompanyNotes')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'QuickCompanyNotes' )
		ENDIF
		
		
		PRIVATE cNotes
		IF USED('QuickCompanyNotes')
			IF nID > 0
				IF NOT ISNULL(QuickCompanyNotes.Notes) 
					IF NOT EMPTY(QuickCompanyNotes.Notes) 
						ThisForm.QuickCompanyNotes.Value = QuickCompanyNotes.Notes
					ENDIF
				ENDIF
			ELSE
				cNotes = ""
				SELECT QuickCompanyNotes
				DO WHILE NOT EOF()
					IF NOT ISNULL(QuickCompanyNotes.Notes)
						IF NOT EMPTY(QuickCompanyNotes.Notes)  
							cNotes = cNotes + ALLTRIM(QuickCompanyNotes.Notes)
						ENDIF
					ENDIF
					SKIP
				ENDDO
				ThisForm.QuickCompanyNotes.Value = cNotes
			ENDIF
			USE IN QuickCompanyNotes
		ENDIF
		
		
		IF NOT EMPTY(ThisForm.QuickCompanyNotes.Value)
			ThisForm.QuickCompanyNotes.Visible = .T.
		ENDIF
		ThisForm.QuickCompanyNotes.Refresh			
	ENDPROC

	PROCEDURE refresh_customer_contact_txt
		*ThisForm.Refresh_Customer_Contact_txt()
		
		PRIVATE cCustomerID
		cCustomerID = Customer_List.CustomerID
		
		ThisForm.pf1.pgCustContact.grdCustomer_Contact.RecordSource = ''
		ThisForm.pf1.pgCustContact.grdCustomer_Contact.Visible = .F.
		ThisForm.pf1.pgCustContact.edtNotes.Value = ''
		ThisForm.pf1.pgCustContact.edtNotes.Visible = .F.
		ThisForm.pf1.pgCustContact.cmdNotes.Visible = .F.
			
		IF EMPTY(cCustomerID)
			RETURN .F.
		ENDIF
		
		IF USED('tmpCustomer_List_Call')
			USE IN tmpCustomer_List_Call
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT [Date],CAST([WHO] AS CHAR(30)) AS [Whom] "
		cSQL = cSQL + " FROM dbo.Customer_List_Call "
		cSQL = cSQL + " WHERE CustomerID = '"+cCustomerID+"'"
		cSQL = cSQL + " ORDER BY [Date] DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Call')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Call' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Call')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Call')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCustomer_List_Call' )
		ENDIF
		
		IF USED('tmpCustomer_List_Call')
			IF EOF('tmpCustomer_List_Call') 
				ThisForm.pf1.pgCustContact.grdCustomer_Contact.Visible = .F.
				ThisForm.pf1.pgCustContact.cmdNotes.Visible = .F.
		*		ThisForm.pf1.pgCustContact.cmdNotes.Caption = 'Add Note'  &&'Edit Notes'
			ELSE
				ThisForm.pf1.pgCustContact.grdCustomer_Contact.RecordSource = 'tmpCustomer_List_Call'
				ThisForm.pf1.pgCustContact.grdCustomer_Contact.Visible = .T.
				ThisForm.pf1.pgCustContact.cmdNotes.Visible = .T.
				ThisForm.pf1.pgCustContact.cmdNotes.Caption = 'Add Note'  &&'Edit Notes'
			ENDIF
		ENDIF
		
		***********
		IF USED('tmpCustomer_List_Notes')
			USE IN tmpCustomer_List_Notes
		ENDIF
		
		SELECT 0
		PRIVATE cSQL
		
		cSQL = "SELECT Notes "
		cSQL = cSQL + " FROM dbo.Customer_List_Notes "
		cSQL = cSQL + " WHERE CustomerID = '"+cCustomerID+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Notes')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Notes' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Notes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomer_List_Notes')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCustomer_List_Notes' )
		ENDIF
		
		IF USED('tmpCustomer_List_Notes')
		
			ThisForm.pf1.pgCustContact.edtNotes.Value = tmpCustomer_List_Notes.Notes
			ThisForm.pf1.pgCustContact.edtNotes.Visible = .T.
			ThisForm.pf1.pgCustContact.cmdNotes.Caption = 'Edit Notes'
			
		ENDIF
	ENDPROC

	PROCEDURE refresh_customer_list
		*ThisForm.Refresh_Customer_List()
		ThisForm.grdCustomer_List.RecordSource = ''
		IF USED('Customer_List')
			USE IN Customer_List
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		*cSQL = "SELECT * FROM dbo.Customer_List ORDER BY CustomerID"
		cSQL = "SELECT CL.* "
		cSQL = cSQL + ", dbo.f_GetLastCall_CustomerID(CL.CustomerID) AS [LastCall]"
		cSQL = cSQL + ", LEFT(dbo.f_GetWho_CustomerID(CL.CustomerID),30) AS [Who]"
		cSQL = cSQL + " FROM dbo.Customer_List CL "
		cSQL = cSQL + " ORDER BY CustomerID"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Customer_List' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
		ENDIF
		
		IF USED('Customer_List')
		
			INDEX ON CustomerID TAG CustomerID
			INDEX ON CustomerName TAG CustomerNa
			INDEX ON LastCall TAG LastCall
			
			DO CASE
			CASE ThisForm.ogCustomer_List.Value = 1
				SET ORDER TO TAG CustomerID
			CASE ThisForm.ogCustomer_List.Value = 2
				SET ORDER TO TAG CustomerNa
			CASE ThisForm.ogCustomer_List.Value = 3
				SET ORDER TO TAG LastCall
			ENDCASE	
			
			ThisForm.grdCustomer_List.RecordSource = 'Customer_List'
			ThisForm.grdCustomer_List.Visible = .T.
		ELSE
			ThisForm.grdCustomer_List.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE refresh_customer_list_txt
		*ThisForm.Refresh_Customer_List_TXT()
		
		ThisForm.txtCustomerName.refresh
		ThisForm.txtCustomerID.refresh
		ThisForm.txtAddr1.refresh
		ThisForm.txtAddr1.refresh
		ThisForm.txtCity.refresh
		ThisForm.txtST.refresh
		ThisForm.txtCountry.refresh
		
		ThisForm.chkStandTerms.Refresh
		ThisForm.chkCODTerms.Refresh
		ThisForm.chkPrePaid.Refresh
		
		ThisForm.txtTelePhone.refresh
		
		ThisForm.txtCredit_Info.refresh
		ThisForm.txtMisc_Info.refresh
		ThisForm.txtCreditLimit.refresh
		
		ThisForm.txtCustomerSince.Refresh
		ThisForm.txtLastInvoice.Refresh
		
		ThisForm.txtWho.Refresh
		ThisForm.txtLastCall.Refresh
		
		ThisForm.RefreshQuickCompanyNotes(Customer_List.CustomerID)
		
		DO CASE
		CASE ThisForm.pf1.ActivePage = 1  &&QuickCompany
			PRIVATE nQuickCompanyID
			nQuickCompanyID = QuickCompany.ID
		
			SELECT QuickCompany
			SEEK (Customer_List.CustomerID) ORDER TAG Customer
			IF FOUND('QuickCompany')
				ThisForm.Refresh_quickcompany_txt()
			ELSE
				LOCATE FOR ID = nQuickCompanyID
			ENDIF
			
			ThisForm.pf1.pgQuickCompany.grdQuickCompany.Refresh
			
		CASE  ThisForm.pf1.ActivePage = 2  &&ShipAddr
			PRIVATE nShipCode
			nShipCode= ShipAddr.ShipCode
		
			SELECT ShipAddr
			SEEK (Customer_List.CustomerID) ORDER TAG Customer
			IF FOUND('ShipAddr')
				ThisForm.Refresh_shipaddr_txt()
			ELSE
				LOCATE FOR ShipCode = nShipCode
			ENDIF
			
			ThisForm.pf1.pgShipAddr.grdShipAddr.Refresh
			
		CASE  ThisForm.pf1.ActivePage = 3  &&SoldAddr
			PRIVATE nSoldCode
			nSoldCode= SoldAddr.SoldCode
		
			SELECT SoldAddr
			SEEK (Customer_List.CustomerID) ORDER TAG Customer
			IF FOUND('SoldAddr')
				ThisForm.Refresh_soldaddr_txt()
			ELSE
				LOCATE FOR SoldCode = nSoldCode
			ENDIF
			
			ThisForm.pf1.pgSoldAddr.grdSoldAddr.Refresh
			
		CASE  ThisForm.pf1.ActivePage = 4  &&
			
			ThisForm.Refresh_customer_contact_txt()
			
		ENDCASE
	ENDPROC

	PROCEDURE refresh_quickcompany
		PARAMETERS pnID
		
		*ThisForm.Refresh_QuickCompany()
		ThisForm.pf1.pgQuickCompany.grdQuickCompany.RecordSource = ''
		
		IF USED('QuickCompany')
			USE IN QuickCompany
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT QuickCompany.*,Customer_List.CustomerID"
		cSQL = cSQL + " FROM dbo.QuickCompany LEFT OUTER JOIN Customer_List ON QuickCompany.Customer=Customer_List.CustomerID "
		cSQL = cSQL + " ORDER BY Customer, Company"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompany')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'QuickCompany' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompany')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompany')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'QuickCompany' )
		ENDIF
		
		IF USED('QuickCompany')
		
			INDEX ON Customer TAG Customer
			INDEX ON Company TAG Company
			INDEX ON CustomerID TAG CustomerID
			
			DO CASE
			CASE ThisForm.pf1.pgQuickCompany.ogQuickCompany.Value = 1
				SET ORDER TO TAG Customer
			CASE ThisForm.pf1.pgQuickCompany.ogQuickCompany.Value = 2
				SET ORDER TO TAG Company
			CASE ThisForm.pf1.pgQuickCompany.ogQuickCompany.Value = 3
				SET ORDER TO TAG CustomerID
			ENDCASE	
			
			IF VARTYPE(pnID) = "N"
				LOCATE FOR ID = pnID
			ENDIF
			ThisForm.pf1.pgQuickCompany.grdQuickCompany.RecordSource = 'QuickCompany'
			ThisForm.pf1.pgQuickCompany.grdQuickCompany.Visible = .T.
			
			ThisForm.pf1.pgQuickCompany.grdQuickCompany.SetAll("dynamicbackcolor", "IIF(ISNULL(QuickCompany.CustomerID),RGB( 255, 255, 255 ),RGB( 128,255,128 ))", "Column")
			
		ELSE
			ThisForm.pf1.pgQuickCompany.grdQuickCompany.Visible = .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE refresh_quickcompany_txt
		*ThisForm.Refresh_QuickCompany_TXT()
		
