	PROCEDURE pf1.pgCustContact.cmdAddContactDate.Click
		
		PRIVATE cCustomerID
		cCustomerID = Customer_List.CustomerID
		IF EMPTY(cCustomerID)
			MESSAGEBOX('CustomerID is empty!')
			RETURN 
		ENDIF
		
		INSERT_Customer_List_Date(cCustomerID,ThisForm.nConnHandle)
		
		
		ThisForm.Refresh_customer_contact_txt()
		
	ENDPROC

	PROCEDURE pf1.pgCustContact.cmdNotes.Click
		PRIVATE cCaption
		cCaption = This.Caption
		
		PRIVATE cCustomerID
		cCustomerID = Customer_List.CustomerID
		PRIVATE cSQLi, nSQLEXEC
		
			IF EMPTY(cCustomerID)
				MESSAGEBOX('CustomerID is empty!')
				RETURN 
			ENDIF
		
		
		DO CASE
		CASE cCaption = 'Add Note'  
			
			This.parent.edtNotes.Value = ' '
			This.parent.edtNotes.Visible = .T.
			This.parent.edtNotes.ReadOnly = .F.
			
			This.Caption = 'Save Note'
				
		CASE cCaption = 'Edit Note'
		
			This.parent.edtNotes.Value = ' '
			This.parent.edtNotes.Visible = .T.
			This.parent.edtNotes.ReadOnly = .F.
			
			This.Caption = 'Save Note'
			
		CASE cCaption = 'Save Note'
			
			PRIVATE cNotes
			cNotes = PrepareSQLtxt(This.parent.edtNotes.Value,'Notes',-1)
			
			IF NOT EMPTY(cNotes)
			
			
			
			
			
				cSQLi = "INSERT INTO dbo.Customer_List_Notes (CustomerID,Notes) VALUES ('"+cCustomerID +"','"+cNotes+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC  )
				ENDIF
			ELSE
				MESSAGEBOX('No Notes to save!')
			ENDIF
			
			This.Caption = 'Edit Note'
			This.parent.edtNotes.ReadOnly = .T.
				
		ENDCASE
	ENDPROC

