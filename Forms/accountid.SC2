	PROCEDURE refresh_shipaddr
		PARAMETERS pnShipCode
		
		*ThisForm.Refresh_ShipAddr()
		ThisForm.pf1.pgShipAddr.grdShipAddr.RecordSource = ''
		
		IF USED('ShipAddr')
			USE IN ShipAddr
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		*cSQL = "SELECT * FROM dbo.ShipAddr ORDER BY Customer"
		cSQL = "SELECT ShipAddr.*,Customer_List.CustomerID"
		cSQL = cSQL + " FROM dbo.ShipAddr LEFT OUTER JOIN Customer_List ON ShipAddr.Customer=Customer_List.CustomerID "
		cSQL = cSQL + " ORDER BY Customer, Company"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr' )
		ENDIF
		
		IF USED('ShipAddr')
		
			INDEX ON Customer TAG Customer
			INDEX ON Company TAG Company
			INDEX ON CustomerID TAG CustomerID
			
			DO CASE
			CASE ThisForm.pf1.pgShipAddr.ogShipAddr.Value = 1
				SET ORDER TO TAG Customer
			CASE ThisForm.pf1.pgShipAddr.ogShipAddr.Value = 2
				SET ORDER TO TAG Company
			CASE ThisForm.pf1.pgShipAddr.ogShipAddr.Value = 3
				SET ORDER TO TAG CustomerID
			ENDCASE	
			
			IF VARTYPE(pnShipCode) = "N"
				LOCATE FOR ShipCode = pnShipCode
			ENDIF
			
			ThisForm.pf1.pgShipAddr.grdShipAddr.RecordSource = 'ShipAddr'
			ThisForm.pf1.pgShipAddr.grdShipAddr.Visible = .T.
			
			ThisForm.pf1.pgShipAddr.grdShipAddr.SetAll("dynamicbackcolor", "IIF(ISNULL(ShipAddr.CustomerID),RGB( 255, 255, 255 ),RGB( 128,255,128 ))", "Column")
			
		ELSE
			ThisForm.pf1.pgShipAddr.grdShipAddr.Visible = .F.
		ENDIF
	ENDPROC

