	PROCEDURE pf1.pgSoldAddr.cmdCopyCustomerID.Click
		PRIVATE cCompany, nSoldCode, cCustomer
		cCompany 	= SoldAddr.Company
		nSoldCode	= SoldAddr.SoldCode
		cCustomer	= SoldAddr.Customer
		
		PRIVATE cCustomerID, cCompany2
		cCustomerID	= Customer_List.CustomerID
		cCompany2	= Customer_List.Company
		
		PRIVATE cMess
		IF EMPTY(ALLTRIM(cCustomer))
			cMess = "Are you sure you want to store "+CHR(13)+"'CustomerID="+ALLTRIM(cCustomerID)+"'"+CHR(13)+" from 'Company="+ALLTRIM(cCompany2)+"'"+CHR(13)+" to 'Company="+ALLTRIM(cCompany)+"'"
		ELSE
			cMess = "Are you sure you want to overwrite "+CHR(13)+"'Customer="+ALLTRIM(cCustomer)+CHR(13)+" with 'CustomerID="+ALLTRIM(cCustomerID)+"'"+CHR(13)+" from 'Company="+ALLTRIM(cCompany2)+"'"+CHR(13)+" to 'Company="+ALLTRIM(cCompany)+"'"
		ENDIF
		
		IF MESSAGEBOX(cMess,4+32,"Copy CustomerID") = 6
			cSQL = "UPDATE dbo.SoldAddr SET Customer='"+cCustomerID+"',LastEdit=GetDate() WHERE SoldCode="+STR(nSoldCode)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
			ENDIF
			
			ThisForm.Refresh_SoldAddr(nSoldCode)
		
		ELSE
			WAIT WINDOW "No Change made!" NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE pf1.pgSoldAddr.cmdFind.Click
		PRIVATE nCustomer_ListSort
		nCustomer_ListSort = ThisForm.ogCustomer_List.Value
		IF nCustomer_ListSort = 2
			*OK
		ELSE
			SELECT Customer_List
			SET ORDER TO TAG Company
			ThisForm.ogCustomer_List.Value = 2
			ThisForm.grdCustomer_List.Refresh
		ENDIF
		
		PRIVATE cCompany
		cCompany = SoldAddr.Company
		
		SELECT Customer_List 
		LOCATE FOR Company = cCompany 
		
		IF NOT FOUND()
			LOCATE FOR ALLTRIM(Company) = ALLTRIM(cCompany )
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,10) = LEFT(cCompany,10)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,8) = LEFT(cCompany,8)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,6) = LEFT(cCompany,6)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,5) = LEFT(cCompany,5)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,4) = LEFT(cCompany,4)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,3) = LEFT(cCompany,3)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,2) = LEFT(cCompany,2)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(Company,1) = LEFT(cCompany,1)
		ENDIF
		
		ThisForm.grdCustomer_List.Refresh
		ThisForm.Refresh_Customer_List_TXT()
	ENDPROC

	PROCEDURE pf1.pgSoldAddr.grdSoldAddr.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Refresh_SOLDADDR_TXT()
	ENDPROC

	PROCEDURE pf1.pgSoldAddr.ogSoldAddr.Company.Click
		SELECT SoldAddr
		SET ORDER TO TAG Company
		This.parent.parent.grdSoldAddr.Refresh
		
	ENDPROC

	PROCEDURE pf1.pgSoldAddr.ogSoldAddr.Customer.Click
		SELECT SoldAddr
		SET ORDER TO TAG Customer
		This.parent.parent.grdSoldAddr.Refresh
	ENDPROC

	PROCEDURE pf1.pgSoldAddr.ogSoldAddr.CustomerID.Click
		SELECT SoldAddr
		SET ORDER TO TAG CustomerID
		This.parent.parent.grdSoldAddr.Refresh
	ENDPROC

ENDDEFINE
