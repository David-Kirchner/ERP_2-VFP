	PROCEDURE pf1.pgQuickCompany.cmbPU.Valid
		
		PRIVATE nQCID, nPU
		nQCID = QuickCompany.ID
		nPU	= PrepareSQLnum(ThisForm.cmbPU.Value,'PU',1)
		
		IF nPU >= 0 AND nPU < 6
			cSQL = "UPDATE dbo.QuickCompany SET PU="+STR(nPU)+" WHERE ID ="+STR(nQCID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgQuickCompany.cmdCopyCustomerID.Click
		
		
		PRIVATE cCompany, nID, cCustomer
		cCompany 	= QuickCompany.Company
		nID			= QuickCompany.ID
		cCustomer	= QuickCompany.Customer
		
		PRIVATE cCustomerID, cCustomerName
		cCustomerID		= PrepareSQLtxt(Customer_List.CustomerID,'CustomerID',20)
		cCustomerName	= PrepareSQLtxt(Customer_List.CustomerName,'CustomerName',30)
		
		PRIVATE cMess
		IF EMPTY(ALLTRIM(cCustomer))
			cMess = "Are you sure you want to store "+CHR(13)+"'CustomerID="+ALLTRIM(cCustomerID)+"'"+CHR(13)+" from 'CustomerName="+ALLTRIM(cCustomerName)+"'"+CHR(13)+" to 'Company="+ALLTRIM(cCompany)+"'"
		ELSE
			cMess = "Are you sure you want to overwrite "+CHR(13)+"'Customer="+ALLTRIM(cCustomer)+CHR(13)+" with 'CustomerID="+ALLTRIM(cCustomerID)+"'"+CHR(13)+" from 'CustomerName="+ALLTRIM(cCustomerName)+"'"+CHR(13)+" to 'Company="+ALLTRIM(cCompany)+"'"
		ENDIF
		
		IF MESSAGEBOX(cMess,4+32,"Copy CustomerID") = 6
			cSQL = "UPDATE dbo.QuickCompany SET Customer='"+cCustomerID+"' WHERE ID ="+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
			ENDIF
			
			cMess = "Do you want to update all the Quotes with this 'Accounting' Customer ID?"
			IF MESSAGEBOX(cMess,4+32,"Update CustomerID in AllQuotes") = 6
		
				cSQL = "UPDATE dbo.AllQuotes "
				cSQL = cSQL + " SET CustID=QC.Customer "
				cSQL = cSQL + " FROM dbo.QuickCompany QC "
				cSQL = cSQL + " WHERE AllQuotes.Company = QC.Company "
				cSQL = cSQL + " AND AllQuotes.Phone = QC.Phone "
				cSQL = cSQL + " AND AllQuotes.CountryC = QC.CountryC "
				cSQL = cSQL + " AND AllQuotes.Fax = QC.Fax "
				cSQL = cSQL + " AND QC.ID = '"+cCustomerID+"'"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL  )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
				ENDIF
			ENDIF
		
			ThisForm.Refresh_Quickcompany(nID)
		
		ELSE
			WAIT WINDOW "No Change made!" NOWAIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf1.pgQuickCompany.cmdFind.Click
		PRIVATE nCustomer_ListSort
		nCustomer_ListSort = ThisForm.ogCustomer_List.Value
		IF nCustomer_ListSort = 2
			*OK
		ELSE
			SELECT Customer_List
			*SET ORDER TO TAG Company
			SET ORDER TO TAG CustomerNa
			ThisForm.ogCustomer_List.Value = 2
			ThisForm.grdCustomer_List.Refresh
		ENDIF
		
		PRIVATE cCompany
		cCompany = QuickCompany.Company
		
		SELECT Customer_List 
		*LOCATE FOR Company = cCompany 
		LOCATE FOR CustomerName  = cCompany 
		
		IF NOT FOUND()
			LOCATE FOR ALLTRIM(CustomerName) = ALLTRIM(cCompany )
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,10) = LEFT(cCompany,10)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,8) = LEFT(cCompany,8)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,6) = LEFT(cCompany,6)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,5) = LEFT(cCompany,5)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,4) = LEFT(cCompany,4)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,3) = LEFT(cCompany,3)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,2) = LEFT(cCompany,2)
		ENDIF
		IF NOT FOUND()
			LOCATE FOR LEFT(CustomerName,1) = LEFT(cCompany,1)
		ENDIF
		
		ThisForm.grdCustomer_List.Refresh
		ThisForm.Refresh_Customer_List_TXT()
	ENDPROC

