	PROCEDURE txtRockwell.Valid
		IF NOT Empty(This.Value)
			IF NOT UPPER(LEFT(LTRIM(This.Value)+" ",1)) $ "ABCDE"
				MESSAGEBOX("Value should begin with the Rockwell scale 'A, B or C'.",0,"Need the Rockwell Scale")
				RETURN .F.
			ENDIF
		ENDIF
