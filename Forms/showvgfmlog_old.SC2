	PROCEDURE Destroy
		IF USED('GFMlog')
			USE IN GFMLog
		ENDIF
		
		IF USED('GFMLabs')
			USE IN GFMlabs
		ENDIF
		
		*!*	IF ThisForm.OpenedHPACert AND DBUSED('HPACert')
		*!*		SET DATABASE TO HPACert
		*!*		CLOSE DATABASES 
		*!*	ENDIF
		
		
		IF ThisForm.lOpenShip AND USED('Ship')
			USE IN Ship
		ENDIF
	ENDPROC

	PROCEDURE duplots		&& Count the number of within this lot
		*ThisForm.DupLots()
		
		
		PRIVATE nLot
		*nLot = GFMlog.Lot
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.GFMLog WHERE LOT ="+ALLTRIM(STR(nLot))
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'tmpCountLot')
		ELSE
			IF USED('tmpCountLot')
		*		IF tmpCountLot.Cntd > 0
					ThisForm.Lots.Caption = ALLTRIM(STR(tmpCountLot.Cntd))
		*		ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pLot, pAlloy
		*DO FORM Forms\ShowvGFMlog WITH Lot, Alloy TO Lot
		
		*loads all of Alloy and locates for LOT
		
		PRIVATE nLot
		IF VARTYPE(pLot) != "N"
			nLot = 0
		ELSE
			nLot = pLot
		ENDIF
		
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(pAlloy,'Alloy',12)
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('GFMLog')	
			USE IN GFMLog
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.GFMLog "
		IF nLot > 0
			cSQL = cSQL + " WHERE LOT = "+STR(nLot)
		ELSE
			IF NOT EMPTY(cAlloy)
				cSQL=cSQL+" WHERE AlloyName = '"+cAlloy+"'"
			ELSE		
				cSQL = cSQL + " " &&All
			ENDIF
		ENDIF
		
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'GFMLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'GFMLog')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'GFMLog')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT GFMLog
		*	INDEX ON LOT TAG LOT
		ENDIF
		*SET ORDER TO TAG LOT
		
		
		
		SELECT GFMlog
		*pCurRec = MIN( Recno(),RECCOUNT() )
		*SET ORDER TO TAG Lot
		
		IF nLot>0
			LOCATE FOR Lot = nLot
			IF NOT FOUND()
				GO BOTTOM
			ENDIF
		ELSE
			GO BOTTOM
		ENDIF
		
		ThisForm.RefreshGFMlog()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		
		ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.ConnHandle < 1
			*try again
			ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
	ENDPROC

	PROCEDURE loadgfmlabs		&& Used in InteractiveChange of Lab
		PRIVATE cSQL, nSQLEXEC
		*LoadGFMLab()
		
		cSQL = "SELECT DISTINCT [LAB] FROM dbo.GFMlog WITH(NOLOCK) ORDER BY Lab "
		
		IF USED("GFMLabs")
			SELECT GFMLabs
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'GFMLabs')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL , 'GFMLabs')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'GFMLabs')
		ENDIF
		
		
		IF USED("GFMLabs")
			SELECT GFMlabs
			INDEX ON UPPER(LAB) TAG UppLAB
		ENDIF
		
	ENDPROC

	PROCEDURE loadgfmlog
		PARAMETERS pID
		
		IF VARTYPE(pID)!="N"
			pID = 0
		ENDIF
		
		*ThisForm.LoadGFMlog()
		
		IF USED('GFMLog')	
			USE IN GFMLog
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.GFMLog WITH(NOLOCK) WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'GFMLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'GFMLog')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'GFMLog')
			RETURN
		ELSE
			SELECT GFMLog
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .F.
		ENDIF
		
		IF pID = 0
			GO BOTTOM
		ELSE
			LOCATE FOR ID = pID
		ENDIF
		
		ThisForm.RefreshGFMlog()
	ENDPROC

	PROCEDURE lothighvalue		&& Returns the highest Lot number for Lot spinner.
	ENDPROC

	PROCEDURE refreshgfmlog		&& Prints Screen
		*ThisForm.RefreshGFMlog()
		SELECT GFMLog
		
		ThisForm.txtAlloyName.Value = GFMLog.AlloyName
		ThisForm.txtDate.Value 		= TTOD(GFMLog.Date)
		ThisForm.txtHeat.Value 		= GFMLog.Heat
		ThisForm.txtLot.Value 		= GFMLog.Lot
		ThisForm.txtSpiece.Value 	= GFMLog.sPiece
		ThisForm.txtFpiece.Value 	= GFMLog.fPiece
		ThisForm.txtSsize.Value 	= GFMLog.sSize
		ThisForm.txtGFMSize.Value 	= GFMLog.GFMSize
		ThisForm.txtSlength.Value 	= GFMLog.sLength
		ThisForm.txtFsize.Value 	= GFMLog.fSize
		ThisForm.txtSweight.Value 	= GFMLog.sWeight
		ThisForm.txtFlength.Value 	= GFMLog.fLength
		ThisForm.txtCondition.Value = GFMLog.Condition
		ThisForm.txtColdWork.Value 	= GFMLog.ColdWork
		ThisForm.txtSpec.Value 		= GFMLog.Spec
		ThisForm.txtHTreat.Value 	= GFMLog.Htreat
		ThisForm.txtSalesNum.Value 	= GFMLog.SalesNum
		ThisForm.txtItemSO.Value 	= GFMLog.ItemSO
		ThisForm.txtOvenTemp.Value 	= GFMLog.OvenTemp
		ThisForm.txtPO.Value 		= GFMLog.PO
		ThisForm.txtWO_Detail.Value = GFMLog.WO_Detail
		ThisForm.edtNotes.Value 	= GFMLog.Notes
		ThisForm.txtTestPO.Value 	= GFMLog.TestPO
		ThisForm.txtTestPoItem.Value= GFMLog.TestPOitem
		ThisForm.txtTestSent.Value 	= IIF(GFMLog.TestSent=CTOD('12/30/1899'), CTOD("  /  /  "),TTOD(GFMLog.TestSent))
		ThisForm.txtLab.Value		= GFMLog.Lab
		ThisForm.txtMinutes.Value 	= GFMLog.Minutes
		ThisForm.txtGFMp.Value 		= GFMLog.GFMp
		ThisForm.txtOvenp.Value 	= GFMLog.Ovenp
		ThisForm.txtCGp.Value 		= GFMLog.CGp
		ThisForm.txtTensile.Value 	= IIF(ISNULL(GFMLog.Tensile),0,GFMLog.Tensile)
		ThisForm.txtYield.Value 	= IIF(ISNULL(GFMLog.Yield),0,GFMLog.Yield)
		ThisForm.txtElongation.Value= IIF(ISNULL(GFMLog.Elongation),0,GFMLog.Elongation)
		ThisForm.txtRed_area.Value 	= IIF(ISNULL(GFMLog.Red_Area),0,GFMLog.Red_Area)
		ThisForm.txtRockwell.Value 	= IIF(ISNULL(GFMLog.Rockwell),'',GFMLog.Rockwell)
		ThisForm.txtBHN.Value 		= IIF(ISNULL(GFMLog.BHN),0,GFMLog.BHN)
		ThisForm.txtTensile2.Value 		= IIF(ISNULL(GFMLog.Tensile2),0,GFMLog.Tensile2)
		ThisForm.txtYield2.Value 		= IIF(ISNULL(GFMLog.Yield2),0,GFMLog.Yield2)
		ThisForm.txtElongation2.Value	= IIF(ISNULL(GFMLog.Elongation2),0,GFMLog.Elongation2)
		ThisForm.txtRed_area2.Value 	= IIF(ISNULL(GFMLog.Red_Area2),0,GFMLog.Red_Area2)
		ThisForm.txtRockwell2.Value 	= IIF(ISNULL(GFMLog.Rockwell2),'',GFMLog.Rockwell2)
		ThisForm.txtBHN2.Value 			= IIF(ISNULL(GFMLog.BHN2),0,GFMLog.BHN2)
		ThisForm.txtTensile3.Value 		= IIF(ISNULL(GFMLog.Tensile3),0,GFMLog.Tensile3)
		ThisForm.txtYield3.Value 		= IIF(ISNULL(GFMLog.Yield3),0,GFMLog.Yield3)
		ThisForm.txtElongation3.Value	= IIF(ISNULL(GFMLog.Elongation3),0,GFMLog.Elongation3)
		ThisForm.txtRed_area3.Value 	= IIF(ISNULL(GFMLog.Red_Area3),0,GFMLog.Red_Area3)
		ThisForm.txtRockwell3.Value 	= IIF(ISNULL(GFMLog.Rockwell3),'',GFMLog.Rockwell3)
		ThisForm.txtBHN3.Value 			= IIF(ISNULL(GFMLog.BHN3),0,GFMLog.BHN2)
		ThisForm.chkPassed.Value 		= IIF(ISNULL(GFMLog.Passed),.F.,GFMLog.Passed)
		ThisForm.chkCustomerMat.Value 	= IIF(ISNULL(GFMLog.CustomerMat),.F.,GFMLog.CustomerMat)
		ThisForm.chkChart.Value 		= IIF(ISNULL(GFMLog.Chart),.F.,GFMLog.Chart)
		ThisForm.txtHTRockwell.Value 	= IIF(ISNULL(GFMLog.HTRockwell),'',GFMLog.HTRockwell)
		ThisForm.txtHTBHN.Value 		= IIF(ISNULL(GFMLog.HTBHN),0,GFMLog.HTBHN)
		
		ThisForm.txtTensile4.Value 		= IIF(ISNULL(GFMLog.Tensile4),0,GFMLog.Tensile4)
		ThisForm.txtYield4.Value 		= IIF(ISNULL(GFMLog.Yield4),0,GFMLog.Yield4)
		ThisForm.txtElongation4.Value	= IIF(ISNULL(GFMLog.Elongation4),0,GFMLog.Elongation4)
		ThisForm.txtRed_area4.Value 	= IIF(ISNULL(GFMLog.Red_Area4),0,GFMLog.Red_Area4)
		
		ThisForm.txtTensile5.Value 		= IIF(ISNULL(GFMLog.Tensile5),0,GFMLog.Tensile5)
		ThisForm.txtYield5.Value 		= IIF(ISNULL(GFMLog.Yield5),0,GFMLog.Yield5)
		ThisForm.txtElongation5.Value	= IIF(ISNULL(GFMLog.Elongation5),0,GFMLog.Elongation5)
		ThisForm.txtRed_area5.Value 	= IIF(ISNULL(GFMLog.Red_Area5),0,GFMLog.Red_Area5)
		
		ThisForm.txtID.Value			= GFMLog.ID
		
		
		IF USED('tmpShip')
			USE IN tmpShip
		ENDIF
		
		IF NOT ISNULL( GFMlog.SOitem )
			IF VAL(RIGHT( GFMlog.SOitem,2 ))>1
				
				cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+GFMlog.SOitem+"')"
				SELECT 0
				
				nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpShip' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL, 'tmpShip' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpShip' )
				ENDIF
					
				IF USED('tmpShip')
					ThisForm.txtCompany.Value	= tmpShip.Company
					ThisForm.txtSalesP.Value	= tmpShip.SalesP
					IF tmpShip.DueDate > CTOD('12/30/1900')
						ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
					ELSE
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ENDIF
					
					IF tmpShip.ShipDate > CTOD('12/30/1900')
						ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
					ELSE
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
					USE IN tmpShip
				ELSE &&USED('tmpShip')
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&Not Item Number
				IF GFMlog.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(GFMlog.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&GFMlog.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			
			ENDIF
		ELSE  &&ISNULL( GFMlog.SOitem )
			IF NOT ISNULL(GFMlog.SalesNum)
				IF GFMlog.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(GFMlog.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&GFMlog.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&ISNULL(GFMlog.SalesNum)
				ThisForm.txtCompany.Value	= ''
				ThisForm.txtSalesP.Value	= ''
				ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
				ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		PRIVATE lnUT
		lnUT = UTresult( GFMLog.ID ,"GFMLog", ThisForm.ConnHandle)
		IF EMPTY(lnUT)
			*Null
			ThisForm.lblUTpass.Visible = .F.
		ELSE
			IF lnUT > 0
				*True
				ThisForm.lblUTpass.Caption = "Pass"
				ThisForm.lblUTpass.Visible = .T.
				ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
				ThisForm.lblUTpass.BackColor = RGB(0,191,96)
		
			ELSE
				IF lnUT <0 
					*False
					ThisForm.lblUTpass.Caption = "Fail"
					ThisForm.lblUTpass.Visible = .T.
					ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
					ThisForm.lblUTpass.BackColor = RGB(255,0,0)
				ENDIF
			ENDIF
		ENDIF
		
		
		ThisForm.DupLots()
		
	ENDPROC

