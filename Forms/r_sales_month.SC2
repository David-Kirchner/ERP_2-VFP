	PROCEDURE seek_soitem_in_sales
		PARAMETERS pcSOitem
		*Seek_SOitem_in_Sales
		IF VARTYPE( pcSOitem ) != "C"
			pcSOitem = ''
		ENDIF
		
		IF USED('Sales')
			USE IN Sales
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.Sales WITH(NOLOCK) WHERE "
		
		IF EMPTY(pcSOitem)
			cSQL = cSQL + " 0>0 "
		ELSE
			cSQL = cSQL + " SOitem = dbo.f_ProperSOitem('"+pcSOitem+"')"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Sales')
		ENDIF
		IF USED('Sales')
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

