	PROCEDURE pgfAll.pgSearch.cmbYear.Init
		this.clear
		
		LOCAL aYEARS[1], i, nYearVal, nDefaultYear, cSQL, nSQLEXEC
		
		nDefaultYear = YEAR(DATE())
		
		IF USED('Year_Sales')
			USE IN Year_Sales
		ENDIF
		SELECT 0
		
		cSQL = "SELECT DISTINCT YEAR(shipped) AS YearShipped "
		cSQL = cSQL+" FROM dbo.SALES WITH(NOLOCK) "
		cSQL = cSQL + " WHERE shipped > '1900' AND cncld=0 "
		cSQL = cSQL + " ORDER BY YearShipped "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Year_Sales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Year_Sales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Year_Sales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Year_Sales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Year_Sales')
		ENDIF
		IF USED('Year_Sales') AND RECCOUNT('Year_Sales') > 0
			SELECT YearShipped FROM Year_Sales INTO ARRAY aYEARS
			FOR i = 1 TO ALEN(aYEARS, 1)
				IF ALEN(aYEARS, 2) > 0
					nYearVal = aYEARS[i, 1]
				ELSE
					nYearVal = aYEARS[i]
				ENDIF
				IF TYPE("nYearVal") = "N" AND !EMPTY(nYearVal)
					this.additem(ALLTRIM(STR(nYearVal)))
					nDefaultYear = nYearVal
				ENDIF
			ENDFOR
			USE IN Year_Sales
		ENDIF
		
		This.AddItem("Not")
		THIS.VALUE = ALLTRIM(STR(nDefaultYear))
		
		
	ENDPROC

	PROCEDURE pgfAll.pgSearch.cmbYear.InteractiveChange
		IF THIS.Value = "Not"
			IF This.Parent.lstMonths.ListCount > 0
				FOR i = 1 TO THIS.PARENT.lstMonths.LISTCOUNT
		*			IF This.Parent.lstMonths.SELECTED(i)
					IF This.Parent.lstMonths.SELECTED(i)
						*Unselect all month but NA
						This.Parent.lstMonths.SELECTED(i) = .F.
					ENDIF
				ENDFOR
				This.Parent.lstMonths.VALUE = 'NA'
			ENDIF
		ENDIF
		
		ThisForm.vSalesFiltered= .F.
	ENDPROC

