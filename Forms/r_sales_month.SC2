	PROCEDURE Destroy
		
		IF USED('PackingSlip_NO') AND close_PackingSlip_NO
			USE IN PackingSlip_NO
		EndIf
		IF USED('ShipAddr') AND close_ShipAddr
			USE IN ShipAddr
		EndIf
		IF USED('SoldAddr') AND close_SoldAddr
			USE IN SoldAddr
		EndIf
		IF USED('PackingSlip') AND close_PackingSlip
			USE IN PackingSlip
		EndIf
		IF USED('Sales') AND close_Sales
			USE IN Sales
		EndIf
		IF USED('Sales_No') AND close_Sales_No
			USE IN Sales_No
		EndIf
		IF USED('FilterSales')
			USE IN FilterSales
		EndIf
		
		IF USED('AllQuotes') AND close_AllQuotes
			USE IN AllQuotes
		EndIf
		IF USED('Ship') AND close_Ship
			USE IN Ship
		EndIf
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
	ENDPROC

	PROCEDURE filterso
		LOCAL cYear, cSPSYear, cMonthDigit, cSPSMonthDigit ,cSalesPFilter, cCustomerFilter, cAlloyFilter
		LOCAL cAddAnd
		lResetMonth = .F.
		cMonthDigit = ""
		cSPSMonthDigit = ""
		
		*Year
		IF ThisForm.pgfAll.pgSearch.cmbYear.VALUE = "Not"
			*cYear = "Shipped = CTOD('  /  /  ') "
			cYear = "Shipped < '1900/01/01' "
			cSPSYear = "PS_Date < '1900/01/01' "
		ELSE
			IF EMPTY(ThisForm.pgfAll.pgSearch.cmbYear.VALUE)
				cYear = "YEAR(SHIPPED) = YEAR(GetDate())"
				cSPSYear = "YEAR(SPS.PS_Date) = YEAR(GetDate())"
				WAIT WINDOW 'Using Current Year'
			ELSE
				cYear = "YEAR(SHIPPED) = "+ThisForm.pgfAll.pgSearch.cmbYear.VALUE
				cSPSYear = "YEAR(SPS.PS_Date) = "+ThisForm.pgfAll.pgSearch.cmbYear.VALUE
			ENDIF
		ENDIF
		
		
		*Month
		IF ThisForm.pgfAll.pgSearch.lstMonths.LISTCOUNT = 0
			cMonthDigit = ""
			cSPSMonthDigit = ""
		ELSE
			FOR i = 1 TO ThisForm.pgfAll.pgSearch.lstMonths.LISTCOUNT
				IF ThisForm.pgfAll.pgSearch.lstMonths.SELECTED(i)
					cMonthDigit = cMonthDigit+IIF(EMPTY(cMonthDigit)," AND ("," OR ")+"MONTH(SHIPPED) = "+ThisForm.pgfAll.pgSearch.lstMonths.LIST(i)
					cSPSMonthDigit = cSPSMonthDigit+IIF(EMPTY(cSPSMonthDigit)," AND ("," OR ")+"MONTH(SPS.PS_Date) = "+ThisForm.pgfAll.pgSearch.lstMonths.LIST(i)
					IF ThisForm.pgfAll.pgSearch.lstMonths.LIST(i) = "NA"
						lResetMonth = .T.
					ENDIF
				ENDIF
			ENDFOR
		
			IF lResetMonth
				cMonthDigit = ""
				cSPSMonthDigit = ""
			ENDIF
			IF !EMPTY(cMonthDigit)
				cMonthDigit = cMonthDigit+")"
				cSPSMonthDigit = cSPSMonthDigit+")"
			ENDIF
		ENDIF
		
		*!*	*Employee
		*!*	IF ThisForm.pgfAll.pgSearch.cmbAllEmployees.VALUE <> "*"
		*!*		cAddAnd = IIF(EMPTY(cYear) AND EMPTY(cMonthDigit),""," AND")
		*!*		cSalesPFilter= cAddAnd +" AllQuotes.SalesP = '" +ThisForm.pgfAll.pgSearch.cmbAllEmployees.VALUE+"'"
		*!*	ELSE
		*!*		cSalesPFilter= ""
		*!*	ENDIF
		
		*!*	*Company
		*!*	cCustomerFilter = ""
		*!*	IF ThisForm.pgfAll.pgSearch.chkCompany.VALUE = 1
		*!*		cAddAnd = IIF(EMPTY(cYear) AND EMPTY(cMonthDigit) AND EMPTY(cSalesPFilter),""," AND")
		*!*		cCustomerFilter = cAddAnd +" AllQuotes.Company = '" +ThisForm.pgfAll.pgSearch.cmbCompany.VALUE+"'"
		*!*	ENDIF
		
		*!*	*Alloy
		*!*	cAlloyFilter = ""
		*!*	IF ThisForm.pgfAll.pgSearch.chkAlloy.VALUE = 1
		*!*		cAddAnd = IIF(EMPTY(cYear) AND EMPTY(cMonthDigit) AND EMPTY(cSalesPFilter) AND EMPTY(cCustomerFilter),""," AND")
		*!*		cAlloyFilter = cAddAnd +" AllQuotes.Alloy = '" +ALLTRIM(ThisForm.pgfAll.pgSearch.cmbAlloy.VALUE)+"'"
		*!*	ENDIF
		
		*!*	*Heat
		*!*	cHeatFilter = ""
		*!*	IF ThisForm.pgfAll.pgSearch.chkHeat.VALUE = 1 AND !EMPTY(ThisForm.pgfAll.pgSearch.txtHeat.VALUE)
		*!*		cAddAnd = IIF(EMPTY(cYear);
		*!*			AND EMPTY(cMonthDigit) ;
		*!*			AND EMPTY(cSalesPFilter) ;
		*!*			AND EMPTY(cCustomerFilter) ;
		*!*			AND EMPTY(cAlloyFilter) ,""," AND")
		*!*		cHeatFilter = cAddAnd +" Sales.Heat LIKE '%" +ALLTRIM(ThisForm.pgfAll.pgSearch.txtHeat.VALUE)+"%'"
		*!*	ENDIF
		
		*!*	*POnum
		*!*	cPONumFilter = ""
		*!*	IF ThisForm.pgfAll.pgSearch.chkPoNum.VALUE = 1 AND !EMPTY(ThisForm.pgfAll.pgSearch.txtPoNum.VALUE)
		*!*		cAddAnd = IIF(EMPTY(cYear);
		*!*			AND EMPTY(cMonthDigit) ;
		*!*			AND EMPTY(cSalesPFilter) ;
		*!*			AND EMPTY(cCustomerFilter) ;
		*!*			AND EMPTY(cAlloyFilter) ;
		*!*			AND EMPTY(cHeatFilter) ,""," AND")
		*!*		cPONumFilter = cAddAnd +" UPPER(AllQuotes.PO_Num) LIKE '%" +UPPER(ALLTRIM(ThisForm.pgfAll.pgSearch.txtPoNum.VALUE))+"%'"
		*!*	ENDIF
		
		*!*	*HpaPO
		*!*	cHpaPOFilter = ""
		*!*	IF ThisForm.pgfAll.pgSearch.chkHpaPO.VALUE = 1
		*!*		nHpaPo = 0
		*!*		IF TYPE('ThisForm.pgfAll.pgSearch.txtHpaPO.VALUE') = "N"
		*!*			nHpaPo = ThisForm.pgfAll.pgSearch.txtHpaPO.VALUE
		*!*		ENDIF
		*!*		IF TYPE('ThisForm.pgfAll.pgSearch.txtHpaPO.VALUE') = "C"
		*!*			nHpaPo = VAL(ThisForm.pgfAll.pgSearch.txtHpaPO.VALUE)
		*!*		ENDIF
		
		*!*		IF nHpaPo > 0
		*!*			cAddAnd = IIF(EMPTY(cYear);
		*!*				AND EMPTY(cMonthDigit) ;
		*!*				AND EMPTY(cSalesPFilter) ;
		*!*				AND EMPTY(cCustomerFilter) ;
		*!*				AND EMPTY(cAlloyFilter) ;
		*!*				AND EMPTY(cHeatFilter) ;
		*!*				AND EMPTY(cPONumFilter) ,""," AND")
		*!*			cHpaPOFilter = cAddAnd +" AllQuotes.HpaPO = " +ALLTRIM(STR(nHpaPO))
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*SalesNum
		*!*	cSalesNumFilter = ""
		*!*	IF ThisForm.pgfAll.pgSearch.chkSalesNum.VALUE = 1
		*!*		nSalesNum = 0
		*!*		IF TYPE('ThisForm.pgfAll.pgSearch.txtSalesNum.VALUE') = "N"
		*!*			nSalesNum = ThisForm.pgfAll.pgSearch.txtSalesNum.VALUE
		*!*		ENDIF
		*!*		IF TYPE('ThisForm.pgfAll.pgSearch.txtSalesNum.VALUE') = "C"
		*!*			nSalesNum = VAL(ThisForm.pgfAll.pgSearch.txtSalesNum.VALUE)
		*!*		ENDIF
		
		*!*		IF nSalesNum > 0
		*!*			cAddAnd = IIF(EMPTY(cYear);
		*!*				AND EMPTY(cMonthDigit) ;
		*!*				AND EMPTY(cSalesPFilter) ;
		*!*				AND EMPTY(cCustomerFilter) ;
		*!*				AND EMPTY(cAlloyFilter) ;
		*!*				AND EMPTY(cHeatFilter) ;
		*!*				AND EMPTY(cPONumFilter) ;
		*!*				AND EMPTY(cHpaPOFilter) ,""," AND")
		*!*			cSalesNumFilter = cAddAnd +" AllQuotes.SalesNum = " +ALLTRIM(STR(nSalesNum))
		*!*		ENDIF
		*!*	ENDIF
		
		
		*!*	*ShipCity
		*!*	*ThisForm.pgfAll.pgView.grdSales.RECORDSOURCE = ''
		*!*	IF USED('FilterSales')
		*!*		USE IN FilterSales
		*!*	ENDIF
		*!*	SELECT 0
		
		gvSalesWhere = "Sales.Cncld=0 AND ISNULL(Sales.cmplt,0)=1 "
		gvSalesWhere = gvSalesWhere +" AND " +cYear +cMonthDigit 
		ThisForm.SalesWhere = gvSalesWhere
		
		gvSPSWhere = "SPS.Cncld=0 "
		gvSPSWhere = gvSPSWhere +" AND " +cSPSYear +cSPSMonthDigit 
		ThisForm.SPSWhere = gvSPSWhere
		
		*!*	gvSalesWhere = gvSalesWhere +cSalesPFilter 
		*!*	gvSalesWhere = gvSalesWhere +cCustomerFilter +cAlloyFilter +cHeatFilter +cPONumFilter +cHpaPOFilter +cSalesNumFilter
		
		
		cSQL = "SELECT Sales.soitem, Sales.shipdue, Sales.shipped, Sales.cncld, Sales.cmplt"
		cSQL = cSQL +",CAST(LEFT(Sales.soitem,7) AS INT) AS SalesNum "
		cSQL = cSQL +",Allquotes.company, Allquotes.SalesP, Allquotes.Alloy "
		cSQL = cSQL +" FROM dbo.Sales WITH(NOLOCK) LEFT OUTER JOIN dbo.AllQuotes WITH(NOLOCK) ON Sales.SOitem = Allquotes.SOitem "
		cSQL = cSQL +" WHERE LEN(Sales.SOitem)>0 AND "+(ThisForm.SalesWhere)
		cSQL = cSQL +" ORDER BY Sales.SOitem"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FilterSales')
		ENDIF
		
		*THIS.PARENT.PARENT.pgView.SETFOCUS
		*THIS.PARENT.PARENT.pgView.grdSales.RECORDSOURCETYPE = 1
		*ThisForm.pgfAll.pgView.grdSales.RECORDSOURCE = 'FilterSales'
		*ThisForm.pgfAll.pgView.grdSales.Refresh
		
		*MESSAGEBOX( ThisForm.SalesWhere )
		
		IF USED('FilterSales')
			SELECT FilterSales
			
			IF RECCOUNT('FilterSales') < 1
		*		WAIT WINDOW 'No Records' NOWAIT
				MESSAGEBOX("No Records found, Try again",0+48,"Nothing to Display")
				THISFORM.vSalesFiltered = .F.
			ELSE
		
				THISFORM.RefreshView()
				ThisForm.pgfAll.pgTotals.edtvSalesWhere.Value = ThisForm.SalesWhere
				
		*		ThisForm.pgfAll.pgView.SETFOCUS
				THISFORM.vSalesFiltered = .T.
			ENDIF
		ELSE
			WAIT WINDOW 'No Records' NOWAIT
			MESSAGEBOX('Bad SQL statement!')
			THISFORM.vSalesFiltered = .F.
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PUBLIC aUcompany[1], aUalloy[1]
		aUcompany(1) = "Not Selected"
		aUalloy(1) = "Not Selected"
		*ThisForm.pgfAll.pgView.pgfSOitem.pgPackingSlip.grdPackingslip.RecordSource = "SELECT PackingSli,pcs,descript,Packedweight,po_num,Heat,weight,alloy FROM PackingSlip WHERE PackingSlip.SOitem = Sales.SOItem INTO CURSOR tmpPackingSlip"
		PUBLIC gnSales,gnCost,gnProfit,gnAveSale,gnAveCost,gnOrdereItems,gnPounds,gcSalesSalesP
		PUBLIC gvSalesWhere, gnPS_Total, gnQ_Total, gnStkCost, gnPOCost
		
		ThisForm.cSalesP = ''
		
		ThisForm.SalesWhere = ""
		ThisForm.SPSWhere = ""
		
		ThisForm.FilterSO()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		*IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*	SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		*ENDIF 
		PUBLIC close_PackingSlip_NO,close_ShipAddr,close_SoldAddr,close_PackingSlip,close_Sales,close_AllQuotes,close_Ship,close_Sales_No
		close_PackingSlip_NO = .F.
		close_ShipAddr		= .F.
		close_SoldAddr		= .F.
		close_PackingSlip	= .F.
		close_Sales			= .F.
		close_Sales_No			= .F.
		close_AllQuotes		= .F.
		close_Ship			= .F.
		
		STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle
		
		PUBLIC aCompany_AllquotesSales[1]
		aCompany_AllquotesSales(1) = " "
		PUBLIC aEmployees[1]
		aEmployees(1) = ""
		
		IF USED('FilterSales')
			USE IN FilterSales
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Sales.soitem, Sales.shipdue, Sales.shipped, Sales.cncld, Sales.cmplt"
		cSQL = cSQL +",CAST(LEFT(Sales.soitem,7) AS INT) AS SalesNum "
		cSQL = cSQL +",Allquotes.company, Allquotes.salesp, Allquotes.Alloy , AllQuotes.SalesNum "
		cSQL = cSQL +" FROM dbo.Sales WITH(NOLOCK) , dbo.allquotes WITH(NOLOCK) "
		*cSQL = cSQL +" FROM dbo.Sales LEFT OUTER JOIN dbo.allquotes ON Sales.soitem = Allquotes.soitem "
		cSQL = cSQL + " WHERE 0 > 0"
		*cSQL = cSQL + " WHERE LEN(Sales.soitem) > 0"
		*cSQL = cSQL +" ORDER BY Sales.SOitem"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FilterSales')
		ENDIF
		
		
		IF NOT USED('PackingSlip_NO')
			ThisForm.Seek_PackingSli_in_PackingSlip_No( 0 )
			close_PackingSlip_NO = .T.
		EndIf
		IF NOT USED('ShipAddr')
			ThisForm.Seek_ShipCode_in_ShipAddr( 0 )
			close_ShipAddr = .T.
		EndIf
		IF NOT USED('SoldAddr')
			ThisForm.Seek_SoldCode_in_SoldAddr( 0 )
			close_SoldAddr = .T.
		EndIf
		IF NOT USED('PackingSlip')
			ThisForm.Seek_SOitem_in_PackingSlip( 0 )
			close_PackingSlip = .T.
		EndIf
		IF NOT USED('Sales')
			ThisForm.Seek_SOitem_in_Sales( '' )
			close_Sales = .T.
		EndIf
		IF NOT USED('Sales_No')
			ThisForm.Seek_SO_in_Sales_No( 0 )
			close_Sales_No = .T.
		EndIf
		IF NOT USED('AllQuotes')
			ThisForm.Seek_SOitem_in_AllQuotes('')
			
			close_AllQuotes = .T.
		EndIf
		IF NOT USED('Ship')
			ThisForm.Seek_SOitem_in_Ship( '' )
			close_Ship	= .T.
		EndIf
		
		
	ENDPROC

	PROCEDURE refreshview		&& Refresh View tab after SO row changes
		*!*	WAIT WINDOW "Refreshing View" NOWAIT
		
		*!*	PRIVATE nPage
		*!*	*nPage = ThisForm.pgfAll.pgView.pgfSOitem.ActivePage
		
		
		*!*	DO Case
		*!*	CASE nPage = 1 &&Sales
		*!*		ThisForm.Seek_SOitem_in_Sales( FilterSales.SOItem )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgSales.Refresh()
		*!*	CASE nPage = 2 &&Sales2
		*!*		ThisForm.Seek_SOitem_in_Sales( FilterSales.SOItem )
		*!*		ThisForm.Seek_SO_in_Sales_No( FilterSales.SalesNum )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgSales2.Refresh()
		*!*	CASE nPage = 3 &&PackingSlipItem
		*!*		ThisForm.Seek_SOitem_in_PackingSlip( FilterSales.SOItem )
		*!*		ThisForm.Seek_PackingSli_in_PackingSlip_No( Packingslip.PackingSli )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgPSItems.Refresh()
		*!*	CASE nPage = 4 &&SoldAddr
		*!*	ThisForm.Seek_SOitem_in_PackingSlip( FilterSales.SOItem )
		*!*		ThisForm.Seek_PackingSli_in_PackingSlip_No( Packingslip.PackingSli )
		*!*		ThisForm.Seek_SoldCode_in_SoldAddr( PackingSlip_NO.SoldCode )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgSoldAddress.Refresh()
		*!*	CASE nPage = 5 &&ShipAddr
		*!*		ThisForm.Seek_SOitem_in_PackingSlip( FilterSales.SOItem )
		*!*		ThisForm.Seek_PackingSli_in_PackingSlip_No( Packingslip.PackingSli )
		*!*		ThisForm.Seek_ShipCode_in_ShipAddr( PackingSlip_NO.ShipCode )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgShipAddress.Refresh()
		*!*	CASE nPage = 6 &&Quotes1
		*!*		ThisForm.Seek_SOitem_in_AllQuotes( FilterSales.SOItem )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgQuotes1.Refresh()
		*!*	CASE nPage = 7 &&Quotes2
		*!*		ThisForm.Seek_SOitem_in_AllQuotes( FilterSales.SOItem )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgQuotes2.Refresh()
		*!*	CASE nPage = 8 &&Ship
		*!*		*SEEK FilterSales.SOItem IN Ship ORDER TAG soitem
		*!*		ThisForm.Seek_SOitem_in_Ship( FilterSales.SOItem )
		*!*		ThisForm.pgfAll.pgView.pgfSOitem.pgship.Refresh()
		*!*	ENDCASE
		
		*!*	SELECT FilterSales
		
		*!*	WAIT CLEAR
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDH, nDW
		
		nDH = ThisForm.Height - 443
		nDW = ThisForm.Width - 646
		
		
		ThisForm.pgfAll.Height = 432 + nDH
		
		ThisForm.pgfAll.pgTotals.cmdExit.Top = 355 + nDH
		ThisForm.pgfAll.pgTotals.lstSalesSalesP.Height = 170 + nDH
	ENDPROC

	PROCEDURE seek_packingsli_in_packingslip_no
		PARAMETERS pnPackingSli
		*ThisForm.Seek_PackingSli_in_PackingSlip_No( Packingslip.PackingSli )
		
		IF VARTYPE(pnPackingSli) != "N"
			pnPackingSli = 0
		ENDIF
		
		IF USED('PackingSlip_No')
			USE IN PackingSlip_No
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.PackingSlip_No WITH(NOLOCK) WHERE "
		
		IF EMPTY(pnPackingSli)
			cSQL = cSQL + " 0>0 "
		ELSE
			cSQL = cSQL + " PackingSli = "+STR(pnPackingSli)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PackingSlip_No')
		ENDIF
		IF USED('PackingSlip_No')
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE seek_shipcode_in_shipaddr		&& Seek ShipCode in ShipAddr
