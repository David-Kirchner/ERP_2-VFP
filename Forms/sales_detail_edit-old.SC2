				ThisFormset.frmSales_Reconcile.Visible = .T.
				ThisFormset.frmSales_Reconcile.txtID_Sales_Detail.Value 			= 0
				ThisFormset.frmSales_Reconcile.txtSOitem.Value 		= ThisFormSet.SOitem
				ThisFormset.frmSales_Reconcile.txtStockEdit.Value 	= CTOD("  /  /  ")
				ThisFormset.frmSales_Reconcile.txtPS_Date.Value 	= CTOD("  /  /  ")
				ThisFormset.frmSales_Reconcile.txtInvoiceDate.Value	= CTOD("  /  /  ")
				ThisFormset.frmSales_Reconcile.txtAlloy.Value	= ''
				ThisFormset.frmSales_Reconcile.txtForm.Value	= ''
				ThisFormset.frmSales_Reconcile.txtCC.Value		= ''
				ThisFormset.frmSales_Reconcile.txtCL.Value		= ''
				
				ThisFormset.frmSales_Reconcile.txtQuoted_QTY.Value 	= 0
				ThisFormset.frmSales_Reconcile.txtQuoted_PU.Value 	= Get_PUtext(0)
				ThisFormset.frmSales_Reconcile.txtQuoted_P.Value 	= 0
				ThisFormset.frmSales_Reconcile.txtQuoted_Total.Value= 0
				ThisFormset.frmSales_Reconcile.txtQuoted_PC.Value 	= 0
				ThisFormset.frmSales_Reconcile.txtQuoted_Dim1.Value	= 0
				ThisFormset.frmSales_Reconcile.txtQuoted_LBS.Value 	= 0
				
				ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value 	= 0
				ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value 	= Get_PUtext(0)
				ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= 0
				ThisFormset.frmSales_Reconcile.txtStkPaid_P.Value 		= 0
				ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value	= 0
				ThisFormset.frmSales_Reconcile.txtStkPaid_Total.Value 		= 0
				ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value 	= 0
				ThisFormset.frmSales_Reconcile.txtStockLst_Dim1.Value	= 0
				ThisFormset.frmSales_Reconcile.txtStockLst_LBS.Value 	= 0
				
				ThisFormset.frmSales_Reconcile.txtSale_QTY.Value	= 0
				ThisFormset.frmSales_Reconcile.txtSale_PC.Value		= 0
				ThisFormset.frmSales_Reconcile.txtDescript.Value	= ''
				ThisFormset.frmSales_Reconcile.txtWeight.Value		= 0
				
				ThisFormset.frmSales_Reconcile.txtInvoice_QTY.Value	= 0
				ThisFormset.frmSales_Reconcile.txtInvoice_P.Value	= 0
				ThisFormset.frmSales_Reconcile.txtInvoice_Total.Value		= 0
				ThisFormset.frmSales_Reconcile.txtFreight.Value		= 0
				ThisFormset.frmSales_Reconcile.txtReconDiff.Value	= 0
				ThisFormset.frmSales_Reconcile.txtDisc_Allowed.Value= 0
				ThisFormset.frmSales_Reconcile.txtSOProfitMargin.Value		= 0
				
			ENDIF
			**************************************
			
			cSQL = "SELECT S.*,Q.Pieces,Q.Thck,Q.Weight "
			cSQL = cSQL +" ,dbo.f_DescriptCL(Q.Alloy,Q.CC,Q.CL,Q.Form,Q.Thck,Q.Sz2,Q.Sz3,Q.Weight,Q.RandLen) AS Descript "
			cSQL = cSQL +" FROM dbo.Sales S"
			cSQL = cSQL +" INNER JOIN dbo.AllQuotes Q ON S.Soitem = Q.SOitem "
			IF EMPTY( cSOitem )
				cSQL = cSQL +" WHERE 0>0 "
			ELSE
				cSQL = cSQL +" WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
		
			IF USED('tmpSales')
				USE IN tmpSales
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales' )
			ENDIF
		
			IF USED('tmpSales')
				IF RECCOUNT('tmpSales') > 0
					ThisFormset.frmSales_Reconcile.txtSales_QTY.Value 	= PrepareSQLnum(tmpSales.Quoted_QTY,'Quoted_QTY',-5)
					ThisFormset.frmSales_Reconcile.txtSales_PU.Value 	= Get_PUtext( tmpSales.Quoted_PU )
					ThisFormset.frmSales_Reconcile.txtSales_P.Value 	= PrepareSQLnum(tmpSales.Quoted_P,'Quoted_P',-5)
					ThisFormset.frmSales_Reconcile.txtSales_Total.Value= PrepareSQLnum(tmpSales.Quoted_Total,'Quoted_Total',-5)
					
					ThisFormset.frmSales_Reconcile.txtSales_PC.Value 	= PrepareSQLnum(tmpSales.Pieces,'Pieces',-3)
					*ThisFormset.frmSales_Reconcile.txtSales_Dim1.Value	= PrepareSQLnum(tmpSales.Thck,'Thck',10,4)
					ThisFormset.frmSales_Reconcile.txtSales_Descript.Value	= PrepareSQLtxt(tmpSales.Descript,'Descript',-1)
					ThisFormset.frmSales_Reconcile.txtSales_LBS.Value 	= PrepareSQLnum(tmpSales.Weight ,'Weight ',7,2)
				ELSE
					ThisFormset.frmSales_Reconcile.txtSales_QTY.Value 	= 0
					ThisFormset.frmSales_Reconcile.txtSales_PU.Value 	= 0
					ThisFormset.frmSales_Reconcile.txtSales_P.Value 	= 0
					ThisFormset.frmSales_Reconcile.txtSales_Total.Value = 0
					
					ThisFormset.frmSales_Reconcile.txtSales_PC.Value 	= 0
					*ThisFormset.frmSales_Reconcile.txtSales_Dim1.Value	= 0
					ThisFormset.frmSales_Reconcile.txtSales_Descript.Value	= ''
					ThisFormset.frmSales_Reconcile.txtSales_LBS.Value 	= 0		
				ENDIF
				USE IN tmpSales
			ENDIF
				
			**************************************
			ThisFormSet.Show_lstSales_Detail_ID()
			
			*Sum Stock
			ThisFormSet.ShowSumStock()
			
			*Sum PackingSlip
			ThisFormSet.ShowSumPackingSlip()
		
			*Sum Invoice
			ThisFormSet.ShowSumInvoice()
			
			*Show Quoted
			ThisFormSet.ShowQuotedTotal()
				
			*AllQuote
			ThisFormSet.Show_Quote()		
			
			*Add up SO item
			ThisFormSet.ShowSumTotal()
			
		ELSE
			ThisFormset.frmSales_Reconcile.Visible = .F.
		ENDIF
	ENDPROC

