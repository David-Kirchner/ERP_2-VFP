				cSQL = cSQL +" AND Sale_QTY="+STR(nSale_QTY,18,4)
				cSQL = cSQL +" AND Sale_PC="+STR(nSale_PC,18,4)
				cSQL = cSQL +" AND Descript='"+cDescript+"'"
				cSQL = cSQL +" AND Sale_LBS="+STR(nSale_LBS,7,1)
				
