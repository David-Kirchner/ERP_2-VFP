				cSQL = cSQL +" AND Quoted_P="+STR(nQuoted_P,18,4)
				cSQL = cSQL +" AND Quoted_Total="+STR(nQuoted_Total,18,4)
				cSQL = cSQL +" AND Quoted_PU="+STR(nQuoted_PU)
				cSQL = cSQL +" AND Quoted_PC="+STR(nQuoted_PC,18,4)
				cSQL = cSQL +" AND Quoted_Dim1="+STR(nQuoted_Dim1,18,4)
				cSQL = cSQL +" AND Quoted_LBS="+STR(nQuoted_LBS,7,1)
		
				cSQL = cSQL +" AND StockLst_QTY="+STR(nStockLst_QTY,18,4)
				cSQL = cSQL +" AND StockLst_P="+STR(nStockLst_P,18,4)
				cSQL = cSQL +" AND StkPaid_P="+STR(nStkPaid_P,18,4)
				cSQL = cSQL +" AND StockLst_Total="+STR(nStockLst_Total,18,4)
				cSQL = cSQL +" AND StkPaid_Total="+STR(nStkPaid_Total,18,4)
				cSQL = cSQL +" AND StockLst_PU="+STR(nStockLst_PU)
				cSQL = cSQL +" AND StockLst_PC="+STR(nStockLst_PC)
				cSQL = cSQL +" AND StockLst_Dim1="+STR(nStockLst_Dim1,18,4)
				cSQL = cSQL +" AND StockLst_LBS="+STR(nStockLst_LBS,7,1)
		
				cSQL = cSQL +" AND Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				
				cSQL = cSQL +" AND StockEdit='"+IIF(dtStockEdit    =CTOD("  /  /  "),'',TTOC(dtStockEdit))+"'"
				cSQL = cSQL +" AND Shipped='"+IIF(dShipped    =CTOD("  /  /  "),'',DTOC(dShipped))+"'"
				cSQL = cSQL +" AND InvoiceDate='"+IIF(dInvoiceDate=CTOD("  /  /  "),'',DTOC(dInvoiceDate))+"'"
				
				cSQL = cSQL +" AND Invoice_QTY="+STR(nInvoice_QTY,18,4)
				cSQL = cSQL +" AND Invoice_P="+STR(nInvoice_P,18,4)
				cSQL = cSQL +" AND Invoice_Total="+STR(nInvoice_Total,18,4)
		
				cSQL = cSQL +" AND ProfitMargin="+STR(nProfitMargin,18,4)
				cSQL = cSQL +" AND Disc_Allowed="+STR(nDisc_Allowed,18,4)
				cSQL = cSQL +" AND ReconDiff="+STR(nReconDiff,18,4)
				cSQL = cSQL +" AND Freight="+STR(nfreight,18,4)
				cSQL = cSQL +" AND Reconciled="+IIF(lReconciled,"1","0")
								
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL ,'tmpSales_DetailID' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL ,'tmpSales_DetailID' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'tmpSales_DetailID' )
				ENDIF
				IF USED('tmpSales_DetailID')
					IF RECCOUNT('tmpSales_DetailID') > 0
						nID_Sales_Detail = tmpSales_DetailID.ID
						ThisFormset.frmSales_Reconcile.txtID_Sales_Detail.Value 	= nID_Sales_Detail
						ThisFormSet.Init_lstSales_Detail_ID()
					ENDIF
					USE IN tmpSales_DetailID	
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		PRIVATE lPassed
		lPassed = .T.
		
		IF VARTYPE(nID_Sales_Detail) != "N"
			MESSAGEBOX("No Sales_Detail_ID ",0,"Error")
			TrackError("No Sales_Detail_ID ","No Save Reconcile!","Sales_Detail_Edit:cmdSave.Click",LINENO())
			lPassed = .F.
		ELSE
			IF nID_Sales_Detail < 1
				MESSAGEBOX("No Sales_Detail_ID ",0,"Error")
				TrackError("No Sales_Detail_ID ","No Save Reconcile!","Sales_Detail_Edit:cmdSave.Click",LINENO())
				lPassed = .F.
			ENDIF
		ENDIF
		
		IF lPassed 
			lPassed = ThisFormSet.Save_Invoice_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		IF lPassed 
			lPassed = ThisFormSet.Save_Invoice_Frt_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		IF lPassed 
			lPassed = ThisFormSet.Save_PackingSlip_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		IF lPassed 
			lPassed = ThisFormSet.Save_Sales_Stock_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		
		*!*	IF lPassed 
		*!*		lPassed = ThisFormSet.Update_Current_Stock_Price(lReconciled,nID_Sales_Detail)
		*!*	ENDIF
		
		IF lPassed 
			IF lReconciled
				 ThisFormSet.Clear_StockLst_Process(cSOitem)
			ENDIF
		ENDIF
		
		*******************************
		PRIVATE nFoundUnRec
		nFoundUnRec = 0
		
		*Get UnRec
		IF USED('tmpUnRec')
			USE IN tmpUnRec
		ENDIF
		
		SELECT 0
		cSQL = "SELECT COUNT(*) AS Cntd "
		cSQL = cSQL +" FROM dbo.Sales_Invoice "
		cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL +" AND Reconciled=1 "
						
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL ,'tmpUnRec' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL ,'tmpUnRec' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'tmpUnRec' )
		ENDIF
		IF USED('tmpUnRec')
			IF RECCOUNT('tmpUnRec') > 0
				nFoundUnRec = tmpUnRec.Cntd 
			ENDIF
			USE IN tmpUnRec	
		ENDIF
			
		********************************
		
		IF lPassed 
			IF nFoundUnRec = 0
				*lReconciled
			
				*ThisFormSet.frmSalesOrder.chkReconciled.Value = IIF(lReconciled,1,0)
				ThisFormSet.frmSales_Reconcile.Visible = .F.
				ThisFormSet.frmInvoice.Visible = .F.
				ThisFormSet.frmInvoiceFrt.Visible = .F.
				ThisFormSet.frmSales_stock.Visible = .F.
				ThisFormSet.frmPackingSlip.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
			ENDIF		
			MESSAGEBOX("SOitem-Invoice has been reconciled.",0+64,"Saved.")
		ENDIF
		
		
	ENDPROC

	PROCEDURE save_invoice_frt_reconcile
		PARAMETERS pReconciled, nSales_Detail_ID
		*ThisFormSet.Save_Invoice_Frt_Reconcile(pReconciled, nSales_Detail_ID)
		
		IF NOT USED('tmpInvoiceFrt')
			*Only used when Freght is paid oustside of SO.
		*	MESSAGEBOX("No 'tmpInvoiceFrt' table",0,"Error")
		*	TrackError("No 'tmpInvoiceFrt' table","No table","Sales_DetailEdit:Sales_Detail.Save_Invoice_Reconcile",LINENO())
			RETURN .T.
		ENDIF
		IF RECCOUNT('tmpInvoiceFrt') < 1
		*	MESSAGEBOX("No 'tmpInvoiceFrt' table",0,"Error")
		*	TrackError("No 'tmpInvoiceFrt' table","No table","Sales_DetailEdit:Sales_Detail.Save_Invoice_Reconcile",LINENO())
			RETURN .T.
		ENDIF
		IF VARTYPE(pReconciled) != "L"
			TrackError("Bad Parameter","Bad Parameter","Sales_DetailEdit:Sales_Detail.Save_Invoice_Reconcile",LINENO())
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpInvoiceFrt
		PRIVATE nRecNo
		nRecNo = RECNO()
		PRIVATE lPassed
		lPassed = .T.
		
		PRIVATE nInvoice
		nInvoice	= PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		* Do not Just get Invoice from here
		
		PRIVATE nQuantity, nAmount
		*PRIVATE nID, 
		PRIVATE cSOitem00, lReconciled 
		
		SCAN FOR NOT DELETED()
			*nID = tmpInvoiceFrt.ID
			lReconciled = pReconciled
			
			cSOitem00 = tmpInvoiceFrt.SOitem
		
			cSQL = "UPDATE dbo.Sales_Invoice SET Reconciled=" + IIF(lReconciled,'1','0')
			cSQL = cSQL + " ,Sales_Detail_ID="+ALLTRIM(STR(nSales_Detail_ID))
			*cSQL = cSQL + ",Amount="+ALLTRIM(STR(n))
			cSQL = cSQL + " WHERE Invoice = "+ALLTRIM(STR( nInvoice ))
			cSQL = cSQL + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem00+"')"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC  )
				lPassed = .F.
			ENDIF
		
		ENDSCAN
		GOTO nRecNo
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lPassed 
	ENDPROC

	PROCEDURE save_invoice_reconcile
		PARAMETERS pReconciled, nSales_Detail_ID
		*ThisFormSet.Save_Invoice_Reconcile(pReconciled, nSales_Detail_ID)
		
		IF NOT USED('tmpInvoice')
			MESSAGEBOX("No 'tmpInvoice' table",0,"Error")
			TrackError("No 'tmpInvoice' table","No table","Sales_DetailEdit:Sales_Detail.Save_Invoice_Reconcile",LINENO())
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpInvoice') < 1
			MESSAGEBOX("No 'tmpInvoice' table",0,"Error")
			TrackError("No 'tmpInvoice' table","No table","Sales_DetailEdit:Sales_Detail.Save_Invoice_Reconcile",LINENO())
			RETURN .F.
		ENDIF
		
		PRIVATE lChangeReconcile
		lChangeReconcile = .F.
		IF ISNULL(pReconciled)
			lChangeReconcile = .F.
		ELSE
			IF VARTYPE(pReconciled) != "L"
				TrackError("Bad Parameter","Bad Parameter","Sales_DetailEdit:Sales_Detail.Save_Invoice_Reconcile",LINENO())
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpInvoice
		PRIVATE nRecNo
		nRecNo = RECNO()
		PRIVATE lPassed
		lPassed = .T.
		
		PRIVATE nInvoice
		*nInvoice = PrepareSQLnum(ThisFormSet.frmSalesOrder.txtInvoice.Value,'Invoice',-3) frmInvoice
		nInvoice = PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3) 
		
		PRIVATE nQuantity, nPaid
		PRIVATE nID, lReconciled 
		PRIVATE cSQL, nSQLEXEC 
		
		SCAN FOR NOT DELETED()
			nID = tmpInvoice.ID
			IF lChangeReconcile 
				lReconciled = pReconciled
			ELSE
				lReconciled = PrepareSQLlogic(tmpInvoice.Reconciled,'Reconciled')
			ENDIF
			
			nQuantity 	= PrepareSQLnum(tmpInvoice.Quantity,'Quantity',-3)
			nPaid		= PrepareSQLnum(tmpInvoice.Paid,'Paid',-5)
			
			cSQL = "UPDATE dbo.Sales_Invoice "
			cSQL = cSQL + " SET Reconciled=" + IIF(lReconciled,'1','0')
			cSQL = cSQL + ",Invoice ="+ALLTRIM(STR(nInvoice))
			cSQL = cSQL + ",Sales_Detail_ID="+ALLTRIM(STR(nSales_Detail_ID))
			cSQL = cSQL + ",Quantity ="+ALLTRIM(STR(nQuantity))
			cSQL = cSQL + ",Paid ="+ALLTRIM(STR(nPaid,18,4))
			cSQL = cSQL + " WHERE ID = "+ALLTRIM(STR( nID ))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC  )
				lPassed = .F.
			ENDIF
		
		ENDSCAN
		GOTO nRecNo
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lPassed 
	ENDPROC

	PROCEDURE save_packingslip_reconcile
		PARAMETERS pReconciled, nSales_Detail_ID
		*ThisFormSet.Save_PackingSlip_Reconcile(pReconciled, nSales_Detail_ID)
		
		IF NOT USED('tmpPackingSlip')
			MESSAGEBOX("No 'tmpPackingSlip' table",0,"Error")
			TrackError("No 'tmpPackingSlip' table","No Table","Sales_DetailEdit:Save_PackingSlip_Reconcile",LINENO(1))
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpPackingSlip') < 1
		*	MESSAGEBOX("No 'tmpPackingSlip' table",0,"Error")
		*	TrackError("No 'tmpPackingSlip' table","Empty Table","Sales_DetailEdit:Save_PackingSlip_Reconcile",LINENO(1))
		*	RETURN .F.
			RETURN .T.
		ENDIF
		IF VARTYPE(pReconciled) != "L"
			TrackError("Bad Parameter","Bad Parameter","Sales_DetailEdit:Save_PackingSlip_Reconcile",LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpPackingSlip
		PRIVATE nRecNo
		nRecNo = RECNO()
		PRIVATE lPassed
		lPassed = .T.
		
		*PRIVATE nID
		PRIVATE nID_PackingSlip, lReconciled
		
		SCAN FOR NOT DELETED()
			*nID = tmpPackingSlip.PackingSli
			nID_PackingSlip = tmpPackingSlip.ID_PackingSlip
			lReconciled 	= pReconciled
			
			cSQL = "UPDATE dbo.PackingSlip "
			cSQL = cSQL + " SET Reconciled=" + IIF(lReconciled,'1','0')
			cSQL = cSQL + ",Sales_Detail_ID="+ALLTRIM(STR(nSales_Detail_ID))
			cSQL = cSQL+" WHERE ID_PackingSlip= "+ALLTRIM(STR( nID_PackingSlip))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC  )
				lPassed = .F.
			ENDIF
		
		ENDSCAN
		GOTO nRecNo
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lPassed 
	ENDPROC

	PROCEDURE save_sales_stock_reconcile
		PARAMETERS pReconciled, nSales_Detail_ID
		*ThisFormSet.Save_Sales_Stock_Reconcile( pReconciled, nSales_Detail_ID )
		
		IF NOT USED('tmpPackingSlip')
			MESSAGEBOX("No 'tmpSales_Stock' table",0,"Error")
			TrackError("No 'tmpSales_Stock' table","No table","Sales_DetailEdit:Sales_Detail.Save_Sales_Stock_Reconcile",LINENO())
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpSales_Stock') = 0
			**Nothing to Do, No stock was used!!
			RETURN .T.
		ENDIF
		IF VARTYPE(pReconciled) != "L"
			TrackError("Bad Parameter","Bad Parameter","Sales_DetailEdit:Sales_Detail.Save_Sales_Stock_Reconcile",LINENO())
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpSales_Stock
		PRIVATE nRecNo
		nRecNo = RECNO()
		PRIVATE lPassed
		lPassed = .T.
		
		PRIVATE nID, lReconciled 
		
		SCAN FOR NOT DELETED()
			nID = tmpSales_Stock.ID
			cPOitem = PrepareSQLtxt(tmpSales_Stock.StockLst_POitem,'POitem',12)
			lReconciled = pReconciled
			
			cSQL = "UPDATE dbo.Sales_Stock "
			cSQL = cSQL + " SET Reconciled=" + IIF(lReconciled,'1','0')
			cSQL = cSQL + ",Sales_Detail_ID="+ALLTRIM(STR(nSales_Detail_ID))
			IF NOT EMPTY(cPOitem)
				cSQL = cSQL + ",StockLst_POitem=dbo.f_ProperPOitem('"+cPOitem+"')"
			ENDIF
			cSQL = cSQL + " WHERE ID= "+ALLTRIM(STR( nID ))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC  )
				lPassed = .F.
			ENDIF
		
		ENDSCAN
		GOTO nRecNo
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lPassed 
	ENDPROC

	PROCEDURE showquotedtotal
		*ThisFormSet.ShowQuotedTotal()
		
		PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU, nQuoted_LBS
		nQuoted_QTY	= 0
		nQuoted_P	= 0
		nQuoted_Total= 0
		nQuoted_PU	= 0
		nQuoted_LBS	= 0
		
		IF USED('tmpSales_Detail')
			IF RECCOUNT('tmpSales_Detail') > 0
				nQuoted_QTY	 = PrepareSQLnum(tmpSales_Detail.Quoted_QTY,'Quoted_QTY',-5)
				nQuoted_P	 = PrepareSQLnum(tmpSales_Detail.Quoted_P,'Quoted_P',-5)
				nQuoted_Total= PrepareSQLnum(tmpSales_Detail.Quoted_Total,'Quoted_Total',-5)
				nQuoted_PU	 = PrepareSQLnum(tmpSales_Detail.Quoted_PU,'Quoted_PU',-1)
			ENDIF
		ENDIF
		
		IF Proper_SO_item(ThisFormset.SOitem) != Proper_SO_item("")
			IF nQuoted_QTY = 0
				nQuoted_QTY	= Get_QTYinSales( ThisFormset.SOitem, ThisFormSet.nConnHandle )
			ENDIF
			IF nQuoted_P = 0 AND nQuoted_Total = 0
				nQuoted_Total = Get_ItemSaleinSales( ThisFormset.SOitem, ThisFormSet.nConnHandle )
			ENDIF
		ELSE
			nQuoted_QTY = 0
			nQuoted_Total = 0
		ENDIF
		IF nQuoted_P = 0
			IF nQuoted_QTY > 0
				nQuoted_P	= nQuoted_Total / nQuoted_QTY
			ELSE
				nQuoted_P	= 0
			ENDIF
		ENDIF
		
		IF nQuoted_Total = 0
			nQuoted_Total = nQuoted_QTY * nQuoted_P
		ENDIF
		
		IF nQuoted_PU = 0
			nQuoted_PU	= GetPUfromForm( ThisFormset.frmSales_stock.txtForm.Value , ThisFormSet.nConnHandle )
		ENDIF
		
		nQuoted_LBS = Get_LBSinSales( ThisFormset.SOitem, ThisFormSet.nConnHandle )
		 
		ThisFormset.frmSales_Reconcile.txtQuoted_QTY.Value 		= nQuoted_QTY
		ThisFormset.frmSales_Reconcile.txtQuoted_PU.Value 		= Get_PUtext( nQuoted_PU )
		ThisFormset.frmSales_Reconcile.txtQuoted_P.Value		= nQuoted_P
		ThisFormset.frmSales_Reconcile.txtQuoted_Total.Value	= nQuoted_Total
		ThisFormset.frmSales_Reconcile.txtQuoted_LBS.Value		= nQuoted_LBS
			
		
		
	ENDPROC

	PROCEDURE showsuminvoice
		*ThisFormSet.ShowSumInvoice()
		
		IF NOT USED('tmpInvoice')
			MESSAGEBOX("No 'tmpInvoice' table",0,"Error")
			TrackError("No 'tmpInvoice' table","No table","Sales_DetailEdit:Sales_Detail.ShowSumInvoice",LINENO())
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpInvoice') < 1
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpInvoice
		PRIVATE nRecNo, nCount, nSum
		nRecNo = RECNO()
		
		COUNT FOR NOT DELETED() TO nCount
		GOTO nRecNo
		
		IF nCount = 1
			ThisFormset.frmSales_Reconcile.txtInvoiceDate.Value	= tmpInvoice.InvoiceDate
			ThisFormset.frmSales_Reconcile.txtInvoice_QTY.Value	= tmpInvoice.Quantity
			ThisFormset.frmSales_Reconcile.txtInvoice_P.Value	= tmpInvoice.UnitPrice
			ThisFormset.frmSales_Reconcile.txtInvoice_Item.Value	= ABS(tmpInvoice.AR_Amount)
		*	ThisFormset.frmSales_Reconcile.txtFreight.Value		= tmpInvoice.Freight &&Done in _Frt
			ThisFormset.frmSales_Reconcile.txtDisc_Allowed.Value= ABS(tmpInvoice.Disc_Amount)
		
		ENDIF
		IF nCount > 1
			PRIVATE nSumInvoice_QTY, nSumUnitPrice, nSumDisc_Allowed
			SET Talk OFF
			ThisFormset.frmSales_Reconcile.txtInvoiceDate.Value	= tmpInvoice.InvoiceDate
			SUM Quantity FOR NOT DELETED() TO nSumInvoice_QTY
			ThisFormset.frmSales_Reconcile.txtInvoice_QTY.Value	= nSumInvoice_QTY
			
			ThisFormset.frmSales_Reconcile.txtInvoice_P.Value 	= tmpInvoice.UnitPrice 
			SUM Amount FOR NOT DELETED() TO nSumUnitPrice
			ThisFormset.frmSales_Reconcile.txtInvoice_Item.Value		= ABS(nSumUnitPrice)
		
		*	SUM Freight FOR NOT DELETED() TO nSum
		*	ThisFormset.frmSales_Reconcile.txtFreight.Value		= nSUM
			
			SUM Disc_Amount FOR NOT DELETED() TO nSumDisc_Allowed
			ThisFormset.frmSales_Reconcile.txtDisc_Allowed.Value 	= ABS(nSumDisc_Allowed)
		
		ENDIF
		
		GOTO nRecNo
		
		ThisFormSet.frmInvoice.chkReconciled.Refresh
		ThisFormSet.frmInvoice.txtPaid.Refresh
		ThisFormSet.frmInvoice.txtQuantity.Refresh
		
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showsumpackingslip
		*ThisFormSet.ShowSumPackingSlip()
		
		IF NOT USED('tmpPackingSlip')
			MESSAGEBOX("No 'tmpPackingSlip' table",0,"Error")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpPackingSlip') < 1
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpPackingSlip
		PRIVATE nRecNo, nCount, nSum
		nRecNo = RECNO()
		
		COUNT FOR NOT DELETED() TO nCount
		GOTO nRecNo
		
		IF nCount = 1
		
			ThisFormset.frmSales_Reconcile.txtPS_Date.Value		= tmpPackingSlip.PS_Date
			ThisFormset.frmSales_Reconcile.txtSale_QTY.Value	= tmpPackingSlip.Pcs
			ThisFormset.frmSales_Reconcile.txtSale_PC.Value		= tmpPackingSlip.Pcs
			ThisFormset.frmSales_Reconcile.txtDescript.Value	= tmpPackingSlip.Descript
			ThisFormset.frmSales_Reconcile.txtWeight.Value		= tmpPackingSlip.Weight
		
		ENDIF
		IF nCount > 1
			SET Talk OFF
			ThisFormset.frmSales_Reconcile.txtPS_Date.Value		= tmpPackingSlip.PS_Date
			ThisFormset.frmSales_Reconcile.txtDescript.Value	= tmpPackingSlip.Descript
			SUM Pcs FOR NOT DELETED() TO nSum
			ThisFormset.frmSales_Reconcile.txtSale_QTY.Value 	= nSum
		
			SUM Pcs FOR NOT DELETED() TO nSum
			ThisFormset.frmSales_Reconcile.txtSale_PC.Value 	= nSum
		
			SUM Weight FOR NOT DELETED() TO nSum
			ThisFormset.frmSales_Reconcile.txtWeight.Value 	= nSum
		
		ENDIF
		
		GOTO nRecNo
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showsumstock
		*ThisFormSet.ShowSumStock()
		
		IF NOT USED('tmpSales_Stock')
			MESSAGEBOX("No 'tmpSales_Stock' table",0,"Error")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpSales_Stock') < 1
			ThisFormset.frmSales_Reconcile.txtStockEdit.Value		= ''
			ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= 0
			ThisFormset.frmSales_Reconcile.txtStkPaid_P.Value 		= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value	= 0
			ThisFormset.frmSales_Reconcile.txtStkPaid_total.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_Dim1.Value	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_LBS.Value 	= 0
			*ThisFormSet.frmSales_Reconcile.Visible = .F.
			
			RETURN .T.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
			
		SELECT tmpSales_Stock
		PRIVATE nRecNo, nCount, nSum
		nRecNo = RECNO()
		
		COUNT FOR NOT DELETED() TO nCount
		
		GOTO nRecNo
		IF DELETED()
			GO TOP
			DO WHILE DELETED()
				SKIP
			ENDDO		
		ENDIF
		
		IF nCount = 1
			ThisFormset.frmSales_Reconcile.txtStockEdit.Value		= tmpSales_Stock.StockEdit
			ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_QTY,'StockLst_QTY',-5)
			ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value 	= Get_PUtext( tmpSales_Stock.StockLst_PU )
			ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= PrepareSQLnum(tmpSales_Stock.StockLst_P,'StockLst_P',-5)
			ThisFormset.frmSales_Reconcile.txtStkPaid_P.Value 		= PrepareSQLnum(tmpSales_Stock.StkPaid_P,'StkPaid_P',-5)
			ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value	= PrepareSQLnum(tmpSales_Stock.StockLst_Total,'StockLst_Total',-5)
			ThisFormset.frmSales_Reconcile.txtStkPaid_total.Value 	= PrepareSQLnum(tmpSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
			ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value 	= tmpSales_Stock.StockLst_PC
			ThisFormset.frmSales_Reconcile.txtStockLst_Dim1.Value	= tmpSales_Stock.StockLst_Dim1
			ThisFormset.frmSales_Reconcile.txtStockLst_LBS.Value 	= tmpSales_Stock.StockLst_LBS
		ELSE
			ThisFormset.frmSales_Reconcile.txtStockEdit.Value		= ''
			ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= 0
			ThisFormset.frmSales_Reconcile.txtStkPaid_P.Value 		= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value	= 0
			ThisFormset.frmSales_Reconcile.txtStkPaid_total.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value 	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_Dim1.Value	= 0
			ThisFormset.frmSales_Reconcile.txtStockLst_LBS.Value 	= 0
		ENDIF
		
		IF nCount > 1
			PRIVATE nSumStockLst_QTY, nSumStockLst_Total, nSumStkPaid_Total
			SET Talk OFF
			ThisFormset.frmSales_Reconcile.txtStockEdit.Value		= tmpSales_Stock.StockEdit
			
			SUM StockLst_QTY FOR NOT DELETED() TO nSumStockLst_QTY
			ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value 	= nSumStockLst_QTY
			
			ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value 	= Get_PUtext( tmpSales_Stock.StockLst_PU )
			
			SUM StockLst_Total FOR NOT DELETED() TO nSumStockLst_Total
			ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value	= nSumStockLst_Total
			
			SUM StkPaid_Total FOR NOT DELETED() TO nSumStkPaid_Total
			ThisFormset.frmSales_Reconcile.txtStkPaid_Total.Value	= nSumStkPaid_Total
			
			
			PRIVATE nTotal, nQTY
			nTotal = PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value,'StockLst_Total',18,4)
			nQTY   = PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value,'StockLst_QTY',18,4)
			IF nQTY > 0
				ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= nTotal / nQTY
			ELSE
				ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= 0
			ENDIF
			SUM StockLst_PC FOR NOT DELETED() TO nSum
			ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value 	= nSum
			SUM StockLst_LBS FOR NOT DELETED() TO nSum
			ThisFormset.frmSales_Reconcile.txtStockLst_LBS.Value 	= nSum
			ThisFormset.frmSales_Reconcile.txtStockLst_Dim1.Value	= tmpSales_Stock.StockLst_Dim1
		ENDIF
		
		GOTO nRecNo
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showsumtotal
		*ThisFormSet.ShowSumTotal()
		*Use ShowSumInvoice When Invoice has changed!
		
		PRIVATE nStockLst_Total, nQuoted_Total, nInvoice_Total, nFreight, nReconDiff
		
		nQuoted_Total	= PrepareSQLnum(ThisFormSet.frmSales_Reconcile.txtQuoted_Total.Value,'Quoted_Total',18,4)
		*nInvoice_Total	= PrepareSQLnum(ThisFormSet.frmSales_Reconcile.txtInvoice_Total.Value,'Invoice_Total',18,4)
		*nInvoice_Item	= PrepareSQLnum(ThisFormSet.frmSales_Reconcile.txtInvoice_Item.Value,'Invoice_Item',18,4)
		nFreight		= PrepareSQLnum(ThisFormSet.frmSales_Reconcile.txtFreight.Value,'Freight',18,4)
		nReconDiff		= PrepareSQLnum(ThisFormSet.frmSales_Reconcile.txtReconDiff.Value,'ReconDiff',18,4)
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nInvoice
		*nInvoice = PrepareSQLnum(ThisFormSet.frmSalesOrder.txtInvoice.Value,'Invoice',-3)
		nInvoice = PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		**********************************
		*get nStockLst_SOTotal 
		PRIVATE nStockLst_SOTotal
		nStockLst_SOTotal = 0
		
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SUM(StockLst_Qty*StockLst_P) AS StockLst_SOTotal FROM dbo.Sales_Detail "
		cSQL = cSQL + " WHERE SalesNum = "+STR(VAL(cSOitem))
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		*cSQL = cSQL + " and Reconciled=1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nStockLst_SOTotal = tmpSumInvoice.StockLst_SOTotal
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**********************************
		*get 	nStockLst_ItemTotal
		PRIVATE nStockLst_ItemTotal
		*nStockLst_ItemTotal = PrepareSQLnum(ThisFormSet.frmSales_Reconcile.txtStockLst_Total.Value,'StockLst_ItemTotal',18,4)
		nStockLst_ItemTotal = 0
		
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SUM(StockLst_Qty*StockLst_P) AS StockLst_ItemTotal FROM dbo.Sales_Detail "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		*cSQL = cSQL + " and ISNULL(Reconciled,0)=1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nStockLst_ItemTotal = tmpSumInvoice.StockLst_ItemTotal
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**********************************
		*get  nInvoice_ItemTotal
		nInvoice_Total = 0
		PRIVATE nInvoice_ItemTotal
		nInvoice_ItemTotal = 0
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SUM(Paid) AS Invoice_ItemTotal FROM dbo.Sales_Invoice "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		cSQL = cSQL + " and ISNULL(Reconciled,0)=1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nInvoice_ItemTotal = tmpSumInvoice.Invoice_ItemTotal 
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**********************************
		*get  nInvoice_SOTotal
		PRIVATE nInvoice_SOTotal
		nInvoice_SOTotal = 0
		
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SUM(Paid) AS Invoice_SOTotal FROM dbo.Sales_Invoice "
		*cSQL = cSQL + " WHERE CAST(LEFT(SOitem,7) AS INT) = CAST(LEFT(dbo.f_ProperSOitem('"+cSOitem+"'),7) AS INT)"
		cSQL = cSQL + " WHERE SalesNum = "+STR(VAL(cSOitem))
		
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		cSQL = cSQL + " and ISNULL(Reconciled,0)=1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nInvoice_SOTotal = tmpSumInvoice.Invoice_SOTotal
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**************************************
		
		
		PRIVATE nItemProfitMargin, nSOProfitMargin, nCalcItemTotal, nReconDiff
		
		nCalcItemTotal = nInvoice_ItemTotal &&+ nFreight 
		nCalcSOTotal = nInvoice_SOTotal + nFreight 
		nItemProfitMargin = nCalcItemTotal - nStockLst_ItemTotal
		nSOProfitMargin = nCalcSOTotal  - nStockLst_SOTotal 
		
		IF nCalcItemTotal > 0 AND nInvoice_ItemTotal > 0 
			*nReconDiff = nCalcItemTotal - nInvoice_ItemTotal
			nReconDiff = nCalcSOTotal - nInvoice_SOTotal 
		ENDIF
		
		
		ThisFormSet.frmSales_Reconcile.txtReconDiff.ForeColor = RGB(0,0,0)
		ThisFormSet.frmSales_Reconcile.txtReconDiff.BackColor = RGB(255,255,255)
		IF nReconDiff > 0
			IF nCalcItemTotal> 0
				IF nCalcItemTotal/10 > nReconDiff
					*RecDiff is more than the 10%
					ThisFormSet.frmSales_Reconcile.txtReconDiff.ForeColor = RGB(255,0,0)
					ThisFormSet.frmSales_Reconcile.txtReconDiff.BackColor = RGB(255,255,128)
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.frmSales_Reconcile.txtReconDiff.Value = nReconDiff
		
		ThisFormSet.frmSales_Reconcile.txtItemProfitMargin.Value = nItemProfitMargin
		ThisFormSet.frmSales_Reconcile.txtSOProfitMargin.Value = nSOProfitMargin
		
		ThisFormSet.frmSales_Reconcile.txtCalcItemTotal.Value = PrepareSQLnum(nCalcItemTotal,'CalcItemTotal',10,2)
		ThisFormSet.frmSales_Reconcile.txtCalcSOTotal.Value = PrepareSQLnum(nCalcSOTotal,'CalcSOTotal',10,2)
	ENDPROC

	PROCEDURE show_invoice
		*ThisFormSet.Show_Invoice()
		
		IF USED('tmpInvoice')
			IF RECCOUNT('tmpInvoice') > 0
				ThisFormSet.frmInvoice.Visible = .T.
				
				ThisFormSet.frmInvoice.txtCustomerID.Value 	= tmpInvoice.CustomerID
				ThisFormSet.frmInvoice.txtCustomerName.Value= tmpInvoice.CustomerName
				ThisFormSet.frmInvoice.chkReconciled.Value	= PrepareSQLchk(tmpInvoice.Reconciled,'Reconciled')
				ThisFormSet.frmInvoice.txtInvoice.Value 	= tmpInvoice.Invoice
				ThisFormSet.frmInvoice.txtInvoiceDate.Value = tmpInvoice.InvoiceDate
				ThisFormSet.frmInvoice.txtCustomer_PO.Value = tmpInvoice.Customer_PO
				ThisFormSet.frmInvoice.txtShip_Via.Value 	= tmpInvoice.Ship_Via
				ThisFormSet.frmInvoice.txtSales_Rep.Value 	= tmpInvoice.Sales_Rep
				ThisFormSet.frmInvoice.txtAR_Amount.Value 	= tmpInvoice.AR_Amount
				IF PrepareSQLnum(tmpInvoice.Paid,'Paid',-5) = 0
					*ThisFormSet.frmInvoice.txtPaid.Value 	= ABS(tmpInvoice.AR_Amount)
					ThisFormSet.frmInvoice.txtPaid.Value 	= ABS(tmpInvoice.Amount)
					SELECT tmpInvoice
					nID = tmpInvoice.ID
					*UPDATE tmpInvoice SET Paid = ABS(tmpInvoice.AR_Amount) WHERE ID = nID
					UPDATE tmpInvoice SET Paid = ABS(tmpInvoice.Amount) WHERE ID = nID
					LOCATE FOR ID = nID
				ELSE
					ThisFormSet.frmInvoice.txtPaid.Value 	= tmpInvoice.Paid
				ENDIF
				ThisFormSet.frmInvoice.txtAmount.Value 		= (tmpInvoice.Amount)
				ThisFormSet.frmInvoice.txtDisc_Amount.Value = tmpInvoice.Disc_Amount
				ThisFormSet.frmInvoice.txtItem.Value 		= tmpInvoice.Item
				ThisFormSet.frmInvoice.txtItemTot.Value 	= tmpInvoice.ItemTot
				ThisFormSet.frmInvoice.txtGL_Account.Value 	= tmpInvoice.GL_Account
				ThisFormSet.frmInvoice.txtInvoice_Note.Value= tmpInvoice.Invoice_Note
				ThisFormSet.frmInvoice.txtSOitem.Value 		= tmpInvoice.SOitem
				ThisFormSet.frmInvoice.txtQuantity.Value 	= tmpInvoice.Quantity
				ThisFormSet.frmInvoice.txtUnitPrice.Value 	= tmpInvoice.UnitPrice
				ThisFormSet.frmInvoice.txtTrans_Period.Value = tmpInvoice.Trans_Period
				ThisFormSet.frmInvoice.txtTrans_No.Value 	= tmpInvoice.Trans_No
				ThisFormSet.frmInvoice.txtReturnAuth.Value 	= tmpInvoice.ReturnAuth
				ThisFormSet.frmInvoice.txtDescription.Value	= tmpInvoice.Description
				ThisFormSet.frmInvoice.txtShip_Date.Value 	= tmpInvoice.Ship_Date
				ThisFormSet.frmInvoice.txtDate_Due.Value 	= tmpInvoice.Date_Due
				
				IF PrepareSQLlogic(tmpInvoice.Reconciled,'Reconciled',.F.)
					ThisFormSet.frmInvoice.cmdSave.Caption = 'Update'
				ELSE
					ThisFormSet.frmInvoice.cmdSave.Caption = 'Save'
				ENDIF
				
				
				
				IF DELETED('tmpInvoice') 
					ThisFormset.frmInvoice.BackColor = RGB(255,128,128)
				ELSE
					ThisFormset.frmInvoice.BackColor = RGB(240,240,240)
				ENDIF
		
			ELSE
				ThisFormSet.frmInvoice.Visible = .F.
		
			ENDIF
		ELSE
			ThisFormSet.frmInvoice.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE show_invoice_frt
		PARAMETERS nInvoice 
		*ThisFormSet.Show_Invoice_Frt()
		
		IF VARTYPE(nInvoice) != 'N'
			nInvoice = 0
		ENDIF	
		
		IF USED('tmpInvoiceFrt')
			IF RECCOUNT('tmpInvoiceFrt') > 0
				IF nInvoice > 0
					PRIVATE nOldInvoice
					SELECT tmpInvoiceFrt
					nOldInvoice = tmpInvoiceFrt.Invoice
					LOCATE FOR Invoice=nInvoice
					IF NOT FOUND('tmpInvoiceFrt')
						LOCATE FOR Invoice=nOldInvoice
					ENDIF
				ENDIF
				
				ThisFormSet.frmInvoiceFrt.txtSales_Invoice_ID.Value = tmpInvoiceFrt.ID
		*		ThisFormSet.frmInvoiceFrt.txtCustomerID.Value 	= tmpInvoiceFrt.CustomerID
		*		ThisFormSet.frmInvoiceFrt.txtCustomerName.Value	= tmpInvoiceFrt.CustomerName
				ThisFormSet.frmInvoiceFrt.txtInvoice.Value 		= tmpInvoiceFrt.Invoice
				ThisFormSet.frmInvoiceFrt.txtInvoiceDate.Value 	= tmpInvoiceFrt.InvoiceDate
		*		ThisFormSet.frmInvoiceFrt.txtCustomer_PO.Value 	= tmpInvoiceFrt.Customer_PO
				ThisFormSet.frmInvoiceFrt.txtShip_Via.Value 	= tmpInvoiceFrt.Ship_Via
		*		ThisFormSet.frmInvoiceFrt.txtSales_Rep.Value 	= tmpInvoiceFrt.Sales_Rep
		*		ThisFormSet.frmInvoiceFrt.txtAR_Amount.Value 	= tmpInvoiceFrt.AR_Amount
				ThisFormSet.frmInvoiceFrt.txtAmount.Value 		= tmpInvoiceFrt.Amount
		*		ThisFormSet.frmInvoiceFrt.txtDisc_Amount.Value 	= tmpInvoiceFrt.Disc_Amount
		*		ThisFormSet.frmInvoiceFrt.txtItem.Value 		= tmpInvoiceFrt.Item
		*		ThisFormSet.frmInvoiceFrt.txtItemTot.Value 		= tmpInvoiceFrt.ItemTot
				ThisFormSet.frmInvoiceFrt.txtGL_Account.Value 	= tmpInvoiceFrt.GL_Account
				ThisFormSet.frmInvoiceFrt.txtInvoice_Note.Value	= tmpInvoiceFrt.Invoice_Note
				ThisFormSet.frmInvoiceFrt.txtSOitem.Value 		= tmpInvoiceFrt.SOitem
		*		ThisFormSet.frmInvoiceFrt.txtQuantity.Value 	= tmpInvoiceFrt.Quantity
		*		ThisFormSet.frmInvoiceFrt.txtUnitPrice.Value 	= tmpInvoiceFrt.UnitPrice
		*		ThisFormSet.frmInvoiceFrt.txtTrans_Period.Value = tmpInvoiceFrt.Trans_Period
		*		ThisFormSet.frmInvoiceFrt.txtTrans_No.Value 	= tmpInvoiceFrt.Trans_No
		*		ThisFormSet.frmInvoiceFrt.txtReturnAuth.Value 	= tmpInvoiceFrt.ReturnAuth
				ThisFormSet.frmInvoiceFrt.edtDescription.Value	= tmpInvoiceFrt.Description
		*		ThisFormSet.frmInvoiceFrt.txtShip_Date.Value 	= tmpInvoiceFrt.Ship_Date
		*		ThisFormSet.frmInvoiceFrt.txtDate_Due.Value 	= tmpInvoiceFrt.Date_Due
				
				*ThisFormSet.frmInvoiceFrt.chkReconciled.Value	= tmpInvoiceFrt.Reconciled
				ThisFormSet.frmInvoiceFrt.chkReconciled.Refresh
				
				PRIVATE nAmount
				nAmount = PrepareSQLnum(tmpInvoiceFrt.Amount,'Amount',-5)
				
				IF nAmount != 0
						*Should be a sumation of Freight still active
					ThisFormSet.frmSales_Reconcile.txtFreight.Value = ABS(nAmount)
				ENDIF
				ThisFormSet.frmInvoiceFrt.grdInvoiceFrt.Value = tmpInvoiceFrt.Invoice
				
				ThisFormSet.frmInvoiceFrt.Visible = .T.
				
				IF DELETED('tmpInvoiceFrt') 
					ThisFormset.frmInvoiceFrt.BackColor = RGB(255,128,128)
				ELSE
					ThisFormset.frmInvoiceFrt.BackColor = RGB(240,240,240)
				ENDIF
		
			ELSE
				ThisFormSet.frmInvoiceFrt.Visible = .F.
			ENDIF
		ELSE
			ThisFormSet.frmInvoiceFrt.Visible = .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE show_lstsales_detail_id
		*ThisFormSet.Show_lstSales_Detail_ID()
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		*ThisFormSet.Sales_Detail_ID = 0
		
		PRIVATE cSQL, nSQLEXEC
		
		*** Populate lst Sales Reconcile ID
		ThisFormset.frmSalesOrder.lstSales_Detail_ID.Clear
		
		IF USED('tmpSales_Detail_ID')
			USE IN tmpSales_Detail_ID
		ENDIF
		SELECT 0
		
		
		cSQL = "SELECT ID, Reconciled "
		cSQL = cSQL +" FROM dbo.Sales_Detail WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Detail_ID' )
		ENDIF
		
		ThisFormset.frmSalesOrder.cmdDeleteSales_Rec.Visible = .F.
		
		IF USED('tmpSales_Detail_ID')
			IF RECCOUNT('tmpSales_Detail_ID') > 0
				SELECT tmpSales_Detail_ID
				SCAN
					ThisFormset.frmSalesOrder.lstSales_Detail_ID.AddItem(STR(tmpSales_Detail_ID.ID))
				ENDSCAN
		
				ThisFormset.frmSalesOrder.lstSales_Detail_ID.Refresh
				
				SELECT tmpSales_Detail_ID
				LOCATE FOR ID = ThisFormSet.Sales_Detail_ID 
				IF NOT FOUND()
					GO TOP
				ENDIF
				
				ThisFormset.frmSalesOrder.lstSales_Detail_ID.Value = STR(tmpSales_Detail_ID.ID)
				ThisFormSet.Sales_Detail_ID 				= tmpSales_Detail_ID.ID
				ThisFormSet.frmSales_Reconcile.txtID_Sales_Detail.Value	= ThisFormSet.Sales_Detail_ID
				
				
				lReconciled = PrepareSQLchk(tmpSales_Detail_ID.Reconciled,'Reconciled')
				*ThisFormset.frmSalesOrder.chkReconciled.Value = IIF(lReconciled,1,0)
				
				IF RECCOUNT('tmpSales_Detail_ID') > 1
					ThisFormset.frmSalesOrder.cmdDeleteSales_Rec.Visible = .T.
				ENDIF
				
			ELSE
		
				*ThisFormset.frmSalesOrder.chkReconciled.Value = 0
		
			ENDIF		
		ENDIF
		
		
		IF USED('tmpSales_Detail_ID')	
			USE IN tmpSales_Detail_ID	
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE show_packingslip
		*ThisFormSet.Show_PackingSlip()
		
		
		*PSn.PS_Date, PSn.TotalWeight
