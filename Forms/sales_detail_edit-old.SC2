	PROCEDURE frmSalesOrder.lblInvoice.Click
		IF USED('tmpInvoiceNo')
			USE IN tmpInvoiceNo
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT Invoice FROM dbo.Sales_Invoice "
		cSQL = cSQL + " WHERE ISNULL(Reconciled,0) = 0 "
		cSQL = cSQL + " ORDER BY Invoice DESC "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceNo')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceNo' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpInvoiceNo' )
		ENDIF
		
		ThisFormSet.frmUnRecInvoice.Visible = .F.
		
		ThisFormset.frmUnRecInvoice.lstInvoiceUNR.Clear
		
		IF USED('tmpInvoiceNo')
			IF RECCOUNT('tmpInvoiceNo') > 0
				SELECT tmpInvoiceNo
				SCAN
					ThisFormset.frmUnRecInvoice.lstInvoiceUNR.AddItem(STR(tmpInvoiceNo.Invoice))
				ENDSCAN
		
				ThisFormset.frmUnRecInvoice.lstInvoiceUNR.Refresh
				
				ThisFormSet.frmUnRecInvoice.AlwaysOnTop = .T.
				ThisFormSet.frmUnRecInvoice.Visible = .T.
				ThisFormSet.frmUnRecInvoice.AlwaysOnTop = .F.
				
			ENDIF
			USE IN tmpInvoiceNo	
		ENDIF
	ENDPROC

	PROCEDURE frmSalesOrder.lblSalesOrder.Click
		IF USED('tmpSOitemUnRec')
			USE IN tmpSOitemUnRec
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT Distinct Sales_Detail.SOitem FROM dbo.Sales_Detail"
		*cSQL = cSQL +" INNER JOIN dbo.Sales_Invoice ON Sales_Detail.SOitem = Invoice.SOitem"
		cSQL = cSQL +" WHERE Sales_Detail.Reconciled = 0 "
		cSQL = cSQL +" ORDER BY SOitem DESC "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitemUnRec')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitemUnRec' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitemUnRec' )
		ENDIF
		
		ThisFormSet.frmUnRecSOitems.Visible = .F.
		
		ThisFormset.frmUnRecSOitems.lstSOitemsUNR.Clear
		
		IF USED('tmpSOitemUnRec')
			IF RECCOUNT('tmpSOitemUnRec') > 0
				SELECT tmpSOitemUnRec
				SCAN
					ThisFormset.frmUnRecSOitems.lstSOitemsUNR.AddItem(tmpSOitemUnRec.SOitem)
				ENDSCAN
		
				ThisFormset.frmUnRecSOitems.lstSOitemsUNR.Refresh
				
				ThisFormSet.frmUnRecSOitems.AlwaysOnTop = .T.
				ThisFormSet.frmUnRecSOitems.Visible = .T.
				ThisFormSet.frmUnRecSOitems.AlwaysOnTop = .F.
				
			ENDIF
			USE IN tmpSOitemUnRec	
		ENDIF
	ENDPROC

