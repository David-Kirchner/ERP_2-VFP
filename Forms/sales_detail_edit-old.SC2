			cSQL = cSQL +",Quoted_Total="+STR(nQuoted_Total,18,4)
			cSQL = cSQL +",Quoted_PU="+STR(nQuoted_PU)
			cSQL = cSQL +",Quoted_PC="+STR(nQuoted_PC,18,4)
			cSQL = cSQL +",Quoted_Dim1="+STR(nQuoted_Dim1,18,4)
			cSQL = cSQL +",Quoted_LBS="+STR(nQuoted_LBS,7,1)
		
			cSQL = cSQL +",StockLst_QTY="+STR(nStockLst_QTY,18,4)
			cSQL = cSQL +",StockLst_P="+STR(nStockLst_P,18,4)
			cSQL = cSQL +",StkPaid_P="+STR(nStkPaid_P,18,4)
			cSQL = cSQL +",StockLst_Total="+STR(nStockLst_Total,18,4)
			cSQL = cSQL +",StkPaid_Total="+STR(nStkPaid_Total,18,4)
			cSQL = cSQL +",StockLst_PU="+STR(nStockLst_PU)
			cSQL = cSQL +",StockLst_PC="+STR(nStockLst_PC)
			cSQL = cSQL +",StockLst_Dim1="+STR(nStockLst_Dim1,18,4)
			cSQL = cSQL +",StockLst_LBS="+STR(nStockLst_LBS,7,1)
		
			cSQL = cSQL +",Alloy='"+cAlloy+"'"
			cSQL = cSQL +",Form='"+cForm+"'"
			cSQL = cSQL +",CC='"+cCC+"'"
			cSQL = cSQL +",CL='"+cCL+"'"
			
			cSQL = cSQL +",StockEdit='"+IIF(dtStockEdit  =CTOD("  /  /  "),'',TTOC(dtStockEdit))+"'"
			cSQL = cSQL +",Shipped='"+IIF(dShipped    =CTOD("  /  /  "),'',DTOC(dShipped))+"'"
			cSQL = cSQL +",InvoiceDate='"+IIF(dInvoiceDate=CTOD("  /  /  "),'',DTOC(dInvoiceDate))+"'"
			
			cSQL = cSQL +",Invoice_QTY="+STR(nInvoice_QTY,18,4)
			cSQL = cSQL +",Invoice_P="+STR(nInvoice_P,18,4)
			cSQL = cSQL +",Invoice_Total="+STR(nInvoice_Total,18,4)
		
			cSQL = cSQL +",ProfitMargin="+STR(nProfitMargin,18,4)
			cSQL = cSQL +",Disc_Allowed="+STR(nDisc_Allowed,18,4)
			cSQL = cSQL +",ReconDiff="+STR(nReconDiff,18,4)
			cSQL = cSQL +",Freight="+STR(nFreight,18,4)
			cSQL = cSQL +",Reconciled="+IIF(lReconciled,"1","0")
			cSQL = cSQL +" WHERE ID="+STR(nID_Sales_Detail)
			
		ENDIF
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		ELSE
			WAIT WINDOW "Saved" NOWAIT
			
			IF nID_Sales_Detail = 0
				*Get ID
				IF USED('tmpSales_DetailID')
					USE IN tmpSales_DetailID
				ENDIF
				
				SELECT 0
				cSQL = "SELECT ID FROM dbo.Sales_Detail WHERE "
				cSQL = cSQL +" SOitem='"+cSOitem+"'"
