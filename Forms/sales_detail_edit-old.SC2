				ENDIF
			ELSE
				ThisFormset.frmPackingSlip.Visible = .F.
				ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
			ENDIF
		ELSE
			ThisFormset.frmPackingSlip.Visible = .F.
			ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
		ENDIF
	ENDPROC

	PROCEDURE show_quote
		*ThisFormSet.Show_Quote()
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpQuote')
			USE IN tmpQuote
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3,Weight "
		cSQL = cSQL +",P_LB,P_PC,P_FT,Cuts,LotP,OtherFLD,OtherP "
		cSQL = cSQL +",RandLen,Metric,Services "
		cSQL = cSQL +" FROM dbo.AllQuotes WHERE  SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuote')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpQuote' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpQuote' )
		ENDIF
		
		
		IF USED('tmpQuote')
			IF RECCOUNT('tmpQuote') > 0
				ThisFormset.frmQuote.Visible = .T.
				ThisFormset.frmQuote.Alloy1.Value		= tmpQuote.Alloy
				ThisFormset.frmQuote.Form1.Value 		= tmpQuote.Form
				ThisFormset.frmQuote.CC1.Value			= tmpQuote.CC
				ThisFormset.frmQuote.CL1.Value			= tmpQuote.CL
		*		ThisFormset.frmQuote.chkReconciled.Value= tmpQuote.Reconciled
				ThisFormset.frmQuote.Pieces1.Value		= tmpQuote.Pieces
				ThisFormset.frmQuote.Thck1.Value		= tmpQuote.Thck
				ThisFormset.frmQuote.Sz21.Value		= tmpQuote.Sz2
				ThisFormset.frmQuote.Sz31.Value		= tmpQuote.Sz3
				ThisFormset.frmQuote.Weight1.Value 	= tmpQuote.Weight
				
				ThisFormset.frmQuote.P_LB1.Value 	= tmpQuote.P_LB
				ThisFormset.frmQuote.P_PC1.Value 	= tmpQuote.P_PC
				ThisFormset.frmQuote.P_FT1.Value 	= tmpQuote.P_FT
				ThisFormset.frmQuote.Cuts1.Value 	= tmpQuote.Cuts
				ThisFormset.frmQuote.LotP1.Value 	= tmpQuote.LotP
				ThisFormset.frmQuote.OtherFLD1.Value= tmpQuote.OtherFLD
				ThisFormset.frmQuote.OtherP1.Value 	= tmpQuote.OtherP
				
				ThisFormset.frmQuote.chkRL.Value 	= tmpQuote.RandLen
				ThisFormset.frmQuote.chkMetric.Value 	= tmpQuote.Metric
				ThisFormset.frmQuote.chkServices.Value 	= tmpQuote.Services
				
				ThisFormSet.RefreshForms()
				
				IF EMPTY(ThisFormSet.frmSales_Reconcile.txtAlloy.Value)
					ThisFormSet.frmSales_Reconcile.txtAlloy.Value = tmpQuote.Alloy
				ENDIF
				IF EMPTY(ThisFormSet.frmSales_Reconcile.txtForm.Value)
					ThisFormSet.frmSales_Reconcile.txtForm.Value = tmpQuote.Form
				ENDIF
				IF EMPTY(ThisFormSet.frmSales_Reconcile.txtCC.Value)
					ThisFormSet.frmSales_Reconcile.txtCC.Value = PrepareSQLtxt(tmpQuote.CC,'CC',1)
				ENDIF
				IF EMPTY(ThisFormSet.frmSales_Reconcile.txtCL.Value)
					ThisFormSet.frmSales_Reconcile.txtCL.Value = PrepareSQLtxt(tmpQuote.CL,'CL',1)
				ENDIF
				
				ThisFormSet.frmSalesOrder.cmdHideQuoted.Visible 	= .T.
			ELSE
				ThisFormset.frmQuote.Visible = .F.
				ThisFormSet.frmSalesOrder.cmdHideQuoted.Visible 	= .F.
			ENDIF
		ELSE
			ThisFormset.frmQuote.Visible = .F.
			ThisFormSet.frmSalesOrder.cmdHideQuoted.Visible 	= .F.
		ENDIF
		
		IF ThisFormset.frmQuote.Visible
			IF EMPTY( ThisFormSet.frmSales_Reconcile.txtAlloy.Value )
				WAIT WINDOW "Copy Quote data to Sales_Detail form." NOWAIT
				ThisFormSet.CopyQuote2Detail()
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE show_sales_detail
		*ThisFormSet.Show_Sales_Detail()
		
		PRIVATE lCreate_Sales_Reconcile
		lCreate_Sales_Reconcile =.T.
		
		IF ThisFormSet.Sales_Detail_ID > 0
			lCreate_Sales_Reconcile = .F.
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		PRIVATE cSQL, nSQLEXEC
		
		IF lCreate_Sales_Reconcile
			cSQL = "SELECT * FROM dbo.Sales_Detail "
			IF EMPTY( cSOitem )
				cSQL = cSQL +" WHERE 0>0 "
			ELSE
				cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL +" AND ISNULL(Invoice,0)> 0 "
			ENDIF
		ELSE
			cSQL = "SELECT * "
			cSQL = cSQL +" FROM dbo.Sales_Detail WHERE ID = "+STR(ThisFormSet.Sales_Detail_ID)
		ENDIF
		
		IF USED('tmpSales_Detail')
			USE IN tmpSales_Detail
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Detail' )
		ENDIF
		
		IF USED('tmpSales_Detail')
			IF RECCOUNT('tmpSales_Detail') > 0
		
				ThisFormset.frmSales_Reconcile.Visible = .T.
				*ThisFormset.frmSales_Reconcile.txtID_Sales_Detail.Value 		= tmpSales_Detail.ID
				ThisFormSet.frmSales_Reconcile.txtID_Sales_Detail.Value			= ThisFormSet.Sales_Detail_ID
				ThisFormset.frmSales_Reconcile.txtSOitem.Value 		= ThisFormSet.SOitem
				ThisFormset.frmSales_Reconcile.txtStockEdit.Value 	= tmpSales_Detail.StockEdit
				ThisFormset.frmSales_Reconcile.txtPS_Date.Value 	= tmpSales_Detail.Shipped
				ThisFormset.frmSales_Reconcile.txtInvoiceDate.Value	= tmpSales_Detail.InvoiceDate
				
				ThisFormset.frmSales_Reconcile.txtAlloy.Value	= tmpSales_Detail.Alloy
				ThisFormset.frmSales_Reconcile.txtForm.Value	= tmpSales_Detail.Form
				ThisFormset.frmSales_Reconcile.txtCC.Value		= tmpSales_Detail.CC
				ThisFormset.frmSales_Reconcile.txtCL.Value		= tmpSales_Detail.CL
				
				ThisFormset.frmSales_Reconcile.txtQuoted_QTY.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_QTY,'Quoted_QTY',-5)
				ThisFormset.frmSales_Reconcile.txtQuoted_PU.Value 	= Get_PUtext( tmpSales_Detail.Quoted_PU )
				ThisFormset.frmSales_Reconcile.txtQuoted_P.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_P,'Quoted_P',-5)
				ThisFormset.frmSales_Reconcile.txtQuoted_Total.Value= PrepareSQLnum(tmpSales_Detail.Quoted_Total,'Quoted_Total',-5)
				ThisFormset.frmSales_Reconcile.txtQuoted_PC.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_PC,'Quoted_PC',-3)
				ThisFormset.frmSales_Reconcile.txtQuoted_Dim1.Value	= PrepareSQLnum(tmpSales_Detail.Quoted_Dim1,'Quoted_Dim1',10,4)
				ThisFormset.frmSales_Reconcile.txtQuoted_LBS.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_LBS,'Quoted_LBS',7,2)
				
				ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Detail.StockLst_QTY,'StockLst_QTY',-5)
				ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value 	= Get_PUtext( tmpSales_Detail.StockLst_PU )
				ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= PrepareSQLnum(tmpSales_Detail.StockLst_P,'StockLst_P',-5)
				ThisFormset.frmSales_Reconcile.txtStkPaid_P.Value 		= PrepareSQLnum(tmpSales_Detail.StkPaid_P,'StkPaid_P',-5)
