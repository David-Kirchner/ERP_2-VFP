	PROCEDURE frmInvoiceFrt.lblAmount.Click
		PRIVATE nFreight, nSalesNum, nItems
		nFreight = PrepareSQLnum(ThisForm.txtAmount.Value,'Freight',-5)
		nFreight = -nFreight 
		
		nSalesNum = PrepareSQLnum(ThisFormSet.frmSalesOrder.txtSalesOrder.Value,'SalesOrder',-3)
		nItems = Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle )
		
		*nItem_Total = PrepareSQLnum(ThisFormSet.frmInvoice.txtItemTot.Value,'ItemTot',-3)
		
		IF nFreight > 0
			IF nItems > 0
													*Should be a sumation of Freight still active.	
				ThisFormSet.frmSales_Reconcile.txtFreight.Value = nFreight &&nFreight / nItems 
			ENDIF
			ThisFormSet.ShowSumTotal()
		ENDIF
	ENDPROC

