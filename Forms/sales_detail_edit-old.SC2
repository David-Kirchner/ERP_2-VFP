			ThisFormSet.frmSalesOrder.cmdHideStock.Visible 	= .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE unreconcile
		*ThisFormSet.UnReconcile()
		
		PRIVATE lReconciled
		lReconciled = .F.
		
		PRIVATE nSales_Detail_ID,cSOitem,nInvoice,lPassed 
		*nSales_Detail_ID= ThisFormset.frmSales_Reconcile.txtID_Sales_Detail.Value 		
		*nSales_Detail_ID= ThisFormset.frmInvoice.txtID ??
		cSOitem			= ThisFormset.frmInvoice.txtSOitem.Value
		nInvoice		= ThisFormset.frmInvoice.txtInvoice.Value
		lPassed 		= .T.
		
		PRIVATE cSOitem00
		cSOitem00 = Proper_SO_Item( STR(VAL(cSOitem))+"-00" )
		
		PRIVATE cQSL, nSQLEXEC 
		cSQL = "UPDATE dbo.Sales_Detail SET "
		cSQL = cSQL +" Reconciled=0"
		*cSQL = cSQL +" WHERE ID="+STR(nSales_Detail_ID)
		cSQL = cSQL +" WHERE InvoiceID="+STR(nInvoice)
		cSQL = cSQL + " AND ( SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " OR SOitem = dbo.f_ProperSOitem('"+cSOitem00+"')"
		cSQL = cSQL + " )"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			lPassed = .F.
		ELSE	
			IF lPassed 
				lPassed = ThisFormSet.Save_PackingSlip_Reconcile(lReconciled, nSales_Detail_ID)
			ENDIF
			*nSales_Detail_ID
			*ID_PackingSlip= "+ALLTRIM(STR( nID_PackingSlip))
		
			IF lPassed 
				lPassed = ThisFormSet.Save_Sales_Stock_Reconcile( lReconciled, nSales_Detail_ID )	
			ENDIF
			*nSales_Detail_ID
			*cPOitem
			*dbo.Sales_Stock nID
				
			IF lPassed 
				lPassed = ThisFormSet.Save_Invoice_Frt_Reconcile(lReconciled, nSales_Detail_ID)
			ENDIF
			*nSales_Detail_ID
			*dbo.Sales_Invoice nID
		ENDIF
		
		IF lPassed 
			*ThisFormSet.frmSalesOrder.chkReconciled.Value = 0
			ThisFormSet.frmInvoice.chkReconciled.Value = 0
			ThisFormSet.frmInvoice.chkReconciled.Refresh
			*ThisFormSet.frmInvoiceFrt.Refresh 
			ThisFormSet.frmSales_stock.chkReconciled.Value = 0
			ThisFormSet.frmSales_stock.chkReconciled.Refresh
			ThisFormSet.frmPackingSlip.chkReconciled.Value = 0
			ThisFormSet.frmPackingSlip.chkReconciled.Refresh
			
			MESSAGEBOX("SOitem-Invoice has been UN Reconciled.",0+64,"Saved.")
		ENDIF
	ENDPROC

	PROCEDURE frmInvoice.chkReconciled.Click
		PRIVATE lReconciled,cSOitem
		lReconciled = PrepareSQLlogic(This.Value,'Reconciled')
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		
		IF lReconciled
			IF MESSAGEBOX("Are you sure you want to UN Reconcile this SO-item:"+cSOitem+" ?",4+32,"UnReconciled?") != 6
				RETURN
			ELSE
				ThisFormSet.UnReconcile()
			ENDIF
		ELSE
			MESSAGEBOX("Please use the 'Save' button.",0,"No Reconcile")
		ENDIF
	ENDPROC

	PROCEDURE frmInvoice.cmdRefresh.Click
		ThisFormSet.Show_Invoice()
		ThisFormSet.ShowSumInvoice()
		
	ENDPROC

	PROCEDURE frmInvoice.cmdSave.Click
		
		PRIVATE nID, lReconciled
		nID = tmpInvoice.ID
		lReconciled = .T.
		
		SELECT tmpInvoice
		UPDATE tmpInvoice SET Reconciled = lReconciled WHERE ID = nID
		LOCATE FOR ID=nID
		
		ThisFormSet.SaveInvoiceAmount()
		
		
		
	ENDPROC

	PROCEDURE frmInvoice.cmdSOiDelete.Click
		PRIVATE cSOitem, nMess
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		
		nMess = MESSAGEBOX("Are you sure you want to Delete this SOitem:"+ALLTRIM(cSOitem)+"?"+CHR(13)+"This delete will be recorded.",4+32,"Delete?")
		IF nMess = 6
		
			cSQL = "DELETE FROM dbo.Sales_Invoice WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
			ELSE
				TrackMess("SOitem:"+ALLTRIM(cSOitem)+" was be DELETED FROM dbo.Sales_Invoice")
				TrackError("Deleted in Sales_Invoice.","SOitem:"+ALLTRIM(cSOitem)+" was DELETED FROM dbo.Sales_Invoice","Sales_DetailEdit:frmInvoice.cmdSOiDelete",LINENO())
				MESSAGEBOX("DELETED."+CHR(13)+"Next use import to get correct data from Sage.",0,"DELETED.")
			ENDIF
		
			ThisFormSet.FindSalesOrder()
			*ThisFormSet.Init_Invoice()
			*ThisFormSet.Show_Invoice()
			
			
		ENDIF
		
		
		
	ENDPROC

