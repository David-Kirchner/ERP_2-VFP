	PROCEDURE saveinvoiceamount
		*ThisFormSet.SaveInvoiceAmount()
		
		PRIVATE lUpdateSD
		lUpdateSD = .F.
		IF ThisFormSet.frmInvoice.cmdSave.Caption = "Update"
			lUpdateSD = .T.
		ENDIF
		
		PRIVATE nID_Sales_Detail,cSOitem,nInvoice
		nID_Sales_Detail= ThisFormset.frmSales_Reconcile.txtID_Sales_Detail.Value 		
		cSOitem		= ThisFormset.frmSales_Reconcile.txtSOitem.Value 	
		nInvoice	= PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		
		PRIVATE nSale_QTY, nSale_PC, cDescript, nSale_LBS
		nSale_QTY	= ThisFormset.frmSales_Reconcile.txtSale_QTY.Value 	
		nSale_PC	= ThisFormset.frmSales_Reconcile.txtSale_PC.Value 	
		cDescript	= PrepareSQLtxt(ThisFormset.frmSales_Reconcile.txtDescript.Value,'Descript',254)
		nSale_LBS	= ThisFormset.frmSales_Reconcile.txtWeight.Value 	
		
		PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU, nQuoted_PC, nQuoted_Dim1, nQuoted_LBS
		nQuoted_QTY		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtQuoted_QTY.Value,'Quoted_QTY',-5)
		nQuoted_P		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtQuoted_P.Value,'Quoted_P',-5)
		nQuoted_Total	= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtQuoted_Total.Value,'Quoted_Total',-5)
		nQuoted_PU		= Get_PUfromText(ThisFormset.frmSales_Reconcile.txtQuoted_PU.Value)
		nQuoted_PC		= ThisFormset.frmSales_Reconcile.txtQuoted_PC.Value
		nQuoted_Dim1	= ThisFormset.frmSales_Reconcile.txtQuoted_Dim1.Value
		nQuoted_LBS		= ThisFormset.frmSales_Reconcile.txtQuoted_LBS.Value
		PRIVATE nStockLst_QTY, nStockLst_P, nStkPaid_P, nStockLst_Total, nStkPaid_total, nStockLst_PU
		PRIVATE nStockLst_PC, nStockLst_Dim1, nStockLst_LBS
		nStockLst_QTY	= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value,'StockLst_QTY',-5)
		nStockLst_P		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtStockLst_P.Value,'StockLst_P',-5)
		nStkPaid_P		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtStkPaid_P.Value,'StkPaid_P',-5)
		nStockLst_Total	= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value,'StockLst_Total',-5)
		nStkPaid_Total	= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtStkPaid_Total.Value,'StkPaid_Total',-5)
		nStockLst_PU	= Get_PUfromText(ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value)
		nStockLst_PC	= ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value
		nStockLst_Dim1	= ThisFormset.frmSales_Reconcile.txtStockLst_Dim1.Value
		nStockLst_LBS	= ThisFormset.frmSales_Reconcile.txtStockLst_LBS.Value
		PRIVATE cAlloy, cForm, cCC, cCL
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmSales_Reconcile.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmSales_Reconcile.txtForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmSales_Reconcile.txtCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmSales_Reconcile.txtCL.Value,'CL',1)
		PRIVATE dtStockEdit, dShipped, dInvoiceDate, nInvoice_QTY, nInvoice_P, nInvoice_Total
		dtStockEdit	= PrepareSQLdate(ThisFormset.frmSales_Reconcile.txtStockEdit.Value,'StockEdit')
		dShipped	= PrepareSQLdate(ThisFormset.frmSales_Reconcile.txtPS_Date.Value,'ShipDate')
		dInvoiceDate= PrepareSQLdate(ThisFormset.frmSales_Reconcile.txtInvoiceDate.Value,'InvoiceDate')
		nInvoice_QTY= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtInvoice_QTY.Value,'Invoice_QTY',-5)
		nInvoice_P	= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtInvoice_P.Value,'Invoice_P',-5)
		nInvoice_Total=PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtInvoice_Total.Value,'Invoice_Total',-5)
		PRIVATE nFreight, nProfitMargin, nDisc_Allowed, nReconDiff, lReconciled
		nFreight		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtFreight.Value,'Freight',-5)
		nProfitMargin	= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtSOProfitMargin.Value,'ProfitMargin',-5)
		nDisc_Allowed	= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtDisc_Allowed.Value,'Disc_Allowed',-5)
		nReconDiff		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtReconDiff.Value,'ReconDiff',-5)
		
		*****************************************
		*Test Data
		IF nID_Sales_Detail = 0  &&routine will insert!
		*	MESSAGEBOX("Lost Sales Detail ID Number!"+CHR(13)+"On form 'Sales Order item Detail'."+CHR(13)+"Cannot Save.",0+16,"Data Error.")
		*	RETURN .F.
		ENDIF
		
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')
			MESSAGEBOX("Lost Sales Order item!"+CHR(13)+"On form 'Sales Invoice'."+CHR(13)+"Cannot Save.",0+16,"Data Error.")
			RETURN .F.
		ENDIF
		
		IF nInvoice = 0
			MESSAGEBOX("Lost Sales Invoice Number!"+CHR(13)+"On form 'Sales Invoice'."+CHR(13)+"Cannot Save.",0+16,"Data Error.")
			RETURN .F.
		ENDIF
		
		
		*****************************************
		PRIVATE lPassed, lReconciled
		lPassed = .F.
		lReconciled = .F.
		
		IF lUpdateSD AND nID_Sales_Detail > 0
			*UPDATE
			
			cSQL = "UPDATE dbo.Sales_Detail SET "
			cSQL = cSQL +" Invoice_Total="+STR(nInvoice_Total,18,4)
			cSQL = cSQL +",ProfitMargin="+STR(nProfitMargin,18,4)
			cSQL = cSQL +",ReconDiff="+STR(nReconDiff,18,4)
			cSQL = cSQL +",Freight="+STR(nFreight,18,4)
			cSQL = cSQL +",Invoice ="+STR(nInvoice)
			cSQL = cSQL +" WHERE ID="+STR(nID_Sales_Detail)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				lPassed = .T.
			ENDIF
			
			lReconciled	= PrepareSQLchk(ThisFormset.frmInvoice.chkReconciled.Value,'Reconciled')
			
			IF lPassed 
				lPassed = ThisFormSet.Save_Invoice_Reconcile(.NULL.,nID_Sales_Detail)
			ENDIF
			IF lPassed 
				lPassed = ThisFormSet.Save_Invoice_Frt_Reconcile(lReconciled,nID_Sales_Detail)
			ENDIF
			IF lPassed 
				lPassed = ThisFormSet.Save_PackingSlip_Reconcile(lReconciled,nID_Sales_Detail)
			ENDIF
			IF lPassed 
				lPassed = ThisFormSet.Save_Sales_Stock_Reconcile(lReconciled,nID_Sales_Detail)
			ENDIF
			IF lPassed 
				IF lReconciled
					 ThisFormSet.Clear_StockLst_Process(cSOitem)
				ENDIF
			ENDIF
			
			IF lPassed 
				*ThisFormSet.frmSalesOrder.chkReconciled.Value = IIF(lReconciled,1,0)
				ThisFormSet.frmSales_Reconcile.Visible = .F.
				ThisFormSet.frmInvoice.Visible = .F.
				ThisFormSet.frmInvoiceFrt.Visible = .F.
				ThisFormSet.frmSales_stock.Visible = .F.
				ThisFormSet.frmPackingSlip.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
					
				MESSAGEBOX("SOitem-Invoice has been updated.",0+64,"Saved.")
			ENDIF
		
				
			***********		
			RETURN .T.
			***********
			
			
		ENDIF
		
		*IF NOT lReconciled
		*	IF MESSAGEBOX("Do you want the SOitem: "+ALLTRIM(cSOitem)+" to be Reconciled? (Y)",4+32,"Reconcile?") = 6
				lReconciled = .T.
		*	ELSE
		*		RETURN .F.
		*	ENDIF
		*ENDIF
		
		IF nID_Sales_Detail = 0
			**while Testing, TrackMess
			PRIVATE Pnerror, Pmess1, Pcprogram, Pnlineno, pMesM
			*     (    INT, C(254),    C(254),      INT,      MEMO)
			Pnerror = 0
			Pmess1 = "Test Info"
			Pcprogram = "Sales_Detail_Edit.SaveInvoiceAmount"
			Pnlineno = 0
			pMesM= "This data is for test, see if anything looks odd."+CHR(13)
		
			pMesM= pMesM+ CHR(13)
			
			
			pMesM = "INSERT INTO dbo.Sales_Detail ("+CHR(13)
			pMesM = pMesM +" SOitem='"+cSOitem+"'"+CHR(13)
			pMesM = pMesM +",Invoice="+STR(nInvoice)+CHR(13)
			pMesM = pMesM +",Sale_QTY="+STR(nSale_QTY,18,4)+CHR(13)
			pMesM = pMesM +",Sale_PC="+STR(nSale_PC,18,4)+CHR(13)
			pMesM = pMesM +",Descript="+cDescript+"'"+CHR(13)
			pMesM = pMesM +",Sale_LBS="+STR(nSale_LBS,7,1)+CHR(13)
			
			pMesM = pMesM +",Quoted_QTY="+STR(nQuoted_QTY,18,4)+CHR(13)
			pMesM = pMesM +",Quoted_P="+STR(nQuoted_P,18,4)+CHR(13)
			pMesM = pMesM +",Quoted_Total="+STR(nQuoted_Total,18,4)+CHR(13)
			pMesM = pMesM +",Quoted_PU="+STR(nQuoted_PU)+CHR(13)
