	PROCEDURE clear_stocklst_process
		PARAMETERS pSOitem
		*ThisFormset.Clear_StockLst_Process()
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		
		IF cSOitem = Proper_SO_item('')
			RETURN .F.
		ENDIF
		
		RETURN Cancel_Detail_Process_SOitem(cSOitem,ThisFormSet.nConnHandle)
		
		*!*	PRIVATE cSQL, nSQLEXEC
		
		*!*	cSQL = "DELETE FROM dbo.StockLst_Process "
		*!*	cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		*!*	nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		*!*	ENDIF
		
		*!*	*********************
		
		*!*	cSQL = "DELETE FROM dbo.BrokerLst_Process "
		*!*	cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		*!*	nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		*!*	ENDIF
		
		*!*	 ********************
	ENDPROC

	PROCEDURE copyquote2detail
		*ThisFormSet.CopyQuote2Detail()
		
		PRIVATE cAlloy, cForm, cCC, cCL
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmQuote.Alloy1.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmQuote.Form1.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmQuote.CC1.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmQuote.CC1.Value,'CL',1)
		PRIVATE nQuoted_QTY, nQuoted_PU, nQuoted_P,nQuoted_Total, nQuoted_PC, nQuoted_Dim1, nQuoted_LBS
		nQuoted_QTY		= Get_QTYinSales(ThisFormSet.SOItem, ThisFormSet.nConnHandle)
		nQuoted_PU		= GetPUfromForm(cForm,ThisFormSet.nConnHandle)
		nQuoted_Total	= Get_ItemSaleinSales(ThisFormSet.SOItem, ThisFormSet.nConnHandle)
		nQuoted_PC		= ThisFormSet.frmQuote.Pieces1.Value
		nQuoted_Dim1	= ThisFormSet.frmQuote.Thck1.Value
		nQuoted_LBS		= Get_LBSinSales(ThisFormSet.SOItem, ThisFormSet.nConnHandle)
		
		nQuoted_P		= 0
		IF nQuoted_Total > 0 AND nQuoted_QTY > 0
			nQuoted_P = nQuoted_Total / nQuoted_QTY 
		ENDIF
		
		ThisFormset.frmSales_Reconcile.txtAlloy.Value	= cAlloy
		ThisFormset.frmSales_Reconcile.txtForm.Value	= cForm
		ThisFormset.frmSales_Reconcile.txtCC.Value		= cCC
		ThisFormset.frmSales_Reconcile.txtCL.Value		= cCL
		
		ThisFormset.frmSales_Reconcile.txtQuoted_QTY.Value 	= nQuoted_QTY
		ThisFormset.frmSales_Reconcile.txtQuoted_PU.Value 	= Get_PUtext( nQuoted_PU )
		ThisFormset.frmSales_Reconcile.txtQuoted_P.Value 	= nQuoted_P
		ThisFormset.frmSales_Reconcile.txtQuoted_Total.Value= nQuoted_Total
		ThisFormset.frmSales_Reconcile.txtQuoted_PC.Value 	= nQuoted_PC
		ThisFormset.frmSales_Reconcile.txtQuoted_Dim1.Value	= nQuoted_Dim1
		ThisFormset.frmSales_Reconcile.txtQuoted_LBS.Value 	= nQuoted_LBS
		
	ENDPROC

	PROCEDURE Destroy
		IF USED('tmpInvoiceNo')
			USE IN tmpInvoiceNo
		ENDIF
		IF USED('tmpInvoiceSO')
			USE IN 'tmpInvoiceSO'
		ENDIF
				
		IF USED('tmpGreenSheet')
			USE IN tmpGreenSheet
		ENDIF
		IF USED('tmpSales_Detail')
			USE IN tmpSales_Detail
		ENDIF
		IF USED('tmpSales_Detail_ID')
			USE IN tmpSales_Detail_ID
		ENDIF
		IF USED('tmpSOitem_Found')
			USE IN 'tmpSOitem_Found'
		ENDIF
				
		IF USED('tmpSales_Detail_ID2')
			USE IN tmpSales_Detail_ID2
		ENDIF
		IF USED('tmpSO')
			USE IN tmpSO
		ENDIF
		IF USED('tmpPackingSlip')
			USE IN tmpPackingSlip
		ENDIF
		IF USED('tmpSales_Stock')
			USE IN tmpSales_Stock
		ENDIF
		IF USED('tmpInvoiceFrt')
			USE IN tmpInvoiceFrt
		ENDIF
		IF USED('tmpSOitemUnRec')
			USE IN tmpSOitemUnRec
		ENDIF
		IF USED('tmpInvoiceSOitem')
			USE IN tmpInvoiceSOitem
		ENDIF
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		IF USED('tmpMessTable')
			USE IN tmpMessTable
		ENDIF
		
		**
		IF VARTYPE(HPA_Menu) = "O"  &&
			HPA_Menu.WindowState = 0
		ENDIF
		**
		
		
	ENDPROC

	PROCEDURE findinvoice
		*ThisFormSet.FindInvoice()
		
		PRIVATE nInvoice
		nInvoice = ThisFormSet.nInvoice
		
		IF USED('tmpInvoiceSOitem')
			USE IN tmpInvoiceSOitem
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT Invoice, SOitem FROM dbo.Sales_Invoice WHERE Invoice = "+STR(nInvoice)+""
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceSOitem' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpInvoiceSOitem' )
		ENDIF
		
		IF USED('tmpInvoiceSOitem')
			IF RECCOUNT('tmpInvoiceSOitem') > 0
		*		ThisFormset.frmSalesOrder.lstInvoice.AddItem(STR(tmpInvoiceSOitem.Invoice))
				
				IF NOT EMPTY(tmpInvoiceSOitem.SOitem)
					PRIVATE cSOitem, nSalesNum, cDecimals
		
					cSOitem = tmpInvoiceSOitem.SOitem
					nSalesNum = LEFT(cSOitem,AT("-",cSOitem)-1)
		
					cDecimals = SET("Decimals")
					SET DECIMALS TO 0
					nSalesNum = VAL( nSalesNum )
					SET DECIMALS TO (cDecimals)
		
		
					ThisFormSet.frmSalesOrder.txtSalesOrder.Value = nSalesNum 
					ThisFormSet.SalesNum = nSalesNum
					ThisFormSet.SOitem = cSOitem
					
					ThisFormSet.FindSalesOrder()
				ELSE
					MESSAGEBOX("Could not get the SO associated with this Invoice!",0+16,"No SO")
				ENDIF
				
				USE IN tmpInvoiceSOitem
			ELSE
				MESSAGEBOX("The SQL Invoice table does not have this Invoice!"+CHR(13)+"You may need to Import.",0+16,"Invoice not found")
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE findsalesorder
		*ThisFormSet.FindSalesOrder()
		
		PRIVATE nSalesNum
		nSalesNum = ThisFormSet.SalesNum
		
		ThisFormset.frmSalesOrder.lstSOitems.Clear
		
		IF USED('tmpSO')
			USE IN tmpSO
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT DISTINCT SOitem FROM dbo.Sales WHERE SOitem LIKE '"+STR(nSalesNum,7,0)+"-%'"
		cSQL = cSQL + " ORDER BY SOitem"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSO' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO' )
		ENDIF
		
		PRIVATE cFirtstSOitem
		
		IF USED('tmpSO')
			cFirtstSOitem = tmpSO.SOitem
		
			SELECT tmpSO
			SCAN
				ThisFormset.frmSalesOrder.lstSOitems.AddItem(tmpSO.SOitem)
			ENDSCAN
		
			ThisFormset.frmSalesOrder.lstSOitems.Refresh
			
			GO TOP
			
			ThisFormSet.SOitem = cFirtstSOitem
			
		*	ThisFormSet.Init_lstSales_Detail_ID()
			ThisFormSet.Refresh_Sales_Detail_ID()
			
		*!*		**Next steps:
		*!*		Refresh_Sales_Detail_ID
		*!*		  Init_Sales_Stock()
		*!*		  Init_PackingSlip()
		*!*		  Init_Invoice()
		*!*		  Init_Invoice_Frt()
		*!*		  Show_Sales_Detail()
		*!*			ShowSumStock()
		*!*			ShowSumPackingSlip()
		*!*			ShowSumInvoice()
		*!*			ShowQuotedTotal()
		*!*			Show_Quote()		
		*!*		  	  CopyQuote2Detail()
		*!*			ShowSumTotal()
			
			USE IN tmpSO	
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE importfromgreensheet
		*ThisFormSet.ImportFromGreensheet()
		
		IF NOT FILE("\\BobWhite\HPAData\Quotes\HPA SQL GreenSheet.CSV")
			MESSAGEBOX ("\\BobWhite\HPAData\Quotes\HPA SQL GreenSheet.CSV does not exists."+CHR(13)+"Have Accountant Export Greensheet.",16,"No file")
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cSQL, nSQLEXEC 
		
		*Create a tmpTable to hold error data
		IF USED('tmpMessTable')
			USE IN tmpMessTable
		ENDIF
		
		SELECT 0
		CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+"tmpMessTable") FREE (LINE C(80) )
			
		IF NOT USED('tmpMessTable')
		*	RETURN .F.
		ENDIF
		
		
		***********************
		*Clean up code!
		
		*!*	--SELECT * FROM dbo.Sales_Invoice  WHERE Invoice = 95164
		
		*!*	BEGIN TRANSACTION
		
		*!*	DELETE FROM dbo.Sales_Invoice WHERE ID IN (
		*!*	SELECT DISTINCT(S2.ID)
		*!*	--,Isnull(S1.Reconciled,0)
		*!*	--,ISNULL(S2.Reconciled,0)
		
		*!*	FROM dbo.Sales_Invoice S1 
		*!*	INNER JOIN dbo.Sales_Invoice S2 
		*!*	ON S2.Invoice = S1.Invoice 
		*!*	--AND S2.SOitem = S1.SOitem 
		*!*	AND S2.InvoiceDate = S1.InvoiceDate
		*!*	AND s2.Item = S1.Item
		*!*	AND S1.GL_Account = S2.GL_Account
		*!*	WHERE ISNULL(S1.Reconciled,0)=1
		*!*	AND ISNULL(S2.Reconciled,0) = 0
		*!*	--AND S1.Invoice = 95164
		*!*	) AND ISNULL(Sales_Invoice.Reconciled,0) = 0
		*!*
		*!*	commit
		
		
		
		IF USED('tmpGreenSheet')
			USE IN tmpGreenSheet
		ENDIF
		SELECT 0
		
		CREATE CURSOR tmpGreenSheet (;
			[Customer_ID] C(50) NULL;
			,[Customer_Name] C(50) NULL;
			,[Invoice] C(50) NULL;
			,[InvoiceDate] C(50) NULL;
			,[Customer_PO] C(50) NULL;
			,[Ship_Via] C(50) NULL;
			,[Disc_Amount] C(50) NULL;
			,[Sales_Rep] C(50) NULL;
			,[AR_Amount] C(50) NULL;
			,[Invoice_Note] C(50) NULL;
			,[Amount] C(50) NULL;
			,[ItemTot] C(50) NULL;
			,[Item] C(50) NULL;
			,[Quantity] C(50) NULL;
			,[GL_Account] C(50) NULL;
			,[UnitPrice] C(50) NULL;
			,[Trans_Period] C(50) NULL;
			,[Trans_No] C(50) NULL;
			,[ReturnAuth] C(50) NULL;
			,[Description] C(254) NULL;
			,[Date_Due] C(50) NULL;
			,[Ship_Date] C(50) NULL;
			 ) 
			
			
		APPEND FROM "\\BobWhite\HPAData\Quotes\HPA SQL GreenSheet.CSV" CSV
		
		IF RECCOUNT('tmpGreenSheet') = 0
			MESSAGEBOX("Did not get the records!"+CHR(13)+"\\BobWhite\HPAData\Quotes\HPA SQL GreenSheet.CSV",0+16,"Error with CSV")
			RETURN .F.
		ENDIF
		
		PRIVATE lReturn
		lReturn = .T.
		
		PRIVATE cSQL
		PRIVATE lSOitem_Found
		PRIVATE cCustomer_ID, cCustomer_Name, nInvoice, dInvoiceDate
		PRIVATE cCustomer_PO, cShip_Via, nDisc_Amount
		PRIVATE cSales_Rep, nAR_Amount, cInvoice_Note
		PRIVATE nAmount, nItemTot, nItem
		PRIVATE nQuantity, nGL_Account, nUnitPrice
		PRIVATE nTrans_Period, nTrans_No, cReturnAuth, cDescription
		PRIVATE cSOitem, nSalesNum, dDate_Due, cDate_DueFld, dShip_Date
		PRIVATE nSalesNumLast
		nSalesNumLast = 0
		
		PRIVATE lInsertSI, lUpdateSI
		lInsertSI = .T.
		lUpdateSI = .T.
		
		PRIVATE nInvoices, nInsert, nUpdate, nRecNo 
		nInvoices = RECCOUNT('tmpGreenSheet')
		nInsert = 0
		nUpdate = 0
		
		PRIVATE lInvoiceSO_OK 
		PRIVATE cMessage, nSOitm, SOinv
		
		
		SELECT tmpGreenSheet
		GO TOP
		SCAN	
		
			nRecNo = RECNO('tmpGreenSheet')
			WAIT WINDOW "Record "+ALLTRIM(STR(nRecNo))+" of "+ALLTRIM(STR(nInvoices))+"." NOWAIT
			
			IF LEFT(tmpGreenSheet.Customer_ID,1) = ["]
				LOOP
			ENDIF
			
			***********
			nInvoice	= PrepareSQLnum(Invoice,'Invoice',-3,0,.F.,.T.)	
			nItemTot	= PrepareSQLnum(ItemTot,'ItemTot',-1)
			*cSOitem		= getSOitemfromInvoiceDescription(tmpGreenSheet.Description)
			cDescription	= PrepareSQLtxt(tmpGreenSheet.Description,'Description',254,.F.,.T.)
			cSOitem		= getSOitemfromInvoiceDescription(cDescription)
			nSalesNum	= VAL(cSOitem)
			dInvoiceDate	= PrepareSQLdate(tmpGreenSheet.InvoiceDate,'InvoiceDate',.F.)  
			nItem			= PrepareSQLnum(tmpGreenSheet.Item,'Item',-1)
			**nItem is not same as SOitem  
			**The Invoice may may mutliple SOitem, a SOitem may have muliple ITEMS !!!
			
			
			
			********************************************
			*  Test data
		
			IF nInvoice < 1
				LOOP
			ENDIF
			IF nItemTot < 1
				LOOP
			ENDIF
			
			IF Proper_SO_item(cSOitem) = Proper_SO_item('')
				*LOOP  Freight is checked later, starts with bad SO item!
			ENDIF
			
			
					
			*	IF nInvoice = 98354
			IF nInvoice = 100516
		*		SELECT tmpGreenSheet
			*ELSE
			*	LOOP
			ENDIF
		*	IF RECNO()>169 AND RECNO()<174
		*		SELECT tmpGreenSheet
		*	ENDIF
		*	IF RECNO()=173
		*		cSOitem		= getSOitemfromInvoiceDescription(tmpGreenSheet.Description)
		*	ENDIF
			
		
		
			*Look for Reconciled Invoice, return Invoiced!  2015-11-11
			IF USED('tmpCntInvRec')
				SELECT 'tmpCntInvRec'
			ELSE
				SELECT 0
			ENDIF
			
			cSQL = "SELECT ISNULL(Reconciled,0) AS Reconciled "
			cSQL = cSQL + " FROM dbo.Sales_Invoice "
			cSQL = cSQL + " WHERE Invoice = "+ALLTRIM(STR(nInvoice)) 
			cSQL = cSQL + " AND SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " AND Item = "+STR(nItem)
			cSQL = cSQL + " AND ItemTot = "+STR(nItemTot)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntInvRec' )
					
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntInvRec' )
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntInvRec' )
			ENDIF
		
			*Check for Reconciled
			IF USED('tmpCntInvRec')
				IF RECCOUNT('tmpCntInvRec') > 0
					IF tmpCntInvRec.Reconciled 
						*Found a Reconciled Invoice
						*Do not Insert or Update
						lInsertSI = .F.
						lUpdateSI = .F.
					ELSE
						*Found Invoice unreconciled
						*Do not Insert, just Update
						lInsertSI = .F.
						lUpdateSI = .T.
					ENDIF
				ELSE
					*ItemTotal changed: Delete and Insert.
					
					cSQL = "DELETE FROM dbo.Sales_Invoice "
					cSQL = cSQL + " WHERE Invoice = "+ALLTRIM(STR(nInvoice)) 
					cSQL = cSQL + " AND ISNULL(Reconciled,0) = 0 "
					cSQL = cSQL + " AND ( SOitem = '"+cSOitem+"' OR SOitem = '      0-00' )"
					cSQL = cSQL + " AND Item = "+STR(nItem)
					cSQL = cSQL + " AND InvoiceDate = '"+DTOC(dInvoiceDate)+"'"
							
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLExecError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					lInsertSI = .T.
					lUpdateSI = .F.
				ENDIF
				USE IN 'tmpCntInvRec'
			ENDIF
			
					
			*****************************
			IF NOT lInsertSI AND NOT lUpdateSI 
				LOOP
			ENDIF
			*****************************
			
			SELECT tmpGreenSheet
			dInvoiceDate	= PrepareSQLdate(tmpGreenSheet.InvoiceDate,'InvoiceDate',.F.)  
			cCustomerID		= PrepareSQLtxt(tmpGreenSheet.Customer_ID,'CustomerID',20,.F.,.T.)
			cCustomerName	= PrepareSQLtxt(tmpGreenSheet.Customer_Name ,'CustomerName',40,.F.,.T.) 
			cCustomer_PO	= PrepareSQLtxt(tmpGreenSheet.Customer_PO,'Customer_PO',50,.F.,.T.)
			cShip_Via		= PrepareSQLtxt(tmpGreenSheet.Ship_Via,'Ship_Via',50,.F.,.T.)
			nDisc_Amount	= PrepareSQLnum(tmpGreenSheet.Disc_Amount,'Disc_Amount',-3,0,.F.,.T.)
			cSales_Rep		= AppSetup_Get_UserName( PrepareSQLtxt(tmpGreenSheet.Sales_Rep,'Sales_Rep',50,.F.,.T.), ThisFormSet.nConnHandle )
			nAR_Amount		= PrepareSQLnum(tmpGreenSheet.AR_Amount,'AR_Amount',18,4,.F.,.T.)
			cInvoice_Note	= PrepareSQLtxt(tmpGreenSheet.Invoice_Note,'Invoice_Note',50,.F.,.T.)
			nAmount			= PrepareSQLnum(tmpGreenSheet.Amount,'Amount',18,4,.F.,.T.)
			nItemTot		= PrepareSQLnum(tmpGreenSheet.ItemTot,'ItemTot',-1)
			nItem			= PrepareSQLnum(tmpGreenSheet.Item,'Item',-1)
			nQuantity		= PrepareSQLnum(tmpGreenSheet.Quantity,'Quantity',-3,0,.F.,.T.)
			nGL_Account		= PrepareSQLnum(tmpGreenSheet.GL_Account,'GL_Account',-3,0,.F.,.T.)
			nUnitPrice		= PrepareSQLnum(tmpGreenSheet.UnitPrice,'UnitPrice',18,4,.F.,.T.)
			nTrans_Period	= PrepareSQLnum(tmpGreenSheet.Trans_Period,'Trans_Period',-1,0,.F.,.T.)
			nTrans_No		= PrepareSQLnum(tmpGreenSheet.Trans_No,'Trans_No',-2,0,.F.,.T.)
			cReturnAuth		= PrepareSQLtxt(tmpGreenSheet.ReturnAuth,'ReturnAuth',50,.F.,.T.)
			*cDescription	= PrepareSQLtxt(tmpGreenSheet.Description,'Description',254,.F.,.T.)
			*cSOitem			= getSOitemfromInvoiceDescription(cDescription)
			dDate_Due		= PrepareSQLdate(tmpGreenSheet.Date_Due,'Date_Due',.F.)
			cDate_DueFld	= PrepareSQLtxt(tmpGreenSheet.Date_Due,'Date_Due',-1)  &&Gets bad with " symbol
			dShip_Date		= PrepareSQLdate(tmpGreenSheet.Ship_Date,'Ship_Date',.F.)
		
			********************************************************	
			*Check Data
			cMessage = ""
			*****
			IF dInvoiceDate + 3650 < DATE()	
				IF USED('tmpMessTable')
					INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Invoice Date: "+DTOC(dInvoiceDate))
				ENDIF
				cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Invoice Date: "+DTOC(dInvoiceDate)+CHR(13)
			ENDIF
			IF dInvoiceDate - 3650 > DATE()	
				IF USED('tmpMessTable')
					INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Invoice Date: "+DTOC(dInvoiceDate))
				ENDIF
				cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Invoice Date: "+DTOC(dInvoiceDate)+CHR(13)
			ENDIF
			
			*****
			IF dDate_Due != CTOD("  /  /  ")
				IF dDate_Due + 3650 < DATE()	
					IF USED('tmpMessTable')
						INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Date Due: "+DTOC(dDate_Due))
					ENDIF
					cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Date Due: "+DTOC(dDate_Due)+CHR(13)
				ENDIF
				IF dDate_Due - 3650 > DATE()	
					IF USED('tmpMessTable')
						INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Date Due: "+DTOC(dDate_Due))
					ENDIF
					cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Date Due: "+DTOC(dDate_Due)+CHR(13)
				ENDIF
			ENDIF
			
			*****
			IF LEN(ALLTRIM(cDate_DueFld)) > 20
				IF USED('tmpMessTable')
					INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Date Due: '"+ALLTRIM(cDate_DueFld)+"'" )
				ENDIF
				cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Date Due: '"+ALLTRIM(cDate_DueFld)+"'"+CHR(13)
				lInsertSI = .F.
				lUpdateSI = .F.
			ENDIF
			
			*****
			IF dShip_Date != CTOD("  /  /  ")
				IF dShip_Date + 3650 < DATE()	
					IF USED('tmpMessTable')
						INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Ship Date: "+DTOC(dShip_Date))
					ENDIF
					cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Ship Date: "+DTOC(dShip_Date)+CHR(13)
				ENDIF
				IF dShip_Date - 3650 > DATE()	
					IF USED('tmpMessTable')
						INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Ship Date:" +DTOC(dShip_Date))
					ENDIF
					cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad Ship Date:" +DTOC(dShip_Date)+CHR(13)
				ENDIF
			ENDIF
			*****
			
			IF EMPTY(cSOitem) OR Proper_SO_Item(cSOitem) = Proper_SO_Item('')
				nSO = VAL(RIGHT(LEFT(cInvoice_Note,9),6) ) 
				IF nGL_Account = 69000
					*Billing has no Item!
					cSOitem = Proper_SO_Item( STR(nSO)+"-00" )
				ELSE
					DO CASE
					CASE UPPER(LEFT(cDescription,3))="VAT"
					CASE UPPER(LEFT(cDescription,4))="SKID"
					CASE UPPER(LEFT(cDescription,3))="DO/"
					CASE UPPER(LEFT(cDescription,8))="BANK FEE"
					CASE UPPER(LEFT(cDescription,9))="REBILLING"
		
					CASE "RETURN" $ UPPER(cDescription)
					CASE "CREDIT" $ UPPER(cDescription)
					CASE "DEBIT" $ UPPER(cDescription)
					CASE "OVERPAYMENT" $ UPPER(cDescription)
					CASE "REFUND" $ UPPER(cDescription)
					CASE "ULTIMATE CONSIGNEE" $ UPPER(cDescription)
					CASE "RMA" $ UPPER(cDescription)
					CASE "NONCONFORMING" $ UPPER(cDescription)
					CASE "RESTOCKING" $ UPPER(cDescription)
					CASE "DOES NOT MEET" $ UPPER(cDescription)
					CASE "LOWER THAN EST" $ UPPER(cDescription)
					CASE "TO BE CORRECTED" $ UPPER(cDescription)
					CASE "ISSUE CREDIT" $ UPPER(cDescription)
					CASE "RESTOCK" $ UPPER(cDescription)
					CASE "CANCEL" $ UPPER(cDescription)
					CASE "INCORRECT" $ UPPER(cDescription)
					CASE "DISCREPANCY" $ UPPER(cDescription)
					CASE "UNDERCHARGED" $ UPPER(cDescription)
					CASE "UNDER CHARGED" $ UPPER(cDescription)
					CASE "REPLACED" $ UPPER(cDescription)
					CASE "WRONG" $ UPPER(cDescription)
					CASE "MATERIAL WAS RETURN" $ UPPER(cDescription)
					
					OTHERWISE
						IF USED('tmpMessTable')
							INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has a bad Item! SOitem="+ALLTRIM(STR(nSOitm))+" or SO="+ALLTRIM(STR(nSOinv)))
							INSERT INTO tmpMessTable (Line) VALUE ("^"+LEFT(cDescription,100) )
							INSERT INTO tmpMessTable (Line) VALUE ("^"+LEFT(cInvoice_Note,100) )
						ENDIF
						cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has a bad Item!"+CHR(13)+"SOitem="+ALLTRIM(STR(nSOitm))+" or SO="+ALLTRIM(STR(nSOinv))+CHR(13)
					ENDCASE
				ENDIF
			ENDIF
			
			IF AT("-",cSOitem) > 0
				nSOitm = VAL(LEFT(cSOitem,AT("-",cSOitem)-1))
				nSOinv = VAL(SUBSTR(cInvoice_Note,3,10))
				IF nSOinv > 0
					IF nSOitm != nSOinv 
						IF USED('tmpMessTable')
							INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has a bad SalesNum! SOitem="+ALLTRIM(STR(nSOitm))+" or SO="+ALLTRIM(STR(nSOinv)))
						ENDIF
						cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has a bad SalesNum!"+CHR(13)+"SOitem="+ALLTRIM(STR(nSOitm))+" or SO="+ALLTRIM(STR(nSOinv))+CHR(13)
					ENDIF
				ENDIF
			ENDIF
			
			************
			IF nItem = 0 
				DO CASE
				CASE UPPER(cDescription) = UPPER("Freight Amount")
					IF VAL( RIGHT(cSOitem,2) ) > 0
						*Trouble
						IF USED('tmpMessTable')
							INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+"Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad SO Item! SOitem="+ALLTRIM(cSOitem)+" should be Item=0" )
						ENDIF
						cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad SO Item! SOitem="+ALLTRIM(cSOitem)+" should be Item=0"+CHR(13)+" 69000 'Freight Amount' should be listed without an Item number!"+CHR(13)		
						lInsertSI = .F.
						lUpdateSI = .F.
					ELSE 
						*Good!
					ENDIF
				CASE LEFT(ALLTRIM(cDescription),2) = "^ "
					*"^ CustomerID=FERRAEN, Customer_PO=Payment!!, Period=32"  &&a Rem Statement
					lInsertSI = .F.
					lUpdateSI = .F.
				OTHERWISE
					IF USED('tmpMessTable')
						INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has NO Description!"+" GL_Acount="+ALLTRIM(STR(nGL_Account)) )
					ENDIF
					cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has NO Description!"+CHR(13)+" GL_Acount="+ALLTRIM(STR(nGL_Account))+CHR(13)
					lInsertSI = .F.
					lUpdateSI = .F.
				ENDCASE
			ENDIF
			
			*******************************
			**Data check nSalesNum
			IF nSalesNum > 0
				IF nSalesNumLast = 0
					nSalesNumLast = nSalesNum
				ENDIF
				
				IF nSalesNum * 2 < nSalesNumLast 
					IF USED('tmpMessTable')
						INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" low SalesNum '"+ALLTRIM(STR(nSalesNum))+"' and SOitem is '"+cSoitem+"'" )
					ENDIF
					cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" low SalesNum '"+ALLTRIM(STR(nSalesNum))+"' and SOitem is '"+cSoitem+"'" +CHR(13)
					lInsertSI = .F.
					lUpdateSI = .F.
				ENDIF
		
				IF nSalesNum > nSalesNumLast * 2
					IF USED('tmpMessTable')
						INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" high SalesNum '"+ALLTRIM(STR(nSalesNum))+"' and SOitem is '"+cSoitem+"'" )
					ENDIF
					cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" high SalesNum '"+ALLTRIM(STR(nSalesNum))+"' and SOitem is '"+cSoitem+"'" +CHR(13)
					lInsertSI = .F.
					lUpdateSI = .F.
				ENDIF
			ENDIF
						
		*	************  This rule should not be used, Accountants add lines without SOitem or split SOitem in 2 lline numbers  12/30/2015
		*	IF nItem > 0 
		*		IF VAL( RIGHT(cSOitem,2) ) <> nItem
		*			IF USED('tmpMessTable')
		*				INSERT INTO tmpMessTable (Line) VALUE ("L"+ALLTRIM(STR(RECNO('tmpGreenSheet')))+" Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad SO Item! SOitem="+ALLTRIM(STR(nSOitm))+", should be Item="+ALLTRIM(STR(nItem)) )
		*			ENDIF
		*			cMessage = cMessage + " Invoice #"+ALLTRIM(STR(nInvoice))+" has a bad SO Item! SOitem="+ALLTRIM(STR(nSOitm))+", should be Item="+ALLTRIM(STR(nItem))+CHR(13)	
		*			lInsertSI = .F.
		*		ENDIF
		*	ENDIF
			
			************
			IF LEN(ALLTRIM(cInvoice_Note)) = 0
				*No SO in Invoice_Note
				*See if SOitem has been already entered with nInvoice
				lInvoiceSO_OK = .F.	
				DO CASE
				CASE UPPER(LEFT(cDescription,3))="VAT"
				CASE UPPER(LEFT(cDescription,4))="SKID"
				CASE UPPER(LEFT(cDescription,3))="DO/"
				CASE UPPER(LEFT(cDescription,8))="BANK FEE"
				CASE UPPER(LEFT(cDescription,9))="REBILLING"
		
				CASE "RETURN" $ UPPER(cDescription)
				CASE "CREDIT" $ UPPER(cDescription)
				CASE "DEBIT" $ UPPER(cDescription)
				CASE "OVERPAYMENT" $ UPPER(cDescription)
				CASE "REFUND" $ UPPER(cDescription)
				CASE "ULTIMATE CONSIGNEE" $ UPPER(cDescription)
				CASE "RMA" $ UPPER(cDescription)
				CASE "NONCONFORMING" $ UPPER(cDescription)
				CASE "RESTOCKING" $ UPPER(cDescription)
				CASE "DOES NOT MEET" $ UPPER(cDescription)
				CASE "LOWER THAN EST" $ UPPER(cDescription)
				CASE "TO BE CORRECTED" $ UPPER(cDescription)
				CASE "ISSUE CREDIT" $ UPPER(cDescription)
				CASE "RESTOCK" $ UPPER(cDescription)
				CASE "CANCEL" $ UPPER(cDescription)
				CASE "INCORRECT" $ UPPER(cDescription)
				CASE "DISCREPANCY" $ UPPER(cDescription)
				CASE "UNDERCHARGED" $ UPPER(cDescription)
				CASE "UNDER CHARGED" $ UPPER(cDescription)
				CASE "REPLACED" $ UPPER(cDescription)
				CASE "WRONG" $ UPPER(cDescription)
				CASE "MATERIAL WAS RETURN" $ UPPER(cDescription)
				
				OTHERWISE
					lInvoiceSO_OK = .T.
				ENDCASE
				****
				
				IF lInvoiceSO_OK
					IF USED('tmpInvoiceSO')
						USE IN 'tmpInvoiceSO'
					ENDIF
					SELECT 0
					
					cSQL = "SELECT SOitem FROM dbo.Sales_Invoice "
					cSQL = cSQL + " WHERE Invoice = "+ALLTRIM(STR(nInvoice)) 	
					cSQL = cSQL + " AND GL_Account = "+ALLTRIM(STR(nGL_Account)) 	
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceSO' )
							
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceSO' )
					ENDDO
					IF nSQLEXEC < 0
						SQLExecError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpInvoiceSO' )
					ENDIF
					
					IF USED('tmpInvoiceSO')
						IF RECCOUNT('tmpInvoiceSO') > 0
							IF VARTYPE(tmpInvoiceSO.SOitem) = "C"
								IF Proper_SO_Item(" 0-00") != tmpInvoiceSO.SOitem
									cSOitem = tmpInvoiceSO.SOitem
									nSO = VAL( LEFT(cSOitem,AT("-",cSOitem)-1) )
									lInvoiceSO_OK = .T.
								ENDIF
							ENDIF
						ENDIF
						USE IN tmpInvoiceSO
					ENDIF
					IF NOT lInvoiceSO_OK 
						IF USED('tmpMessTable')
							INSERT INTO tmpMessTable (Line) VALUE ("Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has no SO. Invoice_Note is Empty.")
							cInvoice = LEFT(tmpGreenSheet.Invoice,30)	&&Invoice is not always a number here!
							INSERT INTO tmpMessTable (Line) VALUE ( "^ "+LEFT(ALLTRIM(cInvoice)+". "+ALLTRIM(cDescription),80) )
							cDescription = "^ "+"CustomerID="+PrepareSQLtxt(tmpGreenSheet.Customer_ID,'CustomerID',20,.F.,.T.)
							cDescription = cDescription + ", Customer_PO=" + PrepareSQLtxt(tmpGreenSheet.Customer_PO,'Customer_PO',50,.F.,.T.)+"!!"
							cDescription = cDescription + ", Period="+ALLTRIM(STR(PrepareSQLnum(tmpGreenSheet.Trans_Period,'Trans_Period',-1,0,.F.,.T.)))
							INSERT INTO tmpMessTable (Line) VALUE ( LEFT(cDescription,80) )
						ENDIF
						cMessage = cMessage + "Invoice #"+ALLTRIM(STR(nInvoice))+" on: "+DTOC(dInvoiceDate)+" has a bad SalesNum!"+CHR(13)+"NO SOitem or SO."+CHR(13)
					ENDIF	
				ENDIF
			ENDIF
		
			*****
		*IF nInvoice=85749
		*	MESSAGEBOX("nInvoice = "+STR(nInvoice))
		*ENDIF
			
		
			
			*End of Data Check
			********************************************************
			
			IF lInsertSI
			
				*Do not dublicate GL_Account 69000
				PRIVATE lHaveGL_Account
				lHaveGL_Account = .F.
				
				IF nGL_Account = 69000
					*Check for a Current GL_Account = 69000
					IF USED('tmpCntSls_Inv')
						SELECT 'tmpCntSls_Inv'
					ELSE
						SELECT 0
					ENDIF
					
					cSQL = "SELECT COUNT(*) AS CNTD "
					cSQL = cSQL + " FROM dbo.Sales_Invoice "
					cSQL = cSQL + " WHERE Invoice = "+ALLTRIM(STR(nInvoice)) 
					cSQL = cSQL + " AND SOitem = '"+cSOitem+"'"
					cSQL = cSQL + " AND Item = "+STR(nItem)
					cSQL = cSQL + " AND ItemTot = "+STR(nItemTot)
					cSQL = cSQL + " AND GL_Account = 69000"
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntSls_Inv' )
							
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntSls_Inv' )
					ENDDO
					IF nSQLEXEC < 0
						SQLExecError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntSls_Inv' )
					ENDIF
		
					*Check for Reconciled
					IF USED('tmpCntSls_Inv')
						IF RECCOUNT('tmpCntSls_Inv') > 0
							IF tmpCntSls_Inv.CNTD > 0
								lHaveGL_Account = .T.
								cSQL = "SELECT GetDate()"
							ENDIF
						ENDIF
						USE IN tmpCntSls_Inv
					ENDIF		
				ENDIF
				
				IF NOT lHaveGL_Account 
					cSQL = "INSERT INTO dbo.Sales_Invoice ("
					cSQL = cSQL + " [Invoice],[InvoiceDate],[SOitem],[SalesNum],[CustomerID],[CustomerName]"
					cSQL = cSQL + ",[Customer_PO],[Ship_Via],[Disc_Amount],[Sales_Rep]"
					cSQL = cSQL + ",[AR_Amount],[Invoice_Note],[Amount],[ItemTot],[Item]"
					cSQL = cSQL + ",[Quantity],[GL_Account]"
					cSQL = cSQL + ",[UnitPrice],[Trans_Period],[Trans_No],[ReturnAuth],[Description]"
					cSQL = cSQL + ",[Date_Due],[Ship_Date]"
					cSQL = cSQL + ") VALUES ("
					cSQL = cSQL + " "+STR(nInvoice)
					cSQL = cSQL + ",'"+IIF(dInvoiceDate= CTOD("  /  /  "),'',DTOC(dInvoiceDate))+"'"
					cSQL = cSQL + ",'"+cSOitem+"'"
					cSQL = cSQL + ",'"+STR(VAL(cSOitem))+"'" 
					cSQL = cSQL + ",'"+cCustomerID+"'"
					cSQL = cSQL + ",'"+cCustomerName+"'"
					cSQL = cSQL + ",'"+cCustomer_PO+"'"
					cSQL = cSQL + ",'"+cShip_Via+"'"
					cSQL = cSQL + ","+STR(nDisc_Amount,18,4)
					cSQL = cSQL + ",'"+cSales_Rep+"'"
					cSQL = cSQL + ","+STR(nAR_Amount,18,4)
					cSQL = cSQL + ",'"+cInvoice_Note+"'"
					cSQL = cSQL + ","+STR(nAmount,18,4)
					cSQL = cSQL + ","+STR(nItemTot)
					cSQL = cSQL + ","+STR(nItem)
					cSQL = cSQL + ","+STR(nQuantity)
					cSQL = cSQL + ","+STR(nGL_Account)
					cSQL = cSQL + ","+STR(nUnitPrice,18,4)
					cSQL = cSQL + ","+STR(nTrans_Period)
					cSQL = cSQL + ","+STR(nTrans_No)
					cSQL = cSQL + ",'"+cReturnAuth+"'"
					cSQL = cSQL + ",'"+cDescription+"'"
					cSQL = cSQL + ",'"+IIF(dDate_Due= CTOD("  /  /  "),'',DTOC(dDate_Due))+"'"
					cSQL = cSQL + ",'"+IIF(dShip_Date= CTOD("  /  /  "),'',DTOC(dShip_Date))+"'"
					cSQL = cSQL + ")"
					
					nInsert = nInsert + 1
				ENDIF
			ENDIF
			
			*****************************
			
			IF lUpdateSI 		
				cSQL = "UPDATE dbo.Sales_Invoice SET "
				cSQL = cSQL + " InvoiceDate='"+IIF(dInvoiceDate= CTOD("  /  /  "),'',DTOC(dInvoiceDate))+"'"
				cSQL = cSQL + ",CustomerID='"+cCustomerID+"'"
				cSQL = cSQL + ",CustomerName='"+cCustomerName+"'"
				cSQL = cSQL + ",Customer_PO='"+cCustomer_PO+"'"
				cSQL = cSQL + ",Ship_Via='"+cShip_Via+"'"
				cSQL = cSQL + ",Disc_Amount="+STR(nDisc_Amount,18,4)
				cSQL = cSQL + ",Sales_Rep='"+cSales_Rep+"'"
				cSQL = cSQL + ",AR_Amount="+STR(nAR_Amount,18,4)
				cSQL = cSQL + ",Invoice_Note='"+cInvoice_Note+"'"
				cSQL = cSQL + ",Amount="+STR(nAmount,18,4)
		*		cSQL = cSQL + ",ItemTot="+STR(nItemTot)
		*		cSQL = cSQL + ",Item="+STR(nItem)
				cSQL = cSQL + ",Quantity="+STR(nQuantity)
				cSQL = cSQL + ",GL_Account="+STR(nGL_Account)
				cSQL = cSQL + ",UnitPrice="+STR(nUnitPrice,18,4)
				cSQL = cSQL + ",Trans_Period="+STR(nTrans_Period)
				cSQL = cSQL + ",Trans_No="+STR(nTrans_No)
				cSQL = cSQL + ",ReturnAuth='"+cReturnAuth+"'"
				cSQL = cSQL + ",Description='"+cDescription+"'"
				cSQL = cSQL + ",SOitem='"+cSOitem+"'"
				cSQL = cSQL + ",SalesNum="+STR(VAL(cSOitem))
				cSQL = cSQL + ",Date_Due='"+IIF(dDate_Due= CTOD("  /  /  "),'',DTOC(dDate_Due))+"'"
				cSQL = cSQL + ",Ship_Date='"+IIF(dShip_Date= CTOD("  /  /  "),'',DTOC(dShip_Date))+"'"
				cSQL = cSQL + " WHERE Invoice = "+ALLTRIM(STR(nInvoice)) 
				cSQL = cSQL + " AND Item="+STR(nItem)
				
				nUpdate = nUpdate + 1
			ENDIF
			
			*****************************
			
			IF lInsertSI OR lUpdateSI 
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
						
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC )
					*exit
				ENDIF
				
			ENDIF
			SELECT tmpGreenSheet
			
		ENDSCAN
		
		IF USED('tmpGreenSheet')
			USE IN tmpGreenSheet
		ENDIF
		
		WAIT CLEAR
		*******
		
		IF USED('tmpMessTable')
			IF RECCOUNT('tmpMessTable') > 0
				SELECT tmpMessTable
				REPORT FORM Reports\MessageTable HEADING "Use [12345-12] in the Descripton to identify SOitem." PREVIEW
			ENDIF
		
			USE IN tmpMessTable
		ENDIF
		
		IF FILE(SYS(5)+SYS(2003)+"\MEM\tmpMessTable.DBF")
			DELETE FILE (SYS(5)+SYS(2003)+"\MEM\tmpMessTable.DBF")
		ENDIF
		******
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		WAIT WINDOW "Added "+ALLTRIM(STR(nInsert))+" records, Updated "+ALLTRIM(STR(nUpdate))+" records." NOWAIT
		
		***********************
		IF FILE("\\BobWhite\HPAData\Quotes\HPA SQL GreenSheet.CSV")
		*	DELETE FILE "\\BobWhite\HPAData\Quotes\HPA SQL GreenSheet.CSV"
		ENDIF
		
		***********************
		
		
		RETURN lReturn 
	ENDPROC

	PROCEDURE Init
		PARAMETERS pSOitem, pSO
		*DO FORM Forms\Sales_Detail SOitem,SO
		
		IF VARTYPE(pSO) = "N"
			ThisFormset.frmSalesOrder.txtSalesOrder.Value = pSO
			ThisFormSet.SalesNum = pSO
			ThisFormset.frmSalesOrder.cmdFindSO.Click
			RETURN
		ENDIF
		
		IF VARTYPE(pSOitem) = "C"
			pSO = VAL(LEFT(pSOitem,7))
			ThisFormset.frmSalesOrder.txtSalesOrder.Value = pSO
			ThisFormSet.SalesNum = pSO
			ThisFormset.frmSalesOrder.cmdFindSO.Click
			RETURN
		ENDIF
		
		
		
		ThisFormset.frmSalesOrder.txtSalesOrder.SetFocus
	ENDPROC

	PROCEDURE init_invoice
		*ThisFormSet.Init_Invoice()
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		PRIVATE nInvoice
		nInvoice = 0
		
		PRIVATE cSQL, nSQLEXEC
		
		ThisFormset.frmInvoice.grdInvoice.Visible = .F.
		ThisFormset.frmInvoice.grdInvoice.RecordSource = ""
		
		IF USED('tmpInvoice')
			USE IN tmpInvoice
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * "
		cSQL = cSQL +" FROM dbo.Sales_Invoice "
		cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpInvoice')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpInvoice' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpInvoice' )
		ENDIF
		
		IF USED('tmpInvoice')
			IF RECCOUNT('tmpInvoice') > 0
				ThisFormset.frmInvoice.grdInvoice.RecordSource = "tmpInvoice"
				ThisFormSet.frmInvoice.grdInvoice.column1.ControlSource = 'tmpInvoice.ID'
				ThisFormset.frmInvoice.grdInvoice.Visible = .T.
				
				*UPDATE tmpInvoice SET Paid = ABS(AR_Amount) WHERE NOT PrepareSQLlogic(tmpInvoice.reconciled,'Reconciled')
				UPDATE tmpInvoice SET Paid = ABS(Amount) WHERE NOT PrepareSQLlogic(tmpInvoice.reconciled,'Reconciled')
				
				ThisFormSet.Show_Invoice()	
						
		*		IF RECCOUNT('tmpInvoice') = 1
		*			ThisFormSet.frmInvoice.chkReconciled.Value = 1
		*		ENDIF
			ELSE
				MESSAGEBOX("Invoice for SOitem '"+ALLTRIM(cSOitem)+"' was not found!"+CHR(13)+"Cannot Reconcile!"+CHR(13)+CHR(13)+"You may need to Import GreenSheet!",0+16,"No SOitem.")
				RETURN .F.
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE init_invoice_frt
		*ThisFormSet.Init_Invoice_Frt()
		*PRIVATE nInvoice
		*nInvoice = PrepareSQLnum(ThisFormSet.frmSalesOrder.txtInvoice.Value,'Invoice',-3)
		*nInvoice = PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		PRIVATE cSOitem00
		*cSOitem00 = STUFF(ThisFormSet.SOitem,LEN(ThisFormSet.SOitem)-2,2,'00')
		cSOitem00 = LEFT(ThisFormSet.SOitem,LEN(ThisFormSet.SOitem)-2)+"00"
		
		PRIVATE cSQL, nSQLEXEC
		
		ThisFormset.frmInvoiceFrt.grdInvoiceFrt.Visible = .F.
		ThisFormset.frmInvoiceFrt.grdInvoiceFrt.RecordSource = ""
		
		IF USED('tmpInvoiceFrt')
			USE IN tmpInvoiceFrt
		ENDIF
		SELECT 0
		
		*!*	cSQL = "SELECT "
		*!*	cSQL = cSQL +" [ID],"
		*!*	cSQL = cSQL +" [Invoice],[InvoiceDate],[SOitem],[CustomerID],[CustomerName],[Customer_PO]"
		*!*	cSQL = cSQL +",[Ship_Via] ,[Disc_Amount] ,[Sales_Rep] ,[AR_Amount] ,[Invoice_Note],[Amount]"
		*!*	cSQL = cSQL +",[ItemTot],[Item],[Quantity],[GL_Account],[UnitPrice],[Trans_Period],[Trans_No]"
		*!*	cSQL = cSQL +",[ReturnAuth],[Description],[Ship_Date],[Date_Due] ,[Reconciled] ,[Sales_Detail_ID],[Paid]"
		*!*	cSQL = cSQL +" FROM dbo.Sales_Invoice "
		*!*	cSQL = cSQL +" WHERE SOitem = '"+cSOitem00+"'"
		*!*	cSQL = cSQL +" AND GL_Account = 69000"
		*!*	*cSQL = cSQL +" AND Invoice = "+ALLTRIM(STR( nInvoice ))
		
		*!*	cSQL = "SELECT DISTINCT si.Invoice FROM dbo.Sales_Invoice si"
		*!*	cSQL = cSQL +", dbo.Sales_Invoice si2 "
		*!*	cSQL = cSQL +" WHERE si.GL_Account = 69000 "
		*!*	cSQL = cSQL +" AND si2.SOitem = '"+cSOitem00+"'"
		*!*	cSQL = cSQL +" AND si.Invoice = si2.Invoice "
		
		
		cSQL = "SELECT si3.* FROM dbo.Sales_Invoice si3 "
		cSQL = cSQL +" WHERE si3.Invoice IN ("
		cSQL = cSQL +" 	SELECT DISTINCT si.Invoice FROM dbo.Sales_Invoice si"
		cSQL = cSQL +" 	, dbo.Sales_Invoice si2 "
		cSQL = cSQL +" 	WHERE si.GL_Account = 69000"
		cSQL = cSQL +" 	AND si2.SOitem = '"+cSOitem00+"'"
		cSQL = cSQL +" 	AND si.Invoice = si2.Invoice ) "
		cSQL = cSQL +" AND si3.GL_Account = 69000 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceFrt')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceFrt' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpInvoiceFrt' )
		ENDIF
		
		IF USED('tmpInvoiceFrt')
			IF RECCOUNT('tmpInvoiceFrt') > 0	
				
		*!*			IF nInvoice > 0
		*!*				SELECT tmpInvoiceFrt
		*!*				DELETE FOR Invoice != nInvoice
		*!*				GO TOP
		*!*				
		*!*				DO WHILE NOT EOF('tmpInvoiceFrt')
		*!*					IF DELETED('tmpInvoiceFrt')
		*!*						SKIP 1
		*!*						*Go to the first non delete record.
		*!*					ELSE
		*!*						EXIT
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF
				
															*Should be a sumation of Freight still active.	
				ThisFormSet.frmSales_Reconcile.txtFreight.Value = tmpInvoiceFrt.Amount &&tmpInvoice.Freight
															
				ThisFormset.frmInvoiceFrt.grdInvoiceFrt.RecordSource = "tmpInvoiceFrt"
				*ThisFormSet.frmInvoiceFrt.grdInvoiceFrt.column1.ControlSource = "tmpInvoiceFrt.ID"
				ThisFormSet.frmInvoiceFrt.grdInvoiceFrt.column1.ControlSource = "tmpInvoiceFrt.Invoice"
				ThisFormset.frmInvoiceFrt.grdInvoiceFrt.Visible = .T.
			
				ThisFormSet.Show_Invoice_Frt()	
						
				IF RECCOUNT('tmpInvoiceFrt') = 1
					ThisFormSet.frmInvoiceFrt.chkReconciled.Value = 1
				ENDIF
			ELSE
				ThisFormSet.frmInvoiceFrt.Visible = .F.
			ENDIF
		ELSE
			ThisFormSet.frmInvoiceFrt.Visible = .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE init_lstsales_detail_id
		*ThisFormSet.Init_lstSales_Detail_ID()
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		*ThisFormSet.Sales_Detail_ID = 0
		
		PRIVATE cSQL, nSQLEXEC
		
		*** Populate lst Sales Reconcile ID
		ThisFormset.frmSalesOrder.lstSales_Detail_ID.Clear
		
		IF USED('tmpSales_Detail_ID')
			USE IN tmpSales_Detail_ID
		ENDIF
		SELECT 0
		
		
		cSQL = "SELECT ID, Reconciled "
		cSQL = cSQL +" FROM dbo.Sales_Detail WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Detail_ID' )
		ENDIF
		
		ThisFormset.frmSalesOrder.cmdDeleteSales_Rec.Visible = .F.
		
		IF USED('tmpSales_Detail_ID')
			IF RECCOUNT('tmpSales_Detail_ID') > 0
				SELECT tmpSales_Detail_ID
				SCAN
					ThisFormset.frmSalesOrder.lstSales_Detail_ID.AddItem(STR(tmpSales_Detail_ID.ID))
				ENDSCAN
		
				ThisFormset.frmSalesOrder.lstSales_Detail_ID.Refresh
				
				GO TOP
				ThisFormset.frmSalesOrder.lstSales_Detail_ID.Value = STR(tmpSales_Detail_ID.ID)
				ThisFormSet.Sales_Detail_ID = tmpSales_Detail_ID.ID
				
				lReconciled = PrepareSQLchk(tmpSales_Detail_ID.Reconciled,'Reconciled')
		
				IF RECCOUNT('tmpSales_Detail_ID') > 1
					ThisFormset.frmSalesOrder.cmdDeleteSales_Rec.Visible = .F.
				ENDIF
				
				****
				ThisFormSet.Refresh_Sales_Detail_ID()
				****	
				
			ELSE
		
				ThisFormSet.Refresh_Sales_Detail_ID()
			ENDIF		
		ENDIF
		
		IF USED('tmpSales_Detail_ID')	
			USE IN tmpSales_Detail_ID	
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE init_packingslip
		*ThisFormSet.Init_PackingSlip()
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		ThisFormSet.frmPackingSlip.grdPackingSlip.Visible = .F.
		ThisFormSet.frmPackingSlip.grdPackingSlip.RecordSource = ''
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpPackingSlip')
			USE IN tmpPackingSlip
		ENDIF
		SELECT 0
		
		cSQL = " SELECT PS.PackingSli,Pcs,Descript,SOitem,PO_num,Heat,Weight,PS.Kg,Alloy,SOitem_Cmplt"
		cSQL = cSQL +" ,PSn.PS_Date, PSn.TotalWeight, PS.ID_PackingSlip, PS.Reconciled"
		cSQL = cSQL +" FROM dbo.PackingSlip PS"
		cSQL = cSQL +" JOIN dbo.PackingSlip_No PSn ON PSn.PackingSli = PS.PackingSli"
		cSQL = cSQL +" WHERE PS.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL +" AND ISNULL(PS.Cancld,1) = 0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPackingSlip')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPackingSlip' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPackingSlip' )
		ENDIF
		
		IF USED('tmpPackingSlip')
			
			IF RECCOUNT('tmpPackingSlip') > 0
				ThisFormSet.frmPackingSlip.grdPackingSlip.RecordSource = 'tmpPackingSlip'
				ThisFormSet.frmPackingSlip.grdPackingSlip.column1.ControlSource = 'tmpPackingSlip.PackingSli'
				ThisFormSet.frmPackingSlip.grdPackingSlip.Visible = .T.
				
				ThisFormSet.Show_PackingSlip()
				
				IF RECCOUNT('tmpPackingSlip') = 1
					ThisFormSet.frmPackingSlip.chkReconciled.Value = 1
				ENDIF
			ENDIF
		ENDIF
		
		RETURN .T.
		
		
		
	ENDPROC

	PROCEDURE init_sales_stock
		PARAMETERS pnSales_Detail_ID
		*ThisFormSet.Init_Sales_Stock()
		
		IF VARTYPE(pnSales_Detail_ID) != 'N'
			pnSales_Detail_ID = 0
		ENDIF
		
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		ThisFormSet.frmSales_Stock.grdSales_Stock.Visible = .F.
		ThisFormSet.frmSales_Stock.grdSales_Stock.RecordSource = ''
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpSales_Stock')
			USE IN tmpSales_Stock
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * "
		cSQL = cSQL +" FROM dbo.Sales_Stock "
		IF pnSales_Detail_ID > 0
			cSQL = cSQL +" WHERE Sales_Detail_ID ="+STR( pnSales_Detail_ID )
		ELSE
			cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Stock')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Stock' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Stock' )
		ENDIF
		
		IF USED('tmpSales_Stock')
			
			IF RECCOUNT('tmpSales_Stock') > 0
				
				ThisFormSet.frmSales_Stock.Visible = .T.
				
				ThisFormSet.frmSales_Stock.grdSales_Stock.RecordSource = 'tmpSales_Stock'
				ThisFormSet.frmSales_Stock.grdSales_Stock.column1.ControlSource = 'tmpSales_Stock.ID'
				ThisFormSet.frmSales_Stock.grdSales_Stock.Visible = .T.
				
				IF RECCOUNT('tmpSales_Stock') = 1
					ThisFormSet.frmSales_Stock.chkReconciled.Value = 1
				ENDIF
				
			ELSE
				ThisFormSet.frmSales_Stock.Visible = .F.
				*Some Orders will have no Stock!  Could be toll work!
				cSQL = "SELECT * FROM dbo.Sales_Stock WHERE 0>0"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Stock')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Stock' )
				ENDDO
			ENDIF
			
			ThisFormSet.Show_Sales_Stock()
			
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE init_soitem
	ENDPROC

	PROCEDURE Load
		IF NOT "QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		SET DECIMAL TO 4
		
		*ThisFormSet.GetSales_Reconcile(-180)
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE refreshforms
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		PRIVATE cForm
		cForm = ThisFormset.frmQuote.Form1.Value
			
		
		IF NOT EMPTY(cForm )
			IF GetFormCaptions(cForm ,ThisFormSet.nConnHandle)
				IF USED('tmpFormCaptions')
					ThisFormset.frmQuote.LBLTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisFormset.frmQuote.LBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
					ThisFormset.frmQuote.LBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
					ThisFormset.frmQuote.LBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisFormset.frmQuote.LBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
					ThisFormset.frmQuote.SZ31.Visible 		= tmpFormCaptions.use3rdDim
					ThisFormset.frmQuote.SZ31.Enabled 		= tmpFormCaptions.Sz3Enable
					ThisFormset.frmQuote.LBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
					ThisFormset.frmQuote.LBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
					
					USE IN tmpFormCaptions
				ELSE
					TrackMess( "tmpFormCaptions is not used!")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions returned False!")
			ENDIF
		ELSE
			TrackMess("GetFormCaptions did not have a Form!")
		ENDIF
		
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
		
		
		
		
	ENDPROC

	PROCEDURE refresh_sales_detail_id
		PARAMETERS pnSales_Detail_ID
		*ThisFormSet.Refresh_Sales_Detail_ID()
		
		IF VARTYPE(pnSales_Detail_ID) != 'N'
			pnSales_Detail_ID = 0
		ENDIF
		
		
		PRIVATE lPassed
		lPassed = .T.
		
		IF lPassed
			lPassed = ThisFormSet.Init_Sales_Stock(pnSales_Detail_ID)
			IF lPassed
				lPassed = ThisFormSet.Init_PackingSlip()
				IF lPassed
					lPassed = ThisFormSet.Init_Invoice()
					IF lPassed
						lPassed = ThisFormSet.Init_Invoice_Frt()  &&tmpInvoiceFrt.Ship_Via
						IF lPassed
		*					lPassed = ThisFormSet.Init_lstSales_Detail_ID()
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		*Need ThisFormSet.Sales_Detail_ID
		PRIVATE nSales_Detail_ID
		IF pnSales_Detail_ID > 0
			nSales_Detail_ID = pnSales_Detail_ID
		ELSE
			nSales_Detail_ID = PrepareSQLnum(ThisFormset.frmSalesOrder.lstSales_Detail_ID.Value,'Sales_Detail_ID ',-3)
		ENDIF
		
		ThisFormSet.Sales_Detail_ID = nSales_Detail_ID
		ThisFormSet.frmSales_Reconcile.txtID_Sales_Detail.Value = nSales_Detail_ID
		
		IF lPassed
			ThisFormSet.Show_Sales_Detail()
			
			*ThisFormSet.CopyQuote2Detail()
			
		ELSE
			ThisFormSet.frmQuote.Visible = .F.
			ThisFormSet.frmPackingSlip.Visible = .F.
			ThisFormSet.FrmSales_stock.Visible = .F.
			ThisFormSet.frmInvoice.Visible = .F.
			ThisFormSet.frmInvoiceFrt.Visible = .F.
			ThisFormSet.frmSales_Reconcile.Visible = .F.
			
			WAIT WINDOW 'Did NOT pass Initiation' NOWAIT
			RETURN
		ENDIF
		
		********
		
		IF ThisFormSet.Sales_Detail_ID > 1
		
			*Go back for the Reconciled check mark
			
			IF USED('tmpSales_Detail_ID2')
				USE IN tmpSales_Detail_ID2
			ENDIF
			SELECT 0
		
			cSQL = "SELECT ID, Reconciled "
			cSQL = cSQL +" FROM dbo.Sales_Detail WHERE ID = "+STR(nSales_Detail_ID)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID2')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID2' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Detail_ID2' )
			ENDIF
		
			IF USED('tmpSales_Detail_ID2')
				IF RECCOUNT('tmpSales_Detail_ID2')>0
					*ThisFormset.frmSalesOrder.chkReconciled.Value = tmpSales_Detail_ID2.Reconciled
			
				ENDIF
				USE IN tmpSales_Detail_ID2
			ENDIF
		ELSE
			*ThisFormset.frmSalesOrder.chkReconciled.Value = 0
		ENDIF
		
		
		
	ENDPROC

