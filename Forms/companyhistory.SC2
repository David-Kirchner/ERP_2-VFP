	ADD OBJECT 'grdvCompQHistory' AS grid WITH ;
		BackColor = 128,255,255, ;
		GridLineColor = 0,0,128, ;
		Height = 312, ;
		Left = 0, ;
		Name = "grdvCompQHistory", ;
