		MinWidth = 624
		Name = "frmCompanyHistory"
		nreturnkey = 0
		Top = 0
		Width = 624
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdCompanyInfo' AS commandbutton WITH ;
