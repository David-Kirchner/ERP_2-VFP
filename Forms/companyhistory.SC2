DEFINE CLASS frmcompanyhistory AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="shpAlloySearch" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReturn" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblAlloy" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtAlloy" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSearchAlloy" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdvCompQHistory" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSelect" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCompanyInfo" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: closealloys		&& Opened by this program
		*p: nreturnkey		&& vCompQHistory.ID
	*</DefinedPropArrayMethod>

	*<PropValue>
