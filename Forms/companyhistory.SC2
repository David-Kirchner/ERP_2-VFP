	ADD OBJECT 'lblAlloy' AS label WITH ;
		Caption = "Alloy", ;
		Height = 17, ;
		Left = 52, ;
		Name = "lblAlloy", ;
		TabIndex = 2, ;
		Top = 315, ;
		Width = 40
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'shpAlloySearch' AS shape WITH ;
		Height = 39, ;
		Left = 32, ;
		Name = "shpAlloySearch", ;
		Top = 313, ;
		Width = 216
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtAlloy' AS textbox WITH ;
		Format = "", ;
		Height = 23, ;
		InputMask = "!!!!!!!!!!!!", ;
		Left = 49, ;
		Name = "txtAlloy", ;
		TabIndex = 3, ;
		Top = 327, ;
		Width = 88
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		IF ThisForm.CloseAlloys 
			USE IN Alloys
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pCompany,pAlloy,cSQL
		*DO FORM Forms\companyhistory WITH 'FASPRO TECHNOLOGIES INC. ', 'Ni200',''
		
		PRIVATE cCompany
		cCompany = ""
		*vCompQHistory
		
		IF TYPE('pCompany') = "C"
			cCompany = pCompany	
		ENDIF
		
		IF TYPE('pAlloy') = "C"
			ThisForm.txtAlloy.Value = pAlloy
		ELSE
			ThisForm.txtAlloy.Value = SPACE(12)
		ENDIF
		
		
		IF !EMPTY(ThisForm.txtAlloy.Value)
		*	ThisForm.cmdSearch.Click
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF TYPE('gnConnHandle') = "U"
			STORE get_SQLSTRINGCONNECT() TO gnConnHandle
			IF gnConnHandle < 0
				= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
				QUIT
			ENDIF
		ENDIF
		IF gnConnHandle < 1
			* INITIALIZED, But connection has been dropped by another module
			STORE get_SQLSTRINGCONNECT() TO gnConnHandle
		ENDIF
		
		SELECT 0
		cSQL="SELECT * FROM DBO.AllQuotes WHERE Company Like '%"+STRTRAN(ALLTRIM(cCompany),"'","''")+"' ORDER BY InqNum"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'vCompQHistory')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'vCompQHistory')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "vCompQHistory")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "vCompQHistory")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			*THISFORMSET.SQLEXECError(cSQL)
			SQLExecError(cSQL,gnConnHandle, nSQLEXEC, 'vCompQHistory')
		ENDIF
		
		ThisForm.grdvCompQHistory.RecordSource = "vCompQHistory"
		
		*INDEX ON Alloy tag tmpAlloy
		
		*!*	IF FILE('Reports\CompHist.FRX')
		*!*		REPORT FORM Reports\CompHist PREVIEW
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		*IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*	SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		*ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE Resize
		ThisForm.shpAlloySearch.Top = 313 + (ThisForm.Height - 352 )
		ThisForm.cmdReturn.Top = 324 + (ThisForm.Height - 352 )
		ThisForm.cmdSelect.Top = 324 + (ThisForm.Height - 352 )
		
		ThisForm.lblAlloy.Top = 315 + (ThisForm.Height - 352 )
		ThisForm.txtAlloy.Top = 327 + (ThisForm.Height - 352 )
		ThisForm.cmdSearchAlloy.Top = 320 + (ThisForm.Height - 352 )
		
		ThisForm.grdvCompQHistory.Height = 312 + (ThisForm.Height - 352 )
		ThisForm.grdvCompQHistory.Width = 624 + (ThisForm.Width - 624 )
	ENDPROC

	PROCEDURE Unload
		IF USED('vCompQHistory')
			USE IN vCompQHistory
		ENDIF
		
		RETURN This.nReturnKey
	ENDPROC

	PROCEDURE cmdCompanyInfo.Click
		PRIVATE cCompany
		cCompany = PrepareSQLtxt(vCompQHistory.Company,'Company',50)
		
		
		*cHyperLink = HTML_CompanyInfo(cCompany,.T.)
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_CompanyInfo(cCompany,.T.)
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
	ENDPROC

	PROCEDURE cmdReturn.Click
		IF FILE("tmpAlloy.IDX")
			DELETE FILE "tmpAlloy.IDX"
		ENDIF
		
		ThisForm.nReturnKey = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSearchAlloy.Click
		PRIVATE nBestItem, cSQL, cCompany, cAlloy
		
		SELECT vCompQHistory
		*!*	IF "TMPALLOY" $ UPPER(SET('INDEX'))
		
		*!*	ELSE
		*!*		INDEX ON Alloy tag tmpAlloy
		*!*		SET ORDER TO tag tmpAlloy
		*!*	ENDIF
		
		*!*	IF !EMPTY(ThisForm.txtAlloy.Value) 
		*!*		SEEK LEFT(ThisForm.txtAlloy.Value,12)
		*!*		SET FILTER TO Alloy = ThisForm.txtAlloy.Value
		*!*		IF FILE('Reports\CompHist.FRX')
		*!*			REPORT FORM Reports\CompHist PREVIEW
		*!*		ENDIF
		*!*	ELSE
		*!*		SET INDEX TO
		*!*	ENDIF
		cAlloy = STRTRAN(ALLTRIM(ThisForm.txtAlloy.Value),"'","''")
		cCompany = vCompQHistory.Company
		
		ThisForm.grdvCompQHistory.RecordSource = ""
		USE IN vCompQHistory
		
		IF EMPTY(cAlloy)
			cSQL="SELECT * FROM DBO.AllQuotes WHERE Company Like '%"+STRTRAN(ALLTRIM(cCompany),"'","''")+"' ORDER BY InqNum"
		
		ELSE
			cSQL="SELECT * FROM DBO.AllQuotes WHERE Company Like '%"+STRTRAN(ALLTRIM(cCompany),"'","''")+"' AND Alloy = '"+;
			cAlloy+"' ORDER BY InqNum"
		ENDIF
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'vCompQHistory')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'vCompQHistory')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "vCompQHistory")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "vCompQHistory")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			*THISFORMSET.SQLEXECError(cSQL)
			SQLExecError(cSQL,gnConnHandle, nSQLEXEC, 'vCompQHistory')
			MESSAGEBOX("Error",16,"Error")
		ENDIF
		
		ThisForm.grdvCompQHistory.RecordSource = "vCompQHistory"
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF FILE("tmpAlloy.IDX")
			DELETE FILE "tmpAlloy.IDX"
		ENDIF
		
		ThisForm.Release
		
		
		
		
	ENDPROC

	PROCEDURE grdvCompQHistory.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.nReturnKey = vCompQHistory.ID
	ENDPROC

	PROCEDURE txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, gnConnHandle)
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			IF VARTYPE(gnConnHandle) = "N"
			
				cAlloyStandard = GetAlloyStandard( pCurAlloy, gnConnHandle)
				
				IF NOT EMPTY(cAlloyStandard)
					This.Value = cAlloyStandard
					THIS.FORECOLOR = RGB(0,0,0)
					RETURN .T.
				ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
				ENDIF
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .T.	&&Need to get out of VALID check
			ENDIF	
		ENDIF
		
		
	ENDPROC

ENDDEFINE
