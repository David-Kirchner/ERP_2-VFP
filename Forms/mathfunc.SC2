 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.
		Height = 0
		Left = 0
		Name = "Dataenvironment"
		Top = 0
		Width = 0
	*</PropValue>

ENDDEFINE

DEFINE CLASS mathfunc AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="txtStart" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCalc" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtAns" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmbFromUnit" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: objectname
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		BackColor = 0,128,255
		BorderStyle = 0
		Caption = "Convert to Inches"
		Closable = .F.
		ControlBox = .F.
		DoCreate = .T.
		Height = 46
		Left = 13
		MaxButton = .F.
		MDIForm = .T.
		Name = "mathfunc"
		Top = 13
		Width = 439
	*</PropValue>

	ADD OBJECT 'cmbFromUnit' AS combobox WITH ;
		ColumnCount = 1, ;
		ColumnWidths = "68", ;
		DisplayValue = 73, ;
		FirstElement = 1, ;
		Height = 24, ;
		IncrementalSearch = .F., ;
		Left = 178, ;
		Name = "cmbFromUnit", ;
		NumberOfElements = 4, ;
		RowSource = "Foot,CM,MM,M,Gage", ;
		RowSourceType = 1, ;
		Style = 2, ;
		TabIndex = 2, ;
		Top = 12, ;
		Value = "Foot", ;
		Width = 73
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'cmdCalc' AS commandbutton WITH ;
		Caption = "Calc", ;
		Height = 25, ;
		Left = 275, ;
		Name = "cmdCalc", ;
		TabIndex = 3, ;
		TerminateRead = .T., ;
		Top = 12, ;
		Width = 59
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'txtAns' AS textbox WITH ;
		Alignment = 3, ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 356, ;
		Name = "txtAns", ;
		TabIndex = 4, ;
		Top = 12, ;
		Value = , ;
		Width = 76
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtStart' AS textbox WITH ;
		Alignment = 1, ;
		Format = "K", ;
		Height = 23, ;
		InputMask = "999999.9999", ;
		Left = 24, ;
		Name = "txtStart", ;
		TabIndex = 1, ;
		Top = 12, ;
		Value = 0, ;
		Width = 132
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETER pcObjectName
		
		IF TYPE('pcObjectName') = "U" OR TYPE('pcObjectName') = "L"
			pcObjectName=""
		ENDIF
		
		ThisForm.txtAns.Value = pcObjectName
		ThisForm.cmbFromUnit.Value="Foot"
	ENDPROC

	PROCEDURE Unload
		*RETURN This.nReturnValue
	ENDPROC

	PROCEDURE cmdCalc.Click
		PRIVATE nCalcValue 
		
		nCalcValue = 0
		
		
		DO CASE 
			CASE ThisForm.cmbFromUnit.Value = "Foot"
				nCalcValue = (ThisForm.txtStart.Value) * 12
			CASE ThisForm.cmbFromUnit.Value = "CM"
				nCalcValue = (ThisForm.txtStart.Value) * .3937
			CASE ThisForm.cmbFromUnit.Value = "MM"
				nCalcValue = (ThisForm.txtStart.Value) * .03937
			CASE ThisForm.cmbFromUnit.Value = "M"
				nCalcValue = (ThisForm.txtStart.Value) * 39.37
			CASE ThisForm.cmbFromUnit.Value = "Gage"
				DO CASE
					CASE ThisForm.txtStart.Value = 8
						nCalcValue = .172
					CASE ThisForm.txtStart.Value = 9
						nCalcValue = .156
					CASE ThisForm.txtStart.Value = 10
						nCalcValue = .141
					CASE ThisForm.txtStart.Value = 11
						nCalcValue = .125
					CASE ThisForm.txtStart.Value = 12
						nCalcValue = .109
					CASE ThisForm.txtStart.Value = 13
						nCalcValue = .094
					CASE ThisForm.txtStart.Value = 14
						nCalcValue = .078
					CASE ThisForm.txtStart.Value = 15
						nCalcValue = .070
					CASE ThisForm.txtStart.Value = 16
						nCalcValue = .063
					CASE ThisForm.txtStart.Value = 17
						nCalcValue = .056
					CASE ThisForm.txtStart.Value = 18
						nCalcValue = .050
					CASE ThisForm.txtStart.Value = 19
						nCalcValue = .044
					CASE ThisForm.txtStart.Value = 20
						nCalcValue = .038
					CASE ThisForm.txtStart.Value = 21
						nCalcValue = .034
					CASE ThisForm.txtStart.Value = 22
						nCalcValue = .031
					CASE ThisForm.txtStart.Value = 23
						nCalcValue = .028
					CASE ThisForm.txtStart.Value = 24
						nCalcValue = .025
					OTHERWISE
						wait window "Gage not Programed!"
					ENDCASE		
			Otherwise
				wait window "no Unit Choosen"
		ENDCASE
		
		pcObjectName = ThisForm.txtAns.Value
		
		debug
		set step on
		
		DO CASE 
			CASE pcObjectName = "pieces1"
			CASE pcObjectName = "THCK1"
				IF TYPE('Quotes98.Quotes.THCK1.Value')="N"
					Quotes98.Quotes.THCK1.Value = nCalcValue 
				ENDIF
				IF TYPE('HPA.Quotes98.Quotes.THCK1.Value')="N"
					HPA.Quotes98.Quotes.THCK1.Value = nCalcValue 
				ENDIF
			CASE pcObjectName = "SZ21"
				IF TYPE('Quotes98.Quotes.SZ21.Value')="N"
					Quotes98.Quotes.SZ21.Value = nCalcValue 
				ENDIF
				IF TYPE('ThisForm.Quotes.SZ21.Value')="N"
					ThisForm.Quotes.SZ21.Value = nCalcValue 
				ENDIF
			CASE pcObjectName = "SZ31"
				IF TYPE('Quotes98.Quotes.SZ31.Value')="N"
					Quotes98.Quotes.SZ31.Value = nCalcValue 
				ENDIF
		*		IF TYPE('ThisFormSet.Quotes98.Quotes.SZ31.Value')="N"
					ThisFormSet.Quotes.SZ31.Value = nCalcValue 
		*		ENDIF
			CASE pcObjectName = "WEIGHT1"
			CASE pcObjectName = "P_LB1"
			CASE pcObjectName = "P_PC1"
			CASE pcObjectName = "P_FT1"
			CASE pcObjectName = "CUTS1"
			CASE pcObjectName = "OtherP1"
			CASE pcObjectName = "LOTP1"
			
			OTHERWISE
			ThisForm.txtAns.Value = nCalcValue 
			WAIT WINDOW "No replacements, Any Key to Exit" Timeout 25
		ENDCASE	
		
		ThisForm.Release
	ENDPROC

ENDDEFINE
