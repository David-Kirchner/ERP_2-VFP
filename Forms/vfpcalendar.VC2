		*m: visible_assign
		*p: controlsource		&& Specifies the source of data to which an object is bound.
		*p: value		&& Specifies the current state of a control.
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackColor = 255,255,255
		BackStyle = 1
		controlsource = 
		Height = 24
		Name = "caldatetimepicker"
		SpecialEffect = 1
		TabStop = .T.
		value = 
		Width = 201
	*</PropValue>

	ADD OBJECT 'cmdCalendar' AS commandbutton WITH ;
		BackColor = 255,255,255, ;
		Caption = "", ;
		Height = 20, ;
		Left = 71, ;
		Name = "cmdCalendar", ;
		Picture = caldropdown.bmp, ;
		SpecialEffect = 2, ;
		TabIndex = 3, ;
		TabStop = .F., ;
		Top = 2, ;
		Width = 39
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'spnTime' AS spinner WITH ;
		BorderStyle = 0, ;
		Height = 20, ;
		KeyboardHighValue = 1, ;
		KeyboardLowValue = -1, ;
		Left = 185, ;
		Name = "spnTime", ;
		SpinnerHighValue =   1.00, ;
		SpinnerLowValue =  -1.00, ;
		TabIndex = 5, ;
		TabStop = .F., ;
		Top = 2, ;
		Width = 15
		*< END OBJECT: BaseClass="spinner" />

	ADD OBJECT 'txtDate' AS textbox WITH ;
		Alignment = 3, ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		DisabledForeColor = 0,0,0, ;
		Height = 20, ;
		Left = 1, ;
		Margin = 3, ;
		Name = "txtDate", ;
		SpecialEffect = 1, ;
		StrictDateEntry = 1, ;
		TabIndex = 1, ;
		Top = 2, ;
		Value = {}, ;
		Width = 71
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtDatetime' AS clshiddendt WITH ;
		Alignment = 3, ;
		Height = 16, ;
		Left = 78, ;
		Name = "txtDatetime", ;
		TabIndex = 2, ;
		Top = 4, ;
		Value = , ;
		Visible = .F., ;
		Width = 14
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="textbox" />

	ADD OBJECT 'txtTime' AS textbox WITH ;
		Alignment = 0, ;
		BorderStyle = 0, ;
		DisabledForeColor = 0,0,0, ;
		Format = "", ;
		Height = 20, ;
		HideSelection = .F., ;
		IMEMode = 0, ;
		InputMask = "##:##:## AA", ;
		Left = 109, ;
		Margin = 3, ;
		Name = "txtTime", ;
		SpecialEffect = 1, ;
		StrictDateEntry = 1, ;
		TabIndex = 4, ;
		Top = 2, ;
		Width = 74
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE controlsource_access
		*To do: Modify this routine for the Access method
		RETURN THIS.ControlSource
		
	ENDPROC

	PROCEDURE controlsource_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		THIS.ControlSource = m.vNewVal
		
	ENDPROC

	PROCEDURE enabled_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		this.txtdate.Enabled = m.vNewVal
		this.cmdCALENDAR.Enabled = m.vNewVal
		this.txttime.Enabled = m.vNewVal
		this.spnTIME.Enabled = m.vNewVal
		THIS.Enabled = m.vNewVal
		
	ENDPROC

	PROCEDURE Init
		IF !EMPTY(this.controlsource)
			this.txtDatetime.ControlSource = this.controlsource
		ELSE
			this.txtDatetime.value = {/:}
		ENDIF
		this.txtdate.Visible = THIS.Visible
		this.cmdCALENDAR.Visible = THIS.Visible
		this.spnTIME.Visible = THIS.Visible
		*!* Add the properties to hold the objects original dimensions
		WITH this.txtdate
			.addproperty('nOriginalwidth', .width)
			.addproperty('nOriginalFontsize', .Fontsize)
		ENDWITH
		WITH this.cmdCalendar
			.addproperty('nOriginalwidth', .width)
			.addproperty('nOriginalLeft', .left)
		ENDWITH
		WITH this.txttime
			.addproperty('nOriginalwidth', .width)
			.addproperty('nOriginalFontsize', .Fontsize)
			.addproperty('nOriginalLeft', .Left)
		ENDWITH
		WITH this.spnTime
			.addproperty('nOriginalwidth', .width)
			.addproperty('nOriginalLeft', .left)
		ENDWITH
		this.Enabled = this.Enabled
		
	ENDPROC

	PROCEDURE parsedatetime
		LOCAL cDateTime, dDateTime
		IF TYPE("this.txtdatetime.value") $ "TD"
			dDateTime = IIF(TYPE("this.txtdatetime.value") = "T", this.txtdatetime.value, DTOT(this.txtdatetime.value))
			cDateTime = TTOC(dDateTime)
			IF EMPTY(TTOD(dDateTime))
				this.txtDate.Value = {}
				IF OCCURS(":",cDateTime) > 1
					this.txtTime.Value = "  :  :   AM"
				ELSE
					this.txtTime.Value = "  :   AM"
				ENDIF
			ELSE
				this.txtDate.Value = TTOD(dDateTime)
				this.txtTime.Value = TTOC(dDateTime,2)
			ENDIF
			this.txtDate.Refresh()
			this.txtTime.Refresh()
		ENDIF
		
	ENDPROC

	PROCEDURE positioncalendar
		LPARAMETERS loCalendar
		LOCAL lnTop
		IF PCOUNT() = 0
			loCalendar = IIF(TYPE("oCalendar") = "O", oCalendar, .NULL.)
		ENDIF
		IF TYPE("loCalendar.name") = "C"
			WITH loCalendar
					lnTop = OBJTOCLIENT( THIS, 1 ) + IIF(THISFORM.TITLEBAR=1,SYSMETRIC(9),0) + THIS.txtDate.HEIGHT + ;
						IIF(THISFORM.BORDERSTYLE = 3, SYSMETRIC(4), SYSMETRIC(13)) + ;
						IIF(THISFORM.SHOWWINDOW = 2, THISFORM.TOP, OBJTOCLIENT(THISFORM, 1 )) + 2 && thanks to Vassilis Aggelakos for the Titlebar=1 fix/idea
		
					.LEFT = OBJTOCLIENT(THIS, 2) + IIF(THISFORM.BORDERSTYLE = 3, SYSMETRIC(3), SYSMETRIC(12)) + IIF(THISFORM.SHOWWINDOW = 2, THISFORM.LEFT, OBJTOCLIENT( THISFORM, 2 ))
		
					IF ((lnTop + .Height) > SYSMETRIC(2))
						lnTop = lnTop - .HEIGHT - THIS.txtDate.HEIGHT - (2 * SYSMETRIC(13)) + 4
					ENDIF
					.Top = lnTop
					.positioning = .T.
			ENDWITH
		ENDIF
		
	ENDPROC

	PROCEDURE Refresh
		this.txtDatetime.Refresh()
		this.txtDatetime.Value = this.txtDatetime.Value
		IF SET("Seconds") = "ON"
			this.txttime.InputMask = "##:##:## AM"
		ELSE
			This.txttime.InputMask = "##:## AM"
		ENDIF
		
	ENDPROC

	PROCEDURE Resize
		IF PEMSTATUS(thisform,'nOriginalwidth',5)
			#Define WIDTHRATIO thisform.Width/thisform.nOriginalwidth
			WITH this.txtdate
				.width = .nOriginalwidth * WIDTHRATIO
				.height = this.Height - 3
				.fontsize = IIF(INT(.noriginalfontsize * WIDTHRATIO) < 1, 1, INT(.noriginalfontsize * WIDTHRATIO))
			ENDWITH
			WITH this.cmdCalendar
				.width = .nOriginalwidth * WIDTHRATIO
				.height = this.Height - 2
				.Left = .nOriginalleft * WIDTHRATIO
			ENDWITH
			WITH this.txttime
				.width = .nOriginalwidth * WIDTHRATIO
				.height = this.Height - 3
				.fontsize = IIF(INT(.noriginalfontsize * WIDTHRATIO) < 1, 1, INT(.noriginalfontsize * WIDTHRATIO))
				.Left = .nOriginalleft * WIDTHRATIO
			ENDWITH
			WITH this.spnTime
				.width = .nOriginalwidth * WIDTHRATIO
				.height = this.Height - 2
				.Left = .nOriginalleft * WIDTHRATIO
			ENDWITH
		ENDIF
		
	ENDPROC

	PROCEDURE savedatetime
		this.txtDateTime.value = CTOT(DTOC(this.txtDate.Value) + SPACE(1) + this.txttime.value)
	ENDPROC

	PROCEDURE validtime
		PARAMETER cTime
		PRIVATE nOccurs, nVal, cVal
		cTime = UPPER(cTime)
		nOccurs = OCCURS(":", cTime)
		nVal = VAL(LEFT(cTime, 2))
		IF !BETWEEN(nVal, 1, 12)
			cTime = STUFF(cTime,1,2,"12")
		ELSE
			cTime = STUFF(cTime, 1, 2, RIGHT("0" + ALLTRIM(STR(nVal)), 2))
		ENDIF
		
		nVal = VAL(SUBSTR(cTime,4,2))
		IF !BETWEEN(nVal, 0, 59)
			cTime = STUFF(cTime,4,2,"00")
		ELSE
			cTime = STUFF(cTime, 4, 2, RIGHT("0" + ALLTRIM(STR(nVal)), 2))
		ENDIF
		
		DO CASE
		CASE nOccurs = 1 &&Seconds not shown handle AM/PM only
			cVal = SUBSTR(cTime,7, 1)
			IF cVal $ "AP"
				cTime = STUFF(cTime,7,2,cVal+"M")
			ELSE
				cTime = STUFF(cTime,7,2,"AM")
			ENDIF
		CASE nOccurs = 2 &&Handle seconds and AM/PM
			nVal = VAL(SUBSTR(cTime,7,2))
			IF !BETWEEN(nVal, 0, 59)
				cTime = STUFF(cTime,7,2,"00")
			ELSE
				cTime = STUFF(cTime, 7, 2, RIGHT("0" + ALLTRIM(STR(nVal)), 2))
			ENDIF
			cVal = SUBSTR(cTime,10, 1)
			IF cVal $ "AP"
				cTime = STUFF(cTime,10,2,cVal+"M")
			ELSE
				cTime = STUFF(cTime,10,2,"AM")
			ENDIF
		ENDCASE
		
		RETURN (cTime)
		
	ENDPROC

	PROCEDURE value_access
		RETURN THIS.txtDateTime.Value
		
	ENDPROC

	PROCEDURE value_assign
		LPARAMETERS vNewVal
		IF TYPE("m.vNewVal") $ "TD"
			THIS.txtdatetime.value = m.vNewVal
		ENDIF
		
	ENDPROC

	PROCEDURE visible_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		this.txtdate.Visible = m.vNewVal
		this.cmdCALENDAR.Visible = m.vNewVal
		this.spnTIME.Visible = m.vNewVal
		THIS.Visible = m.vNewVal
		
	ENDPROC

	PROCEDURE cmdCalendar.Click
		LOCAL dHoldDate
		Public dSelectedDate, oCalendar
		*!* Code below was commented out to allow for empty dates
		*!*	IF EMPTY(this.Parent.txtDate.value)
		*!*		dSelectedDate = DATE()
		*!*	ELSE
			dSelectedDate = this.Parent.txtDate.value
		*!*	ENDIF
		dHoldDate = dSelectedDate
		oCalendar = CREATEOBJECT("calCalendar",dSelectedDate)
		this.Parent.PositionCalendar(oCalendar)
		oCalendar.visible = .t.
		BINDEVENT(thisform, "moved", this.Parent, "PositionCalendar")
		READ EVENTS
		UNBINDEVENTS(thisform, "moved", this.Parent, "PositionCalendar")
		WITH this.parent
			.txtDate.Value = dSelectedDate
			.txtDate.refresh()
			.savedatetime()
			.value = .txtdatetime.value
		ENDWITH
		oCalendar = NULL
		RELEASE dSelectedDate, oCalendar
	ENDPROC

	PROCEDURE spnTime.InteractiveChange
		*!*	LOCAL nSelStart, nSelLength, cSelText
		LOCAL nAmount
		*!*	SET STEP ON 
		*!*	WITH this.Parent.txttime
		*!*		nSelLength = .SelLength
		*!*		nSelStart = .SelStart
		*!*	*!*		cSelText = .SelText
		*!*	ENDWITH
		*!*	IF nSelLength > 0
		*!*		DO case
		*!*		CASE nSelStart < 3 &&Hours
		*!*			nAmount = (this.value * 3600)		
		*!*		CASE nSelStart < 6 &&Minutes
		*!*			nAmount = (this.value * 60)		
		*!*		OTHERWISE &&Seconds
		*!*			nAmount = this.value
		*!*		ENDCASE
		*!*	ELSE
			IF SET("seconds") = "ON"
				nAmount = this.value
			ELSE
				nAmount = (this.value * 60)
			ENDIF
		*!*	ENDIF
		
		this.Parent.txtdatetime.Value = this.parent.txtdatetime.Value + nAmount
		this.Value = 0
		
	ENDPROC

	PROCEDURE txtDate.GotFocus
		ON READERROR Messagebox("The date you have entered is either" + CHR(13) + ;
								"a bad date (such as 02/31/2004 or 01/00/2004)" + CHR(13) + ;
								"or the format is incorrect (enter dates as mm/dd/yyyy).",16,"Invalid Date")
		
	ENDPROC

	PROCEDURE txtDate.Init
		*!*	IF SET("Century") = "OFF"
		*!*		this.Century= 0
		*!*	ENDIF
		
		*!*	this.StrictDateEntry = SET("strictdate")
	ENDPROC

	PROCEDURE txtDate.LostFocus
		ON READERROR
		this.Parent.Savedatetime()
		
	ENDPROC

	PROCEDURE txtDatetime.value_assign
		LPARAMETERS vNewVal
		IF DODEFAULT(vNewVal)
			this.Parent.parsedatetime()
		ENDIF
		
	ENDPROC

	PROCEDURE txtTime.Init
		IF SET("Seconds") = "ON"
			this.InputMask = "##:##:## AM"
		ELSE
			This.InputMask = "##:## AM"
		ENDIF
		
	ENDPROC

	PROCEDURE txtTime.LostFocus
		this.Value = this.parent.validtime(this.value)
		this.refresh()
		this.Parent.Savedatetime()
	ENDPROC

ENDDEFINE

DEFINE CLASS calday AS container 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="txtDay" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtOverlay" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="CALBUTTON1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: backstyle_access
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackColor = 255,255,255
		BorderWidth = 0
		Height = 25
		Name = "calday"
		Width = 25
	*</PropValue>

	ADD OBJECT 'CALBUTTON1' AS calbutton WITH ;
		Caption = "", ;
		Height = 24, ;
		Left = 0, ;
		Name = "CALBUTTON1", ;
		Style = 1, ;
		Top = 0, ;
		Width = 24
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'txtDay' AS caltextbox WITH ;
		Alignment = 2, ;
		BackStyle = 1, ;
		BorderStyle = 0, ;
		Height = 23, ;
		Left = 1, ;
		Margin = 4, ;
		Name = "txtDay", ;
		Top = 1, ;
		Width = 29
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="textbox" />

	ADD OBJECT 'txtOverlay' AS caltextbox WITH ;
		Alignment = 2, ;
		BackStyle = 0, ;
		BorderStyle = 0, ;
		FontSize = 18, ;
		ForeColor = 128,128,255, ;
		Height = 26, ;
		Left = 3, ;
		Margin = 0, ;
		MousePointer = 1, ;
		Name = "txtOverlay", ;
		Top = -3, ;
		Width = 24
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="textbox" />
	
	PROCEDURE backstyle_access
		LOCAL lcControlSource, lnDayColor, lnBackColor, lnOverlayColor, ;
			lnDayNumber, ldDate, ldDateSelected, ldDayDate, llCurrentDay
		llCurrentDay = .F.
		WITH THIS
			lcControlSource = RIGHT(ALLTRIM(.txtDay.CONTROLSOURCE),1)
			IF !EMPTY(lcControlSource)
				lnDayColor = EVALUATE("daycolor" + lcControlSource)
				lnBackColor = EVALUATE("backcolor" + lcControlSource)
				lnOverlayColor = EVALUATE("overcolor" + lcControlSource)
				lnDayNumber = VAL(EVALUATE("daynum" + lcControlSource))
				IF .txtDay.FORECOLOR != lnDayColor
					.txtDay.FORECOLOR = lnDayColor
				ENDIF
				IF .Parent.Parent.Parent.DatesMatch
					IF lnDayNumber > 0
						ldDate = .Parent.Parent.Parent.calengine1.currentdate
						ldDayDate = DATE(YEAR(ldDate), MONTH(ldDate), lnDayNumber)
						ldDateSelected = .Parent.Parent.Parent.DateSelected
						IF ldDayDate == ldDateSelected
							.txtDay.BACKCOLOR = .Parent.Parent.Parent.calengine1.HighlightColor && RGB(255,128,64)
							llCurrentDay = .T.
						ENDIF
					ENDIF
				ENDIF
				IF !llCurrentDay and .txtDay.BACKCOLOR != lnBackColor
					.txtDay.BACKCOLOR = lnBackColor
				ENDIF
				IF .txtOverlay.ForeColor != lnOverlayColor
					.txtOverlay.ForeColor = lnOverlayColor
				ENDIF
			ENDIF
			RETURN .BACKSTYLE
		ENDWITH
		*!*	RETURN This.BackStyle
	ENDPROC

	PROCEDURE CALBUTTON1.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		WITH This.Parent.Parent.Parent.Parent
			.DateSelected = DATE(YEAR(.Calengine1.Currentdate),Month(.Calengine1.Currentdate), VAL(this.Parent.txtDay.Value))
			This.Parent.Parent.Parent.Refresh()
		ENDWITH
		
	ENDPROC

	PROCEDURE CALBUTTON1.When
		RETURN ISDIGIT(this.Parent.txtDay.Value)
		
	ENDPROC

ENDDEFINE

DEFINE CLASS calengine AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: createcursor
		*m: currentdate_assign
		*m: monthfirstday
		*m: monthlastday
		*p: backcolor		&& Specifies the background color used to display text and graphics in an object.
		*p: currentdate
		*p: daycolor
		*p: highlightcolor
		*p: monthcursor
		*p: overlaycolor
		*p: weekdayscolor
	*</DefinedPropArrayMethod>

	*<PropValue>
		backcolor = 16777215
		currentdate = {}
		daycolor = 0
		Height = 17
		highlightcolor = 4227327
		monthcursor = 
		Name = "calengine"
		overlaycolor = 16744576
		weekdayscolor = 16744576
		Width = 18
	*</PropValue>
	
	PROCEDURE createcursor
		LPARAMETERS vNewVal
		LOCAL lnCounter, lnDayCounter, lcFields, lcSafetyWas, ;
			lcDayNum, lcOverlay, lcDayColor, lcBackColor, lnDayofWeek, ;
			lnTotalDays, lcHoldRecSource, lcGridSourceWas, lnO, lnW, lnB
		
		WITH THIS
			IF USED(.monthcursor)
				lcSafetyWas = SET("Safety")
				SET SAFETY OFF
				ZAP IN (.monthcursor)
				SET SAFETY &lcSafetyWas
			ELSE
				.monthcursor = Sys(2015)
				CREATE CURSOR (.monthcursor) (daynum1 c(2), daynum2 c(2), daynum3 c(2), daynum4 c(2), daynum5 c(2), daynum6 c(2), daynum7 c(2), ;
					overlay1 c(1), overlay2 c(1), overlay3 c(1), overlay4 c(1), overlay5 c(1), overlay6 c(1), overlay7 c(1), ;
					overcolor1 i, overcolor2 i, overcolor3 i, overcolor4 i, overcolor5 i, overcolor6 i, overcolor7 i, ;
					daycolor1 i, daycolor2 i, daycolor3 i, daycolor4 i, daycolor5 i, daycolor6 i, daycolor7 i, ;
					backcolor1 i, backcolor2 i, backcolor3 i, backcolor4 i, backcolor5 i, backcolor6 i, backcolor7 i)
			ENDIF
		
			lcFields = "daynum1, daynum2, daynum3, daynum4, daynum5, daynum6, daynum7, " + ;
				"overlay1, overlay2, overlay3, overlay4, overlay5, overlay6, overlay7, " + ;
				"overcolor1, overcolor2, overcolor3, overcolor4, overcolor5, overcolor6, overcolor7, " + ;
				"daycolor1, daycolor2, daycolor3, daycolor4, daycolor5, daycolor6, daycolor7, " + ;
				"backcolor1, backcolor2, backcolor3, backcolor4, backcolor5, backcolor6, backcolor7"
			lnO = .overlaycolor
			lnW = .weekdayscolor
			lnB = .BACKCOLOR
			INSERT INTO (.monthcursor) (&lcFields) ;
				VALUES ("S", "M", "T", "W", "T", "F", "S", ;
				"", "", "", "", "", "", "", ;
				lnO, lnO, lnO, lnO, lnO, lnO, lnO, ;
				lnW, lnW, lnW, lnW, lnW, lnW, lnW, ;
				lnB, lnB, lnB, lnB, lnB, lnB, lnB)
		
			lnDayofWeek = -(DOW(.monthfirstday(m.vNewVal))) + 1
			lnTotalDays = DAY(.monthlastday(m.vNewVal))
		
			FOR lnCounter = 1 TO 7
				lcDayNum = ""
				lcOverlay = ""
				lcOverlayColor = ""
				lcDayColor = ""
				lcBackColor = ""
				FOR lnDayCounter = 1 TO 7
					lnDayofWeek = lnDayofWeek + 1
					IF BETWEEN(lnDayofWeek, 1, lnTotalDays)
						lcDayNum = lcDayNum + "'"+ALLTRIM(STR(lnDayofWeek))+"',"
						lcOverlay = lcOverlay + "'',"
						lcOverlayColor = lcOverlayColor + "lnO,"
						lcDayColor = lcDayColor + ".daycolor," && ALLTRIM(STR(INT(4 * RAND( )))) + "," && 0 = Default; 1 = Shaded; 2 = X; 3 = Shaded and X
						lcBackColor = lcBackColor + "lnB,"
					ELSE
						lcDayNum = lcDayNum + "'',"
						lcOverlay = lcOverlay + "'',"
						lcOverlayColor = lcOverlayColor + "lnO,"
						lcDayColor = lcDayColor + ".daycolor,"
						lcBackColor = lcBackColor + "lnB,"
					ENDIF
				ENDFOR
				lcBackColor = LEFT(lcBackColor,LEN(lcBackColor) - 1)
				INSERT INTO (.monthcursor) (&lcFields) ;
					VALUES (&lcDayNum &lcOverlay &lcOverlayColor &lcDayColor &lcBackColor)
			ENDFOR
		
			GO TOP IN (.monthcursor)
		
		ENDWITH
		
	ENDPROC

	PROCEDURE currentdate_assign
		LPARAMETERS vNewVal
		*!*	IF m.vNewVal != This.Currentdate
		*!*		SET STEP ON
			THIS.CurrentDate = m.vNewVal
			This.CreateCursor(m.vNewVal)
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE Destroy
		LOCAL lcAliasWas
		*!* Thanks to Hernan E. Delgado for pointing out that the
		*!* temporary cursor was not being released
		IF USED(this.monthcursor)
			m.lcAliasWas = ALIAS()
			USE IN SELECT(this.monthcursor)
			IF USED(m.lcAliasWas)
				SELECT (m.lcAliasWas)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE monthfirstday
		LPARAMETERS tcDate
		DO CASE
		CASE TYPE("tcDate") = "T"
			tcDate = TTOD(tcDate)
		CASE TYPE("tcDate") != "D"
			tcDate = This.Currentdate
		ENDCASE
		RETURN (tcdate - DAY(tcDate) + 1)
	ENDPROC

	PROCEDURE monthlastday
		LPARAMETERS tcDate
		RETURN (GOMONTH(this.monthfirstday(tcdate),1)-1)
	ENDPROC

ENDDEFINE

