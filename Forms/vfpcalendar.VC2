DEFINE CLASS caldatepicker AS control 
 	*< CLASSDATA: Baseclass="control" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="txtDate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCalendar" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: controlsource_access
		*m: controlsource_assign
		*m: enabled_assign
		*m: interactivechange		&& Occurs when the user changes the value of a control using the keyboard or the mouse.
		*m: positioncalendar
		*m: value_access
		*m: value_assign
		*m: visible_assign
		*p: controlsource		&& Specifies the source of data to which an object is bound.
		*p: isagodatebox
		*p: value		&& Specifies the current state of a control.
		*p: wasdate
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackColor = 255,255,255
		BackStyle = 0
		controlsource = 
		Height = 24
		Name = "caldatepicker"
		SpecialEffect = 1
		TabStop = .T.
		value = {}
		wasdate = {}
		Width = 112
	*</PropValue>

	ADD OBJECT 'cmdCalendar' AS commandbutton WITH ;
		BackColor = 255,255,255, ;
		Caption = "", ;
		Height = 20, ;
		Left = 71, ;
		Name = "cmdCalendar", ;
		Picture = caldropdown.bmp, ;
		SpecialEffect = 2, ;
		TabIndex = 2, ;
		TabStop = .F., ;
		Top = 1, ;
		Width = 39
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'txtDate' AS textbox WITH ;
		Alignment = 3, ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		DisabledForeColor = 0,0,0, ;
		Height = 20, ;
		Left = 1, ;
		Margin = 3, ;
		MaxLength = 0, ;
		Name = "txtDate", ;
		SpecialEffect = 1, ;
		StrictDateEntry = 1, ;
		TabIndex = 1, ;
		Top = 1, ;
		Value = {}, ;
		Width = 71
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE controlsource_access
		*To do: Modify this routine for the Access method
		RETURN THIS.ControlSource
		
	ENDPROC

	PROCEDURE controlsource_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		THIS.ControlSource = m.vNewVal
		
	ENDPROC

	PROCEDURE enabled_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		this.txtdate.Enabled = m.vNewVal
		this.cmdCALENDAR.Enabled = m.vNewVal
		THIS.Enabled = m.vNewVal
		
	ENDPROC

	PROCEDURE Init
		IF !EMPTY(this.controlsource)
			this.txtDate.ControlSource = this.controlsource
		ELSE
			this.txtDate.value = {}
		ENDIF
		this.txtDate.visible = THIS.Visible
		this.cmdCALENDAR.visible = THIS.Visible
		*!* Add the properties to hold the objects original dimensions
		WITH this.txtdate
			.addproperty('nOriginalwidth', .width)
			.addproperty('nOriginalFontsize', .Fontsize)
		ENDWITH
		WITH this.cmdCalendar
			.addproperty('nOriginalwidth', .width)
			.addproperty('nOriginalLeft', .left)
		ENDWITH
		this.Enabled = this.Enabled
	ENDPROC

	PROCEDURE interactivechange		&& Occurs when the user changes the value of a control using the keyboard or the mouse.
		IF this.isagodatebox
			IF !EMPTY(this.txtDate.Value)
				IF TYPE("this.Parent.cmdGoDate") = "O"
					this.Parent.cmdGoDate.click()
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE positioncalendar
		LPARAMETERS loCalendar
		LOCAL lnTop
		IF PCOUNT() = 0
			loCalendar = IIF(TYPE("oCalendar") = "O", oCalendar, .NULL.)
		ENDIF
		
		IF TYPE("loCalendar.name") = "C"
			WITH loCalendar
					lnTop = OBJTOCLIENT( THIS, 1 ) + IIF(THISFORM.TITLEBAR=1,SYSMETRIC(9),0) + THIS.txtDate.HEIGHT + ;
						IIF(THISFORM.BORDERSTYLE = 3, SYSMETRIC(4), SYSMETRIC(13)) + ;
						IIF(THISFORM.SHOWWINDOW = 2, THISFORM.TOP, OBJTOCLIENT(THISFORM, 1 )) + 1 && thanks to Vassilis Aggelakos for the Titlebar=1 fix/idea
		
					.LEFT = OBJTOCLIENT(THIS, 2) + IIF(THISFORM.BORDERSTYLE = 3, SYSMETRIC(3), SYSMETRIC(12)) + IIF(THISFORM.SHOWWINDOW = 2, THISFORM.LEFT, OBJTOCLIENT( THISFORM, 2 ))
		
					IF ((lnTop + .Height) > SYSMETRIC(2))
						lnTop = lnTop - .HEIGHT - THIS.txtDate.HEIGHT - (2 * SYSMETRIC(13)) + 4
					ENDIF
					.Top = lnTop
					.positioning = .T.
			ENDWITH
		ENDIF
		
	ENDPROC

	PROCEDURE Refresh
		this.txtDate.Refresh()
	ENDPROC

	PROCEDURE Resize
		IF PEMSTATUS(thisform,'nOriginalwidth',5)
			#Define WIDTHRATIO thisform.Width/thisform.nOriginalwidth
			WITH this.txtdate
				.width = .nOriginalwidth * WIDTHRATIO
				.height = this.Height - 3
				.fontsize = IIF(INT(.noriginalfontsize * WIDTHRATIO) < 1, 1, INT(.noriginalfontsize * WIDTHRATIO))
			ENDWITH
			WITH this.cmdCalendar
				.width = .nOriginalwidth * WIDTHRATIO
				.height = this.Height - 2
				.Left = .nOriginalleft * WIDTHRATIO
			ENDWITH
		ENDIF
		
	ENDPROC

	PROCEDURE value_access
		RETURN THIS.txtDate.Value
		
	ENDPROC

	PROCEDURE value_assign
		LPARAMETERS vNewVal
		THIS.txtDate.value = m.vNewVal
		
	ENDPROC

	PROCEDURE visible_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		this.txtdate.Visible = m.vNewVal
		this.cmdCALENDAR.Visible = m.vNewVal
		THIS.Visible = m.vNewVal
		
	ENDPROC

	PROCEDURE cmdCalendar.Click
		LOCAL dHoldDate
		Public dSelectedDate, oCalendar
		*!* Code below was commented out to allow for empty dates
		*!*	IF EMPTY(this.Parent.txtDate.value)
		*!*		dSelectedDate = DATE()
		*!*	ELSE
			dSelectedDate = this.Parent.txtDate.value
		*!*	ENDIF
		oCalendar = CREATEOBJECT("calCalendar", dSelectedDate)
		this.Parent.PositionCalendar(oCalendar)
		oCalendar.visible = .t.
		BINDEVENT(thisform, "moved", this.Parent, "PositionCalendar")
		READ EVENTS
		UNBINDEVENTS(thisform, "moved", this.Parent, "PositionCalendar")
		*!*	IF dHoldDate != dSelectedDate
			WITH this.parent
				dHoldDate = .txtDate.Value
				.txtDate.Value = dSelectedDate
				.txtDate.refresh()
				IF dHoldDate != dSelectedDate
					this.parent.interactiveChange()
				ENDIF
			ENDWITH
		*!*	ENDIF
		oCalendar = NULL
		RELEASE dSelectedDate, oCalendar
		
	ENDPROC

	PROCEDURE txtDate.GotFocus
		ON READERROR Messagebox("The date you have entered is either" + CHR(13) + ;
								"a bad date (such as 02/31/2004 or 01/00/2004)" + CHR(13) + ;
								"or the format is incorrect (enter dates as mm/dd/yyyy).",16,"Invalid Date")
		this.Parent.wasdate = this.Value
		
	ENDPROC

	PROCEDURE txtDate.LostFocus
		ON READERROR
		IF this.Parent.wasdate != this.Value
			this.Parent.interactiveChange()
		ENDIF
	ENDPROC

ENDDEFINE

DEFINE CLASS caldatetimepicker AS control 
 	*< CLASSDATA: Baseclass="control" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="txtTime" UniqueID="" Timestamp="" />
