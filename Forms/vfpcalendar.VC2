		Name = "Calday1", ;
		Top = 22, ;
		txtDay.Name = "txtDay", ;
		txtOverlay.Name = "txtOverlay", ;
		CALBUTTON1.Name = "CALBUTTON1"
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="container" />

	ADD OBJECT 'Calgrid1.Column7.Header1' AS header WITH ;
		Caption = "Header1", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'Calmonthmover1' AS calmonthmover WITH ;
		BorderColor = 255,255,255, ;
		BorderWidth = 0, ;
		Height = 29, ;
		Left = 0, ;
		Name = "Calmonthmover1", ;
		Top = 0, ;
		Width = 176, ;
		txtDateCaption.Name = "txtDateCaption", ;
		Calxpbutton1.Calimage1.Height = 20, ;
		Calxpbutton1.Calimage1.Name = "Calimage1", ;
		Calxpbutton1.Calimage1.Width = 20, ;
		Calxpbutton1.Name = "Calxpbutton1", ;
		Calxpbutton2.Calimage1.Height = 20, ;
		Calxpbutton2.Calimage1.Name = "Calimage1", ;
		Calxpbutton2.Calimage1.Width = 20, ;
		Calxpbutton2.Name = "Calxpbutton2"
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="container" />

	ADD OBJECT 'Line1' AS line WITH ;
		BorderColor = 128,128,255, ;
		Height = 0, ;
		Left = 4, ;
		Name = "Line1", ;
		Top = 27, ;
		Width = 166
		*< END OBJECT: BaseClass="line" />
	
	PROCEDURE dateselected_assign
		LPARAMETERS vNewVal
		
		IF MONTH(m.vNewVal) == MONTH(This.calengine1.currentdate) ;
			AND YEAR(m.vNewVal) == YEAR(This.calengine1.currentdate)
			THIS.DatesMatch = .T.
		ELSE
			This.DatesMatch = .F.
		ENDIF
		
		THIS.DateSelected = m.vNewVal
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tdDate
		IF !THIS.DelayedInitialization && thanks to Vassilis Aggelakos for this fix/idea
			THIS.SETUP(tdDate)
		ENDIF
		
	ENDPROC

	PROCEDURE setcolors
		WITH THIS
			.calengine1.BACKCOLOR = .calendarbackcolor
			.calengine1.overlaycolor = .overlayforecolor
			.calengine1.weekdayscolor = .daysoftheweekforecolor
			.calengine1.HighlightColor = .HighlightColor
			.BACKCOLOR = .calendarbackcolor
			.calgrid1.BACKCOLOR = .calendarbackcolor
			.calmonthmover1.BACKCOLOR = .calendarbackcolor
			.calmonthmover1.txtDateCaption.BACKCOLOR = .calendarbackcolor
			.calmonthmover1.calxpbutton1.BACKCOLOR = .calendarbackcolor
			.calmonthmover1.calxpbutton2.BACKCOLOR = .calendarbackcolor
			.calmonthmover1.HighlightColor = .HighlightColor
			.calmonthmover1.txtDateCaption.ForeColor = .captionforecolor
			.line1.BorderColor = .captionforecolor
		ENDWITH
		
	ENDPROC

	PROCEDURE setup
		LPARAMETERS tdDate
		THIS.InitIsRunning = .T.
		DO CASE
			CASE TYPE("tdDate") = "T"
				tdDate = TTOD(tdDate)
			CASE TYPE("tdDate") != "D"
				tdDate = {} && DATE()
		ENDCASE
		WITH THIS
			.Setcolors()
			.calengine1.currentdate = IIF(EMPTY(tdDate), DATE(), tdDate)
			.Dateselected = tdDate
			.Datesmatch = .T.
			.calmonthmover1.GRID = .calgrid1
			.calmonthmover1.calengine = .calengine1
			.SetupGrid()
			.REFRESH()
		ENDWITH
		THIS.InitIsRunning = .F.
		
	ENDPROC

	PROCEDURE setupgrid
		WITH this.Calgrid1
			.RecordSource = this.calengine1.monthcursor
			.setall("Sparse", .F., "Column")
			.column1.calday1.txtDay.ControlSource = "daynum1"
			.column2.calday1.txtDay.ControlSource = "daynum2"
			.column3.calday1.txtDay.ControlSource = "daynum3"
			.column4.calday1.txtDay.ControlSource = "daynum4"
			.column5.calday1.txtDay.ControlSource = "daynum5"
			.column6.calday1.txtDay.ControlSource = "daynum6"
			.column7.calday1.txtDay.ControlSource = "daynum7"
			.column1.calday1.txtOverlay.ControlSource = "overlay1"
			.column2.calday1.txtOverlay.ControlSource = "overlay2"
			.column3.calday1.txtOverlay.ControlSource = "overlay3"
			.column4.calday1.txtOverlay.ControlSource = "overlay4"
			.column5.calday1.txtOverlay.ControlSource = "overlay5"
			.column6.calday1.txtOverlay.ControlSource = "overlay6"
			.column7.calday1.txtOverlay.ControlSource = "overlay7"
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS calmonthmover AS container 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="txtDateCaption" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Calxpbutton1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Calxpbutton2" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: calengine_assign
		*m: setcaption
		*m: showmovers_assign
		*p: calengine
		*p: grid
		*p: highlightcolor
		*p: movertype		&& 1 = Day, 2 = Month, 3 = Year
		*p: showmovers
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackColor = 255,255,255
		BorderWidth = 0
		calengine = .NULL.
		grid = .NULL.
		Height = 28
		highlightcolor = 4227327
		movertype = 2
		Name = "calmonthmover"
		showmovers = .T.
		Width = 175
	*</PropValue>

	ADD OBJECT 'Calxpbutton1' AS calxpbutton WITH ;
		Left = 2, ;
		Name = "Calxpbutton1", ;
		Top = 3, ;
		Visible = .F., ;
		Calimage1.Height = 19, ;
		Calimage1.Left = 3, ;
		Calimage1.Name = "Calimage1", ;
		Calimage1.Top = 0, ;
		Calimage1.Width = 20
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="container" />

	ADD OBJECT 'Calxpbutton2' AS calxpbutton WITH ;
		Left = 144, ;
		Name = "Calxpbutton2", ;
		Top = 3, ;
		Visible = .F., ;
		Calimage1.Height = 19, ;
		Calimage1.Left = 6, ;
		Calimage1.Name = "Calimage1", ;
		Calimage1.Picture = (HOME(1) + "wizards\wizbmps\wznext.bmp"), ;
		Calimage1.Top = 0, ;
		Calimage1.Width = 17
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="container" />

	ADD OBJECT 'txtDateCaption' AS caltextbox WITH ;
		Alignment = 2, ;
		BackStyle = 1, ;
		BorderStyle = 0, ;
		FontBold = .T., ;
		ForeColor = 128,128,255, ;
		Height = 24, ;
		Left = -1, ;
		Margin = 4, ;
		MousePointer = 1, ;
		Name = "txtDateCaption", ;
		Top = 2, ;
		Width = 177
		*< END OBJECT: ClassLib="vfpcalendar.vcx" BaseClass="textbox" />
	
	PROCEDURE calengine_assign
		LPARAMETERS vNewVal
		THIS.calengine = m.vNewVal
		This.SetCaption()
		
	ENDPROC

	PROCEDURE Destroy
		STORE .NULL. TO this.grid, this.calengine
	ENDPROC

	PROCEDURE Init
		This.showmovers = This.showmovers
	ENDPROC

	PROCEDURE setcaption
		LOCAL ldDate, lcRecordSource
		WITH This
			ldDate = IIF(ISNULL(.calengine), DATE(), .Calengine.CurrentDate)
			DO CASE 
			CASE .movertype = 1 && Day
				.txtDateCaption.Value = DTOS(ldDate)
			CASE .movertype = 2 && Month
				.txtDateCaption.Value = CMONTH(ldDate) + " " + ALLTRIM(STR(YEAR(ldDate)))
			CASE .movertype = 3 && Year
				.txtDateCaption.Value = ALLTRIM(STR(YEAR(ldDate)))
			ENDCASE
			.txtDateCaption.refresh()
			IF !ISNULL(.grid)
				.Grid.Refresh()
				.Grid.Recordsource = .Grid.Recordsource
			ENDIF
		ENDWITH
	ENDPROC

	PROCEDURE showmovers_assign
		LPARAMETERS vNewVal
		This.calxpbutton1.Visible = m.vNewVal
		This.calxpbutton2.Visible = m.vNewVal
		THIS.showmovers = m.vNewVal
		
	ENDPROC

	PROCEDURE Calxpbutton1.Click
		WITH THIS.PARENT
			DO CASE
				CASE .movertype = 1 && Day
					.PARENT.calengine1.currentdate = .PARENT.calengine1.currentdate - 1
				CASE .movertype = 2 && Month
					.PARENT.calengine1.currentdate = GOMONTH(.PARENT.calengine1.currentdate, -1)
				CASE .movertype = 3 && Year
					.PARENT.calengine1.currentdate = GOMONTH(.PARENT.calengine1.currentdate, -12)
			ENDCASE
			.setcaption()
		ENDWITH
		
	ENDPROC

	PROCEDURE Calxpbutton2.Click
		WITH THIS.PARENT
			DO CASE
				CASE .movertype = 1 && Day
					.PARENT.calengine1.currentdate = .PARENT.calengine1.currentdate + 1
				CASE .movertype = 2 && Month
					.PARENT.calengine1.currentdate = GOMONTH(.PARENT.calengine1.currentdate, 1)
				CASE .movertype = 3 && Year
					.PARENT.calengine1.currentdate = GOMONTH(.PARENT.calengine1.currentdate, 12)
			ENDCASE
			.setcaption()
		ENDWITH
		
	ENDPROC

ENDDEFINE

