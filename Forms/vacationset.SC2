DEFINE CLASS frmaddvacdate AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblEmployee" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblReason" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmbReason" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblHours" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtEmployee" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDay" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtHours" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: creturnkey
		*p: nconnhandle
		*p: nvacationid
		*p: openedvacation
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth-globe.ico
		AlwaysOnTop = .T.
		AutoCenter = .T.
		Caption = "Add / Edit vacation Date"
		creturnkey = ""
		DoCreate = .T.
		Height = 192
		LockScreen = .F.
		MDIForm = .T.
		Name = "frmAddVacDate"
		Width = 256
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmbReason' AS combobox WITH ;
		ColumnCount = 0, ;
		ColumnWidths = "", ;
		FirstElement = 1, ;
		Height = 24, ;
		Left = 96, ;
		Name = "cmbReason", ;
		NumberOfElements = 0, ;
		RowSource = "Vacation,Sick,Personal", ;
		RowSourceType = 1, ;
		Top = 84, ;
		Value = Vacation, ;
		Width = 100
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		Caption = "\<Cancel", ;
		Height = 27, ;
		Left = 144, ;
		Name = "cmdCancel", ;
		TabIndex = 8, ;
		ToolTipText = '"Leave the SHIP program"', ;
		Top = 156, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSave' AS commandbutton WITH ;
		Caption = "\<Save", ;
		Height = 27, ;
		Left = 24, ;
		Name = "cmdSave", ;
		TabIndex = 7, ;
		ToolTipText = '"Leave the SHIP program"', ;
		Top = 156, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label2' AS label WITH ;
		Alignment = 1, ;
		AutoSize = .F., ;
		Caption = "Day", ;
		Height = 17, ;
		Left = 24, ;
		Name = "Label2", ;
		Top = 48, ;
		Width = 57
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblEmployee' AS label WITH ;
		Alignment = 1, ;
		AutoSize = .F., ;
		Caption = "Employee", ;
		Height = 17, ;
		Left = 24, ;
		Name = "lblEmployee", ;
		Top = 12, ;
		Width = 57
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblHours' AS label WITH ;
		Alignment = 1, ;
		AutoSize = .F., ;
		Caption = "Hours", ;
		Height = 17, ;
		Left = 24, ;
		Name = "lblHours", ;
		Top = 120, ;
		Width = 57
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblReason' AS label WITH ;
		Alignment = 1, ;
		AutoSize = .F., ;
		Caption = "Reason", ;
		Height = 17, ;
		Left = 24, ;
		Name = "lblReason", ;
		Top = 84, ;
		Width = 57
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'txtDay' AS textbox WITH ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 96, ;
		Name = "txtDay", ;
		Top = 48, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtEmployee' AS textbox WITH ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 96, ;
		Name = "txtEmployee", ;
		Top = 12, ;
		Width = 144
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtHours' AS textbox WITH ;
		ControlSource = "", ;
		Format = "9", ;
		Height = 23, ;
		Left = 96, ;
		Name = "txtHours", ;
		Top = 120, ;
		Width = 24
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		*!*	IF USED('tmpQuotes')
		*!*		USE IN tmpQuotes
		*!*	ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pnVacationID, pcDisplayName, pdVacationDate
		
		IF TYPE("pnVacationID")= "N"
			ThisForm.nVacationID = pnVacationID
		ELSE
			MESSAGEBOX("No Vacation ID passed to AddVacDate",0,"Bad parameter")
			RETURN TO MASTER
		ENDIF
		
		IF TYPE("pcDisplayName") = "C"
			ThisForm.txtEmployee.Value = pcDisplayName
		ENDIF
		
		IF TYPE("pdVacationDate") = "D"
			ThisForm.txtDay.Value = DTOC( pdVacationDate )
		ENDIF
		
		ThisForm.cmbReason.Value = "Vacation"
		ThisForm.txtHours.Value = 8
		
		
	ENDPROC

	PROCEDURE Load
		*!*	PRIVATE nConnHandle,cSQL,nSQLExec
		
		
		*!*	IF nSQLEXEC < 1
		*!*		*THISFORMSET.SQLEXECError(gcSQL)
		*!*	ENDIF
		*!*		
		*!*	ThisForm.nConnHandle = nConnHandle
		*!*		
		
		IF !USED("Vacation")
			USE HPA!Vacation IN 0
			ThisForm.OpenedVacation = .T.
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.OpenedVacation
			IF USED("Vacation")
				USE IN Vacation
			ENDIF
		ENDIF
		
		*RETURN This.cReturnKey
	ENDPROC

	PROCEDURE cmdCancel.Click
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE lcDisplayName, ldVacationDate, lcVacaType, lcReason, lnHours
		
		*ThisForm.nVacationID
		lcDisplayName =	ThisForm.txtEmployee.Value
		ldVacationDate = CTOD( ThisForm.txtDay.Value )
		lcReason = ThisForm.cmbReason.Value 
		lnHours = ThisForm.txtHours.Value 
		
		DO CASE 
		CASE lcReason = "Vacation"
			lcVacaType = "V"
		CASE lcReason = "Sick"
			lcVacaType = "S"
		CASE lcReason = "Personal"
			lcVacaType = "P"
		OTHERWISE
			lcVacaType = "."
		ENDCASE
		
		INSERT INTO HPA!Vacation ( ID, VacaType, DispName, VacaDate,  Hours );
		 VALUES (ThisForm.nVacationID, lcVacaType, lcDisplayName, ldVacationDate,  lnHours )
		
		ThisForm.Release
	ENDPROC

ENDDEFINE
