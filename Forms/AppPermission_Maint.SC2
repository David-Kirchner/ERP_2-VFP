		Left = 12, ;
		Name = "cmdAll", ;
		Top = 458, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdClose' AS commandbutton WITH ;
		Cancel = .T., ;
		Caption = "Close", ;
		Height = 27, ;
		Left = 560, ;
		Name = "cmdClose", ;
		Top = 458, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdNewUser' AS commandbutton WITH ;
