DEFINE CLASS frmapppermission_maint AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="lblUser" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cboUser" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdNewUser" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm.clmDisplay.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm.clmDisplay.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm.clmCategory.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm.clmCategory.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm.clmGranted.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm.clmGranted.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdPerm.clmGranted.chkGranted" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdNone" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdClose" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: cselecteduser
		*p: lhasappusergrant
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		Caption = "Program Permissions (AppSetup PRP=YES)"
		cselecteduser = ""
		DoCreate = .T.
		Height = 520
		Icon = graphics\earth-globe.ico
		lhasappusergrant = .F.
		Name = "frmAppPermission_maint"
		nconnhandle = 0
		Width = 680
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cboUser' AS combobox WITH ;
		BoundColumn = 1, ;
		Height = 24, ;
		Left = 82, ;
		Name = "cboUser", ;
