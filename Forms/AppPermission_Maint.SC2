	ADD OBJECT 'cmdReload' AS commandbutton WITH ;
		Caption = "Reload", ;
		Height = 27, ;
		Left = 200, ;
		Name = "cmdReload", ;
		Top = 458, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSave' AS commandbutton WITH ;
		Caption = "Save", ;
		Height = 27, ;
		Left = 380, ;
		Name = "cmdSave", ;
		Top = 458, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdPerm' AS grid WITH ;
		ColumnCount = 3, ;
		DeleteMark = .F., ;
		Height = 400, ;
		Left = 12, ;
		Name = "grdPerm", ;
		RecordMark = .F., ;
		RecordSource = "", ;
		ScrollBars = 3, ;
		Top = 48, ;
		Width = 652, ;
		Column1.ControlSource = "", ;
		Column1.Name = "clmDisplay", ;
		Column1.ReadOnly = .T., ;
		Column1.Width = 300, ;
		Column2.ControlSource = "", ;
		Column2.Name = "clmCategory", ;
		Column2.ReadOnly = .T., ;
		Column2.Width = 120, ;
		Column3.ControlSource = "", ;
		Column3.CurrentControl = "chkGranted", ;
		Column3.Name = "clmGranted", ;
		Column3.ReadOnly = .F., ;
		Column3.Sparse = .F., ;
		Column3.Width = 70
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grdPerm.clmCategory.Header1' AS header WITH ;
		Caption = "Category", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdPerm.clmCategory.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdPerm.clmDisplay.Header1' AS header WITH ;
		Caption = "Permission", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdPerm.clmDisplay.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdPerm.clmGranted.chkGranted' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "", ;
		Name = "chkGranted", ;
		ReadOnly = .F.
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'grdPerm.clmGranted.Header1' AS header WITH ;
		Caption = "Granted", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdPerm.clmGranted.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
		ReadOnly = .T., ;
		Visible = .F.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'lblUser' AS label WITH ;
		Caption = "User (UN):", ;
		Height = 17, ;
		Left = 12, ;
		Name = "lblUser", ;
		Top = 14, ;
		Width = 70
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE ConfigureGrid
		WITH This.grdPerm
			.clmDisplay.ControlSource = "csrPerm.display"
			.clmCategory.ControlSource = "csrPerm.category"
			WITH .clmGranted
				.ControlSource = "granted"
				.Sparse = .F.
				.ReadOnly = .F.
				.CurrentControl = "chkGranted"
				.Text1.Visible = .F.
				.chkGranted.Caption = ""
			ENDWITH
		ENDWITH
	ENDPROC

	PROCEDURE Destroy
		IF USED("csrPerm")
			USE IN csrPerm
		ENDIF
		IF USED("csrUsers")
			USE IN csrUsers
		ENDIF
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
	ENDPROC

	PROCEDURE EnsureAppPermissionCode
		LPARAMETERS tcCode, tcDisplay, tcCategory
		LOCAL lcSQL
		IF NOT This.lHasAppUserGrant
			RETURN
		ENDIF
		IF EMPTY(ALLTRIM(tcCode))
			RETURN
		ENDIF
		IF EMPTY(ALLTRIM(tcDisplay))
			tcDisplay = tcCode
		ENDIF
		IF EMPTY(ALLTRIM(tcCategory))
			tcCategory = "General"
		ENDIF
		lcSQL = "IF NOT EXISTS (SELECT 1 FROM dbo.AppPermission WHERE PermissionCode = "
		lcSQL = lcSQL + AppPermission_SQLQuote(tcCode)+") "
		lcSQL = lcSQL + "INSERT INTO dbo.AppPermission (PermissionCode, DisplayName, Category, SortOrder) "
		lcSQL = lcSQL + "VALUES ("+AppPermission_SQLQuote(tcCode)+", "
		lcSQL = lcSQL + AppPermission_SQLQuote(tcDisplay)+", "
		lcSQL = lcSQL + AppPermission_SQLQuote(tcCategory)+", 999)"
		SQLEXEC(This.nConnHandle, lcSQL)
	ENDPROC

	PROCEDURE EnsurePermCursor
		IF USED("csrPerm")
			IF TYPE("csrPerm.grantTxt") # "C" OR TYPE("csrPerm.granted") # "L"
				USE IN csrPerm
			ENDIF
		ENDIF
		IF NOT USED("csrPerm")
			CREATE CURSOR csrPerm (permcode C(80), display C(120), category C(50), granted L, grantTxt C(5))
		ENDIF
	ENDPROC

	PROCEDURE Init
		This.EnsurePermCursor()
		This.nConnHandle = get_SQLSTRINGCONNECT()
		This.lHasAppUserGrant = This.TableExists("AppUserGrant")
		This.LoadUserList()
		This.LoadPermissionCatalog()
		This.grdPerm.RecordSource = "csrPerm"
		This.ConfigureGrid()
		IF This.cboUser.ListCount > 0
			This.cboUser.ListIndex = 1
			This.cSelectedUser = ALLTRIM(This.cboUser.Value)
			This.LoadUserGrants()
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		SET PROCEDURE TO PROGS\AppPermission_maint ADDITIVE
		This.EnsurePermCursor()
	ENDPROC

	PROCEDURE LoadPermissionCatalog
		LOCAL lcSQL, lnRet, lcCode, lcDisp, lcCat
		This.EnsurePermCursor()
		SELECT csrPerm
		ZAP
		lcSQL = "SELECT PermissionCode, DisplayName, Category "
		lcSQL = lcSQL + "FROM dbo.AppPermission WITH (NOLOCK) "
		lcSQL = lcSQL + "WHERE Active = 1 "
		lcSQL = lcSQL + "ORDER BY SortOrder, PermissionCode"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpAppPermCat")
		IF lnRet < 1
			lcSQL = "SELECT DISTINCT LTRIM(RTRIM(ANS)) AS PermissionCode "
			lcSQL = lcSQL + "FROM dbo.AppSetup WITH (NOLOCK) "
			lcSQL = lcSQL + "WHERE UPPER(LTRIM(RTRIM(PRP))) = 'YES' "
			lcSQL = lcSQL + "AND LTRIM(RTRIM(ISNULL(ANS,''))) <> '' "
			lcSQL = lcSQL + "ORDER BY PermissionCode"
			lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpAppPermCat")
			IF NOT This.SqlOk(lnRet, lcSQL)
				MESSAGEBOX("Could not load permission list from SQL.", 48, "App Permissions")
				RETURN
			ENDIF
		ENDIF
		IF NOT USED("tmpAppPermCat")
			RETURN
		ENDIF
		SELECT tmpAppPermCat
		GO TOP
		SCAN
			lcCode = ALLTRIM(tmpAppPermCat.PermissionCode)
			DO CASE
			CASE TYPE("tmpAppPermCat.DisplayName") = "C"
				lcDisp = ALLTRIM(tmpAppPermCat.DisplayName)
			OTHERWISE
				lcDisp = lcCode
			ENDCASE
			DO CASE
			CASE TYPE("tmpAppPermCat.Category") = "C"
				lcCat = ALLTRIM(tmpAppPermCat.Category)
			OTHERWISE
				lcCat = "General"
			ENDCASE
			INSERT INTO csrPerm (permcode, display, category, granted, grantTxt) ;
				VALUES (lcCode, lcDisp, lcCat, .F., "No")
		ENDSCAN
		USE IN tmpAppPermCat
		SELECT csrPerm
		GO TOP
	ENDPROC

	PROCEDURE LoadUserGrants
		LOCAL lcUser, lcSQL, lnRet, lcCode
		lcUser = ALLTRIM(This.cSelectedUser)
		IF EMPTY(lcUser)
			RETURN
		ENDIF
		IF NOT USED("csrPerm")
			RETURN
		ENDIF
		SELECT csrPerm
		REPLACE ALL granted WITH .F., grantTxt WITH "No"
		lcSQL = "SELECT LTRIM(RTRIM(ANS)) AS PermissionCode "
		lcSQL = lcSQL + "FROM dbo.AppSetup WITH (NOLOCK) "
		lcSQL = lcSQL + "WHERE LTRIM(RTRIM(UN)) = "+AppPermission_SQLQuote(lcUser)+" "
		lcSQL = lcSQL + "AND UPPER(LTRIM(RTRIM(PRP))) = 'YES'"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpAppPermGrant")
		IF lnRet > 0 AND USED("tmpAppPermGrant")
			SELECT tmpAppPermGrant
			GO TOP
			SCAN
				lcCode = UPPER(ALLTRIM(tmpAppPermGrant.PermissionCode))
				SELECT csrPerm
				GO TOP
				LOCATE FOR UPPER(ALLTRIM(permcode)) == lcCode
				IF FOUND()
					REPLACE granted WITH .T., grantTxt WITH "Yes"
				ENDIF
			ENDSCAN
			USE IN tmpAppPermGrant
		ENDIF
		IF This.lHasAppUserGrant
			lcSQL = "SELECT PermissionCode FROM dbo.AppUserGrant WITH (NOLOCK) "
			lcSQL = lcSQL + "WHERE LTRIM(RTRIM(UserName)) = "+AppPermission_SQLQuote(lcUser)+" AND Granted = 1"
			lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpAppPermGrant2")
			IF lnRet > 0 AND USED("tmpAppPermGrant2")
				SELECT tmpAppPermGrant2
				GO TOP
				SCAN
					lcCode = UPPER(ALLTRIM(tmpAppPermGrant2.PermissionCode))
					SELECT csrPerm
					GO TOP
					LOCATE FOR UPPER(ALLTRIM(permcode)) == lcCode
					IF FOUND()
						REPLACE granted WITH .T., grantTxt WITH "Yes"
					ENDIF
				ENDSCAN
				USE IN tmpAppPermGrant2
			ENDIF
		ENDIF
		This.SyncAllGrantTxt()
		SELECT csrPerm
		GO TOP
		This.grdPerm.RecordSource = ""
		This.grdPerm.RecordSource = "csrPerm"
		This.ConfigureGrid()
		This.grdPerm.Refresh()
	ENDPROC

	PROCEDURE LoadUserList
		LOCAL lcSQL, lnRet
		lcSQL = "SELECT DISTINCT LTRIM(RTRIM(UN)) AS UserName "
		lcSQL = lcSQL + "FROM dbo.AppSetup WITH (NOLOCK) "
		lcSQL = lcSQL + "WHERE LTRIM(RTRIM(ISNULL(UN,''))) <> '' "
		lcSQL = lcSQL + "ORDER BY UserName"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "csrUsers")
		IF NOT This.SqlOk(lnRet, lcSQL)
			RETURN
		ENDIF
		This.cboUser.Clear()
		SELECT csrUsers
		GO TOP
		SCAN
			This.cboUser.AddItem(ALLTRIM(csrUsers.UserName))
		ENDSCAN
	ENDPROC

	PROCEDURE SaveUserGrants
		LOCAL lcUser, lcSQL, lnRet, lnChg, lcCode, lcModBy
		lcUser = ALLTRIM(This.cSelectedUser)
		IF EMPTY(lcUser)
			MESSAGEBOX("Select a user first.", 48, "App Permissions")
			RETURN
		ENDIF
		IF This.nConnHandle < 1
			This.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		lcModBy = ALLTRIM(RIGHT(SYS(0), LEN(SYS(0)) - AT("#", SYS(0)) - 1))
		lnChg = 0
		SELECT csrPerm
		SCAN
			lcCode = ALLTRIM(csrPerm.permcode)
			IF csrPerm.granted
				lcSQL = "SELECT COUNT(*) AS Cntd FROM dbo.AppSetup WITH (NOLOCK) "
				lcSQL = lcSQL + "WHERE UN = "+AppPermission_SQLQuote(lcUser)+" "
				lcSQL = lcSQL + "AND UPPER(LTRIM(RTRIM(PRP))) = 'YES' "
				lcSQL = lcSQL + "AND LTRIM(RTRIM(ANS)) = "+AppPermission_SQLQuote(lcCode)
				lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpAppPermChk")
				IF lnRet > 0 AND USED("tmpAppPermChk") AND tmpAppPermChk.Cntd = 0
					IF AppSetup_Insert(lcUser, "YES", lcCode, This.nConnHandle)
						lnChg = lnChg + 1
					ENDIF
				ENDIF
				IF USED("tmpAppPermChk")
					USE IN tmpAppPermChk
				ENDIF
				IF This.lHasAppUserGrant
					This.EnsureAppPermissionCode(lcCode, csrPerm.display, csrPerm.category)
					lcSQL = "IF NOT EXISTS (SELECT 1 FROM dbo.AppUserGrant WHERE UserName = "
					lcSQL = lcSQL + AppPermission_SQLQuote(lcUser)+" AND PermissionCode = "
					lcSQL = lcSQL + AppPermission_SQLQuote(lcCode)+") "
					lcSQL = lcSQL + "INSERT INTO dbo.AppUserGrant (UserName, PermissionCode, Granted, ModifiedBy) "
					lcSQL = lcSQL + "VALUES ("+AppPermission_SQLQuote(lcUser)+", "
					lcSQL = lcSQL + AppPermission_SQLQuote(lcCode)+", 1, "+AppPermission_SQLQuote(lcModBy)+") "
					lcSQL = lcSQL + "ELSE UPDATE dbo.AppUserGrant SET Granted = 1, ModifiedBy = "
					lcSQL = lcSQL + AppPermission_SQLQuote(lcModBy)+", ModifiedUtc = SYSUTCDATETIME() "
					lcSQL = lcSQL + "WHERE UserName = "+AppPermission_SQLQuote(lcUser)+" "
					lcSQL = lcSQL + "AND PermissionCode = "+AppPermission_SQLQuote(lcCode)
					SQLEXEC(This.nConnHandle, lcSQL)
				ENDIF
			ELSE
				lcSQL = "DELETE FROM dbo.AppSetup "
				lcSQL = lcSQL + "WHERE UN = "+AppPermission_SQLQuote(lcUser)+" "
				lcSQL = lcSQL + "AND UPPER(LTRIM(RTRIM(PRP))) = 'YES' "
				lcSQL = lcSQL + "AND LTRIM(RTRIM(ANS)) = "+AppPermission_SQLQuote(lcCode)
				lnRet = SQLEXEC(This.nConnHandle, lcSQL)
				IF lnRet > 0
					lnChg = lnChg + 1
				ENDIF
				IF This.lHasAppUserGrant
					lcSQL = "DELETE FROM dbo.AppUserGrant WHERE UserName = "
					lcSQL = lcSQL + AppPermission_SQLQuote(lcUser)+" AND PermissionCode = "
					lcSQL = lcSQL + AppPermission_SQLQuote(lcCode)
					SQLEXEC(This.nConnHandle, lcSQL)
				ENDIF
			ENDIF
		ENDSCAN
		MESSAGEBOX("Saved permissions for "+lcUser+CHR(13)+ ;
			ALLTRIM(STR(lnChg))+" row(s) added or removed.", 64, "App Permissions")
		This.LoadUserGrants()
	ENDPROC

	PROCEDURE SqlOk
		LPARAMETERS tnRet, tcSQL
		IF tnRet < 1
			SQLEXECError(tcSQL, This.nConnHandle, tnRet, "AppPermission_maint")
			RETURN .F.
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE SyncAllGrantTxt
		SELECT csrPerm
		GO TOP
		SCAN
			REPLACE grantTxt WITH IIF(granted, "Yes", "No")
		ENDSCAN
		GO TOP
	ENDPROC

	PROCEDURE SyncGrantTxt
		REPLACE grantTxt WITH IIF(granted, "Yes", "No")
	ENDPROC

	PROCEDURE TableExists
		LPARAMETERS tcTable
		LOCAL lnRet, lcSQL
		lcSQL = "SELECT OBJECT_ID('dbo."+tcTable+"','U') AS ObjId"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpAppPermObj")
		IF lnRet > 0 AND USED("tmpAppPermObj") AND !ISNULL(tmpAppPermObj.ObjId)
			USE IN tmpAppPermObj
			RETURN .T.
		ENDIF
		IF USED("tmpAppPermObj")
			USE IN tmpAppPermObj
		ENDIF
		RETURN .F.
	ENDPROC

	PROCEDURE UserPicked
		Thisform.cSelectedUser = ALLTRIM(Thisform.cboUser.Value)
		Thisform.LoadUserGrants()
	ENDPROC

	PROCEDURE cboUser.InteractiveChange
		Thisform.UserPicked()
	ENDPROC

	PROCEDURE cboUser.Valid
		Thisform.UserPicked()
		RETURN .T.
	ENDPROC

	PROCEDURE cmdAll.Click
		SELECT csrPerm
		REPLACE ALL granted WITH .T., grantTxt WITH "Yes"
		GO TOP
		Thisform.grdPerm.Refresh()
	ENDPROC

	PROCEDURE cmdClose.Click
		IF USED("csrPerm")
			USE IN csrPerm
		ENDIF
		IF USED("csrUsers")
			USE IN csrUsers
		ENDIF
		Thisform.Release()
	ENDPROC

	PROCEDURE cmdNewUser.Click
		LOCAL lcNew
		lcNew = ALLTRIM(INPUTBOX("Enter user display name (same as AppSetup.UN / SYS(0) after #):", ;
			"New ERP user", ""))
		IF EMPTY(lcNew)
			RETURN
		ENDIF
		lcNew = ALLTRIM(lcNew)
		Thisform.cboUser.AddItem(lcNew)
		Thisform.cboUser.Value = lcNew
		Thisform.cSelectedUser = lcNew
		Thisform.LoadUserGrants()
	ENDPROC

	PROCEDURE cmdNone.Click
		SELECT csrPerm
		REPLACE ALL granted WITH .F., grantTxt WITH "No"
		GO TOP
		Thisform.grdPerm.Refresh()
	ENDPROC

	PROCEDURE cmdReload.Click
		Thisform.LoadPermissionCatalog()
		Thisform.LoadUserGrants()
	ENDPROC

	PROCEDURE cmdSave.Click
		IF MESSAGEBOX("Save permission changes for "+ALLTRIM(Thisform.cSelectedUser)+"?", 4+32, "App Permissions") = 6
			Thisform.SaveUserGrants()
		ENDIF
	ENDPROC

ENDDEFINE
