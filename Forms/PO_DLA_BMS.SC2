DEFINE CLASS frmpo_dla AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdDLA_BMS" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: getpo_dla
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "PO DLA BMS QC"
		DoCreate = .T.
		Height = 250
		Icon = graphics\earth-globe.ico
		Left = 0
		Name = "frmPO_DLA"
		nconnhandle = 0
		Top = 0
		Width = 507
	*</PropValue>

	ADD OBJECT 'cmdQuit' AS commandbutton WITH ;
		Caption = "Quit", ;
		Height = 27, ;
		Left = 288, ;
		Name = "cmdQuit", ;
		Top = 216, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdDLA_BMS' AS grid WITH ;
		Height = 156, ;
		Left = 12, ;
		Name = "grdDLA_BMS", ;
		Top = 12, ;
		Width = 480
		*< END OBJECT: BaseClass="grid" />
	
	PROCEDURE getpo_dla
		*GetPO_DLA
		
		IF USED('PO_DLA')
			USE IN PO_DLA
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "PO.* FROM dbo.PurchaseOrder PO WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Vendor V ON V.VendCode = PO.VendCode "
		cSQL = cSQL + " WHERE PO.HPAPO > 500000 "
		cSQL = cSQL + " AND ISNULL(PO.BMScheck,0) = 0 "
		cSQL = cSQL + " AND ISNULL(V.DLA_BMS,0) = 1 "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PO_DLA')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PO_DLA' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PO_DLA' )
		ENDIF
		
		SELECT PO_DLA
		INDEX ON Company TAG Company
		SET ORDER TO Company
		*INDEX ON ValPOitem(POitem) TAG VALPOitem
		*SET ORDER TO VALPOitem
		
		GO BOTTOM
		
		IF RECNO('PO_DLA') > 10
			SKIP -2
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		ThisForm.GetPO_DLA()
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

ENDDEFINE
