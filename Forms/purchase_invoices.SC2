	PROCEDURE Init
		PARAMETERS nHPAPO
		*DO FORM forms\purchase_invoices WITH HPAPO
		
		
		*!*	IF VARTYPE(nHPAPO) != "N"
		*!*		RETURN .F.
		*!*	ENDIF
		*!*	IF nHPAPO < 1
		*!*		RETURN .F.
		*!*	ENDIF
		*nHPAPO=500708
		
		ThisForm.Load_table(nHPAPO)
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SETUP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		
	ENDPROC

	PROCEDURE load_table
		PARAMETERS nHPAPO
		*ThisForm.Load_Table()
		
		
		IF USED('Invoices')
			ThisForm.grdInvoices.RecordSource = ''
			USE IN Invoices
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT [ID],[Vendor_Invoice],VI.HPAPO,[InvoiceDate],[Subtotal],[Freight],[TotalAmount] "
		cSQL = cSQL+",[ID_Detail],[Vendor_Invoice_ID],[Recv_Qty],[Recv_P]"
		cSQL = cSQL+",[ItemTotal],VID.[POitem],VID.[Reconciled] "
		cSQL = cSQL+",PO.[POitem],PO.[SOitem],[SalesP],[Company],[Alloy],[Form],[CC]"
		cSQL = cSQL+",PO.[Order_Qty],PO.[pieces],PO.[thck],PO.[sz2],PO.[sz3]"
		cSQL = cSQL+",PO.[p_lb],PO.[p_pc],PO.[p_ft],PO.[lotp],PO.[otherp],PO.[otherfld],PO.[orderdate],PO.[due_min],PO.[due_max],PO.[received]"
		cSQL = cSQL+",PO.[receipt],PO.[delivered],PO.[cancelled],PO.[posalesp],PO.[shipvia],PO.[jobnumber]"
		cSQL = cSQL+",PO.[Services],PO.[ConvServ],PO.[Equipment],PO.[Stock],PO.[Sheet_pk],PO.[ShipWhere],PO.[POshipaddr],PO.[POpayaddr]"
		cSQL = cSQL+",PO.[Randlen],PO.[Metric],PO.[Sz1Orig],PO.[Sz2Orig],PO.[Sz3Orig],PO.[DispAlloy],PO.[StandSize]"
		cSQL = cSQL+",PO.[Amendment],PO.[Printed],PO.[VendCode],PO.[ContactID],PO.[Terms],PO.[FOB]"
		cSQL = cSQL+",PO.[HPA_Due_Min],PO.[HPA_Due_Max],PO.[First_Due_Max],PO.[Reconciled],PO.[ReconcileTotal]"
		cSQL = cSQL+",PO.[StockLst_QTY],PO.[StockLst_P],PO.[StockLst_PU],PO.[BMScheck] "
		cSQL = cSQL+",VID.PU"
		cSQL = cSQL+" FROM dbo.Vendor_Invoice VI "
		cSQL = cSQL+",dbo.Vendor_Invoice_Detail VID "
		cSQL = cSQL+",dbo.PurchaseOrder PO "
		
		cSQL = cSQL+" WHERE VI.HPAPO ="+ALLTRIM(STR(nHPAPO))
		
		cSQL = cSQL+" AND VID.Vendor_Invoice_ID = VI.ID"
		cSQL = cSQL+" AND PO.POitem = VID.POitem"
		
		
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Invoices')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Invoices')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Invoices")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Invoices")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'Invoices' )
		ENDIF
		
		
		IF USED('Invoices')
			IF EOF('Invoices')
				MESSAGEBOX("Did not find ERP PO: "+ALLTRIM(STR(nHPAPO)),48,"No Data")
			ELSE
				ThisForm.grdInvoices.RecordSource = 'Invoices'
				ThisForm.RefreshINV()
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE refreshinv
		*ThisForm.RefreshINV()
		
		ThisForm.txtSubtotal.Value		= Invoices.Subtotal
		ThisForm.txtFreight.Value		= Invoices.Freight
		ThisForm.txtTotalAmount.Value	= Invoices.TotalAmount
		
		ThisForm.txtRecv_Qty.Value		= Invoices.Recv_Qty
		ThisForm.txtRecv_P.Value		= Invoices.Recv_P
		ThisForm.txtItemTotal.Value		= Invoices.ItemTotal
		
		ThisForm.txtOrder_Qty.Value		= Invoices.Order_Qty
		ThisForm.txtStockLst_P.Value	= Invoices.StockLst_P
		PRIVATE nPU
		nPU = PrepareSQLnum(Invoices.StockLst_PU,'PU',-1)
		IF nPU = 0
			nPU = Get_cPUfrom_nPU(PrepareSQLnum(Invoices.PU,'PU',1,0))  &&VID_PU  --ERP Acct Standard
		ENDIF
		ThisForm.txtCPU.Value			= nPU
		ThisForm.txtStockLst_QTY.Value	= Invoices.StockLst_QTY
		
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('Invoices')
			USE IN Invoices
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdDone.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE grdInvoices.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshInv
	ENDPROC

ENDDEFINE
