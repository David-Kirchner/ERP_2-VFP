		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtxYLD' AS textbox WITH ;
		Height = 23, ;
		InputMask = "999,999,999", ;
		Left = 96, ;
		Name = "txtxYLD", ;
		SelectOnEntry = .T., ;
		TabIndex = 21, ;
		Top = 249, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		IF ThisForm.OpenedGFMLog AND USED('GFMLog')
			USE IN GFMLog
		ENDIF
		IF ThisForm.OpenedHPAQuote AND DBUSED('HPA')
			SET DATABASE TO HPA
			CLOSE DATABASES 
		ENDIF
		
		IF ThisForm.OpenedAlloys AND DBUSED('HPA')
			SET DATABASE TO HPA
			CLOSE DATABASES 
		ENDIF
		
		
		IF ThisForm.OpenedERPCert AND DBUSED('ERPCert')
			SET DATABASE TO ERPCert
			CLOSE DATABASES 
		ENDIF
	ENDPROC

	PROCEDURE Init
		PRIVATE nSQLEXEC, cSQL
		IF USED('GFMLog')	
			USE IN GFMLog
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.GFMLog WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'GFMLog')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT GFMLog
			INDEX ON LOT TAG LOT
		ENDIF
		SET ORDER TO TAG LOT
		
		
		
		SELECT GFMlog
		*pCurRec = MIN( Recno(),RECCOUNT() )
		*SET ORDER TO TAG Lot
		
		GO BOTTOM
		ThisForm.fAlloy = ""
		ThisForm.Alloy1.Value = ""
		ThisForm.txtSnD.Value = 0
		ThisForm.txtSxD.Value = 0
		ThisForm.txtGnD.Value = 0
		ThisForm.txtGxD.Value = 0
		ThisForm.txtnUTS.Value = 0
		ThisForm.txtxUTS.Value = 0
		ThisForm.txtnYLD.Value = 0
		ThisForm.txtxYLD.Value = 0
		ThisForm.txtHeat.Value = ""
		ThisForm.txtColdWork.Value = 0
		ThisForm.txtColdWork2.Value = 0
		ThisForm.txtSalesnum.Value = 0
		ThisForm.txtPO.Value = ""
		ThisForm.txtTestPO.Value = 0
		ThisForm.txtLab.Value = ""
		ThisForm.txtDate.Value = CTOD("  /  /    ")
		ThisForm.txtDate2.Value = CTOD("  /  /    ")
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
	ENDPROC

	PROCEDURE loadalloys		&& Alloys is used to check spelling in Alloy field
		PRIVATE cSQL, nSQLEXEC
		*ThisForm.LoadAlloys()
		
		cSQL = "SELECT * FROM dbo.Alloys ORDER BY Alloy "
		
		IF USED("Alloys")
			SELECT Alloys
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Alloys')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL , 'Alloys')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Alloys")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Alloys")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Alloys')
		ENDIF
		
		
		IF USED("Alloys")
			SELECT Alloys
			INDEX ON UPPER(Alloys) TAG UppAlloys
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE ALLOY1.Click
		ThisForm.fAlloy = This.Value
		
		
	ENDPROC

	PROCEDURE ALLOY1.GotFocus
		IF USED('ALLOYS')
			SELECT alloys
		ELSE
			ThisForm.LoadAlloys()
		ENDIF
		
	ENDPROC

	PROCEDURE ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		IF lnInsertionPt = 11
			*Having Trouble with the last character.
			lnFakeInsertionPt = 12
		ELSE
			lnFakeInsertionPt = lnInsertionPt 
		ENDIF
		
		*lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnFakeInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
		
		**********************
		*!*	lnInsertionPt = IIF(this.SelStart=0,11,this.SelStart)
		*!*	lcSearchStr = substr(this.value,1,lnInsertionPt)
		*!*	IF !empty(lcSearchStr)
		*!*		=seek(upper(lcSearchStr),"Alloys","UPPAlloys")
		*!*		IF found("Alloys")
		*!*			this.VALUE=Alloys.Alloy
		*!*		ELSE
		*!*			**No replacement
		*!*			this.value=lcSearchStr
		*!*		ENDIF
		*!*	ELSE
		*!*		this.value=space(0)
		*!*	ENDIF
		*!*	this.selstart = lnInsertionPt
		
	ENDPROC

	PROCEDURE ALLOY1.LostFocus
		=insmode(.T.)
		
	ENDPROC

	PROCEDURE ALLOY1.Valid
		
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pCurAlloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy,  ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
			
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				*RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				MESSAGEBOX("Alloy '"+pCurAlloy+"' is unknown."+CHR(13)+"Use Quotes-Alloys Standard program to add a new Alloy.",0+64,"Unkown Alloy.")
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
		
		*****************
		IF !USED('ALLOYS')
			ThisForm.LoadAlloys()
		ENDIF
		
		PRIVATE nCountAlloy
		nCountAlloy = 0
		
		*SELECT Alloys
		*SET TALK OFF
		*COUNT FOR Alloy = pCurAlloy TO nCountAlloy
		**LOCATE FOR Alloy = pCurAlloy
		*ThisForm.lblCountAlloy.Caption = "Counted "+ALLTRIM(STR(nCountAlloy))
		
		
		*!*	*INDEX ON UPPER(Alloys) TAG UPPAlloys
		*!*	*SET ORDER TO alloys
		*!*	SEEK UPPER(ThisForm.fAlloy) ORDER TAG UPPALLOYS
		*!*	IF FOUND('Alloys')
		*!*		IF ThisForm.fAlloy <> alloys.alloy
		*!*			ThisForm.fAlloy = alloys.alloy
		*!*		ENDIF
		*!*	ELSE
		
		*!*		INDEX ON UPPER(Alloy) TAG UPPAlloy
		*!*		SEEK UPPER(ThisForm.fAlloy) ORDER TAG UPPAlloy
		*!*		IF FOUND()
		*!*			IF ThisForm.fAlloy <> alloys.alloy
		*!*				ThisForm.fAlloy = alloys.alloy
		*!*			ENDIF
		*!*		ELSE
		*!*			WAIT WINDOW "Alloy not found! " TO BLANK
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE cmdApplyFilter.Click
		ThisForm.lblFilterRecords.Caption = "0 Records"
		ThisForm.edtLotNumbers.Visible = .F.
		ThisForm.cmdPrint.Visible = .F.
		ThisForm.cmdExcelXLS.Visible = .F.
		ThisForm.cmdExcelDIF.Visible = .F.
		
		
		PRIVATE cAlloy, nStart_MinDia, nStart_MaxDia
		cAlloy			= PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		nStart_MinDia	= PrepareSQLnum(ThisForm.txtSnD.Value,'Dia',9,3)
		nStart_MaxDia	= PrepareSQLnum(ThisForm.txtSxD.Value,'Dia',9,3)
		
		PRIVATE nGFM_MinDia, nGFM_MaxDia
		nGFM_MinDia	= PrepareSQLnum(ThisForm.txtGnD.Value,'Dia',9,3)
		nGFM_MaxDia	= PrepareSQLnum(ThisForm.txtGxD.Value,'Dia',9,3)
		
		PRIVATE nUTSMin, nUTSMax
		nUTSMin	= PrepareSQLnum(ThisForm.txtnUTS.Value,'Tensile',-3)
		nUTSMax	= PrepareSQLnum(ThisForm.txtxUTS.Value,'Tensile',-3)
		
		PRIVATE nYldMin, nYldMax
		nYldMin	= PrepareSQLnum(ThisForm.txtnYLD.Value,'Yeild',-3)
		nYldMax	= PrepareSQLnum(ThisForm.txtxYLD.Value,'Yeild',-3)
		
		PRIVATE cHeat
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
		PRIVATE nCWmin, nCWmax
		nCWmin	= PrepareSQLnum(ThisForm.txtColdWork.Value,'CW',4,3)
		nCWmax	= PrepareSQLnum(ThisForm.txtColdWork2.Value,'CW',4,3)
		
		PRIVATE nSalesNum, cPO, nTestPO
		nSalesNum = PrepareSQLnum(ThisForm.txtSalesnum.Value,'SalesNum',-3)
		cPO		= PrepareSQLtxt(ThisForm.txtPO.Value,'PO',50)
		nTestPO = PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',-3)
		
		PRIVATE cLab
		cLab = PrepareSQLtxt(ThisForm.txtLab.Value,'Lab',12)
		
		PRIVATE dAfter, dBefore
		dAfter	= PrepareSQLdate(ThisForm.txtDate.Value,'After_Date')
		dBefore	= PrepareSQLdate(ThisForm.txtDate2.Value,'Before_Date')
		
		PRIVATE cSQL
		cSQL = "SELECT * FROM dbo.GFMLog "
		
		PRIVATE lUsedWhere
		lUsedWhere = .F.
		
		IF LEN(cAlloy) > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " AlloyName = '"+cAlloy+"' "
		ENDIF
		
		*nStart_MinDia, nStart_MaxDia
		IF nStart_MinDia > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " sSize >= "+STR(nStart_MinDia)
		ENDIF
		
		IF nStart_MaxDia > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " sSize <= "+STR(nStart_MaxDia) + " AND sSize > 0 "
		ENDIF
		
		*nGFM_MinDia, nGFM_MaxDia
		IF nGFM_MinDia > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " GFMSize >= "+STR(nGFM_MinDia)
		ENDIF
		
		IF nGFM_MaxDia > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " GFMSize <= "+STR(nGFM_MaxDia) + " AND GFMSize > 0 "
		ENDIF
		
		*nUTSMin, nUTSMax
		IF nUTSMin > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " Tensile >= "+STR(nUTSMin)
		ENDIF
		
		IF nUTSMax > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " Tensile <= "+STR(nUTSMax) + " AND Tensile > 0 "
		ENDIF
		
		*nYldMin, nYldMax
		IF nYldMin > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " Yield >= "+STR(nYldMin)
		ENDIF
		
		IF nYldMax > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " Yield <= "+STR(nYldMax) + " AND Yield > 0 "
		ENDIF
		
		*cHeat
		IF LEN(cHeat) > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " Heat LIKE '%"+cHeat+"%'"
		ENDIF
		
		*nCWmin, nCWmax
		IF nCWmin > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " ColdWork >= "+STR(nCWmin,4,3)
		ENDIF
		
		IF nCWmax > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " ColdWork <= "+STR(nCWmax,4,3) + " AND ColdWork > 0 "
		ENDIF
		
		* nSalesNum, cPOo, nTestPO, cLab
		IF nSalesNum > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " SalesNum = "+STR(nSalesNum)
		ENDIF
		IF LEN(cPO) > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " PO LIKE '%"+cPO+"%'"
		ENDIF
		IF nTestPO > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " TestPO = "+STR(nTestPO)
		ENDIF
		IF LEN(cLab) > 0
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " Lab LIKE '%"+cLab+"%'"
		ENDIF
		
		*dAfter, dBefore
		IF NOT EMPTY(dAfter) AND NOT EMPTY(dBefore)
			*Check Data
			IF dBefore > dAfter
				MESSAGEBOX("Bad use of Before/After Date"+CHR(13)+"Please fix the Dates",16,"Reenter the Dates")
				RETURN .F.
			ENDIF
		ENDIF
		
		IF NOT EMPTY(dAfter)
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " [Date] >='" + DTOC(dAfter)+ "'" 
			*+ " AND [Date] > 0 "
		ENDIF
		IF NOT EMPTY(dBefore)
			IF NOT lUsedWhere 
				cSQL = cSQL + " WHERE "
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " AND "
			ENDIF
			cSQL = cSQL + " [Date] <='" + DTOC(dBefore)+ "'"
		ENDIF
		
		
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'GFMLog')
			RETURN .F.
		ENDIF
		
		IF USED('GFMLog')
			ThisForm.lblFilterRecords.Caption = ALLTRIM(STR(RECCOUNT('GFMLog')))+" Records"
			IF RECCOUNT('GFMLog') > 0
				ThisForm.edtLotNumbers.Value = ""
				SCAN
					ThisForm.edtLotNumbers.Value = ThisForm.edtLotNumbers.Value + STR(GFMLog.Lot)+CHR(13)
				ENDSCAN
				ThisForm.edtLotNumbers.Visible = .T.
				
				IF RECCOUNT('GFMLog') > 5
					ThisForm.cmdPrint.Visible = .T.
				ENDIF
				ThisForm.cmdExcelXLS.Visible = .T.
				ThisForm.cmdExcelDIF.Visible = .T.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdExcelDIF.Click
		IF USED('GFMLog')
			IF RECCOUNT('GFMLog') > 0
				SELECT GFMLog
				*REPORT FORM Reports\GFMlog TO PRINTER PROMPT NOCONSOLE
				*COPY TO SYS(2023)+"GFMlog" XL5
				
				IF "\MEM" $ SYS(2003)
					EXPORT TO (SYS(5)+SYS(2003)+"\GFMlog.DIF") TYPE DIF
				ELSE
					EXPORT TO (SYS(5)+SYS(2003)+"\MEM\GFMlog.DIF") TYPE DIF
				ENDIF
				
				WAIT WINDOW 'Done' NOWAIT
			
				LOCAL loExcel
				TRY
					loExcel = CREATEOBJECT("Excel.Application")
			*		loExcel.workbooks.open(SYS(5)+SYS(2003)+"\GFMlog.XLS")
					IF "\MEM" $ SYS(2003)
						loExcel.workbooks.open(SYS(5)+SYS(2003)+"\GFMlog.DIF")
					ELSE
						loExcel.workbooks.open(SYS(5)+SYS(2003)+"\MEM\GFMlog.DIF")
					ENDIF
					loExcel.visible = .T.
				CATCH
					PRIVATE cFile
					IF "\MEM" $ SYS(2003)
						cFile = (SYS(5)+SYS(2003)+"\GFMlog.DIF")
					ELSE
						cFile = (SYS(5)+SYS(2003)+"\MEM\GFMlog.DIF")
					ENDIF
					
					MESSAGEBOX("Could not Start Excel"+CHR(13)+"Your file is at "+CHR(13)+cFile,0,"")
											
				ENDTRY		
				
			ELSE
				MESSAGEBOX("Please Set an Apply a filter first",16,"No records to report.")
			ENDIF
		ELSE
			MESSAGEBOX("Please Apply a filter first",16,"No records to report.")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdExcelXLS.Click
		IF USED('GFMLog')
			IF RECCOUNT('GFMLog') > 0
				SELECT GFMLog
				*REPORT FORM Reports\GFMlog TO PRINTER PROMPT NOCONSOLE
				*COPY TO SYS(2023)+"GFMlog" XL5
				
				IF "\MEM" $ SYS(2003)
					COPY TO (SYS(5)+SYS(2003)+"\GFMlog.XLS" XL5
				ELSE
					COPY TO (SYS(5)+SYS(2003)+"\MEM\GFMlog.XLS") XL5
				ENDIF
				
				WAIT WINDOW 'Done' NOWAIT
			
				LOCAL loExcel
				TRY
					loExcel = CREATEOBJECT("Excel.Application")
			*		loExcel.workbooks.open(SYS(5)+SYS(2003)+"\GFMlog.XLS")
					IF "\MEM" $ SYS(2003)
						loExcel.workbooks.open(SYS(5)+SYS(2003)+"\GFMlog.XLS")
					ELSE
						loExcel.workbooks.open(SYS(5)+SYS(2003)+"\MEM\GFMlog.XLS")
					ENDIF
					loExcel.visible = .T.
				CATCH
					PRIVATE cFile
					IF "\MEM" $ SYS(2003)
						cFile = (SYS(5)+SYS(2003)+"\GFMlog.XLS")
					ELSE
						cFile = (SYS(5)+SYS(2003)+"\MEM\GFMlog.XLS")
					ENDIF
					
					MESSAGEBOX("Could not Start Excel"+CHR(13)+"Your file is at "+CHR(13)+cFile+CHR(13)+CHR(13)+"Open with OpenOffice Calc"+CHR(13)+"or Google Sheets",0,"Could not start Excel")
											
				ENDTRY		
				
			ELSE
				MESSAGEBOX("Please Set an Apply a filter first",16,"No records to report.")
			ENDIF
		ELSE
			MESSAGEBOX("Please Apply a filter first",16,"No records to report.")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPrint.Click
		IF USED('GFMLog')
			IF RECCOUNT('GFMLog') > 0
				SELECT GFMLog
				IF RECCOUNT('GFMLog') > 15
					MESSAGEBOX("Too many pages, Please use Excel or DIF",48,"Too much paper")
				ELSE
					REPORT FORM Reports\GFMlog TO PRINTER PROMPT NOCONSOLE
				ENDIF
			ELSE
				MESSAGEBOX("Please Set an Apply a filter first",16,"No records to report.")
			ENDIF
		ELSE
			MESSAGEBOX("Please Apply a filter first",16,"No records to report.")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.release
		
	ENDPROC

	PROCEDURE cmdRS_GFMLog.Click
		*https://raptor/ReportS/report/MFG%20Log/GFM%20-Alloy%20Size%20CW
		
		PRIVATE cHTML
		*cHTML = get_Report_Server()+"%2fHPA+Purchasing+Reports%2fPurchaseOrders+POitem&rs:Command=Render&cHPAPOItem="
		cHTML = get_Report_Server()+"%2fMFG%20Log%2fGFM%20-Alloy%20Size%20CW"
		
		
		PRIVATE m.loHyperlink,m.cHyperLink
		*	m.cHyperLink = HTML_PO(nPO,.T.) &&lReturnURL --not URL is an HTML code.
			m.cHyperLink = cHTML
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
			
	ENDPROC

	PROCEDURE lblDateAfter.Click
		PRIVATE dDate1,dDate2
		dDate1 = ThisForm.txtDate.Value
		
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.txtDate.Value = dDate2
		
		ThisForm.txtDate.Refresh
	ENDPROC

	PROCEDURE lblDateBefore.Click
		PRIVATE dDate1,dDate2
		dDate1 = ThisForm.txtDate2.Value
		
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.txtDate2.Value = dDate2
		
		ThisForm.txtDate.Refresh
	ENDPROC

ENDDEFINE
