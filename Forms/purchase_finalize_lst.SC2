			****************************************************
			** These statements were placed before the Transaction Lock
			
			*Undo EXEC dbo.p_Vendor_Invoice_ins 
			cSQL = "DELETE FROM dbo.Vendor_Invoice WHERE ID="+STR(nVendor_InvoiceID) 
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisForm.nConnHandle )
				ENDIF
			ENDIF
					
			*Undo PurchaseOrder 
			*cPOitem = RIGHT(cSQL3_Insert_Vendor_Invoice_Detail,12)
			*cPOitem = STRTRAN(cPOitem,"'","")
			cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
			
			cSQL = "UPDATE dbo.PurchaseOrder SET ReconcileTotal = 0"
			cSQL = cSQL + ", Reconciled=0 "
			cSQL = cSQL + ", StockLst_P = 0"
			cSQL = cSQL + ", StockLst_QTY = 0"
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisForm.nConnHandle )
				ENDIF
			ENDIF
			
			cSQL = "DELETE FROM dbo.Vendor_Invoice_Detail WHERE "
			cSQL = cSQL + " Vendor_Invoice_ID="+STR(nVendor_InvoiceID)
			cSQL = cSQL + " AND POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisForm.nConnHandle )
				ENDIF
			ENDIF
		ELSE
			nSQLEXEC = SQLCOMMIT(ThisForm.nConnHandle)
			WAIT WINDOW "Saving all changes now." TIMEOUT 1
		ENDIF
		
		nSQLEXEC = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
			
		
		RETURN lFailTrans 
	ENDPROC

	PROCEDURE showid_detailtotal
		*ThisForm.ShowID_DetailTotal()
		
		PRIVATE nCostValue, nDetailTotal
		PRIVATE nIDDetailUnits, nIDDetailPerUnit, nIDDetailTotal 
		nCostValue 		= tmpToInvoice.CostValue
		nIDDetailUnits	= tmpToInvoice.IDDetailUnits 
		nIDDetailPerUnit= tmpToInvoice.IDDetailPerUnit
		nIDDetailTotal 	= tmpToInvoice.IDDetailTotal 
		
		PRIVATE nSumUnitsR
		nSumUnitsR	= PrepareSQLnum(ThisForm.txtSumUnits.Value,'SumValue',-5)
		PRIVATE nInvitemTotal
		nInvitemTotal= PrepareSQLnum(ThisForm.txtInvitemTotal.Value,'InvitemTotal',-5)
		
		PRIVATE nDecimal 
		nDecimal = 0
		nDecimal = SET("Decimals")
		SET DECIMALS TO 4
		
		
		IF EMPTY(nIDDetailUnits) AND NOT EMPTY(nIDDetailPerUnit) AND NOT EMPTY(nIDDetailTotal)
			 nIDDetailUnits =  nIDDetailTotal / nIDDetailPerUnit
		ENDIF
		***
		
		IF NOT EMPTY(nIDDetailUnits) AND NOT EMPTY(nIDDetailTotal)
			 nIDDetailPerUnit =  ROUND(nIDDetailTotal / nIDDetailUnits,4)
		ENDIF
		***
		
		IF NOT EMPTY(nIDDetailUnits) AND NOT EMPTY(nIDDetailPerUnit) AND EMPTY(nIDDetailTotal)
			 nIDDetailTotal = ROUND(nIDDetailPerUnit * nIDDetailUnits,2)
		ENDIF
		
		IF nDecimal > 0
			SET DECIMALS TO &nDecimal 
		ENDIF
		
		ThisForm.txtIDDetailUnits.Value		= nIDDetailUnits
		ThisForm.txtIDDetailPerUnit.Value	= ROUND(nIDDetailPerUnit,4)
		ThisForm.txtIDDetailTotal.Value		= ROUND(nIDDetailTotal,2) 
	ENDPROC

	PROCEDURE showinvoicedvalue
		*ThisForm.ShowInvoicedValue()
		*Runs once from INIT
		
		PRIVATE nCostValue, nDetailTotal
		PRIVATE nAcct_QTY, nAcct_P, nIDDetailTotal
		nCostValue 	= tmpToInvoice.CostValue
		nAcct_QTY	= tmpToInvoice.IDDetailUnits 
		nAcct_P		= tmpToInvoice.IDDetailPerUnit
		nIDDetailTotal	= tmpToInvoice.IDDetailTotal 
		
		PRIVATE nSumUnitsR
		nSumUnitsR	= PrepareSQLnum(ThisForm.txtSumUnits.Value,'SumValue',-5)
		PRIVATE nInvitemTotal
		nInvitemTotal= PrepareSQLnum(ThisForm.txtInvitemTotal.Value,'InvitemTotal',-5)
		
		PRIVATE nDecimal 
		nDecimal = 0
		nDecimal = SET("Decimals")
		SET DECIMALS TO 4
		
		IF nSumUnitsR = 0
			IF EMPTY(nAcct_QTY) AND NOT EMPTY(nAcct_P) AND NOT EMPTY(nIDDetailTotal)
				 nAcct_QTY =  nIDDetailTotal / nAcct_P
			ENDIF
		ELSE
			*Use the Recieving Units by default!, adjust PerUnit to match Invoice Total
			nAcct_QTY = nSumUnitsR
		ENDIF
		***
		
		IF nInvitemTotal = 0
			IF NOT EMPTY(nAcct_QTY) AND NOT EMPTY(nIDDetailTotal)
				 nAcct_P =  ROUND(nIDDetailTotal / nAcct_QTY, 4)
			ENDIF
		ELSE
			* adjust PerUnit to match Invoice Total
			IF NOT EMPTY(nAcct_QTY)
				nAcct_P = ROUND( nInvitemTotal / nAcct_QTY, 4)
			ENDIF
		ENDIF
		***
		
		IF nInvitemTotal = 0
			IF NOT EMPTY(nAcct_QTY) AND NOT EMPTY(nAcct_P) AND EMPTY(nIDDetailTotal)
				 nIDDetailTotal = ROUND(nAcct_P * nAcct_QTY, 2)
			ENDIF
		ELSE
			nIDDetailTotal = nInvitemTotal 
		ENDIF
		
		IF nDecimal > 0
			SET DECIMALS TO &nDecimal 
		ENDIF
		
		ThisForm.txtAcct_QTY.Value	= ROUND(nAcct_QTY,4)
		ThisForm.txtPerUnit.Value	= ROUND(nAcct_P,4)
		ThisForm.txtTotal.Value		= ROUND(nIDDetailTotal,4)
		
		
	ENDPROC

	PROCEDURE soitemupdate
		*ThisForm.SOitemUpdate()
		
		PRIVATE nID_Detail 
		nID_Detail = tmpToInvoice.ID_Detail
		
		PRIVATE nAcct_QTY, nAcct_P, nDetailItemTotal
		nAcct_QTY		= PrePareSQLnum(ThisForm.txtAcct_QTY.Value,'S_Qty',10,4)
		nAcct_P			= PrePareSQLnum(ThisForm.txtPerUnit.Value,'S_P',10,4)
		nInvitemTotal	= ROUND(ThisForm.txtInvitemTotal.Value,2)
		nDetailItemTotal = ROUND(nAcct_QTY * nAcct_P,2)
		
		IF nAcct_QTY = 0 OR nAcct_P = 0 
			IF nDetailItemTotal = 0
				IF RECCOUNT('tmpToInvoice') > 0
					MESSAGEBOX( "Please Complete Quanities",0+64,"Cannot save.")
					RETURN .F.
				ENDIF
			ENDIF
			
		ENDIF
		
		*SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Units,D.Unit,M.Form,D.CostValue,D.RandLen,D.InvoiceValue, 0 AS IDDetailUnits, 0 AS IDDetailPerUnit, 0 AS IDDetailTotal 
		SELECT tmpToInvoice
		IF RECCOUNT('tmpToInvoice') = 0
			APPEND BLANK
			REPLACE Lst WITH 'N'
			
			REPLACE tmpToInvoice.Units WITH nAcct_QTY
			REPLACE tmpToInvoice.CostValue WITH nAcct_P
		
			REPLACE tmpToInvoice.IDDetailUnits WITH nAcct_QTY
			REPLACE tmpToInvoice.IDDetailPerUnit WITH nAcct_P
			
			MESSAGEBOX("No Stock record has been affected by this POitem"+CHR(13)+"Just 'commit' to continue.",4+64,"Invoice has no Stock to update.")
			ThisForm.cmdCalculate.Click
			
		ELSE
			REPLACE tmpToInvoice.Units WITH nAcct_QTY
			REPLACE tmpToInvoice.CostValue WITH nAcct_P
			
			UPDATE tmpTOInvoice SET IDDetailUnits = nAcct_QTY, IDDetailPerUnit = nAcct_P WHERE ID_Detail = nID_Detail 
		ENDIF
		
		LOCATE FOR ID_Detail = nID_Detail 
		IF NOT FOUND()
			GO BOTTOM
		ENDIF
		
		ThisForm.CalcTotal()
		
		
	ENDPROC

	PROCEDURE toinvoice_totals
		*ThisForm.ToInvoice_Totals()
		
		*called from LoadLst
		*SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Units,M.Form,'S' AS LST,D.CostValue,D.RandLen,D.InvoiceValue, 0.0000 AS Units, 0.0000 AS IDDetailUnits, 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal"
		
		PRIVATE cUnits
		PRIVATE nDetailTotal
		PRIVATE cSQL, nSQLEXEC
		
		PRIVATE nID_Detail, cSQL_Insert, cSQL_PODiff, cSQL_Sold
		PRIVATE nInsertWeight, nInsertPC
		PRIVATE nPODiffWeight, nPODiffPC
		PRIVATE nSoldWeight, nSoldPC
		PRIVATE nStartWeight,nStartPC
		
		SELECT tmpToInvoice
		*REPLACE tmpToInvoice.Units WITH 0
			
		SCAN
			nInsertWeight	= 0
			nInsertPC		= 0
			nPODiffWeight	= 0
			nPODiffPC		= 0
			nSoldWeight		= 0
			nSoldPC			= 0
			nStartWeight	= 0
			nStartPC		= 0
			
			nID_Detail 		= tmpToInvoice.ID_Detail
			
			IF tmpToInvoice.Lst = "S"
				*"SELECT InvoiceValue,CurrUnitPrice,CurrUnits FROM dbo.StockLst_Value WHERE ID_Detail = "+STR(nID_Detail)+" AND TBL = 'S'"
				cSQL_Insert = "SELECT pWeight, pPc, S_QTY,S_P FROM dbo.[AR.StockLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT] = 'INSERT' AND [Comment] = 'StockLst_Detail Insert'"
				cSQL_PODiff = "SELECT pWeight, pPc, S_QTY,S_P FROM dbo.[AR.StockLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NULL"
				cSQL_Sold   = "SELECT SOitem, pWeight, pPc,S_QTY,S_P FROM dbo.[AR.StockLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NOT NULL"
			ELSE
				cSQL_Insert = "SELECT pWeight, pPc, S_QTY,S_P FROM dbo.[AR.BrokerLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT] = 'INSERT' AND [Comment] = 'StockLst_Detail Insert'"
				cSQL_PODiff = "SELECT pWeight, pPc, S_QTY,S_P FROM dbo.[AR.BrokerLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NULL"
				cSQL_Sold   = "SELECT SOitem, pWeight, pPc,S_QTY,S_P FROM dbo.[AR.BrokerLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NOT NULL"
			ENDIF	  
			
			IF USED('tmpInsert')
				USE IN tmpInsert
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Insert, 'tmpInsert' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Insert, 'tmpInsert' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Insert, "tmpInsert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Insert, "tmpInsert")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL_Insert, ThisForm.nConnHandle, 'tmpInsert' )
				ENDIF
			ENDIF	
		
			IF USED('tmpInsert')
				IF VARTYPE(tmpInsert.pWeight) = "N"
					nInsertWeight = tmpInsert.pWeight
				ENDIF
				IF VARTYPE(tmpInsert.pPc) = "N"
					nInsertPc = tmpInsert.pPc
				ENDIF
				
				nS_QTY = PrepareSQLnum(tmpInsert.S_QTY,'S_QTY',-5)
				IF nS_QTY > 0
					*nInsertWeight = nS_QTY 
				ENDIF
				
				
				USE IN tmpInsert
			ENDIF
			**
			IF USED('tmpPODiff')
				USE IN tmpPODiff
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_PODiff, 'tmpPODiff' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_PODiff, 'tmpPODiff' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_PODiff, "tmpPODiff")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_PODiff, "tmpPODiff")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL_PODiff, ThisForm.nConnHandle, 'tmpPODiff' )
				ENDIF
			ENDIF	
		
			IF USED('tmpPODiff')
				IF VARTYPE(tmpPODiff.pWeight) = "N"
					nPODiffWeight = tmpPODiff.pWeight
				ENDIF
				IF VARTYPE(tmpPODiff.pPc) = "N"
					nPODiffPC = tmpPODiff.pPc
				ENDIF
				USE IN tmpPODiff
			ENDIF
			**
			IF USED('tmpSold')
				USE IN tmpSold
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Sold, 'tmpSold' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Sold, 'tmpSold' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Sold, "tmpSold")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Sold, "tmpSold")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL_Sold, ThisForm.nConnHandle, 'tmpSold' )
				ENDIF
			ENDIF	
			
			************************************
			IF USED('tmpSold')
				PRIVATE cTalk 
				cTalk = SET('TALK')
				SET TALK OFF
				SELECT tmpSold
				IF VARTYPE(tmpSold.pWeight) = "N"
					*SELECT SUM(pWeight) AS nSoldWeight FROM tmpSold
					SUM pWeight TO nSoldWeight
				ENDIF
				IF VARTYPE(tmpSold.pPc) = "N"
		*			nSoldPC = tmpSold.pPc
					*SELECT SUM(pPc) AS nSoldPc FROM tmpSold
					SUM pPc TO nSoldPc 
				ENDIF		
				USE IN tmpSold
				IF cTalk = "ON"
					SET TALK ON
				ENDIF
			ENDIF
			**
			nStartWeight 	= nInsertWeight - nPODiffWeight
			nStartPC 		= nInsertPC - nPODiffPC
		
			*ThisForm.txtIDDetailUnits.Value 	= nStartWeight
			nDetailTotal 						= nStartWeight * nStartPc
			SELECT tmpToInvoice
			REPLACE tmpToInvoice.Units WITH tmpToInvoice.Units + nStartWeight
			REPLACE tmpToInvoice.IDDetailUnits WITH nStartWeight
		
		*D.InvoiceValue,IDDetailUnits,IDDetailPerUnit,IDDetailTotal 
			SELECT tmpToInvoice
		ENDSCAN
		
		SELECT tmpToInvoice
		GO TOP IN tmpToInvoice
		
		ThisForm.txtIDDetailUnits.Value = PrepareSQLnum(tmpToInvoice.Units,'Units',-5)
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpToInvoice')
			USE IN tmpToInvoice
		ENDIF
		IF USED('tmpStockLstID')
			USE IN tmpStockLstID
		ENDIF
		
		IF ThisForm.nConnHandle > 0
			=SQLDISCONNECT( ThisForm.nConnHandle )
		ENDIF
		
		RETURN ThisForm.lReturn
		
	ENDPROC

	PROCEDURE cmdCalculate.Click
		PRIVATE nAcct_QTY, nAcct_P, nInvItemTotal, nIDDetailTotal
		
		nAcct_QTY	= PrePareSQLnum(ThisForm.txtAcct_QTY.Value,'Units',-5)
		nAcct_P	= PrePareSQLnum(ThisForm.txtPerUnit.Value,'S_P',-5)
		nTotal 		= PrePareSQLnum(ThisForm.txtTotal.Value,'Total',-5)
		nInvItemTotal	= PrePareSQLnum(ThisForm.txtInvItemTotal.Value,'ItemTotal',-5)
		
		
		IF nAcct_QTY = 0
			nAcct_QTY = PrePareSQLnum(ThisForm.txtIDDetailUnits.Value,'Units',-5)
		ENDIF
		IF nAcct_QTY = 0
			nAcct_QTY = 1
		ENDIF
		
		PRIVATE nDecimal 
		nDecimal = 0
		nDecimal = SET("Decimals")
		SET DECIMALS TO 4
		
		IF nAcct_P = 0 AND nTotal > 0 AND nAcct_QTY > 0
			nAcct_P = nTotal / nAcct_QTY
		ENDIF
		
		IF nAcct_P = 0 AND nInvItemTotal > 0 AND nAcct_QTY > 0
			nAcct_P = nInvItemTotal / nAcct_QTY
		ENDIF
		
		IF nDecimal > 0
			SET DECIMALS TO &nDecimal 
		ENDIF
		
		ThisForm.txtAcct_QTY.Value	= ROUND(nAcct_QTY,1)
		ThisForm.txtPerUnit.Value	= ROUND(nAcct_P,4)
		ThisForm.txtTotal.Value 	= ROUND(nTotal,4)
		
		ThisForm.SOitemUpdate()
	ENDPROC

	PROCEDURE cmdCommit.Click
		PRIVATE lFail
		
		lFail = ThisForm.SavetoStockLst()
		
		IF lFail
			MESSAGEBOX("StockLst_Value not updated!"+CHR(13)+"Please try again!",0+48,"Error")
		ELSE
			ThisForm.lReturn = .T.
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdExit.Click
		IF MESSAGEBOX("Are you sure you want to Exit?",4+32,"Quit?") = 6
		
			ThisForm.lReturn = .F.
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdSOitemUpdate.Click
		ThisForm.SOitemUpdate()
		
	ENDPROC

	PROCEDURE cmdSumTotal.Click
		PRIVATE nSumUnitsR,nSumPerUnitR,nSumTotalR,nIDDetailTotal
		
		nSumUnitsR		= PrePareSQLnum(ThisForm.txtSumUnits.Value,'Units',-5)
		nSumPerUnitR	= PrePareSQLnum(ThisForm.txtSumPerUnit.Value,'SumPerUnit',-5)
		nSumTotalR	= PrePareSQLnum(ThisForm.txtSumTotal.Value,'SumTotal',-5)
		
		*nIDDetailTotal = PrePareSQLnum(ThisForm.txtIDDetailTotal.Value,'DetailTotal',-5)
		
		IF nSumUnitsR = 0
			nSumUnitsR = PrePareSQLnum(ThisForm.txtSumUnits.Value,'Units',-5)
		ENDIF
		IF nSumUnitsR = 0
			nSumUnitsR = 1
		ENDIF
		
		PRIVATE nDecimal 
		nDecimal = 0
		nDecimal = SET("Decimals")
		SET DECIMALS TO 4
		
		
		IF nDecimal > 0
			SET DECIMALS TO &nDecimal 
		ENDIF
		
		ThisForm.txtAcct_QTY.Value		= ROUND(nSumUnitsR,1)
		ThisForm.txtPerUnit.Value	= ROUND(nSumPerUnitR,4)
		ThisForm.txtTotal.Value = ROUND(nSumTotalR,3)
		
		ThisForm.SOitemUpdate()
	ENDPROC

	PROCEDURE grdToInvoice.AfterRowColChange
		LPARAMETERS nColIndex
		
		IF ThisForm.nTmpToInvoiceRec != RECNO('tmpToInvoice')
			ThisForm.nTmpToInvoiceRec = RECNO('tmpToInvoice')
		
			ThisForm.lblItemDescription.Caption = ALLTRIM(STR(PC))+"Pc "+ItemDescriptionMetric(Form,Dim1,Dim2,Dim3,MAX(StkUnits,RcvUnits),RandLen,'','','' )
		
			ThisForm.txtIDDetailUnits.Value		= tmpToInvoice.IDDetailUnits 
			ThisForm.txtIDDetailPerUnit.Value	= tmpToInvoice.IDDetailPerUnit
			ThisForm.txtIDDetailTotal.Value		= tmpToInvoice.IDDetailTotal 
		
			*ThisForm.CalcTotal()
		ENDIF
	ENDPROC

	PROCEDURE grdToInvoice.Column2.Text1.Valid
		ThisForm.CalcTotal()
		
	ENDPROC

	PROCEDURE lblPerUnit.Click
		PRIVATE nAcct_QTY, nAcct_P ,nDetailItemTotal,nInvItemTotal
		nAcct_QTY 			= PrepareSQLnum(ThisForm.txtAcct_QTY.Value,'Recv_Qty',11,3)
		nDetailItemTotal	= PrePareSQLnum(ThisForm.txtTotal.Value,'DetailItemTotal',10,4)
		nInvItemTotal 		= PrePareSQLnum(ThisForm.txtInvItemTotal.Value,'ItemTotal',10,4)
		
		PRIVATE nDecimal 
		nDecimal = 0
		nDecimal = SET("Decimals")
		SET DECIMALS TO 4
		
		IF nAcct_QTY > 0 
			IF nDetailItemTotal > 0
				nAcct_P = nDetailItemTotal / nAcct_QTY 
				ThisForm.txtPerUnit.Value = ROUND(nAcct_P,4)
			ELSE
				IF nInvItemTotal > 0
					nAcct_P = nInvItemTotal / nAcct_QTY 
					ThisForm.txtPerUnit.Value = ROUND(nAcct_P,4)
					ThisForm.txtTotal.Value = ROUND(nInvItemTotal,2)
				ENDIF
			ENDIF
		ENDIF
		
		IF nDecimal > 0
			SET DECIMALS TO &nDecimal 
		ENDIF
		
		ThisForm.SOitemUpdate()
	ENDPROC

	PROCEDURE lblPOitemTotal.Click
		PRIVATE nAcct_QTY, nPO_P
		nAcct_QTY	= PrepareSQLnum(ThisForm.txtAcct_QTY.Value,'S_Qty',10,4)
		nAcct_P		= PrepareSQLnum(ThisForm.txtPerUnit.Value,'S_P',10,4)
		
		PRIVATE nDetailItemTotal, nDetailTotal
		nDetailItemTotal = 0
		nDetailTotal	= 0
		*!*	PRIVATE nDetailItemUnits, nDetailUnits
		*!*	nDetailItemUnits= 0
		*!*	nDetailUnits	= 0
		
		PRIVATE nCurrRec
		
		IF NOT EMPTY(nAcct_QTY) AND NOT EMPTY(nAcct_P)
			nDetailItemTotal =  nAcct_QTY * nAcct_P
		ELSE
		*!*		*Find Total from tmpToInvoice
		*!*		SELECT tmpToInvoice
		*!*		nCurrRec = RECNO('tmpToInvoice')
		*!*		SCAN	
		*!*			cPU = FormUnitPrice( tmpToInvoice.Form, ThisForm.nConnHandle )
		
		*!*			DO CASE
		*!*			CASE cPU = 'LB'
		*!*				nDetailItemUnits		= tmpToInvoice.StkUnits
		*!*			CASE cPU = 'FT'
		*!*				IF tmpToInvoice.Dim3 > 0
		*!*					nDetailItemUnits	= tmpToInvoice.Dim3
		*!*				ELSE
		*!*					nDetailItemUnits	= tmpToInvoice.Dim2
		*!*				ENDIF
		*!*			CASE cPU = 'PC'
		*!*				nDetailItemUnits		= tmpToInvoice.PC
		*!*			OTHERWISE
		*!*				nDetailItemUnits		= 0
		*!*			ENDCASE
		*!*			nDetailUnits	= nDetailUnits + nDetailItemUnits
		*!*			
		*!*		ENDSCAN	
		*!*		GOTO nCurrRec IN tmpToInvoice
		*!*		
		*!*		nDetailTotal 	= PrePareSQLnum(ThisForm.txtInvItemTotal.Value,'InvItemTotal',10,4)
		*!*		
		*!*		*Find current percent of total
		*!*		cPU = FormUnitPrice( tmpToInvoice.Form, ThisForm.nConnHandle )
		
		*!*		DO CASE
		*!*		CASE cPU = 'LB'
		*!*			nDetailItemUnits		= tmpToInvoice.StkUnits
		*!*		CASE cPU = 'FT'
		*!*			IF tmpToInvoice.Dim3 > 0
		*!*				nDetailItemUnits	= tmpToInvoice.Dim3
		*!*			ELSE
		*!*				nDetailItemUnits	= tmpToInvoice.Dim2
		*!*			ENDIF
		*!*		CASE cPU = 'PC'
		*!*			nDetailItemUnits		= tmpToInvoice.PC
		*!*		OTHERWISE
		*!*			nDetailItemUnits = 0
		*!*		ENDCASE
		*!*		PRIVATE nDecimal 
		*!*	nDecimal = 0
		*!*	nDecimal = SET("Decimals")
		*!*	SET DECIMALS TO 4
		
		*!*		nDetailItemTotal = nDetailTotal * nDetailItemUnits / nDetailUnits 
		*!*	IF nDecimal > 0
		*!*		SET DECIMALS TO &nDecimal 
		*!*	ENDIF
		*!*		
		ENDIF
			
		ThisForm.txtTotal.Value = ROUND(nDetailItemTotal,2)
		
		ThisForm.SOitemUpdate()
	ENDPROC

	PROCEDURE lblUnits.Click
		PRIVATE nRecv_Qty,nAcct_P,nDetailItemTotal,nInvItemTotal
		
		nAcct_P 		= PrePareSQLnum(ThisForm.txtPerUnit.Value,'Acct_P',10,4)
		nDetailItemTotal	= PrePareSQLnum(ThisForm.txtTotal.Value,'DetailItemTotal',10,4)
		nInvItemTotal 		= PrePareSQLnum(ThisForm.txtInvItemTotal.Value,'ItemTotal',10,4)
		
		PRIVATE nDecimal 
		nDecimal = 0
		nDecimal = SET("Decimals")
		SET DECIMALS TO 4
		
		IF nAcct_P > 0 
			IF nDetailItemTotal	> 0
				ThisForm.txtAcct_QTY.Value = ROUND(nDetailItemTotal/nAcct_P,4)
			ELSE
				IF nInvItemTotal > 0
					ThisForm.txtAcct_QTY.Value = ROUND(nInvItemTotal/nAcct_P,4)
					ThisForm.txtTotal.Value = ROUND(nInvItemTotal,2)
				ENDIF
			ENDIF
		ENDIF
		ThisForm.SOitemUpdate()
		
		IF nDecimal > 0
			SET DECIMALS TO &nDecimal 
		ENDIF
		
	ENDPROC

	PROCEDURE txtAcct_QTY.Valid
		PRIVATE nAcct_QTY, nAcct_P, nDetailItemTotal
		nAcct_QTY	= PrePareSQLnum(ThisForm.txtAcct_QTY.Value,'S_Qty',10,4)
		nAcct_P	= PrePareSQLnum(ThisForm.txtPerUnit.Value,'Acct_P',10,4)
		
		nDetailItemTotal =  nAcct_QTY * nAcct_P
		ThisForm.txtTotal.Value = ROUND(nDetailItemTotal,2)
	ENDPROC

