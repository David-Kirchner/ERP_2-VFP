	ADD OBJECT 'txtTotal' AS textbox WITH ;
		Alignment = 1, ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 143, ;
		Name = "txtTotal", ;
		SelectOnEntry = .T., ;
		TabIndex = 14, ;
		ToolTipText = "-ERP Accounting Standard", ;
		Top = 278, ;
		Width = 80
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtTotalDiff' AS textbox WITH ;
		Alignment = 1, ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 396, ;
		Name = "txtTotalDiff", ;
		SelectOnEntry = .T., ;
		TabIndex = 20, ;
		Top = 231, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE calctotal
		*ThisForm.CalcTotal()
		
		*D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Units,M.Form
		*,D.CostValue,D.RandLen,D.InvoiceValue, 0 AS IDDetailUnits, 0 AS IDDetailPerUnit, 0 AS IDDetailTotal 
		
		SELECT tmpToInvoice
		PRIVATE nCurrRec
		nCurrRec = RECNO('tmpToInvoice')
		
		PRIVATE nNewUnits, nNewPerUnit, nNewDetailItemTotal, nNewTotal
		nNewUnits = 0
		nNewPerUnit = 0
		nNewDetailItemTotal = 0
		nNewTotal = 0
		
		SCAN
		*	IF tmpToInvoice.InvoiceValue > 0
				*Do not Add to this Invoice!, I has been already invoiced
		*		LOOP
		*	ENDIF
			
			nNewUnits			= PrepareSQLnum(tmpToInvoice.Units,'Units',14,4)
			nNewPerUnit			= PrepareSQLnum(tmpToInvoice.CostValue,'CostValue',18,4)
			nNewDetailItemTotal = ROUND(nNewUnits * nNewPerUnit,2)
			nNewTotal			= ROUND(nNewTotal + nNewDetailItemTotal,2)
		ENDSCAN
		
		IF nCurrRec > RECCOUNT('tmpToInvoice')
			GO BOTTOM
		ELSE
			GOTO RECORD nCurrRec 
		ENDIF
		
		PRIVATE nInvItemTotal
		nInvItemTotal = PrepareSQLnum(ThisForm.txtInvItemTotal.Value,'InvItemTotal',-5)
		nInvItemTotal = ROUND(nInvItemTotal,4)
		
		PRIVATE nAcct_QTY, nAcct_P
		nAcct_QTY 	= PrepareSQLnum(Thisform.txtAcct_QTY.Value,'S_QTY',-5)
		nAcct_P	= PrepareSQLnum(Thisform.txtPerUnit.Value,'S_P',-5)
		
		IF nNewTotal = nInvItemTotal
			ThisForm.txtTotalDiff.Value = 0
			
			WAIT WINDOW "Totals Match!" NOWAIT
			
			ThisForm.cmdCommit.Enabled = .T.
			
			IF RECCOUNT('tmpToInvoice') = 1
		*		ThisForm.cmdCommit.Click
			ENDIF
		ELSE
			PRIVATE nVarianceH, nVarianceL
			nVarianceH = nAcct_QTY * (nAcct_P + .01) &&One penny per unit Variance
			nVarianceL = nAcct_QTY * (nAcct_P - .01) &&One penny per unit Variance
			
			IF nNewTotal >  nVarianceL AND nNewTotal < nVarianceH
				ThisForm.txtTotalDiff.Value = nNewTotal - (nAcct_QTY * nAcct_P)
				
				WAIT WINDOW "Totals are within variance!" TIMEOUT 1
				
				ThisForm.cmdCommit.Enabled = .T.
				
				IF RECCOUNT('tmpToInvoice') = 1
		*			ThisForm.cmdCommit.Click
				ENDIF
			ELSE
				ThisForm.txtTotalDiff.Value = nNewTotal - (nAcct_QTY * nAcct_P)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS cPOitem, nPO_Qty, nPO_P, nInvitemTotal, cSQL1_Vendor_Invoice_ins, cSQL2_Update_PurchaseOrder, cSQL3_Insert_Vendor_Invoice_Detail
		*DO FORM Forms\Purchase_Finalize_Lst WITH cPOitem, nRecv_Qty, nPO_P TO lReturn
		*DO FORM Forms\Purchase_Finalize_Lst WITH '   497203-02', 47, 13.7397 TO lReturn
		
		
		IF VARTYPE(cPOitem) != "C"
			MESSAGEBOX("DO FORM Forms\Purchase_Finalize_Lst WITH cPOitem, nRecv_Qty, nPO_P, nInvItemTotal TO lReturn",0+16,"Pass Parameters")
			RETURN TO MASTER
		ENDIF
		
		*ThisForm.nVendor_InvoiceID = nVendor_InvoiceID  &&VI_ID_Detail
		ThisForm.cSQL1_Vendor_Invoice_ins 	= cSQL1_Vendor_Invoice_ins
		ThisForm.cSQL2_Update_PurchaseOrder = cSQL2_Update_PurchaseOrder
		ThisForm.cSQL3_Insert_Vendor_Invoice_Detail = cSQL3_Insert_Vendor_Invoice_Detail
		
		This.Caption = This.Caption +" POitem: "+ALLTRIM(cPOitem)
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			EXIT
		ENDIF
		
		ThisForm.txtPOitem.Value	= cPOitem
		ThisForm.txtPOrder_Qty.Value	= nPO_Qty
		ThisForm.txtRecv_P.Value	= nPO_P
		
		IF VARTYPE(nInvItemTotal) = "L"
			nInvItemTotal = nPO_Qty * nPO_P
		ENDIF
		IF nInvItemTotal = 0
			nInvItemTotal = nPO_Qty * nPO_P
		ENDIF
		ThisForm.txtInvItemTotal.Value = ROUND(nInvItemTotal,2)
		
		ThisForm.LoadLst()
		
		IF USED('tmpToInvoice')
		
			*try to auto complete
			ThisForm.ShowID_DetailTotal()
			ThisForm.ShowInvoicedValue()
		
			ThisForm.SOitemUpdate()
			
			ThisForm.nTmpToInvoiceRec =  MIN(RECCOUNT('tmpToInvoice') ,RECNO('tmpToInvoice') )
		ELSE	
			ThisForm.SOitemUpdate()
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE loadlst
		PRIVATE cSQL, nSQLEXEC
		*ThisForm.LoadLst()
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		
		PRIVATE lFoundReceiving ,lFoundInHistory
		lFoundReceiving = .F.
		
		*Create Table to load with data
		cSQLLst = " SELECT "
		cSQLLst = cSQLLst+" D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,CAST(D.Weight AS INT) AS StkUnits,M.Form,'S' AS LST"
		cSQLLst = cSQLLst+",D.CostValue,D.RandLen,D.InvoiceValue, 0.0000 AS Units, 0.0000 AS IDDetailUnits"
		cSQLLst = cSQLLst+", 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal,0 AS ID_Detail_Process"
		cSQLLst = cSQLLst+" ,CAST(D.Weight AS INT) AS RcvUnits, D.CostValue AS RcvPerUnit"
		cSQLLst = cSQLLst+" ,M.ID "
		cSQLLst = cSQLLst+" FROM dbo.[AR.StockLst_Master_History M WITH(NOLOCK)"
		cSQLLst = cSQLLst+", dbo.[AR.StockLst_Detail_History D WITH(NOLOCK) "
		cSQLLst = cSQLLst+" WHERE 0>0"
		
		IF USED('tmpToInvoice')
			USE IN tmpToInvoice
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLLst, 'tmpToInvoice' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLLst, 'tmpToInvoice' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLLst, "tmpToInvoice")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLLst, "tmpToInvoice")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLLst, ThisForm.nConnHandle, 'tmpToInvoice' )
				lFailTrans = .T.
			ENDIF
		ENDIF	
		
		
		*Get Stock info from receiving!
		IF USED('tmpReceiveID')
			USE IN tmpReceiveID
		ENDIF
		SELECT 0
		*cSQL = "SELECT DISTINCT ID_Master,StockTable FROM dbo.Receiving WHERE POitem = '"+cPOitem+"'"
		cSQL = " SELECT DISTINCT ID AS ID_Master,'S' AS TBL FROM dbo.StockLst_Master WHERE PO_item = '"+cPOitem+"'"
		cSQL = cSQL+" UNION "
		cSQL = cSQL+" SELECT DISTINCT ID AS ID_Master,'S' AS TBL FROM dbo.BrokerLst_Master WHERE PO_item = '"+cPOitem+"'"
		cSQL = cSQL+" UNION "
		cSQL = cSQL+" SELECT DISTINCT ID_Master, StockTable AS TBL FROM dbo.Receiving WHERE POitem = '"+cPOitem+"'"
		cSQL = cSQL+" AND ID_Master > 0 "
		 
		 
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpReceiveID' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpReceiveID' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiveID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiveID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpReceiveID' )
				lFailTrans = .T.
			ENDIF
		ENDIF	
		
		PRIVATE cSQLLst 
		cSQLLst = ''
		
		IF USED('tmpReceiveID')
			IF VARTYPE(tmpReceiveID.ID_Master) = "N"
				SELECT tmpReceiveID
				SCAN
					IF PrepareSQLnum(tmpReceiveID.ID_Master,'ID',-3) > 0
		
						cSQLLst= ''
						DO CASE
						CASE tmpReceiveID.TBL = "S"
		
							ThisForm.lblStock.Caption = 'SC'
							cSQLLst = " SELECT TOP 1 "
							cSQLLst = cSQLLst+" D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,CAST(D.Weight AS INT) AS StkUnits,M.Form,'S' AS LST"
							cSQLLst = cSQLLst+",D.CostValue,D.RandLen,D.InvoiceValue, 0.0000 AS Units, 0.0000 AS IDDetailUnits"
							cSQLLst = cSQLLst+", 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal,0 AS ID_Detail_Process"
							cSQLLst = cSQLLst+" ,CAST(D.Weight AS INT) AS RcvUnits, D.CostValue AS RcvPerUnit"
							cSQLLst = cSQLLst+" ,M.ID "
							cSQLLst = cSQLLst+" FROM dbo.StockLst_Master M, dbo.StockLst_Detail D"
							cSQLLst = cSQLLst+" WHERE M.ID = "+STR(tmpReceiveID.ID_Master)
							cSQLLst = cSQLLst+" AND M.ID = D.ID "
		
						CASE tmpReceiveID.TBL = "B"
							ThisForm.lblStock.Caption = 'BC'
		
							cSQLLst = " SELECT TOP 1 "
							cSQLLst = cSQLLst+" D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,CAST(D.Weight AS INT) AS StkUnits,M.Form,'B' AS LST"
							cSQLLst = cSQLLst+",D.CostValue,D.RandLen,D.InvoiceValue, 0.0000 AS Units, 0.0000 AS IDDetailUnits"
							cSQLLst = cSQLLst+", 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal,0 AS ID_Detail_Process"
							cSQLLst = cSQLLst+" ,CAST(D.Weight AS INT) AS RcvUnits, D.CostValue AS RcvPerUnit"
							cSQLLst = cSQLLst+" ,M.ID "
							cSQLLst = cSQLLst+" FROM dbo.BrokerLst_Master M, dbo.BrokerLst_Detail D"
							cSQLLst = cSQLLst+" WHERE M.ID = "+STR(tmpReceiveID.ID_Master)
							cSQLLst = cSQLLst+" AND M.ID = D.ID "
											
						ENDCASE	
						
						IF NOT EMPTY(cSQLLst)				
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLLst, 'tmpToInvoice2' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLLst, 'tmpToInvoice2' )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLLst, "tmpToInvoice2")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLLst, "tmpToInvoice2")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLLst, ThisForm.nConnHandle, 'tmpToInvoice2' )
									lFailTrans = .T.
								ENDIF
							ENDIF	
							
		
							IF USED('tmpToInvoice2')
								IF VARTYPE(tmpToInvoice2.ID_Detail) = 'N'
									IF tmpToInvoice2.ID_Detail > 0
									
										INSERT INTO tmpToInvoice SELECT * FROM tmpToInvoice2
										lFoundReceiving = .T.
										
									ENDIF
								ENDIF
								USE IN tmpToInvoice2
							ENDIF
						ENDIF
					ELSE
						*tmpReceiveID.ID_Master not found
					ENDIF
				
					**************************
					SELECT tmpReceiveID
				ENDSCAN	
			ELSE
				*tmpReceiveID.ID_Master not found
			ENDIF
			USE IN tmpReceiveID
		ENDIF
		
		PRIVATE cSQLLstLive
		cSQLLstLive = ''
		
		IF NOT lFoundReceiving 
		*EMPTY(cSQLLst)
		*!*		*Did not find Receiving record.
		*!*		MESSAGEBOX("PO item:"+ALLTRIM(cPOitem)+" Does not exists in Receiving table.")
			
			*Check For HISTORY StockLst POitem entry
			IF Count_POitem_StockLst(cPOitem,"SH",ThisForm.nConnHandle) > 0
				ThisForm.lblStock.Caption = 'SH'
				cSQLLstLive = " SELECT TOP 1 "
				cSQLLstLive = cSQLLstLive+" D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,CAST(D.Weight AS INT) AS StkUnits,M.Form,'S' AS LST"
				cSQLLstLive = cSQLLstLive+",D.CostValue,D.RandLen,D.InvoiceValue, 0.0000 AS Units, 0.0000 AS IDDetailUnits"
				cSQLLstLive = cSQLLstLive+", 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal,0 AS ID_Detail_Process"
				cSQLLstLive = cSQLLstLive+" ,CAST(D.Weight AS INT) AS RcvUnits, D.CostValue AS RcvPerUnit"
				cSQLLstLive = cSQLLstLive+" ,M.ID "
				cSQLLstLive = cSQLLstLive+" FROM dbo.[AR.StockLst_Master_History M, dbo.[AR.StockLst_Detail_History D"
				cSQLLstLive = cSQLLstLive+" WHERE M.PO_item = '"+cPOitem+"'"
				cSQLLstLive = cSQLLstLive+" AND M.ID = D.ID "
		*		cSQLLstLive = cSQLLstLive+" AND M.[WHAT] = 'DELETE'"
				cSQLLstLive = cSQLLstLive+" ORDER BY D.[WHEN] DESC"
			ENDIF
			IF Count_POitem_StockLst(cPOitem,"BH",ThisForm.nConnHandle) > 0
				ThisForm.lblStock.Caption = 'BH'
				cSQLLstLive = " SELECT TOP 1 "
				cSQLLstLive = cSQLLstLive+" D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,CAST(D.Weight AS INT) AS StkUnits,M.Form,'B' AS LST"
				cSQLLstLive = cSQLLstLive+",D.CostValue,D.RandLen,D.InvoiceValue, 0.0000 AS Units, 0.0000 AS IDDetailUnits"
				cSQLLstLive = cSQLLstLive+", 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal,0 AS ID_Detail_Process"
				cSQLLstLive = cSQLLstLive+" ,CAST(D.Weight AS INT) AS RcvUnits, D.CostValue AS RcvPerUnit"
				cSQLLstLive = cSQLLstLive+" ,M.ID "
				cSQLLstLive = cSQLLstLive+" FROM dbo.[AR.BrokerLst_Master_History M, dbo.[AR.BrokerLst_Detail_History D"
				cSQLLstLive = cSQLLstLive+" WHERE M.PO_item = '"+cPOitem+"'"
				cSQLLstLive = cSQLLstLive+" AND M.ID = D.ID "
		*		cSQLLstLive = cSQLLstLive+" AND M.[WHAT] = 'DELETE'"
				cSQLLstLive = cSQLLstLive+" ORDER BY D.[WHEN] DESC"
			ENDIF
		
			IF NOT EMPTY(cSQLLstLive)
				IF USED('tmpToInvoice2')
					USE IN tmpToInvoice2
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLLstLive, 'tmpToInvoice2' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLLstLive, 'tmpToInvoice2' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLLstLive, "tmpToInvoice2")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLLstLive, "tmpToInvoice2")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQLLstLive, ThisForm.nConnHandle, 'tmpToInvoice2' )
						lFailTrans = .T.
					ENDIF
				ENDIF	
				
				IF USED('tmpToInvoice2')
					IF PrepareSQLnum(tmpToInvoice2.ID_Detail,'ID_Detail',-3) > 0
						IF tmpToInvoice2.ID_Detail > 0
						
							INSERT INTO tmpToInvoice SELECT * FROM tmpToInvoice2
							
						ENDIF
					ENDIF
					USE IN tmpToInvoice2
				ENDIF
			ENDIF
		ENDIF
		
		**************
		IF NOT lFailTrans
			IF USED('tmpToInvoice')
				SELECT tmpToInvoice
				DELETE ALL FOR ID_Detail = 0
				
				ThisForm.ReceiveTotals()
				ThisForm.ToInvoice_Totals()
				
				IF RECCOUNT('tmpToInvoice') > 0
					ThisForm.grdToInvoice.recordSource = 'tmpToInvoice'
					ThisForm.lblItemDescription.Caption = ALLTRIM(STR(PC))+"Pc "+ItemDescriptionMetric(Form,Dim1,Dim2,Dim3,MAX(StkUnits,RcvUnits),RandLen,'','','' )
					
					PRIVATE nID, cTBL
					nID  = PrepareSQLnum(tmpToInvoice.ID,'ID',-3)
					cTBL = PrepareSQLtxt(tmpToInvoice.LST,'TBL',1)
					ThisForm.lblMoreDescription.Caption = ReceiveDesc_LstID( nID, cTBL, ThisForm.nConnHandle )
					
				ELSE			
					*Nothing todo
					*MESSAGEBOX("No Stock record has been affected by this POitem",4+64,"")
					*Message now in SOitemUpdate 
				ENDIF
				SELECT tmpToInvoice
				GO TOP
			ENDIF
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE receivetotals
		*thisForm.ReceiveTotals
		
		PRIVATE nTotal
		*PRIVATE nCostValue, nInvoiceValue
		PRIVATE nRcvUnits, nRcvUnitsTotal, nRcvPerUnit
		
		nAcct_QTY	= 0
		nTotal	= 0
		nRcvUnits	= 0
		nRcvUnitsTotal = 0
		nRcvPerUnit	= 0
		
		SELECT tmpToInvoice
		*REPLACE tmpToInvoice.Units WITH 0
			
		SCAN
			nRcvUnits = PrepareSQLnum(tmpToInvoice.RcvUnits,'RcvUnits',-5)
			nRcvUnitsTotal = nRcvUnitsTotal + nRcvUnits 
		
			nRcvPerUnit	= PrepareSQLnum(tmpToInvoice.RcvPerUnit,'RcvPerUnit',-5)
			
			nTotal	= 	nTotal + (nRcvUnits * nRcvPerUnit)
			
			SELECT tmpToInvoice
		ENDSCAN
		
		
		IF nRcvUnitsTotal > 0
			ThisForm.txtSumUnits.Value = nRcvUnitsTotal 
		ELSE
			ThisForm.txtSumUnits.Value = 0
		ENDIF
		
		IF nTotal > 0
			ThisForm.txtSumTotal.Value = nTotal
		ELSE
			ThisForm.txtSumTotal.Value = 0
		ENDIF
		
		IF nRcvUnitsTotal > 0 AND nTotal > 0
			ThisForm.txtSumPerUnit.Value = nTotal / nRcvUnitsTotal 
		ELSE
			ThisForm.txtSumPerUnit.Value = 0
		ENDIF
		
		SELECT tmpToInvoice
		GO TOP IN tmpToInvoice
	ENDPROC

	PROCEDURE savetostocklst
		*ThisForm.SavetoStockLst()
		SELECT tmpToInvoice
		
		*SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Units,D.Unit,M.Form,D.CostValue,D.RandLen,
		*D.InvoiceValue, 0 AS IDDetailUnits, 0 AS IDDetailPerUnit, 0 AS IDDetailTotal 
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		
		PRIVATE lFailTrans 
		lFailTrans = .F.
		
		***********************************************************************************************
		PRIVATE nID,nID_Detail, nIDDetailUnits, nIDDetailPerUnit
		PRIVATE cTBL,nID_Detail_Process, nVendor_InvoiceID 
		PRIVATE cSQL, nSQLEXEC
		
		SELECT 0
		*EXEC dbo.p_Vendor_Invoice_ins "
		cSQL = ThisForm.cSQL1_Vendor_Invoice_ins
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendor_Invoice_ins' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendor_Invoice_ins' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendor_Invoice_ins")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendor_Invoice_ins")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpVendor_Invoice_ins' )
				lFailTrans = .T.
				TrackError(PrepareSQLtxt(cSQL,'SQL',8000),"Purchase_Finalize_Lst",Program(),LINENO(1))
				MESSAGEBOX(cSQL,0+64,"Please show to David")
			ENDIF
		ENDIF	
		
		IF USED('tmpVendor_Invoice_ins')
			IF VARTYPE(tmpVendor_Invoice_ins.EXP) = 'N'
				nVendor_InvoiceID = tmpVendor_Invoice_ins.EXP
				ThisForm.nVendor_InvoiceID = nVendor_InvoiceID 
			ENDIF
			USE IN tmpVendor_Invoice_ins
		ELSE
			lFailTrans = .T.
		ENDIF
		
