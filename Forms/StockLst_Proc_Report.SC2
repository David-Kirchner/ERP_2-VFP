	PROCEDURE showstocklst_detail
		PARAMETER pnID_Detail
		*ThisForm.ShowStockLst_Detail( nID )
		
		*********************************************
		
		IF TYPE("pnID_Detail") != "N"
			RETURN .F.
		ENDIF
		
		IF USED("tmpStockLstD")
			USE IN tmpStockLstD
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT m.Alloy,m.Specs,m.Heat,d.Descript, d.S_P, d.S_PU "
		cSQL = cSQL + " ,P.* "
		
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail D "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail D"
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Detail D"
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
		OTHERWISE
			TrackError("Did not get a TBL"," TBL:"+ThisForm.cTBL,"StockLst_Process:ShowStockLst_Detail",LINENO(1) )
		ENDCASE
		
		cSQL = cSQL + " WHERE D.ID_Detail = "+STR(pnID_Detail)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstD')
		ELSE
			IF USED("tmpStockLstD")
				ThisForm.txtAlloy.Value		= ShowSQLtxt(tmpStockLstD.Alloy,'Alloy',12)
				ThisForm.txtSpecs.Value		= ShowSQLtxt(tmpStockLstD.Specs,'Specs',160)
				ThisForm.txtHeat.Value		= ShowSQLtxt(tmpStockLstD.Heat,'Heat',50)
				ThisForm.txtDescript.Value	= ShowSQLtxt(tmpStockLstD.Descript,'Descript',100)
				ThisForm.S_PU.Value			= PrepareSQLtxt(tmpStockLstD.S_PU,'S_PU',1)
		
				ThisForm.txtAlloy.Visible	= .T.
				ThisForm.txtSpecs.Visible	= .T.
				ThisForm.txtHeat.Visible	= .T.
				ThisForm.txtDescript.Visible	= .T.
			
				ThisForm.lblAlloy.Visible	= .T.
				ThisForm.lblSpecs.Visible	= .T.
				ThisForm.lblHeat.Visible	= .T.
				ThisForm.lblDescript.Visible	= .T.		
			ENDIF
		ENDIF
		
		PRIVATE cDescription
		cDescription = get_Description_ID_Detail( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle, .T. )
		ThisForm.txtDescript.Value	= ShowSQLtxt(cDescription,'Descript',100)
		
		********
		IF USED("tmpStockLstD")
		*	USE IN tmpStockLstD
			ThisForm.grdProcess.RecordSource = "tmpStockLstD"
			ThisForm.grdProcess.COLUMN1.ControlSource = "tmpStockLstD.ID_Detail_Process"
			ThisForm.grdProcess.Refresh
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE soldmemvar
		PARAMETER pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pPoItem
		*ThisForm.SoldMemVar()
		
		IF TYPE("pSOitem") = "C"
			IF Proper_PO_item(pSOitem) != Proper_PO_item('')
				ThisForm.SOitem1.Value = pSOitem
				ThisForm.SOITEM1.Enabled = .F.
				ThisForm.PO_ITEM1.Enabled = .F.
			ELSE
				ThisForm.SOitem1.Value = SPACE(10)
			ENDIF
		ELSE
			ThisForm.SOitem1.Value = SPACE(10)
		ENDIF
		
		IF TYPE("pSalesP") = "C"
			IF NOT EMPTY(pSalesP)
				ThisForm.SalesPerson1.Value = SalesPDescription(pSalesP,'')
			ELSE
				ThisForm.SalesPerson1.Value = SPACE(20)
			ENDIF
		ELSE
			ThisForm.SalesPerson1.Value = SPACE(20)
		ENDIF
		
		IF TYPE("pSalesDate") = "D"
			IF pSalesDate>CTOD("01/01/1900")
				ThisForm.StartDate1.Value = PrepareSQLdateTime(pSalesDate,'StartDate', .F.,.T.)
			ELSE
				ThisForm.StartDate1.Value = DATETIME()
			ENDIF
		ELSE
			IF TYPE("pSalesDate") = "T"
				IF pSalesDate>CTOD("01/01/1900")
					ThisForm.StartDate1.Value = TTOD(pSalesDate)
				ELSE
					ThisForm.StartDate1.Value = DATETIME()
				ENDIF
			ELSE
				ThisForm.StartDate1.Value= DATETIME()
			ENDIF
		ENDIF
		
		
		*****
		PRIVATE cDescript, nS_QTY
		*, nQShipped, nQBackOrder
		cDescript = ''
		nS_QTY = 0
		
		***********
		*Get from Sales
		IF Proper_PO_item(pSOitem) != Proper_PO_item('')
			PRIVATE cSQL
			
			IF USED('tmpSales_SD')
				USE IN tmpSales_SD
			ENDIF
			SELECT 0
			
			cSQL = "SELECT dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS Descript "
			cSQL=cSQL+" ,S.ShipDue "
			cSQL=cSQL+" ,S.S_QTY "
			*, S.QShipped, S.QBackOrder "
			cSQL=cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
			cSQL=cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON AQ.SOitem = S.SOitem "
			cSQL=cSQL+" WHERE AQ.SOItem = dbo.f_ProperSOitem('"+pSOitem+"') "
		
		
			IF USED("tmpSales_SD")
				SELECT tmpSales_SD
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_SD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_SD')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_SD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_SD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle , nSQLEXEC, 'tmpSales_SD')
			ELSE
				IF USED("tmpSales_SD")
					IF RECCOUNT('tmpSales_SD') > 0
			*			ThisForm.txtDescript.Value	= PrepareSQLtxt(tmpSales_SD.Descript,'Descript',100)
						*ThisForm.Duedate1.Value	= PrepareSQLdate(tmpSales_SD.ShipDue,'ShipDue')
						pShipDue					= PrepareSQLdate(tmpSales_SD.ShipDue,'ShipDue')
						cDescript	= ShowSQLtxt(tmpSales_SD.Descript,'Descript',100)
						nS_QTY		= PrepareSQLnum(tmpSales_SD.S_QTY,'S_QTY',-5)		&&Total for SOitem
						*nQShipped	= PrepareSQLnum(tmpSales_SD.QShipped,'QShipped',-5)
						*nQBackOrder	= PrepareSQLnum(tmpSales_SD.QBackOrder,'QBackOrder',-5)
					ENDIF
							
					USE IN tmpSales_SD
				ENDIF
			ENDIF
		ENDIF
		
		***********
		
		IF TYPE("pShipDue") = "D"
			IF pShipDue>CTOD("01/01/1900")
				ThisForm.DueDate1.Value = pShipDue
			ELSE
				*Find in Sales
				ThisForm.DueDate1.Value = CTOD("  /  /  ")
			ENDIF
		ELSE
			IF TYPE("pShipDue") = "T"
				IF pShipDue>CTOD("01/01/1900")
					ThisForm.DueDate1.Value = TTOD(pShipDue)
				ELSE
					*Find in Sales
					ThisForm.DueDate1.Value = CTOD("  /  /  ")
				ENDIF
			ELSE
				ThisForm.DueDate1.Value = CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		
		ThisForm.chkAllowSub.Value = 1
		
		PRIVATE nLBS, nQTY
		nLBS	= PrepareSQLnum(pLBS,'Pounds',9,1)
		nQTY	= PrepareSQLnum(pQTY,'QTY',-5)
		
		IF nQTY = 0 AND nS_QTY > 0
			nQTY = nS_QTY
		ENDIF
		
		ThisForm.Pounds1.Value = nLBS
		ThisForm.Qty1.Value = nQTY 		&&ERP Acct Standard QTY total for Sale
		*ThisForm.P_Qty.Value = 
		
		***********
		*Get from Purchase
		
		IF TYPE("pPOitem") = "C"
			IF NOT EMPTY(pPOitem)
				ThisForm.PO_Item1.Value = pPOitem
				ThisForm.GetFromPOitem(pPOitem)
			ELSE
				ThisForm.PO_Item1.Value = SPACE(11)
			ENDIF
		ELSE
			ThisForm.PO_Item1.Value = SPACE(11)
		ENDIF
		
		
		*****
		ThisForm.Process_ID1.Value = "SELECTED"
		ThisForm.PROCESS_ID1.Enabled = .F.
		
		ThisForm.Processor1.Value = SPACE(20)
		ThisForm.PROCESSOR1.Enabled = .F.
		
		IF TYPE("pComment") = "C"
			IF NOT EMPTY(pComment)
				ThisForm.Comment1.Value = pComment
			ELSE
				ThisForm.Comment1.Value = ''
			ENDIF
		ELSE
			ThisForm.Comment1.Value = ''
		ENDIF
		
		m.ID_Detail_Process = 0
		ThisForm.ID_Detail_Process1.Value = 0
		
		IF EMPTY(ThisForm.SALESPERSON1.Value)
			PRIVATE cMach_User 
			cMach_User = SYS(0)
			ThisForm.SALESPERSON1.Value = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		ENDIF
	ENDPROC

	PROCEDURE sumprocess
		*ThisForm.SumProcess()
		PRIVATE nID_DetailS_QTY, nSOS_QTY, nWOS_QTY, nStockLst_QTY
		nID_DetailS_QTY = 0
		nSOS_QTY = 0
		nWOS_QTY = 0
		nStockLst_QTY = 0
		
		PRIVATE nSOitemQTY, nSOiSelQTY, nWOQTY, nPartSelect_QTY, nBalanceQTY
		nSOitemQTY = 0
		nSOiSelQTY = 0
		nWOQTY = 0
		nPartSelect_QTY = 0
		nBalanceQTY	= 0
		
		PRIVATE cSOitem
		cSOitem	= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		
		***
		IF USED("cntStockQty")
			USE IN cntStockQty
		ENDIF
		
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = "SELECT S_QTY FROM dbo.StockLst_Detail "
		CASE ThisForm.cTBL = "B"
			cSQL = "SELECT S_QTY FROM dbo.BrokerLst_Detail "
		CASE ThisForm.cTBL = "W"
			cSQL = "SELECT S_QTY FROM dbo.WIPLst_Detail "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(THISFORM.ID_Detail)+""
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 1
			SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntStockQty')
		ELSE
			IF USED('cntStockQty')
				IF RECCOUNT('cntStockQty') > 0
					nID_DetailS_QTY = PrepareSQLnum(cntStockQty.S_QTY,'QTY',18,4)
				ENDIF
				USE IN cntStockQty
			ENDIF
		ENDIF
		
		***
		IF cSOitem	!= Proper_SO_Item('')
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM dbo.StockLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE ThisForm.cTBL = "B"
				cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM dbo.BrokerLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "	
			CASE ThisForm.cTBL = "W"
				cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM dbo.WIPLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
			ENDCASE
		
			cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOS_QTY = PrepareSQLnum(cntStockQty.S_QTY,'S_QTY',18,4)
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF ThisForm.nWO > 0
			*nWO = ThisForm.nWO
			
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = "SELECT SUM(D.S_QTY) AS S_QTY FROM dbo.StockLst_Detail D"
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE ThisForm.cTBL = "B"
				cSQL = "SELECT SUM(D.S_QTY) AS S_QTY FROM dbo.BrokerLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "	
			CASE ThisForm.cTBL = "W"
				cSQL = "SELECT SUM(D.S_QTY) AS S_QTY FROM dbo.WIPLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
			ENDCASE
		
			IF ThisForm.nWO > 0
				cSQL = cSQL + " WHERE P.WO = "+STR(ThisForm.nWO)+""
				cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
			ELSE
				cSQL = cSQL + " WHERE ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
			ENDIF	
			IF cSOitem	!= Proper_SO_Item('')
				cSQL = cSQL + " AND NOT P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nWOS_QTY = PrepareSQLnum(cntStockQty.S_QTY,'S_QTY',18,4)
						*nWOS_QTY = PrepareSQLnum(cntStockQty.S_QTY,'QTY',18,4)
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF cSOitem	!= Proper_SO_Item('')
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			cSQL = "SELECT Quoted_QTY FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOitemQTY = PrepareSQLnum(cntStockQty.Quoted_QTY,'QTY',18,4)
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		
		***
		
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM dbo.StockLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE ThisForm.cTBL = "B"
				cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM dbo.BrokerLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE ThisForm.cTBL = "W"
				cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM dbo.WIPLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
			ENDCASE
				
			cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOiSelQTY = PrepareSQLnum(cntStockQty.S_QTY,'QTY',18,4)
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF ThisForm.nWO > 0
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			cSQL = "SELECT sWeight FROM dbo.WorkOrder "
			cSQL = cSQL + " WHERE WO = "+STR(ThisForm.nWO)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nWOQTY = PrepareSQLnum(cntStockQty.sWeight,'Weight',7,1)
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		nPartSelect_QTY = get_PartialPick_QTY(cSOitem,ThisForm.nWO,ThisForm.nConnHandle)
		***
		*!*	IF USED("cntStockQty")
		*!*		USE IN cntStockQty
		*!*	ENDIF
		
		*!*	DO CASE
		*!*	CASE ThisForm.cTBL = "S"
		*!*		cSQL = "SELECT SUM(QTY) AS QTY FROM dbo.StockLst_Process "
		*!*	CASE ThisForm.cTBL = "B"
		*!*		cSQL = "SELECT SUM(QTY) AS QTY FROM dbo.BrokerLst_Process "
		*!*	CASE ThisForm.cTBL = "W"
		*!*		cSQL = "SELECT SUM(QTY) AS QTY FROM dbo.WIPLst_Detail "
		*!*	ENDCASE
		
		*!*	IF ThisForm.nWO > 0	
		*!*		cSQL = cSQL + " WHERE WO = "+STR(ThisForm.nWO)+""
		*!*		cSQL = cSQL + " AND Process_ID = 'PARTSELECT'"
		*!*	ELSE
		*!*		IF cSOitem	!= Proper_SO_Item('')
		*!*			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*			cSQL = cSQL + " AND Process_ID = 'PARTSELECT'"
		*!*		ELSE
		*!*			*No WO or SOitem
		*!*			cSQL = "SELECT 0 AS QTY"
		*!*		ENDIF
		*!*	ENDIF
		*!*		
		*!*	SELECT 0
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockQty')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockQty")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 	
		*!*	IF nSQLEXEC < 1
		*!*		SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntStockQty')
		*!*	ELSE
		*!*		IF USED('cntStockQty')
		*!*			IF RECCOUNT('cntStockQty') > 0
		*!*				nPartSelect_QTY = PrepareSQLnum(cntStockQty.QTY,'QTY',18,4)
		*!*			ENDIF
		*!*			USE IN cntStockQty
		*!*		ENDIF
		*!*	ENDIF
		
		******************************************************
		***This code also exists in SumProcess and cmdConsume
		
		***
		nStockLst_QTY = PrepareSQLnum(ThisForm.QTY1.Value,'StockLst_QTY',-5)
		***
		
		ThisForm.txtSOitemQTY.Value = nSOitemQTY
		*ThisForm.txtSOS_QTY.Value = nSOS_QTY 
		ThisForm.txtSOS_QTY.Value = nSOiSelQTY
		
		Thisform.txtWOQTY.Value = nWOQTY 
		ThisForm.txtWOS_QTY.Value = nWOS_QTY
		
		ThisForm.txtID_DetailS_QTY.Value = nID_DetailS_QTY
		
		IF nID_DetailS_QTY > nStockLst_QTY
			ThisForm.txtID_DetailS_QTY.DisabledForeColor = RGB(255,0,0)
		ENDIF
		
		ThisForm.txtPP_QTY.Value = nPartSelect_QTY 
		
		nBalanceQTY = nID_DetailS_QTY - nSOitemQTY - nSOiSelQTY - nWOQTY - nWOS_QTY
		ThisForm.txtBalance.Value = nBalanceQTY
		*nStockLst_QTY - nSOitemQTY - nWOQTY - nWOS_QTY + nPartSelect_QTY + nSOiSelQTY
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
		RETURN ThisForm.ID_Detail_Process
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.ID_Detail_Process = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdReport.Click
		ThisForm.AlwaysOnTop = .F.
		*DO FORM Forms\StockLst_Detail_History WITH 0, ThisForm.ID_Detail_Process1.Value, 0, ThisForm.cTBL, 0
		DO FORM Forms\StockLst_Detail_History WITH ThisForm.ID_Detail_Process1.Value, ThisForm.cTBL
		*Parameter SOitem, Process
		ThisForm.AlwaysOnTop = .T.
		
		
	ENDPROC

	PROCEDURE lblDescript.Click
		PRIVATE cDescript,cComment
		cDescript	= ALLTRIM(Thisform.txtDescript.value)
		cComment	= ALLTRIM(ThisForm.Comment1.Value)
		IF LEN(cComment) > 1
			cComment = cComment + CHR(13)
		ELSE
			cComment = ''
		ENDIF
		IF NOT "for:" $ cComment
			ThisForm.Comment1.Value = ShowSQLtxt(cComment+"for:"+cDescript,'Comment',100)
		ENDIF
		
	ENDPROC

	PROCEDURE LBLDUEDATE1.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.DUEDATE1.Value)
			dDate1 = ThisForm.DUEDATE1.Value 
		ELSE
			dDate1 = DATE()
		ENDIF
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		ThisForm.AlwaysOnTop = .T.
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.DUEDATE1.Value = dDate2
	ENDPROC

	PROCEDURE lblPO_Item.Click
		*ThisForm.nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',10)
		
		PRIVATE cSOitem, cPOitem 
		cSOitem = PrepareSQLtxt(ThisForm.SOITEM1.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(ThisForm.PO_Item1.Value,'POitem',12)
		PRIVATE vcPOitem
		vcPOitem = ''
		
		ThisForm.AlwaysOnTop = .F.
		IF cPOitem <> Proper_PO_Item('')
			DO FORM Forms\SelectPO_Item WITH cPOItem, 'POitem' TO vcPOitem
		ELSE
			IF cSOitem <> Proper_SO_Item('')
				DO FORM Forms\SelectPO_Item WITH PROPER_SO_Item_SO(cSOItem), 'SalesNum' TO vcPOitem
			ELSE
				DO FORM Forms\SelectPO_Item TO vcPOitem
			ENDIF
		ENDIF
		ThisForm.AlwaysOnTop = .T.
		
		PRIVATE cText
		cText = ''
		IF VARTYPE(vcPOitem) = "C"
			IF NOT EMPTY(vcPOitem)
				cText = "New POitem="+ALLTRIM(vcPOitem)+"!"
				cText = cText +CHR(13)+"Old POitem="+ALLTRIM(cPOitem)+"!"
				IF MESSAGEBOX("Do you wish to replace the POitem?"+CHR(13)+cText,4+32,"Change PO data") = 6
					*needs Permission , verified.
					
					ThisForm.PO_Item1.Value = vcPOitem
					cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
					
					TrackError("Info","User to replace the POitem. "+cText,"StockLst_Process",LINENO(1))
					TrackMess( "User to replace the POitem. "+cText )
				ENDIF
			ENDIF
		ENDIF
		
		IF vcPOitem = Proper_PO_item('')
			cText = "Old POitem="+ALLTRIM(cPOitem)+"!"
			IF MESSAGEBOX("Do you wish to Erase this PO?"+CHR(13)+cText,4+32,"Remove PO data") = 6
				ThisForm.PO_Item1.Value = ""
				
				cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
				TrackMess( "User erased the POitem. "+cText )
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE LBLSALESPERSON1.Click
		PRIVATE cMach_User 
		cMach_User = SYS(0)
		ThisForm.SALESPERSON1.Value = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
	ENDPROC

	PROCEDURE LBLSOITEM1.Click
		PRIVATE vcSOitem, cSOitem, nSO
		cSOitem = PrepareSQLtxt(ThisForm.SOITEM1.Value,'SOitem',10)
		nSO = Proper_SO_Item_SO(cSOitem)
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\Select_SO-item WITH nSO TO vcSOitem
		ThisForm.AlwaysOnTop = .T.
		
		PRIVATE cText
		cText = ''
		IF VARTYPE(vcSOitem) = "C"
			IF Proper_SO_item(vcSOitem) <> Proper_SO_item('')
				vcSOitem = Proper_SO_item(vcSOitem)
			ENDIF
		ELSE
			vcSOitem = Proper_SO_item('')
		ENDIF
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			IF Proper_SO_item(cSOitem) = Proper_SO_item(vcSOitem)
				*Already match.
			ELSE
				cText = "New SOitem="+ALLTRIM(vcSOitem)+"!"
				cText = cText +CHR(13)+"Old SOitem="+ALLTRIM(cSOitem)+"!"
				
				IF MESSAGEBOX("Do you wish to replace the SOitem?"+CHR(13)+cText,4+32,"Change SO data") = 6
					*needs Permission , verified.
					
					ThisForm.SOItem1.Value = vcSOitem
					cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
						
					TrackError("Info","User wished to replace the SOitem. "+cText,"StockLst_Process",LINENO(1))
					TrackMess( "User to replace the SOitem. "+cText )
				ENDIF
			ENDIF
		ENDIF
		
		IF vcSOitem = Proper_SO_item('')
			cText = "Old SOitem="+ALLTRIM(cSOitem)+"!"
			IF MESSAGEBOX("Do you wish to Erase this?"+CHR(13)+cText,4+32,"Remove SO data") = 6
				ThisForm.SOItem1.Value = ""
				
				cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
				TrackMess( "User erased the SOitem. "+cText )
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE lblWO.Click
		PRIVATE vnWO
		
		PRIVATE cSOitem, cPOitem 
		cSOitem = PrepareSQLtxt(ThisForm.SOITEM1.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(ThisForm.PO_Item1.Value,'POitem',12)
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\Select_WorkOrder WITH cSOitem, cPOitem TO vnWO
		ThisForm.AlwaysOnTop = .T.
		
		PRIVATE cText
		cText = ''
		
		IF VARTYPE(vnWO) != "N"
			vcWO = 0
		ENDIF
		
		
		IF ThisForm.nWO = vnWO AND vnWO > 0
			ThisForm.txtWO.Value = vnWO
			*Already there.
		ELSE
			cText = "New WO="+ALLTRIM(STR(vnWO))+"!"
			cText = cText +CHR(13)+"Old WO="+ALLTRIM(STR(ThisForm.nWO))+"!"
			IF MESSAGEBOX("Do you wish to replace the WO?"+CHR(13)+cText,4+32,"Change WO data") = 6
				*needs Permission , verified.
				
				ThisForm.txtWO.Value = vnWO
				ThisForm.nWO = vnWO
				cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
				
				TrackError("Info","User to replace the WO. "+cText,"StockLst_Process",LINENO(1))
				TrackMess( "User to replace the WO. "+cText )
		
		
			ENDIF
		ENDIF
		
		
		IF vnWO = 0
			cText = "Old WO="+ALLTRIM(STR(ThisForm.nWO))+"!"
			IF MESSAGEBOX("Do you wish to Remove this WO?"+CHR(13)+cText,4+32,"Remove WO data") = 6
				ThisForm.txtWO.Value = 0
				ThisForm.nWO = 0
				
				cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
				TrackMess( "User removed the WO. "+cText )
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE lblWO_Detail.Click
		PRIVATE vnWO_Detail
		PRIVATE cSOitem, cPOitem 
		cSOitem = PrepareSQLtxt(ThisForm.SOITEM1.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(ThisForm.PO_Item1.Value,'POitem',12)
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\Select_WorkOrder WITH cSOitem, cPOitem TO vnWO_Detail
		ThisForm.AlwaysOnTop = .T.
		
		PRIVATE cText
		cText = ''
		
		IF VARTYPE(vnWO_Detail) = "N"
			vcWO_Detail = 0
		ENDIF
		
		
		IF ThisForm.nWO_Detail = vnWO_Detail AND vnWO_Detail > 0
			*Already there.
		ELSE
			cText = "New WO_Detail="+ALLTRIM(STR(vnWO_Detail))+"!"
			cText = cText +CHR(13)+"Old WO_Detail="+ALLTRIM(STR(ThisForm.nWO_Detail))+"!"
			IF MESSAGEBOX("Do you wish to replace the WO_Detail?"+CHR(13)+cText,4+32,"Change WO_Detail data") = 6
				*needs Permission , verified.
				
				ThisForm.txtWO_Detail.Value = vnWO_Detail
				ThisForm.nWO_Detail = vnWO_Detail
				cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
				
				TrackError("Info","User replaced the WO_Detail. "+cText,"StockLst_Process",LINENO(1))
				TrackMess( "User replaced the WO_Detail. "+cText )
		
		
			ENDIF
		ENDIF
		
		
		IF vnWO_Detail = 0
			cText = "Old WO_Detail="+ALLTRIM(STR(ThisForm.nWO_Detail))+"!"
			IF MESSAGEBOX("Do you wish to Remove this WO_Detail?"+CHR(13)+cText,4+32,"Remove WO_detail data") = 6
				ThisForm.txtWO_Detail.Value = 0
				ThisForm.nWO_Detail = 0
				
				cText = cText +CHR(13)+"SOitem ='"+cSOitem+"' TBL='"+PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)+" ID_Detail_Process="+STR(PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3))+", ID_Detail="+STR(PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3))
				TrackMess( "User removed the WO_Detail. "+cText )
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE PO_Item1.DblClick
		PRIVATE nPO
		nPO = PrepareSQLnum(This.Value,'HPAPO',-3)
		IF nPO > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_PO(nPO,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
		
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE PO_Item1.Valid
		PRIVATE cPOitem, nWO, cSOitem
		cPOitem = PrepareSQLtxt(This.Value,'POitem',12)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		cSOitem = PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		
		IF cPOitem = Proper_PO_item('') AND nWO = 0 AND cSOitem = Proper_SO_item('')
			MESSAGEBOX("PO item not correct!",0,"PO item Error")
		ELSE
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_POitem(cPOitem,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
		
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE SOITEM1.DblClick
		PRIVATE loIE, nSO
		nSO = PrepareSQLnum(This.Value,'SalesNum',-3)
		IF nSO > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_SO(nSO,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
		
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		*	loIE.Navigate(get_Report_Server()+"%2fHPA+Sales+Reports%2fSalesOrders&rs:Command=Render&soNum="+ALLTRIM(STR(nSO)) )
		
		ENDIF
		
	ENDPROC

	PROCEDURE SOITEM1.Valid
		PRIVATE nSalesNum, nItem, cSOitem
		
		cSOitem = This.Value
		nSalesNum = VAL( LEFT( cSOitem, 7) )
		nItem = VAL( RIGHT( cSOitem, 2) )
		PRIVATE cPOitem, nWO
		cPOitem = PrepareSQLtxt(ThisForm.PO_Item1.Value,'POitem',12)
		nWO	= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		IF cPOitem = Proper_PO_item('') AND nWO = 0 
			*Need this SO
			IF nSalesNum > 0
				IF nItem > 0
					IF AT("-",cSOitem) < 4
						MESSAGEBOX("Sales Number Item not correct!"+CHR(13)+"Did not Find Hyphen '-' .",0,"SO item Error")
					ENDIF
				ELSE
					MESSAGEBOX("Sales Number Item not correct!",0,"SO item Error")
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

