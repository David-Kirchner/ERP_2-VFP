	PROCEDURE get_orders_selected
		
		*ThisForm.Get_Orders_Selected()
		IF USED('tmpOrders_Sel')	
			ThisForm.grd_Orders_Sel.RecordSource = ''
			USE IN tmpOrders_Sel
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT SP.SOitem, CAST(SP.QTY AS Numeric(9,1)) AS QTY1, SP.Comment, SP.DueDate, SP.ID_Detail_Process, SP.* "
		cSQL = cSQL +" FROM dbo.StockLst_Process SP "
		cSQL = cSQL +" WHERE SP.ID_Detail IN "
		cSQL = cSQL +" (SELECT DISTINCT ID_Detail FROM dbo.StockLst_Process "
		cSQL = cSQL +" WHERE WO_Detail = "+STR(nWO_Detail)+" )"
		cSQL = cSQL +" AND SP.Process_ID = 'SELECTED' ORDER BY SP.ID_Detail, SP.SOitem "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrders_Sel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpOrders_Sel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Sel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Sel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOrders_Sel')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpOrders_Sel')
				IF RECCOUNT('tmpOrders_Sel') > 0
					lFound_WOD = .T.
					PRIVATE nSelQty
					SET TALK OFF
					SUM QTY1 TO nSelQty FOR Process_ID = 'SELECTED' 
					ThisForm.txtSelQty.Value = ROUND(nSelQty,1)
					IF ThisForm.txtSelQty.Value > ThisForm.txtFWeight.Value
						ThisForm.txtSelQty.BackColor = RGB(255,0,10)				
					ENDIF
					GO TOP
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpOrders_Sel') AND lFound_WOD 
			ThisForm.grd_Orders_Sel.RecordSource = 'tmpOrders_Sel'
			*ThisForm.grd_Orders_Sel.Visible = .T.
			ThisForm.RefreshOrder_Sel()
			
		ENDIF
				
	ENDPROC

	PROCEDURE get_orders_track
		
		*ThisForm.Get_Orders_Track()
		IF USED('tmpOrders_Track')	
			ThisForm.grd_Orders_Track.RecordSource = ''
			USE IN tmpOrders_Track
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT [SOitem],[QTY],[ID_Detail_Process],[ID] "
		cSQL = cSQL +" FROM dbo.[WOD_Orders] "
		cSQL = cSQL +" WHERE WO_Detail = "+STR(nWO_Detail)
		cSQL = cSQL +" ORDER BY SOitem "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrders_Track')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpOrders_Track')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Track")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Track")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOrders_Track')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpOrders_Track')
				IF RECCOUNT('tmpOrders_Track') > 0
					lFound_WOD = .T.
					PRIVATE nTrackQty
					SET TALK OFF
					SUM QTY TO nTrackQty &&FOR Process_ID = 'SELECTED' 
					ThisForm.txtTrackQTY.Value = ROUND(nTrackQty ,1)
					IF ThisForm.txtTrackQTY.Value > ThisForm.txtFWeight.Value
						ThisForm.txtTrackQTY.BackColor = RGB(255,0,10)				
					ENDIF
					GO TOP
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpOrders_Track') AND lFound_WOD 
			ThisForm.grd_Orders_Track.RecordSource = 'tmpOrders_Track'
			ThisForm.RefreshOrder_Track()
			
		ENDIF
				
	ENDPROC

	PROCEDURE get_wod_po
		*ThisForm.Get_WOD_PO()
		
		IF USED('tmpWOD_PO')	
			ThisForm.grd_WOD_PO.RecordSource = ''
			USE IN tmpWOD_PO
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT [WO_Detail],[POitem],[Company] "
		cSQL = cSQL +" ,dbo.f_BestDate( [Due_Min],[Due_Max]) AS DueDate "
		cSQL = cSQL +" ,dbo.f_BestDate( [HPA_Due_Min],[HPA_Due_Max]) AS HPADueDate "
		cSQL = cSQL +" ,[Received],Cmplt "
		cSQL = cSQL +" ,(case when SOitem = 'LabService' then 1 else 0 end ) AS Testing "
		cSQL = cSQL +" ,(case when SOitem = 'ConvertSVC' then 1 else 0 end ) AS ConvertSVC "
		cSQL = cSQL +" FROM dbo.[PurchaseOrder] "
		cSQL = cSQL +" WHERE ISNULL(WO_Detail,0) = "+STR(nWO_Detail)
		cSQL = cSQL +" AND Cancelled = 0 "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOD_PO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOD_PO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWOD_PO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWOD_PO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWOD_PO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOD_PO')
				*IF RECCOUNT('tmpWOD_PO') > 0
					
				*ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpWOD_PO') 
			ThisForm.grd_WOD_PO.RecordSource = 'tmpWOD_PO'
			*ThisForm.grd_WOD_PO.Visible = .T.
			ThisForm.RefreshWOD_PO()
			
		ENDIF
				
	ENDPROC

	PROCEDURE refreshorder_sel
		
		*ThisForm.RefreshOrder_Sel()
		Thisform.txtSOitem.Value = tmpOrders_Sel.SOitem
		ThisForm.txtQTY1.Value	= tmpOrders_Sel.QTY1
		ThisForm.txtDueDate.Value = tmpOrders_Sel.DueDate
		ThisForm.chkSub.Value = IIF(tmpOrders_Sel.AllowSub = 'Y',.T.,.F.)
		ThisForm.txtWOD_Sel.Value = tmpOrders_Sel.WO_Detail
		IF tmpOrders_Sel.WO_Detail = 0
			ThisForm.cmdAddWO_Detail.Visible = .T.
			ThisForm.cmdRemoveWOD_Proc.Visible = .F.
		ELSE
			ThisForm.cmdAddWO_Detail.Visible = .F.
			ThisForm.cmdRemoveWOD_Proc.Visible = .T.
		ENDIF
	ENDPROC

	PROCEDURE refreshorder_track
		*Thisform.RefreshOrder_Track()
		
		
		Thisform.txtSOitemT.Value = tmpOrders_Track.SOitem
		ThisForm.txtQTY0.Value	= tmpOrders_Track.QTY
		ThisForm.txtID_D_P.Value = tmpOrders_Track.ID_Detail_Process
		*ThisForm.chkSub.Value = IIF(tmpOrders_Track.AllowSub = 'Y',.T.,.F.)
	ENDPROC

	PROCEDURE refreshwod_po
		*ThisForm.RefreshWOD_PO()
		
		ThisForm.txtPOitem.Value	= tmpWOD_PO.POitem
		ThisForm.txtVendor.Value	= tmpWOD_PO.Company
		ThisForm.chkPO_Testing.Value = tmpWOD_PO.Testing
		ThisForm.chkPO_SVC.Value 	= tmpWOD_PO.ConvertSVC
		ThisForm.txtPO_DueDate.Value 	= tmpWOD_PO.DueDate
		ThisForm.txtPO_Received.Value	= tmpWOD_PO.Received
		ThisForm.chkPO_Complete.Value	= tmpWOD_PO.Cmplt 
	ENDPROC

	PROCEDURE frmWO_Detail_SO.cmdEditQTY.Click
		DODEFAULT()
	ENDPROC

	PROCEDURE frmWO_Detail_SO.Init
		PARAMETER pnWO_Detail, nTop, nLeft
		*DO FORM Forms\WO_Detail_SO WITH nWO_Detail 
		
		nWO_Detail = 2313
		
		*ThisFormSet.frmWO_Detail_SO.Top = ThisFormSet.frmWorkOrder.Top + 250
		*ThisFormSet.frmWO_Detail_SO.LEFT = ThisFormSet.frmWorkOrder.LEFT + ThisFormSet.frmWorkOrder.Width
					
		ThisFormSet.frmWO_Detail_SO.RefreshWO_Detail_SO(nWO_Detail)
	ENDPROC

