		PRIVATE cUserName
		*cUserName = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
		cUserName = SUBSTR(SYS(0),AT("#",SYS(0))+2)
		IF cUserName = "David Kirchner"
			*RedundantServer()  &&Writes XML of Operating SQL servers.
		ENDIF
		
		***********************
		ThisForm.ShowServerData()
		Set_HPAVersion()
		
		*Get_HPAVersion(lNotCaption, pWhat)
		ThisForm.lblVersionOld.Caption =  Get_HPAVersion(.F.,"STABLE")	&&not Visible
		ThisForm.lblVersionNew.Caption =  Get_HPAVersion(.F.,"LATEST")
		*ThisForm.lblVersionNew.Caption =  Get_HPAVersion(.F.,'BETA')
		
		ThisForm.Timer10.Interval = 600000		&&Ten Minutes
		*ThisForm.Timer10.Interval = 60000	&&One Minute
		
		*CollectErrors()
		
		IF NOT AllowHPA_Version()
			*Calls:AppSetup_get_MinVersion() SELECT [ANS] FROM dbo.AppSetup WITH(NOLOCK) WHERE [Prp] = 'Version' AND [UN] = 'Minimum'
			ThisForm.lblServerData.Caption = 'Version not allowed'
			ThisForm.oleListViewHPA.Visible = .F.
			MESSAGEBOX("Please run a HPA App Update"+CHR(13)+"Ask IT to help if needed."+CHR(13)+"Too many database changes have made "+CHR(13)+"this version impossible to run.",16,"Version is Too old")
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		*? "HPA.Load()"
		SET SAFETY OFF
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_RTR ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		*SET PROCEDURE is in MAIN.PRG
		
		*PROC_SETUP:HPAAppLoad()
		HPAAppLoad()
	ENDPROC

	PROCEDURE LostFocus
		ThisForm.WindowState = 1  &&minimized to an icon
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaHeight, nDeltaWidth
		nDeltaHeight = This.Height - 339
		nDeltaWidth = This.Width - 212
		
		WITH ThisForm.oleListViewHPA
			.Height = 290 + nDeltaHeight 
			.Left = 0
			.top = 2
			.Width = 200 + nDeltaWidth
		ENDWITH
		
		WITH ThisForm.cmdQuit
		*	.Left = nWidth - ThisForm.cmdQuit.Width &&+ 39 &&68
			.Top = 293 + nDeltaHeight 
		ENDWITH
		
		WITH ThisForm.lblServerData
		*	.Left = 1
			.Top = 291 + nDeltaHeight 
		ENDWITH
		
		ThisForm.lblVersionOld.Top = 303 + nDeltaHeight 
		ThisForm.lblVersionNew.Top = 318 + nDeltaHeight 
		
		
		
	ENDPROC

	PROCEDURE showserverdata
		*ThisForm.ShowServerData()
		
		************************
		* Get Server and DataBase
		*WAIT WINDOW "Show Server and DataBase." NOWAIT
		
		PRIVATE nConnHandle
		nConnHandle = 0 
		
		ThisForm.lblServerData.Caption = ''
		
		TRY 
			nConnHandle = get_SQLSTRINGCONNECT()
			IF USED("tmpSerBase")
				USE IN tmpSerBase
			ENDIF
			SELECT 0
		
			cSQL = "SELECT serverproperty('MachineName') AS [Server], DB_NAME() AS [Database]"
		
			nSQLEXEC = SQLEXEC( nConnHandle, cSQL, 'tmpSerBase')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConnHandle, cSQL, 'tmpSerBase')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( nConnHandle, cSQL, "tmpSerBase")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( nConnHandle, cSQL, "tmpSerBase")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
		*		SQLEXECError(cSQL, nConnHandle,nSQLEXEC, 'tmpSerBase')
				RecordError(1, 'SQL Error', 'HPA.ShowServerData '+PROGRAM(), LINENO(1), "Could not 'SELECT serverproperty('MachineName')' ")
				*RecordError(Pnerror, Pmess1, Pcprogram, Pnlineno, pMess)
				MESSAGEBOX("Could not'SELECT serverproperty('MachineName')"+CHR(13)+"Permissions Error.",16,"SQL Error")
			ELSE
				IF USED("tmpSerBase")
					IF VARTYPE(tmpSerBase.Server) = "C"
						ThisForm.lblServerData.Caption = ALLTRIM(tmpSerBase.Server)+" "+ALLTRIM(tmpSerBase.Database)
					ELSE
						ThisForm.lblServerData.Caption = ' No Server '
					ENDIF
					USE IN tmpSerBase			
				ELSE
					ThisForm.lblServerData.Caption = 'Connect Error'
				ENDIF
				ThisForm.lblServerData.Refresh
			ENDIF
		CATCH
			ThisForm.lblServerData.Caption = ' No Connection '
			ThisForm.lblServerData.Refresh
		ENDTRY
		
		IF nConnHandle > 0
			SQLDISCONNECT( nConnHandle )
		ENDIF
	ENDPROC

