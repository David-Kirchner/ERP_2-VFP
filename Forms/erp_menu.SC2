	PROCEDURE Destroy
		*CollectErrors()
		*MESSAGEBOX("RecordError.prg will not be run to Email this message.",0,"Skipping Email!")
		
		IF "\MEM" $ SYS(2003)
			IF FILE( SYS(5)+SYS(2003) +"\QuotesSet.Mem")
				TRY
					RESTORE FROM ( SYS(5)+SYS(2003) +"\QuotesSet.Mem") ADDITIVE
				ENDTRY
			ENDIF
		ELSE
			IF FILE( SYS(5)+SYS(2003) +"\MEM\QuotesSet.Mem")
				TRY
					RESTORE FROM ( SYS(5)+SYS(2003) +"\MEM\QuotesSet.Mem") ADDITIVE
				ENDTRY
			ENDIF
		ENDIF
		
		
		IF TYPE('lcMainClassLib')="C"
			IF NOT lcLastSetClassLib==SET("classlib")
				Release CLASSLIB (lcMainClassLib)
			ENDIF
		ENDIF
		
		IF TYPE('lcLastSetPath')="C"	
			IF EMPTY(lcLastSetPath)
				SET PATH TO
			ELSE
				SET PATH TO (lcLastSetPath)
			ENDIF
		ENDIF
		
		IF TYPE('lcLastSetSafety')="C"	
			IF lcLastSetSafety=="ON"
				SET SAFETY ON
			ELSE
				SET SAFETY OFF
			ENDIF
		ENDIF
		
		IF TYPE('lcLastSetTalk')="C"	
			IF lcLastSetTalk=="ON"
				SET TALK ON
			ELSE
				SET TALK OFF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE GotFocus
		*ThisForm.ShowServerData()
		
		*ThisForm.lblVersion.Caption = HPAVersion()
		
		*SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		*CollectErrors()
		
		*ThisForm.WindowState = 0
	ENDPROC

	PROCEDURE hpamenu		&& Main case for menu. (Node.Text)
		PARAMETER tNodeText, nNodeIndex
		*ThisForm.HPAmenu(node.Text, Node.Index)
		
		* Placed menu case here because the OCX was upgraded and the original code was lost
		*Quotes
		*Sales
		*Mail
		*Manufacturing
		*Maintanence
		
		*SET DEFAULT TO (LoginAppHome)
		DO CASE
		
		******* Accounting ********
		CASE tNodeText = "Accounting Costing"
			IF WEXIST("frmAccountingCosting")
				ACTIVATE WINDOW frmAccountingCosting
			ELSE
				DO FORM "Forms\AccountingCosting.SCX"
			ENDIF
		CASE tNodeText = "Customer Terms"
			IF WEXIST("frmCustomerTerms")
				ACTIVATE WINDOW frmCustomerTerms
