	PROCEDURE Destroy
		RELEASE gaPOIprocess
	ENDPROC

	PROCEDURE getbyid
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT DISTINCT CAST([When] AS Date) AS [When],[What]"
		cSQL = cSQL + " ,[ID] ,[ID_Detail] "
		IF ThisForm.Lst = "S"
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History "
		ELSE
			cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Detail_History "
		ENDIF
		cSQL = cSQL + " WHERE ID_Detail = "+STR(ThisForm.ID_Detail)
		
		
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT DISTINCT CAST(GetDate() AS Date) AS [When] "
		cSQL = cSQL + " ,'CURRENT   ' AS [What] ,[ID] ,[ID_Detail]  "
		IF ThisForm.Lst = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail"
		ELSE
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail"
		ENDIF
		cSQL = cSQL + " WHERE ID_Detail = "+STR(ThisForm.ID_Detail)
		
		cSQL = cSQL + " ORDER BY CAST([When] AS Date) DESC"
		
		IF USED("tmpID_Process_History")
			SELECT tmpID_Process_History
		ELSE 
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Process_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Process_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Process_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Process_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Process_History')
		ELSE
			IF USED("tmpID_Process_History")
		*		THISFORM.ID_Detail_History= tmpID_Process_History.ID_Detail
		*		THISFORM.ID = tmpStockLst_Detail.ID
			ENDIF
		ENDIF
		
		*PUBLIC ARRAY gaPOIprocess(1)
		gaPOIprocess(1) = ""
		
		IF USED("tmpID_Process_History")
			IF RECCOUNT("tmpID_Process_History") > 0
				*SELECT When+" "+What+"|"+STR(ID)+"|"+STR(ID_Detail) FROM tmpID_Process_History INTO ARRAY gaPOIprocess
				SELECT When+" "+What,When,What,ID,ID_Detail FROM tmpID_Process_History INTO ARRAY gaPOIprocess
				**BigInt is Char(19)
				
				ThisForm.lstPOIProcess.NumberOfElements = ALEN(gaPOIprocess,1)
				*ThisForm.lstPOIProcess.RowSource = gaPOIprocess
				ThisForm.lstPOIProcess.REFRESH
				ThisForm.lstPOIProcess.Enabled = .T.
				
			ENDIF		
			GO TOP
			ThisForm.ShowStockLst_Detail_History( tmpID_Process_History.What, tmpID_Process_History.When, tmpID_Process_History.ID, tmpID_Process_History.ID_Detail )			
			USE IN tmpID_Process_History
		ENDIF
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETER pnID_Detail, pLst
		*DO FORM Forms\StockLst_Detail_History WITH 44756,'S'
		*DO FORM Forms\StockLst_Detail_History WITH 28590,'S'
		
		IF TYPE("pnID_Detail") <> "N" 
		pnID_Detail = 27500
		pLst = 'S'
		
		*	MESSAGEBOX("Send Parameter 'ID_Detail'",0, "Bad Parameter")
		*	CANC
		ENDIF
		
		ThisForm.ID_Detail1.Value = pnID_Detail
		ThisForm.ID_Detail = pnID_Detail
		
		
		
		IF VARTYPE(pLst) != "C"
			pLst = "S"
		ENDIF
		
		IF pLst = "S"
			ThisForm.txtLst.Value = "StockLst"
			ThisForm.Lst 		  = "S"
		ELSE
			ThisForm.txtLst.Value = "BrokerLst"
			ThisForm.Lst 		  = "B"
		ENDIF
		
		ThisForm.GetByID()
		
		
	ENDPROC

	PROCEDURE initmemvar
		ThisForm.id1.Value			= 0
		ThisForm.ID_DETAIL1.value	= THISFORM.ID_Detail_History
		ThisForm.PC1.value			= 1
		ThisForm.Size_H1.value		= 0
		ThisForm.Dim11.value		= 0
		ThisForm.Size_L1.value		= 0
		ThisForm.Dim21.value		= 0
		ThisForm.Dim31.value		= 0
		ThisForm.Pounds1.value		= 0
		ThisForm.S_QTY.Value		= 0
		ThisForm.Descript1.value	= ""
		ThisForm.Length1.value		= ""
		*ThisForm.CostValue1.value	= 0
		*ThisForm.Unit1.value		= ""
		ThisForm.S_P.Value			= 0
		ThisForm.S_PU.Value			= 0
		ThisForm.InvoiceValue1.Value	= 0
		ThisForm.FloorStatus1.value	= ""
		ThisForm.Class1.value		= ""
		ThisForm.Location1.value	= ""
		ThisForm.InvCheck1.value	= CTOD('')
		
		ThisForm.Who1.value			= ""
		ThisForm.When1.value		= CTOD('')
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE showstocklst_detail_history
		PARAMETERS cWhat, cWhen, nID, nID_Detail
		*ThisForm.ShowStockLst_Detail_History( cWhat, dWhen, nID, nID_Detail )
		
		cWhat = ALLTRIM(cWhat)
		PRIVATE cSQL, nSQLEXEC
		
		IF cWhat = "CURRENT"
			cSQL = "SELECT DH.* "
			 IF ThisForm.Lst = "S"
				cSQL = cSQL + " FROM dbo.StockLst_Detail DH"
			ELSE
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail DH"
			ENDIF
			cSQL = cSQL + " WHERE DH.ID_Detail = "+STR(nID_Detail)
		ELSE
			cSQL = "SELECT DH.* "
			 IF ThisForm.Lst = "S"
				cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History DH"
			ELSE
				cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Detail_History DH"
			ENDIF
			cSQL = cSQL + " WHERE DH.WHAT = '"+cWhat +"'"
			cSQL = cSQL + " AND CAST(DH.[WHEN] AS DATE) = '"+cWhen+"'"
			cSQL = cSQL + " AND DH.ID = "+STR(nID)
			cSQL = cSQL + " AND DH.ID_Detail = "+STR(nID_Detail)
		ENDIF
		
		IF USED("tmpStockLst_Detail_History")
			SELECT tmpStockLst_Detail_History
		ELSE 
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail_History')
		ELSE
			IF USED("tmpStockLst_Detail_History")
				IF cWhat = "CURRENT"
					THISFORM.ID_Detail_History	= 0 &&tmpStockLst_Detail_History.ID_Detail_History
					ThisForm.id1.Value			= tmpStockLst_Detail_History.ID
					ThisForm.ID_DETAIL1.value	= tmpStockLst_Detail_History.ID_Detail
					ThisForm.PC1.value			= tmpStockLst_Detail_History.PC
					ThisForm.Size_H1.value		= tmpStockLst_Detail_History.Size_H
					ThisForm.Dim11.value		= tmpStockLst_Detail_History.Dim1
					ThisForm.Size_L1.value		= tmpStockLst_Detail_History.Size_L
					ThisForm.Dim21.value		= tmpStockLst_Detail_History.Dim2
					ThisForm.Dim31.value		= tmpStockLst_Detail_History.Dim3
					ThisForm.S_QTY.Value		= PrepareSQLnum(tmpStockLst_Detail_History.S_QTY,'S_QTY',-5)
					ThisForm.Pounds1.value		= tmpStockLst_Detail_History.Weight
					ThisForm.Descript1.value	= tmpStockLst_Detail_History.DESCRIPT
					ThisForm.Length1.value		= tmpStockLst_Detail_History.LENGTH
					ThisForm.S_P.Value			= PrepareSQLnum(tmpStockLst_Detail_History.S_P,'S_P',-5)
					ThisForm.S_PU.Value			= PrepareSQLnum(tmpStockLst_Detail_History.S_PU,'S_PU',-1)
					ThisForm.InvoiceValue1.Value	= PrepareSQLnum(tmpStockLst_Detail_History.InvoiceValue,'InvoiceValue',-5)
					
					ThisForm.FloorStatus1.value	= tmpStockLst_Detail_History.FloorStatus
					ThisForm.Class1.value		= tmpStockLst_Detail_History.CLASS
					ThisForm.Location1.value	= tmpStockLst_Detail_History.Location
					ThisForm.InvCheck1.value	= tmpStockLst_Detail_History.InvCheck
					ThisForm.chkRandLen.value	= tmpStockLst_Detail_History.RandLen
					ThisForm.chkPrime.value		= tmpStockLst_Detail_History.Prime
					
					ThisForm.Who1.value			= ''
					ThisForm.When1.value		= '' &&tmpStockLst_Detail_History.When
				
				ELSE
					THISFORM.ID_Detail_History	= tmpStockLst_Detail_History.ID_Detail
					ThisForm.id1.Value			= tmpStockLst_Detail_History.ID
					ThisForm.ID_DETAIL1.value	= tmpStockLst_Detail_History.ID_Detail
					ThisForm.PC1.value			= tmpStockLst_Detail_History.PC
					ThisForm.Size_H1.value		= tmpStockLst_Detail_History.Size_H
					ThisForm.Dim11.value		= tmpStockLst_Detail_History.Dim1
					ThisForm.Size_L1.value		= tmpStockLst_Detail_History.Size_L
					ThisForm.Dim21.value		= tmpStockLst_Detail_History.Dim2
					ThisForm.Dim31.value		= tmpStockLst_Detail_History.Dim3
					ThisForm.S_QTY.Value		=  PrepareSQLnum(tmpStockLst_Detail_History.S_QTY,'S_QTY',-5)
					ThisForm.Pounds1.value		= tmpStockLst_Detail_History.Weight
					ThisForm.Descript1.value	= tmpStockLst_Detail_History.DESCRIPT
					ThisForm.Length1.value		= tmpStockLst_Detail_History.LENGTH
					ThisForm.S_P.Value			= PrepareSQLnum(tmpStockLst_Detail_History.S_P,'S_P',-5)
					ThisForm.S_PU.Value			= PrepareSQLnum(tmpStockLst_Detail_History.S_PU,'S_PU',-1)
					ThisForm.InvoiceValue1.Value	= PrepareSQLnum(tmpStockLst_Detail_History.InvoiceValue,'InvoiceValue',-5)
					
					ThisForm.FloorStatus1.value	= tmpStockLst_Detail_History.FloorStatus
					ThisForm.Class1.value		= tmpStockLst_Detail_History.CLASS
					ThisForm.Location1.value	= tmpStockLst_Detail_History.Location
					ThisForm.InvCheck1.value	= tmpStockLst_Detail_History.InvCheck
					ThisForm.chkRandLen.value	= tmpStockLst_Detail_History.RandLen
					ThisForm.chkPrime.value		= tmpStockLst_Detail_History.Prime
					
					ThisForm.Who1.value			= tmpStockLst_Detail_History.Who
					ThisForm.When1.value		= tmpStockLst_Detail_History.When
				ENDIF
			ELSE
				THISFORM.InitMemVar()
			ENDIF
		
		ENDIF
		
		IF USED("tmpStockLst_Detail_History")
			USE IN tmpStockLst_Detail_History
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
		RETURN &&ThisForm.ID_Detail
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.ID_Detail_History = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE DIM11.Valid
		IF This.Value > 0
			IF ThisForm.Size_H1.Value > 0
				IF ThisForm.Size_H1.Value < This.Value
					MESSAGEBOX( "The High Tolerance is usually above the Dim 1.",0,"Caution")
				ENDIF
			ENDIF
			IF ThisForm.Size_L1.Value > 0
				IF ThisForm.Size_L1.Value > This.Value
					MESSAGEBOX( "The Low Tolerance is usually below the Dim 1.",0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Dim 1 is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE InvoiceValue1.GotFocus
		this.InputMask = ""
	ENDPROC

	PROCEDURE InvoiceValue1.LostFocus
		this.InputMask = "99,999,999.9999"
	ENDPROC

	PROCEDURE lblQuantity.Click
		ThisForm.GetWeight("S_QTY")
	ENDPROC

	PROCEDURE lstPOIProcess.Click
		PRIVATE cField, dWhen, cWhat, nID, nID_Detail
		cField = This.Value
		
		dWhen = gaPOIprocess(This.ListIndex,2)
		cWhat = gaPOIprocess(This.ListIndex,3)
		nID = gaPOIprocess(This.ListIndex,4)
		nID_Detail = gaPOIprocess(This.ListIndex,5)
		
		ThisForm.ShowStockLst_Detail_History( cWhat, dWhen, nID, nID_Detail )			
	ENDPROC

	PROCEDURE lstPOIProcess.Destroy
		RELEASE gaPOIprocess
	ENDPROC

	PROCEDURE lstPOIProcess.Init
		PUBLIC ARRAY gaPOIprocess(1)
	ENDPROC

	PROCEDURE SIZE_H1.Valid
		PRIVATE nSize_H1 
		
		nSize_H1 = This.Value
		IF VARTYPE(nSize_H1) != 'N'
			This.Value = 0
			nSize_H1  = 0
		ENDIF
			
		IF nSize_H1  > 0
			IF ThisForm.DIM11.Value > 0
				IF ThisForm.DIM11.Value > This.Value
					MESSAGEBOX( "The High Tolerance is usually higher than the Dim 1",0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF nSize_H1 < 0
				MESSAGEBOX( "The High Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE SIZE_L1.Valid
		IF This.Value > 0
			IF ThisForm.DIM11.Value > 0
				IF ThisForm.DIM11.Value < This.Value
					MESSAGEBOX( "The Low Tolerance is usually below the Dim 1",0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Low Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE S_P.GotFocus
		this.InputMask = ""
	ENDPROC

	PROCEDURE S_P.LostFocus
		this.InputMask = "99,999,999.9999"
	ENDPROC

	PROCEDURE S_PU.GotFocus
		this.InputMask = ""
	ENDPROC

	PROCEDURE S_PU.LostFocus
		this.InputMask = "99,999,999.9999"
	ENDPROC

	PROCEDURE S_QTY.GotFocus
		this.InputMask = "99999999.99"
	ENDPROC

	PROCEDURE S_QTY.LostFocus
		this.InputMask = "99,999,999.99"
	ENDPROC

ENDDEFINE
