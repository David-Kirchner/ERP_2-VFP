DEFINE CLASS frmcheck_text AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdPrint" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdSpecText" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdSpecText.Column1.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdSpecText.Column1.Text1" UniqueID="" Timestamp="" />

	*<PropValue>
		Caption = "Spec Check Text"
		DoCreate = .T.
		Height = 357
		Icon = graphics\earth-globe.ico
		Left = 0
		LockScreen = .F.
		Name = "frmCheck_Text"
		Top = 0
		Width = 513
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdPrint' AS commandbutton WITH ;
		BackColor = 128,255,128, ;
		Caption = "\<Print", ;
		Enabled = .T., ;
		Height = 27, ;
		Left = 408, ;
		Name = "cmdPrint", ;
		Top = 264, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdQuit' AS commandbutton WITH ;
		BackColor = 255,128,128, ;
		Caption = "\<Quit", ;
		Height = 27, ;
		Left = 408, ;
		Name = "cmdQuit", ;
		Top = 312, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdSpecText' AS grid WITH ;
		BackColor = 255,255,255, ;
		ColumnCount = 1, ;
		DeleteMark = .F., ;
		ForeColor = 0,0,0, ;
		GridLineColor = 0,128,128, ;
		GridLines = 0, ;
		GridLineWidth = 1, ;
		HeaderHeight = 20, ;
		Height = 336, ;
		Left = 12, ;
		Name = "grdSpecText", ;
		RecordMark = .F., ;
		RecordSource = "spectext", ;
		RecordSourceType = 1, ;
		ScrollBars = 2, ;
		Top = 12, ;
		Width = 372, ;
		Column1.Alignment = 0, ;
		Column1.BackColor = 255,255,255, ;
		Column1.ControlSource = "spectext.spectext", ;
		Column1.DynamicBackColor = "IIF(MOD(RECNO(),2)=1,RGB(255,255,255),RGB(192,220,192))", ;
		Column1.FontBold = .T., ;
		Column1.FontName = "MS Sans Serif", ;
		Column1.FontSize = 8, ;
		Column1.ForeColor = 0,0,0, ;
		Column1.Name = "Column1", ;
		Column1.Visible = .T., ;
		Column1.Width = 360
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grdSpecText.Column1.Header1' AS header WITH ;
		Alignment = 0, ;
		BackColor = 192,220,192, ;
		Caption = "Specification results.", ;
		FontBold = .T., ;
		FontName = "MS Sans Serif", ;
		FontSize = 10, ;
		ForeColor = 0,0,0, ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdSpecText.Column1.Text1' AS textbox WITH ;
		Alignment = 0, ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		FontBold = .T., ;
		FontName = "MS Sans Serif", ;
		FontSize = 8, ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1", ;
		Visible = .T.
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Load
		IF USED('SpecText')
			USE IN SpecText
		ENDIF
		
		PRIVATE cFileName
		cFileName = SYS(3)
		SELECT 0
		
		CREATE TABLE (SYS(5)+SYS(2003)+"\"+(cFileName) ) FREE ;
		( SpecText CHAR(60) )
		
		USE (SYS(5)+SYS(2003)+"\"+cFileName) EXCL ALIAS SpecText
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"SpecText") FREE ( SpecText CHAR(60) )
		
		SELECT SpecText
		SET SAFETY OFF
		ZAP IN SpecText
		
			
		
	ENDPROC

	PROCEDURE Unload
		IF USED('SpecText')
			SELECT SpecText
			ZAP
			USE IN SpecText
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPrint.Click
		Private currdbf
		currdbf = ALIAS()
		IF USED('SpecText')
		SELECT SpecText
		REPORT FORM "c:\Program Files\vfp\ERPCert\Reports\SpecText" TO PRINTER PROMPT NOCONSOLE
		*REPORT FORM "c:\Program Files\vfp\ERPCert\Reports\SpecText" preview
		ENDIF
		SELECT (Currdbf)
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
	ENDPROC

ENDDEFINE
