	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpPOalloy.cancelled
			nColor = RGB( 255, 0, 0 ) &&RED	
		*CASE tmpPOalloy.Cancelled
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pAlloy, pForm, pCC, pCL
		*DO FORM "c:\program files (x86)\hpa\forms\choosealloyspecs.scx" WITH "400","10","1",""
		
		IF VARTYPE(pAlloy) != "C"
			pAlloy = '400'
		*	MESSAGEBOX("No HPA POitem",0,"Bad Paramater")
		*	RETURN .F. 
		ENDIF
		
		IF VARTYPE(pForm) != "C"
			pForm = '10'
		ENDIF
		IF VARTYPE(pCC) != "C"
			pCC = '1'
		ENDIF
		IF VARTYPE(pCL) != "C"
			pCL = ''
		ENDIF
		
		ThisForm.Alloy = pAlloy
		ThisForm.Form = pForm
		ThisForm.CC	= pCC
		ThisForm.CL	= pCL
		
		IF USED("tmpPOalloy")
			SELECT tmpPOalloy
		ELSE
			*MESSAGEBOX("Table 'tmpPOalloy' not open",0,"Open file first")
			*RETURN .F. 
			PRIVATE cSQL
			SELECT 0
			
			cSQL = "SELECT Alloy,Form,CC,CL "
			cSQL = cSQL + " ,dbo.f_DescriptCL(Alloy,CC,CL,Form,Thck,Sz2,Sz3,Pounds,RandLen) AS Descript "
			cSQL = cSQL + " ,Thck,OrderDate,Order_Qty,Cond_Spec,Misc_Purch,Cancelled "
			cSQL = cSQL + " FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE Alloy = '"+ThisForm.Alloy+"' "
			IF NOT EMPTY(ThisForm.Form)
				cSQL = cSQL + " AND Form = '"+ThisForm.Form+"' "
			ENDIF
			IF NOT EMPTY(ThisForm.CC)
				cSQL = cSQL + " AND CC = '"+ThisForm.CC+"' "
			ENDIF
			IF NOT EMPTY(ThisForm.CL)
				cSQL = cSQL + " AND CL = '"+ThisForm.CL+"' "
			ENDIF
			cSQL = cSQL + " AND SOitem = 'STOCK'"
		 
			
			SELECT 0  
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOalloy')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPOalloy')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOalloy')
				RETURN
			ELSE
		
			ENDIF
		ENDIF
		
		*SELECT * FROM PurchaseOrders WHERE HpaPo = pnHpaPo INTO CURSOR tmpPOitems
		*IF TYPE("pHPAPoItem") = "N"
		*	ThisForm.Caption = ThisForm.Caption+" for PO#"+ALLTRIM(STR( pHPAPoItem ))+" Heat: "+pcHeat
		*ELSE
		*ENDIF
		
		ThisForm.grid.RecordSource = "tmpPOalloy"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		*ThisForm.grid.SetFocus
		*!*	PRIVATE nRecCount
		*!*	nRecCount = RECCOUNT("tmpPOalloy")
		*!*	DO CASE
		*!*	CASE nRecCount = 0
		*!*		MESSAGEBOX("Sorry, PO Item number not Found",32,"No records to Show!")
		*!*		ThisForm.cmdQuit.Click
		*!*	CASE nRecCount = 1
		*!*		ThisForm.cmdSelect.Click()
		*!*	CASE nRecCount > 7
		*!*		GO BOTTOM
		*!*		SKIP -6
		*!*	OTHERWISE
		*!*		GO BOTTOM
		*!*	ENDCASE
		
		
		
		ThisForm.txtAlloy.Value 		= ShowSQLtxt(tmpPOalloy.Alloy,'ALLOY',12)
		ThisForm.txtCC.Value 			= ShowSQLtxt(tmpPOalloy.CC,'CC',1)
		ThisForm.txtCL.Value 			= ShowSQLtxt(tmpPOalloy.CL,'CL',1)
		ThisForm.txtDescription.Value 	= tmpPOalloy.Descript
		ThisForm.txtCond_Spec.Value 	= tmpPOalloy.Cond_Spec
		ThisForm.txtMisc_Purch.Value 	= tmpPOalloy.Misc_Purch 
		ThisForm.txtOrderDate.Value 	= tmpPOalloy.OrderDate
		ThisForm.lblCancelled.Visible	= PrepareSQLlogic(tmpPOalloy.Cancelled,'Cancelled')
		
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE Unload
			IF USED("tmpPOalloy")
				USE IN tmpPOalloy
			ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdQuit.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE cHoldNumber
		*cHoldNumber = ""
		cHoldNumber = tmpPOalloy.Cond_Spec
		ThisForm.HoldNumber = cHoldNumber 
		
		PRIVATE lCancelled
		lCancelled = PrepareSQLlogic(tmpPOalloy.Cancelled,"Cancelled")
		IF lCancelled 
			IF MESSAGEBOX("You have selected a Cancelled Receive."+CHR(13)+"Are you sure you want to continue?",4+32,"Cancelled") != 6
				RETURN .f.
			ENDIF
		ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE Grid.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.txtAlloy.Value 		= tmpPOalloy.Alloy
		ThisForm.txtDescription.Value 	= tmpPOalloy.Descript
		ThisForm.txtCond_Spec.Value 	= tmpPOalloy.Cond_Spec
		ThisForm.txtMisc_Purch.Value 	= tmpPOalloy.Misc_Purch 
		ThisForm.txtOrderDate.Value 	= tmpPOalloy.OrderDate
		ThisForm.lblCancelled.Visible = PrepareSQLlogic(tmpPOalloy.Cancelled,'Cancelled')
		
		
	ENDPROC

ENDDEFINE
