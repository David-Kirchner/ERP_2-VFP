	ADD OBJECT 'txt_search_text' AS textbox WITH ;
		Height = 23, ;
		Left = 22, ;
		Name = "txt_search_text", ;
		SelectOnEntry = .T., ;
		TabIndex = 1, ;
		Top = 17, ;
		Width = 152
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS cTable, cDefaultText, pConnHandle
		
		*DO FORM Forms\SearchForm WITH 'SoldAddr','A'
		*DO FORM Forms\SearchForm WITH 'ShipAddr','Castle'
		*DO FORM Forms\SearchForm WITH 'Vendor',10995
		*DO FORM Forms\SearchForm WITH "VendorContact", nVendCode 
		*DO FORM Forms\SearchForm WITH "CustID", cCustID &&ShipAddr
		
		IF TYPE("cTable") = "L"
			MESSAGEBOX("No table name parameter.")
			cTable = ""
		ENDIF
		
		IF TYPE("pConnHandle") = "N"
			IF pConnHandle > 0
				ThisForm.nConnHandle = pConnHandle
			ELSE
				ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			ENDIF		
		ELSE
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		
		
		This.Caption = This.Caption + cTable
		This.cSearchTable = cTable
		
		DO CASE
		CASE cTable = "SoldAddr"
			ThisForm.TableName = "SoldAddr"
			ThisForm.cmdDetails.Visible = .T.
			ThisForm.cmdDetails.Enabled = .F.
			ThisForm.cmdSeeOther.Visible = .T.
			ThisForm.cmdSeeOther.Enabled = .T.
			ThisForm.cmdSeeOther.Caption = "See Shipping"
			ThisForm.BackColor = RGB(214,210,211)
			ThisForm.chkShowInactive.Visible = .T.
			
			IF NOT USED('SoldAddr')
				ThisForm.CloseAddr = .T.
				SELECT 0
				
				cSQL="SELECT * FROM dbo.SoldAddr WITH(NOLOCK) WHERE 0>0"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle)
				ENDIF
			ENDIF
			
		CASE cTable = "ShipAddr" 
			ThisForm.TableName = "ShipAddr"
			ThisForm.cmdDetails.Visible = .T.
			ThisForm.cmdDetails.Enabled = .F.
			ThisForm.cmdSeeOther.Visible = .T.
			ThisForm.cmdSeeOther.Enabled = .T.
			ThisForm.cmdSeeOther.Caption = "See Billing"
			ThisForm.BackColor = RGB(201,210,200)
			ThisForm.chkShowInactive.Visible = .T.
			
			IF NOT USED('ShipAddr')
				ThisForm.CloseAddr = .T.
				SELECT 0
				
				cSQL="SELECT * FROM dbo.ShipAddr WITH(NOLOCK) WHERE 0>0"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle)
				ENDIF
			ENDIF
			
		CASE cTable = "VendorContact"  
			ThisForm.TableName = "VendorContact"
			ThisForm.cmdDetails.Visible = .T.
			ThisForm.cmdDetails.Enabled = .F.
			ThisForm.cmdSeeOther.Visible = .F.
			ThisForm.cmdSeeOther.Enabled = .F.
			ThisForm.cmdSeeOther.Caption = ""
			ThisForm.BackColor = RGB(201,210,200)
			ThisForm.chkShowInactive.Visible = .T.
			
			IF NOT USED('ShipAddr')
				ThisForm.CloseAddr = .T.
				SELECT 0
				
				cSQL="SELECT * FROM dbo.VendorContact WITH(NOLOCK) WHERE 0>0"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle)
				ENDIF
			ENDIF
				
		CASE cTable = "Vendor"  
			ThisForm.TableName = "Vendor"
			ThisForm.cmdDetails.Visible = .T.
			ThisForm.cmdDetails.Enabled = .F.
			ThisForm.cmdSeeOther.Visible = .F.
			ThisForm.cmdSeeOther.Enabled = .F.
			ThisForm.cmdSeeOther.Caption = ""
			ThisForm.BackColor = RGB(201,210,200)
			ThisForm.chkShowInactive.Visible = .T.
			
			IF NOT USED('ShipAddr')
				ThisForm.CloseAddr = .T.
				SELECT 0
				
				cSQL="SELECT * FROM dbo.Vendor WITH(NOLOCK) WHERE 0>0"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle)
				ENDIF
			ENDIF
			
		OTHERWISE
			ThisForm.cmdDetails.Visible = .F.
			ThisForm.cmdDetails.Enabled = .F.
			ThisForm.cmdSeeOther.Visible = .F.
			ThisForm.cmdSeeOther.Enabled = .F.
			ThisForm.BackColor = RGB(212,208,200)
			ThisForm.chkShowInactive.Visible = .F.
			ThisForm.TableName = ""
		ENDCASE
		
		
		IF TYPE('cDefaultText') = "C"
			IF EMPTY(cDefaultText)
				cDefaultText=SPACE(20)
			ENDIF
			ThisForm.txt_search_text.Value = cDefaultText
			ThisForm.cmdcmdSearch.Click
		ELSE
			IF TYPE('cDefaultText') = 'N'
				ThisForm.txt_search_text.Value = STR(cDefaultText,20,0)
				ThisForm.ogrp_search_in.Value = 6
				ThisForm.cmdcmdSearch.Click
			ELSE	
			cDefaultText=SPACE(20)
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE Resize
		ThisForm.Grid1.Height = This.Height - 137 &&252 - 389 = 137
		ThisForm.Grid1.Width = This.Width - 29 &&588 - 617 = 29
	ENDPROC

	PROCEDURE searchnow
		PARAMETER cSearchText,nSearch_in,nSearch_how
		*ThisForm.searchNow()
		
		PRIVATE cSQL_where, cSQL_field
		
		cSearchText = STRTRAN(cSearchText,["],"")
		cSearchText = STRTRAN(cSearchText,"%","")
		*cSearchText = STRTRAN(cSearchText,"&","")
		ThisForm.txt_search_text.Value = cSearchText &&Show that removed Characters are gone
		cSearchText = STRTRAN(cSearchText,"'","''")  &&Do not show this one!
		
		PRIVATE nSearchText &&CASE nSearch_in = 6 returns Number
		nSearchText = 0
		
		DO CASE
		CASE THISFORM.cSearchTable = "SoldAddr"
			DO CASE
			CASE nSearch_in = 1
				cSQL_field = "company"
				cSearchText = PrepareSQLtxt(cSearchText,'company',100)
			CASE nSearch_in = 2
				cSQL_field = "city"
				cSearchText = PrepareSQLtxt(cSearchText,'city',50)
			CASE nSearch_in = 3
				cSQL_field = "st"
				cSearchText = PrepareSQLtxt(cSearchText,'st',50)
			CASE nSearch_in = 4
				cSQL_field = "zip"
				cSearchText = PrepareSQLtxt(cSearchText,'zip',50)
			CASE nSearch_in = 5
				cSQL_field = "addr1"
				cSearchText = PrepareSQLtxt(cSearchText,'addr1',100)
			CASE nSearch_in = 6
				cSQL_field = "SoldCode"
				nSearchText = PrepareSQLnum(cSearchText,'SoldCode',-3)
			ENDCASE
		CASE THISFORM.cSearchTable = "ShipAddr"
			DO CASE
			CASE nSearch_in = 1
				cSQL_field = "company"
				cSearchText = PrepareSQLtxt(cSearchText,'company',100)
			CASE nSearch_in = 2
				cSQL_field = "city"
				cSearchText = PrepareSQLtxt(cSearchText,'city',50)
			CASE nSearch_in = 3
				cSQL_field = "st"
				cSearchText = PrepareSQLtxt(cSearchText,'st',50)
			CASE nSearch_in = 4
				cSQL_field = "zip"
				cSearchText = PrepareSQLtxt(cSearchText,'zip',50)
			CASE nSearch_in = 5
				cSQL_field = "addr1"
				cSearchText = PrepareSQLtxt(cSearchText,'addr1',100)
			CASE nSearch_in = 6
				cSQL_field = "ShipCode"
				nSearchText = PrepareSQLnum(cSearchText,'ShipCode',-3)
			ENDCASE
		CASE THISFORM.cSearchTable == "Vendor"
			DO CASE
			CASE nSearch_in = 1
				cSQL_field = "Company"
				cSearchText = PrepareSQLtxt(cSearchText,'Company',100)
			CASE nSearch_in = 2
				cSQL_field = "city"
				cSearchText = PrepareSQLtxt(cSearchText,'city',50)
			CASE nSearch_in = 3
				cSQL_field = "telephone"
				cSearchText = PrepareSQLtxt(cSearchText,'telephone',50)
			CASE nSearch_in = 4
				cSQL_field = "zip"
				cSearchText = PrepareSQLtxt(cSearchText,'zip',50)
			CASE nSearch_in = 5
				cSQL_field = "addr1"
				cSearchText = PrepareSQLtxt(cSearchText,'addr1',100)
			CASE nSearch_in = 6
				cSQL_field = "VendCode"
				nSearchText = PrepareSQLnum(cSearchText,'VendCode',10) 
			CASE nSearch_in = 7
				cSQL_field = "PeachID"
				cSearchText = PrepareSQLtxt(cSearchText,'PeachID',10) 
			ENDCASE
		CASE THISFORM.cSearchTable = "VendorContact"
			DO CASE
			CASE nSearch_in = 1
				cSQL_field = "branch"
				cSearchText = PrepareSQLtxt(cSearchText,'Branch',30)
			CASE nSearch_in = 2
				cSQL_field = "city"
				cSearchText = PrepareSQLtxt(cSearchText,'city',50)
			CASE nSearch_in = 3
				cSQL_field = "st"
				cSearchText = PrepareSQLtxt(cSearchText,'st',50)
			CASE nSearch_in = 4
				cSQL_field = "zip"
				cSearchText = PrepareSQLtxt(cSearchText,'zip',50)
			CASE nSearch_in = 5
				cSQL_field = "addr1"
				cSearchText = PrepareSQLtxt(cSearchText,'addr1',100)
			CASE nSearch_in = 6
				cSQL_field = "VendCode"
				nSearchText = PrepareSQLnum(cSearchText,'VendCode',10) 
			CASE nSearch_in = 7
				cSQL_field = "Contact"
				cSearchText = PrepareSQLtxt(cSearchText,'Contact',100) 
			ENDCASE
		OTHERWISE
		ENDCASE
		
		
		IF nSearch_in = 6
			*Number
			DO CASE
			CASE nSearch_how = 1
				cSQL_where = " WHERE " + cSQL_field + ' = ' + ALLTRIM(STR(nSearchText)) + ' '
			CASE nSearch_how = 2
				cSQL_where = " WHERE " + cSQL_field + " LIKE '%" + ALLTRIM(STR(nSearchText)) + "%'"
			ENDCASE
		ELSE
			*TEXT
			DO CASE
			CASE nSearch_how = 1
				cSQL_where = " WHERE " + cSQL_field + " LIKE '" + cSearchText + "%'"
			CASE nSearch_how = 2
				cSQL_where = " WHERE " + cSQL_field + " LIKE '%" + cSearchText + "%'"
			ENDCASE
		ENDIF
		
		IF THISFORM.cSearchTable = "SoldAddr" OR THISFORM.cSearchTable = "ShipAddr" OR THISFORM.cSearchTable = "Vendor"
			IF THISFORM.chkShowInactive.VALUE = 0
				*Do not show InActive
				cSQL_where = cSQL_where + " AND ISNULL(InActive,0)=0 "
			ELSE
				cSQL_where = cSQL_where + " AND ISNULL(InActive,0)=1 "
			ENDIF
		ENDIF
		
		
		cSQL_statement = "SELECT * FROM dbo." + THISFORM.cSearchTable + cSQL_where + " ORDER BY " + cSQL_field 
		&&" NOCONSOLE INTO CURSOR tmpSearch"
			
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_statement , 'tmpSearch')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_statement , 'tmpSearch')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL_statement , ThisForm.nConnHandle)
		ENDIF
		
		
		
		THISFORM.Grid1.ENABLED = .T.
		THISFORM.Grid1.RECORDSOURCE = 'tmpSearch'
		THISFORM.Grid1.REFRESH()
		
		DO CASE
		CASE ThisForm.TableName = "VendorContact"
			THISFORM.Grid1.SetAll("dynamicbackcolor"," IIF( INACTIVE, RGB(255,0,0), RGB(128,255,128) )", "Column")
		CASE ThisForm.TableName = "Vendor"
			THISFORM.Grid1.SetAll("dynamicbackcolor"," IIF( INACTIVE, RGB(255,0,0), IIF(QAApproved=1, RGB(128,255,128),RGB(255,255,255)))", "Column")
		ENDCASE
		
		
		IF RECCOUNT('tmpSearch')>0
			
			THISFORM.cmdSelect.ENABLED = .T.
			THISFORM.cmdDetails.ENABLED = .T.
			THISFORM.cmdDeactivate.ENABLED = .T.
			
			*This code is in AfterRowColChange
			DO CASE
			CASE THISFORM.cSearchTable = "SoldAddr"
				THISFORM.nReturnKey = tmpSearch.SoldCode
			CASE THISFORM.cSearchTable = "ShipAddr"
				THISFORM.nReturnKey = tmpSearch.ShipCode
			CASE THISFORM.cSearchTable = "Vendor"
				THISFORM.nReturnKey = tmpSearch.VendCode
			CASE THISFORM.cSearchTable = "Vendor"
				THISFORM.nReturnKey = tmpSearch.ContactID
			ENDCASE
		
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		
		
		RETURN This.nReturnKey
	ENDPROC

	PROCEDURE chkShowInactive.InteractiveChange
		ThisForm.cmdcmdSearch.Click
	ENDPROC

	PROCEDURE cmdcmdSearch.Click
		PRIVATE tmpSearchCount,cSearchText,nSearch_in,nSearch_how,cSearchTextOrig
		cSearchText = UPPER(ALLTRIM(THISFORM.txt_search_text.VALUE))
		*cSearchText = STRTRAN(cSearchText,"'","''") &&Not yet!
		nSearch_in = THISFORM.oGrp_search_in.VALUE
		nSearch_how = THISFORM.oGrp_search_how.VALUE
		cSearchTextOrig = cSearchText
		
		IF NOT ISNULL(cSearchText)
		
			THISFORM.SearchNow(cSearchText, nSearch_in, nSearch_how)
		
			IF nSearch_in != 6 &&Do not Step down this number!
				IF LEN(cSearchText ) > 0
					tmpSearchCount = 0
					IF USED('tmpSearch')
						tmpSearchCount = RECCOUNT("tmpSearch")
					ENDIF
		
					DO WHILE tmpSearchCount = 0 AND LEN(cSearchText) > 0
						THISFORM.txt_search_text.VALUE = cSearchText
						THISFORM.SearchNow(cSearchText, nSearch_in, nSearch_how)
						cSearchText = SUBSTR(cSearchText ,1, LEN(cSearchText )-1 )
		
						IF USED('tmpSearch')
							tmpSearchCount = RECCOUNT("tmpSearch")
						ELSE
							tmpSearchCount = 0
						ENDIF
					ENDDO
				ELSE
					THISFORM.txt_search_text.VALUE = cSearchTextOrig
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDeactivate.Click
		PRIVATE nCode,cSQL
		cSQL = ''
		
		IF MESSAGEBOX( "Are you sure you want to change the Active Status?"+CHR(10)+CHR(10)+"Changes may not show untill you search again!",4+32,"Deactivate?") = 6
		
			IF ISNULL(tmpSearch.Inactive)
				DO Case
				CASE ThisForm.cSearchTable = "SoldAddr"
					nCode = tmpSearch.SoldCode
					cSQL = "UPDATE dbo.SoldAddr SET Inactive = 1,LastEdit=GetDate() WHERE SoldCode = "+STR(nCode )
				CASE ThisForm.cSearchTable = "ShipAddr"
					nCode = tmpSearch.ShipCode
					cSQL = "UPDATE dbo.ShipAddr SET Inactive = 1,LastEdit=GetDate() WHERE ShipCode = "+STR(nCode )
				CASE ThisForm.cSearchTable = "Vendor"
					nCode = tmpSearch.VendCode
					cSQL = "UPDATE dbo.Vendor SET Inactive = 1,LastEdit=GetDate() WHERE VendCode = "+STR(nCode )
				CASE ThisForm.cSearchTable = "VendorContact"
					nCode = tmpSearch.ContactID
					cSQL = "UPDATE dbo.VendorContact SET Inactive = 1 WHERE ContactID = "+STR(nCode )
				OTHERWISE
					MESSAGEBOX("Your table was not programmed to be edited.",0+48,"Not Applicable")
				ENDCASE		
			ELSE
				IF !tmpSearch.Inactive
					DO Case
					CASE ThisForm.cSearchTable = "SoldAddr"
						nCode = tmpSearch.SoldCode
						cSQL = "UPDATE dbo.SoldAddr SET Inactive = 1,LastEdit=GetDate() WHERE SoldCode = "+STR(nCode )
					CASE ThisForm.cSearchTable = "ShipAddr"
						nCode = tmpSearch.ShipCode
						cSQL = "UPDATE dbo.ShipAddr SET Inactive = 1,LastEdit=GetDate() WHERE ShipCode = "+STR(nCode )
					CASE ThisForm.cSearchTable = "Vendor"
						nCode = tmpSearch.VendCode
						cSQL = "UPDATE dbo.Vendor SET Inactive = 1,LastEdit=GetDate() WHERE VendCode = "+STR(nCode )
					CASE ThisForm.cSearchTable = "VendorContact"
						nCode = tmpSearch.ContactID
						cSQL = "UPDATE dbo.VendorContact SET Inactive = 1 WHERE ContactID = "+STR(nCode )
					OTHERWISE
						MESSAGEBOX("Your table was not programmed to be edited.",0+48,"Not Applicable")
					ENDCASE		
				ELSE
					*REVERSE
					DO Case
					CASE ThisForm.cSearchTable = "SoldAddr"
						nCode = tmpSearch.SoldCode
						cSQL = "UPDATE dbo.SoldAddr SET Inactive = 0,LastEdit=GetDate() WHERE SoldCode= "+STR(nCode )
					CASE ThisForm.cSearchTable = "ShipAddr"
						nCode = tmpSearch.ShipCode
						cSQL = "UPDATE dbo.ShipAddr SET Inactive = 0,LastEdit=GetDate() WHERE ShipCode= "+STR(nCode )
					CASE ThisForm.cSearchTable = "Vendor"
						nCode = tmpSearch.VendCode
						cSQL = "UPDATE dbo.Vendor SET Inactive = 0,LastEdit=GetDate() WHERE VendCode= "+STR(nCode )
					CASE ThisForm.cSearchTable = "VendorContact"
						nCode = tmpSearch.ContactID
						cSQL = "UPDATE dbo.VendorContact SET Inactive = 1 WHERE ContactID = "+STR(nCode )
					OTHERWISE
						MESSAGEBOX("Your table was not programmed to be edited.",0+48,"Not Applicable")
					ENDCASE		
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT EMPTY('cSQL')	
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL , ThisForm.nConnHandle)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdDetails.Click
		DO CASE 
		CASE ThisForm.cSearchTable = "SoldAddr"
			DO FORM Forms\AddressDetail WITH "SoldAddr", ThisForm.nReturnKey
		CASE ThisForm.cSearchTable = "ShipAddr"
			DO FORM Forms\AddressDetail WITH "ShipAddr", ThisForm.nReturnKey
		CASE ThisForm.cSearchTable = "Vendor"
			DO FORM Forms\Vendor WITH VendCode
		*!*		PRIVATE nVendCode
		*!*		DO FORM Forms\Vendor11 WITH VendCode TO nVendCode
		*!*		IF TYPE('nVendCode') = "N"
		*!*			IF nVendCode > 0
		*!*			
		*!*				PRIVATE cPeachID
		*!*				cPeachID = getPeachID_VendCode(nVendCode,ThisForm.nConnHandle)
		*!*			
		*!*				PRIVATE cSearchText, nSearch_in, nSearch_how
		*!*				cSearchText	= cPeachID 
		*!*				nSearch_in	= 7
		*!*				nSearch_how	= 1
		*!*				THISFORM.SearchNow(cSearchText, nSearch_in, nSearch_how)
		*!*
		*!*			ENDIF
		*!*		ENDIF
		CASE ThisForm.cSearchTable = "VendorContact"
		OTHERWISE
			MESSAGEBOX("Your table was not programmed to be edited.",0+48,"Not Applicable")
		ENDCASE
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.nReturnKey = -1
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSeeOther.Click
		PRIVATE lcSelectCompany
		
		lcSelectCompany = ThisForm.txt_search_text.Value
		IF USED("tmpSearch") 
			IF RECNO("tmpSearch") > 0 AND NOT EOF("tmpSearch")
				lcSelectCompany  = tmpSearch.company 
			ENDIF
		ENDIF
		
		IF NOT EMPTY("lcSelectCompany")
			DO CASE 
			CASE ThisForm.cSearchTable = "SoldAddr"
				DO FORM Forms\SearchForm WITH "ShipAddr", lcSelectCompany 
			CASE ThisForm.cSearchTable = "ShipAddr"
				DO FORM Forms\SearchForm WITH "SoldAddr", lcSelectCompany 
		*	CASE ThisForm.cSearchTable = "Vendor"
		*	CASE ThisForm.cSearchTable = "VendorContact"
			OTHERWISE
				MESSAGEBOX("Your table was not programmed.",0+48,"Not Applicable")
			ENDCASE
		ELSE
			MESSAGEBOX("Select a Company first")
		ENDIF
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF USED('tmpSearch')
		*	USE IN tmpSearch
		ENDIF
		
		*ThisForm.nReturnKey 
		ThisForm.Release
		
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		IF USED('tmpSearch')
			*Code also found at end of SearchNow to initialize the top record.
			DO CASE
			CASE THISFORM.cSearchTable = "SoldAddr"
				THISFORM.nReturnKey = tmpSearch.SoldCode
			CASE THISFORM.cSearchTable = "ShipAddr"
				THISFORM.nReturnKey = tmpSearch.ShipCode
			CASE THISFORM.cSearchTable = "Vendor"
				THISFORM.nReturnKey = tmpSearch.VendCode
			CASE THISFORM.cSearchTable = "VendorContact"
				THISFORM.nReturnKey = tmpSearch.ContactID
			ENDCASE
		
			WAIT WINDOW STR(THISFORM.nReturnKey) NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE Grid1.Init
		*This.SetAll("dynamicbackcolor","IIF( Posted = 'Y', RGB(255,255,0), RGB(255,255,255))", "Column")
	ENDPROC

	PROCEDURE ogrp_search_in.Click
		ThisForm.txt_search_text.value = ""
		ThisForm.txt_search_text.SetFocus()
	ENDPROC

ENDDEFINE
