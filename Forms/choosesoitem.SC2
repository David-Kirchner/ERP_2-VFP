	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(SOitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpSOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpSOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpSOitems.cncld
			nColor = RGB( 255, 0, 0 ) &&RED	
		CASE tmpSOitems.cmplt
			nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pnHpaSO
		*DO FORM Forms\ChooseSOitem WITH 0 TO cSOItem
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF USED("tmpSOitems")
			USE IN tmpSOitems
		ENDIF
		
		IF TYPE("pnHpaSO") = "N"
			IF pnHpaSO = 0
				IF USED('tmpSOitems')
					USE IN tmpSOitems
				ENDIF
		
				SELECT 0
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT '' AS POitem, S.SOitem,"
				cSQL = cSQL + "dbo.f_SalesPDescription(AQ.SalesP,AQ.Cover) AS SalesMan,AQ.Company,AQ.Alloy,AQ.Pieces,"
				cSQL = cSQL + "LEFT(dbo.f_ItemDescription(AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Weight,AQ.RandLen),40) AS Description,"
		**		cSQL = cSQL + "S.heat,S.converter,"
				cSQL = cSQL + "CONVERT(CHAR(8), S.shipped ,1 ) AS Shipped,"
				cSQL = cSQL + "S.matlwt,S.cncld,S.cmplt,"
				cSQL = cSQL + "S.orderspec,S.s_instrct"
				cSQL = cSQL + " FROM dbo.Sales S JOIN dbo.AllQuotes AQ ON (S.SOitem = AQ.SOitem)"
				cSQL = cSQL + " WHERE AQ.SaleDate > GetDate()-90 "
				cSQL = cSQL + " AND ISNULL(S.Cncld,0) = 0"
				cSQL = cSQL + " AND ISNULL(S.Cmplt,0) = 0"
				cSQL = cSQL + " ORDER BY S.SOitem DESC"
			
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitems')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitems' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		*		nSQLEXEC = -1  to Test SQLEXEC
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitems' )
				ENDIF
		
				IF USED('tmpSOitems')
		*			GO TOP
					IF RECCOUNT('tmpSOitems') > 5
						SKIP -5
					ENDIF
				ENDIF
			
			ELSE
				ThisForm.Caption = ThisForm.Caption+" for SO#"+ALLTRIM(STR( pnHpaSO ))
				
				IF USED('tmpSOitems')
					USE IN tmpSOitems
				ENDIF
		
				SELECT 0
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT '' AS POitem, S.SOitem,"
				cSQL = cSQL + "dbo.f_SalesPDescription(AQ.SalesP,AQ.Cover) AS SalesMan,AQ.Company,AQ.Alloy,AQ.Pieces,"
				cSQL = cSQL + "LEFT(dbo.f_ItemDescription(AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Weight,AQ.RandLen),40) AS Description,"
				**cSQL = cSQL + "S.heat,S.converter,"
				cSQL = cSQL + "CONVERT(CHAR(8), S.shipped ,1 ) AS Shipped,"
				cSQL = cSQL + "S.matlwt,S.cncld,S.cmplt,"
				cSQL = cSQL + "S.orderspec,S.s_instrct"
				cSQL = cSQL + " FROM dbo.Sales S JOIN dbo.AllQuotes AQ ON (S.SOitem = AQ.SOitem)"
				cSQL = cSQL + " WHERE S.SalesNum = "+STR(pnHpaSO)+""
				cSQL = cSQL + " ORDER BY S.SOitem DESC"
			
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitems')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitems' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitems' )
				ENDIF
		
				IF USED('tmpSOitems')	
		*			GO TOP
					IF RECCOUNT('tmpSOitems') > 5
						SKIP -5
					ENDIF
		
				ENDIF
			ENDIF
		ELSE
			*****
			IF USED('tmpSOitems')
				USE IN tmpSOitems
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT TOP 2000 S.soitem,"
			cSQL = cSQL + "dbo.f_SalesPDescription(AQ.SalesP,AQ.Cover) AS SalesMan,AQ.Company,AQ.Alloy,AQ.Pieces,"
			cSQL = cSQL + "LEFT(dbo.f_ItemDescription(AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Weight,AQ.RandLen),40) AS Description,"
		*	cSQL = cSQL + "S.heat,S.converter,"
			cSQL = cSQL + "CONVERT(CHAR(8), S.shipped ,1 ) AS Shipped,"
			cSQL = cSQL + "S.matlwt,S.cncld,S.cmplt,"
			cSQL = cSQL + "S.orderspec,S.s_instrct"
			cSQL = cSQL + " FROM dbo.Sales S JOIN dbo.AllQuotes AQ ON (S.SOitem = AQ.SOitem)"
			cSQL = cSQL + " ORDER BY S.SOitem DESC"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitems')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitems' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitems' )
			ENDIF
		
			IF USED('tmpSOitems')
		*	  GO TOP
			  IF RECCOUNT('tmpSOitems') > 10
			  	SKIP -10
			  ENDIF 
			ENDIF
		ENDIF
		
		ThisForm.grid.RecordSource = "tmpSOitems"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		ThisForm.txtAlloy.Value = tmpSOitems.Alloy
		ThisForm.txtDescription.Value = tmpSOitems.Description
		
		IF RECCOUNT("tmpSOitems") = 1
			ThisForm.cmdSelect.Click()
		ELSE
			IF RECCOUNT("tmpSOitems") = 0
				MESSAGEBOX("Sorry, SO number not Found",32,"No records to Show!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpSOitems')
			USE IN tmpSOitems
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE cHoldNumber
		*cHoldNumber = ""
		cHoldNumber = tmpSOitems.SOItem
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE grid.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.txtAlloy.Value = tmpSOitems.Alloy
		ThisForm.txtDescription.Value = tmpSOitems.Description
	ENDPROC

	PROCEDURE grid.BeforeRowColChange
		LPARAMETERS nColIndex
	ENDPROC

ENDDEFINE
