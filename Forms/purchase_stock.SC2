						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Vendor')
		ELSE
