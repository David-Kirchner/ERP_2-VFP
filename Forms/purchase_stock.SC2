	PROCEDURE frmVendorImport.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
		
	ENDPROC

	PROCEDURE frmVendorImport.cmbForm.Valid
		*!*	IF ThisFormset.QUOTES.THCK1.Value * ThisFormset.QUOTES.SZ21.Value > 0
		*!*		IF NOT ThisFormset.QUOTES.SZ31.Visible
		*!*				ThisFormSet.CalcInv(2)
		*!*			ELSE
		*!*			IF ThisFormset.QUOTES.SZ31.Value > 0
		*!*				ThisFormSet.CalcInv(3) 
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		PRIVATE pForm
		pForm = This.Value
		
		IF NOT EMPTY(pForm)
			IF GetFormCaptions(pForm,ThisFormSet.nConnHandle)
				IF USED('tmpFormCaptions')
					*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
					ThisForm.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.LBLSZ21.Caption = RTRIM(tmpFormCaptions.txt2)
					ThisForm.LBLSZ31.Caption = RTRIM(tmpFormCaptions.txt3)
					ThisForm.LBLSZ31.Visible = tmpFormCaptions.lblSz3Vis
					ThisForm.LBLSZ41.Visible = tmpFormCaptions.use3rdDim
					ThisForm.LBLSZ41.Caption = RTRIM(tmpFormCaptions.txt4)
					USE IN tmpFormCaptions
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmVendorImport.cmdCancel.Click
		SELECT 'tmpVendorStock'
		GO BOTTOM
		SKIP 1
		
		ThisFormset.SaveAll = .F.
		
		ThisFormSet.GetGenerickVendorImport()
		
	ENDPROC

	PROCEDURE frmVendorImport.cmdHide.Click
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE frmVendorImport.cmdSaveAll.Click
		ThisFormset.SaveAll = .T.
		
		DO WHILE ThisFormset.SaveAll
			ThisForm.cmdSaveStockImport.Click
			
		ENDDO
	ENDPROC

	PROCEDURE frmVendorImport.cmdSaveStockImport.Click
		
		*Save
		PRIVATE nID, cAlloy, cForm, cCC, nPc, nDim1, nDim2, nDim3
		PRIVATE nMWeight, cSpecs, cHeat, cCond, cDescript
		PRIVATE cBrandName, cVendor, cMill, cMelt, dRemoveDate
		*,Size,CCSortValue,FormSort
		nID		= 0
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12,.F.,.T.)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2,.F.,.T.)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.F.,.T.)
		nPc		= PrepareSQLnum(ThisForm.Pieces1.Value,'Pc',8,1)
		nDim1	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
		nDim2	= PrepareSQLnum(ThisForm.SZ21.Value,'Sz2',9,3)
		nDim3	= PrepareSQLnum(ThisForm.SZ31.Value,'Sz3',9,3)
		nMWeight = PrepareSQLnum(ThisForm.Weight1.Value,'Weight',9,1)
		cSpecs	= PrepareSQLtxt(ThisForm.txtSpecs.Value,'Specs',160,.F.,.T.)
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.F.,.T.)
		cCond	= PrepareSQLtxt(ThisForm.txtCond.Value,'Cond',50,.F.,.T.)
		cDescript 	= PrepareSQLtxt(ThisForm.txtDescript.Value,'Descript',20,.F.,.T.)
		cBrandName 	= PrepareSQLtxt(ThisForm.txtBrandName.Value,'BrandName',20,.F.,.T.)
		cVendor 	= PrepareSQLtxt(ThisForm.txtVendor.Value,'Vendor',30,.F.,.T.)
		cMill 		= PrepareSQLtxt(ThisForm.txtMill.Value,'Mill',10,.F.,.T.)
		cMelt 		= PrepareSQLtxt(ThisForm.txtMelt.Value,'Melt',7,.F.,.T.)
		dRemoveDate	= PrepareSQLdate(ThisForm.txtRemoveDate.Value,'RemoveDate')
		*ThisForm.txtAddDate.Value
		
		
		IF NOT EMPTY(cVendor)
			IF NOT EMPTY(ThisFormSet.Stocklst_vendor)
				IF ThisFormSet.Stocklst_vendor != cVendor
					ThisFormSet.Stocklst_vendor = cVendor
					
					IF MESSAGEBOX("Do you want ro remove previous entries for '"+cVendor+"'",4+32,"Remove old Vendor records?") = 6
						
						cSQL = "DELETE FROM dbo.StockLst_Vendor WHERE Vendor='"+cVendor+"'"
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
						ENDIF
					ENDIF
				ENDIF
			ENDIF		
		ENDIF
				
		PRIVATE cSQL, nSQLEXEC
		
		*******************************************
		*Check to See if it already exists
		IF USED('tmpCntVendor')
			USE IN tmpCntVendor
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Vendor "
		cSQL = cSQL+"WHERE "
		cSQL = cSQL+" Alloy='"+cAlloy+"'"
		cSQL = cSQL+" AND Form='"+cForm+"'"
		cSQL = cSQL+" AND CC='"+cCC+"'"
		cSQL = cSQL+" AND Pc="+STR(nPc)+""
		cSQL = cSQL+" AND Dim1="+STR(nDim1,10,4)+""
		cSQL = cSQL+" AND Dim2="+STR(nDim2,9,3)+""
		cSQL = cSQL+" AND Dim3="+STR(nDim3,9,3)+""
		cSQL = cSQL+" AND MWeight="+STR(nMWeight,9,1)+""
		cSQL = cSQL+" AND mS_QTY="+STR(nMWeight,9,1)+""  &&mS_QTY
		cSQL = cSQL+" AND Specs='"+cSpecs+"'"
		cSQL = cSQL+" AND Heat='"+cHeat+"'"
		*cSQL = cSQL+" AND Cond='"+cCond+"'"
		cSQL = cSQL+" AND Descript='"+cDescript+"'"
		cSQL = cSQL+" AND Size="+STR(nDim1,10,4)+""
		cSQL = cSQL+" AND BrandName='"+cBrandName+"'"
		cSQL = cSQL+" AND Vendor='"+cVendor+"'"
		cSQL = cSQL+" AND Mill='"+cMill+"'"
		cSQL = cSQL+" AND Melt='"+cMelt+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCntVendor' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntVendor' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntVendor")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntVendor")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpCntVendor')
		ENDIF
		IF USED('tmpCntVendor')
			IF tmpCntVendor.CNT > 0
				*Delete
				cSQL = "DELETE FROM dbo.StockLst_Vendor "
				cSQL = cSQL+"WHERE "
				cSQL = cSQL+" Alloy='"+cAlloy+"'"
				cSQL = cSQL+" AND Form='"+cForm+"'"
				cSQL = cSQL+" AND CC='"+cCC+"'"
				cSQL = cSQL+" AND Pc="+STR(nPc)+""
				cSQL = cSQL+" AND Dim1="+STR(nDim1,10,4)+""
				cSQL = cSQL+" AND Dim2="+STR(nDim2,9,3)+""
				cSQL = cSQL+" AND Dim3="+STR(nDim3,9,3)+""
				cSQL = cSQL+" AND MWeight="+STR(nMWeight,9,1)+""
				cSQL = cSQL+" AND mS_QTY="+STR(nMWeight,9,1)+""  &&mS_QTY
				cSQL = cSQL+" AND Specs='"+cSpecs+"'"
				cSQL = cSQL+" AND Heat='"+cHeat+"'"
		*		cSQL = cSQL+" AND Cond='"+cCond+"'"
				cSQL = cSQL+" AND Descript='"+cDescript+"'"
				cSQL = cSQL+" AND Size="+STR(nDim1,10,4)+""
				cSQL = cSQL+" AND BrandName='"+cBrandName+"'"
				cSQL = cSQL+" AND Vendor='"+cVendor+"'"
				cSQL = cSQL+" AND Mill='"+cMill+"'"
				cSQL = cSQL+" AND Melt='"+cMelt+"'"
		
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC )
				ENDIF
			ENDIF
		ENDIF
		
		
		*INSERT
		cSQL = "INSERT INTO dbo.StockLst_Vendor "
		cSQL = cSQL+"( Alloy,Form,CC,Pc,Dim1,Dim2,Dim3"
		cSQL = cSQL+",MWeight,mS_QTY,Specs,Heat,Cond,Descript"
		cSQL = cSQL+",Size,BrandName,CCSortValue,FormSort,Vendor,Mill,Melt,RemoveDate )"
		cSQL = cSQL+" VALUES ("
		cSQL = cSQL+"'"+cAlloy+"'"
		cSQL = cSQL+",'"+cForm+"'"
		cSQL = cSQL+",'"+cCC+"'"
		cSQL = cSQL+","+STR(nPc)+""
		cSQL = cSQL+","+STR(nDim1,10,4)+""
		cSQL = cSQL+","+STR(nDim2,9,3)+""
		cSQL = cSQL+","+STR(nDim3,9,3)+""
		cSQL = cSQL+","+STR(nMWeight,9,1)+""
		cSQL = cSQL+","+STR(nMWeight,9,1)+""  &&mS_QTY
		cSQL = cSQL+",'"+cSpecs+"'"
		cSQL = cSQL+",'"+cHeat+"'"
		cSQL = cSQL+",'"+cCond+"'"
		cSQL = cSQL+",'"+cDescript+"'"
		cSQL = cSQL+","+STR(nDim1,10,4)+""
		cSQL = cSQL+",'"+cBrandName+"'"
		cSQL = cSQL+",dbo.f_GetCCSortValue("+cCC+")"
		cSQL = cSQL+",dbo.f_FormSort("+cForm+")"
		cSQL = cSQL+",'"+cVendor+"'"
		cSQL = cSQL+",'"+cMill+"'"
		cSQL = cSQL+",'"+cMelt+"'"
		*cSQL = cSQL+",'"+DTOC(dRemoveDate)+"'"
		cSQL = cSQL+",'"+IIF(EMPTY(dRemoveDate),'',DTOC(dRemoveDate))+"'"
		cSQL = cSQL+")"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
		ENDIF
		
		ThisFormSet.GetGenerickVendorImport()
		
		IF EMPTY(ThisForm.Alloy1.Value)
			ThisForm.ALLOY1.SetFocus
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmVendorImport.cmdSkipStockImport.Click
		ThisForm.cmdSaveStockImport.Enabled = .T.
		
		ThisFormSet.GetGenerickVendorImport()
		*Abort
		*ThisForm.Visible = .F.
		ThisForm.ALLOY1.SetFocus
		
	ENDPROC

	PROCEDURE frmVendorImport.LBLPIECES1.Click
		
		PRIVATE cAlloy,cForm,cCC,cCL,nPieces,nThck,nSz2,nSz3,nForceBracket
		cAlloy = PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12,.F.,.T.)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2,.F.,.T.)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		*nPieces	= PrepareSQLnum(ThisForm.Pieces1.Value,'Pieces',-3)
		nPieces	= 1
		nThck	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(ThisForm.Sz21.Value,'sz2',9,3)
		nSz3	= PrepareSQLnum(ThisForm.Sz31.Value,'Sz3',9,3)
		nForceBracket = .F.
		nWeight = PrepareSQLnum(ThisForm.WEIGHT1.Value,'Weight',7,1)
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		cSQL = cSQL + ",''" &&CustID
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			
			PRIVATE cMess
			cMess = "Could not get the Price!"+CHR(13)
			IF nPieces > 10000
				cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
			ENDIF
			IF nThck > 16
				cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
			ENDIF
			IF nSz2	> 120
				cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
			ENDIF
			IF nSz3	 > 300
				cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
			ENDIF
			MESSAGEBOX(cMess,16,"Edit your input numbers")
			
		ENDIF
		
		IF USED('tmpPriceTbl')
			IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
				IF tmpPriceTbl.Pounds > 0
					
					nPoundsPc = tmpPriceTbl.Pounds
		
					nPC = ROUND(nWEIGHT / nPoundsPc,0)
		*			WAIT WINDOW ALLTRIM(STR(tmpPriceTbl.Pounds,10,1))+" LBS" NOWAIT
						
					ThisForm.Pieces1.Value = nPC
					ThisForm.Pieces1.Refresh
		
		*			ThisForm.WEIGHT1.Refresh
				ENDIF
			ENDIF
			USE IN tmpPriceTbl
		ENDIF
	ENDPROC

	PROCEDURE frmVendorImport.lblRemoveDate.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = This.Parent.txtRemoveDate.Value
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		This.Parent.txtRemoveDate.Value = dDate2
		This.Parent.txtRemoveDate.Refresh
		This.Parent.txtRemoveDate.SetFocus
	ENDPROC

