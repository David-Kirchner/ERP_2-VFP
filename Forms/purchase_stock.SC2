		INDEX ON (StockLst_Review.CurrStock + StockLst_Review.StockDue - StockLst_Review.SafeLevel)+StockLst_Review.Yr1Sales ASCENDING TAG BelowSf
		*INDEX ON (StockLst_Review.CurrStock + StockLst_Review.StockDue - StockLst_Review.SafeLevel) ASCENDING TAG BelowSf
		
