	ENDPROC

	PROCEDURE remeltresourcecsvimport
		PARAMETER cFile
		*ThisFormSet.RemeltResourceCSVimport()
		*Col1:Alloy, Col2:UNS, Col3:Size and Form, Col4 Pieces, Col5 Weight, Col6:Heat, Col7:Comment
		*Append FROM CSV
		
		
		IF USED('tmpRemeltSources')
			USE IN tmpRemeltSources
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\tmpRemeltSources.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\tmpRemeltSources.dbf")
		ENDIF
		
		SELECT 0
		CREATE TABLE SYS(5)+SYS(2003)+"\tmpRemeltSources" FREE ( Alloy C(30), [UNS] C20, [Size] C(30), [Pieces] C10, [Weight] C10, [Heat] C(15), [Comment] C(25) )
		USE (SYS(5)+SYS(2003)+"\tmpRemeltSources.DBF") EXCL 
		
		
		IF USED('tmpRemeltSources')
			SELECT tmpRemeltSources
		ENDIF
		
		*******
		IF NOT USED('tmpRemeltSources')
			RETURN .F.
		ENDIF
		
		SELECT tmpRemeltSources
		APPEND FROM (cFile) TYPE CSV
		PRIVATE cPrevDia, cPrevAlloy 
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill
		SELECT tmpRemeltSources
		SCAN
			*Look for Alloy
			cAlloy = tmpRemeltSources.Alloy
		*	lcTryAlloy = ''
			
			IF AT("/",cAlloy) > 0
				cAlloy = LEFT(cAlloy, AT("/",cAlloy)-1)
			ENDIF
			
			lcTryAlloy = SearchAlloyStandard(LEFT(cAlloy,12), ThisFormSet.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)
				cAlloy = lcTryAlloy
			ELSE
				cAlloy = ''
			ENDIF
			
			DO CASE
			CASE "DIA" $ tmpRemeltSources.Size
				cForm = '10'
			CASE "RD" $ tmpRemeltSources.Size
				cForm = '10'
			CASE "RCS" $ tmpRemeltSources.Size
				cForm = '98'
			CASE "SQUARE" $ tmpRemeltSources.Size
				cForm = '13'
			CASE "T" $ tmpRemeltSources.Size AND "W" $ tmpRemeltSources.Size
				cForm = '96'
			OTHERWISE
				cForm = ''
			ENDCASE
				
			cCC			= '1'
		
			cThickness	= STR( VAL(tmpRemeltSources.Size) ,10,3)
			
			
			cWidth		= '' &&tmpRemeltSources.Size
			cLength		= '' &&tmpRemeltSources.Size
			cPCS		= tmpRemeltSources.Pieces
			cWeight		= STRTRAN(tmpRemeltSources.Weight,[,],"")
			cCondition	= PrepareSQLtxt(tmpRemeltSources.Comment,'Condition',30)
			cSpecs		= tmpRemeltSources.UNS
		
			IF "ESR" $ tmpRemeltSources.Alloy
				cMelt		= 'ESR' 
			ELSE
				cMelt		= '' 
			ENDIF
			cHeat		= tmpRemeltSources.Heat
			cBrandName	= tmpRemeltSources.Alloy
			cVendor		= "RSI"
			cMill 		= "Remelt Sources"
			
			*****************************************
			
			IF EMPTY(cForm)
				SELECT tmpRemeltSources
				LOOP
			ENDIF
			
			IF VAL(cWeight) = 0
				SELECT tmpRemeltSources
				LOOP
			ENDIF
		
		*	IF EMPTY( cBrandName )
		*		cBrandName = cPrevAlloy 
		*	ENDIF
		*	IF EMPTY( cThickness )
		*		cThickness = cPrevDia
		*	ENDIF
			
			INSERT INTO tmpVendorStock ;
			(Alloy,Form,CC,Thickness,Width,Length,PCS,Weight,Condition,Specs,Melt,Heat,BrandName,Vendor,Mill);
			 VALUES ;
			(cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill)
			
			cPrevAlloy	= cBrandName
			cPrevDia	= cThickness
			
			SELECT tmpRemeltSources
		ENDSCAN
		
		
		RETURN .T.
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE remeltresourcetxtimport
		PARAMETERS cFileName
		*ThisFormSet.RemeltResourcesTXTimport()
		*Open PDF, Select Text, open Notepad, paste, save as text file (RSI - BILLET STOCK LIST.txt)
		IF VARTYPE(cFileName) != "C"
			RETURN .F.
		ENDIF
		
		PRIVATE lReturn
		lReturn = .T.
		
		SELECT tmpVendorStock
		
		LOCAL lnFileHandle && numeric file handle
		
		lnFileHandle = FOPEN(cFileName)
		
		IF lnFileHandle = -1
		
		   MESSAGEBOX("Could not open File")
		   && do something to handle the error
		
		   RETURN .F.
		
		ENDIF
		
		LOCAL lcLine && define a variable to hold each line
		
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cHeat,cBrandName,cVendor,cMill
		cVendor	= "Remelt Souces"
		cMill	= "RSI"
		
		PRIVATE lFoundAlloy, lFoundUNS,cNextBrandName 
		lFoundAlloy = .F.
		lFoundUNS = .F.
		cNextBrandName = ''
		PRIVATE cLineNow,nAT
		PRIVATE cSQL, nSQLEXEC
		
		*MESSAGEBOX("ThisFormSet.RemeltResourcesTXTimport() has not been coded!")
		
		DO WHILE NOT FEOF( lnFileHandle ) && loop through the file
		
			IF FEOF( lnFileHandle ) 
				EXIT
			ENDIF
		
				
			*Parse
			***********************************************************
			*Look for Alloy
			IF lFoundAlloy 
				cAlloy = cNextAlloy
				cBrandName = cNextBrandName
				*do not fGet
		
		*!*			IF AT("/",cAlloy) > 0
		*!*				cAlloy = LEFT(cAlloy, AT("/",cAlloy)-1)
		*!*			ENDIF
		
			ELSE
				IF NOT FEOF( lnFileHandle) 
					lcLine = FGETS( lnFileHandle) && store each line in lcLine
					lcLine = ALLTRIM(UPPER(lcLine))
				ENDIF
				cAlloy = ALLTRIM(lcLine)
				cBrandName = cAlloy
				IF "LOCO" $ cAlloy 
					cNextAlloy = ALLTRIM(LEFT(cAlloy, AT("LOCO",cAlloy)-1 ))
				ENDIF
				IF RIGHT(cAlloy,3) = "ESR"
					cAlloy = LEFT(cAlloy, LEN(cAlloy)-4)
				ENDIF
				IF LEFT(cAlloy,5) = "ALLOY"
					IF LEN(cAlloy) > 8  &&Exclude Alloy 20
						cAlloy = RIGHT(cAlloy, LEN(cAlloy)-6)
					ENDIF
				ENDIF
		
		
		*		IF AT("/",cAlloy) > 0
		*			cAlloy = LEFT(cAlloy, AT("/",cAlloy)-1)
		*		ENDIF
				
			ENDIF
			****
			lcTryAlloy = SearchAlloyStandard(LEFT(cAlloy,12), ThisFormSet.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)
				IF NOT EMPTY(cNextBrandName)
					cBrandName = cNextBrandName
				ELSE
					cBrandName = ALLTRIM(cAlloy)
				ENDIF
				
				cAlloy = lcTryAlloy
			ELSE
				WAIT WINDOW "Alloy "+cAlloy+ " not found in Alloys Table." NOWAIT
				*lcLine = FGETS( lnFileHandle) &&UNS
				cTestUNS = LEFT(lcLine,6)
				
				IF USED('tmpUNS')
					USE IN tmpUNS
				ENDIF
				
				SELECT 0
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Alloy WHERE UNS = '"+cTestUNS+"'"
			
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUNS' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUNS' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUNS")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUNS")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUNS')
				ENDIF
				
				IF USED('tmpUNS')
					IF tmpUNS.Cntd > 0
						lFoundUNS = .T.
					ELSE
						lFoundUNS = .F.
					ENDIF
					USE IN tmpUNS
				ELSE
					lFoundUNS = .F.
				ENDIF
				
				IF lFoundUNS
					IF cUNS = "N04400"	
						WAIT WINDOW cUNS
					ENDIF
					
					*Skip these
					lcLine = FGETS( lnFileHandle) &&Thickness \ Form
					lcLine = FGETS( lnFileHandle) &&Pieces
					lcLine = FGETS( lnFileHandle) &&Lbs
					lcLine = FGETS( lnFileHandle) &&Heat
					lcLine = FGETS( lnFileHandle) &&Comments 
		
					*Look for Comments - Optional
					cComments = ALLTRIM(lcLine)
					cNextAlloy = cComments 
		
					*Look for Alloy
					IF RIGHT(cNextAlloy ,3) = "ESR"
						cNextAlloy = LEFT(cNextAlloy , LEN(cNextAlloy )-4)
					ENDIF
					IF LEFT(cNextAlloy ,5) = "ALLOY"
						*cNextAlloy = RIGHT(cNextAlloy , LEN(cNextAlloy )-6)
						IF LEN(cNextAlloy ) > 8  &&Exclude Alloy 20
							cNextAlloy = RIGHT(cNextAlloy , LEN(cNextAlloy )-6)
						ENDIF
		
					ENDIF
					
					lcTryAlloy = SearchAlloyStandard(LEFT(cNextAlloy ,12), ThisFormSet.nConnHandle)
					IF NOT EMPTY(lcTryAlloy)
						lFoundAlloy = .T.
						cNextBrandName = ALLTRIM(cComments)
						cNextAlloy = lcTryAlloy
						
						cComments = ''  &&Do not save as a comment
			*			LOOP
					ELSE
						lFoundAlloy = .F.
					ENDIF
				ELSE
					*did not find Alloy
					*did not find UNS
					lFoundAlloy = .F.
				ENDIF
				
				LOOP
			ENDIF
			****
			
			IF NOT FEOF( lnFileHandle) 
				lcLine = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLine))
			ENDIF
			***********************************************************
			
			*Look for UNS
			cUNS = LEFT(lcLine,6)
			
			IF USED('tmpUNS')
				USE IN tmpUNS
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Alloy WHERE UNS = '"+cUNS+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUNS' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUNS' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUNS")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUNS")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUNS')
			ENDIF
			
			IF USED('tmpUNS')
				IF tmpUNS.Cntd > 0
					lFoundUNS = .T.
				ELSE
					lFoundUNS = .F.
				ENDIF
				USE IN tmpUNS
			ELSE
				lFoundUNS = .F.
			ENDIF
			
			IF lFoundUNS
					IF cUNS = "N04400"	
						WAIT WINDOWcUNS
					ENDIF
					
				IF cUNS = GetUNS( LEFT(cAlloy, IIF(AT("/",cAlloy)>0,AT("/",cAlloy)-1,LEN(cAlloy))), ThisFormSet.nConnHandle )
					*GOOD
				ELSE
					*Should this be dropped?
					MESSAGEBOX("Alloys is "+cAlloy+CHR(13)+"UNS is "+cUNS+CHR(13)+"Not a match!",0+48,"Dropping InputLine")
					lFoundAlloy = .F.
					LOOP
				ENDIF
			ELSE
				lFoundAlloy = .F.
				LOOP
			ENDIF
				
			IF NOT FEOF( lnFileHandle) 
				lcLine = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLine))
			ENDIF
			***********************************************************
			
			*Look for Thickness \ Form
			cThickness = ALLTRIM(lcLine)
			cFormName = cThickness
			IF AT(["],cThickness) > 0
				IF LEFT(cThickness ,1) = '"'
					cThickness = RIGHT( cThickness, LEN(cThickness)-1)
				ENDIF
				IF LEFT(cThickness ,1) = '"' &&Try Again
					cThickness = RIGHT( cThickness, LEN(cThickness)-1)
				ENDIF
				
				IF AT(["],cThickness) > 0
					cThickness = LEFT(cThickness,AT(["],cThickness)-1)
				ELSE
					cThickness = cThickness	&&Bad, lost Thickness and Form!
				ENDIF
			ENDIF
			
			IF AT(["],cFormName) > 0	
				cFormName = ALLTRIM(cFormName)
				IF RIGHT(cFormName,1) = '"'
					cFormName = LEFT( cFormName, LEN(cFormName)-1)
				ENDIF
				IF LEFT(cFormName,1) = '"'
					cFormName= RIGHT( cFormName, LEN(cFormName)-1)
				ENDIF
		
				IF RIGHT(cFormName,1) = '"' &&Try Again
					cFormName = LEFT( cFormName, LEN(cFormName)-1)
				ENDIF
				
				IF AT(["],cFormName) > 0
					nOccurs = OCCURS(["],cFormName)  &&Use last Occurance
					cFormName = UPPER( RIGHT(cFormName, LEN(cFormName)-AT(["],cFormName,nOccurs) ) )
				ELSE
					cFormName = UPPER( cFormName )&&Bad, lost Thickness and Form!
				ENDIF
			ENDIF		
			** 
			nThickness = Convert_Fractions_to_Numeric(cThickness)
			cThickness = Remove0( nThickness,10,3 )
			cFormName = UPPER(ALLTRIM(cFormName))
			**
			DO CASE
			CASE "DIA" $ cFormName 
				cForm = '10'
			CASE "RD" $ cFormName 
				cForm = '10'
			CASE "SQUARE" $ cFormName 
				cForm = '13'
			CASE "RCS" $ cFormName 
				cForm = '98'
			OTHERWISE
				cForm = ''	
				WAIT WINDOW "No Form, Any Key..."	
			ENDCASE
			**
			
			IF NOT FEOF( lnFileHandle) 
				lcLine = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLine))
			ENDIF
			***********************************************************
		
			*Look for Pieces
			cPCS = ALLTRIM(lcLine)
		
			IF NOT FEOF( lnFileHandle) 
				lcLine = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLine))
			ENDIF
			***********************************************************
		
			*Look for Lbs
			cWeight = ALLTRIM(lcLine)
		
			IF NOT FEOF( lnFileHandle) 
				lcLine = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLine))
			ENDIF
			***********************************************************
		
			*Look for Heat
			cHEAT = ALLTRIM(lcLine)
		
			IF NOT FEOF( lnFileHandle) 
				lcLine = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLine))
			ENDIF
		
			***********************************************************
			*Look for Comments - Optional
			cComments = ALLTRIM(lcLine)
			cNextAlloy = cComments 
		
			*Look for Alloy
			IF "LOCO" $ cNextAlloy
				cNextAlloy = ALLTRIM(LEFT(cNextAlloy, AT("LOCO",cNextAlloy )-1 ))
			ENDIF
			IF RIGHT(cNextAlloy ,3) = "ESR"
				cNextAlloy = LEFT(cNextAlloy, LEN(cNextAlloy )-4)
			ENDIF
			IF LEFT(cNextAlloy ,5) = "ALLOY"
				IF LEN(cNextAlloy ) > 8  &&Exclude Alloy 20
					cNextAlloy = RIGHT(cNextAlloy , LEN(cNextAlloy )-6)
				ENDIF
			ENDIF
			
			lcTryAlloy = SearchAlloyStandard(LEFT(cNextAlloy ,12), ThisFormSet.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)
				lFoundAlloy = .T.
				cNextBrandName = ALLTRIM(cComments)
				cNextAlloy = lcTryAlloy
				
				cComments = ''  &&Do not save as a comment
		*			LOOP
			ELSE
				lFoundAlloy = .F.
			ENDIF
		
			***********************************************************
			cCC = ''
			
			IF cForm = '13' OR cForm = '98'
				*Square
				cWidth = cThickness
			ELSE
				cWidth = ''
			ENDIF
			
			IF LEN(cComments ) > 0
				cLength = cComments 
			ELSE
				cLength = " "
			ENDIF
			
			cCondition = ''
			cSpecs	= ''
			
			****
		   
			*INSERT INTO CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock" 
			*( Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
			
			SELECT tmpVendorStock 
			APPEND BLANK
			
			REPLACE Alloy WITH cAlloy
			REPLACE Form WITH cForm
			REPLACE CC WITH cCC
			REPLACE Thickness WITH cThickness
			REPLACE Width WITH cWidth
			REPLACE Length WITH cLength
			REPLACE PCS WITH cPCS
			REPLACE Weight WITH cWeight
			REPLACE Condition WITH cCondition
			REPLACE Specs WITH cSpecs
			REPLACE Heat WITH cHeat
			REPLACE BrandName WITH cBrandName
			REPLACE Vendor WITH cVendor
			REPLACE Mill WITH cMill
			
		ENDDO
		
		FCLOSE( lnFileHandle) && don't forget to close the file
		
		RETURN lReturn
	ENDPROC

	PROCEDURE setstocklst_revieworder
		*ThisFormSet.SetStockLst_ReviewOrder()
		
		nSortOrder1 = ThisFormSet.frmStockReviewSort.oGrp1.Value
		*nSortOrder2 = ThisFormSet.frmStockReviewSort.oGrp2.Value
		*	1 Broker
		*	2 3YrSales
		*	3 1YrSales
		*	4 AvgSales
		*	5 CurrStock
		*	6 No Sort
		
		IF NOT USED('StockLst_Review')
			ThisFormSet.GetStockLst_Review()
		ENDIF
		
		SELECT 'StockLst_Review'
		
		DO CASE
		CASE nSortOrder1 = 1
			INDEX ON Broker DESCENDING TAG Broker
		CASE nSortOrder1 = 2
			INDEX ON Yr3Sales DESCENDING TAG Yr3Sales 
		CASE nSortOrder1 = 3
			INDEX ON Yr1Sales DESCENDING TAG Yr1Sales 
		CASE nSortOrder1 = 4
			INDEX ON AvgStock DESCENDING TAG AvgStock 
		CASE nSortOrder1 = 5
			INDEX ON CurrStock DESCENDING TAG CurrStock 
		CASE nSortOrder1 = 6
			INDEX ON Alloy+Form+CC+STR(Thck,10,3) ASCENDING TAG Stock
		*	INDEX ON IIF(Crutial,'1','0') + IIF(Active,'1','0') + STR(CurrStock-SafeLevel)	 TAG CurrSafe
		ENDCASE
		
		
		ThisFormSet.frmStockReview.grdStockLst.Refresh
		ThisFormSet.RefreshStocklst_Review()
	ENDPROC

	PROCEDURE Unload
		= FCLOSE( ThisFormSet.nConnHandle )
		= SQLDISCONNECT(ThisFormSet.nConnHandle)
	ENDPROC

	PROCEDURE zappcsvimport
		PARAMETER cFile
		*ThisFormSet.ZappCSVimport()
		*Col1:Alloy, Col2:Form, Col3:Dia, Col4 Lbs
		*Append FROM CSV
		
		
		IF USED('tmpZappstock')
			USE IN tmpZappstock
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\tmpZappstock.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\tmpZappstock.dbf")
		ENDIF
		
		SELECT 0
		*CREATE TABLE SYS(5)+SYS(2003)+"\tmpZappstock" FREE ( Alloy C(20), [Form] C(10), [Dia] C(10), LBS C(10))
		CREATE TABLE SYS(5)+SYS(2003)+"\tmpZappstock" FREE ( [Shape] C50, [din] C50, Alloy C(20), Dmm N(9,3), Dinch N(9,3), Tmm N(9,3), Tinch N(9,3), Wmm INT, Lmm INT, PartCode INT,Batch INT, Heat C(50), PCS INT, Lbs INT )
		USE (SYS(5)+SYS(2003)+"\tmpZappstock.DBF") EXCL 
		
		
		IF USED('tmpZappstock')
			SELECT tmpZappstock
		ENDIF
		
		*******
		IF NOT USED('tmpZappstock')
			RETURN .F.
		ENDIF
		
		SELECT tmpZappstock
		APPEND FROM (cFile) TYPE CSV
		PRIVATE nPrevDia, cPrevAlloy 
		*PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill
		PRIVATE cShape, cDin, cAlloy, nDmm, nDinch, nTmm, nTinch, nWmm, nLmm, nPartCode, nBatch, cHeat, nPCS, nLbs
		SELECT tmpZappstock
		SCAN
			*Alloy C(20), [Dia] C(10), [Form] C(10), LBS C(10)
			*cShape, cDin, cAlloy, nDmm, nDinch, nTmm, nTinch, nLmm, nPartCode,nBatch, cHeat, nLbs
			cAlloy		= ''
			DO CASE
			CASE tmpZappstock.Shape='Round bar'
				cForm	= '10'
				nThickness	= PrepareSQLnum(tmpZappstock.Dinch,'Inch',9,3)
				nWidth		= 0
				
			CASE tmpZappstock.Shape='Sheet/ Plate'
				cForm	= '40'
				nThickness	= PrepareSQLnum(tmpZappstock.Tinch,'Inch',9,3)
				nWidth		= PrepareSQLnum(tmpZappstock.Wmm,'Wmm',9,2) / 25.4
		
			CASE tmpZappstock.Shape='Welded Wire'
				cForm	= '20'
			CASE tmpZappstock.Shape='Wire on spool'
				cForm	= '20'
			CASE tmpZappstock.Shape='Coated electrode'
				cForm = '30'
			OTHERWISE
				cForm = ''
			ENDCASE
			
			cCC			= '1'
			nLength		= PrepareSQLnum(tmpZappstock.Lmm,'Lmm',9,3) / 24.5
			nPCS		= PrepareSQLnum(tmpZappstock.PCS,'PC',-3)
			nLBS		= PrepareSQLnum(tmpZappstock.LBS,'LBS',-3)
		*	cWeight		= STRTRAN(tmpZappstock.LBS,[,],"")
			cCondition	= ''
			cSpecs		= ''
			cMelt		= ''
			cHeat		= PrepareSQLtxt(tmpZappstock.Heat,'Heat',50,.F.,.T.)
			cBrandName	= PrepareSQLtxt(tmpZappstock.Alloy,'Alloy',12,.F.,.T.)
			cVendor		= "Zapp"
			cMill 		= "Haynes German"
			
			IF EMPTY(cForm)
				SELECT tmpZappstock
				LOOP
			ENDIF
			
			IF nLBS = 0
				SELECT tmpZappstock
				LOOP
			ENDIF
		
		*	IF EMPTY( cBrandName )
		*		cBrandName = cPrevAlloy 
		*	ENDIF
		*	IF EMPTY( cThickness )
		*		cThickness = cPrevDia
		*	ENDIF
			
			INSERT INTO tmpVendorStock ;
			(Alloy,Form,CC,Thickness,Width,Length,PCS,Weight,Condition,Specs,Melt,Heat,BrandName,Vendor,Mill);
			 VALUES ;
			(cAlloy,cForm,cCC,nThickness,nWidth,nLength,nPCS,nLBS,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill)
		
			cPrevAlloy	= cBrandName
			nPrevDia	= nThickness
			
			SELECT tmpZappstock
		ENDSCAN
		
		
		RETURN .T.
		
		
		
		
		
		
		
	ENDPROC

