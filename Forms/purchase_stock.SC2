	PROCEDURE frmSafeLevel.chkFilter.Click
		PRIVATE cFilterAlloy,nStockLst_ID
		nStockLst_ID = ThisForm.stockLst_ID.Value
		
		IF This.Value = 1
			cFilterAlloy = ThisForm.txtFilterAlloy.Value
			
			IF ThisForm.txtFilterAlloy.FORECOLOR != RGB(0,0,0)
				*Did not find Alloy
				cFilterAlloy = ''
			ENDIF
			
			IF EMPTY(cFilterAlloy)
				cFilterAlloy = ThisForm.Alloy1.Value
				ThisForm.txtFilterAlloy.Value = cFilterAlloy 
			ENDIF
			ThisFormSet.getStockLst_SafeLevel(cFilterAlloy)
			
		ELSE
			ThisForm.txtFilterAlloy.Value = ''
			ThisFormSet.getStockLst_SafeLevel()
		ENDIF
		
					
		SELECT StockLst_SafeLevel
		INDEX ON ID TAG ID
		SEEK nStockLst_ID
		GOTO RECNO(0)	
		ThisFormSet.RefreshStockLst_SafeLevel()
		
	ENDPROC

