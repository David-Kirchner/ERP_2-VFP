		IF USED('ConditionLevel')
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CL
		
		
	ENDPROC

	PROCEDURE frmVendorStock.cmbCL.Valid
		*!*	IF ThisFormset.QUOTES.THCK1.Value * ThisFormset.QUOTES.SZ21.Value > 0
		*!*		IF NOT ThisFormset.QUOTES.SZ31.Visible
		*!*	*		IF ThisFormset.QUOTES.SZ21.Value > 0
		*!*				ThisFormSet.CalcInv(2)
		*!*	*		ENDIF
		*!*		ELSE
		*!*			IF ThisFormset.QUOTES.SZ31.Value > 0
		*!*				ThisFormSet.CalcInv(3) 
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmVendorStock.cmbCL.When
		RETURN ThisFormSet.IsEditingStockLst_Vendor 
	ENDPROC

	PROCEDURE frmVendorStock.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE frmVendorStock.cmbForm.Valid
		PRIVATE pForm
		pForm = This.Value
		
		IF NOT EMPTY(pForm)
			IF GetFormCaptions(pForm,ThisFormSet.nConnHandle)
				IF USED('tmpFormCaptions')
					*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
					ThisForm.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.LBLSZ21.Caption = RTRIM(tmpFormCaptions.txt2)
					ThisForm.LBLSZ31.Caption = RTRIM(tmpFormCaptions.txt3)
					ThisForm.LBLSZ31.Visible = tmpFormCaptions.lblSz3Vis
					ThisForm.LBLSZ41.Visible = tmpFormCaptions.use3rdDim
					ThisForm.LBLSZ41.Caption = RTRIM(tmpFormCaptions.txt4)
					USE IN tmpFormCaptions
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmVendorStock.cmbForm.When
		RETURN ThisFormSet.IsEditingStockLst_Vendor 
	ENDPROC

	PROCEDURE frmVendorStock.cmdDelete.Click
		IF THIS.Caption = "Delete"
			*Delete
			This.Parent.cmdNew.Enabled = .T.
			This.parent.cmdEdit.Enabled = .T.
			
			PRIVATE nStockLst_ID, cAlloy, cForm, cCC, nThck, cDescr
			nStockLst_ID = This.parent.StockLst_ID.Value
			cAlloy	= This.Parent.AlLOY1.Value
			cForm	= This.Parent.cmbForm.Value
			cCC		= This.Parent.cmbCC.Value
			nThck	= This.Parent.Thck1.Value
			cDescr = ALLTRIM(cAlloy)+" "+cForm+" "+cCC+" "+ALLTRIM(STR(nThck,10,4))
			
			IF nStockLst_ID > 0
				IF MESSAGEBOX( "Are you sure you want to Delete ID:"+ALLTRIM(STR(nStockLst_ID))+"?"+CHR(13)+cDescr,4+64,"Delete (Y/N)") = 6
					
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "DELETE dbo.Stocklst_Vendor WHERE ID ="+ALLTRIM(STR(nStockLst_ID))
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					ThisFormSet.GetStockLst_Vendor()
					
					SELECT StockLst_Vendor
					INDEX ON ID TAG ID
					SEEK nStockLst_ID
					GOTO RECNO(0)	
					ThisForm.grdStockLst.refresh
					ThisFormSet.RefreshStockLst_Vendor()
					
				ENDIF
			ENDIF
		ELSE
		*Abort
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdEdit.Caption = "Edit"
			This.parent.cmdEdit.Enabled = .T.
			This.Caption = "Delete"
			ThisFormSet.IsEditingStockLst_Vendor = .F.
			
			ThisFormSet.RefreshStockLst_Vendor()
			
		ENDIF
	ENDPROC

	PROCEDURE frmVendorStock.cmdEdit.Click
		IF THIS.Caption = "Edit"
			This.Parent.cmdNew.Enabled = .F.
			This.Parent.cmdDelete.Caption = "Abort"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Save"
			ThisFormSet.IsEditingStockLst_Vendor = .T.
			
			*ThisForm.txtRemoveDate.Value = TTOD(DATETIME()+60)
			WAIT WINDOW "Ready to Edit" NOWAIT
		ELSE
			*Save
			
			PRIVATE nID, cAlloy, cForm, cCC, nPc, nDim1, nDim2, nDim3
			PRIVATE nMWeight, cSpecs, cHeat, cCond, cDescript
			PRIVATE cBrandName, cVendor, cMill, cMelt, dRemoveDate
			*,Size,CCSortValue,FormSort
			nID		= PrepareSQLnum(ThisForm.StockLst_ID.Value,'ID',-3)
			cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12,.F.,.T.)
			cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
			nPc		= PrepareSQLnum(ThisForm.Pieces1.Value,'Pc',8,1)
			nDim1	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
			nDim2	= PrepareSQLnum(ThisForm.SZ21.Value,'Sz2',9,3)
			nDim3	= PrepareSQLnum(ThisForm.SZ31.Value,'Sz3',9,3)
			nMWeight = PrepareSQLnum(ThisForm.Weight1.Value,'Weight',9,1)
			cSpecs	= PrepareSQLtxt(ThisForm.txtSpecs.Value,'Specs',160)
			cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
			cCond	= PrepareSQLtxt(ThisForm.txtCond.Value,'Cond',50)
			cDescript = PrepareSQLtxt(ThisForm.txtDescript.Value,'Descript',20,.F.,.T.)
			cBrandName = PrepareSQLtxt(ThisForm.txtBrandName.Value,'BrandName',20,.F.,.T.)
			cVendor = PrepareSQLtxt(ThisForm.txtVendor.Value,'Vendor',30)
			cMill 	= PrepareSQLtxt(ThisForm.txtMill.Value,'Mill',10)
			cMelt 	= PrepareSQLtxt(ThisForm.txtMelt.Value,'Melt',7)
			dRemoveDate = PrepareSQLdate(ThisForm.txtRemoveDate.Value,'RemoveDate')
			*ThisForm.txtAddDate.Value
			
			IF EMPTY(cForm)
				ThisForm.cmbForm.Value = '10'
				MESSAGEBOX("Please choose the form!",0+48,"Could not save!")
				RETURN .F.
			ENDIF
			
			IF EMPTY(cCC)
				cCC = '1'
			ENDIF
			IF nPc = 0
				nPc = 1
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC
			IF nID = 0
				*INSERT
				cSQL = "INSERT INTO dbo.StockLst_Vendor "
				cSQL = cSQL+"( Alloy,Form,CC,Pc,Dim1,Dim2,Dim3"
				cSQL = cSQL+",MWeight,mS_QTY,Specs,Heat,Cond,Descript"
				cSQL = cSQL+",Size,BrandName,CCSortValue,FormSort,Vendor,Mill,Melt )"
				cSQL = cSQL+" VALUES ("
				cSQL = cSQL+"'"+cAlloy+"'"
				cSQL = cSQL+",'"+cForm+"'"
				cSQL = cSQL+",'"+cCC+"'"
				cSQL = cSQL+","+STR(nPc)+""
				cSQL = cSQL+","+STR(nDim1,10,4)+""
				cSQL = cSQL+","+STR(nDim2,9,3)+""
				cSQL = cSQL+","+STR(nDim3,9,3)+""
				cSQL = cSQL+","+STR(nMWeight,9,1)+""
				cSQL = cSQL+","+STR(nMWeight,9,1)+"" &&nS_QTY
				cSQL = cSQL+",'"+cSpecs+"'"
				cSQL = cSQL+",'"+cHeat+"'"
				cSQL = cSQL+",'"+cCond+"'"
				cSQL = cSQL+",'"+cDescript+"'"
				cSQL = cSQL+","+STR(nDim1,10,4)+""
				cSQL = cSQL+",'"+cBrandName+"'"
				cSQL = cSQL+",dbo.f_GetCCSortValue("+cCC+")"
				cSQL = cSQL+",dbo.f_FormSort("+cForm+")"
				cSQL = cSQL+",'"+cVendor+"'"
				cSQL = cSQL+",'"+cMill+"'"
				cSQL = cSQL+",'"+cMelt+"'"
				cSQL = cSQL+")"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Vendor()
					GO BOTTOM IN 'StockLst_Vendor'
					ThisFormSet.RefreshStockLst_Vendor()
					WAIT WINDOW "Saved." NOWAIT
				ENDIF
		
			ELSE
				*UPDATE
				cSQL = "UPDATE dbo.StockLst_Vendor "
				cSQL = cSQL+" SET "
				cSQL = cSQL+" Alloy='"+cAlloy+"'"
				cSQL = cSQL+",Form='"+cForm+"'"
				cSQL = cSQL+",CC='"+cCC+"'"
				cSQL = cSQL+",Pc="+STR(nPc)+""
				cSQL = cSQL+",Dim1="+STR(nDim1,10,4)+""
				cSQL = cSQL+",Dim2="+STR(nDim2,9,3)+""
				cSQL = cSQL+",Dim3="+STR(nDim3,9,3)+""
				cSQL = cSQL+",MWeight="+STR(nMWeight,9,1)+""
				cSQL = cSQL+",mS_QTY="+STR(nMWeight,9,1)+"" &&mS_QTY
				cSQL = cSQL+",Specs='"+cSpecs+"'"
				cSQL = cSQL+",Heat='"+cHeat+"'"
				cSQL = cSQL+",Cond='"+cCond+"'"
				cSQL = cSQL+",Descript='"+cDescript+"'"
				cSQL = cSQL+",Size="+STR(nDim1,10,4)+""
				cSQL = cSQL+",BrandName='"+cBrandName+"'"
				cSQL = cSQL+",CCSortValue=dbo.f_GetCCSortValue("+cCC+")"
				cSQL = cSQL+",FormSort=dbo.f_FormSort("+cForm+")"
				cSQL = cSQL+",Vendor='"+cVendor+"'"
				cSQL = cSQL+",Mill='"+cMill+"'"
				cSQL = cSQL+",Melt='"+cMelt+"'"
				cSQL = cSQL+",RemoveDate='"+DTOC(dRemoveDate)+"'"
				cSQL = cSQL+" WHERE ID = "+STR(nID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Vendor()
					SELECT 'StockLst_Vendor'
					INDEX ON ID TAG ID
					LOCATE FOR ID = nID
					ThisForm.grdStockLst.SetFocus()
					ThisFormSet.RefreshStockLst_Vendor()
					WAIT WINDOW "Saved." NOWAIT
				ENDIF
				
			ENDIF
			
			
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdDelete.Caption = "Delete"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Edit"
			ThisFormSet.IsEditingStockLst_Vendor = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmVendorStock.cmdHide.Click
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE frmVendorStock.cmdNew.Click
		ThisFormSet.IsEditingStockLst_Vendor = .T.
		
		ThisForm.txtAddDate.Value = TTOD(DATETIME())
		ThisForm.txtRemoveDate.Value = TTOD(DATETIME()+60)
		
		ThisForm.StockLst_ID.Value = 0
		
		This.Enabled = .F.
		
		This.Parent.cmdEdit.Caption = "Save"
		This.parent.cmdEdit.Enabled = .T.
		This.Parent.cmdDelete.Caption = "Abort"
		This.parent.cmdDelete.Enabled = .T.
		
		WAIT WINDOW "Ready to Edit" NOWAIT
	ENDPROC

	PROCEDURE frmVendorStock.grdStockLst.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.RefreshStockLst_Vendor()
	ENDPROC

	PROCEDURE frmVendorStock.lblRemoveDate.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = This.Parent.txtRemoveDate.Value
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		This.Parent.txtRemoveDate.Value = dDate2
		This.Parent.txtRemoveDate.Refresh
		This.Parent.txtRemoveDate.SetFocus
	ENDPROC

	PROCEDURE frmVendorStock.LBLTHCK1.DblClick
		
		PRIVATE cAlloy,cForm,cCC,cCL,nPieces,nThck,nSz2,nSz3,nForceBracket
		cAlloy = PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12,.F.,.T.)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		nPieces	= PrepareSQLnum(ThisForm.Pieces1.Value,'Pieces',-3)
		nThck	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(ThisForm.Sz21.Value,'sz2',9,3)
		nSz3	= PrepareSQLnum(ThisForm.Sz31.Value,'Sz3',9,3)
		nForceBracket = .F.
		
		IF nPieces = 0
			nPieces = 1
		ENDIF
		IF EMPTY(cForm)
			MESSAGEBOX("Please check the form."+CHR(13)+"Defaulted form to '10'.",0,"No form")
			cForm = '10'
			ThisForm.cmbForm.Value = '10'
		ENDIF
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		cSQL = cSQL + ",''" &&CustID
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			
			PRIVATE cMess
			cMess = "Could not get the Price!"+CHR(13)
			IF nPieces > 10000
				cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
			ENDIF
			IF nThck > 16
				cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
			ENDIF
			IF nSz2	> 120
				cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
			ENDIF
			IF nSz3	 > 300
				cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
			ENDIF
			MESSAGEBOX(cMess,16,"Edit your input numbers")
			
		ENDIF
		
		IF USED('tmpPriceTbl')
			IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
				IF tmpPriceTbl.Pounds > 0
					ThisForm.WEIGHT1.Value = tmpPriceTbl.Pounds
					ThisForm.WEIGHT1.Refresh
				ENDIF
			ENDIF
			USE IN tmpPriceTbl
		ENDIF
	ENDPROC

	PROCEDURE frmVendorStock.LBLWEIGHT1.Click
		
		PRIVATE cAlloy,cForm,cCC,cCL,nPieces,nThck,nSz2,nSz3,nForceBracket
		cAlloy = PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12,.F.,.T.)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CL',1)
		nPieces	= PrepareSQLnum(ThisForm.Pieces1.Value,'Pieces',-3)
		nThck	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(ThisForm.Sz21.Value,'sz2',9,3)
		nSz3	= PrepareSQLnum(ThisForm.Sz31.Value,'Sz3',9,3)
		nForceBracket = .F.
		
		IF nPieces = 0
			nPieces = 1
		ENDIF
		IF EMPTY(cForm)
			MESSAGEBOX("Please check the form."+CHR(13)+"Defaulted form to '10'.",0,"No form")
			cForm = '10'
			ThisForm.cmbForm.Value = '10'
		ENDIF
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		cSQL = cSQL + ",''" &&CustID
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			
			PRIVATE cMess
			cMess = "Could not get the Price!"+CHR(13)
			IF nPieces > 10000
				cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
			ENDIF
			IF nThck > 16
				cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
			ENDIF
			IF nSz2	> 120
				cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
			ENDIF
			IF nSz3	 > 300
				cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
			ENDIF
			MESSAGEBOX(cMess,16,"Edit your input numbers")
			
		ENDIF
		
		IF USED('tmpPriceTbl')
			IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
				IF tmpPriceTbl.Pounds > 0
					ThisForm.WEIGHT1.Value = tmpPriceTbl.Pounds
					ThisForm.WEIGHT1.Refresh
				ENDIF
			ENDIF
			USE IN tmpPriceTbl
		ENDIF
	ENDPROC

