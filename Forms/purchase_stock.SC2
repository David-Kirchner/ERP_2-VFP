	PROCEDURE frmMenu.chkVendorImport.Click
		*Import Vendor data
		
		PRIVATE cFile
		cFile = GETFILE('CSV,TXT', 'Browse for File:', 'Open', 1, 'File' )
		
		IF VARTYPE(cFile)!="C"
			IF MESSAGEBOX("Do you want to look for a TXT file?",4+32,"Find TXT?") = 6
			
				cFile=GETFILE('TXT', 'Browse for TXT:', 'Open', 1, 'File' )
				IF VARTYPE(cFile)!="C"
					RETURN .F.
				ENDIF
				
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
		*!*	IF NOT FILE(cFile)
		*!*		IF MESSAGEBOX("Do you want to look for a TXT file?",4+32,"Find TXT?") = 6
		*!*		
		*!*			cFile=GETFILE('TXT', 'Browse for TXT:', 'Open', 1, 'File' )
		*!*			IF VARTYPE(cFile)!="C"
		*!*				RETURN .F.
		*!*			ENDIF
		*!*			IF NOT FILE(cFile)
		*!*				RETURN .F.
		*!*			ENDIF
		*!*		ELSE
		
		*!*			MESSAGEBOX("File:"+ALLTRIM(cFile)+" not Found!",64,"Error")
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
		
		***************************
		* Create the holding table
		***************************
		IF USED('tmpVendorStock')
			USE IN tmpVendorStock
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\tmpVendorStock.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\tmpVendorStock.dbf")
		ENDIF
		
		*!*	IF FILE(SYS(5)+SYS(2003)+"\tmpVendorStock.DBF") &&Clean the file
		*!*		SELECT 0
		*!*		USE (SYS(5)+SYS(2003)+"\tmpVendorStock.DBF") EXCL 
		*!*		IF USED('tmpVendorStock')
		*!*			ZAP
		*!*		ENDIF
		*!*	ELSE &&Create file
			SELECT 0
			CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock" FREE ( Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Melt C(7), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
			USE (SYS(5)+SYS(2003)+"\tmpVendorStock.DBF") EXCL 
		*!*	ENDIF
		
		IF USED('tmpVendorStock')
			SELECT tmpVendorStock
		ENDIF
		*******
		IF NOT USED('tmpVendorStock')
			RETURN .F.
		ENDIF
		***************************	
		
		***************************
		* look at file name to see what function to run
		***************************
		DO CASE
		CASE RIGHT(cFile,3) = "CSV"
			DO CASE 
			CASE "DSS " $ UPPER(cFile)
				ThisFormSet.DunkirkSSCSVimport(cFile)
			CASE "RSI - BILLET" $ UPPER(cFile)
				ThisFormSet.RemeltResourceCSVimport(cFile)
			CASE UPPER("Special Metals") $ cFile 
				ThisFormSet.ImportSpecialMetals(cFile)
			CASE "ZAPP" $ UPPER(cFile)
				ThisFormSet.ZappCSVimport(cFile)
				
			CASE UPPER("ELECTRALLOY STAINLESS") $ UPPER(cFile)
				ThisFormSet.ElectralloyCSVimport(cFile)
			CASE UPPER("ELECTRALLOY NICKEL") $ UPPER(cFile)
				ThisFormSet.ElectralloyCSVimport(cFile)
			CASE "ELECTRALLOY " $ UPPER(cFile)
				ThisFormSet.ElectralloyCSVimport(cFile)
				
			CASE UPPER("LATROBE") $ UPPER(cFile)
				ThisFormSet.LatrobeCSVimport(cFile)
				
			CASE UPPER("DNA") $ UPPER(cFile)
				ThisFormSet.DNACSVimport(cFile)
		
			OTHERWISE
				SELECT tmpVendorStock
				APPEND FROM (cFile) TYPE CSV
				**"GenericVendor"
			ENDCASE
		CASE RIGHT(cFile,3) = "TXT"
			DO CASE 
			*Cannot parse the Electralloy Size and Weight.
			*CASE "ELECTRALLOY" $ UPPER(cFile)
			*	ThisFormSet.ElectralloyTXTimport(cFile)
			
			*CASE "RSI - BILLET STOCK LIST" $ UPPER(cFile)
			*	ThisFormSet.RemeltResourceTXTimport(cFile)
			
			CASE "CRUCIBLE " $ UPPER(cFile)
				ThisFormSet.CrucibleTXTimport2015(cFile)
				*ThisFormSet.CrucibleTXTimport(cFile)
			CASE "RSI - BILLET" $ UPPER(cFile)
		*		ThisFormSet.RemeltResourceCSVimport(cFile)	
				ThisformSet.Remeltresourcetxtimport(cFile)
			ENDCASE
		ENDCASE
		
		***************************
		PRIVATE cSQL, nSQLEXEC
		SELECT tmpVendorStock
		
		nRecCount = RECCOUNT('tmpVendorStock')
		IF nRecCount > 0
			
			SELECT tmpVendorStock
			GO TOP 
			
			ThisFormSet.VendorImportTable = "GenericVendor"
			
			PRIVATE dDate1,dDate2
			dDate1 = DATE()+120
			DO FORM "forms\OleCalendar.scx" WITH dDate1,"Set Remove Date. Default +180" TO dDate2
			IF VARTYPE(dDate2) = "T"
				dDate2 = TTOD(dDate2)
			ENDIF
			IF VARTYPE(dDate2) != "D"
				dDate2 = CTOD('')
			ENDIF
			
			ThisFormSet.frmVendorImport.txtRemoveDate.Value = dDate2 
			
		*	IF MESSAGEBOX("Is this good Vendor Stock ?"+CHR(13)+"Answer YES to list as 'Vendor Stock'"+CHR(13)+"Answer No to list as 'Excess Stock'.",4+32,"Stock Condition") = 6
				ThisFormSet.ExcessStock = .F.
		*	ELSE
		*		ThisFormSet.ExcessStock = .T.
		*	ENDIF
			
			ThisFormSet.GetGenerickVendorImport()
			
			PRIVATE cVendor, cMill, cMess
		
			*Delete Old listings
			SELECT tmpVendorStock
		
			IF RECCOUNT('tmpVendorStock') > 0
				IF NOT EMPTY(tmpVendorStock.Vendor)
					cVendor = ALLTRIM(tmpVendorStock.Vendor)
					cMill = ALLTRIM(tmpVendorStock.Mill)
					
					ThisFormSet.Stocklst_vendor = tmpVendorStock.Vendor
					IF cVendor = ThisFormSet.cVendor
						**Already been asked.
					ELSE
						IF UPPER(cMill) = "LATROBE"
							cMess = "Do you want ro remove previous entries for '"+cVendor+"' and Mill is 'Latrobe'"
						ELSE
							cMess = "Do you want ro remove previous entries for '"+cVendor+"'"
						ENDIF
									
						IF MESSAGEBOX(cMess ,4+32,"Remove old Vendor records?") = 6
							
							IF UPPER(cMill) = "LATROBE"
								cSQL = "DELETE FROM dbo.StockLst_Vendor WHERE Vendor='"+cVendor+"' AND [Mill]='LATROBE'"
							ELSE
								cSQL = "DELETE FROM dbo.StockLst_Vendor WHERE Vendor='"+cVendor+"'"
							ENDIF
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormsET.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormsET.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ELSE
								ThisFormSet.cVendor = cVendor
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

