			DELETE FILE(SYS(5)+SYS(2003)+"\tmpSMCstock.dbf")
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\MEM\tmpSMCstock.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\MEM\tmpSMCstock.dbf")
		ENDIF
		
		SELECT 0
		IF "\MEM" $ SYS(2003)
			CREATE TABLE SYS(5)+SYS(2003)+"\tmpSMCstock" FREE ( Alloy C(20), [Dia] C(10),  LOT C(30), [REFORGE] C(10), SPEC C(40),lengthIn C(10), LengthFt C(10), Weight C(10))
			USE (SYS(5)+SYS(2003)+"\tmpSMCstock.DBF") EXCL 
		ELSE
			CREATE TABLE SYS(5)+SYS(2003)+"\MEM\tmpSMCstock" FREE ( Alloy C(20), [Dia] C(10),  LOT C(30), [REFORGE] C(10), SPEC C(40),lengthIn C(10), LengthFt C(10), Weight C(10))
			USE (SYS(5)+SYS(2003)+"\MEM\tmpSMCstock.DBF") EXCL 
		ENDIF
		
		IF USED('tmpSMCstock')
			SELECT tmpSMCstock
		ENDIF
		
		*******
		IF NOT USED('tmpSMCstock')
			RETURN .F.
		ENDIF
		
		SELECT tmpSMCstock
		APPEND FROM (cFile) TYPE CSV
		PRIVATE cPrevDia, cPrevAlloy 
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill
		cPrevAlloy = ''
		cPrevDia = ''
		SELECT tmpSMCstock
		SCAN
			*Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Melt C(7), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
			*Alloy C(20), [Dia] C(10), [TOL] C(20), LOT C(30), [REFORGE] C(10), SPEC C(40),lengthIn C(10), LengthFt C(10), Weight C(10)	
			
			IF EMPTY(tmpSMCstock.Alloy)
				cAlloy = cPrevAlloy
			ELSE
				cAlloy	= tmpSMCstock.Alloy
			ENDIF
			cForm		= '10'
			cCC			= '1'
			cThickness	= tmpSMCstock.Dia
			cWidth		= ''
			cLength		= tmpSMCstock.lengthIn 
			cPCS		= ''
			cWeight		= STRTRAN(tmpSMCstock.Weight,[,],"")
			cCondition	= tmpSMCstock.ReForge
			cSpecs		= tmpSMCstock.Spec
			cMelt		= ''
			cHeat		= tmpSMCstock.Lot
			cBrandName	= tmpSMCstock.Alloy
			cVendor		= "SMC"
			cMill 		= "Special Metals"
			
			IF EMPTY(cHeat)
				SELECT tmpSMCstock
				LOOP
			ENDIF
			IF cHeat = "Lot Number"
				SELECT tmpSMCstock
				LOOP
			ENDIF
			
			IF EMPTY( cBrandName )
				cBrandName = cPrevAlloy 
			ENDIF
			IF EMPTY( cThickness )
				cThickness = cPrevDia
			ENDIF
			
			INSERT INTO tmpVendorStock ;
			(Alloy,Form,CC,Thickness,Width,Length,PCS,Weight,Condition,Specs,Melt,Heat,BrandName,Vendor,Mill);
			 VALUES ;
			(cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill)
			
			cPrevAlloy	= cAlloy
			cPrevDia	= cThickness
			
			SELECT tmpSMCstock
		ENDSCAN
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE Init
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "DELETE FROM dbo.Stocklst_Vendor WHERE RemoveDate <= GetDate()"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		ENDIF
		
		ThisFormSet.GetStockLst_Wants()
		
		ThisFormSet.frmMenu.AlwaysOnTop = .T.
		
		= FCLOSE( ThisFormSet.nConnHandle )
	ENDPROC

	PROCEDURE latrobecsvimport		&& Carpenter\ Latrobe MP35N
		PARAMETER cFile
		*ThisFormSet.LatrobeCVSImport( cFile )
		*Append FROM CSV
		
		
		IF USED('tmpLatrobe')
			USE IN tmpLatrobe
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\tmpLatrobe.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\tmpLatrobe.dbf")
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\MEM\tmpLatrobe.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\MEM\tmpLatrobe.dbf")
		ENDIF
		
		*LOT C(30), [REFORGE] C(10), LengthFt C(10)
		
		SELECT 0
		IF "\MEM" $ SYS(2003)
			CREATE TABLE SYS(5)+SYS(2003)+"\tmpLatrobe" FREE ( Mat C(40), Descr C(100), Weight C(20) )
			USE (SYS(5)+SYS(2003)+"\tmpLatrobe.DBF") EXCL 
		ELSE
			CREATE TABLE SYS(5)+SYS(2003)+"\MEM\tmpLatrobe" FREE (  Mat C(40), Descr C(100), Weight C(20) )
			USE (SYS(5)+SYS(2003)+"\MEM\tmpLatrobe.DBF") EXCL 
		ENDIF
		
		IF USED('tmpLatrobe')
			SELECT tmpLatrobe
		ENDIF
		
		*******
		IF NOT USED('tmpLatrobe')
			RETURN .F.
		ENDIF
		
		SELECT tmpLatrobe
		APPEND FROM (cFile) TYPE CSV
		
		
		PRIVATE cPrevDia, cPrevAlloy 
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cSpecsA,cMelt,cHeat,cBrandName,cVendor,cMill
		cPrevAlloy = 'MP35N'
		cPrevDia = ''
		SELECT tmpLatrobe
		SCAN
			*Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Melt C(7), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
			*Alloy C(20), [Dia] C(10), [TOL] C(20), LOT C(30), [REFORGE] C(10), SPEC C(40),lengthIn C(10), LengthFt C(10), Weight C(10)	
			
			IF UPPER(tmpLatrobe.Mat) = "MATERIAL"
				*Header row
				SELECT tmpLatrobe
				LOOP
			ENDIF
			
		*!*		IF EMPTY(tmpLatrobe.Alloy)
		*!*			cAlloy = cPrevAlloy
		*!*		ELSE
		*!*			cAlloy	= tmpLatrobe.Alloy
		*!*		ENDIF
			
			cAlloy		= 'MP35N'
			cForm		= '10'
			cCC			= '1'
			cThickness	= LEFT( tmpLatrobe.Descr,AT('RND',tmpLatrobe.Descr)-1 )
			cWidth		= ''
			cLength		= ''
			cPCS		= ''
			cWeight		= tmpLatrobe.Weight
			cCondition	= ''
			cSpecsA		= SUBSTR( tmpLatrobe.Descr,AT('-VV',tmpLatrobe.Descr)+4 )
			cSpecs		= LEFT( cSpecsA,AT('BAR',cSpecsA)-1 )
		
			cMelt		= ''
			cHeat		= ''
			cBrandName	= 'MP35N'
			cVendor		= "Carpenter"
			cMill 		= "Latrobe"
			
			*IF EMPTY( cBrandName )
			*	cBrandName = cPrevAlloy 
			*ENDIF
			*IF EMPTY( cThickness )
			*	cThickness = cPrevDia
			*ENDIF
			
			INSERT INTO tmpVendorStock ;
			(Alloy,Form,CC,Thickness,Width,Length,PCS,Weight,Condition,Specs,Melt,Heat,BrandName,Vendor,Mill);
			 VALUES ;
			(cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill)
			
			cPrevAlloy	= cAlloy
			cPrevDia	= cThickness
			
			SELECT tmpLatrobe
		ENDSCAN
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE Load
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_rtr ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		SET SAFETY OFF
		
	ENDPROC

	PROCEDURE refreshstocklst_mins
		*ThisFormSet.RefreshStockLst_Mins()
		*RefreshStockLst_Review
		IF USED('StockLst_Mins')
			ThisFormSet.frmStockListMins.StockLst_ID.Value	= StockLst_Mins.ID
			ThisFormSet.frmStockListMins.ALLOY1.Value		= StockLst_Mins.Alloy
			ThisFormSet.frmStockListMins.cmbForm.Value		= StockLst_Mins.Form
			ThisFormSet.frmStockListMins.cmbCC.Value		= StockLst_Mins.CC
		
			ThisFormSet.frmStockListMins.Thck1.Value		= StockLst_Mins.thck
			ThisFormSet.frmStockListMins.Sz21.Value			= StockLst_Mins.Sz2
			
			ThisFormSet.frmStockListMins.txtSafeLevel.Value		= StockLst_Mins.SafeLevel
			ThisFormSet.frmStockListMins.txtMillWeeks.Value		= StockLst_Mins.MillWeeks
			ThisFormSet.frmStockListMins.chkActive.Value		= StockLst_Mins.Active
			ThisFormSet.frmStockListMins.chkCrutial.Value		= StockLst_Mins.Crutial
			ThisFormSet.frmStockListMins.txtQUsage.Value		= StockLst_Mins.QUsage
			ThisFormSet.frmStockListMins.txtPrevQUsage.Value	= StockLst_Mins.PrevQUsage
			ThisFormSet.frmStockListMins.txtYUsage.Value		= StockLst_Mins.YUsage
			ThisFormSet.frmStockListMins.txtPrevYUsage.Value	= StockLst_Mins.PrevYUsage
			ThisFormSet.frmStockListMins.txtAddDate.Value		= StockLst_Mins.LastEdit
			
			*****************************************
			ThisFormSet.frmStockListMins.txtBroker.Value		= 0
			ThisFormSet.frmStockListMins.txt3yrSales.Value		= 0
			ThisFormSet.frmStockListMins.txt1Yrsales.Value		= 0
			ThisFormSet.frmStockListMins.txtAvgStock.Value		= 0
			ThisFormSet.frmStockListMins.txtCurrStock.Value		= 0
			ThisFormSet.frmStockListMins.txtStockDue.Value		= 0
			
			IF USED("tmpHistory")
				SELECT tmpHistory
			ELSE
				SELECT 0
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT ID"
			cSQL = cSQL + ",dbo.f_Report_1yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr1Sales]"
			cSQL = cSQL + ",dbo.f_Report_3yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr3Sales]"
			cSQL = cSQL + ",dbo.f_Report_CurrStock(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [CurrStock]"
			cSQL = cSQL + ",dbo.f_Report_1YrStock (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [AvgStock]"
			cSQL = cSQL + ",dbo.f_Report_1YrBroker(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [Broker]"
			cSQL = cSQL + ",dbo.f_Report_StockDue (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [StockDue]"
			cSQL = cSQL + " FROM dbo.StockLst_Mins "
			cSQL = cSQL + " WHERE Alloy='"+StockLst_Mins.Alloy+"'"
			cSQL = cSQL + " AND Form ='"+StockLst_Mins.Form+"'"
			cSQL = cSQL + " AND CC ='"+StockLst_Mins.CC+"'"
			cSQL = cSQL + " AND Thck="+STR(StockLst_Mins.thck,11,4)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpHistory')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpHistory')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHistory")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHistory")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpHistory')
			ELSE
				SELECT tmpHistory
				IF RECCOUNT('tmpHistory') > 0	
					ThisFormSet.frmStockListMins.txtBroker.Value		= PrepareSQLnum(tmpHistory.Broker,'Broker',-3)
					ThisFormSet.frmStockListMins.txt3yrSales.Value		= PrepareSQLnum(tmpHistory.Yr3Sales,'Yr3Sales',-3)
					ThisFormSet.frmStockListMins.txt1Yrsales.Value		= PrepareSQLnum(tmpHistory.Yr1Sales,'Yr1Sales',-3)
					ThisFormSet.frmStockListMins.txtAvgStock.Value		= PrepareSQLnum(tmpHistory.AvgStock,'AvgStock',-3)
					ThisFormSet.frmStockListMins.txtCurrStock.Value		= PrepareSQLnum(tmpHistory.CurrStock,'CurrStock',-3)
					ThisFormSet.frmStockListMins.txtStockDue.Value		= PrepareSQLnum(tmpHistory.StockDue,'StockDue',-3)
				ENDIF
			ENDIF
			*****************************************	
		
		ENDIF
		
		IF GetFormCaptions(StockLst_Mins.Form, ThisFormSet.nConnHandle)
			IF USED('tmpFormCaptions')
				*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
				ThisFormSet.frmStockListMins.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
				ThisFormSet.frmStockListMins.LBLSZ21.Caption = RTRIM(tmpFormCaptions.txt2)
				ThisFormSet.frmStockListMins.LBLSZ31.Caption = RTRIM(tmpFormCaptions.txt3)
				ThisFormSet.frmStockListMins.lblSZ31.Visible = tmpFormCaptions.lblSz3Vis
				ThisFormSet.frmStockListMins.LBLSZ41.Visible = tmpFormCaptions.use3rdDim
				ThisFormSet.frmStockListMins.LBLSZ41.Caption = RTRIM(tmpFormCaptions.txt4)
				USE IN tmpFormCaptions
			ENDIF
		ENDIF
			
		SELECT StockLst_Mins
	ENDPROC

