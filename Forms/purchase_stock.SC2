	PROCEDURE crucibletxtimport		&& CrucibleTXTimport
		PARAMETERS cFileName
		*ThisFormSet.CrucibleTXTimport()
		
		IF VARTYPE(cFileName) != "C"
			RETURN .F.
		ENDIF
		PRIVATE lReturn
		lReturn = .T.
		
		
		
		SELECT tmpVendorStock
		
		LOCAL lnFileHandle && numeric file handle
		
		lnFileHandle = FOPEN(cFileName)
		
		IF lnFileHandle = -1
		
		   && error, could not open the file
		
		   && do something to handle the error
		
		   RETURN .F.
		
		ENDIF
		
		LOCAL lcLine && define a variable to hold each line
		
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cHeat,cBrandName,cVendor,cMill
		cVendor	= "Crucible"
		cMill	= "CRUCIBLE"
		
		PRIVATE cLineNow,nAT
		PRIVATE cSQL, nSQLEXEC
		
		DO WHILE NOT FEOF( lnFileHandle) && loop through the file
		
			lcLine = FGETS( lnFileHandle) && store each line in lcLine
			lcLine = ALLTRIM(UPPER(lcLine))
			 
			IF EMPTY(lcLine)
				LOOP
			ENDIF
			IF AT("----- Page 1-----",lcLine) > 0 
				LOOP
			ENDIF
			IF AT("1650 MINERAL",UPPER(lcLine)) > 0 
				*Must be for Remelt Sources
		
				lReturn = .F.
				EXIT
			ENDIF
			 
			 
			IF AT("NAME ",UPPER(lcLine)) > 0
				*Firest line, loop over
				LOOP
			ENDIF
			
			*Remove Begining ["}
			IF LEFT(lcLine,1) = ["]
				lcLine = RIGHT(lcLine,LEN(lcLine)-1)
			ENDIF
			*Remove Ending ["}
			IF RIGHT(lcLine,1) = ["]
				lcLine = LEFT(lcLine,LEN(lcLine)-1)
			ENDIF
			cLineNow = lcLine
				
			*Parse
			***********************************************************
			*Look for Form
			nAT = 0
			DO CASE
			CASE AT(" FLAT ",lcLine) > 0
				nAT = AT(" FLAT ",lcLine)
				IF nAT > 0
					cAlloy = LEFT(lcLine,nAT)
					cBrandName = cAlloy
					cForm = '11'
					cLineNow = RIGHT(lcLine,LEN(lcLine)-nAT-4)
				ENDIF
			CASE AT(" RD ",lcLine) > 0
				nAT = AT(" RD ",lcLine)
				IF nAT > 0
					cAlloy = LEFT(lcLine,nAT)
					cBrandName = cAlloy
					cForm = '10'
					cLineNow = RIGHT(lcLine,LEN(lcLine)-nAT-2)
				ENDIF
			CASE AT(" SQ ",lcLine) > 0
				nAT = AT(" SQ ",lcLine)
				IF nAT > 0
					cAlloy = LEFT(lcLine,nAT)
					cBrandName = cAlloy
					cForm = '13'
					cLineNow = RIGHT(lcLine,LEN(lcLine)-nAT-2)
				ENDIF
			OTHERWISE
				IF MESSAGEBOX("Did not match a form!"+CHR(13)+lcLine+CHR(13)+cLineNow,4+32,"Do you want to continue?") = 6
					LOOP
				ENDIF
				cAlloy = ''
				cForm = ''		
				cBrandName = cAlloy
			ENDCASE
			***********************************************************
			*cLineNow = "~" + cLineNow 
			*Look for Condition
			nAT = 0
			DO CASE
			CASE AT(" ANN ",cLineNow) > 0
				nAT = AT(" ANN ",cLineNow)
				IF nAT > 0
					cCondition = LEFT(cLineNow,nAT)
					cCC = '1'
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-8)
				ENDIF
			CASE AT(" H1150 ",cLineNow) > 0
				nAT = AT(" H1150 ",cLineNow)
				IF nAT > 0
					cCondition = LEFT(cLineNow,nAT)
					cCC = '3'
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-9)
				ENDIF
			CASE AT(" HH-1150 ",cLineNow) > 0
				nAT = AT(" HH-1150 ",cLineNow)
				IF nAT > 0
					cCondition = LEFT(cLineNow,nAT)
					cCC = '3'
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-11)
				ENDIF
			CASE AT(" H1025 ",cLineNow) > 0
				nAT = AT(" H1025 ",cLineNow)
				IF nAT > 0
					cCondition = LEFT(cLineNow,nAT)
					cCC = '3'
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-9)
				ENDIF
			CASE AT(" HIGH STRENGTH ",cLineNow) > 0
				nAT = AT(" HIGH STRENGTH ",cLineNow)
				IF nAT > 0
					cCondition = LEFT(cLineNow,nAT)
					cCC = '2'
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-18)
				ENDIF
			OTHERWISE
				IF MESSAGEBOX("Did not match a Condition!"+CHR(13)+lcLine+CHR(13)+cLineNow,4+32,"Do you want to continue?") = 6
					LOOP
				ELSE
					FCLOSE( lnFileHandle)
					RETURN .F.
				ENDIF
				cCondition = ''
				cCC = '1'
			ENDCASE
			
			***********************************************************
		 *  	cLineNow = "~" + cLineNow 
		   	*Add a Space behind cCondition before adding Finish
		   	IF !EMPTY(cCondition)
		   		cCondition = cCondition + " "
		   	ENDIF
		   	
			*Look for Finish
			nAT = 0
			DO CASE
			CASE AT(" HRAP ",cLineNow) > 0
				nAT = AT(" HRAP ",cLineNow)
				IF nAT > 0
					cCondition = cCondition + LEFT(cLineNow,nAT)
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-8)
				ENDIF
			CASE AT(" CG ",cLineNow) > 0
				nAT = AT(" CG ",cLineNow)
				IF nAT > 0
					cCondition = cCondition + LEFT(cLineNow,nAT)
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-6)
				ENDIF
			CASE AT(" RGH TU ",cLineNow) > 0
				nAT = AT(" RGH TU ",cLineNow)
				IF nAT > 0
					cCondition = cCondition + LEFT(cLineNow,nAT)
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-10)
				ENDIF
			CASE AT(" MACH ",cLineNow) > 0
				nAT = AT(" MACH ",cLineNow)
				IF nAT > 0
					cCondition = cCondition + LEFT(cLineNow,nAT)
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-8)
				ENDIF
			CASE AT(" RT ",cLineNow) > 0
				nAT = AT(" RT ",cLineNow)
				IF nAT > 0
					cCondition = cCondition + LEFT(cLineNow,nAT)
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-6)
				ENDIF
			CASE AT(" HR ",cLineNow) > 0
				nAT = AT(" HR ",cLineNow)
				IF nAT > 0
					cCondition = cCondition + LEFT(cLineNow,nAT)
					cLineNow = RIGHT(cLineNow,LEN(cLineNow)-nAT-6)
				ENDIF
		
			OTHERWISE
				IF MESSAGEBOX("Did not match a Finish!"+CHR(13)+lcLine+CHR(13)+cLineNow,4+32,"Do you want to continue?") = 6
					LOOP
				ELSE
					FCLOSE( lnFileHandle)
					RETURN .F.
				ENDIF
			ENDCASE
			***********************************************************
		   	
			*Look for Thickness
			nAT = 0
					
			IF LEFT(cLineNow,1) = " "
				*remove first space
				cLineNow = RIGHT(cLineNow, LEN(cLineNow)- 1)
			ENDIF
			nAT = AT(" ",cLineNow)
			IF nAT > 0
				cThickness = LEFT(cLineNow,nAT)
				cLineNow = RIGHT(cLineNow,LEN(cLineNow) -nAT -1)
			ELSE
				cThickness = ''
			ENDIF
			
			***********************************************************
		   	
			*Look for cWidth
			nAT = 0
					
			IF LEFT(cLineNow,1) = " "
				*remove first space
				cLineNow = RIGHT(cLineNow, LEN(cLineNow)- 1)
			ENDIF
			nAT = AT(" ",cLineNow)
			IF nAT > 0
				cWidth = LEFT(cLineNow,nAT)
				cLineNow = RIGHT(cLineNow,LEN(cLineNow) -nAT -1)
			ELSE
				cWidth = ''
			ENDIF
			
			***********************************************************
		   	
		   	 
			*Look for cWeight cLength
			nAT = 0
					
			IF LEFT(cLineNow,1) = " "
				*remove first space
				cLineNow = RIGHT(cLineNow, LEN(cLineNow)- 1)
			ENDIF
			nAT = AT(" ",cLineNow)
			IF nAT > 0
				cWeight = LEFT(cLineNow,nAT)
				cLineNow = RIGHT(cLineNow,LEN(cLineNow) -nAT -1)
			ELSE
				cWeight = ''
			ENDIF	
			
			***********************************************************
		
			cPCS	= " "
			cLength = " "
			cSpecs	= cCondition 
			cHeat	= " "
		   ****
		   
			*INSERT INTO CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock" 
			*( Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
			
			SELECT tmpVendorStock 
			APPEND BLANK
			
			REPLACE Alloy WITH cAlloy
			REPLACE Form WITH cForm
			REPLACE CC WITH cCC
			REPLACE Thickness WITH cThickness
			REPLACE Width WITH cWidth
			REPLACE Length WITH cLength
			REPLACE PCS WITH cPCS
			REPLACE Weight WITH cWeight
			REPLACE Condition WITH cCondition
			REPLACE Specs WITH cSpecs
			REPLACE Heat WITH cHeat
			REPLACE BrandName WITH cBrandName
			REPLACE Vendor WITH cVendor
			REPLACE Mill WITH cMill
			
		ENDDO
		
		FCLOSE( lnFileHandle) && don't forget to close the file
		
		RETURN lReturn = .T.
	ENDPROC

	PROCEDURE crucibletxtimport2015
		PARAMETERS cFileName
		*ThisFormSet.CrucibleTXTimport2015()
		
		IF VARTYPE(cFileName) != "C"
			RETURN .F.
		ENDIF
		PRIVATE lReturn
		lReturn = .T.
		
		
		
		SELECT tmpVendorStock
		
		LOCAL lnFileHandle && numeric file handle
		
		lnFileHandle = FOPEN(cFileName)
		
		IF lnFileHandle = -1
			FCLOSE( lnFileHandle)
			lnFileHandle = FOPEN(cFileName)
		ENDIF
		
		IF lnFileHandle = -1
			&& error, could not open the file
			&& do something to handle the error
			MESSAGEBOX("File may be locked.",0,"Could not open File")
			RETURN .F.
		ENDIF
		
		LOCAL lcLine && define a variable to hold each line
		
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cHeat,cBrandName,cVendor,cMill
		cVendor	= "Crucible"
		cMill	= "CRUCIBLE"
		
		PRIVATE cLineNow,nAT
		PRIVATE cSQL, nSQLEXEC
		
		IF NOT FEOF( lnFileHandle)
			lcLine = FGETS( lnFileHandle) && store each line in lcLine
			lcLine = ALLTRIM(UPPER(lcLine))
			IF lcLine != "CRUCIBLE INVENTORY LIST"
				FCLOSE( lnFileHandle)
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE lcTryAlloy, cAlloy2, cBrandName2
		cAlloy2 = ''
		cBrandName2 = ''
		
		PRIVATE nColumn
		nColumn = 0
		DO WHILE NOT FEOF( lnFileHandle) && loop through the file
			
			lcLine = FGETS( lnFileHandle) && store each line in lcLine
			lcLine = ALLTRIM(UPPER(lcLine))
			 
			IF EMPTY(lcLine)
				LOOP
			ENDIF
			IF AT("-",lcLine,2)>=6 AND AT("-",lcLine,2)<=8
				*Date '27-Feb-15'
				LOOP
			ENDIF
			
			IF UPPER(lcLine) = "NAME" OR UPPER(lcLine) = "SHAPE" OR UPPER(lcLine) = "CONDITION";
				OR UPPER(lcLine) = "FINISH" OR UPPER(lcLine) = "WIDTH/DIA" OR UPPER(lcLine) = "THICKNESS";
				OR UPPER(lcLine) = "AVAILWGHT" OR UPPER(lcLine) = "COMMENTS"
				*First line, loop over
				nColumn = 0
				LOOP
			ENDIF
			
			IF ASC(LEFT(lcLine,1)) > 127
				WAIT WINDOW "Found odd character "+lcLine
				nColumn = 0
				LOOP
			ENDIF
			nColumn = nColumn +1
			
			IF nColumn = 1
				IF NOT EMPTY(cAlloy2)
					*Found Alloy instead of Comment on last save, skip Alloy and start on Form
					cAlloy = cAlloy2
					cBrandName = cBrandName2
					nColumn = 2
				ENDIF
			ENDIF
			
			***********************************************************
			IF nColumn = 1
				*Look for Alloy
				cAlloy = lcLine
				
				lcTryAlloy = SearchAlloyStandard(LEFT(cAlloy,12), ThisFormSet.nConnHandle)
				IF NOT EMPTY(lcTryAlloy)
					cBrandName = ALLTRIM(cAlloy)
					cAlloy = lcTryAlloy
					LOOP
				ELSE
					WAIT WINDOW "Alloy "+cAlloy+ " not found in Alloys Table." NOWAIT
					nColumn = 0 &&Start over
					LOOP
				ENDIF
			ENDIF		
			***********************************************************
			IF nColumn = 2
				*Look for Form
				DO CASE
				CASE UPPER(lcLine) = "FLAT"
					cForm = '11'
				CASE UPPER(lcLine) = "RD"
					cForm = '10'
				CASE UPPER(lcLine) = "SQ"
					cForm = '13'
				CASE UPPER(lcLine) = "INGOT"
					cForm = '99'
		
		*		OTHERWISE
		*			IF MESSAGEBOX("Did not match a form!"+CHR(13)+lcLine+CHR(13)+cLineNow,4+32,"Do you want to continue?") = 6
		*				LOOP
		*			ENDIF
				ENDCASE
				LOOP
			ENDIF
		
			***********************************************************
			IF nColumn = 3
				*Look for Condition
				DO CASE
				CASE UPPER(lcLine) = "ANN"
					cCC = '1'
				CASE UPPER(lcLine) = "H1150"
					cCC = '3'
				CASE UPPER(lcLine) = "HH-1150"
					cCC = '3'
				CASE UPPER(lcLine) = "H1025"
					cCC = '3'
				CASE UPPER(lcLine) = "HIGH STRENGTH"
					cCC = '2'
				OTHERWISE
		*			IF MESSAGEBOX("Did not match a Condition!"+CHR(13)+lcLine+CHR(13)+cLineNow,4+32,"Do you want to continue?") = 6
		*				LOOP
		*			ELSE
		*				FCLOSE( lnFileHandle)
		*				RETURN .F.
		*			ENDIF
					cCC = '1'
				ENDCASE
				cCondition = lcLine
				LOOP
			ENDIF	
			***********************************************************
			IF nColumn = 4
				*Look for Finish
				cFinish = ALLTRIM(lcLine )
				LOOP
			ENDIF
			
			
			***********************************************************
			IF nColumn = 5
				*Look for Thickness
				cThickness = ALLTRIM(lcLine)
		*!*			IF LEFT(lcLine,1) = " "
		*!*				*remove first space
		*!*				lcLine= RIGHT(lcLine, LEN(lcLine)- 1)
		*!*			ENDIF
		*!*			nAT = AT(" ",lcLine)
		*!*			IF nAT > 0
		*!*				cThickness = LEFT(lcLine,nAT)
		*!*			ELSE
		*!*				cThickness = ''
		*!*			ENDIF
				LOOP
			ENDIF
			
			***********************************************************
		   	IF nColumn = 6
				*Look for cWidth
				cWidth = ALLTRIM(lcLine)
				LOOP
			ENDIF	
			***********************************************************
		   	
		   	IF nColumn = 7 
				*Look for cWeight 
				cWeight = ALLTRIM(lcLine)
		
				*pass over the next blank line	
				lcLine = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLine))
				 
				IF EMPTY(lcLine)
					lcLine = FGETS( lnFileHandle) && store each line in lcLine
					lcLine = ALLTRIM(UPPER(lcLine))
				ENDIF
				
				*Column 8
				*Look for Comments- Could find an Alloy!			
				lcTryAlloy = SearchAlloyStandard(LEFT(lcLine,12), ThisFormSet.nConnHandle)
				IF NOT EMPTY(lcTryAlloy)
					*Have next Alloy
					cBrandName2 = lcLine
					cAlloy2 = lcTryAlloy
					cComments = ''
				ELSE
			   		*look for Comments
					cComments = ALLTRIM(lcLine)
					IF LEN( ALLTRIM(cComments) )<12
						WAIT WINDOW "May be missing Alloy AKA "+cComments 
					ENDIF
					cBrandName2 = ''
					cAlloy2 = ''
				ENDIF
					
				*SAVE
					
				cPCS	= " "
				cLength = " "
				*cSpecs	= cCondition 
				cSpecs	= cFinish 
				cHeat	= " "
				****
				IF cBrandName = "XM-19HS"
					cCC = '2'
				ENDIF
				*INSERT INTO CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock" 
				*( Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
				
				SELECT tmpVendorStock 
				APPEND BLANK
				
				REPLACE Alloy WITH cAlloy
				REPLACE Form WITH cForm
				REPLACE CC WITH cCC
				REPLACE Thickness WITH cThickness
				REPLACE Width WITH cWidth
				REPLACE Length WITH cLength
				REPLACE PCS WITH cPCS
				REPLACE Weight WITH cWeight
				REPLACE Condition WITH cCondition
				REPLACE Specs WITH cSpecs
				REPLACE Heat WITH cHeat
				REPLACE BrandName WITH cBrandName
				REPLACE Vendor WITH cVendor
				REPLACE Mill WITH cMill
				
				nColumn = 0
				LOOP
			ENDIF	
			
		ENDDO
		
		FCLOSE( lnFileHandle) && don't forget to close the file
		
		RETURN lReturn = .T.
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE dnacsvimport
		PARAMETER cFile
		*ThisFormSet.DNACVSImport( cFile )
		*Append FROM CSV
		
		
		IF USED('tmpDNA')
			USE IN tmpDNA
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\tmpDNA.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\tmpDNA.dbf")
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\MEM\tmpDNA.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\MEM\tmpDNA.dbf")
		ENDIF
		
		*ID C(30), [Descript] C(100), Pounds I(10)
		
		SELECT 0
		IF "\MEM" $ SYS(2003)
			CREATE TABLE SYS(5)+SYS(2003)+"\tmpDNA" FREE ( Descr C(100), Weight N(10) )
			USE (SYS(5)+SYS(2003)+"\tmpDNA.DBF") EXCL 
		ELSE
			CREATE TABLE SYS(5)+SYS(2003)+"\MEM\tmpDNA" FREE ( Descr C(100), Weight N(10) )
			USE (SYS(5)+SYS(2003)+"\MEM\tmpDNA.DBF") EXCL 
		ENDIF
		
		IF USED('tmpDNA')
			SELECT tmpDNA
		ENDIF
		
		*******
		IF NOT USED('tmpDNA')
			RETURN .F.
		ENDIF
		
		SELECT tmpDNA
		APPEND FROM (cFile) TYPE CSV
		
		
		PRIVATE cPrevDia, cPrevAlloy 
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cSpecsA,cMelt,cHeat,cBrandName,cVendor,cMill
		cPrevAlloy = 'MP35N'
		cPrevDia = ''
		
		SELECT tmpDNA
		SCAN
			*Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Melt C(7), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
			*Alloy C(20), [Dia] C(10), [TOL] C(20), LOT C(30), [REFORGE] C(10), SPEC C(40),lengthIn C(10), LengthFt C(10), Weight C(10)	
			
		*!*		IF UPPER(tmpDNA.itemID) = "item_id"
		*!*			*Header row
		*!*			SELECT tmpDNA
		*!*			LOOP
		*!*		ENDIF
			
		*!*		IF EMPTY(tmpDNA.Alloy)
		*!*			cAlloy = cPrevAlloy
		*!*		ELSE
		*!*			cAlloy	= tmpDNA.Alloy
		*!*		ENDIF
			cDesc = tmpDNA.Descr
			
			cAlloy		= LEFT(cDesc,AT(" BAR",cDesc)-1)
			cDesc2 		= RIGHT(cDesc,LEN(cDesc)-LEN(cAlloy)-1)
			
			*cForm		= LEFT(cDesc2,LEN(cDesc2)-5)
			cForm		= '10'
			
			cDesc3 		= RIGHT(cDesc2,LEN(cDesc2)-LEN(" DIA"))
			cCC			= '1'
			
			cThickness	= LEFT(cDesc3,AT("DIA",cDesc3)-2)
			*cThickness	= LEFT( tmpDNA.Descr,AT('RND',tmpDNA.Descr)-1 )
			
			cDesc4 		= RIGHT(cDesc3,LEN(cDesc3)-AT(cThickness,cDesc3))
			*cDesc4 		= LEFT(cDesc3,AT(cThickness,cDesc3)-2)
			
			cWidth		= ''
			cLength		= ''
			cPCS		= ''
			cWeight		= tmpDNA.Weight
			cCondition	= cDesc4
			cSpecsA		= ''	&&SUBSTR( tmpDNA.Descr,AT('-VV',tmpDNA.Descr)+4 )
			cSpecs		= ''	&&LEFT( cSpecsA,AT('BAR',cSpecsA)-1 )
		
			cMelt		= ''
			cHeat		= ''
			cBrandName	= ''
			cVendor		= "DNA"
			cMill 		= "DNA"
			
			*IF EMPTY( cBrandName )
			*	cBrandName = cPrevAlloy 
			*ENDIF
			*IF EMPTY( cThickness )
			*	cThickness = cPrevDia
			*ENDIF
			
			INSERT INTO tmpVendorStock ;
			(Alloy,Form,CC,Thickness,Width,Length,PCS,Weight,Condition,Specs,Melt,Heat,BrandName,Vendor,Mill);
			 VALUES ;
			(cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill)
			
			cPrevAlloy	= cAlloy
			cPrevDia	= cThickness
			
			SELECT tmpDNA
		ENDSCAN
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE dunkirksscsvimport
		PARAMETER cFile
		*ThisFormSet.DunkirkSSCSVimport(cFile)
		
		
		IF VARTYPE(cFileName) != "C"
			RETURN .F.
		ENDIF
		PRIVATE lReturn
		lReturn = .T.
		
		SELECT tmpVendorStock
		
		LOCAL lnFileHandle && numeric file handle
		
		lnFileHandle = FOPEN(cFileName)
		
		IF lnFileHandle = -1
			FCLOSE( lnFileHandle)
			lnFileHandle = FOPEN(cFileName)
		ENDIF
		
		IF lnFileHandle = -1
			&& error, could not open the file
			&& do something to handle the error
			MESSAGEBOX("File may be locked.",0,"Could not open File")
			RETURN .F.
		ENDIF
		
		LOCAL lcLine,lcLineOrig && define a variable to hold each line
		
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cHeat,cBrandName,cVendor,cMill
		cVendor	= "Dunkirk Specialy Steel" 
		cMill	= "Dunkirk"
		
		MESSAGEBOX("This Procedure is not Complete",0,"")
		
		PRIVATE cLineNow,nAT
		PRIVATE cSQL, nSQLEXEC
		
		PRIVATE lcTryAlloy, cAlloy2, cBrandName2, cWeight2 
		cAlloy2 = ''
		cBrandName2 = ''
		cWeight2 = ''
		PRIVATE nColumn,nATcomma
		nColumn = 0
		nATcomma = 0
		
		*nColumn = 1
		DO WHILE NOT FEOF( lnFileHandle) && loop through the file
			
			IF nColumn < 2
				lcLineOrig = FGETS( lnFileHandle ) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLineOrig))
			ENDIF
				 
			IF EMPTY(lcLine)
				LOOP
			ENDIF
			
			IF UPPER(lcLine) = "SIZE" OR UPPER(lcLine) = "WEIGHT" 
				*First line, loop over
				nColumn = 0
				LOOP
			ENDIF
			IF UPPER(lcLine) = "STAINLESS STOCK LIST" 
				*First line, loop over
				nColumn = 0
				cVendor	= "Electralloy Stainless" &&must be different than "Electralloy Nickel"
				*chkVendorImport will delete all of the same vendor!!!
				cMill	= "ElectralloySS"
				LOOP
			ENDIF
			
			IF ASC(LEFT(lcLine,1)) > 127
				WAIT WINDOW "Found odd character "+lcLine
				nColumn = 0
				LOOP
			ENDIF
			
			IF RIGHT(lcLine,1) = ","
				*Drop the last comma
				lcLine = LEFT(lcLine,LEN(lcLine)-1)
			ENDIF
			
			nColumn = nColumn +1
			
			IF nColumn = 1
				IF NOT EMPTY(cAlloy2)
					*Found Alloy instead of Comment on last save, skip Alloy and start on Form
					cAlloy = cAlloy2
					cBrandName = cBrandName2
					*cWeight = cWeight2 
					nColumn = 2
				ENDIF
			ENDIF
			
			***********************************************************
			IF nColumn = 1
				*Stainless List has double comma!
				IF RIGHT(lcLine,1) = ","
					*Drop the last comma
					lcLine = LEFT(lcLine,LEN(lcLine)-1)
				ENDIF
				
				*Look for Alloy
				cAlloy = lcLine
				
				lcTryAlloy = SearchAlloyStandard(LEFT(cAlloy,12), ThisFormSet.nConnHandle)
				IF NOT EMPTY(lcTryAlloy)
					cBrandName = ALLTRIM(cAlloy)
					cAlloy = lcTryAlloy
					LOOP
				ELSE
					WAIT WINDOW "Alloy "+cAlloy+ " not found in Alloys Table. Looking for Next Alloy..." 
					nColumn = 0 &&Start over
					LOOP
				ENDIF
			ENDIF	
			cForm = '10'	
			*cCC = '1'
			cCondition = ''
			cFinish = ''
			
			
			***********************************************************
			IF nColumn = 2
				IF NOT EMPTY(cAlloy2)
					IF cAlloy != cAlloy2
						cAlloy = cAlloy2
					ENDIF
					IF cBrandName != cBrandName2
						cBrandName = cBrandName2
						*lcLine = "NITRONIC 50 HIGH STRENGTH"
					ENDIF
				ENDIF
						
				*Look for Thickness
				
				nATcomma = AT(",",lcLine)
				IF nATcomma = 0
					cThickness = ALLTRIM(lcLine)
					LOOP
				ELSE
					*column 2 and 3 are combined
					cThickness = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
					cThickness2 = cThickness
					lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
					nColumn = 3
				ENDIF
			ENDIF
			cWidth = '0'
		
			***********************************************************
		   	
		   	IF nColumn = 3
		   		IF NOT EMPTY(cWeight2)
		   			cWeight = cWeight2
					IF AT(",",cWeight)>0
						cWeight= STRTRAN(cWeight,[,],[])
					ENDIF
		
		   			cWeight2 = ''
		   			cThickness = cThickness2
		   			cThickness2 =''
		   		ELSE
					*Look for cWeight 
					cWeight = ALLTRIM(lcLine)
					IF AT(",",cWeight)>0
						cWeight= STRTRAN(cWeight,[,],[])
					ENDIF
				ENDIF
				
				*Get Next Line
				lcLineOrig = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLineOrig))
				IF EMPTY(lcLine)
					lcLineOrig = FGETS( lnFileHandle) && store each line in lcLine
					lcLine = ALLTRIM(UPPER(lcLineOrig))
				ENDIF
				IF RIGHT(lcLine,1) = ","
					*Drop the last comma
					lcLine = LEFT(lcLine,LEN(lcLine)-1)
				ENDIF
				IF RIGHT(lcLine,1) = ","
					*Drop the last comma
					lcLine = LEFT(lcLine,LEN(lcLine)-1)
				ENDIF		
				
				*Look for next Size Could find an Alloy!			
				lcTryAlloy = SearchAlloyStandard(LEFT(lcLine,12), ThisFormSet.nConnHandle)
				IF NOT EMPTY(lcTryAlloy)
					*Have next Alloy
					cBrandName2 = lcLine
					cAlloy2 = lcTryAlloy
					cWeight2 = ''
					cThickness2 = ''
					nColumn = 1
					IF lcLine = "NITRONIC 50 HIGH STRENGTH"
						cCC2 = '2'
					ENDIF
				ELSE
					*Have unknown Alloy or Next Thickness,Weight
					IF LEFT(lcLine,1) = ","
						*Bad Alloy
						MESSAGEBOX("Unknown Alloy: "+lcLine,48,"Add Alloy")
						nColumn = 0
						cAlloy2 = ""
						cBrandName2=""
						LOOP
					ELSE
						nATcomma = AT(",",lcLine)
						cThickness2 = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
						*cThickness2 = cThickness 
						lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
						*nColumn = 3
						cWeight2 = ALLTRIM(lcLine)
						IF AT(",",cWeight2)>0
							cWeight2= STRTRAN(cWeight2,[,],[])
						ENDIF
						
						*cThickness2 = ALLTRIM(lcLine)
						nColumn = 2
					ENDIF
				ENDIF
					
				*SAVE
					
				cPCS	= " "
				cLength = " "
				*cSpecs	= cCondition 
				cSpecs	= cFinish 
				cHeat	= " "
				cComments = ''
				****
				*IF cBrandName = "XM-19HS"
				IF cBrandName = "NITRONIC 50 HIGH STRENGTH"
					cCC = '2'
				ELSE
					cCC = '1'
				ENDIF
				*INSERT INTO CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock" 
				*( Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
				
				SELECT tmpVendorStock 
				APPEND BLANK
				
				REPLACE Alloy WITH cAlloy
				REPLACE Form WITH cForm
				REPLACE CC WITH cCC
				REPLACE Thickness WITH cThickness
				REPLACE Width WITH cWidth
				REPLACE Length WITH cLength
				REPLACE PCS WITH cPCS
				REPLACE Weight WITH cWeight
				REPLACE Condition WITH cCondition
				REPLACE Specs WITH cSpecs
				REPLACE Heat WITH cHeat
				REPLACE BrandName WITH cBrandName
				REPLACE Vendor WITH cVendor
				REPLACE Mill WITH cMill
				
				IF RECCOUNT('tmpVendorStock') = 11
			*		? RECCOUNT('tmpVendorStock')
					*Found a comma in the Weight???
					
				ENDIF
				*nColumn = 0
				LOOP
			ENDIF	
			
		ENDDO
		
		FCLOSE( lnFileHandle) && don't forget to close the file
		
		RETURN lReturn = .T.
	ENDPROC

	PROCEDURE dynamic_backcolor_review
		*ThisFormset.frmStockReview.grdStockLst.clm.DynamicBackColor = ThisFormSet.Dynamic_BackColor_Review
		
		nColor = RGB( 255, 255, 255 ) &&WHITE
		
		IF USED('StockLst_Review')
			IF StockLst_Review.CurrStock + StockLst_Review.StockDue - StockLst_Review.SafeLevel < 0
				*nColor = RGB( 128,128,128 ) &&Grey
				nColor = RGB( 255,128,128 ) &&Pink
			ELSE
				IF StockLst_Review.Broker > 0
					nColor = RGB( 0,255,255 ) &&lightBlue
				ENDIF
				IF StockLst_Review.yr3Sales/5 > StockLst_Review.yr1Sales
					nColor = RGB( 128,128,255 ) &&lightViolet
				ENDIF
				
				IF StockLst_Review.yr1Sales > StockLst_Review.yr3Sales
					nColor = RGB( 255,128,0 ) &&Orange
				ENDIF
				
				IF StockLst_Review.StockDue > 0
					nColor = RGB( 255,255,128 ) &&Yellow
				ENDIF
			ENDIF
		ENDIF
		
		RETURN nColor
	ENDPROC

	PROCEDURE electralloycsvimport
		PARAMETERS cFileName
		*ThisFormSet.ElectralloyCSVimport()
		*Handles both Nickel and Stainless
		
		*https://docs.google.com/spreadsheets/d/1xECtY8jYJCFoyo2f4nNLlG20tNp-4dNlt5b5DO2gzhg/edit?ts=5e4fe0ba#gid=2056785364
		*Copy cells to Excel, save as CSV in HPA folder
		* Header: [GRADE],[SIZE - OD],[LENGTH - Inches],[WEIGHT],[HEAT No.],[CONDITION],[PCS]
		 
		
		IF VARTYPE(cFileName) != "C"
			RETURN .F.
		ENDIF
		PRIVATE lReturn
		lReturn = .T.
		
		SELECT tmpVendorStock
		
		LOCAL lnFileHandle && numeric file handle
		
		lnFileHandle = FOPEN(cFileName)
		
		IF lnFileHandle = -1
			FCLOSE( lnFileHandle)
			lnFileHandle = FOPEN(cFileName)
		ENDIF
		
		IF lnFileHandle = -1
			&& error, could not open the file
			&& do something to handle the error
			MESSAGEBOX("File may be locked.",0,"Could not open File")
			RETURN .F.
		ELSE
			*WAIT WINDOW "FileHandle "+ALLTRIM(STR(lnFileHandle)) TIMEOUT 2
		ENDIF
		
		LOCAL lcLine,lcLineOrig && define a variable to hold each line
		
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cHeat,cBrandName,cVendor,cMill
		IF UPPER("ELECTRALLOY STAINLESS") $ UPPER(cFileName)
			cVendor	= "Electralloy Stainless"
			cMill	= "Electra SS"
		ELSE
			IF UPPER("ELECTRALLOY NICKEL") $ UPPER(cFileName)
				cVendor	= "Electralloy Nickel"
				cMill	= "Electra Ni"
			ELSE
				MESSAGEBOX("Cannot tell if Ni or SS",16,"Error")
				TrackError("Cannot tell if Ni or SS by FileName"+CHR(13)+cFileName,"Cannot tell if Ni or SS", PROGRAM(), LINENO(1))
				RETURN .F.
			ENDIF
		ENDIF
		
		
		PRIVATE cLineNow,nAT
		PRIVATE cSQL, nSQLEXEC
		
		PRIVATE lcTryAlloy, cAlloy2, cBrandName2, cWeight2
		cAlloy2 = ''
		cBrandName2 = ''
		cWeight2 = ''
		PRIVATE nColumn,nATcomma,nLoopCount
		nColumn = 0
		nATcomma = 0
		cSpecs = ""
		*nColumn = 1
		
		PRIVATE lcLineWitle, lcLinePCs, nPass 
		********************************************************				
						
		DO WHILE NOT FEOF( lnFileHandle) && loop through the file
		
			*Grab a cLine
			IF nColumn < 2
				lcLineOrig = FGETS( lnFileHandle ) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLineOrig))
			ENDIF
		
			IF EMPTY(lcLine)
				LOOP
			ENDIF
		
			IF ASC(LEFT(lcLine,1)) > 127
				*WAIT WINDOW "Found odd character "+lcLine
				nColumn = 0
				DO WHILE ASC(LEFT(lcLine,1)) > 127 AND LEN(lcLine)>2
					lcLine = RIGHT(lcLine,LEN(lcLine)-1)
				ENDDO
				IF LEN(lcLine)<2
					*no info
					LOOP
				ENDIF
			ENDIF
		
			DO WHILE RIGHT(lcLine,1) = ","
				*Drop the last comma
				lcLine = LEFT(lcLine,LEN(lcLine)-1)
			ENDDO
		
			IF LEN(lcLine) = 0
				LOOP
			ENDIF
		
		
			***********************************************************
			
			IF UPPER(lcLine) = "GRADE" OR UPPER(lcLine) = "WEIGHT" OR "STOCKLIST" $ UPPER(lcLine)
				*Headers row, loop over
				nColumn = 0
				LOOP
			ENDIF
			
			nColumn = nColumn +1
		
			***********************************************************
		
			*	IF nColumn = 1
			*		IF NOT EMPTY(cAlloy2)
			*			*Found Alloy instead of Comment on last save, skip Alloy and start on Form
			*			cAlloy = cAlloy2
			*			cBrandName = cBrandName2
			*			*cWeight = cWeight2
			*			nColumn = 2
			*		ENDIF
			*	ENDIF
			*
			*	***********************************************************
		
			IF nColumn = 1
				*Check for Alloy
		
				IF 'BAR' $ lcLine
					*This is the Grade Field
		
					cAlloy = LEFT(lcLine,AT('BAR',lcLine)-1)	&&usualy NIT50-BAR or NIT50HBAR or ECK500BARRND
					IF AT('-',cAlloy) > 0
						DO WHILE RIGHT(cAlloy,1) = '-' OR RIGHT(cAlloy,1) = ' '
							cAlloy = LEFT(cAlloy,LEN(cAlloy)-1)
						ENDDO
					ENDIF
				
					IF cAlloy = 'NIT50H'
						cAlloy = 'NIT50H'
					ENDIF
					lcTryAlloy = ALLTRIM( SearchAlloyStandard(LEFT(cAlloy,12), THISFORMSET.nConnHandle) )
					IF NOT EMPTY(lcTryAlloy)
					
						IF cAlloy = 'NIT50H'
							cBrandName = "NITRONIC 50 HIGH STRENGTH"
						ELSE
							cBrandName = ALLTRIM(cAlloy)
						ENDIF
						cAlloy = lcTryAlloy
									
						nColumn = 2
						
						nATcomma = AT(",",lcLine)
						IF nATcomma > 0
							lcLine = ALLTRIM( RIGHT(lcLine, LEN( lcLine) - nATcomma  ) )
						ENDIF
					ELSE
		
						WAIT WINDOW "Alloy "+cAlloy+ " not found in Alloys Table. Looking for Next Alloy..."
						nColumn = 0 &&Start over
						cAlloy = ''
						nColumn = 1
						LOOP
						
					ENDIF
				
				ELSE
					LOOP
				ENDIF
			ENDIF
		
			***********************************************************
		
			cForm = '10'
			*cCC = '1'
			cCondition = ''
			cFinish = ''
			cWidth = '0'
			cPCS	= " "
			cSpecs = ""
		
			***********************************************************
		
			*	IF nColumn = 2
			*		IF NOT EMPTY(cAlloy2)
			*			IF cAlloy != cAlloy2
			*				cAlloy = cAlloy2
			*			ENDIF
			*			IF cBrandName != cBrandName2
			*				cBrandName = cBrandName2
			*				*lcLine = "NITRONIC 50 HIGH STRENGTH"
			*			ENDIF
			*		ENDIF
			*	ENDIF
			*
			*	***********************************************************
		
			IF nColumn = 2
				*Look for Thickness
				cThickness= ''
				nATcomma = AT(",",lcLine)
				IF nATcomma = 0
					cThickness = ALLTRIM(lcLine)
					*LOOP
				ELSE
					cThickness = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
					cThickness2 = cThickness
					lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
				ENDIF
				nColumn = 3
			ENDIF
		
			***********************************************************
		
			IF nColumn = 3
				*Look for Length
		
				nATcomma = AT(",",lcLine)
				IF nATcomma = 0
					cLength = ALLTRIM(lcLine)
					*LOOP
				ELSE
					cLength = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
					cLength2 = cLength
					lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
				ENDIF
				nColumn = 4
			ENDIF
		
			***********************************************************
		
			IF nColumn = 4
				*Look for Weight
		
				nATcomma = AT(",",lcLine)
				IF nATcomma = 0
					cWeight = ALLTRIM(lcLine)
					*LOOP
				ELSE
					cWeight = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
					*Check second comma for more of the number
					IF VAL(SUBSTR(lcLine, nATcomma+1, AT(",",lcLine) )) > 1 AND VAL(SUBSTR(lcLine, nATcomma+1, AT(",",lcLine) )) < 1000
						nWeight = VAL(cWeight) *1000
						nWeight1 = nWeight + VAL( SUBSTR(lcLine, nATcomma+1, AT(",",lcLine)) ) 
						cWeight = STR(nWeight1)
						lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
						nATcomma = AT(",",lcLine)
					ENDIF
					cWeight2 = cWeight
					lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
				ENDIF
				nColumn = 5
			ENDIF
		
			***********************************************************
		
			IF nColumn = 5
				*Look for Heat
		
				nATcomma = AT(",",lcLine)
				IF nATcomma = 0
					cHeat = ALLTRIM(lcLine)
					*LOOP
				ELSE
					cHeat = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
					cHeat = STRTRAN( cHeat,[--],[-] )
					cHeat2 = cHeat
					lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
				ENDIF
				nColumn = 6
			ENDIF
		
			***********************************************************
		
			IF nColumn = 6
				*Look for Pieces
				*Electralloy uses Commas in Specs: Hot Finished, Annealed & Aged
				*So get PCS first!
				
				nATcomma = AT(",",lcLine)
				IF nATcomma = 0
					cPCS = ALLTRIM(lcLine)
					*LOOP
				ELSE
					***work backwards to the pCs is found at a Comma.
					nPass = 1
					lcLineWhitle = lcLine
					lcLinePCs = ''
					DO WHILE LEN(lcLineWhitle) > 1
						*lcLinePCs = RIGHT(lcLine,LEN(lcLineWhitle))
		
						lcLinePCs = RIGHT(lcLine,nPass)
						lcLineWhitle = LEFT(lcLineWhitle,LEN(lcLineWhitle)-1)
						
						IF RIGHT(lcLineWhitle,1) = ','
							EXIT
						ENDIF
						
						nPass = nPass + 1
					ENDDO
					lcLine = LEFT(lcLine,LEN(lcLine)-nPass -1)
					
					cPCS = lcLinePCs
					*cPCS = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
					cPCS2 = cPCS
					*lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
				ENDIF
				nColumn = 7
			ENDIF
		
			***********************************************************
		
			IF nColumn = 7
				*Look for Condition Spec
				*Electralloy uses Commas here: Hot Finished, Annealed & Aged
		
				nATcomma = AT(",",lcLine)
				IF nATcomma = 0
					cSpecs = ALLTRIM(lcLine)
					*LOOP
				ELSE
					cSpecs = ALLTRIM(LEFT(lcLine, nATcomma -1 ))
					lcLine = SUBSTR(lcLine, nATcomma+1, LEN(lcLine)-nATcomma )
				ENDIF
				nColumn = 8
				cCondition = cSpecs
			ENDIF
		
		
			***********************************************************
			*SAVE
		
			*cLength = " "
			*cSpecs	= cCondition
			*cSpecs	= cFinish
			*cHeat	= " "
			****
		
		*	IF cAlloy = 'NIT50HS' &&"XM-19HS"
			IF cBrandName = "NITRONIC 50 HIGH STRENGTH"
				IF "COLD DRAWN" $ UPPER(cCondition )
					cCC='7'
				ELSE
					cCC = '2'
				ENDIF
			ELSE
				cCC = '1'
			ENDIF
			********************************
			IF VAL(cPCS)< 1
				cPCS = '1'
				*IF VAL(cLength) > 0
				*	cLength = ALLTRIM( STR( VAL(cLength)/VAL(cPcs) ) )
				*ENDIF
			ENDIF
			
			********************************
			*INSERT INTO CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock"
			*( Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
		
			SELECT tmpVendorStock
			APPEND BLANK
		
			REPLACE Alloy WITH cAlloy
			REPLACE FORM WITH cForm
			REPLACE CC WITH cCC
			REPLACE Thickness WITH cThickness
			REPLACE WIDTH WITH cWidth
			REPLACE LENGTH WITH cLength
			REPLACE PCS WITH cPCS
			REPLACE Weight WITH cWeight
			REPLACE Condition WITH cCondition
			REPLACE Specs WITH cSpecs
			REPLACE Heat WITH cHeat
			REPLACE BrandName WITH cBrandName
			REPLACE Vendor WITH cVendor
			REPLACE Mill WITH cMill
		
			*	IF RECCOUNT('tmpVendorStock') = 11
			*		? RECCOUNT('tmpVendorStock')
			*Found a comma in the Weight???
			*	ENDIF
		
			cAlloy2 = cAlloy
			nColumn = 0
		
			LOOP
		ENDDO
		
		FCLOSE( lnFileHandle) && don't forget to close the file
		
		RETURN lReturn = .T.
		
	ENDPROC

	PROCEDURE electralloytxtimport
		PARAMETERS cFileName
		*ThisFormSet.ElectralloyTXTimport()
		*
		*
		*
		** Does not Work!, The Size and Weight get connected and can not parse!
		*
		*
		
		*!*	BULK INSERT Sales
		*!*	FROM 'C:\temp\1500000 Sales Records.csv'
		*!*	WITH (FIRSTROW = 2,
		*!*	    FIELDTERMINATOR = ',',
		*!*	    ROWTERMINATOR='\n',
		*!*	    BATCHSIZE=250000,
		*!*	    MAXERRORS=2);
		*!*	    
		*!*	    
		
		IF VARTYPE(cFileName) != "C"
			RETURN .F.
		ENDIF
		PRIVATE lReturn
		lReturn = .T.
		
		
		
		SELECT tmpVendorStock
		
		LOCAL lnFileHandle && numeric file handle
		
		lnFileHandle = FOPEN(cFileName)
		
		IF lnFileHandle = -1
			FCLOSE( lnFileHandle)
			lnFileHandle = FOPEN(cFileName)
		ENDIF
		
		IF lnFileHandle = -1
			&& error, could not open the file
			&& do something to handle the error
			MESSAGEBOX("File may be locked.",0,"Could not open File")
			RETURN .F.
		ENDIF
		
		LOCAL lcLine,lcLineOrig && define a variable to hold each line
		
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cHeat,cBrandName,cVendor,cMill
		cVendor	= "Electralloy"
		cMill	= "Electralloy"
		
		PRIVATE cLineNow,nAT
		PRIVATE cSQL, nSQLEXEC
		
		*!*	IF NOT FEOF( lnFileHandle)
		*!*		lcLine = FGETS( lnFileHandle) && store each line in lcLine
		*!*		lcLine = ALLTRIM(UPPER(lcLine))
		*!*		IF lcLine != "CRUCIBLE INVENTORY LIST"
		*!*			FCLOSE( lnFileHandle)
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
		
		PRIVATE lcTryAlloy, cAlloy2, cBrandName2
		cAlloy2 = ''
		cBrandName2 = ''
		
		PRIVATE nColumn
		nColumn = 0
		DO WHILE NOT FEOF( lnFileHandle) && loop through the file
			
			lcLineOrig = FGETS( lnFileHandle ) && store each line in lcLine
			lcLine = ALLTRIM(UPPER(lcLineOrig))
			 
			IF EMPTY(lcLine)
				LOOP
			ENDIF
		*!*		IF AT("-",lcLine,2)>=6 AND AT("-",lcLine,2)<=8
		*!*			*Date '27-Feb-15'
		*!*			LOOP
		*!*		ENDIF
			
			IF UPPER(lcLine) = "SIZE" OR UPPER(lcLine) = "WEIGHT" 
				*First line, loop over
				nColumn = 0
				LOOP
			ENDIF
			
			IF ASC(LEFT(lcLine,1)) > 127
				WAIT WINDOW "Found odd character "+lcLine
				nColumn = 0
				LOOP
			ENDIF
			
			nColumn = nColumn +1
			
			IF nColumn = 1
				IF NOT EMPTY(cAlloy2)
					*Found Alloy instead of Comment on last save, skip Alloy and start on Form
					cAlloy = cAlloy2
					cBrandName = cBrandName2
					nColumn = 2
				ENDIF
			ENDIF
			
			***********************************************************
			IF nColumn = 1
				*Look for Alloy
				cAlloy = lcLine
				
				lcTryAlloy = SearchAlloyStandard(LEFT(cAlloy,12), ThisFormSet.nConnHandle)
				IF NOT EMPTY(lcTryAlloy)
					cBrandName = ALLTRIM(cAlloy)
					cAlloy = lcTryAlloy
					LOOP
				ELSE
					WAIT WINDOW "Alloy "+cAlloy+ " not found in Alloys Table." NOWAIT
					nColumn = 0 &&Start over
					LOOP
				ENDIF
			ENDIF	
			cForm = '10'	
			cCC = '1'
			cCondition = ''
			cFinish = ''
			
			
			***********************************************************
			IF nColumn = 2
				*Look for Thickness
				cThickness = ALLTRIM(lcLine)
				cThickness2 = cThickness 
				LOOP
			ENDIF
			cWidth = '0'
		
			***********************************************************
		   	
		   	IF nColumn = 3
				*Look for cWeight 
				cWeight = ALLTRIM(lcLine)
				cWeight	= STRTRAN(cWeight,[,],"")
				*pass over the next blank line	
				lcLineOrig = FGETS( lnFileHandle) && store each line in lcLine
				lcLine = ALLTRIM(UPPER(lcLineOrig))
				 
				IF EMPTY(lcLine)
					lcLineOrig = FGETS( lnFileHandle) && store each line in lcLine
					lcLine = ALLTRIM(UPPER(lcLineOrig))
				ENDIF
				
				IF cThickness != cThickness2
					*Column was not 2, Use the cThickness2
					cThickness = cThickness2
				ELSE
					*Column was 2 and cThickness = cThickness2
				ENDIF
				
				*Column 8
				*Look for next Size Could find an Alloy!			
				lcTryAlloy = SearchAlloyStandard(LEFT(lcLine,12), ThisFormSet.nConnHandle)
				IF NOT EMPTY(lcTryAlloy)
					*Have next Alloy
					cBrandName2 = lcLine
					cAlloy2 = lcTryAlloy
					nColumn = 1
				ELSE
					*Have Next Thickness
					cThickness2 = ALLTRIM(lcLine)
					nColumn = 2
				ENDIF
					
				*SAVE
					
				cPCS	= " "
				cLength = " "
				*cSpecs	= cCondition 
				cSpecs	= cFinish 
				cHeat	= " "
				cComments = ''
				****
				*IF cBrandName = "XM-19HS"
				IF cBrandName = "Nitronic 50 High Strength"
					cCC = '2'
				ENDIF
				*INSERT INTO CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock" 
				*( Alloy C(20), [Form] C(10), [CC] C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10), Weight C(10), Condition C(30), Specs C(30), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10) )
				
				SELECT tmpVendorStock 
				APPEND BLANK
				
				REPLACE Alloy WITH cAlloy
				REPLACE Form WITH cForm
				REPLACE CC WITH cCC
				REPLACE Thickness WITH cThickness
				REPLACE Width WITH cWidth
				REPLACE Length WITH cLength
				REPLACE PCS WITH cPCS
				REPLACE Weight WITH cWeight
				REPLACE Condition WITH cCondition
				REPLACE Specs WITH cSpecs
				REPLACE Heat WITH cHeat
				REPLACE BrandName WITH cBrandName
				REPLACE Vendor WITH cVendor
				REPLACE Mill WITH cMill
				
				nColumn = 0
				LOOP
			ENDIF	
			
		ENDDO
		
		FCLOSE( lnFileHandle) && don't forget to close the file
		
		RETURN lReturn = .T.
	ENDPROC

	PROCEDURE getgenerickvendorimport
		*ThisFormSet.GetGenerickVendorImport()
		
		SELECT tmpVendorStock
		
		DO WHILE NOT EOF('tmpVendorStock')
			IF EMPTY(tmpVendorStock.Alloy) AND EMPTY(tmpVendorStock.Form)
				SKIP IN 'tmpVendorStock'
				LOOP
			ENDIF
			EXIT
		ENDDO
			
		IF EOF('tmpVendorStock')
			ThisFormSet.frmVendorImport.Visible = .F.
			ThisFormset.SaveAll = .F.
			USE IN tmpVendorStock
		
		*	ThisFormSet.GetStockLst_Vendor()
		*	ThisFormSet.RefreshStockLst_vendor()
		
		*	ThisFormSet.frmVendorStock.Top = 0
		*	ThisFormSet.frmVendorStock.Left = 152
		*	ThisFormSet.frmVendorStock.Visible = .T.		
			
			RETURN
		ENDIF
		
		PRIVATE nDecimals
		nDecimals = SET("DECIMALS")
		
		*chkVendorImport.Click
		*CREATE TABLE SYS(5)+SYS(2003)+"\tmpVendorStock" FREE ( Alloy C(20), [Form] C(10), CC C(2), Thickness C(50), [Width] C(10), Length C(10),PCS C(10)
		*, Weight C(10), Condition C(30), Specs C(30), Heat C(30), BrandName C(20), Vendor C(30), Mill C(10),Melt C(7) )
		PRIVATE cAlloy,cForm,cCC,cThickness,cWidth,cLength,cPCS,cWeight,cCondition,cSpecs,cMelt,cHeat,cBrandName,cVendor,cMill
		cAlloy		= tmpVendorStock.Alloy
		cForm		= tmpVendorStock.Form
		cCC			= tmpVendorStock.CC
		cThickness	= tmpVendorStock.Thickness
		cWidth		= tmpVendorStock.Width
		cLength		= tmpVendorStock.Length
		cPCS		= tmpVendorStock.PCS
		cWeight		= tmpVendorStock.Weight
		cWeight		= STRTRAN(cWeight,[,],"")
		cCondition	= tmpVendorStock.Condition
		cSpecs		= tmpVendorStock.Specs
		cMelt		= tmpVendorStock.Melt
		cHeat		= tmpVendorStock.Heat
		cBrandName	= tmpVendorStock.BrandName
		cVendor		= tmpVendorStock.Vendor
		cMill 		= tmpVendorStock.Mill
		**************************************************
		
		*Get Alloy From BrandName
		PRIVATE cAlloy2
		IF NOT EMPTY(cBrandName)
			IF 'ESR' $  UPPER(cBrandName)
				cBrandName = STUFF( cBrandName, AT('ESR', cBrandName),3,'')
				cBrandName = ALLTRIM(cBrandName)
			ENDIF
		ENDIF
		
		IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
			cAlloy = GetHPA_Standard_Alloy( cBrandName, ThisFormSet.nConnHandle)
		ENDIF
		IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
			*Try again with short BrandName
			cBrandName = ALLTRIM(cBrandName)
			
			cAlloy2 = LEFT(cBrandName,AT(' ',cBrandName)-1)  &&Remove all past first space
			cAlloy = GetHPA_Standard_Alloy( cAlloy2, ThisFormSet.nConnHandle)
		ENDIF
		
		IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
			*Try Right with out '/'
			IF AT('/',cBrandName) > 0
				cAlloy2 = RIGHT(cBrandName,LEN(cBrandName)-AT('/',cBrandName))
				cAlloy = GetHPA_Standard_Alloy( cAlloy2, ThisFormSet.nConnHandle)
			ENDIF
		ENDIF
		IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
			*Try Right with out '\'
			cBrandName= LEFT(cBrandName,AT(' ',cBrandName)-1)  &&Remove all past first space
			IF AT('\',cBrandName) > 0
				cAlloy2 = RIGHT(cBrandName, LEN(cBrandName)-AT('\',cBrandName))
				cAlloy = GetHPA_Standard_Alloy( cAlloy2, ThisFormSet.nConnHandle)
			ENDIF
		ENDIF
		IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
			*Try Left with out '/'
			cBrandName = LEFT(cBrandName,AT(' ',cBrandName)-1)  &&Remove all past first space
			IF AT('/',cBrandName) > 0
				cAlloy2 = LEFT(cBrandName,AT('/',cBrandName)-1)
				cAlloy = GetHPA_Standard_Alloy( cAlloy2, ThisFormSet.nConnHandle)
			ENDIF
		ENDIF
		IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
			*Try Left with out '\'
			cBrandName = LEFT(cBrandName,AT(' ',cBrandName)-1)  &&Remove all past first space
			IF AT('\',cBrandName) > 0
				cAlloy2 = LEFT(cBrandName,AT('\',cBrandName)-1)
				cAlloy = GetHPA_Standard_Alloy( cAlloy2, ThisFormSet.nConnHandle)
			ENDIF
		ENDIF
		
		***
		IF EMPTY(cBrandName) AND NOT EMPTY(tmpVendorStock.BrandName)
			*Reset cBrandName
			cBrandName = ALLTRIM(tmpVendorStock.BrandName)
		ENDIF
		*Remove ESR from BrandName
		IF NOT EMPTY(cBrandName)
			IF 'ESR' $  UPPER(cBrandName)
				cBrandName = STUFF( cBrandName, AT('ESR', cBrandName),3,'')
				cBrandName = ALLTRIM(cBrandName)
			ENDIF
		ENDIF
		*AND Remove Alloy from BrandName
		IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
			IF 'ALLOY' $  UPPER(cBrandName)
				cBrandName = STUFF( cBrandName, AT('ALLOY', cBrandName),5,'')
				cBrandName = ALLTRIM(cBrandName)
				
				IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
					cAlloy = GetHPA_Standard_Alloy( cBrandName, ThisFormSet.nConnHandle)
				ENDIF
				IF EMPTY(cAlloy) AND NOT EMPTY(cBrandName)
					*Try again with short BrandName
					cBrandName = ALLTRIM(cBrandName)
					
					cAlloy2 = LEFT(cBrandName,AT(' ',cBrandName)-1)  &&Remove all past first space
					cAlloy = GetHPA_Standard_Alloy( cAlloy2, ThisFormSet.nConnHandle)
				ENDIF
			ENDIF
		ENDIF
		***
		
		
		IF EMPTY(cBrandName) AND NOT EMPTY(tmpVendorStock.BrandName)
			*Reset cBrandName
			cBrandName = ALLTRIM(tmpVendorStock.BrandName)
		ENDIF
		
		***************************
		
		PRIVATE cAlloyStandard
		cAlloyStandard = GetAlloyStandard(cAlloy,ThisFormSet.nConnHandle)
		
		IF EMPTY(tmpVendorStock.CC) 
			cCC = 1
		ENDIF
		*IF UPPER(cMill) = "UNKNOWN"
		IF UPPER(cVendor) = "DIRECTALLOYS"
			DO CASE
			CASE UPPER(cCondition) = "FORGING"
				IF "DIA" $ UPPER(cThickness)
					cForm = '97'
					cThickness = LEFT(cThickness,AT("DIA",UPPER(cThickness))-2)
					cWidth = "0"
				ELSE
					IF "RCS" $ UPPER(cThickness)
						cForm = '98'
						cThickness = LEFT(cThickness,AT("RCS",UPPER(cThickness))-2)
						cWidth = "0"
					ELSE
						IF "BILLET" $ UPPER(cThickness)
							cForm = '97'
							cThickness = LEFT(cThickness,AT("BILLET",UPPER(cThickness))-2)
							cWidth = "0"
						ELSE
							IF "INGOT" $ UPPER(cThickness)
								cForm = '99'
								cThickness = LEFT(cThickness,AT("INGOT",UPPER(cThickness))-2)
								cWidth = "0"
							ENDIF
						ENDIF
					ENDIF
				ENDIF
						
			CASE UPPER(cCondition) = "MACHINING"
		
				IF "DIA" $ UPPER(cThickness)
					cForm = '10'
					cThickness = LEFT(cThickness,AT("DIA",UPPER(cThickness))-2)
					cWidth = "0"
				ELSE
					IF "FLAT BAR" $ UPPER(cThickness)
						cForm = '11'
						cWidth = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([X],UPPER(tmpVendorStock.Thickness))-1)
						cThickness = LEFT(cThickness,AT("FLAT BAR",UPPER(cThickness))-1)
					ELSE
						IF "SQUARE" $ UPPER(cThickness) OR " SQ" $ UPPER(cThickness)
							cForm = '13'
							cThickness = LEFT(cThickness,AT("SQ",UPPER(cThickness))-2)
							cWidth	= "0"
						ELSE
							IF "HEX" $ UPPER(cThickness)
								cForm = '12'
								cThickness = LEFT(cThickness,AT("HEX",UPPER(cThickness))-2)
								cWidth	= "0"
							ELSE
								IF "OD" $ UPPER(cThickness)
									cForm = '60'
									cThickness = LEFT(cThickness,AT("OD",UPPER(cThickness))-2)
									cWidth = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([OD],UPPER(tmpVendorStock.Thickness))-3)
								ELSE
									IF "SCH" $ UPPER(cThickness)
										cForm = '65'
										cThickness = LEFT(cThickness,AT("SCH",UPPER(cThickness))-3)
										cWidth = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([SCH],UPPER(tmpVendorStock.Thickness))-4)
									ELSE
										IF OCCURS(cThickness,["]) = 1
											cForm = '10'
											cThickness = LEFT(cThickness,AT(["],UPPER(cThickness))-2)
											cWidth	= "0"
										ELSE
											cForm = '11'
											cWidth = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([X],UPPER(tmpVendorStock.Thickness))-1)
											cThickness = LEFT(cThickness,AT(["],UPPER(cThickness))-2)
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			CASE UPPER(cCondition) = "PLATE"
				cForm = "40"
				cWidth = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([X],UPPER(tmpVendorStock.Thickness))-1)
				cThickness = RIGHT(cThickness,AT(["],UPPER(cThickness))-1)
			CASE UPPER(cCondition) = "SHEET"
				cForm = "40"
				cWidth = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([X],UPPER(tmpVendorStock.Thickness))-1)
				cThickness = RIGHT(cThickness,AT(["],UPPER(cThickness))-1)
			ENDCASE
			
		ENDIF
		**************************************************
		ThisFormSet.frmVendorImport.ALLOY1.FORECOLOR = RGB(0,0,0)
		IF EMPTY(cAlloyStandard)
			cAlloyStandard = cAlloy
			ThisFormSet.frmVendorImport.ALLOY1.FORECOLOR = RGB(255,0,0)
		ENDIF
		ThisFormSet.frmVendorImport.txtAll.Value 	= cAlloy+cThickness+cWidth+cLength+cPCS+cWeight+cVendor+cCondition
		ThisFormSet.frmVendorImport.ALLOY1.Value	= cAlloyStandard
		
		IF VAL(ALLTRIM(cForm)) = 0
			DO CASE
			CASE "RND" $ UPPER(ALLTRIM(cForm)) 
				cForm = "10"
			CASE "FLAT BAR" $ UPPER(ALLTRIM(cForm))
				cForm = "11"
			CASE "HEX" $ UPPER(ALLTRIM(cForm))
				cForm = "12"
			CASE "SQUARE" $ UPPER(ALLTRIM(cForm))
				cForm = "13"
			CASE "SQR" $ UPPER(ALLTRIM(cForm))
				cForm = "13"
			CASE "WIRE" $ UPPER(ALLTRIM(cForm)) 
				cForm = "20"
			CASE "PLATE" $ UPPER(ALLTRIM(cForm)) 
				cForm = "40"
			CASE "SHEET" $ UPPER(ALLTRIM(cForm)) 
				cForm = "40"
			CASE "STRIP" $ UPPER(ALLTRIM(cForm)) 
				cForm = "51"
			CASE "TUBE" $ UPPER(ALLTRIM(cForm)) 
				cForm = "60"
			CASE "PIPE" $ UPPER(ALLTRIM(cForm)) 
				cForm = "65"
			CASE "NIP" $ UPPER(ALLTRIM(cForm))
				cForm = "66"
			CASE "ELB" $ UPPER(ALLTRIM(cForm)) 
				cForm = "67"
			CASE "TEE" $ UPPER(ALLTRIM(cForm)) 
				cForm = "68"
			CASE "RED" $ UPPER(ALLTRIM(cForm)) 
				cForm = "69"
			CASE "FIT" $ UPPER(ALLTRIM(cForm)) 
				cForm = "70"
			CASE "FLANGE" $ UPPER(ALLTRIM(cForm)) 
				cForm = "72"
			CASE "FLNG" $ UPPER(ALLTRIM(cForm)) 
				cForm = "72"
			CASE "FASTEN" $ UPPER(ALLTRIM(cForm)) 
				cForm = "75"
			CASE "FORGE" $ UPPER(ALLTRIM(cForm)) 
				cForm = "95"
			CASE "SLAB" $ UPPER(ALLTRIM(cForm)) 
				cForm = "96"
			CASE "BILLET" $ UPPER(ALLTRIM(cForm)) 
				cForm = "98"
			CASE "RCS" $ UPPER(ALLTRIM(cForm)) 
				cForm = "98"
			CASE "INGOT" $ UPPER(ALLTRIM(cForm)) 
				cForm = "99"
			OTHERWISE
			****
				DO CASE
				CASE "FORGING STOCK" $ UPPER(cSpecs)
					cForm  = '95'
				CASE "BILLET" $ UPPER(cSpecs)
					cForm  = '97'
				CASE "RCS " $ UPPER(cSpecs)
					cForm  = '98'
				CASE "INGOT" $ UPPER(cSpecs)
					cForm  = '99'
				ENDCASE
			***
			ENDCASE
		ENDIF
		ThisFormSet.frmVendorImport.cmbForm.Value	= cForm
		
		*****************************************
		**check Weight
		PRIVATE nCalcLBS 
		nCalcLBS = 0
		
		nPieces = VAL(cPCS)
		nThck	= VAL(cThickness)
		nSz2	= VAL(cWidth)
		nSz3	= VAL(cLength)
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",''"	&&cCL
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'Thck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'Sz3',12,3),9,3)
		cSQL = cSQL + ",0"	&&+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		cSQL = cSQL + ",''" &&CustID
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			
			PRIVATE cMess
			cMess = "Could not get the Price!"+CHR(13)
			IF nPieces > 10000
				cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
			ENDIF
			IF nThck > 16
				cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
			ENDIF
			IF nSz2	> 120
				cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
			ENDIF
			IF nSz3	 > 300
				cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
			ENDIF
			MESSAGEBOX(cMess,16,"Edit your input numbers")
			
		ENDIF
		
		IF USED('tmpPriceTbl')
			IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
				IF tmpPriceTbl.Pounds > 0
					nCalcLBS = PrepareSQLnum(tmpPriceTbl.Pounds,'Pounds',8,1)
					
					IF VAL(cWeight)-1 < nCalcLBS 
						cWeight = STR(nCalcLBS)
					ENDIF
				ENDIF
			ENDIF
			USE IN tmpPriceTbl
		ENDIF
		
		*******************
		
		
		ThisFormSet.frmVendorImport.cmbCC.Value		= cCC
		SET DECIMALS TO 0
		ThisFormSet.frmVendorImport.Pieces1.Value	= VAL(cPCS)
		SET DECIMALS TO 3
		ThisFormSet.frmVendorImport.Thck1.Value		= VAL(cThickness)
		ThisFormSet.frmVendorImport.SZ21.Value		= VAL(cWidth)
		ThisFormSet.frmVendorImport.SZ31.Value		= VAL(cLength)
		SET DECIMALS TO 3
		ThisFormSet.frmVendorImport.Weight1.Value	= VAL(cWeight)
		ThisFormSet.frmVendorImport.txtSpecs.Value	= STRTRAN(cSpecs,[""],["])
		ThisFormSet.frmVendorImport.txtMelt.Value	= cMelt
		ThisFormSet.frmVendorImport.txtHeat.Value	= cHeat
		IF EMPTY(cCondition)
			IF ThisFormSet.ExcessStock
				ThisFormSet.frmVendorImport.txtCond.Value	= 'Excess Stock'  
				*Leave Condition as is,  Write 'Excess Stock' as condition on first entry.
			ELSE
				ThisFormSet.frmVendorImport.txtCond.Value	= 'Vendor Stock'
			ENDIF
		ELSE
			ThisFormSet.frmVendorImport.txtCond.Value	= STRTRAN(cCondition,[""],["])
		ENDIF
		ThisFormSet.frmVendorImport.txtDescript.Value= STRTRAN(tmpVendorStock.Thickness,[""],["])
		ThisFormSet.frmVendorImport.txtBrandName.Value= cBrandName
		ThisFormSet.frmVendorImport.txtVendor.Value	= cVendor
		ThisFormSet.frmVendorImport.txtMill.Value	= cMill
		SET DECIMALS TO nDecimals
		
		ThisFormSet.frmVendorImport.lblWEIGHT1.Click
		ThisFormSet.frmVendorImport.txtRecNum.Value = ALLTRIM(STR(RECNO('tmpVendorStock')))+"/"+ALLTRIM(STR(RECCOUNT('tmpVendorStock')))
		
		***
		IF NOT EMPTY(cForm)
			IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
				IF USED('tmpFormCaptions')
					*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
					ThisFormSet.frmVendorImport.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisFormSet.frmVendorImport.LBLSZ21.Caption = RTRIM(tmpFormCaptions.txt2)
					ThisFormSet.frmVendorImport.LBLSZ31.Caption = RTRIM(tmpFormCaptions.txt3)
					ThisFormSet.frmVendorImport.lblSZ31.Visible = tmpFormCaptions.lblSz3Vis
					ThisFormSet.frmVendorImport.LBLSZ41.Visible	= tmpFormCaptions.use3rdDim
					ThisFormSet.frmVendorImport.LBLSZ41.Caption = RTRIM(tmpFormCaptions.txt4)
					USE IN tmpFormCaptions
				ENDIF
			ENDIF
		ENDIF
		
		*************************************
		*Fix length
		ThisFormSet.GetLength("VendorImport")
		
		SELECT tmpVendorStock
		
		SKIP IN 'tmpVendorStock'
		
		ThisFormSet.frmVendorImport.Top = 0
		ThisFormSet.frmVendorImport.Left = 152
		ThisFormSet.frmVendorImport.Visible = .T.
		*	USE IN tmpVendorStock
		
		**************
		*Hilite Empties
		IF EMPTY(ThisFormSet.frmVendorImport.Alloy1.Value)
			ThisFormSet.frmVendorImport.Alloy1.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.Alloy1.BackColor = RGB(255,255,255)
		ENDIF
		IF EMPTY(ThisFormSet.frmVendorImport.cmbForm.Value)
			ThisFormSet.frmVendorImport.cmbForm.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.cmbForm.BackColor = RGB(255,255,255)
		ENDIF
		IF EMPTY(ThisFormSet.frmVendorImport.cmbCC.Value)
			ThisFormSet.frmVendorImport.cmbCC.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.cmbCC.BackColor = RGB(255,255,255)
		ENDIF
		IF EMPTY(ThisFormSet.frmVendorImport.Pieces1.Value)
			ThisFormSet.frmVendorImport.Pieces1.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.Pieces1.BackColor = RGB(255,255,255)
		ENDIF
		IF EMPTY(ThisFormSet.frmVendorImport.Thck1.Value)
			ThisFormSet.frmVendorImport.Thck1.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.Thck1.BackColor = RGB(255,255,255)
		ENDIF
		IF EMPTY(ThisFormSet.frmVendorImport.SZ21.Value)
			ThisFormSet.frmVendorImport.SZ21.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.SZ21.BackColor = RGB(255,255,255)
		ENDIF
		
		IF ThisFormSet.frmVendorImport.LBLSZ41.Visible
			*Use 3rd Dim
			IF EMPTY(ThisFormSet.frmVendorImport.SZ31.Value)
				ThisFormSet.frmVendorImport.SZ31.BackColor = RGB(255,255,128)
				ThisFormset.SaveAll = .F.
			ELSE
				ThisFormSet.frmVendorImport.SZ31.BackColor = RGB(255,255,255)
			ENDIF
		ELSE
			ThisFormSet.frmVendorImport.SZ31.BackColor = RGB(255,255,255)
		ENDIF
			
		IF EMPTY(ThisFormSet.frmVendorImport.Weight1.Value)
			ThisFormSet.frmVendorImport.Weight1.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.Weight1.BackColor = RGB(255,255,255)
		ENDIF
		*IF EMPTY(ThisFormSet.frmVendorImport.txtSpecs.Value,'Specs',160)
		*IF EMPTY(ThisFormSet.frmVendorImport.txtHeat.Value,'Heat',50)
		*IF EMPTY(ThisFormSet.frmVendorImport.txtCond.Value,'Cond',50)
		*IF EMPTY(ThisFormSet.frmVendorImport.txtDescript.Value,'Descript',20)
		*IF EMPTY(ThisFormSet.frmVendorImport.txtBrandName.Value,'BrandName',20,.F.,.T.)
		IF EMPTY(ThisFormSet.frmVendorImport.txtVendor.Value)
			ThisFormSet.frmVendorImport.txtVendor.BackColor = RGB(255,255,128)
			ThisFormset.SaveAll = .F.
		ELSE
			ThisFormSet.frmVendorImport.txtVendor.BackColor = RGB(255,255,255)
		ENDIF
		*IF EMPTY(ThisFormSet.frmVendorImport.txtMill.Value,'Mill',10)
		*IF EMPTY(ThisFormSet.frmVendorImport.txtRemoveDate.Value,'RemoveDate')
	ENDPROC

	PROCEDURE getimporthelp
		*getImportHelp()
		ThisFormSet.frmImportHelp.Visible = .T.
		
		PRIVATE cEdit1,cEdit2,cEdit3,cEdit4,cEdit5,cEdit6
		cEdit1 = '' &&RSI
		cEdit1 = "FileName:" + CHR(13)
		cEdit1 = cEdit1 + "RSI - BILLET STOCK LIST *.CSV " + CHR(13)
		cEdit1 = cEdit1 + "Open PDF Copy selected text, past in Excel Save as TXT"
		cEdit1 = cEdit1 + "Remove ',' in LBS!" + CHR(13)
		cEdit1 = cEdit1 + "then save as CSV" + CHR(13)
		cEdit1 = cEdit1 + CHR(13)
		
		cEdit2 = '' &&Crucible
		cEdit2 = "FileName:" + CHR(13)
		cEdit2 = cEdit2 + "Crucible *.txt" + CHR(13)
		cEdit2 = cEdit2 + CHR(13)
		
		cEdit3 = '' &&Electralloy
		cEdit3 = "FileName:"+ CHR(13)
		cEdit3 = cEdit3 + "ELECTRALLOY + " + CHR(13)
		cEdit3 = cEdit3 + "STAINLESS or NICKEL *.CSV" + CHR(13)
		cEdit3 = cEdit3 + "Nickel now has PCs"+CHR(13)
		cEdit3 = cEdit3 + "Remove comma from Pounds!"+ CHR(13)
		cEdit3 = cEdit3 + "Unknown Alloy will Corrupt input!"
		
		cEdit4 = '' &&Special Metals
		cEdit4 = "FileName:" + CHR(13)
		cEdit4 = cEdit4 + "Special Metals *.CSV" + CHR(13)
		cEdit4 = cEdit4 + CHR(13)
		cEdit4 = cEdit4 + "Alloy C(20)" + CHR(13)
		cEdit4 = cEdit4 + "[Dia] C(10)" + CHR(13)
		cEdit4 = cEdit4 + "[TOL] C(20)" + CHR(13)
		cEdit4 = cEdit4 + "LOT C(30)" + CHR(13)
		cEdit4 = cEdit4 + "[REFORGE] C(10)" + CHR(13)
		cEdit4 = cEdit4 + "SPEC C(40)" + CHR(13)
		cEdit4 = cEdit4 + "lengthIn C(10)" + CHR(13)
		cEdit4 = cEdit4 + "LengthFt C(10)" + CHR(13)
		cEdit4 = cEdit4 + "Weight C(10)" + CHR(13)
		
		cEdit5 = '' &&Zapp
		cEdit5 = "FileName:" + CHR(13)
		cEdit5 = cEdit5 + "ZAPP *.CSV" + CHR(13)
		cEdit5 = cEdit5 + CHR(13)
		cEdit5 = cEdit5 + "Alloy C(20)" + CHR(13)
		cEdit5 = cEdit5 + "[Form] C(10)" + CHR(13)
		cEdit5 = cEdit5 + "[Dia] C(10)" + CHR(13)
		cEdit5 = cEdit5 + "LBS C(10)" + CHR(13)
		
		cEdit6 = '' &&Dunkirk DSS
		cEdit5 = cEdit5 + "DSS *.CSV" + CHR(13)
		cEdit6 = "FileName:" + CHR(13)
		
		
		ThisFormSet.frmImportHelp.Edit1.Value = cEdit1
		ThisFormSet.frmImportHelp.Edit2.Value = cEdit2
		ThisFormSet.frmImportHelp.Edit3.Value = cEdit3
		ThisFormSet.frmImportHelp.Edit4.Value = cEdit4
		ThisFormSet.frmImportHelp.Edit5.Value = cEdit5
		ThisFormSet.frmImportHelp.Edit6.Value = cEdit6
	ENDPROC

	PROCEDURE getlength
		PARAMETERS pFrm
		*ThisFormSet.GetLength("VendorImport")
		IF VARTYPE(pFrm) != "C"
			RETURN
		ENDIF
		
		PRIVATE cAlloy,cForm,cCC,cCL,nPieces,nThck,nSz2,nSz3,nForceBracket,nWeight 
		IF pFrm = "VendorImport"
		
			cAlloy = PrepareSQLtxt(ThisFormset.frmVendorImport.ALLOY1.Value,'Alloy',12,.F.,.T.)
			cForm	= PrepareSQLtxt(ThisFormset.frmVendorImport.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmVendorImport.cmbCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmVendorImport.cmbCL.Value,'CL',1)
			nPieces	= PrepareSQLnum(ThisFormset.frmVendorImport.Pieces1.Value,'Pieces',-3)
			nThck	= PrepareSQLnum(ThisFormset.frmVendorImport.Thck1.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmVendorImport.Sz21.Value,'Sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmVendorImport.Sz31.Value,'Sz3',9,3)
			nForceBracket = .F.
			nWeight = PrepareSQLnum(ThisFormset.frmVendorImport.Weight1.Value,'weight',7,1)
		ENDIF
		
		IF nPieces = 0
			nPieces = 1
		ENDIF
		
		IF EMPTY(cAlloy)
			RETURN
		ENDIF
		
		IF EMPTY(cForm)
			MESSAGEBOX("Please check the form."+CHR(13)+"Defaulted form to '10'.",0,"No form")
			cForm = '10'
			IF pFrm = "VendorImport"
				ThisFormset.frmVendorImport.cmbForm.Value = '10'
			ENDIF
		ENDIF
		
		PRIVATE lUse3rdDim
		lUse3rdDim = Uses3rdDim( cForm )
		
		IF NOT lUse3rdDim AND EMPTY(nSz2) AND NOT EMPTY(nSz3)
			*nSZ2 was listed as Width and nSz3 was listed as Length
			*Since there is no need for nSz3, move the nSz3 number to nSz2
			nSz2 = nSz3
			nSz3 = 0
			ThisFormset.frmVendorImport.Sz21.Value = nSz2
		ENDIF
		
		PRIVATE nXnumber
		nXnumber = OCCURS([X],UPPER(tmpVendorStock.Thickness))
		IF "HEX" $ UPPER(tmpVendorStock.Thickness)
			nXnumber =  nXnumber - 1
		ENDIF
		IF EMPTY(nSz2)
			IF nXnumber > 0
				cWidth = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([X],UPPER(tmpVendorStock.Thickness))-1)
				nSz2	= PrepareSQLnum(cWidth,'Sz2',9,3)
				IF nSz2 > 0
					IF pFrm = "VendorImport"
						ThisFormset.frmVendorImport.Sz21.Value = nSz2
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		IF ThisFormSet.frmVendorImport.SZ31.Visible 
			IF EMPTY(nSz3)
				IF nXnumber > 1
					cLength = RIGHT(tmpVendorStock.Thickness,LEN(tmpVendorStock.Thickness)-AT([X],UPPER(tmpVendorStock.Thickness),2)-1)
					nSz3	= PrepareSQLnum(cLength ,'Sz3',9,3)
					IF nSz3 > 0
						IF pFrm = "VendorImport"
							ThisFormset.frmVendorImport.Sz31.Value = nSz3
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		***********************
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		*******************************************************************************
		IF NOT luse3rdDim AND nThck > 0 AND nSz2 = 0 AND nWeight > 0
			
			*Find Length
			nSz2 = 100
			
			
			PRIVATE cSQL
			cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
			cSQL = cSQL + STR(nPieces)
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
			cSQL = cSQL + ",''" &&CustID
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
				
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				IF nPieces > 10000
					cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
				ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
				
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
					IF tmpPriceTbl.Pounds > 0
						nSz2 = nWeight  / tmpPriceTbl.Pounds * 100
						IF pFrm = "VendorImport"
							ThisFormset.frmVendorImport.Sz21.Value = nSz2
							ThisFormset.frmVendorImport.Sz21.Refresh
						ENDIF
					ENDIF
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
		ENDIF
		
		
		*******************************************************************************
		IF luse3rdDim AND nThck > 0 AND nSz2 > 0 AND nSz3 = 0 AND nWeight > 0
			
			*Find Length
			nSz3 = 100
			
			PRIVATE cSQL
			cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
			cSQL = cSQL + STR(nPieces)
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
			cSQL = cSQL + ",''" &&CustID
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				IF nPieces > 10000
					cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
				ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
				
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
					IF tmpPriceTbl.Pounds > 0
						nSz3 = nWeight  / tmpPriceTbl.Pounds * 100
						SELECT tmpVendorStock
						REPLACE tmpVendorStock.Length WITH STR(nSz3,10,2)
						IF pFrm = "VendorImport"
							ThisFormSet.frmVendorImport.Sz31.Value = VAL( STR(nSz3,10,2) )
							ThisFormSet.frmVendorImport.Sz31.Refresh
							ThisFormSet.frmVendorImport.Pieces1.Value = nPieces
						ENDIF
					ENDIF
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
		ENDIF
		*******************************************************
		
		*Double check PC
		**************************************
		nPieces	= PrepareSQLnum(ThisFormset.frmVendorImport.Pieces1.Value,'Pieces',-3)
		IF nPieces = 0 
			IF (!luse3rdDim AND nThck > 0 AND nSz2 > 0 AND nWeight > 0 ) OR (luse3rdDim AND nThck > 0 AND nSz2 > 0 AND nSz3 > 0 AND nWeight > 0)
				*recalc PCs
		
				PRIVATE cSQL
				cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
				cSQL = cSQL + "1"  &&nPieces
				cSQL = cSQL + ",'"+cAlloy+"'"
				cSQL = cSQL + ",'"+cForm+"'"
				cSQL = cSQL + ",'"+cCC+"'"
				cSQL = cSQL + ",'"+cCL+"'"
				cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
				cSQL = cSQL + ",''" &&CustID
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
					
					PRIVATE cMess
					cMess = "Could not get the Price!"+CHR(13)
					IF nPieces > 10000
						cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
					ENDIF
					IF nThck > 16
						cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
					ENDIF
					IF nSz2	> 120
						cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
					ENDIF
					IF nSz3	 > 300
						cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
					ENDIF
					MESSAGEBOX(cMess,16,"Edit your input numbers")
					
				ENDIF
		
				IF USED('tmpPriceTbl')
					IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
						IF tmpPriceTbl.Pounds > 0
							nPieces = ROUND(nWeight  / tmpPriceTbl.Pounds ,0)
							SELECT tmpVendorStock
							REPLACE tmpVendorStock.PCS WITH STR(nPieces)
							IF pFrm = "VendorImport"
								ThisFormSet.frmVendorImport.Pieces1.Value = nPieces
							ENDIF
						ENDIF
					ENDIF
					USE IN tmpPriceTbl
				ENDIF
		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE getstocklst_mins
		*ThisFormSet.GetStockLst_Mins()
		
		IF USED("StockLst_Mins")
			SELECT StockLst_Mins
		ELSE
			SELECT 0
		ENDIF
		
		ThisFormSet.frmStockListMins.grdStockLst.RecordSource=""
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT Alloy,Form,CC,Thck,Sz2,SafeLevel"
		cSQL = cSQL + ",MillWeeks,Active,Crutial"
		cSQL = cSQL + ",QUsage,PrevQUsage,YUsage,PrevYUsage"
		cSQL = cSQL + ",LastEdit,SafeLevelDate,ID"
		*cSQL = cSQL + ",dbo.f_Report_1yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr1Sales]"
		*cSQL = cSQL + ",dbo.f_Report_3yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr3Sales]"
		*cSQL = cSQL + ",dbo.f_Report_CurrStock(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [CurrStock]"
		*cSQL = cSQL + ",dbo.f_Report_1YrStock (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [AvgStock]"
		*cSQL = cSQL + ",dbo.f_Report_1YrBroker(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [Broker]"
		*cSQL = cSQL + ",dbo.f_Report_StockDue (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [StockDue]"
		cSQL = cSQL + " FROM dbo.StockLst_Mins "
		cSQL = cSQL + " ORDER BY Alloy,Form,CC,Thck,Sz2 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Mins')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Mins')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Mins")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Mins")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Mins')
		ELSE
			SELECT StockLst_Mins
			IF RECCOUNT('StockLst_Mins') > 0
				
				ThisFormSet.frmStockListMins.grdStockLst.RecordSource="StockLst_Mins"
				
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshStockLst_Mins()
	ENDPROC

	PROCEDURE getstocklst_review
		*ThisFormSet.GetStockLst_Review()
		
		PRIVATE cAlloy
		cAlloy = ThisFormSet.frmStockReviewSort.txtFilterAlloy.Value
		
		IF USED("StockLst_Review")
			SELECT StockLst_Review
		ELSE
			SELECT 0
		ENDIF
		
		ThisFormSet.frmStockReview.grdStockLst.RecordSource=""
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT Alloy,Form,CC,Thck,Sz2,SafeLevel"
		cSQL = cSQL + ",MillWeeks,Active,Crutial"
		cSQL = cSQL + ",QUsage,PrevQUsage,YUsage,PrevYUsage"
		cSQL = cSQL + ",LastEdit,SafeLevelDate,ID"
		cSQL = cSQL + ",dbo.f_Report_1yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr1Sales]"
		cSQL = cSQL + ",dbo.f_Report_3yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr3Sales]"
		cSQL = cSQL + ",dbo.f_Report_CurrStock(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [CurrStock]"
		cSQL = cSQL + ",dbo.f_Report_1YrStock (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [AvgStock]"
		cSQL = cSQL + ",dbo.f_Report_1YrBroker(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [Broker]"
		cSQL = cSQL + ",dbo.f_Report_StockDue (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [StockDue]"
		cSQL = cSQL + " FROM dbo.StockLst_Mins "
		cSQL = cSQL + " WHERE ALLOY = '"+cAlloy+"'"
		cSQL = cSQL + " ORDER BY Alloy,Form,CC,Thck,Sz2 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Review')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Review')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Review")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Review")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Review')
		ELSE
			SELECT StockLst_Review
			IF RECCOUNT('StockLst_Review') > 0
				
				ThisFormSet.frmStockReview.grdStockLst.RecordSource="StockLst_Review"
				ThisFormset.frmStockReview.grdStockLst.SetAll("DynamicBackColor", "ThisFormSet.Dynamic_BackColor_Review()", "Column") 
				ThisFormSet.RefreshStockLst_Review()
				ThisFormSet.frmStockReview.Visible = .T.
				
			ELSE
				ThisFormSet.frmStockReview.Visible = .F.
				MESSAGEBOX("No Records",0+16,"Alloy not Found!")
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE getstocklst_safelevel
		PARAMETERS pAlloy
		*ThisFormSet.GetStockLst_SafeLevel()
		IF VARTYPE(pAlloy) != 'C'
			pAlloy = ''
		ENDIF
		
		IF USED("StockLst_SafeLevel")
			SELECT StockLst_SafeLevel
		ELSE
			SELECT 0
		ENDIF
		
		ThisFormSet.frmSafeLevel.grdStockLst.RecordSource=""
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT Alloy,Form,CC,Thck,Sz2,SafeLevel"
		cSQL = cSQL + ",MillWeeks,Active,Crutial"
		cSQL = cSQL + ",QUsage,PrevQUsage,YUsage,PrevYUsage"
		cSQL = cSQL + ",LastEdit,SafeLevelDate,ID"
		*cSQL = cSQL + ",dbo.f_Report_1yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr1Sales]"
		*cSQL = cSQL + ",dbo.f_Report_3yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr3Sales]"
		*cSQL = cSQL + ",dbo.f_Report_CurrStock(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [CurrStock]"
		*cSQL = cSQL + ",dbo.f_Report_1YrStock (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [AvgStock]"
		*cSQL = cSQL + ",dbo.f_Report_1YrBroker(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [Broker]"
		*cSQL = cSQL + ",dbo.f_Report_StockDue (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [StockDue]"
		cSQL = cSQL + " FROM dbo.StockLst_Mins "
		IF NOT EMPTY(pAlloy)
			cSQL = cSQL + " WHERE ALLOY = '"+pAlloy+"'"
		ENDIF
		cSQL = cSQL + " ORDER BY Alloy,Form,CC,Thck,Sz2 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_SafeLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_SafeLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_SafeLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_SafeLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_SafeLevel')
		ELSE
			SELECT StockLst_SafeLevel
			IF RECCOUNT('StockLst_SafeLevel') > 0
				
				ThisFormSet.frmSafeLevel.grdStockLst.RecordSource="StockLst_SafeLevel"
				
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshStockLst_SafeLevel()
	ENDPROC

