	PROCEDURE frmStockListMins.cmdDelete.Click
		IF THIS.Caption = "Delete"
			*Delete
			This.Parent.cmdNew.Enabled = .T.
			This.parent.cmdEdit.Enabled = .T.
			
			PRIVATE nStockLst_ID, cAlloy, cForm, cCC, nThck, cDescr
			nStockLst_ID = This.parent.StockLst_ID.Value
			cAlloy	= This.Parent.AlLOY1.Value
			cForm	= This.Parent.cmbForm.Value
			cCC		= This.Parent.cmbCC.Value
			nThck	= This.Parent.Thck1.Value
			cDescr = ALLTRIM(cAlloy)+" "+cForm+" "+cCC+" "+ALLTRIM(STR(nThck,10,4))
			
			IF nStockLst_ID > 0
				IF MESSAGEBOX( "Are you sure you want to Delete ID:"+ALLTRIM(STR(nStockLst_ID))+"?"+CHR(13)+cDescr,4+64,"Delete (Y/N)") = 6
					
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "DELETE dbo.Stocklst_Mins WHERE ID ="+ALLTRIM(STR(nStockLst_ID))
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					ThisFormSet.GetStockLst_Mins()
								
					SELECT StockLst_Mins
					INDEX ON ID TAG ID
					SEEK nStockLst_ID
					GOTO RECNO(0)	
					ThisForm.grdStockLst.refresh
					ThisFormSet.RefreshStockLst_Mins()
					
				ENDIF
			ENDIF
		ELSE
		*Abort
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdEdit.Caption = "Edit"
			This.parent.cmdEdit.Enabled = .T.
			This.Caption = "Delete"
			ThisFormSet.IsEditingStockLst_Mins = .F.
			
			ThisFormSet.RefreshStockLst_Mins()
			
		ENDIF
	ENDPROC

	PROCEDURE frmStockListMins.cmdEdit.Click
		IF THIS.Caption = "Edit"
			This.Parent.cmdNew.Enabled = .F.
			This.Parent.cmdDelete.Caption = "Abort"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Save"
			ThisFormSet.IsEditingStockLst_Mins = .T.
		ELSE
			*Save
			
			PRIVATE nID, cAlloy, cForm, cCC, nThck, nSZ2
			PRIVATE nSafeLevel,nMillWeeks,lActive,lCrutial,nQUsage,nPrevQUsage,nYUsage,nPrevYUsage
			*,dLastEdit
		
			nID		= PrepareSQLnum(ThisForm.StockLst_ID.Value,'ID',-3)
			cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12,.F.,.T.)
			cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2,.F.,.T.)
			cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
			nThck	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
			nSZ2	= PrepareSQLnum(ThisForm.SZ21.Value,'Sz2',9,3)
			
			nSafeLevel	= PrepareSQLnum(ThisForm.txtSafeLevel.Value,'SafeLevel',-3)
			nMillWeeks	= PrepareSQLnum(ThisForm.txtMillWeeks.Value,'MillWeeks',-3)
			lActive		= PrepareSQLchk(ThisForm.chkActive.Value,'Active',-3)
			lCrutial	= PrepareSQLchk(ThisForm.chkCrutial.Value,'Crutial',-3)
		
			nQUsage		= PrepareSQLnum(ThisForm.txtQUsage.Value,'QUsage',-3)
			nPrevQUsage	= PrepareSQLnum(ThisForm.txtPrevQUsage.Value,'PrevQUsage',-3)
			nYUsage 	= PrepareSQLnum(ThisForm.txtYUsage.Value,'YUsage',-3)
			nPrevYUsage	= PrepareSQLnum(ThisForm.txtPrevYUsage.Value,'PrevYUsage',-3)
			*ThisForm.txtAddDate.Value
			
			PRIVATE cSQL, nSQLEXEC
			IF nID = 0
				*INSERT
				cSQL = "INSERT INTO dbo.StockLst_Mins "
				cSQL = cSQL+"( Alloy,Form,CC,Thck,SZ2"
				cSQL = cSQL+",SafeLevel,MillWeeks, Active, Crutial )"
				cSQL = cSQL+" VALUES ("
				cSQL = cSQL+"'"+cAlloy+"'"
				cSQL = cSQL+",'"+cForm+"'"
				cSQL = cSQL+",'"+cCC+"'"
				cSQL = cSQL+","+STR(nThck,10,4)+""
				cSQL = cSQL+","+STR(nSZ2,9,3)+""
		
				cSQL = cSQL+","+STR(nSafeLevel)+""
				cSQL = cSQL+","+STR(nMillWeeks)+""
		
				cSQL = cSQL+",'"+IIF(lActive,'1','0')+"'"
				cSQL = cSQL+",'"+IIF(lCrutial,'1','0')+"'"
				cSQL = cSQL+")"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Mins()
					GO BOTTOM IN 'StockLst_Mins'
					ThisFormSet.RefreshStockLst_Mins()
				ENDIF
		
			ELSE
				*UPDATE
				cSQL = "UPDATE dbo.StockLst_Mins "
				cSQL = cSQL+" SET "
				cSQL = cSQL+" Alloy='"+cAlloy+"'"
				cSQL = cSQL+",Form='"+cForm+"'"
				cSQL = cSQL+",CC='"+cCC+"'"
				cSQL = cSQL+",Dim1="+STR(nThck,10,4)+""
				cSQL = cSQL+",SZ2="+STR(nSZ2,9,3)+""
				
				cSQL = cSQL+",SafeLevel="+STR(nSafeLevel)+""
				cSQL = cSQL+",MillWeeks="+STR(nMillWeeks)+""
				cSQL = cSQL+",Active='"+IIF(lActive,'1','0')+"'"
				cSQL = cSQL+",Crutial='"+IIF(lCrutial,'1','0')+"'"
				cSQL = cSQL+" WHERE ID = "+STR(nID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Mins()
					SELECT 'StockLst_Mins'
					INDEX ON ID TAG ID
					LOCATE FOR ID = nID
					ThisForm.grdStockLst.SetFocus()
					ThisFormSet.RefreshStockLst_Mins()
				ENDIF
				
			ENDIF
			
			
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdDelete.Caption = "Delete"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Edit"
			ThisFormSet.IsEditingStockLst_Mins = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmStockListMins.cmdHide.Click
