	ENDPROC

	PROCEDURE refreshstocklst_safelevel
		*ThisFormSet.RefreshStockLst_SafeLevel()
		IF USED('StockLst_SafeLevel')
			PRIVATE nMillWeeks, nQtrUse, nPrevQtrUse, nYearUse, nPrevYearUse, nCalcQtr, nCalcYear, nCalcAll
			nMillWeeks	= PrepareSQLnum(StockLst_SafeLevel.MillWeeks,'MillWeeks',-2)
			nQtrUse		= PrepareSQLnum(StockLst_SafeLevel.QUsage,'QUsage',-3)
			nPrevQtrUse	= PrepareSQLnum(StockLst_SafeLevel.PrevQUsage,'PrevQUsage',-3)
			nYearUse	= PrepareSQLnum(StockLst_SafeLevel.YUsage,'YUsage',-3)
			nPrevYearUse= PrepareSQLnum(StockLst_SafeLevel.PrevYUsage,'PrevYUsage',-3)
		
			IF nMillWeeks = 0
				nMillWeeks = 12
			ENDIF
			nCalcQtr	= (nQtrUse + nPrevQtrUse)/2 * (13/nMillWeeks)
			nCalcYear	= (nYearUse + nPrevYearUse)/2 *(52/nMillWeeks)
			nCalcAll	= (nQtrUse*4 + nPrevQtrUse*4 + nYearUse + nPrevYearUse)/4 *(52/nMillWeeks)
		
		
			ThisFormSet.frmSafeLevel.StockLst_ID.Value	= StockLst_SafeLevel.ID
			ThisFormSet.frmSafeLevel.ALLOY1.Value		= StockLst_SafeLevel.Alloy
			ThisFormSet.frmSafeLevel.TxtFilterAlloy.Value	= StockLst_SafeLevel.Alloy
			ThisFormSet.frmSafeLevel.txtForm.Value		= StockLst_SafeLevel.Form
			ThisFormSet.frmSafeLevel.txtCC.Value		= StockLst_SafeLevel.CC
		
			ThisFormSet.frmSafeLevel.Thck1.Value		= StockLst_SafeLevel.thck
			ThisFormSet.frmSafeLevel.txtStndThck.Value	= getStandardSize(StockLst_SafeLevel.thck,ThisFormSet.nConnHandle)
			
			ThisFormSet.frmSafeLevel.Sz21.Value			= StockLst_SafeLevel.Sz2
			
			ThisFormSet.frmSafeLevel.txtSafeLevel.Value		= StockLst_SafeLevel.SafeLevel
			ThisFormSet.frmSafeLevel.txtMillWeeks.Value		= nMillWeeks 
			ThisFormSet.frmSafeLevel.chkActive.Value		= StockLst_SafeLevel.Active
			ThisFormSet.frmSafeLevel.chkCrutial.Value		= StockLst_SafeLevel.Crutial
			ThisFormSet.frmSafeLevel.txtQUsage.Value		= nQtrUse
			ThisFormSet.frmSafeLevel.txtPrevQUsage.Value	= nPrevQtrUse
			ThisFormSet.frmSafeLevel.txtCalcQtr.Value		= nCalcQtr
			ThisFormSet.frmSafeLevel.txtYUsage.Value		= nYearUse
			ThisFormSet.frmSafeLevel.txtPrevYUsage.Value	= nPrevYearUse
			ThisFormSet.frmSafeLevel.txtCalcYear.Value		= nCalcYear
			ThisFormSet.frmSafeLevel.txtCalcAll.Value		= nCalcAll
			ThisFormSet.frmSafeLevel.txtAddDate.Value		= StockLst_SafeLevel.LastEdit
			ThisFormSet.frmSafeLevel.txtSafeLevelDate.Value	= StockLst_SafeLevel.SafeLevelDate
		
			*****************************************
			ThisFormSet.frmSafeLevel.txtBroker.Value		= 0
			ThisFormSet.frmSafeLevel.txt3yrSales.Value		= 0
			ThisFormSet.frmSafeLevel.txt1Yrsales.Value		= 0
			ThisFormSet.frmSafeLevel.txtAvgStock.Value		= 0
			ThisFormSet.frmSafeLevel.txtCurrStock.Value		= 0
			ThisFormSet.frmSafeLevel.txtStockDue.Value		= 0
			
			IF USED("tmpHistory")
				SELECT tmpHistory
			ELSE
				SELECT 0
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT ID"
			cSQL = cSQL + ",dbo.f_Report_1yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr1Sales]"
			cSQL = cSQL + ",dbo.f_Report_3yrSales (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [yr3Sales]"
			cSQL = cSQL + ",dbo.f_Report_CurrStock(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [CurrStock]"
			cSQL = cSQL + ",dbo.f_Report_1YrStock (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [AvgStock]"
			cSQL = cSQL + ",dbo.f_Report_1YrBroker(Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [Broker]"
			cSQL = cSQL + ",dbo.f_Report_StockDue (Alloy,Form,CC, dbo.f_SizeStandard([thck]) ) AS [StockDue]"
			cSQL = cSQL + " FROM dbo.StockLst_Mins "
			cSQL = cSQL + " WHERE Alloy='"+StockLst_SafeLevel.Alloy+"'"
			cSQL = cSQL + " AND Form ='"+StockLst_SafeLevel.Form+"'"
			cSQL = cSQL + " AND CC ='"+StockLst_SafeLevel.CC+"'"
			cSQL = cSQL + " AND Thck="+STR(StockLst_SafeLevel.thck,11,4)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpHistory')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpHistory')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHistory")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHistory")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpHistory')
			ELSE
				SELECT tmpHistory
				IF RECCOUNT('tmpHistory') > 0	
					ThisFormSet.frmSafeLevel.txtBroker.Value		= PrepareSQLnum(tmpHistory.Broker,'Broker',-3)
					ThisFormSet.frmSafeLevel.txt3yrSales.Value		= PrepareSQLnum(tmpHistory.Yr3Sales,'Yr3Sales',-3)
					ThisFormSet.frmSafeLevel.txt1Yrsales.Value		= PrepareSQLnum(tmpHistory.Yr1Sales,'Yr1Sales',-3)
					ThisFormSet.frmSafeLevel.txtAvgStock.Value		= PrepareSQLnum(tmpHistory.AvgStock,'AvgStock',-3)
					ThisFormSet.frmSafeLevel.txtCurrStock.Value		= PrepareSQLnum(tmpHistory.CurrStock,'CurrStock',-3)
					ThisFormSet.frmSafeLevel.txtStockDue.Value		= PrepareSQLnum(tmpHistory.StockDue,'StockDue',-3)
				ENDIF
			ENDIF
			*****************************************
		ENDIF
			
		SELECT StockLst_SafeLevel
	ENDPROC

	PROCEDURE refreshstocklst_vendor
		*ThisFormSet.RefreshStockLst_Vendor()
		
		IF USED('StockLst_Vendor')
