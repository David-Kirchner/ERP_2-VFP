	PROCEDURE frmStockReviewSort.cmdRetrieveReview.Click
		ThisFormSet.GetStockLst_Review()
		
		PRIVATE cFilterAlloy,nStockLst_ID
		*!*	nStockLst_ID = ThisForm.stockLst_ID.Value
		
		cFilterAlloy = ThisForm.txtFilterAlloy.Value
		IF ThisForm.txtFilterAlloy.FORECOLOR != RGB(0,0,0)
			*Did not find Alloy
			cFilterAlloy = ''
		ENDIF
		
		IF EMPTY(cFilterAlloy)
			cFilterAlloy = ThisForm.Alloy1.Value
			ThisForm.txtFilterAlloy.Value = cFilterAlloy 
		ENDIF
		
		
		IF NOT EMPTY(cFilterAlloy )
			WAIT WINDOW "Please wait for Data..." NOWAIT
			
			ThisFormSet.GetStockLst_Review()
			ThisFormSet.SetStockLst_ReviewOrder()
		ENDIF
	ENDPROC

	PROCEDURE frmStockReviewSort.Command1.Click
		ThisFormSet.SetStockLst_ReviewOrder()
	ENDPROC

