			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = " "
		
		IF USED('ConditionLevel')
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CL
		
		
	ENDPROC

	PROCEDURE frmStockReview.cmbCL.When
		RETURN ThisFormSet.IsEditingStockLst_Mins 
	ENDPROC

	PROCEDURE frmStockReview.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE frmStockReview.cmbForm.Valid
		PRIVATE pForm
		pForm = This.Value
		
		IF NOT EMPTY(pForm)
			IF GetFormCaptions(pForm,ThisFormSet.nConnHandle)
				IF USED('tmpFormCaptions')
					*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
					ThisForm.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.LBLSZ21.Caption = RTRIM(tmpFormCaptions.txt2)
					ThisForm.LBLSZ31.Caption = RTRIM(tmpFormCaptions.txt3)
					ThisForm.LBLSZ31.Visible = tmpFormCaptions.lblSz3Vis
					ThisForm.LBLSZ41.Visible = tmpFormCaptions.use3rdDim
					ThisForm.LBLSZ41.Caption = RTRIM(tmpFormCaptions.txt4)
					USE IN tmpFormCaptions
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmStockReview.cmbForm.When
		RETURN ThisFormSet.IsEditingStockLst_Mins 
	ENDPROC

	PROCEDURE frmStockReview.cmdDelete.Click
		IF THIS.Caption = "Delete"
			*Delete
			This.Parent.cmdNew.Enabled = .T.
			This.parent.cmdEdit.Enabled = .T.
			
			PRIVATE nStockLst_ID, cAlloy, cForm, cCC, nThck, cDescr
			nStockLst_ID = This.parent.StockLst_ID.Value
			cAlloy	= This.Parent.AlLOY1.Value
			cForm	= This.Parent.cmbForm.Value
			cCC		= This.Parent.cmbCC.Value
			nThck	= This.Parent.Thck1.Value
			cDescr = ALLTRIM(cAlloy)+" "+cForm+" "+cCC+" "+ALLTRIM(STR(nThck,10,4))
			
			IF nStockLst_ID > 0
				IF MESSAGEBOX( "Are you sure you want to Delete ID:"+ALLTRIM(STR(nStockLst_ID))+"?"+CHR(13)+cDescr,4+64,"Delete (Y/N)") = 6
					
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "DELETE dbo.Stocklst_Mins WHERE ID ="+ALLTRIM(STR(nStockLst_ID))
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					ThisFormSet.GetStockLst_Mins()
								
					SELECT StockLst_Mins
					INDEX ON ID TAG ID
					SEEK nStockLst_ID
					GOTO RECNO(0)	
					ThisForm.grdStockLst.refresh
					ThisFormSet.RefreshStockLst_Mins()
					
				ENDIF
			ENDIF
		ELSE
		*Abort
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdEdit.Caption = "Edit"
			This.parent.cmdEdit.Enabled = .T.
			This.Caption = "Delete"
			ThisFormSet.IsEditingStockLst_Mins = .F.
			
			ThisFormSet.RefreshStockLst_Mins()
			
		ENDIF
	ENDPROC

	PROCEDURE frmStockReview.cmdEdit.Click
		IF THIS.Caption = "Edit"
			This.Parent.cmdNew.Enabled = .F.
			This.Parent.cmdDelete.Caption = "Abort"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Save"
			ThisFormSet.IsEditingStockLst_Mins = .T.
		ELSE
			*Save
			
			PRIVATE nID, cAlloy, cForm, cCC, nThck, nSZ2
			PRIVATE nSafeLevel,nMillWeeks,lActive,lCrutial,nQUsage,nPrevQUsage,nYUsage,nPrevYUsage
			*,dLastEdit
		
			nID		= PrepareSQLnum(ThisForm.StockLst_ID.Value,'ID',-3)
			cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12,.F.,.T.)
			cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
			nThck	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
			nSZ2	= PrepareSQLnum(ThisForm.SZ21.Value,'Sz2',9,3)
			
			nSafeLevel	= PrepareSQLnum(ThisForm.txtSafeLevel.Value,'SafeLevel',-3)
			nMillWeeks	= PrepareSQLnum(ThisForm.txtMillWeeks.Value,'MillWeeks',-3)
			lActive		= PrepareSQLchk(ThisForm.chkActive.Value,'Active',-3)
			lCrutial	= PrepareSQLchk(ThisForm.chkCrutial.Value,'Crutial',-3)
		
			nQUsage		= PrepareSQLnum(ThisForm.txtQUsage.Value,'QUsage',-3)
			nPrevQUsage	= PrepareSQLnum(ThisForm.txtPrevQUsage.Value,'PrevQUsage',-3)
			nYUsage 	= PrepareSQLnum(ThisForm.txtYUsage.Value,'YUsage',-3)
			nPrevYUsage	= PrepareSQLnum(ThisForm.txtPrevYUsage.Value,'PrevYUsage',-3)
			*ThisForm.txtAddDate.Value
			
			PRIVATE cSQL, nSQLEXEC
			IF nID = 0
				*INSERT
				cSQL = "INSERT INTO dbo.StockLst_Mins "
				cSQL = cSQL+"( Alloy,Form,CC,Thck,SZ2"
				cSQL = cSQL+",SafeLevel,MillWeeks, Active, Crutial )"
				cSQL = cSQL+" VALUES ("
				cSQL = cSQL+"'"+cAlloy+"'"
				cSQL = cSQL+",'"+cForm+"'"
				cSQL = cSQL+",'"+cCC+"'"
				cSQL = cSQL+","+STR(nThck,10,4)+""
				cSQL = cSQL+","+STR(nSZ2,9,3)+""
		
				cSQL = cSQL+","+STR(nSafeLevel)+""
				cSQL = cSQL+","+STR(nMillWeeks)+""
		
				cSQL = cSQL+",'"+IIF(lActive,'1','0')+"'"
				cSQL = cSQL+",'"+IIF(lCrutial,'1','0')+"'"
				cSQL = cSQL+")"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Mins()
					GO BOTTOM IN 'StockLst_Mins'
					ThisFormSet.RefreshStockLst_Mins()
				ENDIF
		
			ELSE
				*UPDATE
				cSQL = "UPDATE dbo.StockLst_Mins "
				cSQL = cSQL+" SET "
				cSQL = cSQL+" Alloy='"+cAlloy+"'"
				cSQL = cSQL+",Form='"+cForm+"'"
				cSQL = cSQL+",CC='"+cCC+"'"
				cSQL = cSQL+",Dim1="+STR(nThck,10,4)+""
				cSQL = cSQL+",SZ2="+STR(nSZ2,9,3)+""
				
				cSQL = cSQL+",SafeLevel="+STR(nSafeLevel)+""
				cSQL = cSQL+",MillWeeks="+STR(nMillWeeks)+""
				cSQL = cSQL+",Active='"+IIF(lActive,'1','0')+"'"
				cSQL = cSQL+",Crutial='"+IIF(lCrutial,'1','0')+"'"
				cSQL = cSQL+" WHERE ID = "+STR(nID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Mins()
					SELECT 'StockLst_Mins'
					INDEX ON ID TAG ID
					LOCATE FOR ID = nID
					ThisForm.grdStockLst.SetFocus()
					ThisFormSet.RefreshStockLst_Mins()
				ENDIF
				
			ENDIF
			
			
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdDelete.Caption = "Delete"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Edit"
			ThisFormSet.IsEditingStockLst_Mins = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmStockReview.cmdExport.Click
		IF USED('StockLst_Review')
			*REPORT FORM reports\StockReview TO PRINTER PROMPT PREVIEW 
			IF RECCOUNT('StockLst_Review') > 0
			
				*EXPORT TO (SYS(5)+SYS(2003)+"\PriceSheet.XLS") TYPE XLS
				EXPORT TO (SYS(5)+SYS(2003)+"\StockReview.DIF") TYPE DIF
				
				WAIT WINDOW 'Done' NOWAIT
			
				LOCAL loExcel
				loExcel = CREATEOBJECT("Excel.Application")
		*		loExcel.workbooks.open(SYS(5)+SYS(2003)+"\PriceSheet.XLS")
				loExcel.workbooks.open(SYS(5)+SYS(2003)+"\StockReview.DIF")
				loExcel.visible = .T.
				
			ELSE
				MESSAGEBOX("No records where found!",48,"Not found!")
			ENDIF
		ELSE
			MESSAGEBOX("No records where found!",48,"Not found!")
		ENDIF
		
	ENDPROC

