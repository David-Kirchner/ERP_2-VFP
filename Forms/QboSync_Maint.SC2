		Left = 104, ;
		Name = "cmdRetry", ;
		Top = 430, ;
		Width = 110
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdQueue' AS grid WITH ;
		ColumnCount = 6, ;
		DeleteMark = .F., ;
		Height = 340, ;
		Left = 12, ;
		Name = "grdQueue", ;
		RecordMark = .F., ;
		RecordSource = "", ;
		ScrollBars = 3, ;
		Top = 72, ;
		Width = 872, ;
		Column1.ControlSource = "", ;
		Column1.Name = "clmQueueId", ;
		Column1.ReadOnly = .T., ;
		Column1.Width = 70, ;
		Column2.ControlSource = "", ;
		Column2.Name = "clmEntity", ;
		Column2.ReadOnly = .T., ;
		Column2.Width = 90, ;
		Column3.ControlSource = "", ;
		Column3.Name = "clmErpKey", ;
		Column3.ReadOnly = .T., ;
		Column3.Width = 140, ;
		Column4.ControlSource = "", ;
		Column4.Name = "clmAction", ;
		Column4.ReadOnly = .T., ;
		Column4.Width = 70, ;
		Column5.ControlSource = "", ;
		Column5.Name = "clmStatus", ;
		Column5.ReadOnly = .T., ;
		Column5.Width = 90, ;
		Column6.ControlSource = "", ;
		Column6.Name = "clmError", ;
		Column6.ReadOnly = .T., ;
		Column6.Width = 360
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grdQueue.clmAction.Header1' AS header WITH ;
		Caption = "Action", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdQueue.clmAction.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
