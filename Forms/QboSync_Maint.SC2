		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdQueue.clmQueueId.Header1' AS header WITH ;
		Caption = "QueueId", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdQueue.clmQueueId.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdQueue.clmStatus.Header1' AS header WITH ;
		Caption = "Status", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdQueue.clmStatus.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'lblConn' AS label WITH ;
		Autosize = .F., ;
		Caption = "Connection: (loading…)", ;
		Height = 20, ;
		Left = 12, ;
		Name = "lblConn", ;
		Top = 10, ;
		Width = 872
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblHint' AS label WITH ;
		Autosize = .F., ;
		Caption = "AP: PO/VI Bills. AR: Sales_Invoice (HPAlloy examples until ERP_2 has sales). PostToQbo=0. Tax=Non. Bank=PNC Business.", ;
		Height = 28, ;
		Left = 12, ;
		Name = "lblHint", ;
		Top = 34, ;
		Width = 872
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE ConfigureGrid
		WITH This.grdQueue
			.clmQueueId.ControlSource = "csrQbo.queueid"
			.clmEntity.ControlSource = "csrQbo.entitytype"
			.clmErpKey.ControlSource = "csrQbo.erpkey"
			.clmAction.ControlSource = "csrQbo.action"
			.clmStatus.ControlSource = "csrQbo.status"
			.clmError.ControlSource = "csrQbo.lasterror"
		ENDWITH
	ENDPROC

	PROCEDURE Destroy
		IF USED("csrQbo")
			USE IN csrQbo
		ENDIF
		IF VARTYPE(ERP_Menu) = "O"
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE EnsureCursor
		IF USED("csrQbo")
			USE IN csrQbo
		ENDIF
		CREATE CURSOR csrQbo (queueid I, entitytype C(40), erpkey C(80), action C(20), status C(20), lasterror C(200))
	ENDPROC

	PROCEDURE Init
		This.EnsureCursor()
		This.nConnHandle = get_SQLSTRINGCONNECT()
		IF This.nConnHandle < 1
			MESSAGEBOX("Could not connect to SQL.", 16, "QBO Sync")
			RETURN .F.
		ENDIF
		This.LoadConnection()
		This.LoadRows()
		This.grdQueue.RecordSource = "csrQbo"
		This.ConfigureGrid()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		This.EnsureCursor()
	ENDPROC

	PROCEDURE LoadConnection
		LOCAL lcSQL, lnRet
		lcSQL = "SELECT TOP 1 CompanyLabel, PostToQbo, GoLiveEstimate, Environment, LastPaymentPullUtc "
		lcSQL = lcSQL + "FROM dbo.QboConnection WHERE IsActive = 1 ORDER BY ConnectionId"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpQboConn")
		IF lnRet < 1 OR NOT USED("tmpQboConn") OR RECCOUNT("tmpQboConn") = 0
			This.lblConn.Caption = "Connection: dbo.QboConnection missing — run MEM\SQL\QBO\01_QboBridge_Schema.sql"
			RETURN
		ENDIF
		SELECT tmpQboConn
		This.lblConn.Caption = "Company: " + ALLTRIM(CompanyLabel) ;
			+ "  |  PostToQbo=" + IIF(PostToQbo, "1 (LIVE)", "0 (dry-run)") ;
			+ "  |  Env=" + ALLTRIM(Environment) ;
			+ "  |  Go-live est: " + IIF(EMPTY(GoLiveEstimate), "n/a", DTOC(GoLiveEstimate)) ;
			+ "  |  LastPayPull: " + IIF(EMPTY(LastPaymentPullUtc), "never", TTOC(LastPaymentPullUtc))
		USE IN tmpQboConn
	ENDPROC

	PROCEDURE LoadRows
		LOCAL lcSQL, lnRet
		This.EnsureCursor()
		SELECT csrQbo
		ZAP
		lcSQL = "SELECT TOP 200 QueueId, EntityType, ErpKey, Action, Status, "
		lcSQL = lcSQL + "LEFT(ISNULL(LastError,''),200) AS LastError "
		lcSQL = lcSQL + "FROM dbo.QboSyncQueue WITH (NOLOCK) "
		lcSQL = lcSQL + "ORDER BY QueueId DESC"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpQboQ")
		IF lnRet < 1
			MESSAGEBOX("Could not load dbo.QboSyncQueue."+CHR(13)+ ;
				"Run MEM\SQL\QBO\01_QboBridge_Schema.sql", 48, "QBO Sync")
			RETURN
		ENDIF
		SELECT tmpQboQ
		SCAN
			INSERT INTO csrQbo (queueid, entitytype, erpkey, action, status, lasterror) ;
				VALUES (tmpQboQ.QueueId, ALLTRIM(tmpQboQ.EntityType), ALLTRIM(tmpQboQ.ErpKey), ;
					ALLTRIM(tmpQboQ.Action), ALLTRIM(tmpQboQ.Status), ALLTRIM(tmpQboQ.LastError))
		ENDSCAN
		USE IN tmpQboQ
		SELECT csrQbo
		GO TOP
	ENDPROC

	PROCEDURE cmdClose.Click
		ThisForm.Release()
	ENDPROC

	PROCEDURE cmdPayPull.Click
		LOCAL lcSQL, lnRet
		IF MESSAGEBOX("Enqueue Phase 4 PaymentPull job (dry-run stub)?"+CHR(13)+ ;
				"Simulates AR payment for HIST-INV-110411; does not call Intuit yet.", 4+32, "QBO Sync") # 6
			RETURN
		ENDIF
		lcSQL = "EXEC dbo.p_QboEnqueuePaymentPull @CreatedBy=N'VFP-QboSync'"
		lnRet = SQLEXEC(ThisForm.nConnHandle, lcSQL)
		IF lnRet < 0
			MESSAGEBOX("Enqueue failed. Deploy MEM\SQL\QBO\05_QboPayment_Pull.sql", 16, "QBO Sync")
			RETURN
		ENDIF
		MESSAGEBOX("Queued PaymentPull. Run QboBridge worker.", 64, "QBO Sync")
		ThisForm.LoadRows()
	ENDPROC

	PROCEDURE cmdHistInv.Click
		LOCAL lcSQL, lnRet
		IF MESSAGEBOX("Enqueue historic HPAlloy sales invoice 110411 (metal+freight) for dry-run?"+CHR(13)+ ;
				"ErpKey=HIST-INV-110411 — design only, not for live QBO.", 4+32, "QBO Sync") # 6
			RETURN
		ENDIF
		lcSQL = "EXEC dbo.p_QboEnqueueInvoiceFromSalesInvoice @Invoice=110411, @SourceDb=N'HPAlloy', @CreatedBy=N'VFP-QboSync'"
		lnRet = SQLEXEC(ThisForm.nConnHandle, lcSQL)
		IF lnRet < 0
			MESSAGEBOX("Enqueue failed. Deploy MEM\SQL\QBO\04_QboInvoice_Payload_And_Enqueue.sql", 16, "QBO Sync")
			RETURN
		ENDIF
		MESSAGEBOX("Queued HIST-INV-110411. Run QboBridge worker.", 64, "QBO Sync")
		ThisForm.LoadRows()
	ENDPROC

	PROCEDURE cmdPreviewPO.Click
		LOCAL lcSQL, lnRet
		IF MESSAGEBOX("Enqueue dry-run Bill preview for Equipment PO 1000?"+CHR(13)+ ;
				"(Uses FixedAsset_ME / 19100. Est freight is NOT posted.)", 4+32, "QBO Sync") # 6
			RETURN
		ENDIF
		lcSQL = "EXEC dbo.p_QboEnqueueBillPreviewFromPO @HPApo=1000, @CreatedBy=N'VFP-QboSync'"
		lnRet = SQLEXEC(ThisForm.nConnHandle, lcSQL)
		IF lnRet < 0
			MESSAGEBOX("Enqueue failed. Confirm Phase 3 SQL is deployed:"+CHR(13)+ ;
				"MEM\SQL\QBO\03_QboBill_Payload_And_Enqueue.sql", 16, "QBO Sync")
			RETURN
		ENDIF
		MESSAGEBOX("Queued PO-PREVIEW-1000. Run QboBridge worker to dry-run.", 64, "QBO Sync")
		ThisForm.LoadRows()
	ENDPROC

	PROCEDURE cmdReload.Click
		This.LoadConnection()
		This.LoadRows()
	ENDPROC

	PROCEDURE cmdRetry.Click
		LOCAL lnId, lcSQL, lnRet
		IF NOT USED("csrQbo") OR EOF("csrQbo")
			RETURN
		ENDIF
		IF NOT INLIST(UPPER(ALLTRIM(csrQbo.status)), "ERROR", "DEAD", "DRYRUN")
			MESSAGEBOX("Select an Error, Dead, or DryRun row to re-queue.", 48, "QBO Sync")
			RETURN
		ENDIF
		lnId = csrQbo.queueid
		lcSQL = "UPDATE dbo.QboSyncQueue SET Status = N'Pending', LastError = NULL, " ;
			+ "ClaimedAtUtc = NULL, ClaimedBy = NULL, ProcessedAtUtc = NULL " ;
			+ "WHERE QueueId = " + ALLTRIM(STR(lnId))
		lnRet = SQLEXEC(This.nConnHandle, lcSQL)
		IF lnRet < 0
			MESSAGEBOX("Retry update failed.", 16, "QBO Sync")
			RETURN
		ENDIF
		This.LoadRows()
	ENDPROC

ENDDEFINE
