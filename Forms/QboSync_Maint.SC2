		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdQueue.clmErpKey.Header1' AS header WITH ;
		Caption = "ERP Key", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdQueue.clmErpKey.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdQueue.clmError.Header1' AS header WITH ;
		Caption = "Last error / note", ;
