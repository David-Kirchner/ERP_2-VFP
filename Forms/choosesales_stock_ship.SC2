	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		*CASE tmpSales_Stock.cancelled
		CASE DELETED(tmpSales_Stock)
			nColor = RGB( 255, 0, 0 ) &&RED	
		*CASE tmpSales_Stock.Cancelled
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pSOitem, pnTmpPSnum 
		*DO FORM Forms\chooseSales_Detail_Ship WITH cSOitem, nTmpPSnum
		*DO FORM Forms\chooseSales_Detail_Ship WITH ' 88720-01',0
		IF VARTYPE(pSOitem) != "C"
			MESSAGEBOX("No Parameter SOitem for FORM Choose_Sales_Stock_Ship",16,"Abort")
			TrackError("No Parameter SOitem","No Parameter SOitem","Choose_Sales_Detail_Ship.Init",LINENO(1) )
			RETURN 
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = Proper_SO_item('')
		
		IF VARTYPE(pSOitem) = "C"
			ThisForm.Caption = ThisForm.Caption+" for SOitem: "+ALLTRIM(pSOitem)
			cSOitem = Proper_SO_item(pSOitem)
		ENDIF
		
		PRIVATE nTmpPSnum
		nTmpPSnum = 0
		
		IF VARTYPE(pnTmpPSnum) = 'N'
			nTmpPSnum = pnTmpPSnum 
		ELSE
			MESSAGEBOX("No Parameter SOitem for FORM Choose_Sales_Stock_Ship",16,"Abort")
			TrackError("No PackingSlip No","No PackingSlip No","Choose_Sales_Detail_Ship.Init",LINENO(1) )
			RETURN .F.
		ENDIF
		
		
		IF NOT USED('tmpSales_Stock')
			
		ENDIF
		
		*!*	IF USED("tmpChooseSales_Stock")	
		*!*		USE IN tmpChooseSales_Stock
		*!*	ENDIF
		
		*!*	SELECT 0
		*!*	PRIVATE cSQL, nSQLEXEC 
		*!*	cSQL = "SELECT SS.* FROM dbo.Sales_Stock SS WHERE "
		*!*	cSQL = cSQL + " SS.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*	cSQL = cSQL + " AND SS.Reconciled = 0 "
		*!*	cSQL = cSQL + " AND SS.PackingSli <= 0 "
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpChooseSales_Stock')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpChooseSales_Stock')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpChooseSales_Stock')
		*!*	ENDIF
		
		ThisForm.grid.RecordSource = "tmpSales_Stock"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		*ThisForm.grid.SetFocus
		PRIVATE nRecCount
		nRecCount = RECCOUNT("tmpSales_Stock")
		DO CASE
		CASE nRecCount = 0
			MESSAGEBOX("Sorry, SO Item not Found:"+cSOitem,32,"No records to Show!")
			ThisForm.cmdCancel.Click
		CASE nRecCount = 1
			ThisForm.txtSOitem.Value 		= cSOitem 
			ThisForm.txtPackingSli.Value 	= nTmpPSnum 
		
		*	IF ThisForm.cmdSelect.Click()
		*		RETURN
		*	ENDIF
			
		CASE nRecCount > 7
			GO BOTTOM
			SKIP -6
		OTHERWISE
			GO BOTTOM
		ENDCASE
		
		
		PRIVATE cHeat, lDeleted
		lDeleted = .F.
		IF USED('tmpPSItem')
			SELECT tmpSales_Stock
			*Check Heat with PackingSlip
			*Delete mark where heat not in tmpPSItem
			SCAN 
				cHeat = PrepareSQLtxt(tmpSales_Stock.Heat,'Heat',50)
				SELECT tmpPSItem
				LOCATE FOR Heat = cHeat
				IF NOT FOUND('tmpPSItem')
					SELECT tmpSales_Stock
					DELETE IN tmpSales_Stock
					lDeleted = .T.
				ENDIF
				SELECT tmpSales_Stock
			ENDSCAN
			*******
		*!*			CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpSales_Stock") FREE ;
		*!*			([ID] I,SOitem C(10),SL_Qty N(18,4),SL_P N(18,4),SL_Total N(18,4),SL_PU N(1);
		*!*			,SL_PC N(10),SL_Dim1 N(10,4),SL_Dim2 N(9,3),SL_Dim3 N(9,3),SL_LBS N(9,1);
		*!*			,SL_POitem C(12),Consumed L,StkBack L,StockEdit T,RecDate T,TBL C(1);
		*!*			,SL_ID I,SL_ID_D I,ID_D_Proc I,Alloy C(12),[Form] C(2),Heat C(50),Lot C(10),CC C(1);
		*!*			,RandLen L,Orig_PC I,Orig_Dim1 N(10,4),Orig_Dim2 N(9,3),Orig_Dim3 N(9,3),Orig_LBS N(9,1);
		*!*			,Reconciled L,Sales_D_ID N(10),StkPaid_P N(18,4),StkPaid_T N(18,4),PackingSli I;
		*!*			,PS_PC I,PS_Form C(2),PS_Dim1 N(10,4),PS_Dim2 N(9,3),PS_Dim3 N(9, 3),PS_LBS N(9,1),WO I  )
		
			PRIVATE	nSS_ID,nPS_PC,cPS_Form,nPS_Dim1,nPS_Dim2,nPS_Dim3,nPS_LBS
		
			SELECT tmpPSItem &&tmpSales_Stock
			SCAN 
			
				nSS_ID	 = PrepareSQLnum(tmpPSItem.SS_ID,'ID',-3)
				nPS_PC	 = PrepareSQLnum(tmpPSitem.PCs,'PC',-3)
				cPS_Form = PrepareSQLtxt(tmpPSitem.Form,'Form',2)
				nPS_Dim1 = PrepareSQLnum(tmpPSitem.Dim1,'Dim1',10,4)
				nPS_Dim2 = PrepareSQLnum(tmpPSitem.Dim2,'Dim2',9,3)
				nPS_Dim3 = PrepareSQLnum(tmpPSitem.Dim3,'Dim3',9,3)
				nPS_LBS	 = PrepareSQLnum(tmpPSitem.Weight,'LBS',9,1)
		
				SELECT tmpSales_Stock
				LOCATE FOR ID = nSS_ID
				IF FOUND('tmpSales_Stock')
					SELECT tmpSales_Stock
					REPLACE PS_PC WITH nPS_PC
					REPLACE PS_Form WITH cPS_Form
					REPLACE PS_Dim1 WITH nPS_Dim1
					REPLACE PS_Dim2 WITH nPS_Dim2
					REPLACE PS_Dim3 WITH nPS_Dim3
					REPLACE PS_LBS WITH nPS_LBS
				ENDIF
				SELECT tmpPSItem 
			ENDSCAN
			
			********
			SELECT tmpSales_Stock
			GO TOP
		ENDIF
		
		IF lDeleted
			MESSAGEBOX("Caution, This list is what the shop has removed for this SO"+CHR(13)+"does has an item that does not match the"+CHR(13)+"Heat number used on the Packing Slip."+CHR(13)+"Those records with missmatched heat are black marked."+CHR(13)+"Look thru all records to see is heat was actually close.",0+32,"Have mismatched heats")
		ENDIF
		
		*******************************
		ThisForm.txtSOitem.Value 		= cSOitem 
		ThisForm.txtPackingSli.Value 	= nTmpPSnum 
		
		ThisForm.txtDescription.Value	= ItemDescription(tmpSales_Stock.Form, tmpSales_Stock.SL_Dim1, tmpSales_Stock.SL_Dim2, tmpSales_Stock.SL_Dim3, tmpSales_Stock.SL_LBS, .F.)
		ThisForm.txtHeat.Value 			= PrepareSQLtxt(tmpSales_Stock.Heat,'Heat',50)
		ThisForm.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Stock.SL_QTY,'StockLst_QTY',-3)
		ThisForm.txtStockLst_LBS.Value 	= PrepareSQLnum(tmpSales_Stock.SL_LBS,'StockLst_LBS',9,1)
		ThisForm.txtStockLst_PC.Value 	= PrepareSQLnum(tmpSales_Stock.SL_PC,'StockLst_PC',-3)
		
		
		ThisForm.txtStockLst_Dim1.Value = PrepareSQLnum(tmpSales_Stock.SL_Dim1,'StockLst_Dim1',10,4)
		ThisForm.txtStockLst_Dim2.Value = PrepareSQLnum(tmpSales_Stock.SL_Dim2,'StockLst_Dim2',9,3)
		ThisForm.txtStockLst_Dim3.Value = PrepareSQLnum(tmpSales_Stock.SL_Dim3,'StockLst_Dim3',9,3)
		
		
		ThisForm.txtPS_PC.Value 	= PrepareSQLnum(tmpSales_Stock.PS_PC,'PS_PC',-3)
		ThisForm.txtPS_Dim1.Value	= PrepareSQLnum(tmpSales_Stock.PS_Dim1,'PS_Dim1',10,4)
		ThisForm.txtPS_Dim2.Value	= PrepareSQLnum(tmpSales_Stock.PS_Dim2,'PS_Dim2',9,3)
		ThisForm.txtPS_Dim3.Value	= PrepareSQLnum(tmpSales_Stock.PS_Dim3,'PS_Dim3',9,3)
		ThisForm.txtPS_LBS.Value 	= PrepareSQLnum(tmpSales_Stock.PS_LBS,'PS_LBS',9,1)
		
		
		ThisForm.chkConsumed.Value = PrepareSQLchk(tmpSales_Stock.Consumed,'Consumed')
		ThisForm.chkStkBack.Value = PrepareSQLchk(tmpSales_Stock.StkBack,'StkBack')
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_SETUP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE Unload
		
		IF USED("tmpSales_Stock")	
			USE IN tmpSales_Stock
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE cHoldNumber
		cHoldNumber = STR(tmpSales_Stock.ID)
		ThisForm.HoldNumber = cHoldNumber 
		
		PRIVATE cSOitem, m.nTmpPSnum,cHeat,cMess
		cSOitem 	= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		m.nTmpPSnum = PrepareSQLnum(ThisForm.txtPackingSli.Value,'tmpPSnum',-3)
		*nTmpPSnum is largest INT minus Seconds from midnight as a temp number untill a real PackingSli number is incremented.
		cHeat = ''
		
		PRIVATE lOk
		lOK = .T.
		
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')	
			MESSAGEBOX("No SOitem!",16,"Cannot Mark!")
		*	RETURN .F.
			lOK = .F.
		ENDIF
		*IF nTmpPSnum = 0
		*	MESSAGEBOX("No PackingSli!",16,"Cannot Mark!")
		*	*RETURN .F.
		*	lOK = .F.
		*ENDIF
		
		*Save tmpPSItem changes to Sales_Stock	
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE	nSS_ID,nPS_PC,cPS_Form,nPS_Dim1,nPS_Dim2,nPS_Dim3,nPS_LBS
		IF lOK
			SELECT tmpPSItem 
			SCAN
				nSS_ID	 = PrepareSQLnum(tmpPSItem.SS_ID,'ID',-3)
				
				IF DELETED('tmpPSItem')
					SELECT tmpSales_Stock
					DELETE FOR ID = nSS_ID
					SELECT tmpPSItem 
					LOOP
				ENDIF
				IF PrepareSQLlogic(tmpSales_Stock.Reconciled,'Reconciled')
					*Reconciled is for show only.  Show what has already shipped.
					SELECT tmpSales_Stock
					DELETE FOR ID = nSS_ID
					SELECT tmpPSItem 
					LOOP
				ENDIF
				
				cHeat =  PrepareSQLtxt(tmpPSItem.Heat,'Heat',50)
				cHeat =  ALLTRIM(UPPER(Heat))
				
				
				
				nPS_PC	 = PrepareSQLnum(tmpPSItem.PS_PC,'PS_PC',-3)
				cPS_Form = PrepareSQLtxt(tmpPSItem.Form,'Form',2)
				nPS_Dim1 = PrepareSQLnum(tmpPSItem.PS_Dim1,'Dim1',10,4)
				nPS_Dim2 = PrepareSQLnum(tmpPSItem.PS_Dim2,'Dim2',9,3)
				nPS_Dim3 = PrepareSQLnum(tmpPSItem.PS_Dim3,'Dim3',9,3)
				nPS_LBS	 = PrepareSQLnum(tmpPSItem.PS_LBS,'PS_LBS',9,1)
		
		*!*			IF USED('tmpPSItem')
		*!*				SELECT tmpPSItem
		*!*				*Check Heat with PackingSlip
		*!*				SELECT tmpSales_Stock
		*!*			ENDIF
			*********************************************************
		*!*			UPDATE tmpSales_Stock SET(StockLst_PC, SOItem, Alloy, Form, Heat, CC, StockLst_LBS ;
		*!*				,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, RandLen, PackingSli ;
		*!*				,StockLst_Qty, StockLst_PU, PackingSli, ID);
		*!*			VALUES (nPCs, cSOitem, cAlloy,cForm,cHeat, cCC, nWeight;
		*!*				,nDim1,nDim2,nDim3,lRandLen,nTmpPSnum ;
		*!*				,nQTY, nPU, nTmpPSnum ,nSS_ID)		
		
		*!*	CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpSales_Stock") FREE ;
		*!*	([ID] I,SOitem C(10),SL_Qty N(18,4),SL_P N(18,4),SL_Total N(18,4),SL_PU N(1);
		*!*	,SL_PC N(10),SL_Dim1 N(10,4),SL_Dim2 N(9,3),SL_Dim3 N(9,3),SL_LBS N(9,1);
		*!*	,SL_POitem C(12),Consumed L,StkBack L,StockEdit T,RecDate T,TBL C(1);
		*!*	,SL_ID I,SL_ID_D I,ID_D_Proc I,Alloy C(12),[Form] C(2),Heat C(50),Lot C(10),CC C(1);
		*!*	,RandLen L,Orig_PC I,Orig_Dim1 N(10,4),Orig_Dim2 N(9,3),Orig_Dim3 N(9,3),Orig_LBS N(9,1);
		*!*	,Reconciled L,Sales_D_ID N(10),StkPaid_P N(18,4),StkPaid_T N(18,4),PackingSli I
		*!*	,PS_PC I,PS_Form C(2),PS_Dim1 N(10,4),PS_Dim2 N(9,3),PS_Dim3 N(9, 3),PS_LBS N(9,1),WO I  )
		
				UPDATE tmpSales_Stock SET;
				 SL_PC =nPS_PC;
				,SL_Dim1 =nPS_Dim1;
				,SL_Dim2 =nPS_Dim2;
				,SL_Dim3 =nPS_Dim3;
				,SL_LBS =nPS_LBS;
				,PackingSli= nTmpPSnum;
				,PS_PC=nPS_PC;
				,PS_Form=cPS_Form;
				,PS_Dim1=nPS_Dim1;
				,PS_Dim2=nPS_Dim2;
				,PS_Dim3=nPS_Dim3;
				,PS_LBS=nPS_LBS;
				WHERE ID = nSS_ID
			
		*!*	,SL_Qty N(18,4)
		*!*	,SL_P N(18,4)
		*!*	,SL_Total N(18,4);
				
		*!*			cSQL = "UPDATE dbo.Sales_Stock SET "
		*!*			cSQL = cSQL+" PackingSli="+ALLTRIM(STR(nTmpPSnum))
		*!*			
		*!*			cSQL = cSQL+" ,PS_PC="+ALLTRIM(STR(nPS_PC))
		*!*			cSQL = cSQL+" ,PS_Form='"+cPS_Form+"'"
		*!*			cSQL = cSQL+" ,PS_Dim1="+STR(nPS_Dim1,10,4)
		*!*			cSQL = cSQL+" ,PS_Dim2="+STR(nPS_Dim2,9,3)
		*!*			cSQL = cSQL+" ,PS_Dim3="+STR(nPS_Dim3,9,3)
		*!*			cSQL = cSQL+" ,PS_LBS="+STR(nPS_LBS,9,1)
		*!*			
		*!*			cSQL = cSQL+" WHERE ID="+ALLTRIM(STR(tmpSales_Stock.ID))
		
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseSales_Detail")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseSales_Detail")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisForm.nConnHandle)
		*!*			ELSE
					
		*!*				nStockLst_ID_Detail = PrepareSQLnum(tmpSales_Stock.SL_ID_D,'StockLst_ID_Detail',-3)
		*!*				IF nStockLst_ID_Detail > 0
		*!*				
		*!*					cSQL = "UPDATE dbo.Sales_Detail SET "
		*!*				
		*!*					cSQL = cSQL+" PackingSli="+ALLTRIM(STR(m.nTmpPSnum))
		*!*					cSQL = cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*					cSQL = cSQL+" AND StockLst_ID_Detail = "+STR( nStockLst_ID_Detail )
		*!*					cSQL = cSQL+" AND ISNULL(PackingSli,0) = 0"
		*!*					cSQL = cSQL+" AND ISNULL(Reconciled,0) = 0"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*					ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL,ThisForm.nConnHandle)
		*!*					ENDIF
		*!*				ENDIF
		*!*							
		*!*				WAIT WINDOW "Saved PackingSli to Sales_Stock" NOWAIT
					lOK = .T.
					*ThisForm.Release
		*!*			ENDIF
			ENDSCAN
		ENDIF	
		
		IF lOK 
			ThisForm.Release
		ENDIF
					
		
	ENDPROC

	PROCEDURE Grid.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.txtDescription.Value	= ItemDescription(tmpSales_Stock.Form, tmpSales_Stock.SL_Dim1, tmpSales_Stock.SL_Dim2, tmpSales_Stock.SL_Dim3, tmpSales_Stock.SL_LBS, .F.)
		ThisForm.txtHeat.Value 			= ShowSQLtxt(tmpSales_Stock.Heat,'Heat',50)
		ThisForm.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Stock.SL_QTY,'StockLst_QTY',-3)
		ThisForm.txtStockLst_PC.Value 	= PrepareSQLnum(tmpSales_Stock.SL_PC,'StockLst_PC',-3)
		ThisForm.txtStockLst_LBS.Value 	= PrepareSQLnum(tmpSales_Stock.SL_LBS,'StockLst_LBS',9,1)
		
		ThisForm.txtStockLst_Dim1.Value = PrepareSQLnum(tmpSales_Stock.SL_Dim1,'StockLst_Dim1',10,4)
		ThisForm.txtStockLst_Dim2.Value = PrepareSQLnum(tmpSales_Stock.SL_Dim2,'StockLst_Dim2',9,3)
		ThisForm.txtStockLst_Dim3.Value = PrepareSQLnum(tmpSales_Stock.SL_Dim3,'StockLst_Dim3',9,3)
		
		
		ThisForm.txtPS_PC.Value 	= PrepareSQLnum(tmpSales_Stock.PS_PC,'PS_PC',-3)
		ThisForm.txtPS_Dim1.Value	= PrepareSQLnum(tmpSales_Stock.PS_Dim1,'PS_Dim1',10,4)
		ThisForm.txtPS_Dim2.Value	= PrepareSQLnum(tmpSales_Stock.PS_Dim2,'PS_Dim2',9,3)
		ThisForm.txtPS_Dim3.Value	= PrepareSQLnum(tmpSales_Stock.PS_Dim3,'PS_Dim3',9,3)
		ThisForm.txtPS_LBS.Value 	= PrepareSQLnum(tmpSales_Stock.PS_LBS,'PS_LBS',9,1)
		
		
		ThisForm.chkConsumed.Value = PrepareSQLchk(tmpSales_Stock.Consumed,'Consumed')
		ThisForm.chkStkBack.Value = PrepareSQLchk(tmpSales_Stock.StkBack,'StkBack')
		
		
	ENDPROC

ENDDEFINE
