	PROCEDURE ClearCursors
		IF USED("csrSOEvt")
			USE IN csrSOEvt
		ENDIF
		IF USED("csrSOMoney")
			USE IN csrSOMoney
		ENDIF
		CREATE CURSOR csrSOEvt (eventwhen T NULL, eventtype C(30), eventdesc C(200), heat C(50), ;
			lot C(10), lb N(9,1) NULL, reftext C(80), whoname C(50), soitem C(10), sortkey I)
		CREATE CURSOR csrSOMoney (soitem C(10), stock_total Y, paid_context Y, acct_status C(40), ;
			acct_approved Y, sales_price Y, qbo_billed Y, qbo_paid Y, margin Y, stock_qty Y, stock_p Y)
	ENDPROC

	PROCEDURE ConfigureGrids
		* Bind via Columns(n) — SCX/FoxBin round-trip does not keep Column1.Name = "clm*".
		WITH This.grdEvents
			.RecordSource = "csrSOEvt"
			.ColumnCount = 8
			.Columns(1).ControlSource = "csrSOEvt.eventwhen"
			.Columns(1).Width = 130
			.Columns(1).Header1.Caption = "When"
			.Columns(2).ControlSource = "csrSOEvt.eventtype"
			.Columns(2).Width = 90
			.Columns(2).Header1.Caption = "Type"
			.Columns(3).ControlSource = "csrSOEvt.eventdesc"
			.Columns(3).Width = 220
			.Columns(3).Header1.Caption = "Description"
			.Columns(4).ControlSource = "csrSOEvt.heat"
			.Columns(4).Width = 80
			.Columns(4).Header1.Caption = "Heat"
			.Columns(5).ControlSource = "csrSOEvt.lot"
			.Columns(5).Width = 70
			.Columns(5).Header1.Caption = "Lot"
			.Columns(6).ControlSource = "csrSOEvt.lb"
			.Columns(6).Width = 70
			.Columns(6).Header1.Caption = "Lb"
			.Columns(7).ControlSource = "csrSOEvt.reftext"
			.Columns(7).Width = 120
			.Columns(7).Header1.Caption = "Ref"
			.Columns(8).ControlSource = "csrSOEvt.whoname"
			.Columns(8).Width = 80
			.Columns(8).Header1.Caption = "Who"
		ENDWITH
		WITH This.grdMoney
			.RecordSource = "csrSOMoney"
			.ColumnCount = 9
			.Columns(1).ControlSource = "csrSOMoney.soitem"
			.Columns(1).Width = 90
			.Columns(1).Header1.Caption = "SOitem"
			.Columns(2).ControlSource = "csrSOMoney.stock_total"
			.Columns(2).Width = 90
			.Columns(2).Header1.Caption = "Stock $"
			.Columns(3).ControlSource = "csrSOMoney.paid_context"
			.Columns(3).Width = 90
			.Columns(3).Header1.Caption = "Paid ctx"
			.Columns(4).ControlSource = "csrSOMoney.acct_status"
			.Columns(4).Width = 80
			.Columns(4).Header1.Caption = "Acct"
			.Columns(5).ControlSource = "csrSOMoney.acct_approved"
			.Columns(5).Width = 90
			.Columns(5).Header1.Caption = "Approved $"
			.Columns(6).ControlSource = "csrSOMoney.sales_price"
			.Columns(6).Width = 90
			.Columns(6).Header1.Caption = "Sale $"
			.Columns(7).ControlSource = "csrSOMoney.qbo_billed"
			.Columns(7).Width = 90
			.Columns(7).Header1.Caption = "Billed $"
			.Columns(8).ControlSource = "csrSOMoney.qbo_paid"
			.Columns(8).Width = 90
			.Columns(8).Header1.Caption = "Paid $"
			.Columns(9).ControlSource = "csrSOMoney.margin"
			.Columns(9).Width = 90
			.Columns(9).Header1.Caption = "Margin $"
		ENDWITH
	ENDPROC

	PROCEDURE Destroy
		IF USED("csrSOEvt")
			USE IN csrSOEvt
		ENDIF
		IF USED("csrSOMoney")
			USE IN csrSOMoney
		ENDIF
		IF USED("tmpSOEvt")
			USE IN tmpSOEvt
		ENDIF
		IF USED("tmpSOMoney")
			USE IN tmpSOMoney
		ENDIF
		IF VARTYPE(ERP_Menu) = "O"
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tnSales
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		This.ClearCursors()
		This.nConnHandle = get_SQLSTRINGCONNECT()
		IF This.nConnHandle < 1
			MESSAGEBOX("Could not connect to SQL.", 16, "SO History")
			RETURN .F.
		ENDIF
		This.ConfigureGrids()
		This.ShowPage("C")
		IF VARTYPE(tnSales) = "N" AND tnSales > 0
			This.txtSalesNum.Value = tnSales
			This.LoadSO(tnSales, "")
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		SET PROCEDURE TO PROGS\SO_History ADDITIVE
		This.ClearCursors()
	ENDPROC

	PROCEDURE LoadSO
		LPARAMETERS tnSales, tcSOitem
		LOCAL lcSQL, lnRet, lcFilter, lnSaleTot, lnBill, lnPaid, lnMargin, lnCost
		IF VARTYPE(tnSales) # "N" OR tnSales < 1
			MESSAGEBOX("Enter a Sales number.", 48, "SO History")
			RETURN
		ENDIF
		This.nSalesNum = INT(tnSales)
		IF VARTYPE(tcSOitem) # "C"
			tcSOitem = ""
		ENDIF
		tcSOitem = ALLTRIM(tcSOitem)
		This.ClearCursors()
		lcFilter = " WHERE SalesNum = " + ALLTRIM(STR(This.nSalesNum))
		IF NOT EMPTY(tcSOitem)
			lcFilter = lcFilter + " AND SOitem = '" + STRTRAN(tcSOitem, "'", "''") + "'"
		ENDIF
		
		IF USED("tmpSOEvt")
			USE IN tmpSOEvt
		ENDIF
		lcSQL = "SELECT EventWhen, EventType, EventDesc, Heat, Lot, Lb, RefText, WhoName, SOitem, SortKey "
		lcSQL = lcSQL + "FROM dbo.v_SO_History_Events " + lcFilter
		lcSQL = lcSQL + " ORDER BY ISNULL(EventWhen,'19000101'), SortKey, EventType"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpSOEvt")
		IF lnRet < 1
			MESSAGEBOX("Could not load chronology."+CHR(13)+ ;
				"Run Config\26_SO_History_Views.sql if views are missing.", 48, "SO History")
			RETURN
		ENDIF
		IF USED("tmpSOEvt")
			SELECT tmpSOEvt
			SCAN
				INSERT INTO csrSOEvt (eventwhen, eventtype, eventdesc, heat, lot, lb, reftext, whoname, soitem, sortkey) ;
					VALUES (NVL(tmpSOEvt.EventWhen, {//}), ALLTRIM(NVL(tmpSOEvt.EventType,"")), ALLTRIM(NVL(tmpSOEvt.EventDesc,"")), ;
					ALLTRIM(NVL(tmpSOEvt.Heat,"")), ALLTRIM(NVL(tmpSOEvt.Lot,"")), NVL(tmpSOEvt.Lb,0), ;
					ALLTRIM(NVL(tmpSOEvt.RefText,"")), ALLTRIM(NVL(tmpSOEvt.WhoName,"")), ;
					ALLTRIM(NVL(tmpSOEvt.SOitem,"")), NVL(tmpSOEvt.SortKey,0))
			ENDSCAN
			USE IN tmpSOEvt
		ENDIF
		
		IF USED("tmpSOMoney")
			USE IN tmpSOMoney
		ENDIF
		lcSQL = "SELECT SOitem, Stock_Total, Paid_Context, Acct_Status, Acct_ApprovedAmt, Sales_Price, "
		lcSQL = lcSQL + "QBO_Billed, QBO_Paid, Margin, Stock_QTY, Stock_P "
		lcSQL = lcSQL + "FROM dbo.v_SO_History_Money " + lcFilter + " ORDER BY SOitem"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpSOMoney")
		IF lnRet < 1
			MESSAGEBOX("Could not load money page.", 48, "SO History")
		ELSE
			IF USED("tmpSOMoney")
				SELECT tmpSOMoney
				SCAN
					INSERT INTO csrSOMoney (soitem, stock_total, paid_context, acct_status, acct_approved, ;
						sales_price, qbo_billed, qbo_paid, margin, stock_qty, stock_p) VALUES ;
						(ALLTRIM(tmpSOMoney.SOitem), NVL(tmpSOMoney.Stock_Total,0), NVL(tmpSOMoney.Paid_Context,0), ;
						ALLTRIM(NVL(tmpSOMoney.Acct_Status,"")), NVL(tmpSOMoney.Acct_ApprovedAmt,0), ;
						NVL(tmpSOMoney.Sales_Price,0), NVL(tmpSOMoney.QBO_Billed,0), NVL(tmpSOMoney.QBO_Paid,0), ;
						NVL(tmpSOMoney.Margin,0), NVL(tmpSOMoney.Stock_QTY,0), NVL(tmpSOMoney.Stock_P,0))
				ENDSCAN
				USE IN tmpSOMoney
			ENDIF
		ENDIF
		
		lnSaleTot = 0
		lnBill = 0
		lnPaid = 0
		lnMargin = 0
		lnCost = 0
		IF USED("csrSOMoney")
			SELECT csrSOMoney
			SUM sales_price, qbo_billed, qbo_paid, margin, stock_total TO lnSaleTot, lnBill, lnPaid, lnMargin, lnCost
		ENDIF
		This.lblHdr.Caption = "Sales #" + ALLTRIM(STR(This.nSalesNum)) + ;
			IIF(EMPTY(tcSOitem), "", "  filter " + tcSOitem) + ;
			"   Events: " + ALLTRIM(STR(RECCOUNT("csrSOEvt"))) + ;
			"   Lines: " + ALLTRIM(STR(RECCOUNT("csrSOMoney")))
		This.lblTotals.Caption = "TOTALS  Sales " + ALLTRIM(TRANSFORM(lnSaleTot,"$$$,$$$,$$9.99")) + ;
			"   Stock cost " + ALLTRIM(TRANSFORM(lnCost,"$$$,$$$,$$9.99")) + ;
			"   QBO billed " + ALLTRIM(TRANSFORM(lnBill,"$$$,$$$,$$9.99")) + ;
			"   QBO paid " + ALLTRIM(TRANSFORM(lnPaid,"$$$,$$$,$$9.99")) + ;
			"   Margin " + ALLTRIM(TRANSFORM(lnMargin,"$$$,$$$,$$9.99"))
		
		This.ConfigureGrids()
		SELECT csrSOEvt
		GO TOP
		SELECT csrSOMoney
		GO TOP
		This.grdEvents.Refresh()
		This.grdMoney.Refresh()
		This.ShowPage(This.cPage)
	ENDPROC

	PROCEDURE ShowPage
		LPARAMETERS tcPage
		This.cPage = UPPER(LEFT(ALLTRIM(EVL(tcPage,"C")),1))
		IF This.cPage = "M"
			This.grdEvents.Visible = .F.
			This.grdMoney.Visible = .T.
			This.lblTotals.Visible = .T.
			This.cmdMoney.FontBold = .T.
			This.cmdChrono.FontBold = .F.
			This.cmdMoney.BackColor = RGB(200,220,255)
			This.cmdChrono.BackColor = RGB(236,233,216)
		ELSE
			This.cPage = "C"
			This.grdEvents.Visible = .T.
			This.grdMoney.Visible = .F.
			This.lblTotals.Visible = .F.
			This.cmdChrono.FontBold = .T.
			This.cmdMoney.FontBold = .F.
			This.cmdChrono.BackColor = RGB(200,220,255)
			This.cmdMoney.BackColor = RGB(236,233,216)
		ENDIF
	ENDPROC

	PROCEDURE cmdChrono.Click
		ThisForm.ShowPage("C")
	ENDPROC

	PROCEDURE cmdClose.Click
		ThisForm.Release()
	ENDPROC

	PROCEDURE cmdLoad.Click
		This.LoadSO(INT(VAL(TRANSFORM(This.txtSalesNum.Value))), ALLTRIM(TRANSFORM(This.txtSOitem.Value)))
	ENDPROC

	PROCEDURE cmdMoney.Click
		ThisForm.ShowPage("M")
	ENDPROC

ENDDEFINE
