	PROCEDURE frmEdt.pf.pgQuote.txtItemCost.Valid
		PRIVATE nBuyCost
		PRIVATE nDecimal
		
		IF !SalesQuote.Cncld
			IF !SalesQuote.inv
				nBuyCost = This.Value
				IF TYPE("nBuyCost") = "C"
					nDecimal = SET("DECIMAL")
					SET DECIMAL TO 0
					nBuyCost = VAL(nBuyCost)
					SET DECIMAL TO nDecimal
				ENDIF
				SELECT SalesQuote
				REPLACE BuyCost WITH nBuyCost  IN SalesQuote
			ENDIF
		ENDIF
	ENDPROC

