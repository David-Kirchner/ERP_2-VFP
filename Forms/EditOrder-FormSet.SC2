	PROCEDURE frmEdt.pf.pgOrder.cmdCancelQuote.Click
		IF This.Caption = "PO"
			**Start the Edit
			This.Parent.CmdEditQuote.Click
		ELSE
			**Cancel the Edit -- NO SAVE
			ThisForm.ShowQuote("OrderDISABLE")
			This.Caption = "PO"
			This.Parent.CmdEditQuote.Caption = "Edit"
			This.Parent.Refresh
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgOrder.CmdEditQuote.Click
		IF This.Caption = "Edit"
			**Prepare Screen for Editing
			ThisForm.ShowQuote("OrderENABLE")
			This.Caption = "Save"
			This.Parent.cmdCancelQuote.Caption = "Cancel"
		ELSE
			**Save Data
			ThisForm.ShowQuote("OrderSAVE")
			ThisForm.ShowQuote("OrderDISABLE")
			This.Caption = "Edit"
			This.Parent.cmdCancelQuote.Caption = "PO"
		ENDIF
	ENDPROC

