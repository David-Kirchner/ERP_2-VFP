	PROCEDURE frmEdt.pf.pgQuote.txtShipdue.Valid
		PRIVATE vDate, dDate
		vDate = This.Value
		
		IF VARTYPE(vDate) = "T"
			dDate = TTOD(vDate)
			This.Value = dDate
		ENDIF
		IF VARTYPE(vDate) = "D"
			dDate = vDate
		ENDIF
		IF VARTYPE(vDate) = "C"
			dDate = CTOD(vDate)
			This.Value = dDate
		ENDIF
		
		
		
		IF dDate != CTOD("  /  /  ")
			*Have a date
			IF dDate > DATE() + 1095 
				*3 Years Ahead
				MESSAGEBOX("Date field is for OVER 3 years ahead!",0,"ShipDue Valid")
			ENDIF
			IF dDate < DATE() - 90
				*3 Years Ahead
				MESSAGEBOX("Date field is for 3 months ago!",0,"ShipDue Valid")
			ENDIF
		ENDIF
		
	ENDPROC

