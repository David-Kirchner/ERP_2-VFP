			cSQL= cSQL+" WHERE shipcode = "+STR(ThisForm.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
			
		ELSE
			MESSAGEBOX("ShipAddr Code is empty",0,'')
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdShipAddSave.Click
		LOCAL llBlind, lcPayType, lcShipPay
		llBlind			= PrepareSQLchk(This.Parent.chkBlindSO.Value,'Blind',.F.)
		lcPayType		= PrepareSQLtxt(This.Parent.cmbPayment.Value,'PayType',10)
		*lcFrtPayment	= PrepareSQLtxt(This.Parent.cmbFrtPayment.Value,'FrtPayment',11)
		lcShipPay		= PrepareSQLtxt(This.Parent.cmbFrtPayment.Value,'ShipPay',11)
		
		IF !Empty(ThisForm.ShipAddr)
		
		*	UPDATE shipaddr SET Blind = llBlind, PayType = lnPaymentType, ShipPay = lcFrtPayment WHERE shipcode = ThisForm.ShipAddr
			PRIVATE cSQLu, nSQLEXEC 
			cSQLu= "UPDATE dbo.ShipAddr SET "
			cSQLu= cSQLu+" Blind = "+IIF(llBlind,'1','0')
			cSQLu= cSQLu+",PayType = '"+lcPayType+"'"
			cSQLu= cSQLu+",ShipPay = '"+lcShipPay +"'"
			cSQLu= cSQLu+",LastEdit=GetDate() "
			cSQLu= cSQLu+" WHERE shipcode = "+STR(ThisForm.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
				
		
		ELSE
			MESSAGEBOX("ShipAddr Code is empty",0,'')
		ENDIF
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.lblShipToCountry.Click
		PRIVATE cSQL_tmpCountries, nSQLEXEC, cCurrTable
		cCurrTable = ALIAS()
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		cSQL_tmpCountries="SELECT CountryCode AS CC, CountryDesc FROM dbo.Countries"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_tmpCountries,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountries')
		ELSE
			DEFINE WINDOW output IN WINDOW frmEdt FROM 12,1 TO 23,40 TITLE 'Countries' CLOSE FLOAT GROW ZOOM
			ACTIVATE WINDOW output
			SELECT tmpCountries
			BROWSE IN WINDOW output NODELETE NOEDIT NOAPPEND
			DEACTIVATE WINDOW output
			RELEASE WINDOW output
		ENDIF
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		IF NOT EMPTY(cCurrTable)
			SELECT (cCurrTable)
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.txtShipRoute.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr, cSearchStrOrig 
		
		nInsertionPt  = IIF(this.SelStart=0,20,this.SelStart)
		cSearchStrOrig = UPPER(substr(this.value,1,nInsertionPt ))
		lcSearchStr = PrepareSQLtxt(cSearchStrOrig,'ShipRoute',20)
		
		
		IF !empty(lcSearchStr)
		*	=seek(upper(lcSearchStr),"QuotesID","UPPName")
			gnPos = ASCAN(aShipRoutes, lcSearchStr ) && Search for company
			IF gnPos != 0
				this.VALUE=aShipRoutes(gnPos )
			ELSE
				this.value=cSearchStrOrig 
			ENDIF
		ELSE
			this.value=space(0)
		ENDIF
		this.selstart = nInsertionPt 
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.txtShipRoute.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.txtShipRoute.Valid
		PRIVATE cShipRoute, cUPSStandShipRoute
		cShipRoute = This.Value
		IF TYPE("cShipRoute") = "C"
			cShipRoute = ALLTRIM(cShipRoute)
		
			IF UPPER(LEFT(cShipRoute ,3)) = "UPS"
				*RETURN CheckUPSroute(cShipRoute)
				
				cUPSStandShipRoute = GetUPSStandShiproute (cShipRoute, ThisForm.nConnHandle )
				IF EMPTY( cUPSStandShipRoute )
					RETURN .F.
				ELSE
					This.Value = cUPSStandShipRoute
					RETURN .T.
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

