	PROCEDURE frmEdt.Unload
		IF USED('tmpValue')
			USE IN tmpValue
		ENDIF
		IF USED('Graph')
			USE IN Graph
		ENDIF
		IF USED('SalesNum2')
			USE IN SalesNum2
		ENDIF
		IF USED('SalesNum')
			USE IN SalesNum
		ENDIF
		IF USED("PurchaseOrder")
			USE IN PurchaseOrder
		ENDIF
		
		
		IF USED("SalesQuote")
			USE IN SalesQuote
		ENDIF
		IF USED("QuotesSO")
			USE IN QuotesSO
		ENDIF
		IF USED("tmpPoItemDetail")
			USE IN tmpPoItemDetail
		ENDIF
		IF USED("CreditCd")	
			USE IN CreditCd
		ENDIF
		
		IF ThisForm.nConnHandle > -1
		IF VARTYPE(gnConnHandle) = "N"
			IF gnConnHandle = ThisForm.nConnhandle
				* Do not close!
			ELSE
				= SQLDISCONNECT(ThisForm.nConnHandle)
			ENDIF
		ELSE
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		ENDIF
		
		*!*	IF ThisForm.Close_Ship
		*!*		IF USED('SHIP')
		*!*			USE IN SHIP
		*!*		ENDIF
		*!*	ELSE
		*!*		IF USED('SHIP')
		*!*			SELECT SHIP
		*!*			USE SHIP NOUPDATE
		*!*		ENDIF
		*!*	ENDIF
		
		IF ThisForm.Close_Sales
			IF USED('SALES')
				USE IN SALES 
			ENDIF
		ELSE
			IF USED('SALES')
				SELECT Sales
		*		USE SALES NOUPDATE
			ENDIF
		ENDIF
		IF USED('Sales_No')
			USE IN Sales_No
		ENDIF
		
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		
		IF USED('VendorContacts')
			USE IN VendorContacts
		ENDIF
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		
		
		IF USED('SalesTotal')
			USE IN SalesTotal
		ENDIF
	ENDPROC

	PROCEDURE frmPO.chkCancelPO.InteractiveChange
		PRIVATE nHpaPo
		nHpaPo = This.Parent.pgfPO.pgPODesc.txtHpapo.Value
		PRIVATE nDecimal
		IF TYPE("nHpaPo") = "C"
			nDecimal = SET("DECIMAL")
			SET DECIMAL TO 0
			nHpaPo = VAL(nHpaPo)
			SET DECIMAL TO nDecimal
		ENDIF
		
		IF nHpaPo > 0
			IF This.Value = 0
				IF MESSAGEBOX("Are you sure you want to Un-Cancel This PO?",4)= 6
					THISFORM.PO_Valid("UNCANCEL")
				ELSE
					THIS.Value = 1
				ENDIF
			ELSE
				IF MESSAGEBOX("Are you sure you want to Cancel This PO Item?",4)= 6
					THISFORM.PO_Valid("CANCEL")
				ELSE
					THIS.Value = 0
				ENDIF
			ENDIF
		ELSE
			WAIT WINDOW "No PO Number to cancel!"
		ENDIF
		This.Refresh
	ENDPROC

