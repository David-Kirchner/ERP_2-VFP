		RETURN .T.
		
	ENDPROC

	PROCEDURE seeksoldcodeinsoldaddr
		PARAMETERS nSoldCode
		*ThisForm.SeekSoldCodeinSoldAddr(ThisForm.SoldAddr)
		
		PRIVATE lReturn
		lReturn = .T.
		
		IF VARTYPE(nSoldCode) != "N"
			lReturn = .F.
			nSoldCode = 0
		ENDIF
		
		IF USED( 'SoldAddr' )
			USE IN SoldAddr
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.SoldAddr"
		cSQL = cSQL + " WHERE SoldCode = "+STR(nSoldCode)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
			lReturn = .F.
		ENDIF
		
		IF !USED( 'SoldAddr' )
			cSQL = "SELECT * FROM dbo.SoldAddr"
			cSQL = cSQL + " WHERE 0>0"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
				lReturn = .F.
			ENDIF
		ENDIF
		RETURN lReturn 
	ENDPROC

	PROCEDURE seekstartingstock
		PARAMETERS pQID
		*ThisForm.SeekStartingStock(ID)
		
		IF VARTYPE(pQID) != "N"
			pQID = 0
		ENDIF
		
		
		IF USED('StartingStock')
			USE IN StartingStock
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.StartingStock"
		IF pQID < 1
			cSQL = cSQL + " WHERE 0>0 "
		ELSE
			cSQL = cSQL + " WHERE AllQuotes_ID = "+STR(pQID)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StartingStock')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StartingStock')
		ENDDO
		
		IF nSQLEXEC < 0 &&Try again
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StartingStock')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StartingStock')
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StartingStock')
		ENDIF
		
	ENDPROC

	PROCEDURE seekstartingstocksalesnum
		PARAMETERS pSalesNum
		*ThisForm.SeekStartingStockSalesNum(SalesQuote.SalesNum)	
		
		IF VARTYPE(pSalesNum) != "N"
			RETURN .F.
		ENDIF
		
		IF USED('StartingStock')
			USE IN StartingStock
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT SS.*, AQ.SOitem FROM dbo.AllQuotes AQ LEFT OUTER JOIN "
		cSQL = cSQL + " dbo.StartingStock SS ON AQ.ID = SS.AllQuotes_ID "
		cSQL = cSQL + " WHERE AQ.SalesNum = "+STR(pSalesNum)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StartingStock')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StartingStock')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StartingStock')
		ENDIF
		
		IF USED('StartingStock')
			SELECT StartingStock
			INDEX ON SOitem TAG SOitem
			SET ORDER TO TAG SOitem
			
			SELECT SalesQuote
			SET RELATION TO SOitem INTO StartingStock
		ENDIF
		
		
	ENDPROC

	PROCEDURE shiptoclear
		*ThisForm.ShipToClear()
		thisform.POShipAddr = 0
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.Value = 0
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtCompany.VALUE	= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtAddr1.VALUE		= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtAddr2.VALUE		= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtCity.VALUE		= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtST.VALUE			= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtZip.VALUE		= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtCountry.VALUE	= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtContact.VALUE	= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPhone.VALUE		= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtFax.VALUE		= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtEmail.VALUE		= ""
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtLastEdit.VALUE	= ""
		
		*ThisForm.pf.pgAdd.pfAdd.pgShipTo
		*ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr
		
	ENDPROC

	PROCEDURE shipwherechange
		PARAMETERS nShipWhere,cCompany,cCity
		*ThisForm.ShipWhereChange(nShipWhere,cCompany,cCity)
		
		IF VARTYPE( nShipWhere ) != 'N'
			nShipWhere = 1
		ENDIF
		
		PRIVATE cCompany, cCity
		cCompany = PrepareSQLtxt(cCompany,'Company',30)
		cCity	= PrepareSQLtxt(cCity,'City',30)
		
		cCompany = UPPER(ALLTRIM(cCompany))
		cCity	= UPPER(ALLTRIM(cCity))
		
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Visible = .T.
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Visible = .T.
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Visible = .T.
		
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmbRemoteStock.Visible = .F.
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmbRemoteStock.Enabled = .F.
		
		*1 HPA Tipton,2 DIRECT,3 Blind,4 Service,5 HPA Windfall,6 RemoteStock
		DO CASE
		CASE nShipWhere = 1
			IF NOT ( cCompany = "HIGH PERFORMANCE ALLOYS" AND cCity = "TIPTON" )
				ThisForm.POShipTO(1)
			ENDIF
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		CASE nShipWhere = 2
			IF NOT ( cCompany = "HIGH PERFORMANCE ALLOYS" AND cCity = "WINDFALL" )
				ThisForm.POShipTO(5)
			ENDIF
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		CASE nShipWhere = 5
			IF NOT ( cCompany = "HIGH PERFORMANCE ALLOYS" AND cCity = "WINDFALL" )
				ThisForm.POShipTO(5)
			ENDIF
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		CASE nShipWhere = 6
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
		OTHERWISE
			IF cCompany != "HIGH PERFORMANCE ALLOYS"
				IF !EMPTY(cCompany)
					IF MESSAGEBOX( "Are you sure you DO NOT want to ship to HPA ?",4,"PO Ship to" ) = 6
						ThisForm.POShipTO( nShipWhere )
					ELSE
						ThisForm.POShipTO( ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value )
					ENDIF
				ELSE
					ThisForm.POShipTO( nShipWhere )
				ENDIF
			ELSE
				ThisForm.POShipTO( nShipWhere )
			ENDIF
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
		ENDCASE
		
		DO CASE
		CASE nShipWhere = 1
			*HPA Tipton
			ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 1
		CASE nShipWhere = 2
			*DIRECT
			ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 2
		CASE nShipWhere = 3
			*Blind
			ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 3
		CASE nShipWhere = 4
			*Service
			ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 4
		CASE nShipWhere = 5
			*HPA Windfall
			ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 5
		CASE nShipWhere = 6
			*Remote Stock
			ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 6
		
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmbRemoteStock.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmbRemoteStock.Enabled = .T.
		
		ENDCASE
		
	ENDPROC

	PROCEDURE showposhipaddr
		PARAMETER pnPOShipAddr
		*ThisForm.ShowPOShipAddr
		
		IF VARTYPE(pnPOShipAddr) != 'N'
			MESSAGEBOX('Bad parameter to function ShowPOshipAddr')
			RETURN .F.
		ENDIF
		
		WAIT WINDOW "ShowPOShipAdd" NOWAIT
		*ThisForm.ShowPOShipAddr( POShipAddr )
		PRIVATE nPOshipAddr, lBlank
		lBlank = .F.
		
		nPOshipAddr = pnPOShipAddr 
		**THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.VALUE
		
		IF NOT EMPTY(nPOshipAddr)
			IF TYPE("nPOshipAddr") = "N"
				IF nPOshipAddr > 0
					*Get Address and Show
		
					IF USED( 'aShipAddr' )
						USE IN aShipAddr
					ENDIF
					
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.ShipAddr "
					cSQL = cSQL + " WHERE ShipCode = "+STR(nPOshipAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
					ENDIF
					IF USED('aShipAddr')
						thisform.POShipAddr = aShipAddr.ShipCode	
						
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.VALUE = aShipAddr.ShipCode
						*ThisForm.pf.pg_po.pgfPO.pgPOAddress.numShipAddr.Value 	= aShipAddr.ShipCode
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCompany.VALUE 	= aShipAddr.Company
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtAddr1.VALUE 		= aShipAddr.Addr1
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtAddr2.VALUE 		= aShipAddr.Addr2
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCity.VALUE 		= aShipAddr.City
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtST.VALUE 		= aShipAddr.ST
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtZip.VALUE 		= aShipAddr.Zip
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCountry.VALUE 	= aShipAddr.Country
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtContact.VALUE 	= aShipAddr.Contact
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtPhone.VALUE 		= aShipAddr.Telephone
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtFax.VALUE 		= aShipAddr.Fax_Number
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtEmail.VALUE 		= aShipAddr.Email
						THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
						
						ThisForm.ShipWhereChange(aShipAddr.ShipCode,aShipAddr.Company,aShipAddr.City)
						
						IF USED( 'aShipAddr' )
							USE IN aShipAddr
						ENDIF
					ENDIF
		
				ELSE
					lBlank = .T.
				ENDIF
			ELSE
				lBlank = .T.
			ENDIF
		ELSE
			lBlank = .T.
		ENDIF
		
		IF lBlank
			*Show blanks
			ThisForm.POShipAddr = 0
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.VALUE = 0
			*ThisForm.pf.pg_po.pgfPO.pgPOAddress.numShipAddr.Value = aShipAddr( 1, 1 )
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCompany.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtAddr1.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtAddr2.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCity.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtST.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtZip.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCountry.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtContact.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtPhone.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtFax.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtEmail.VALUE = ""
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtLastEdit.VALUE = CtoD("  /  /  ")
			
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
		ELSE
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
		ENDIF
		WAIT CLEAR
		
	ENDPROC

	PROCEDURE showposhipto
		PARAMETERS nShipCode
		*ThisForm.ShowPOShipTo()
		
		IF VARTYPE(nShipCode) != 'N'
			MESSAGEBOX('Bad parameter to function ShowPOShipTo')
			RETURN .F.
		ENDIF
		
		IF USED( 'aShipAddr' )
			USE IN aShipAddr
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE ShipCode = "+STR(nShipCode)
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'aShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'aShipAddr' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC)
		ENDIF
		
		IF USED('aShipAddr')
		
			ThisForm.POShipAddr = aShipAddr.ShipCode
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.VALUE = aShipAddr.ShipCode
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtCompany.VALUE 	= aShipAddr.Company
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtAddr1.VALUE		= aShipAddr.Addr1
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtAddr2.VALUE		= aShipAddr.Addr2
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtCity.VALUE 		= aShipAddr.City
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtST.VALUE			= aShipAddr.ST
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtZip.VALUE		= aShipAddr.Zip
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtCountry.VALUE	= aShipAddr.Country
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtContact.VALUE	= aShipAddr.Contact
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPhone.VALUE		= aShipAddr.Telephone
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtFax.VALUE		= aShipAddr.Fax_Number
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtEmail.VALUE		= PrepareSQLtxt(aShipAddr.Email,'Email',60)
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
		*	ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtLastEdit.VALUE	= aShipAddr.LastEdit &&Do not use PrepareSQL before Init!
		
			IF USED('aShipAddr')
				USE IN aShipAddr
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showpotesting
		PARAMETERS pcPOitem
		*ThisForm.ShowPOTesting( lcPOitem )
		
		IF VARTYPE( pcPOitem ) != "C"
			*pcPOitem = ""
			RETURN
		ENDIF
		
		PRIVATE cPOitem, cSOitem 
		
		IF pcPOitem = "NEW" 
			IF NOT EMPTY(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHpapo.Value)
				cPOitem = Proper_PO_Item( STR(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHpapo.Value)+"-"+STR(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtItemPo.Value) )
			ELSE
				cPOitem = Proper_PO_Item( ThisForm.pf.pg_po.lstPoItems.Value )
			ENDIF
			cSOitem = Proper_SO_item( STR(ThisForm.SalesNum)+"-"+STR(ThisForm.itemnumber))
			
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblPOitem.Caption = cPOitem 
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblSOitem.Caption = cSOitem 
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Value = SalesQuote.Alloy
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtHeat.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtLot.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtForm.Value = SalesQuote.Form
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtSize.Value = SalesQuote.Thck
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtQuantity.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestType.Value = 2
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestPackage.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogDelivery.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogReturnSamples.Value = 2
			
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSpecimen.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogLocation.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileConf.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileTemp.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSonicProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogSonicType.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardConf.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogHardProfile.Value = 2
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbIGCorrProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbStressProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyTemp.Value = ""
			
			THISFORM.POTestingScreen("ENABLE")
			
			RETURN	
		ENDIF
		
		IF NOT (pcPOitem = "BLANK" OR pcPOitem = "NEW" ) &&Have POitem
			*Show the PO_Testing Data
			
			IF USED("tmpPO_Testing")
				USE IN cntSoldAddr
			ENDIF
			cSQL = "SELECT * FROM dbo.PO_Testing"
			cSQL = cSQL + " WHERE POitem = dbo.ProperPO('"+pcPOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_Testing')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_Testing')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_Testing')
			ENDIF
			IF USED("tmpPO_Testing")
				IF VARTYPE(tmpPO_Testing.POitem) = "C"
					
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblPOitem.Caption = tmpPO_Testing.POitem
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblSOitem.Caption = tmpPO_Testing.SOitem
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Value = tmpPO_Testing.Alloy
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtHeat.Value = tmpPO_Testing.Heat
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtLot.Value = tmpPO_Testing.Lot
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtForm.Value = tmpPO_Testing.Form
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtSize.Value = tmpPO_Testing.Size
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtQuantity.Value = tmpPO_Testing.Quantity
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestType.Value = tmpPO_Testing.TestType
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestPackage.Value = tmpPO_Testing.TestPackage
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogDelivery.Value = tmpPO_Testing.DelivService
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogReturnSamples.Value = tmpPO_Testing.ReturnSamples
					
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSpecimen.Value = tmpPO_Testing.SpeciDia
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogLocation.Value = tmpPO_Testing.SpeciLoc
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileProc.Value = tmpPO_Testing.TensileTest
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileConf.Value = tmpPO_Testing.TensileConf
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileTemp.Value = tmpPO_Testing.TensileTemp
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSonicProc.Value = tmpPO_Testing.USonicTest
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogSonicType.Value = tmpPO_Testing.USonicType
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardProc.Value = tmpPO_Testing.HardTest
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardConf.Value = tmpPO_Testing.HardConf
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogHardProfile.Value = tmpPO_Testing.HardProf
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbIGCorrProc.Value = tmpPO_Testing.IGCorrTest
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbStressProc.Value = tmpPO_Testing.StressTest
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyProc.Value = tmpPO_Testing.CharpyTest
					ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyTemp.Value = tmpPO_Testing.CharpyTemp
					
					THISFORM.POTestingScreen("ENABLE")
				ELSE
					MESSAGEBOX("PO item '"+pcPOitem+"' was not found!",0+48,"Not found")
					pcPOitem = "BLANK"
				ENDIF
				IF USED("tmpPO_Testing")
					USE IN tmpPO_Testing
				ENDIF
			ELSE
				MESSAGEBOX("PO item '"+pcPOitem+"' was not found!",0+48,"Not found")
				pcPOitem = "BLANK"
			ENDIF
			
		ENDIF
		
		IF pcPOitem = "BLANK"
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblPOitem.Caption = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblSOitem.Caption = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtHeat.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtLot.Value = 0
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtForm.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtSize.Value = 0
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtQuantity.Value = 0
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestType.Value = 2
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestPackage.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogDelivery.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogReturnSamples.Value = 2
			
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSpecimen.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogLocation.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileConf.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileTemp.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSonicProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogSonicType.Value = 1
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardConf.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogHardProfile.Value = 2
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbIGCorrProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbStressProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyProc.Value = ""
			ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyTemp.Value = ""
			
			THISFORM.POTestingScreen("DISABLE")
			
			RETURN
		ENDIF
	ENDPROC

	PROCEDURE showquote
		PARAMETER pAction
		
		DO CASE
		CASE pAction = "ENABLE"
			THISFORM.pf.pgQuote.txtCompany.Enabled = .T.
			THISFORM.pf.pgQuote.txtName.Enabled = .T.
			THISFORM.pf.pgQuote.chkRL.Enabled = .T.
			THISFORM.pf.pgQuote.chkMetric.Enabled = .T.
			THISFORM.pf.pgQuote.chkService.Enabled = .T.
			THISFORM.pf.pgQuote.txtAlloy.Enabled = .T.
			THISFORM.pf.pgQuote.cmbForm.Enabled = .T.
			THISFORM.pf.pgQuote.cmbCC.Enabled = .T.
			THISFORM.pf.pgQuote.txtPieces.Enabled = .T.
			THISFORM.pf.pgQuote.txtThck.Enabled = .T.
			THISFORM.pf.pgQuote.txtSz2.Enabled = .T.
			THISFORM.pf.pgQuote.txtSz3.Enabled = .T.
			THISFORM.pf.pgQuote.txtPhone.Enabled = .T.
			THISFORM.pf.pgQuote.txtPhone_Ext.Enabled = .T.
			THISFORM.pf.pgQuote.txtCountryC.Enabled = .T.
			ThisForm.pf.pgQuote.txtQComments.Enabled = .T.
			THISFORM.pf.pgQuote.txtQComments.ReadOnly = .F.
			THISFORM.pf.pgQuote.txtDescript.Enabled = .T.
			THISFORM.pf.pgQuote.txtLeadTime.Enabled = .T.
			THISFORM.pf.pgQuote.chkShipOn.Enabled = .T.
			THISFORM.pf.pgQuote.txtShipDue.Enabled = .T.
			THISFORM.pf.pgQuote.txtweight.Enabled = .T.
			THISFORM.pf.pgQuote.txtP_lb.Enabled = .T.
			THISFORM.pf.pgQuote.txtP_Pc.Enabled = .T.
			THISFORM.pf.pgQuote.txtP_Ft.Enabled = .T.
			THISFORM.pf.pgQuote.txtCuts.Enabled = .T.
			THISFORM.pf.pgQuote.txtOtherFld.Enabled = .T.
			THISFORM.pf.pgQuote.txtOtherP.Enabled = .T.
			THISFORM.pf.pgQuote.txtLotP.Enabled = .T.
			THISFORM.pf.pgQuote.txtPO_Num.Enabled = .T.
			
			ThisForm.RefreshQuotesForms( SalesQuote.Form )
			ThisForm.Address_Screen("QuoteToSave")
			
		CASE pAction = "DISABLE"
			THISFORM.pf.pgQuote.txtCompany.Enabled = .F.
			THISFORM.pf.pgQuote.txtName.Enabled = .F.
			THISFORM.pf.pgQuote.chkRL.Enabled = .F.
			THISFORM.pf.pgQuote.chkMetric.Enabled = .F.
			THISFORM.pf.pgQuote.chkService.Enabled = .F.
			THISFORM.pf.pgQuote.txtAlloy.Enabled = .F.
			THISFORM.pf.pgQuote.cmbForm.Enabled = .F.
			THISFORM.pf.pgQuote.cmbCC.Enabled = .F.
			THISFORM.pf.pgQuote.txtPieces.Enabled = .F.
			THISFORM.pf.pgQuote.txtThck.Enabled = .F.
			THISFORM.pf.pgQuote.txtSz2.Enabled = .F.
			THISFORM.pf.pgQuote.txtSz3.Enabled = .F.
			THISFORM.pf.pgQuote.txtPhone.Enabled = .F.
			THISFORM.pf.pgQuote.txtPhone_Ext.Enabled = .F.
			THISFORM.pf.pgQuote.txtCountryC.Enabled = .F.
			THISFORM.pf.pgQuote.txtQComments.ReadOnly = .T.
			THISFORM.pf.pgQuote.txtDescript.Enabled = .F.
			THISFORM.pf.pgQuote.txtLeadTime.Enabled = .F.
		*	THISFORM.pf.pgQuote.chkShipOn.Enabled = .F.
			THISFORM.pf.pgQuote.txtweight.Enabled = .F.
			THISFORM.pf.pgQuote.txtP_lb.Enabled = .F.
			THISFORM.pf.pgQuote.txtP_Pc.Enabled = .F.
			THISFORM.pf.pgQuote.txtP_Ft.Enabled = .F.
			THISFORM.pf.pgQuote.txtCuts.Enabled = .F.
			THISFORM.pf.pgQuote.txtOtherFld.Enabled = .F.
			THISFORM.pf.pgQuote.txtOtherP.Enabled = .F.
			THISFORM.pf.pgQuote.txtLotP.Enabled = .F.
			THISFORM.pf.pgQuote.txtPO_Num.Enabled = .F.
			
			ThisForm.Address_Screen("QuoteToEdit")
			
		CASE pAction = "SAVE"
			ThisForm.SaveQuote()
		
		CASE pAction = "OrderENABLE"
			ThisForm.pf.pgOrder.txtBuyFrom2.Enabled = .T.
			ThisForm.pf.pgOrder.txtHPAPo2.Enabled = .T.
			
			ThisForm.Address_Screen("OrderToSave")
			
		CASE pAction = "OrderDISABLE"
			ThisForm.pf.pgOrder.txtBuyFrom2.Enabled = .F.
			ThisForm.pf.pgOrder.txtHPAPo2.Enabled = .F.
			
			ThisForm.Address_Screen("OrderToEdit")
			
		CASE pAction = "OrderSAVE"
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + "BUYFROM2='"+STRTRAN(ALLTRIM(SalesQuote.BUYFROM2),"'","''")+"',"
			cUpdate = cUpdate + "HPAPO2="+ALLTRIM(STR(SalesQuote.HPAPO2))
			cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(SalesQuote.ID))
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cUpdate)
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cUpdate )
			ENDDO
				
			IF nSQLEXEC < 0
				MESSAGEBOX("Data could not be saved at the SQL Server."+CHR(13)+CHR(13)+"Your edit will show on this screen and print on the report,"+CHR(13)+;
				"the data will revert to orignal when refreshed from the SQL Server."+CHR(13)+CHR(13)+"Edit and Try to save again!",0,"SQL Error")
			ENDIF
		
		ENDCASE
	ENDPROC

