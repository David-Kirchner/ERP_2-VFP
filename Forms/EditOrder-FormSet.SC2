	PROCEDURE frmEdt.pf.pgQuote.CmdEditQuote.Click
		IF This.Caption = "Edit"
			IF USED('tmpShip')
				USE IN tmpShip
			ENDIF
			
			cSQL = " SELECT * FROM dbo.Ship "
			cSQL = cSQL + " WHERE SOItem = '"+SalesQuote.SOItem_A+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpShip')
			ENDIF
			IF USED('tmpShip')
				DECLARE aShipItem(1,2)
				SELECT ShipDate,ShipVia FROM tmpShip INTO ARRAY aShipItem
				IF TYPE("aShipItem(1,1)")="D"
					IF aShipItem (1,1) != CTOD("  /  /  ")
						MESSAGEBOX("This item has SHIPPED!"+CHR(13)+CHR(13)+"You cannot Edit!"+CHR(13)+"Unless Ship.ShipDate is empty!",0,"No Edit")	
					ELSE
						**Prepare Screen for Editing
						ThisForm.ShowQuote("ENABLE")
						This.Caption = "Save"
						This.Parent.cmdCancelQuote.Caption = "Cancel"
						ThisForm.QuoteEditing = .T.
					ENDIF
				ELSE
					**Prepare Screen for Editing
					ThisForm.ShowQuote("ENABLE")
					This.Caption = "Save"
					This.Parent.cmdCancelQuote.Caption = "Cancel"
					ThisForm.QuoteEditing = .T.
				ENDIF
				USE IN tmpShip
			ENDIF
		ELSE
			**This.Caption = "Save"
			ThisForm.SaveQuote()
			ThisForm.ShowQuote("DISABLE")
			This.Caption = "Edit"
			This.Parent.cmdCancelQuote.Caption = "Quote"
			ThisForm.QuoteEditing = .F.
		ENDIF
	ENDPROC

