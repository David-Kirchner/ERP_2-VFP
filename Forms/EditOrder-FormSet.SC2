	PROCEDURE frmEdt.pf.pgOrder.cmdSelectInv.Click
		PRIVATE lcInvForm, nReturnPrice, nWeight, nPieces, nFeet
		
		*lcInvForm = ThisForm.InventoryForm( SalesQuote.Form )
		*lcInvForm = ThisForm.InventoryForm( Quotes.Form )
		
		nWeight = SalesQuote.weight
		IF nWeight = 0
			*Calc Weight
		*	nWeight = ThisForm.CalcWeight( SalesQuote.Pieces, SalesQuote.Alloy, SalesQuote.Form, SalesQuote.Thck, SalesQuote.Sz2, SalesQuote.Sz3 )
		ENDIF
		
		IF SalesQuote.StartStock 
			PRIVATE cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			cssAlloy	= ''
			cssForm		= ''
			cssCC		= ''
			nssPieces	= 0
			nssThck		= 0
			nssSz2		= 0
			nssSz3		= 0
			nssWeight	= 0
			DO GetStartingStock WITH SalesQuote.ID,ThisForm.nConnHandle,cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			
			DO FORM Forms\StockLst_SQL_Quotes WITH "SELECT",cssAlloy, cssForm,cssCC,nssThck,nssSz2,nssSz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,nssPieces,nssWeight				
		ELSE
			DO FORM Forms\StockLst_SQL_Quotes WITH "SELECT",SalesQuote.alloy,SalesQuote.Form,SalesQuote.CC,SalesQuote.thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,SalesQuote.Pieces,SalesQuote.weight
		ENDIF
		
		
		
		ThisForm.sumStockLstCost()
		ThisForm.didSOitem_UseStock()
		
		lVis = WVISIBLE('frmEdt')
		IF lVis
		*	MESSAGEBOX( "If you did not just leave the 'Select from Inventory' window,"+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",32,"frmEdt is Visible")
		ELSE	
			MESSAGEBOX( "frmEdt has not been activated, has been hidden, has been deactivated, or doesn't exist"+CHR(13)+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",16,"frmEdt is Visible")
		ENDIF
		ACTIVATE WINDOW frmEdt TOP
		
		*THISFORM.pf.pgQuote.txtItemCost.REFRESH()
		THISFORM.pf.pgOrder.chkInv.REFRESH  &&SalesQuote.inv
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgOrder.txtBuyCost.Valid
		*SalesQuote.LotCost
		IF SalesQuote.buycost > 0 AND EMPTY(SalesQuote.ItemCost)
			SELECT SalesQuote
			REPLACE ItemCost WITH SalesQuote.buycost IN SalesQuote
			
			PRIVATE cSQLu, nSQLEXEC 
			cSQLu = "UPDATE dbo.Sales SET "
			cSQLu = cSQLu + "ItemCost="+STR(SalesQuote.buycost,9,2)+""
			cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+SalesQuote.SoItem_a+"')"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
			ENDDO
			
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
			ENDIF
			
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
			
			THIS.PARENT.PARENT.pgQuote.txtItemSale.REFRESH()
		ELSE
			IF SalesQuote.buycost > 0 AND !EMPTY(SalesQuote.ItemCost) AND SalesQuote.buycost <> SalesQuote.ItemCost
				IF MESSAGEBOX("This buy cost field is seperate from the Quotes page, Cost field."+CHR(13)+CHR(13)+"Use this Buy cost as actual cost from supplier."+CHR(13)++CHR(13)+"The Quotes Cost field value is now "+ALLTRIM(STR(SalesQuote.ItemCost,10,2))+CHR(13)+"Do you want to replace the Quotes Cost field with "+ALLTRIM(STR(THIS.VALUE,10,2)),4+48,"The Quotes Cost field will be used to estimate profit.") = 6
					SELECT SalesQuote
					REPLACE ItemCost WITH SalesQuote.buycost IN SalesQuote
					
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu + "ItemCost="+STR(SalesQuote.buycost,9,2)+""
					cSQLu = cSQLu + " WHERE SOitem = '"+SalesQuote.SoItem_a+"'"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
		
					IF nSQLEXEC < 0 &&Try again!, long triger
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
					ENDIF
					
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
					THIS.PARENT.PARENT.pgQuote.txtItemSale.REFRESH()
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

