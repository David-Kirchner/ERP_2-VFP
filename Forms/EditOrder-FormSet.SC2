	PROCEDURE frmPO.pgfPO.pgPODesc.cmdShowVendors.Click
		PRIVATE cCompany, nVendCode
		nVendCode = PrepareSQLnum(ThisForm.Vendcode,'VendCode',-3)
		cCompany = PrepareSQLtxt(This.Parent.txtCompany.Value,'Company',30)
		
		lcCurrTable = ALIAS()
		
		DO FORM Forms\SearchForm WITH "Vendor",cCompany TO nVendCode 
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nVendCode > 0
			ThisForm.VendCode = nVendCode 
			
			ThisForm.CheckVendCode()
			
			IF USED( 'tmpVendor' )
				USE IN tmpVendor
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT Company,PeachID,VendCode  FROM dbo.Vendor "
			cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendor')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendor' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpVendor')
			ENDIF
					
			IF USED('tmpVendor') 
				IF VARTYPE(tmpVendor.PeachID) = "C"
					This.Parent.lblVendCode.Caption = STR(tmpVendor.VendCode)
					This.Parent.lblPeachID.Caption = PrepareSQLtxt(tmpVendor.PeachID,'PeachID',20)
					This.Parent.txtCompany.Value = tmpVendor.Company
					ThisForm.FillVendorAddr(tmpVendor.VendCode)
				ENDIF		
				
				USE IN tmpVendor
			ENDIF
		ENDIF
	ENDPROC

