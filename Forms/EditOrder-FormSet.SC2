	PROCEDURE seekshipcodeinshipaddr
		PARAMETERS nShipAddr
		*ThisForm.SeekShipCodeinShipAddr(ThisForm.ShipAddr)
		IF VARTYPE(nShipAddr) != "N"
			RETURN .F.
		ENDIF
		
		IF USED( 'ShipAddr' )
