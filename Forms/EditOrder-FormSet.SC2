	PROCEDURE po_saveadd
		PARAMETER pSaveType
		*ThisForm.PO_SaveAdd()
		PRIVATE lPOSaveLst, lPOSaveOK 
		lPOSaveLst = .F.
		lPOSaveOK= .T.
		*SELECT PurchaseOrder
		PRIVATE lSQLgood, lMany_ID_Details 
		lSQLgood = .T.
		lMany_ID_Details = .F.
		
		
		PRIVATE nHpaPo, nItemPo, vSalesNum, nSalesNum
		PRIVATE cBuyFrom, cCompany, cSalesP
		PRIVATE nPieces, cAlloy, cDispAlloy, cForm, cCC, nThck, nStandSize, nSz2, nSz3
		PRIVATE nP_lb, nP_pc, nP_ft, nLotP, nOtherP, cOtherFld, nOrder_Qty, nStockLst_QTY, nStockLst_P
		PRIVATE cPOSalesP, cShipVia, cJobNumber, cStock
		PRIVATE	dOrderDate, dDue_Min, dDue_Max, dHPA_Due_Min, dHPA_Due_Max, dFirst_Due_Max, cCond_Spec, cMisc_purch
		PRIVATE lSheet_pk, lServicesPO,lConvServ,lEquipment, lRandLen, lMetric, nShipWhere, cShipLocation
		PRIVATE nMWeight,cBrandName, cTerms, cFOB, cSz1,cSz2,cSz3
		PRIVATE nVendCode, nContactID, cPeachID
		PRIVATE nPWeight, nPPC, nPFt, nPU
		
		nHpaPo			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtHPApo.VALUE,'HPA PO',-3,0)
		nItemPo			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtItempo.VALUE,'Item PO',2,0)
		nItemSO			= SalesQuote.Item_A
		vSalesNum		= SalesQuote.SalesNum_a
		*vSalesNum		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtSalesNum.VALUE,'SalesNum',9,.F.)
		*nItemSO			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtitem.VALUE,'item SO',2,0)
		
		nVendCode		= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblVendCode.Caption,'VendCode',-3,0)
		cPeachID		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblPeachID.Caption,'PeachID',20,.F.)
		nContactID		= PrepareSQLnum(ThisForm.nContactID,"ContactID",-3)
		
		cCompany		= ALLTRIM(PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtCompany.VALUE,'Company',30,.F.))
		cBuyFrom		= LEFT(cCompany,15)
		
		cSalesP			= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtSalesP.VALUE,'SalesP',1,.F.)
		nPieces			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtPieces.VALUE,'Pieces',6,0)
		cAlloy			= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtAlloy.VALUE,'Alloy',12,.F.)
		cDispAlloy		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDispAlloy.VALUE,'DispAlloy',20,.F.)
		cForm			= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.cmbForm.VALUE,'Form',2,.T.)
		cCC				= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.cmbCC.VALUE,'CC',1,.T.)
		nThck			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtThck.VALUE,'Thck',10,4)
		nStandSize		= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtStandSize.VALUE,'StandSize',10,4)
		nSz2			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtSz2.VALUE,'Sz2',9,3)
		nSz3			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtSz3.VALUE,'Sz3',9,3)
		nStockLst_QTY	= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtStockLst_QTY.VALUE,'StockLst_QTY',-5)
		nStockLst_P		= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtStockLst_P.VALUE,'StockLst_P',-5)
		nP_lb			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_lb.VALUE,'P_Lb',8,2)
		nP_pc			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_pc.VALUE,'P_Pc',9,2)
		nP_ft			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_ft.VALUE,'P_Ft',8,2)
		nLotP			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtLotP.VALUE,'LotP',9,2)
		nOtherP			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOtherP.VALUE,'OtherP',8,2)
		cOtherFld		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOtherFld.VALUE,'OtherFld',10,.F.)
		nOrder_Qty		= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOrder_Qty.VALUE,'Order_Qty',11,3)
		cPOSalesP		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtPOSalesName.VALUE,'PO Sales P',20,.F.)
		cShipVia		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtShipVia.VALUE,'ShipVia',20,.F.)
		cJobNumber		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtJobNumber.VALUE,'JobNumber',20,.F.)
		cStock			= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.cmbStock.VALUE,'Stock',13,.F.)
		dOrderDate		= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOrderDate.VALUE,'OrderDate')
		
		dDue_Min		= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Min.VALUE,'Due_Min')
		dDue_Max		= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Max.VALUE,'Due_Max')
		dHPA_Due_Min	= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtHPA_Due_Min.VALUE,'HPA_Due_Min')
		dHPA_Due_Max	= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtHPA_Due_Max.VALUE,'HPA_Due_Max')
		cCond_Spec		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtCond_Spec.VALUE,'Cond_Spec',-1,.F.)
		cMisc_purch		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtMisc_purch.VALUE,'Misc_Purchase',0,.F.)
		lSheet_pk		= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE,'SPS1')
		lServicesPO		= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.VALUE,'ServicesPO')
		lConvServ		= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.VALUE,'ConvServ')
		lEquipment		= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkEquipment.VALUE,'Equipment')
		nPOShipAddr		= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.Value,'POShipAddr',-3,0)
		nPOPayAddr		= 0 &&ThisForm.pf.pg_po.pgFPO.pgPOdesc.txt.VALUE
		lRandLen		= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkRandLen.VALUE,'RandLen')
		lMetric			= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkMetric.VALUE,'Metric')
		nShipWhere 		= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.cmbShipWhere.VALUE,'ShipWhere',1,0)
		
		*nShipWhere		= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgPOAddress.opgPOShipTo.Value,'ShipWhere',1,0)
		cShipLocation	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmbRemoteStock.Value,'ShipLocation',10)
		nMWeight		= 0
		cTerms			= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOAddress.txtTerms.VALUE,'Terms',50,.F.)
		cFOB			= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOAddress.txtFOB.VALUE,'FOB',50,.F.)
		
		cSz1			= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.VALUE,'Sz1Orig',20,.F.)
		cSz2			= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.VALUE,'Sz2Orig',20,.F.)
		cSz3			= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.VALUE,'Sz3Orig',20,.F.)
		
		nPWeight	= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtStockLst_QTY.VALUE,'StockLst_QTY',-5)
		nPPC		= IIF(nPieces = 0, 1, nPieces )
		nPU 		= GetPUfromForm(cForm, ThisForm.nConnHandle)
		IF nPU = 2
			IF Uses3rdDim(cForm, ThisForm.nConnHandle)
				IF nSz3 = 0
					nPFt = 0
					*Error
				ELSE
					nPFt = nPPC * nSz3 / 12
				ENDIF
			ELSE
				IF nSz2 = 0
					nPFt = 0
					*Error
				ELSE
					nPFt = nPPC * nSz2 / 12
				ENDIF
			ENDIF
		ELSE
			nPFt = 0
		ENDIF
		
		
		IF nItemPo = 0
			nItemPo = 1
		ENDIF
		
		IF lMetric
			IF EMPTY(cSz1+cSz2+cSz3)
				MESSAGEBOX("This PO is marked as Metric,"+CHR(13)+"but there are no 'Metric Sizes' entered."+CHR(13)+CHR(13)+"On the Purchase tab, the Testing / Materials page has 'Metric Sizes'"+CHR(13)+"Keep Description tab: Thck, Sz2, Sz3 as Inch!",0+64,"Please Enter the 'Metric Sizes' to keep this order Metric!")
				lPOSaveOK = .F.
			ELSE
				cDescript = "Description  "+ItemDescriptionMetric (cForm,nThck,nSZ2,nSZ3,nOrder_Qty,lRandLen,lMetric,cSz1,cSz2,cSz3)
				MESSAGEBOX("This Metric PO will shown on printed PO as:"+CHR(13)+cDescript,0+64,"Metric Description")	
			ENDIF
		ENDIF
		
		nWeight	= 0
		IF nP_lb > 0
			IF nOrder_Qty > 0
				nWeight	= nOrder_Qty
			ENDIF
		ENDIF
		
		*Check nStockLst_QTY is also in nZ23 fields when Form requires
		IF nSz2 = 0
			IF RequireSZ2LBS(cForm,ThisForm.nConnHandle)
				IF nStockLst_QTY = 0
					*
				ELSE	
					nSZ2 = nStockLst_QTY
					IF nPieces > 0
						nSZ2 = nStockLst_QTY / nPieces
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		IF nSz3 = 0
			IF RequireSZ3LBS(cForm,ThisForm.nConnHandle)
				IF nStockLst_QTY = 0
					*
				ELSE	
					nSZ3 = nStockLst_QTY
					IF nPieces > 0
						nSZ3 = nStockLst_QTY / nPieces
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE  nS_Total, nS_PU
		nS_Total	= nStockLst_QTY * nStockLst_P
		nS_PU		= GetPUfromForm(cForm, ThisForm.nConnHandle)
		
		PRIVATE	cPoItem, cSOitem
		cPOItem = Proper_PO_item( STR(nHPApo)+"-"+STR(nItemPo,2,0) )
		
		IF nItemSO < 0
			nItemSO = 0
			MESSAGEBOX("SO Item was reset to '0'",0+48,"Cannot be less than zero.")
		ENDIF
		
		nSalesNum = 0
		IF TYPE('vSalesnum') = "C"
			IF UPPER(vSalesnum) = "STOCK" OR UPPER(vSalesnum) = "STCK" OR UPPER(vSalesnum) = "STK"
				cSOItem = "STOCK"
				nSalesNum = 0
				nItemSO = 0
			ELSE
				cSOItem = Proper_SO_item( STR(VAL(vSalesNum))+"-"+STR(nItemSO,2,0) )
				nSalesNum = VAL(vSalesnum)
			ENDIF
		ENDIF  
		
		IF TYPE('vSalesnum') = "N"
		*	vSalesNum = PrepareSQLnum(ThisForm.pf.pgAdd.pfAdd.pgPODesc.txtSalesNum.VALUE,'SalesNum',-3)
			vSalesNum = PrepareSQLnum(ThisForm.pf.pgOrder.txtSalesnum.Value,'SalesNum',-3)
		*	vSalesNum = PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtSalesNum.VALUE,'SalesNum',-3)
			cSOItem = Proper_SO_item( STR(vSalesnum)+"-"+STR(nItemSO,2,0) )
			nSalesNum = vSalesnum
			vSalesNum = STR(nSalesNum)
		ENDIF
		
		IF cSOitem = Proper_SO_item( STR(0)+"-"+STR(0) )
			cSOItem = "STOCK"
			nSalesNum = 0
			nItemSO	 = 0
		ENDIF
		IF nSalesNum = 0
			cSOItem = "STOCK"
			nItemSO	 = 0
		ENDIF
		
		IF lServicesPO
		*	nSalesNum = 0
			cSOItem = "LabService"
		ENDIF
		IF lConvServ
		*	nSalesNum = 0
			cSOItem = "ConvertSVC"
		ENDIF
		IF lEquipment
		*	nSalesNum = 0
			cSOItem = "Equipment"
		ENDIF
		
		IF cShipLocation = "*"
			cShipLocation = ""
		ENDIF
		
		******************************
		**Check Data
		IF nHpaPo = 0
			MESSAGEBOX("Cannot save with HPA PO of 0",0+16,"Save Error")
			RETURN .F.
		ENDIF
		IF nItemPo = 0
			MESSAGEBOX("Cannot save with HPA PO item of 0",0+16,"Save Error")
			RETURN .F.
		ENDIF
		IF TYPE("lServicesPO")="N"
			lServicesPO = (lServicesPO=1)
		ENDIF
		IF TYPE("lConvServ")="N"
			lConvServ = (lConvServ=1)
		ENDIF
		
		IF TYPE("lEquipment")="N"
			lEquipment = (lEquipment=1)
		ENDIF
		IF TYPE("cStock")<>"C"
			cStock ="No Stock"
		ELSE
			IF ISNULL("cStock")
				cStock ="No Stock"
			ENDIF
			IF EMPTY("cStock")
				cStock ="No Stock"
			ENDIF
		ENDIF
		
		IF NOT lServicesPO
			IF EMPTY(dHPA_Due_Min) AND EMPTY(dHPA_Due_Max) 
				MESSAGEBOX("You did NOT enter an expected Due Date."+CHR(13)+"Vendor performance cannot be evaluated without these dates.",0+64,"No Expected date.")
				IF NOT EMPTY(dDue_Min) OR NOT EMPTY(dDue_Max) 
					*Set Expected Due min to latest vendor ship date
					dHPA_Due_Min = GetLatestDate( dDue_Max, dDue_Min )
				ENDIF
			ELSE
				*Check Vendor ship dates to the PO receive due date.
				PRIVATE dLatestDueIn
				dLatestDueIn = GetLatestDate( dHPA_due_min, dHPA_due_max )
				IF NOT EMPTY(dDue_Min)
					IF dDue_Min = GetLatestDate( dLatestDueIn, dDue_Min )
						MESSAGEBOX("Your 'Vendor ship by min' is less than the 'PO receive max'!",0+64,"PO receive is before ship min!")
					ENDIF
				ELSE
					IF NOT EMPTY(dDue_Max)
						IF dDue_Max = GetLatestDate( dLatestDueIn, dDue_Max )
							MESSAGEBOX("Your Vendor ship by max is less than the PO receive max!",0+64,"PO receive is before ship max!")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			*Check PO receive due to the SO Ship Due date.
			PRIVATE dShipDue
			dShipDue = get_ShipDue(cSOitem,ThisForm.nConnHandle)
			IF VARTYPE(dShipDue) = "T"
				dShipDue = TTOD(dShipDue)
			ENDIF
			IF VARTYPE(dShipDue) = "D"
				IF NOT EMPTY(dShipDue)
					IF dHPA_due_min = GetLatestDate( dHPA_due_min, dShipDue )	
						dShipDue = dHPA_due_min	+2
						MESSAGEBOX("The ordered material for this SO "+ALLTRIM(cSOitem)+" was entered to not arrive before you need to ship it."+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+48,"SO was set be late!")
					ELSE
						IF dHPA_due_max = GetLatestDate( dHPA_due_min, dShipDue )		
							dShipDue = dHPA_due_max	+2
							MESSAGEBOX("The ordered material for this SO "+ALLTRIM(cSOitem)+" was entered to not arrive before you need to ship it, "+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+64,"SO could be late")
						ENDIF
					ENDIF
				ELSE	
					IF NOT EMPTY(dHPA_due_max)
						dShipDue = dHPA_due_max + 3
						MESSAGEBOX("No ShipDue date found!"+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+64,"No ShipDue date entered.")
					ELSE
						IF NOT EMPTY(dHPA_due_min )
							dShipDue = dHPA_due_min + 7
							MESSAGEBOX("No ShipDue date found!"+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+64,"No ShipDue date entered.")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		******************************
		IF EMPTY(dOrderdate)
			dOrderdate = DATE()
			MESSAGEBOX( "Orderdate was set to today!",0+48,"Orderdate error")
		ENDIF
		IF dOrderdate + 365 < DATE()
			IF MESSAGEBOX( "Order Date '"+ALLTRIM(DTOC(dOrderdate))+"' is more than 1 year old! "+CHR(13)+"Are you Sure you want to save this PO?",4+32,"Orderdate error")=6
				TrackMess("Editing old PO# "+ALLTRIM(STR(nHPApo))+". Order Date '"+ALLTRIM(DTOC(dOrderdate))+"' is more than 1 year old! "+" frmEdt.PO_saveAdd()" )
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		IF dOrderdate - 730 > DATE()
			MESSAGEBOX( "Orderdate is more than 2 years out!",0+16,"Orderdate error")
			RETURN .F.
		ENDIF
		IF NOT EMPTY(dDue_Min)
			IF dDue_Min+ 365 < DATE()
				MESSAGEBOX( "Due_Min is more than 1 year past due!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
			IF dDue_Min- 730 > DATE()
				MESSAGEBOX( "Due_Min is more than 2 years out!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
		ENDIF
		IF NOT EMPTY(dDue_Max)
			IF dDue_Max+ 365 < DATE()
				MESSAGEBOX( "Due_Max is more than 1 year past due!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
			IF dDue_Max- 730 > DATE()
				MESSAGEBOX( "Due_Max is more than 2 years out!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
		ENDIF
		
		IF NOT EMPTY(dHPA_Due_Min)
			IF dHPA_Due_Min+ 365 < DATE()
				MESSAGEBOX( "HPA_Due_Min is more than 1 year past due!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
			IF dHPA_Due_Min- 730 > DATE()
				MESSAGEBOX( "HPA_Due_Min is more than 2 years out!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
		ENDIF
		IF NOT EMPTY(dHPA_Due_Max)
			IF dHPA_Due_Max+ 365 < DATE()
				MESSAGEBOX( "HPA_Due_Max is more than 1 year past due!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
			IF dHPA_Due_Max- 730 > DATE()
				MESSAGEBOX( "HPA_Due_Max is more than 2 years out!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
		ENDIF
		
		******************************
		
		IF NOT EMPTY(dHPA_Due_Max)
			dFirst_Due_Max = dHPA_Due_Max
		ELSE
			IF NOT EMPTY(dHPA_Due_Min)
				dFirst_Due_Max = dHPA_Due_Min
			ELSE
				IF NOT EMPTY(dDue_Max)
					dFirst_Due_Max = dDue_Max
				ELSE
					IF NOT EMPTY(dHPA_Due_Min)
						dFirst_Due_Max = dDue_Min
					ELSE
						dFirst_Due_Max = ''
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**Check Price
		*nP_lb, nP_pc, nP_ft, nLotP
		
		PRIVATE lHaveOtherP
		lHaveOtherP = .F.
		IF nLotP > 0
			lHaveOtherP = .T.
		ENDIF
		IF nP_ft > 0
			IF lHaveOtherP 
				MESSAGEBOX( "You have overlaping pricing."+CHR(13)+"Price/Ft will show before Lot Price.",48,"Confusing price.")
			ENDIF
			lHaveOtherP = .T.
		ENDIF
		
		IF nP_pc> 0
			IF lHaveOtherP 
				IF nP_ft > 0
					MESSAGEBOX( "You have overlaping pricing."+CHR(13)+"Price/Pc will show before Price/Ft.",48,"Confusing price.")
				ELSE
					MESSAGEBOX( "You have overlaping pricing."+CHR(13)+"Price/Pc will show before Lot Price.",48,"Confusing price.")
				ENDIF
			ENDIF
			lHaveOtherP = .T.
		ENDIF
		
		IF nP_lb> 0
			IF lHaveOtherP 
				IF nP_pc > 0
					MESSAGEBOX( "You have overlaping pricing."+CHR(13)+"Price/Lb will show before Price/Pc.",48,"Confusing price.")
				ELSE
					IF nP_ft > 0
						MESSAGEBOX( "You have overlaping pricing."+CHR(13)+"Price/Pc will show before Price/Ft.",48,"Confusing price.")
					ELSE
						MESSAGEBOX( "You have overlaping pricing."+CHR(13)+"Price/Pc will show before Lot Price.",48,"Confusing price.")
					ENDIF
				ENDIF
			ENDIF
			lHaveOtherP = .T.
		ENDIF
		
		IF nOrder_Qty < 1
			IF nLotP > 0
				*Default to 1 on LotPrice
				nOrder_Qty = 1
			ELSE
				MESSAGEBOX("Please enter the number of units to be priced.",48,"Units priced is empty!")
			ENDIF
		ENDIF
		
		IF nStockLst_QTY <= 0
			MESSAGEBOX("Please enter the HPA Accounting number of units 'Stock' to be priced.",48,"HPA Stock Units priced is empty!")
		ENDIF
		IF nStockLst_P <= 0
			MESSAGEBOX("Please enter the price per Unit.",48,"Price is empty!")
		ENDIF
		
		
		
		***********
		IF lPOSaveOK 
			IF nSalesNum > 0
				*Check to see if SalesNum Exists
				PRIVATE nCount
				nCount = Count_SOinSales(nSalesNum, ThisForm.nConnHandle )
				IF nCount < 1
					MESSAGEBOX("Sales Order:"+ALLTRIM(nSalesNum)+" was not found!"+CHR(13)+"Clear the SO if buying for stock.",48,"Bad HPA SO - Cannot save - Retry Save.")
					lPOSaveOK = .F.
				ENDIF
			ENDIF
		ENDIF
		
		***********
		IF lPOSaveOK 
			IF nSalesNum > 0
				IF AT("-",cSOitem,1) > 0
					*Check to see if SOitem Exists
					PRIVATE nCount
					nCount = Count_SOIteminSales(cSOItem, ThisForm.nConnHandle)
					IF nCount < 1
						MESSAGEBOX("Sales Order Item:"+ALLTRIM(cSOitem)+" was not found!"+CHR(13)+"Clear the SO if buying for stock.",48,"Bad SO item - Cannot save - Retry Save.")
						lPOSaveOK = .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		***********
		IF lPOSaveOK 
			IF EMPTY(cCompany)
				MESSAGEBOX("You must enter a 'Buy from Company' name !",48,"No Vendor - Cannot save.")
				lPOSaveOK = .F.
			ENDIF
		ENDIF
		
		
		***********
		IF lPOSaveOK 
			*Check approved Vendor
			IF nVendCode = 0
				nVendCode = getVendCode_Company(cCompany,ThisForm.nConnHandle)
			ENDIF
		
			IF nVendCode > 0
				IF NOT VendorApproved_VendCode(nVendCode,ThisForm.nConnHandle)
		*			PRIVATE cBody
		*			cBody = 'PO:'+HTML_PO(nHpaPo)+' used unapproved vendor:'+cCompany+CHR(10)+CHR(13)+"VendCode:"+ALLTRIM(STR(nVendCode))+CHR(10)+CHR(13)+"SalesP:"+cSalesP
		*			cBody = cBody + " Sales Person:"+AppSetup_Get_UserName(cSalesP)+CHR(10)+CHR(13)+"frmEdt:PO_SaveAdd()"
		*			Send_HTML_Email( 'QA@hpalloy.com','Bobwhite@hpalloy.com','PO:'+ALLTRIM(STR(nHpaPo))+' used unapproved vendor',cBody,ThisForm.nConnHandle,.F.,.T.)
					PRIVATE m.MsgNoteHTML 
					m.MsgNoteHTML = "<!DOCTYPE html><html><body>"
					m.MsgNoteHTML = m.MsgNoteHTML +[<a href="]
					m.MsgNoteHTML = m.MsgNoteHTML +[http://bobwhite/ReportServer/Pages/ReportViewer.aspx?%2fHPA+Purchasing+Reports%2fPurchaseOrders&rs:Command=Render&hpapo=]+ALLTRIM(STR(nHpaPo))
					m.MsgNoteHTML = m.MsgNoteHTML +[">]+"PO:"+ALLTRIM(STR(nHpaPo))+[</a>]
					m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
					m.MsgNoteHTML = m.MsgNoteHTML +[ unapproved Vendor:]+ALLTRIM(cCompany)
					m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
					m.MsgNoteHTML = m.MsgNoteHTML +[ VendCode:]+ALLTRIM(STR(nVendCode))
					m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
					m.MsgNoteHTML = m.MsgNoteHTML +[ SalesP:]+cSalesP+' '+AppSetup_Get_UserName(cSalesP)
					m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
					m.MsgNoteHTML = m.MsgNoteHTML +[ PurchaseOrder:SaveAdd()]
					m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
					m.MsgNoteHTML = m.MsgNoteHTML+[</body></html>]
		
					Send_HTML_Email( 'QA@hpalloy.com','Bobwhite@hpalloy.com','PO:'+ALLTRIM(STR(nHpaPo))+' used unapproved vendor',m.MsgNoteHTML ,ThisForm.nConnHandle,.F.,.T.)
					
					MESSAGEBOX( "'Unapproved Vendor' message sent to QA",0+48,"PR-74-01 6.1")
				ENDIF
				
			ELSE
				*Old School check
				cCompany = ALLTRIM(cCompany)
				PRIVATE lcTryVendor
				lcTryVendor  = ''
		
				IF !EMPTY(cCompany)
					lcTryVendor = ALLTRIM(SearchVendorCompany(cCompany , "BEGINS", ThisForm.nConnHandle ))
					IF NOT EMPTY(lcTryVendor)		
						IF UPPER(cCompany) = UPPER(lcTryVendor)
							
							*Notifty QA
							*PARAMETERS pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, pConn, lQuiet, lNoHeadder
							*Send_HTML_Email( 'DavidKirchner@yahoo.com','David@hpalloy.com','Test','Just Testing',0,.T.,.T.)
							
							IF VendorApproved_Company(cCompany,cSalesP,ThisForm.nConnHandle)
								**
								nVendCode = getVendCode_Company(cCompany,ThisForm.nConnHandle)
								**
							ELSE
								*cBody = 'PO:'+HTML_PO(nHpaPo)+' used unapproved vendor:'+cCompany+CHR(10)+CHR(13)+"VendCode: ---"+CHR(10)+CHR(13)+"SalesPerson:"+cSalesP
								*cBody = cBody + " Sales Person:"+AppSetup_Get_UserName(cSalesP)+CHR(10)+CHR(13)+"frmEdt:PO_SaveAdd()"
								*Send_HTML_Email( 'QA@hpalloy.com','Bobwhite@hpalloy.com','PO:'+ALLTRIM(STR(nHpaPo))+' used unapproved vendor',cBody,ThisForm.nConnHandle,.F.,.T.)
								PRIVATE m.MsgNoteHTML 
								m.MsgNoteHTML = "<!DOCTYPE html><html><body>"
								m.MsgNoteHTML = m.MsgNoteHTML +[<a href="]
								m.MsgNoteHTML = m.MsgNoteHTML +[http://bobwhite/ReportServer/Pages/ReportViewer.aspx?%2fHPA+Purchasing+Reports%2fPurchaseOrders&rs:Command=Render&hpapo=]+ALLTRIM(STR(nHpaPo))
								m.MsgNoteHTML = m.MsgNoteHTML +[">]+"PO:"+ALLTRIM(STR(nHpaPo))+[</a>]
								m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
								m.MsgNoteHTML = m.MsgNoteHTML +[ unapproved Vendor:]+ALLTRIM(cCompany)
								m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
								m.MsgNoteHTML = m.MsgNoteHTML +[ VendCode:]+ALLTRIM(STR(nVendCode))
								m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
								m.MsgNoteHTML = m.MsgNoteHTML +[ SalesP:]+cSalesP+' '+AppSetup_Get_UserName(cSalesP)
								m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
								m.MsgNoteHTML = m.MsgNoteHTML +[ PurchaseOrder:SaveAdd()]
								m.MsgNoteHTML = m.MsgNoteHTML  +[<br />]
								m.MsgNoteHTML = m.MsgNoteHTML+[</body></html>]
		
								Send_HTML_Email( 'QA@hpalloy.com','Bobwhite@hpalloy.com','PO:'+ALLTRIM(STR(nHpaPo))+' used unapproved vendor',m.MsgNoteHTML ,ThisForm.nConnHandle,.F.,.T.)
		
								MESSAGEBOX( "'Unapproved Vendor' message sent to QA",0+48,"PR-74-01 6.1")
							ENDIF
		
						ELSE
							WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
						ENDIF
					ELSE
						WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
					ENDIF
				ELSE
					WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
				ENDIF
			ENDIF
		ENDIF
		
		***********
		IF lPOSaveOK 
			IF TYPE("nShipWhere") != "N" 
				nShipWhere= ThisForm.pf.pg_po.pgFPO.pgPOdesc.cmbShipWhere.Value
				IF TYPE("nShipWhere") != "N" 
					MESSAGEBOX( [TYPE("nShipWhere") != "N" ],0,"Tell David" )
					nShipWhere = 1
				ENDIF
			ENDIF
		ENDIF
		
		*******
		
		PRIVATE lDelivered  &&1=Tipton, 2=DIRECT 3=Blind 4=Service 5=Windfall 6=RemoteStock
		IF nShipWhere = 2 OR nShipWhere = 3 OR nShipWhere = 4 OR nShipWhere = 6 &&Direct,Blind,Service,RemoteStock
			lDelivered = .T.
		ELSE
			*Do not force a .F.
			lDelivered = PrepareSQLchk(ThisForm.pf.pg_po.ChkDeliveredPO.Value ,'Delivered')
		ENDIF
		
		***********
		IF lPOSaveOK 
			*Check PO expected date to SO Ship Date
		
		ENDIF
		
		*****
		IF lPOSaveOK 
			PRIVATE nCntPOitem,nCntPO 
			IF nHPAPo > 0
				nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle )
				nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
			ELSE
				nCntPO = 0
				nCntPOitem = 0
			ENDIF
		
			IF ThisForm.PONewAdd &&AND nCntPO > 0
				nHPApoOld = nHpapo 
				
				IF nHPAPo > 0 AND nCntPOitem > 0
					*nCntPO > 0
					cMess = Get_SOSalesPCompinPurchaseOrder( nHpaPo, ThisForm.nConnHandle )
					IF VARTYPE(cMess)!="C"
						cMess= " "
					ENDIF
					MESSAGEBOX("You started with a new PO number, But it is allready being used!"+CHR(13)+cMess,0+48,"Getting Another PO#")
		
					nHpapo = GetNextPurchaseOrder(ThisForm.nConnHandle)
					nItemPo = 1
					
					ThisForm.pf.pg_PO.pgfPO.pgPODesc.txtHPAPo.Value		= nHpapo 
					ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtHpapo.Value	= nHpapo 
					ThisForm.pf.pg_po.pgfPO.pgPODesc.txtItempo.Value	= nItemPo 
					ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtItempo.Value	= nItemPo 
		
					cPOItem = Proper_PO_Item( STR(nHPApo)+"-"+STR(nItemPo ,2,0) )
					
					MESSAGEBOX("Your PO number is now "+ALLTRIM(STR(nHpapo))+".",0+48,"New PO")
		
				ENDIF
			ENDIF
		ENDIF
		*****
		IF IsAlloyBrandName( cDispAlloy,ThisForm.nConnHandle )
			cBrandName = cDispAlloy
		ELSE
			cBrandName = ""
		ENDIF
		
		******************* 
		*End PO Check
		
		*	IF pSaveType = "MAKECLONE"
		
		
		*****
		IF lPOSaveOK 
			PRIVATE nMaxPO
			nMaxPO = 0
			IF USED('cntPO')
				USE IN cntPO
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT MAX(hpapo) as MaxPO FROM dbo.PurchaseOrder"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPO' )
			ENDIF
		
			IF USED('cntPO')
				nMaxPO = cntPO.MaxPO 
				USE IN cntPO
			ENDIF
		ENDIF		
		*****
		
		IF lPOSaveOK 
			PRIVATE nCntPOitem 
			nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
		
			IF nCntPOitem = 0
				IF nHPApo > nMaxPO + 20
					MESSAGEBOX("The last PO was "+ALLTRIM(STR(nMaxPO))+", This PO is too large",16,"Cannot save this PO# "+ALLTRIM(STR(nHPApo)) )
					TrackMess("Cannot save this PO# "+ALLTRIM(STR(nHPApo))+"The last PO was "+ALLTRIM(STR(nMaxPO))+", This PO is too large."+" frmEdt.PO_SaveAdd()" )
					lPOSaveOK = .F.
				ENDIF
				
				IF lPOSaveOK 
					PRIVATE cSQLi
					cSQLi = "INSERT INTO dbo.PurchaseOrder "
					cSQLi = cSQLi + "(HPApo,poItem,itempo,SalesNum,soItem,ITEM,Salesp,orderdate,company,alloy,FORM,CC,Pieces,Thck,Sz2,Sz3,P_lb,P_pc,P_ft,LotP,OtherFld,OtherP,Order_Qty,StockLst_QTY,StockLst_P"
					cSQLi = cSQLi + ",Delivered,POSalesP,ShipVia,JobNumber,Due_Min,Due_Max,HPA_Due_Min,HPA_Due_Max,First_Due_Max,Cond_Spec,Misc_Purch,Services,ConvServ,Equipment,Stock,Sheet_Pk,ShipWhere,POShipAddr,POPayAddr,DispAlloy,StandSize,RandLen,Metric"
					cSQLi = cSQLi + ",VendCode,ContactID,Terms,FOB,Sz1Orig,Sz2Orig,Sz3Orig,ShipLocation) VALUES "
					cSQLi = cSQLi + "("+STR(nHPApo)+",'"+cPOItem+"',"+STR(nItemPo,2,0)+","+STR(nSalesNum)+",'"+cSOItem+"',"+STR(nItemSO,2,0)+",'"+cSalesp+"'"
					cSQLi = cSQLi + ",'"+IIF(EMPTY(dOrderDate),'',DTOC(dOrderdate))+"','"+cCompany+"','"+cAlloy+"','"+cForm+"','"+cCC+"'"
					cSQLi = cSQLi + ","+STR(nPieces,6,0)+","+STR(nThck,10,4)+","+STR(nSz2,9,3)+","+STR(nSz3,9,3)+","+STR(nP_lb,8,2)+","+STR(nP_pc,9,2)+","+STR(nP_ft,8,2)
					cSQLi = cSQLi + ","+STR(nLotP,9,2)+",'"+cOtherFld+"',"+STR(nOtherP,8,2)+","+STR(nOrder_Qty,11,3)+","+STR(nStockLst_Qty,18,8)+","+STR(nStockLst_P,18,8)+","+IIF(lDelivered,'1','0')+""
					cSQLi = cSQLi + ",'"+cPOSalesP+"','"+cShipVia+"','"+cJobNumber+"'"
					cSQLi = cSQLi + ",'"+IIF(EMPTY(dDue_Min),'',DTOC(dDue_Min))+"','"+IIF(EMPTY(dDue_Max),'',DTOC(dDue_Max))+"'"
					cSQLi = cSQLi + ",'"+IIF(EMPTY(dHPA_Due_Min),'',DTOC(dHPA_Due_Min))+"','"+IIF(EMPTY(dHPA_Due_Max),'',DTOC(dHPA_Due_Max))+"'"
					cSQLi = cSQLi + ",'"+IIF(EMPTY(dFirst_Due_Max),'',DTOC(dFirst_Due_Max))+"'" &&First_Due_Max
					cSQLi = cSQLi + ",'"+cCond_Spec+"','"+cMisc_Purch+"',"+IIF(lServicesPO,'1','0')+","+IIF(lConvServ,'1','0')+","+IIF(lEquipment,'1','0')+",'"+cStock+"',"+IIF(lSheet_pk,'1','0')
					cSQLi = cSQLi + ","+STR(nShipWhere,1,0)+","+STR(nPOShipAddr)+","+STR(nPOPayAddr)+",'"+cDispAlloy+"',"+STR(nStandSize,10,4)+","+IIF(lRandLen,'1','0')+","+IIF(lMetric,'1','0')
					cSQLi = cSQLi + ","+STR(nVendCode)+","+STR(nContactID)+",'"+cTerms+"','"+cFOB+"','"+cSz1+"','"+cSz2+"','"+cSz3+"'"+",'"+cShipLocation+"'"+")"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC )
						lPOSaveOK  = .F.
					ELSE
						lPOSaveLst = .T.
					ENDIF
				ENDIF
			ELSE
				IF MESSAGEBOX("PO Number-Item:"+ALLTRIM(cPOitem)+" allready exist."+CHR(13)+"If want to update the old values with these, "+CHR(13)+"Answer YES, and Update the values.",4+32,"Update old record?") = 6
					
					PRIVATE cSQLu
					cSQLu = "UPDATE dbo.PurchaseOrder SET "
					cSQLu = cSQLu + " HPApo="+STR(nHPApo)
					cSQLu = cSQLu + ",poItem='"+cPOItem+"'"
					cSQLu = cSQLu + ",itempo="+STR(nItemPo,2,0)
					cSQLu = cSQLu + ",SalesNum="+STR(nSalesNum)
					cSQLu = cSQLu + ",soItem='"+cSOItem+"'"
					cSQLu = cSQLu + ",[ITEM]="+STR(nItemSO)
					cSQLu = cSQLu + ",Salesp='"+cSalesp+"'"
					cSQLu = cSQLu + ",orderdate='"+IIF(EMPTY(dOrderdate),'',DTOC(dOrderdate))+"'"
					cSQLu = cSQLu + ",company='"+cCompany+"'"
					cSQLu = cSQLu + ",alloy='"+cAlloy+"'"
					cSQLu = cSQLu + ",[FORM]='"+cForm+"'"
					cSQLu = cSQLu + ",[CC]='"+cCC+"'"
					cSQLu = cSQLu + ",Pieces="+STR(nPieces,6,0)
					cSQLu = cSQLu + ",Thck="+STR(nThck,10,4)
					cSQLu = cSQLu + ",Sz2="+STR(nSz2,9,3)
					cSQLu = cSQLu + ",Sz3="+STR(nSz3,9,3)
					cSQLu = cSQLu + ",P_lb="+STR(nP_lb,8,2)
					cSQLu = cSQLu + ",P_pc="+STR(nP_pc,9,2)
					cSQLu = cSQLu + ",P_ft="+STR(nP_ft,8,2)
					cSQLu = cSQLu + ",LotP="+STR(nLotP,9,2)
					cSQLu = cSQLu + ",OtherFld='"+cOtherFld+"'"
					cSQLu = cSQLu + ",OtherP="+STR(nOtherP,8,2)
					cSQLu = cSQLu + ",StockLst_QTY="+STR(nStockLst_Qty,18,8)
					cSQLu = cSQLu + ",StockLst_P="+STR(nStockLst_P,18,8)
					cSQLu = cSQLu + ",Order_Qty="+STR(nOrder_Qty,11,3)
					cSQLu = cSQLu + ",Delivered="+IIF(lDelivered,'1','0')
					cSQLu = cSQLu + ",POSalesP='"+cPOSalesP+"'"
					cSQLu = cSQLu + ",ShipVia='"+cShipVia+"'"
					cSQLu = cSQLu + ",JobNumber='"+cJobNumber+"'"
					cSQLu = cSQLu + ",Due_Min='"+IIF(EMPTY(dDue_Min),'',DTOC(dDue_Min))+"'"
					cSQLu = cSQLu + ",Due_Max='"+IIF(EMPTY(dDue_Max),'',DTOC(dDue_Max))+"'"
					cSQLu = cSQLu + ",HPA_Due_Min='"+IIF(EMPTY(dHPA_Due_Min),'',DTOC(dHPA_Due_Min))+"'"
					cSQLu = cSQLu + ",HPA_Due_Max='"+IIF(EMPTY(dHPA_Due_Max),'',DTOC(dHPA_Due_Max))+"'"
					cSQLu = cSQLu + ",Cond_Spec='"+cCond_Spec+"'"
					cSQLu = cSQLu + ",Misc_Purch='"+cMisc_Purch+"'"
					cSQLu = cSQLu + ",Services="+IIF(lServicesPO,'1','0')
					cSQLu = cSQLu + ",ConvServ="+IIF(lConvServ,'1','0')
					cSQLu = cSQLu + ",Equipment="+IIF(lEquipment,'1','0')
					cSQLu = cSQLu + ",Stock='"+cStock+"'"
					cSQLu = cSQLu + ",Sheet_Pk="+IIF(lSheet_pk,'1','0')
					cSQLu = cSQLu + ",ShipWhere="+STR(nShipWhere,1)
					cSQLu = cSQLu + ",POShipAddr="+STR(nPOShipAddr)
					cSQLu = cSQLu + ",POPayAddr="+STR(nPOPayAddr)
					cSQLu = cSQLu + ",DispAlloy='"+cDispAlloy+"'"
					cSQLu = cSQLu + ",StandSize="+STR(nStandSize,10,4)
					cSQLu = cSQLu + ",RandLen="+IIF(lRandLen,'1','0')
					cSQLu = cSQLu + ",Metric="+IIF(lMetric,'1','0')
					cSQLu = cSQLu + ",VendCode="+STR(nVendCode)
					cSQLu = cSQLu + ",ContactID="+STR(nContactID)
					cSQLu = cSQLu + ",Terms='"+cTerms+"'"
					cSQLu = cSQLu + ",FOB='"+cFOB+"'"
					cSQLu = cSQLu + ",Sz1Orig='"+cSz1+"'"
					cSQLu = cSQLu + ",Sz2Orig='"+cSz2+"'"
					cSQLu = cSQLu + ",Sz3Orig='"+cSz3+"'"
					cSQLu = cSQLu + ",ShipLocation='"+cShipLocation+"'"
					cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = '"+cPOItem+"'"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
						lPOSaveOK  = .F.
					ELSE
						lPOSaveLst = .T.
						TrackMess( "Updated POitem:"+ALLTRIM(cPOitem)+" for SOitem:"+cSOItem+" from EnterOrder."+" frmEdt.PO_SaveAdd()")
						Save_SOitem_Status( cSOItem, nHPApo, 'PO', 'Updated POitem:'+ALLTRIM(cPOitem), ThisForm.nConnHandle )
						
					ENDIF
		
				ELSE &&Do not save 	**IF MESSAGEBOX "PO item exists. Update record?"
					*"Cancel/Clear this save
					IF 6=MESSAGEBOX("Do you want to Abort this data?",4+32)
						THISFORM.POScreen("DISABLE")
						THISFORM.Show_Po() 
						THISFORM.pf.pg_po.cmdPOEdit.CAPTION = "Edit PO"
						THISFORM.pf.pg_po.cmdPODelete.CAPTION = "Delete"
						lPOSaveLst = .F.
						lPOSaveOK  = .F.
					ELSE
						**life goes on
						lPOSaveLst = .F.
					ENDIF
				ENDIF &&IF MESSAGEBOX
			ENDIF
		ENDIF
		
		IF lPOSaveOK AND NOT EMPTY(cSOitem) AND cSOItem != "STOCK" AND UPPER(cSOItem) != "LABSSERVICE" AND UPPER(cSOItem) != "EQUIPMENT" AND UPPER(cSOItem) != "CONVERTSVC"
			PRIVATE cSQLUpdate
			cSQLUpdate = "EXEC dbo.p_AllQuotes_AddPO "
			cSQLUpdate = cSQLUpdate + " @BuyFrom='"+STRTRAN(cBuyFrom,"'","''")+"'"
			cSQLUpdate = cSQLUpdate + ",@PO="+STR(nHpaPo)
			cSQLUpdate = cSQLUpdate + ",@SOitem='"+cSOitem+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate)
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLUpdate,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		*********
		nLotCost = 0
		
		IF lPOSaveLst 
			PRIVATE nLotCostOld
			nLotCostOld = THISFORM.pf.pgQuote.txtItemCost.VALUE
			IF VARTYPE(nLotCostOld) <> "N"
				nLotCostOld = 0
			ENDIF
			IF nLotCostOld = 0
				IF nLotCost > 0 &&Replace 0 with new LotCost
					THISFORM.pf.pgQuote.txtItemCost.VALUE = nLotCost
				ENDIF
			ELSE
			 	IF ( ROUND(nLotCostOld,0) <> ROUND(nLotCost,0) ) AND nLotCost > 0
					IF MESSAGEBOX("Do you want the new Costing of $"+ALLTRIM(STR(nLotCost))+CHR(13)+;
						"to replace the old of $"+ALLTRIM(STR(nLotCostOld))+CHR(13)+;
						"for this item?",4,"Replace costing?" ) = 6
						THISFORM.pf.pgQuote.txtItemCost.VALUE = nLotCost
						WAIT WINDOW "Item Cost has Changed, please save!" NOWAIT
					ELSE
						IF MESSAGEBOX("Do you want to add the new Costing of $"+ALLTRIM(STR(nLotCost))+CHR(13)+;
							"to the old of $"+ALLTRIM(STR(nLotCostOld))+CHR(13)+;
							"for this item? (Y)",4,"Add to old costing?" ) = 6
							THISFORM.pf.pgQuote.txtItemCost.VALUE = nLotCost+nLotCostOld
							
							WAIT WINDOW "Item Cost has Changed, please save!" NOWAIT
						ENDIF
					ENDIF
				ELSE
					*Old = New or New is 0
					*Do nothing
				ENDIF
			ENDIF
			THISFORM.pf.pgQuote.txtItemCost.REFRESH
		ENDIF
		
		*********
		PRIVATE cSalesPerson, cBrandName
		cBrandName = ''
		PRIVATE cFullDescr
		cFullDescr = ALLTRIM(STR(nPieces,6,0))+"Pc "+ALLTRIM(cAlloy)+' '+ItemDescriptionMetric( cForm, nThck, nSz2, nSz3, nOrder_Qty,.F., .F.,'','','' )+' '
		
		IF lPOSaveLst AND lPOSaveOK 
			
			*Check Alloy
			IF ALLTRIM(cAlloy) != ALLTRIM(SalesQuote.Alloy)
				IF MESSAGEBOX("The PO will be written as Alloy = "+cAlloy+CHR(13)+;
					"The SO is for Alloy = "+SalesQuote.Alloy+CHR(13)+;
					"When this material comes in, should it be stocked as "+SalesQuote.Alloy+"?";
					,4+32,"How should this be entered into the Stock list?")=6
					cBrandName = cAlloy
					cAlloy = SalesQuote.Alloy
				ELSE
					cBrandName = SalesQuote.Alloy
				ENDIF
			ENDIF
		
			cLOT = ""
			cHistory = ALLTRIM( LEFT( cCompany, 20) )
			dStkDate = CTOD("  /  /  ")
			nNum = 0
			nFrom_ID = 0
		
			cSalesPerson = LEFT( SalesPDescription(cSalesP) ,20 )
			cComment = PrepareSQLtxt( LEFT( cFullDescr+" POi"+cPOitem+IIF(EMPTY(cShipVia), " ShipVia:"+ALLTRIM(cShipVia),"")+;
			IIF(EMPTY(cJobNumber), " JobNumber:"+ALLTRIM(cJobNumber),"")+;
			IIF(EMPTY(cCond_Spec), " Cond_Spec:"+ALLTRIM(cCond_Spec),"") ,99),"Comment",100)
			
			*************************
			
			PRIVATE nStockLst_Total
			nStockLst_Total = nStockLst_QTY * nStockLst_P
			
			*************************
			cProcess_ID = "INCOMING"
			cProcessor = "EnterOrder"
			cAllowSub = 'N'
			
		
		ENDIF
		
		IF lPOSaveLst AND lPOSaveOK
			cSpecs = PrepareSQLtxt(cCond_Spec,'Specs',160)
		
			PRIVATE cCond, dStartDate, cComment, cAllowSub
			PRIVATE dDueDate, mMWeight, cSQL_ProcUp
			PRIVATE cProcess_ID, cProcessor
			
			dDueDate = IIF( NOT EMPTY(dDue_Max), dDue_Max, ;
				IIF ( NOT EMPTY(dDue_Min), dDue_Min, ;
				IIF ( NOT EMPTY(dOrderdate), dOrderdate+7, DATE()+7 )))
			mMWeight = 0
			cCond = " "
		
			PRIVATE lNeedSave, nID_Detail_Process, nID_Detail_Process2
			lNeedSave = .T.
			nID_Detail_Process = 0
		
			IF lServicesPO
				lPOSaveLst = .F.
				*DO NOT Save Service PO do StockLst
			ENDIF
			IF lConvServ
		*		lPOSaveLst = .F.
			ENDIF
			IF lEquipment
				lPOSaveLst = .F.
				*DO NOT Save Equipment to StockLst
			ENDIF
		
			*Check to see if Updates are Allowed
			DECLARE aPO_ID[1]
			aPO_ID(1) = 0
			
			IF USED("POMastCnt")
				USE IN POMastCnt
			ENDIF
			cSQL_cPO="SELECT [ID] FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"') AND NOT POStatus = 'D'"
			cSQL_cPO = cSQL_cPO + " UNION "
			cSQL_cPO = cSQL_cPO + "SELECT [ID] FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"') AND NOT POStatus = 'D'"
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_cPO, 'POMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_cPO, 'POMastCnt' )
			ENDDO
			IF nSQLEXEC < 1
				SQLEXECError(cSQL_cPO, ThisForm.nConnHandle, nSQLEXEC, 'POMastCnt')
			ELSE
				SELECT SUM(ID) FROM POMastCnt INTO ARRAY aPO_ID
			ENDIF
			IF USED("POMastCnt")
				USE IN POMastCnt
			ENDIF
			
			IF VARTYPE(aPO_ID(1)) = "N"
				IF aPO_ID(1)>0
					*Found StkLst that is more than Duein
					MESSAGEBOX("If this PO-item was still 'Due In'"+CHR(13)+"Changes here could be saved to StockLst."+CHR(13)+CHR(13)+"Since the material has bee received in,"+CHR(13)+"you must edit through StockLst Edit.",0+48,"Cannot automaticaly change StockLst now!")
					lPOSaveLst = .F.
				ENDIF
			ENDIF
		ENDIF
		
		********************
		PRIVATE cLstDetailUnit
		cLstDetailUnit = GetUNITfromFORM( cForm,ThisForm.nConnHandle )
		
		
		
		
		
		
		
		*******************
		
		IF lPOSaveLst AND lPOSaveOK
			PRIVATE nStkMastCnt, cSQL_Master_PO, cSQL_Master_Update, cSQL_Master_Insert, nMaster_ID
			nMASTER_ID = 0
			*Check for bad Broker/Stock First
			IF UPPER(ALLTRIM(cStock)) $ "ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
				*Needs to be in StockLst
				*Remove if found in BrokerLst
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt' )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt' )
					nStkMastCnt = 0
				ELSE
					nStkMastCnt = StkMastCnt.counted
				ENDIF
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				
				
				IF nStkMastCnt > 0
					MESSAGEBOX( "This PO-Item was found in BrokerLst."+CHR(13)+"The BrokerLst records will be removed and then saved in StockLst",0+48,"Removing from BrokerLst")
					*Get ID
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					cSQL_Master_PO="SELECT ID FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt' )
					ENDDO
					IF nSQLEXEC < 1
						SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt'  )
						nMaster_ID = 0
					ELSE
						nMaster_ID = StkMastCnt.ID
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					
					IF !Remove_Incoming_Process_by_POitem(cPoItem,"BrokerLst",ThisForm.nConnHandle)
						MESSAGEBOX("Not able to Delete Process from BrokerLst",0+16,"SQL problems.")
					ENDIF
					IF !Remove_StockLst_ID(nMaster_ID,ThisForm.nConnHandle,.T.,"Edit PO","PO was rewritten to be for StockLst.")
						MESSAGEBOX("Not able to Delete Master/Detail from BrokerLst",0+16,"SQL problems.")
					ENDIF
					
				ENDIF
			ELSE
				*Needs to be in BrokerLst, Unless Shipped Direct to Customer
				*Remove if found in StockLst
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt' )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle, cSQL_Master_PO, nSQLEXEC, 'StkMastCnt')
					nStkMastCnt = 0
				ELSE
					nStkMastCnt = StkMastCnt.counted
				ENDIF
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				
				
				IF nStkMastCnt > 0
					MESSAGEBOX( "This PO-Item was found in StockLst."+CHR(13)+"The StockLst records will be removed and then saved in BrokerLst",0+48,"Removing from StockLst")
					*Get ID
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					cSQL_Master_PO="SELECT ID FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt' )
					ENDDO
					IF nSQLEXEC < 1
						SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle, cSQL_Master_PO, nSQLEXEC, 'StkMastCnt' )
						nMaster_ID = 0
					ELSE
						nMaster_ID = StkMastCnt.ID
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					
					IF !Remove_Incoming_Process_by_POitem(cPoItem,"StockLst",ThisForm.nConnHandle)
						MESSAGEBOX("Not able to Delete Process from StockLst",0+16,"SQL problems.")
					ENDIF
					IF !Remove_StockLst_ID(nMaster_ID,ThisForm.nConnHandle,.T.,"Edit PO","PO was rewritten to be for BrokerLst.")
						MESSAGEBOX("Not able to Delete Master/Detail from StockLst",0+16,"SQL problems.")
					ENDIF
					
				ENDIF
				
				****************
				*if being Shipped Direct to Customer, remove from BrokerLst
				**************** nShipWhere = 2 Direct, 3 DirectBlind, 4 Service 6 RemoteStock
				
				IF nShipWhere = 2 or nShipWhere = 3 or nShipWhere = 4 or nShipWhere = 6
					PRIVATE nBrokerMastCnt 
					IF USED("StkBrokerCnt")
						USE IN StkBrokerCnt
					ENDIF
					cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkBrokerCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkBrokerCnt' )
					ENDDO
					IF nSQLEXEC < 1
						SQLEXECError(StkBrokerCnt,ThisForm.nConnHandle, cSQL_Master_PO, nSQLEXEC, 'StkBrokerCnt')
						nBrokerMastCnt = 0
					ELSE
						nBrokerMastCnt = StkBrokerCnt.counted
					ENDIF
					IF USED("StkBrokerCnt")
						USE IN StkBrokerCnt
					ENDIF
					
					
					IF nBrokerMastCnt > 0
						*Get ID
						PRIVATE nMaster_ID 
						IF USED("StkBrokerCnt")
							USE IN StkBrokerCnt
						ENDIF
						cSQL_Master_PO="SELECT ID FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
						SELECT 0
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkBrokerCnt')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkBrokerCnt' )
						ENDDO
						IF nSQLEXEC < 1
							SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC,'StkBrokerCnt')
							nMaster_ID = 0
						ELSE
							nMaster_ID = StkBrokerCnt.ID
						ENDIF
						IF USED("StkBrokerCnt")
							USE IN StkBrokerCnt
						ENDIF
						
						IF !Remove_Incoming_Process_by_POitem(cPoItem,"BrokerLst",ThisForm.nConnHandle)
							MESSAGEBOX("Not able to Delete Process from BrokerLst",0+16,"SQL problems.")
						ENDIF
						IF !Remove_BrokerLst_ID(nMaster_ID,ThisForm.nConnHandle,.T.,"Edit PO","PO was rewritten to be for Direct shipment or a Service.")
							MESSAGEBOX("Not able to Delete Master/Detail from BrokerLst",0+16,"SQL problems.")
						ENDIF
						
					ENDIF		
				ENDIF		
			ENDIF
		
		
			IF UPPER(ALLTRIM(cStock)) $ "ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
				************************** StockLst SQL
				*	"ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
				
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Master WHERE dbo.PRoperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt' )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
					nStkMastCnt = 0
				ELSE
					nStkMastCnt = StkMastCnt.counted
				ENDIF
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				
		
				IF nStkMastCnt > 0
					*UPDATE
					cSQL_Master_Update = "UPDATE dbo.StockLst_Master SET "+ ;
						" Alloy = '" + cAlloy + "',"+;
						" [FORM] = '" + cForm + "',"+;
						" [CC] = '" + cCC + "',"+;
						" Cond = '" + cCond + "',"+;
						" SIZE = " + STR(nThck,9,3) + ","+;
						" Specs = '" + cSpecs + "',"+;
						" Paid = " + STR(nStockLst_P,18,8)+ ","+;
						" PO_Item = '" + cPoItem+ "',"+;
						" POdueDate = '" + IIF(EMPTY(dDueDate),'',DTOC(dDueDate)) + "',"+;
						" BrandName = '"+cBrandName+"'"+;
						" WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_Update )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_Update )
					ENDDO
					IF nSQLEXEC < 1
						SQLEXECError(cSQL_Master_Update,ThisForm.nConnHandle,nSQLEXEC )
						lSQLgood = .F.
					ENDIF	
					
					IF lSQLGood
						IF USED("StkMastCntID")
							USE IN StkMastCntID
						ENDIF
						*Get ID
						cSQL_Master_PO = "SELECT ID FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
						SELECT 0
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCntID')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCntID')
						ENDDO
						IF nSQLEXEC < 1
							SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCntID')
							nMaster_ID = 0
						ELSE
							nMaster_ID = StkMastCntID.ID
						ENDIF
						IF USED("StkMastCntID")
							USE IN StkMastCntID
						ENDIF
		
					ENDIF	
				ELSE
					IF USED('tmpID_Master')
						USE IN tmpID_Master
					ENDIF
		
					*INSERT
					cSQLi = "EXEC p_StockLst_Master_ins "
					cSQLi = cSQLi+ "@Alloy ='"+cAlloy+"'"   &&NOT NULL
					cSQLi = cSQLi+ ",@Form ='"+cForm+"'"   &&NOT NULL
					cSQLi = cSQLi+ ",@CC ='"+cCC+"'"
					cSQLi = cSQLi+ ",@Cond ='"+cCond+"'"   &&NOT NULL
					cSQLi = cSQLi+ ",@Size ="+STR(nThck,9,3)+""   &&NOT NULL
					cSQLi = cSQLi+ ",@PAID ="+STR(nStockLst_P,18,8)+""
					cSQLi = cSQLi+ ",@MWeight ="+"0" &&Init with 0 **STR(IIF(ISNULL(mweight),0,mweight),9,2)+""
					cSQLi = cSQLi+ ",@specs ='"+cSpecs+"'"
					cSQLi = cSQLi+ ",@Heat ='"+'Due In'+"'"   &&NOT NULL
					cSQLi = cSQLi+ ",@Lot =''" 
					cSQLi = cSQLi+ ",@PO_Item ='"+cPoItem+"'"
					cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
					cSQLi = cSQLi+ ",@History =''" 
					cSQLi = cSQLi+ ",@Mill =''" 
					cSQLi = cSQLi+ ",@StkDate =''"
					cSQLi = cSQLi+ ",@Num = 0" 
					cSQLi = cSQLi+ ",@POStatus ='D'" 
					cSQLi = cSQLi+ ",@BrandName ='"+cBrandName+"'"
					cSQLi = cSQLi+ ",@From_ID =0" 
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
					ENDDO
					IF nSQLEXEC < 1
						SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Master')
						nMaster_ID = 0
						lSQLgood = .F.
					ELSE
						nMaster_ID = tmpID_Master.EXP
					ENDIF
					IF USED('tmpID_Master')
						USE IN tmpID_Master
					ENDIF
				ENDIF	
				*MASTER
				*********************************** StockLst
				*	"ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
				*DETAIL
				
				
				IF lSQLgood
					Is_Alloy_New( cAlloy,cBrandName,ThisForm.nConnHandle )
				ENDIF
		
				IF lSQLgood AND lNeedSave
					*Save Detail
					cSQL_Detail_cnt="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Detail WHERE ID = "+ALLTRIM(STR(nMaster_ID ))
		
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_cnt, 'StkDetailCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_cnt, 'StkDetailCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_Detail_cnt,ThisForm.nConnHandle,nSQLEXEC, 'StkDetailCnt')
						nStkDetailCnt = 0
						lSQLgood = .F.
					ELSE
						nStkDetailCnt = StkDetailCnt.counted
					ENDIF
					IF USED("StkDetailCnt")
						USE IN StkDetailCnt
					ENDIF
		
					cSQL_Detail_DEL_cnt="SELECT COUNT(ID) AS counted FROM dbo.[Ar.Stocklst_Detail_History] WHERE ID = "+ALLTRIM(STR(nMaster_ID ))
					cSQL_Detail_DEL_cnt=cSQL_Detail_DEL_cnt+" AND [WHAT] <> 'ADD'"
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_DEL_cnt, 'StkDetail_DELCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL_Detail_DEL_cnt, 'StkDetail_DELCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_Detail_DEL_cnt,ThisForm.nConnHandle,nSQLEXEC, 'StkDetail_DELCnt')
						nStkDetail_DELCnt = 0
						lSQLgood = .F.
					ELSE
						nStkDetail_DELCnt = StkDetail_DELCnt.counted
						IF nStkDetail_DELCnt > 0
							*IF MESSAGEBOX("Are you sure you want to Edit This?",4+16,"This StockLst item has Accounting Value.") = 6
								nStkDetail_DELCnt = 0
								TrackMess("StockLst_Process_History for ID="+ALLTRIM(STR(nMaster_ID))+" has more than just 'ADD' - Probable Edits, user continued anyway."+" frmEdt.PO_SaveAdd()" )
							*ENDIF
						ENDIF
					ENDIF
					IF USED("StkDetail_DELCnt")
						USE IN StkDetail_DELCnt
					ENDIF
		
		
					IF nStkDetailCnt > 0
						*Found Detail belonging to Masters ID
						*IF Master has been Received in, then lNeedSave would be False and this code would be skipped
		
						IF nStkDetail_DELCnt = 0
							*Did not find any Edits in History of the Detail record
							*Check for Change
							cSQL_Detail_PO="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Detail WHERE [ID] = "+STR(nMaster_ID)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [PC] = "   + STR(nPieces)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [DIM1] = " + STR(nThck,18,4)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [DIM2] = " + STR(nSz2,18,4)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [DIM3] = " + STR(nSz3,18,4)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [WEIGHT] = " + STR(nStockLst_QTY,18,8)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [COSTVALUE] = " + STR(nStockLst_P,18,4)
		*					cSQL_Detail_PO=cSQL_Detail_PO+" AND [InvoiceValue] = " + STR(nStockLst_P,18,8)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [RANDLEN] = " + IIF(lRandLen,"1","0")
		
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_QTY = " + STR(nStockLst_P,18,4) + ""
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_P = " + STR(nStockLst_P,18,4) + ""
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_Total = " + STR(nS_Total,18,4) + ""
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_PU = " + STR(nS_PU) + ""
		
							SELECT 0
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_PO, 'StkDetailCnt')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_PO, 'StkDetailCnt')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL_Detail_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkDetailCnt')
								nStkDetailCnt = 0
							ELSE
								nStkDetailCnt = StkDetailCnt.counted
							ENDIF
							IF USED("StkDetailCnt")
								USE IN StkDetailCnt
							ENDIF
							IF nStkDetailCnt = 0  &&Found A Change
		
								*Update
								cSQL_Detail_Update = "UPDATE dbo.StockLst_Detail SET "
								cSQL_Detail_Update = cSQL_Detail_Update +" PC = "   + STR(nPieces)    + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",DIM1 = " + STR(nThck,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",DIM2 = " + STR(nSz2,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",DIM3 = " + STR(nSz3,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",LENGTH = "+"'Listing created from new PO:"+ALLTRIM(STR(nHPAPO))+" needed for a SO:"+ALLTRIM(STR(nSalesNum))+".'" + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",WEIGHT = " + STR(nStockLst_QTY,9,2) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",COSTVALUE = " + STR(nStockLst_P,18,8) + ""
		*						cSQL_Detail_Update = cSQL_Detail_Update +",InvoiceValue= " + STR(nStockLst_P,18,8) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",RANDLEN = " + IIF(lRandLen,"1","0")
								cSQL_Detail_Update = cSQL_Detail_Update +",location ='"+cShipLocation+"'"
								cSQL_Detail_Update = cSQL_Detail_Update +",Unit ='"+cLstDetailUnit+"'"
								
								cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " + STR(nStockLst_P,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " + STR(nStockLst_P,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = " + STR(nS_Total,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " + STR(nS_PU) + ""
								
								cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID = "+STR(nMaster_ID)+""
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
									lSQLgood = .F.
								ENDIF
							ENDIF
		
							*Get ID_Detail
							IF USED('tmpID_Detail')
								USE IN tmpID_Detail
							ENDIF
							SELECT 0
							cSQLi = "SELECT ID_Detail FROM dbo.StockLst_Detail WHERE ID = "+STR(nMaster_ID )+""
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC)
								lSQLgood = .F.
							ELSE
								nID_Detail = tmpID_Detail.ID_Detail
							ENDIF
							IF USED('tmpID_Detail')
								IF RECCOUNT('tmpID_Detail') > 1
									lMany_ID_Details = .T.
								ENDIF
								USE IN tmpID_Detail
							ENDIF
						ELSE
							*Found Detail belonging to Masters ID
							*Found Edits to the Detail record
							*DO NOT EDIT
							MESSAGEBOX("Cannot update StockLst"+CHR(13)+"Have Accountant make changes if needed.",0,"Cannot save here!")
							lNeedSave = .F.
							
							*Get nID_Detail_Process
							IF nMaster_ID > 0
								*Get ID_Detail_Process
								IF USED('tmp_ID_Detail_Pro')
									USE IN tmp_ID_Detail_Pro
								ENDIF
		
								cSQL = "SELECT ID_Detail_Process FROM dbo.StockLst_Process_Detail WHERE ID = "+STR(nMaster_ID )
														
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmp_ID_Detail_Pro')
									lSQLgood = .F.
									*Could not Check for Process
								ELSE
									nID_Detail_Process = tmp_ID_Detail_Pro.ID_Detail_Process
								ENDIF
								IF USED('tmp_ID_Detail_Pro')
									USE IN tmp_ID_Detail_Pro
								ENDIF
							ENDIF
		
						ENDIF
					ELSE   &&nStkDetailCnt > 0
						*No Detail record exist in current
						IF nStkDetail_DELCnt = 0
							*Did not find any Edits in History of the Detail record
		
							*INSERT
							IF USED('tmpID_Detail')
								USE IN tmpID_Detail
							ENDIF
							SELECT 0
							*ALLTRIM(STRTRAN(IIF(ISNULL(cAlloy)," ",cAlloy),"'","''"))
							cSQLi = "EXEC p_StockLst_Detail_ins "
							cSQLi = cSQLi + " @size_h ="+'NULL'
							cSQLi = cSQLi + ",@size_l ="+'NULL'
							cSQLi = cSQLi + ",@pc ="+ STR(IIF(ISNULL(nPieces),0,nPieces))
							cSQLi = cSQLi + ",@dim1 =" + STR(IIF(ISNULL(nThck),0,nThck),18,4)
							cSQLi = cSQLi + ",@dim2 =" + STR(IIF(ISNULL(nSz2),0,nSz2),18,4)
							cSQLi = cSQLi + ",@dim3 =" + STR(IIF(ISNULL(nSz3),0,nSz3),18,4)
							cSQLi = cSQLi + ",@length ="+"'Listing created from new PO:"+ALLTRIM(STR(nHPAPO))+" needed for a SO:"+ALLTRIM(STR(nSalesNum))+".'"
							cSQLi = cSQLi + ",@weight =" + STR(IIF(ISNULL(nStockLst_QTY),0,nStockLst_QTY),9,2)
		*					cSQLi = cSQLi + ",@costvalue =" + STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,8)
							cSQLi = cSQLi + ",@costvalue =" + STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,8)
							cSQLi = cSQLi + ",@descript ='"+"'"
							cSQLi = cSQLi + ",@location ='"+"'"
							cSQLi = cSQLi + ",@floorstatus ='"+"'"
							cSQLi = cSQLi + ",@class ='"+"'"
							cSQLi = cSQLi + ",@unit ='"+cLstDetailUnit+"'"
							cSQLi = cSQLi + ",@RandLen ="+IIF(lRandLen,"1","0")	&&'"+"'"
							cSQLi = cSQLi + ",@ID ="+STR(nMaster_ID )
							cSQLi = cSQLi + ",@ID_Detail_Process ="+STR(nID_Detail_Process)
		
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Detail')
								lSQLgood = .F.
							ELSE
								IF USED('tmpID_Detail')
									nID_Detail = tmpID_Detail.EXP
									USE IN tmpID_Detail
									
									*Now update what does not fit in p_StockLst_Detail_ins
									cSQL_Detail_Update = "UPDATE dbo.StockLst_Detail SET "
									cSQL_Detail_Update = cSQL_Detail_Update +" location ='"+cShipLocation+"'"
									cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " + STR(nStockLst_P,18,4) + ""
									cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " + STR(nStockLst_P,18,4) + ""
									cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = " + STR(nS_Total,18,4) + ""
									cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " + STR(nS_PU) + ""
		
									cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID_Detail = "+STR(nID_Detail)
									
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
									ENDIF
									
								ELSE
									*Insert Failed
									SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Detail')
									lSQLgood = .F.
									MESSAGEBOX('Could not SAVE detail',0,'Error')
								ENDIF
							ENDIF
						ELSE
							*Found Edits in History of the Detail record
							MESSAGEBOX("Cannot update StockLst"+CHR(13)+"Have Accountant make changes if needed.",0,"Cannot save here!")
							lNeedSave = .F.
						ENDIF
					ENDIF  &&nStkDetailCnt > 0
				ENDIF  &&IF lSQLgood AND lNeedSave
				*DETAIL
			***************************** StockLst
			*	"ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
				*Save Process
				IF lSQLgood AND nMaster_ID > 0   &&AND lNeedSave
					*POStatus says Part has NOT been received!
					*No edites to Master
					*No Edites to Detail
					
					IF VARTYPE(nID_Detail) != "N"
						nID_Detail = 0
					ENDIF
					IF nID_Detail < 1
						*Get ID_Detail
						IF USED('tmpID_Detail')
							USE IN tmpID_Detail
						ENDIF
						SELECT 0
						cSQLi = "SELECT ID_Detail FROM dbo.StockLst_Detail WHERE ID = "+STR(nMaster_ID )+""
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Detail')
							lSQLgood = .F.
						ELSE
							nID_Detail = tmpID_Detail.ID_Detail
						ENDIF
						IF USED('tmpID_Detail')
							IF RECCOUNT('tmpID_Detail')>1
								lMany_ID_Details = .T.
							ENDIF
							USE IN tmpID_Detail
						ENDIF
					ENDIF
							
					* Check Process
					cSalesPerson = PrepareSQLtxt( SalesPDescription(cSalesP) ,'SalesPerson',20,.F.)
					cComment = PrepareSQLtxt( LEFT(cFullDescr+" POi"+cPoItem+ IIF(EMPTY(cShipVia),""," ShipVia:"+ALLTRIM(cShipVia))+;
					IIF(EMPTY(cJobNumber),""," JobNumber:"+ALLTRIM(cJobNumber))+;
					IIF(EMPTY(cCond_Spec),""," Cond_Spec:"+ALLTRIM(cCond_Spec)),99), 'Comment',100) 
					cProcess_ID = "INCOMING"
					cProcessor = 'EnterOrder'
					cAllowSub = 'N'
		
					IF USED('tmp_ID_Detail_Pro')
						USE IN tmp_ID_Detail_Pro
					ENDIF
					
					IF lMany_ID_Details 
						cSQL = "SELECT ID_Detail_Process FROM dbo.StockLst_Process WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
						cSQL = cSQL + " AND Process_ID = 'INCOMING'"
					ELSE
						cSQL = "SELECT ID_Detail_Process FROM dbo.StockLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
						cSQL = cSQL + " AND dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
						cSQL = cSQL + " AND Process_ID = 'INCOMING'"
					ENDIF
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmp_ID_Detail_Pro')
						lSQLgood = .F.
						*Could not Check for Process
					ELSE
						nID_Detail_Process = tmp_ID_Detail_Pro.ID_Detail_Process
					ENDIF
		
		
					IF lSQLgood AND USED('tmp_ID_Detail_Pro')
						IF RECCOUNT('tmp_ID_Detail_Pro') > 0
							*Check for Change
							cSQL_Process_PO="SELECT COUNT(*) AS counted FROM dbo.StockLst_Process WHERE [ID_Detail_Process] = "+STR(nID_Detail_Process)
							cSQL_Process_PO=cSQL_Process_PO+" AND [SOItem]='"+cSOitem+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [SalesPerson]='"+cSalesPerson+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [DueDate]='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"  
							cSQL_Process_PO=cSQL_Process_PO+" AND [Process_ID]='"+cProcess_ID+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [Processor]='"+cProcessor+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [AllowSub]='"+cAllowSub+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [PWeight]="+STR(nPWeight,9,1)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [PPc]="+STR(nPieces)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [PFt]="+STR(nPFT,10,4)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [PU]="+STR(nPU)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [ID_Detail]="+STR(nID_Detail)+""
		
							SELECT 0
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process_PO, 'StkDetailCnt')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process_PO, 'StkDetailCnt')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL_Process_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkDetailCnt')
								nStkDetailCnt = 0
							ELSE
								nStkDetailCnt = StkDetailCnt.counted
							ENDIF
							IF USED("StkDetailCnt")
								USE IN StkDetailCnt
							ENDIF
							IF nStkDetailCnt = 0  &&Found A Change
		
								**UPDATE
								cSQL_ProcUp = "UPDATE dbo.StockLst_Process SET"
								cSQL_ProcUp = cSQL_ProcUp + " SOItem='"+cSOitem+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",PO_Item='"+cPoItem+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",SalesPerson='"+cSalesPerson+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",Comment='"+cComment+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",Process_ID='"+cProcess_ID+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",Processor='"+cProcessor+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",AllowSub='"+cAllowSub+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",PWeight="+STR(nPWeight,9,1)+""
								cSQL_ProcUp = cSQL_ProcUp + ",PPC="+STR(nPieces)+""
								cSQL_ProcUp = cSQL_ProcUp + ",PFt="+STR(nPFt,10,4)+""
								cSQL_ProcUp = cSQL_ProcUp + ",PU="+STR(nPU)+""
								cSQL_ProcUp = cSQL_ProcUp + ",ID_Detail="+STR(nID_Detail)+" "
								cSQL_ProcUp = cSQL_ProcUp + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL_ProcUp,ThisForm.nConnHandle,nSQLEXEC)
									lSQLgood = .F.
									=SQLROLLBACK(ThisForm.nConnHandle)
								ELSE
									=SQLCOMMIT(ThisForm.nConnHandle)
								ENDIF
							ELSE
								=SQLCOMMIT(ThisForm.nConnHandle)
							ENDIF
						ELSE
							**INSERT
							*!*	*Create Process
							IF USED("tmpID_Detail_Process")
								USE IN tmpID_Detail_Process
							ENDIF
							SELECT 0
		
							*p_StockLst_Process_ins
							cSQLi = "EXEC p_StockLst_Process_ins2 "
							cSQLi = cSQLi + "@ID_Detail = "+STR(nID_Detail)+""
							cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
							cSQLi = cSQLi + ",@StartDate = '"+DTOC( DATE() )+"'"
							cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
							cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
							cSQLi = cSQLi + ",@pWeight = "+STR(nPWeight,9,2)
							cSQLi = cSQLi + ",@PPc = "+STR(nPPc)
							cSQLi = cSQLi + ",@PFt = "+STR(nPFt,10,4)
							cSQLi = cSQLi + ",@PU = "+STR(nPU)
							cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
							cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
							cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"
							cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
							cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
							ENDDO
							
							IF nSQLEXEC < 0
								*retry
								nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
								ENDDO
							ENDIF
							
							IF nSQLEXEC < 0
								=SQLROLLBACK(ThisForm.nConnHandle)
								SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC)
								TrackError("Could not EXEC p_StockLst_Process_ins2","p_StockLst_Process_ins","EnterOrder.PO_SaveAdd()",1580)
								lSQLgood = .F.
							ELSE
								nID_Detail_Process = tmpID_Detail_Process.EXP
								=SQLCOMMIT(ThisForm.nConnHandle)
							ENDIF
						ENDIF
						
						***************
						*mark stock with a "SELECTED" process if have SOitem
						IF cSOItem != "STOCK" AND UPPER(cSOItem) != "LABSSERVICE" AND UPPER(cSOItem) != "EQUIPMENT" AND UPPER(cSOItem) != "CONVERTSVC"
							ThisForm.StockLst_Process_Save( nID_Detail, cSOitem, cSalesPerson, nPWeight, nPPc, nPFt, nPU, cComment, dDueDate, cPoItem, 'StockLst' )
						ENDIF
						
						*mark stock with a "SELECTED" process if Custom Stock
						IF  UPPER(ALLTRIM(cStock)) = "CUSTOM STOCK"
							cSOItem = "STOCK"
							*cComment = "Custom Stock - Do not select as typical stock!"  &&&+CHR(13)+ cComment &&Comment is re written in function
							ThisForm.StockLst_Process_Custom_Save( nID_Detail, cSOitem, cSalesPerson, nStockLst_QTY, nPPc, nPFt, nPU, cComment, dDueDate, cPoItem, 'StockLst' )
						ELSE
							*Check for a 'Custom Stock' Process, and remove
							ThisForm.StockLst_Process_Remove_Custom( nID_Detail, cPoItem, 'StockLst' )
						ENDIF
						**************
					ENDIF
		
					IF USED('tmp_ID_Detail_Pro')
						USE IN tmp_ID_Detail_Pro
					ENDIF
				ELSE
					*POStatus says Part has been received!
					*an ERROR has occured on Master
				ENDIF  && lSQLGood AND lNeedSave AND nMaster_ID > 0
		
				*		Process			
				****************************
					
					IF nShipWhere != 1 AND nShipWhere != 5 AND nShipWhere != 6 &&Not comming to HPA
						IF UPPER(ALLTRIM(cStock)) $ "ALL FOR STOCK,MOSTLY STOCK,SOME STOCK" AND nShipWhere != 6
							MESSAGEBOX( "The Shipping address is not to HPA, but HPA is to Stock!",0,"Odd Situation." )
						ELSE
							IF MESSAGEBOX("Since this item will not ship to HPA,"+CHR(13)+;
								  "This PO item will be listed as completed."+CHR(13)+;
								  "Do you agree this PO item will not have any Receiving record?"+CHR(13)+;
								  "Answer No if HPA will produce a PackingSlip "+CHR(13)+;
								  "or Receiving record to complete this item.",4,"Is item complete?" ) = 6&&Yes
								
								*Mark Items shipped direct to customer as Complete
								PRIVATE nCountShip
								nCountShip = Count_ShipbySOitem( cSOitem, ThisForm.nConnHandle, '' )
								
								IF nCountShip > 0 Then
									cSQL = "UPDATE dbo.SHIP SET	"
									cSQL = cSQL + "[ShipDate] = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
									cSQL = cSQL + ",ShipVia = '"+LEFT("Direct "+cShipVia,20)+"'"
									cSQL = cSQL + ",Qshipped = "+STR(nPieces,10,0)+"'"
									cSQL = cSQL + ",[COMPLETE] = '1'"
									cSQL = cSQL + "	WHERE SOitem = dbo.ProperSO('"+cSOItem+"')"
									
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
									ENDIF
								ELSE
		
						 			cSQL = "INSERT INTO dbo.SHIP "
						 			cSQL = cSQL + "( SOitem, ShipDate, ShipVia, Qshipped, [COMPLETE] ) VALUES"
									cSQL = cSQL + "('"+cSOitem+"','"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
									cSQL = cSQL + ",'"+LEFT("Direct "+cShipVia,20)+"',"+STR(nPieces,10,0)+",'1')"
									
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
									ENDIF
								ENDIF
								
							
								IF Count_SOinSales(cSOitem, ThisForm.nConnHandle) > 0
										
									cSQLu = "UPDATE dbo.Sales SET "
									cSQLu = cSQLu + "cmplt = '1'"
									cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
									
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
									ENDDO
									IF nSQLEXEC < 0 &&Try again!, long triger
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
										ENDDO
									ENDIF
									IF nSQLEXEC < 0
										SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC)
									ENDIF
									TrackMess("SO Item:"+HTML_SOitem(cSOitem)+" was marked as Complete in Sales EnterOrder:PO_SaveAdd(), PO not comming to HPA, Shipped direct to customer and Count_SOinSales() > 0, L1329")
									Save_SOitem_Status( cSOitem, SalesNum, 'Complete', "Marked as Complete in Sales EnterOrder because it will not ship to HPA", ThisForm.nConnHandle )
		
								ELSE
									cSQL = "INSERT INTO dbo.Sales ( SOitem, SalesNum, cmplt ) VALUES ("
									cSQL = cSQL + "'"+cSOitem+"'"
									cSQL = cSQL + ","+STR(SalesNum)
									cSQL = cSQL + ",1"
									
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
									ENDIF
									TrackMess("SO Item:"+HTML_SOitem(cSOitem)+" was marked as Complete in Sales EnterOrder:PO_SaveAdd(), PO not comming to HPA, Shipped direct to customer and NOT Count_SOinSales() > 0, L3145")
									Save_SOitem_Status( cSOitem, SalesNum, 'Complete', "Marked as Complete in Sales EnterOrder because it will not ship to HPA", ThisForm.nConnHandle )
								ENDIF
							ELSE  &&IF MESSAGEBOX("Since this item will not ship to HPA,"+CHR(13)
								*unmark direct shipment?
								
								*Ship
								cSQL = "UPDATE dbo.SHIP SET	"
								cSQL = cSQL + "[ShipDate] = ''"
								cSQL = cSQL + ",ShipVia = ''"
								cSQL = cSQL + ",Qshipped = 0"
								cSQL = cSQL + ",[COMPLETE] = '0'"
								cSQL = cSQL + "	WHERE SOitem = dbo.ProperSO('"+cSOItem+"')"
								
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
								ENDIF
								
								*Sales
								cSQLu = "UPDATE dbo.Sales SET "
								cSQLu = cSQLu + "cmplt = '0'"
								cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
								ENDDO
								IF nSQLEXEC < 0 &&Try again!, long triger
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC)
								ENDIF
									
							ENDIF  && IF MESSAGEBOX("Since this item will not ship to HPA,"+CHR(13)
						ENDIF  && IF UPPER(ALLTRIM(cmbStock)) $ "ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
					ELSE  &&nShipWhere != 1 AND nShipWhere != 5
					*PO items comming to HPA
					*check for ShipWhere Reversal, see if cmplt is to be unchecked
					
						*unmark direct shipment?
						
						*Ship
						cSQL = "UPDATE dbo.SHIP SET	"
						cSQL = cSQL + "[ShipDate] = ''"
						cSQL = cSQL + ",ShipVia = ''"
						cSQL = cSQL + ",Qshipped = 0"
						cSQL = cSQL + ",[COMPLETE] = '0'"
						cSQL = cSQL + "	WHERE SOitem = dbo.ProperSO('"+cSOItem+"')"
						
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
						
						*Sales
						cSQLu = "UPDATE dbo.Sales SET "
						cSQLu = cSQLu + "cmplt = '0'"
						cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!, long triger
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC)
						ENDIF
							
							
					ENDIF &&nShipWhere != 1 AND nShipWhere != 5
		*		***************************			
		*		ENDIF &&IF lSQLGood
				
			ELSE  &&$ "ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
				*Save to Broker
				**********************************************************************************************
				**********************************************************************************************
				**********************************************************************************************
				**********************************************************************************************
				************************
				**** BrokerLst SQL ****
				************************
				PRIVATE nBrokerMaster_ID
				nBrokerMaster_ID = 0
				
				=SQLSETPROP(ThisForm.nConnHandle,'Transactions',2)
				=SQLCOMMIT(ThisForm.nConnHandle)
		
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC)
					nStkMastCnt = 0
				ELSE
					nStkMastCnt = StkMastCnt.counted
				ENDIF
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
		
				IF nStkMastCnt > 0
					*Found Purchase Order in curent Master!
					*See if has been Received in - do not overwite received data!
					cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
					cSQL_Master_PO=cSQL_Master_PO+" AND POStatus = 'D'"  &&Due in
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.counted
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					IF nStkMastCnt > 0
						*Check for Change
		
						cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
						cSQL_Master_PO=cSQL_Master_PO+" AND [Alloy] = '" + cAlloy+ "'"
						cSQL_Master_PO=cSQL_Master_PO+" AND [FORM] = '" + cForm+ "'"
						cSQL_Master_PO=cSQL_Master_PO+" AND [CC] = '" + cCC+ "'"
						cSQL_Master_PO=cSQL_Master_PO+" AND [SIZE] = " + STR(nThck,9,3)
						cSQL_Master_PO=cSQL_Master_PO+" AND [Specs] = '" + cSpecs+"'"
						cSQL_Master_PO=cSQL_Master_PO+" AND [Paid] = " + STR(nStockLst_P,18,8)
						cSQL_Master_PO=cSQL_Master_PO+" AND [POdueDate] = '" + IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		
						SELECT 0
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
							nStkMastCnt = 0
						ELSE
							nStkMastCnt = StkMastCnt.counted
						ENDIF
						IF USED("StkMastCnt")
							USE IN StkMastCnt
						ENDIF
		
						IF nStkMastCnt = 0  &&Did not find Exact match
		
							*UPDATE
							cSQL_Master_Update = "UPDATE dbo.BrokerLst_Master SET "
							cSQL_Master_Update = cSQL_Master_Update +" Alloy = '" + cAlloy+ "'"
							cSQL_Master_Update = cSQL_Master_Update +",FORM = '" + cForm+ "'"
							cSQL_Master_Update = cSQL_Master_Update +",CC = '" + cCC+ "'"
							cSQL_Master_Update = cSQL_Master_Update +",SIZE = " + STR(nThck,9,3) + ""
							cSQL_Master_Update = cSQL_Master_Update +",Specs = '" + cSpecs + "'"
							cSQL_Master_Update = cSQL_Master_Update +",Paid = " + STR(nStockLst_P,18,8)+ ""
							cSQL_Master_Update = cSQL_Master_Update +",BrandName = '" + cBrandName + "'"
							cSQL_Master_Update = cSQL_Master_Update +",POdueDate = '" + IIF(EMPTY(dDueDate),'',DTOC(dDueDate)) + "'"
							cSQL_Master_Update = cSQL_Master_Update +" WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
							*									", Cond = ' '"+;
							*									", heat = 'Due In'"+;
							*									", mweight = " +STR(mweight,9,2)+ ""+;
							*									", po_Item = '" + cPoItem+ "'"+;
							*									", POStatus = 'D'" + ""+;
		
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_Update )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_Update )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL_Master_Update,ThisForm.nConnHandle,nSQLEXEC )
								lSQLgood = .F.
							ENDIF
						ENDIF
		
						IF USED('tmpID_Master')
							USE IN tmpID_Master
						ENDIF
		
						*Get Master_ID
						SELECT 0
						cSQLi = "SELECT ID FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Master')
							lSQLgood = .F.
						ELSE
							nBrokerMaster_ID = tmpID_Master.ID
		
							IF USED('tmpID_Master')
								USE IN tmpID_Master
							ENDIF
						ENDIF
		
					ELSE
						*POStatus says Part has been received!
						MESSAGEBOX("This BrokerLst has been received in!"+CHR(13)+"This edit will not adjust the BrokerLst",0,"Cannot automate the BrokerLst edits from here.")
						lNeedSave = .F.
					ENDIF
		
					IF USED('tmpID_Master')
						USE IN tmpID_Master
					ENDIF
				ELSE
					*No BrokerLst_Master found to update- Check History
					cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.[Ar.BrokerLst_Master_history] WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
					cSQL_Master_PO=cSQL_Master_PO+" AND [WHAT] = 'DELETE'"  &&Due in
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.counted
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					IF nStkMastCnt = 0
						*no current Master and also NOT Found in Master_History where [WHAT]='DELETE'
						IF USED('tmpID_Master')
							USE IN tmpID_Master
						ENDIF
						SELECT 0
						*INSERT
		
						cSQLi = "EXEC p_BrokerLst_Master_ins "
						cSQLi = cSQLi+ "@Alloy ='"+ALLTRIM(STRTRAN(IIF(ISNULL(cAlloy)," ",cAlloy),"'","''"))+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@Form ='"+ALLTRIM(STRTRAN(IIF(ISNULL(cForm)," ",cForm),"'","''"))+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@CC ='"+ALLTRIM(STRTRAN(IIF(ISNULL(cCC)," ",cCC),"'","''"))+"'"
						cSQLi = cSQLi+ ",@Cond ='"+ALLTRIM(STRTRAN(IIF(ISNULL(' ')," ",' '),"'","''"))+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@Size ="+STR(IIF(ISNULL(nThck),0,nThck),9,3)+""   &&NOT NULL
						cSQLi = cSQLi+ ",@PAID ="+STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,8)+""
						cSQLi = cSQLi+ ",@MWeight =0"
						cSQLi = cSQLi+ ",@specs ='"+cSpecs+"'"
						cSQLi = cSQLi+ ",@Heat ='"+ALLTRIM(STRTRAN(IIF(ISNULL('Due In')," ",'Due In'),"'","''"))+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@Lot =' '" &&+ALLTRIM(STRTRAN(IIF(ISNULL(cLOT),"",cLOT),"'","''"))+"'"
						cSQLi = cSQLi+ ",@PO_Item ='"+cPoItem+"'"
						cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
						cSQLi = cSQLi+ ",@History =' '" &&+ALLTRIM(STRTRAN(IIF(ISNULL(cHistory),"",cHistory),"'","''"))+"'"
						cSQLi = cSQLi+ ",@Mill =' '"
						cSQLi = cSQLi+ ",@StkDate =''" &&+IIF(EMPTY(dStkDate),'',DTOC(dStkDate))+"'"
						cSQLi = cSQLi+ ",@Num = 0 " &&+STR(IIF(ISNULL(nNum),0,nNum),8,0)+""
						cSQLi = cSQLi+ ",@POStatus ='"+ALLTRIM(STRTRAN(IIF(ISNULL('D'),"",'D'),"'","''"))+"'"
						cSQLi = cSQLi+ ",@BrandName ='"+cBrandName+"'"
						cSQLi = cSQLi+ ",@From_ID = 0" &&+STR(IIF(ISNULL(nFrom_ID),0,nFrom_ID))+""
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Master')
							nBrokerMaster_ID = 0
							lSQLgood = .F.
						ELSE
							nBrokerMaster_ID = tmpID_Master.EXP
						ENDIF
						IF USED('tmpID_Master')
							USE IN tmpID_Master
						ENDIF
					ELSE
						*Found as Deleted
						lNeedSave = .F.
					ENDIF
				ENDIF
				*MASTER
		*		********************************** BrokerLst
				*DETAIL
				IF lSQLgood AND lNeedSave
					*Save Detail
					cSQL_Detail_cnt="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Detail WHERE ID = "+ALLTRIM(STR(nBrokerMaster_ID))
		
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_cnt, 'StkDetailCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_cnt, 'StkDetailCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_Detail_cnt,ThisForm.nConnHandle,nSQLEXEC, 'StkDetailCnt')
						nStkDetailCnt = 0
						lSQLgood = .F.
					ELSE
						nStkDetailCnt = StkDetailCnt.counted
					ENDIF
					IF USED("StkDetailCnt")
						USE IN StkDetailCnt
					ENDIF
		
					cSQL_Detail_DEL_cnt="SELECT COUNT(ID) AS counted FROM dbo.[Ar.BrokerLst_Detail_History] WHERE ID = "+ALLTRIM(STR(nBrokerMaster_ID))
					cSQL_Detail_DEL_cnt=cSQL_Detail_DEL_cnt+" AND [WHAT] <> 'ADD'"
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_DEL_cnt, 'StkDetail_DELCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL_Detail_DEL_cnt, 'StkDetail_DELCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_Detail_DEL_cnt,ThisForm.nConnHandle,nSQLEXEC, 'StkDetail_DELCnt')
						nStkDetail_DELCnt = 0
						lSQLgood = .F.
					ELSE
						nStkDetail_DELCnt = StkDetail_DELCnt.counted
						IF nStkDetail_DELCnt > 0
							*IF MESSAGEBOX("Are you sure you want to Edit This?",4+16,"This StockLst item has Accounting Value.") = 6
								nStkDetail_DELCnt = 0
								TrackMess("BrokerLst_Process_History for ID="+ALLTRIM(STR(nMaster_ID))+" has more than just 'ADD' - Probable Edits, user continued anyway."+" frmEdt.PO_SaveAdd()")
							*ENDIF
						ENDIF
		
					ENDIF
					IF USED("StkDetail_DELCnt")
						USE IN StkDetail_DELCnt
					ENDIF
		
		
					IF nStkDetailCnt > 0
						*Found Detail belonging to Masters ID
						*IF Master has been Received in, then lNeedSave would be False and this code would be skipped
		
						IF nStkDetail_DELCnt = 0
							*Did not find any Edits in History of the Detail record
							*Check for Change
							cSQL_Detail_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Detail WHERE [ID] = "+STR(nBrokerMaster_ID)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [PC] = "   + STR(nPieces)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [DIM1] = " + STR(nThck,18,4)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [DIM2] = " + STR(nSz2,18,4)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [DIM3] = " + STR(nSz3,18,4)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [WEIGHT] = " + STR(nStockLst_QTY,9,2)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [COSTVALUE] = " + STR(nStockLst_P,18,8)
		*					cSQL_Detail_PO=cSQL_Detail_PO+" AND [InvoiceValue] = " + STR(nStockLst_P,18,8)
							cSQL_Detail_PO=cSQL_Detail_PO+" AND [RANDLEN] = " + IIF(lRandLen,"1","0")
							
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_QTY = " + STR(nStockLst_P,18,4) + ""
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_P = " + STR(nStockLst_P,18,4) + ""
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_Total = " + STR(nS_Total,18,4) + ""
							cSQL_Detail_PO=cSQL_Detail_PO+" AND S_PU = " + STR(nS_PU) + ""
		
							SELECT 0
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_PO, 'StkDetailCnt')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_PO, 'StkDetailCnt')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL_Detail_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkDetailCnt')
								nStkDetailCnt = 0
							ELSE
								nStkDetailCnt = StkDetailCnt.counted
							ENDIF
							IF USED("StkDetailCnt")
								USE IN StkDetailCnt
							ENDIF
							IF nStkDetailCnt = 0  &&Found A Change
		
								*Update
								cSQL_Detail_Update = "UPDATE dbo.BrokerLst_Detail SET "
								cSQL_Detail_Update = cSQL_Detail_Update +" PC = "   + STR(nPieces)    + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",DIM1 = " + STR(nThck,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",DIM2 = " + STR(nSz2,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",DIM3 = " + STR(nSz3,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",LENGTH = "+"'Listing created from new PO:"+ALLTRIM(STR(nHPAPO))+" needed for a SO:"+ALLTRIM(STR(nSalesNum))+".'" + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",WEIGHT = " + STR(nStockLst_QTY,9,2) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",COSTVALUE = " + STR(nStockLst_P,18,8) + ""
								*cSQL_Detail_Update = cSQL_Detail_Update +",InvoiceValue= " + STR(nStockLst_P,18,8) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",RANDLEN = " + IIF(lRandLen,"1","0")
								cSQL_Detail_Update = cSQL_Detail_Update +",location ='"+cShipLocation+"'"
								cSQL_Detail_Update = cSQL_Detail_Update +",Unit ='"+cLstDetailUnit+"'"
								
								cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " + STR(nStockLst_P,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " + STR(nStockLst_P,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = " + STR(nS_Total,18,4) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " + STR(nS_PU) + ""
		
								cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID = "+STR(nBrokerMaster_ID)+""
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
									lSQLgood = .F.
								ENDIF
							ENDIF
		
							*Get ID_Detail
							IF USED('tmpID_Detail')
								USE IN tmpID_Detail
							ENDIF
							SELECT 0
							cSQLi = "SELECT ID_Detail FROM dbo.BrokerLst_Detail WHERE ID = "+STR(nBrokerMaster_ID)+""
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Detail')
								lSQLgood = .F.
							ELSE
								nID_Detail = tmpID_Detail.ID_Detail
							ENDIF
							IF USED('tmpID_Detail')
								USE IN tmpID_Detail
							ENDIF
						ELSE
							*Found Detail belonging to Masters ID
							*Found Edits to the Detail record
							*DO NOT EDIT
							MESSAGEBOX("Cannot update BrokerLst"+CHR(13)+"Have Accountant make changes if needed.",0,"Cannot save here!")
							lNeedSave = .F.
							
							*Get nID_Detail_Process
							IF nBrokerMaster_ID > 0
								*Get ID_Detail_Process
								IF USED('tmp_ID_Detail_Pro')
									USE IN tmp_ID_Detail_Pro
								ENDIF
		
								cSQL = "SELECT ID_Detail_Process FROM dbo.BrokerLst_Process_Detail WHERE ID = "+STR(nBrokerMaster_ID)
								*" AND PO_Item = dbo.ProperPO('"+PoItem+"')"
		
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmp_ID_Detail_Pro')
									lSQLgood = .F.
									*Could not Check for Process
								ELSE
									nID_Detail_Process = tmp_ID_Detail_Pro.ID_Detail_Process
								ENDIF
								IF USED('tmp_ID_Detail_Pro')
									USE IN tmp_ID_Detail_Pro
								ENDIF
							ENDIF
		
						ENDIF
					ELSE   &&nStkDetailCnt > 0
						*No Detail record exist in current
						IF nStkDetail_DELCnt = 0
							*Did not find any Edits in History of the Detail record
		
							*INSERT
							IF USED('tmpID_Detail')
								USE IN tmpID_Detail
							ENDIF
							SELECT 0
							*ALLTRIM(STRTRAN(IIF(ISNULL(cAlloy)," ",cAlloy),"'","''"))
							cSQLi = "EXEC p_BrokerLst_Detail_ins "
							cSQLi = cSQLi + " @size_h ="+'NULL'
							cSQLi = cSQLi + ",@size_l ="+'NULL'
							cSQLi = cSQLi + ",@pc ="+ STR(IIF(ISNULL(nPieces),0,nPieces))
							cSQLi = cSQLi + ",@dim1 =" + STR(IIF(ISNULL(nThck),0,nThck),18,4)
							cSQLi = cSQLi + ",@dim2 =" + STR(IIF(ISNULL(nSz2),0,nSz2),18,4)
							cSQLi = cSQLi + ",@dim3 =" + STR(IIF(ISNULL(nSz3),0,nSz3),18,4)
							cSQLi = cSQLi + ",@length ="+"'Listing created from new PO:"+ALLTRIM(STR(nHPAPO))+" needed for a SO:"+ALLTRIM(STR(nSalesNum))+".'"
							cSQLi = cSQLi + ",@weight =" + STR(IIF(ISNULL(nStockLst_QTY),0,nStockLst_QTY),9,2)
							*cSQLi = cSQLi + ",@costvalue =" + STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,8)
							cSQLi = cSQLi + ",@costvalue =" + STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,8)
							cSQLi = cSQLi + ",@descript ='"+"'"
							cSQLi = cSQLi + ",@location ='"+"'"
							cSQLi = cSQLi + ",@floorstatus ='"+"'"
							cSQLi = cSQLi + ",@class ='"+"'"
							cSQLi = cSQLi + ",@unit ='"+cLstDetailUnit+"'"
							cSQLi = cSQLi + ",@RandLen ="+IIF(lRandLen,"1","0")	&&'"+"'"
							cSQLi = cSQLi + ",@ID ="+STR(nBrokerMaster_ID)
							cSQLi = cSQLi + ",@ID_Detail_Process ="+STR(nID_Detail_Process)
		
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Detail')
								lSQLgood = .F.
							ELSE
								IF USED('tmpID_Detail')
									nID_Detail = tmpID_Detail.EXP
									USE IN tmpID_Detail
									
									*Now update what does not fit in p_BrokerLst_Detail_ins
									cSQL_Detail_Update = "UPDATE dbo.BrokerLst_Detail SET "
									cSQL_Detail_Update = cSQL_Detail_Update +" location ='"+cShipLocation+"'"
									
									cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " + STR(nStockLst_P,18,4) + ""
									cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " + STR(nStockLst_P,18,4) + ""
									cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = " + STR(nS_Total,18,4) + ""
									cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " + STR(nS_PU) + ""
		
									cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID_Detail = "+STR(nID_Detail)
									
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
									ENDIF
									
								ELSE
									*Insert Failed
									SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Detail')
									lSQLgood = .F.
									MESSAGEBOX('Could not SAVE detail',0,'Error')
								ENDIF
							ENDIF
						ELSE
							*Found Edits in History of the Detail record
							MESSAGEBOX("Cannot update BrokerLst"+CHR(13)+"Have Accountant make changes if needed.",0,"Cannot save here!")
							lNeedSave = .F.
						ENDIF
					ENDIF  &&nStkDetailCnt > 0
				ENDIF  &&IF lSQLgood AND lNeedSave
				*Detail
		*		******************************** BrokerLst
		*			Not Stock
				*Process
				IF lSQLgood AND lNeedSave AND nBrokerMaster_ID > 0
					*POStatus says Part has NOT been received!
					*No edites to Master
					*No Edites to Detail
		
					* Check Process
					cSalesPerson = LEFT( SalesPDescription(cSalesP) ,20 )
					cComment = PrepareSQLtxt( LEFT(cFullDescr+" POi"+cPoItem+ IIF(EMPTY(cShipVia),""," ShipVia:"+ALLTRIM(cShipVia))+;
					IIF(EMPTY(cJobNumber),""," JobNumber:"+ALLTRIM(cJobNumber))+;
					IIF(EMPTY(cCond_Spec),""," Cond_Spec:"+ALLTRIM(cCond_Spec)),99), 'Comment',100) 
					cProcess_ID = "INCOMING"
					cProcessor = 'EnterOrder'
					cAllowSub = 'N'
		
					IF USED('tmp_ID_Detail_Pro')
						USE IN tmp_ID_Detail_Pro
					ENDIF
		
					cSQL = "SELECT ID_Detail_Process FROM dbo.BrokerLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))+;
					" AND dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmp_ID_Detail_Pro')
						lSQLgood = .F.
						*Could not Check for Process
					ELSE
						nID_Detail_Process = tmp_ID_Detail_Pro.ID_Detail_Process
					ENDIF
		
		
					IF lSQLgood AND USED('tmp_ID_Detail_Pro')
						IF RECCOUNT('tmp_ID_Detail_Pro') > 0
							*Check for Change
							cSQL_Process_PO="SELECT COUNT(*) AS counted FROM dbo.BrokerLst_Process WHERE [ID_Detail_Process] = "+STR(nID_Detail_Process)
							cSQL_Process_PO=cSQL_Process_PO+" AND [SOItem]='"+cSOitem+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [SalesPerson]='"+cSalesPerson+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [DueDate]='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [Process_ID]='"+cProcess_ID+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [Processor]='"+cProcessor+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [AllowSub]='"+cAllowSub+"'"
							cSQL_Process_PO=cSQL_Process_PO+" AND [PWeight]="+STR(nPWeight,9,2)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [PPC]="+STR(nPieces)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [PFt]="+STR(nPFt,10,4)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [PU]="+STR(nPU)+""
							cSQL_Process_PO=cSQL_Process_PO+" AND [ID_Detail]="+STR(nID_Detail)+""
		
							SELECT 0
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process_PO, 'StkDetailCnt')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process_PO, 'StkDetailCnt')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL_Process_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkDetailCnt')
								nStkDetailCnt = 0
							ELSE
								nStkDetailCnt = StkDetailCnt.counted
							ENDIF
							IF USED("StkDetailCnt")
								USE IN StkDetailCnt
							ENDIF
							IF nStkDetailCnt = 0  &&Found A Change
		
								**UPDATE
								cSQL_ProcUp = "UPDATE dbo.BrokerLst_Process SET"
								cSQL_ProcUp = cSQL_ProcUp + " SOItem='"+cSOitem+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",PO_Item='"+cPoItem+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",SalesPerson='"+cSalesPerson+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",Comment='"+cComment+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",Process_ID='"+cProcess_ID+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",Processor='"+cProcessor+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",AllowSub='"+cAllowSub+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",PWeight="+STR(nPWeight,9,2)+""
								cSQL_ProcUp = cSQL_ProcUp + ",PPc="+STR(nPieces)+""
								cSQL_ProcUp = cSQL_ProcUp + ",PFt="+STR(nPFt,10,4)+""
								cSQL_ProcUp = cSQL_ProcUp + ",PU="+STR(nPU)+""
								cSQL_ProcUp = cSQL_ProcUp + ",ID_Detail="+STR(nID_Detail)+" "
								cSQL_ProcUp = cSQL_ProcUp + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL_ProcUp,ThisForm.nConnHandle,nSQLEXEC)
									lSQLgood = .F.
									=SQLROLLBACK(ThisForm.nConnHandle)
								ELSE
									=SQLCOMMIT(ThisForm.nConnHandle)
								ENDIF
							ELSE
								=SQLCOMMIT(ThisForm.nConnHandle)
							ENDIF
						ELSE
							**INSERT
							*!*	*Create Process
							IF USED("tmpID_Detail_Process")
								USE IN tmpID_Detail_Process
							ENDIF
							SELECT 0
		
							*p_BrokerLst_Process_ins
							cSQLi = "EXEC p_BrokerLst_Process_ins2 "
							cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
							cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
							cSQLi = cSQLi + ",@StartDate = '"+DTOC( DATE() )+"'"
							cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
							cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
							cSQLi = cSQLi + ",@PWeight = "+STR(nPWeight,9,2)
							cSQLi = cSQLi + ",@PPc = "+STR(nPPc)
							cSQLi = cSQLi + ",@PFt = "+STR(nPFt,10,4)
							cSQLi = cSQLi + ",@PU = "+STR(nPU)
							cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
							cSQLi = cSQLi + ",@PO_item = '"+cPoItem+"'"
							cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"
							cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
							cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
							ENDDO
							
							IF nSQLEXEC < 0
								*retry
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
								ENDDO
							ENDIF
		
							IF nSQLEXEC < 0
								=SQLROLLBACK(ThisForm.nConnHandle)
								SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Detail_Process')
								lSQLgood = .F.
							ELSE
								nID_Detail_Process = tmpID_Detail_Process.EXP
								=SQLCOMMIT(ThisForm.nConnHandle)
							ENDIF
						ENDIF
						
						***************
						*mark stock with a "SELECTED" process
									
						ThisForm.StockLst_Process_Save( nID_Detail, cSOitem, cSalesPerson, nPWeight, nPPc, nPFt, nPU, cComment, dDueDate, cPoItem, 'BrokerLst' )
						
						*Check for a 'Custom Stock' Process, and remove because it changed to BrokerLst
						ThisForm.StockLst_Process_Remove_Custom( nID_Detail, cPoItem, 'BrokerLst' )			
						
						**************
					ENDIF
		
					IF USED('tmp_ID_Detail_Pro')
						USE IN tmp_ID_Detail_Pro
					ENDIF
				ELSE
					*POStatus says Part has been received!
					*an ERROR has occured on Master
				ENDIF  && lSQLGood AND lNeedSave AND nBrokerMaster_ID > 0
				******************************************************************************************
				*****************************************************************************************
				*******************************************************************************************
				=SQLSETPROP(ThisForm.nConnHandle,'Transactions',1)
			ENDIF &&  $ "ALL FOR STOCK,MOSTLY STOCK,SOME STOCK"
		
		ELSE  && IF lPOSaveLst
			*Remove from Lst
			
			************************
			**** StockLst SQL ****              SEE SIMULAR CODE IN ENTERORDER PO_VALID
			************************
			PRIVATE nStockMaster_ID
			nStockMaster_ID = 0
			PRIVATE nStkMastID 
		
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
				nStkMastCnt = 0
			ELSE
				nStkMastCnt = StkMastCnt.counted
			ENDIF
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
		
			IF nStkMastCnt > 0
				PRIVATE nStkMastID 
				*Found Purchase Order in curent Master!
				*See if has been Received in - do not overwite received data!
				cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
				cSQL_Master_PO=cSQL_Master_PO+" AND POStatus != 'D'"  &&Due in DPWA
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
					nStkMastCnt = 0
				ELSE
					nStkMastCnt = StkMastCnt.counted
				ENDIF
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
		
				cSQL_Master_PO="SELECT ID FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
					nStkMastID = 0
				ELSE
					nStkMastID = StkMastCnt.ID
				ENDIF		
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				
								
				IF  lServicesPO
					IF nStkMastCnt > 0
						MESSAGEBOX("This PO: "+ALLTRIM(cPoItem)+"  has been received and cannot be removed from StockLst"+CHR(13)+"This item is not to be saved in list.",0+48,"Cannot remove this Service PO.")
					ELSE
						Remove_StockLst_ID(nStkMastID ,ThisForm.nConnHandle,.T.,'Remove PO','Service PO')
					ENDIF
				ELSE
					IF nStkMastCnt > 0
						MESSAGEBOX("This PO: "+ALLTRIM(cPoItem)+"  has been received and cannot be removed from StockLst"+CHR(13)+"This item is not to be saved in list.",0+48,"Cannot remove this PO.")
					ELSE
						Remove_StockLst_ID(nStkMastID,ThisForm.nConnHandle,.T.,'Remove PO','Edited PO.')
					ENDIF
				ENDIF
			ENDIF
		
			************************
			**** BrokerLst SQL ****
			************************
			PRIVATE nBrokerMaster_ID
			nBrokerMaster_ID = 0
			PRIVATE nStkMastID 
		
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
				nStkMastCnt = 0
			ELSE
				nStkMastCnt = StkMastCnt.counted
			ENDIF
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
		
			IF nStkMastCnt > 0
				
				*Found Purchase Order in curent Master!
				*See if has been Received in - do not overwite received data!
				cSQL_Master_PO="SELECT COUNT(ID) AS counted FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
				cSQL_Master_PO=cSQL_Master_PO+" AND POStatus != 'D'"  &&Due in DPWA
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
					nStkMastCnt = 0
				ELSE
					nStkMastCnt = StkMastCnt.counted
				ENDIF
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
		
				cSQL_Master_PO="SELECT ID FROM dbo.BrokerLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPoItem+"')"
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastCnt' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle,nSQLEXEC, 'StkMastCnt')
					nStkMastID = 0
				ELSE
					nStkMastID = StkMastCnt.ID
				ENDIF		
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
				
								
				IF  lServicesPO
					IF nStkMastCnt > 0
						MESSAGEBOX("This PO: "+ALLTRIM(cPoItem)+"  has been received and cannot be removed from BrokerLst"+CHR(13)+"This item is not to be saved in list.",0+48,"Cannot remove this Service PO.")
					ELSE
						Remove_BrokerLst_ID(nStkMastID,ThisForm.nConnHandle,.T.,'Remove PO','Service PO')
					ENDIF
				ELSE
					IF nStkMastCnt > 0
						MESSAGEBOX("This PO: "+ALLTRIM(cPoItem)+"  has been received and cannot be removed from BrokerLst"+CHR(13)+"This item is not to be saved in list.",0+48,"Cannot remove this PO.")
					ELSE
						Remove_BrokerLst_ID(nStkMastID,ThisForm.nConnHandle,.T.,'Remove PO','PO was Edited.')
					ENDIF
				ENDIF
			ENDIF
		ENDIF && lPOSaveLst
		***********
		
		IF lPOSaveOK
		*!*	INSERT INTO Vendor (Company,Contact) VALUES (cBuyFrom, cPOSalesP)
			IF NOT EMPTY( cCompany )
				IF NOT Is_VendorCompany( cCompany,ThisForm.nConnHandle )
					INSERT_VendorCompany( cCompany,cPOSalesP,ThisForm.nConnHandle )
				ENDIF
			ENDIF
			
			*Update SalesQuote - for Quick acces to PO in SO - Not Accurate!
			*m.cPOitem
			IF nItemPo = 1
				SELECT SalesQuote
				REPLACE SalesQuote.BuyFrom	WITH cBuyFrom
				REPLACE SalesQuote.HPApo	WITH nHpaPo
			ELSE
				SELECT SalesQuote
				IF EMPTY(SalesQuote.BuyFrom)
					*Replace top PO
					REPLACE SalesQuote.BuyFrom	WITH cBuyFrom
					REPLACE SalesQuote.HPApo	WITH nHpaPo
				ELSE
					*Replace bottom PO
					REPLACE SalesQuote.BuyFrom2	WITH cBuyFrom
					REPLACE SalesQuote.HPApo2	WITH nHpaPo
				ENDIF
			ENDIF
			
			*Track Usage
			TrackMess("PO "+ALLTRIM(m.cPOitem)+" was Updated"+" frmEdt.PO_SaveAdd()")
		
		ENDIF
		IF lPOSaveOK 
			***** PO_Testing
			
			IF ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Enabled
				**Testing was in Edit mode!
				*PRIVATE cPOitem,nHPAPO,nItemPO,cSOitem,nSalesNum,nItemSO
				PRIVATE cAlloy,cHeat,cLot,cForm,nSize,nQuantity
				PRIVATE cTestType,cTestPackage,cDelivService,cReturnSamples,cSpeciDia,cSpeciLoc
				PRIVATE cTensileTest,cTensileConf,cTensileTemp,cUSonicTest,cUSonicType
				PRIVATE cHardTest, cHardConf,cHardProf,cIGCorrTest,cStressTest,cCharpyTest,cCharpyTemp
								
				*cPOitem 	= Proper_PO_Item(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblPOitem.Caption)
				*nHPAPO		= VAL(cPOitem)
				*nItemPO		= VAL(RIGHT(cPOitem,2))
				*cSOitem		= Proper_SO_Item(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblSOitem.Caption)
				*nSalesNum	= VAL(cSOitem)
				*nItemSO		= VAL(RIGHT(cSOitem,2))
				cAlloy		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Value,'Alloy',12)
				cHeat		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtHeat.Value,'Heat',35)
				cLot		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtLot.Value,'Lot',10)
				cForm		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtForm.Value,'Form',2)
				nSize		= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtSize.Value ,'Size',9,3)
				nQuantity	= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtQuantity.Value,'Quantity',-2,0)
				cTestType	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestType.Value,'TestType',1)
				cTestPackage	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestPackage.Value,'TestPackage',1)
				cDelivService	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogDelivery.Value,'DelivService',1)
				cReturnSamples	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogReturnSamples.Value,'ReturnSaqmples',1)
				
				cSpeciDia	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSpecimen.Value,'SpeciDia',50)
				cSpeciLoc	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogLocation.Value,'SpeciLoc',1)
				cTensileTest= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileProc.Value,'TensileTest',30)
				cTensileConf= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileConf.Value,'TensileConf',30)
				cTensileTemp= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileTemp.Value,'TensileTemp',30)
				cUSonicTest	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSonicProc.Value,'USonicTest',30)
				cUSonicType	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogSonicType.Value,'UsonicType',1)
				cHardTest	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardProc.Value,'HardTest',30)
				cHardConf	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardConf.Value,'HardConf',30)
				cHardProf	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.ogHardProfile.Value,'HardProf',1)
				cIGCorrTest	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbIGCorrProc.Value,'IGCorrTest',30)
				cStressTest	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbStressProc.Value,'StressTest',30)
				cCharpyTest	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyProc.Value,'CharpyTest',30)
				cCharpyTemp	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyTemp.Value,'CharpyTemp',30)
				
				*********
				IF USED("cntPO_T")
					USE IN cntPO_T
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PO_Testing WHERE POitem = '"+cPOitem+"'"
				
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO_T')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPO_T' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC,'cntPO_T')
				ENDIF		
				IF USED("cntPO_T")
					nPO_T = cntPO_T.cntd
					USE IN cntPO_T
				ELSE
					nPO_T = 0
				ENDIF
		
				IF nPO_T > 0
					*Update
					cSQL = "UPDATE dbo.PO_Testing SET "	
					*cPOitem
					cSQL = cSQL +"SOitem='"+cSOitem+"'"
					cSQL = cSQL +",SalesNum="+STR(nSalesNum)
					cSQL = cSQL +",ItemSO="+STR(nItemSO,2,0)
					cSQL = cSQL +",Alloy='"+cAlloy+"'"
					cSQL = cSQL +",Heat='"+cHeat+"'"
					cSQL = cSQL +",Lot='"+cLot+"'"
					cSQL = cSQL +",Form='"+cForm+"'"
					cSQL = cSQL +",Size="+STR(nSize,9,3)
					cSQL = cSQL +",Quantity="+STR(nQuantity)
					cSQL = cSQL +",TestType='"+cTestType+"'"
					cSQL = cSQL +",TestPackage='"+cTestPackage+"'"
					cSQL = cSQL +",DelivService='"+cDelivService+"'"
					cSQL = cSQL +",ReturnSamples='"+cReturnSamples+"'"
					cSQL = cSQL +",SpeciDia='"+cSpeciDia+"'"
					cSQL = cSQL +",SpeciLoc='"+cSpeciLoc+"'"
					cSQL = cSQL +",TensileTest='"+cTensileTest+"'"
					cSQL = cSQL +",TensileConf='"+cTensileConf+"'"
					cSQL = cSQL +",TensileTemp='"+cTensileTemp+"'"
					cSQL = cSQL +",USonicTest='"+cUSonicTest+"'"
					cSQL = cSQL +",USonicType='"+cUSonicType+"'"
					cSQL = cSQL +",HardTest='"+cHardTest+"'"
					cSQL = cSQL +",HardConf='"+cHardConf+"'"
					cSQL = cSQL +",HardProf='"+cHardProf+"'"
					cSQL = cSQL +",IGCorrTest='"+cIGCorrTest+"'"
					cSQL = cSQL +",StressTest='"+cStressTest+"'"
					cSQL = cSQL +",CharpyTest='"+cCharpyTest+"'"
					cSQL = cSQL +",CharpyTemp='"+cCharpyTemp+"'"
					cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
				ELSE
					*Insert
					cSQL = "INSERT INTO dbo.PO_Testing ("
					cSQL = cSQL +"POitem,HPAPo,ItemPO,SOitem,SalesNum,ItemSO,Alloy,Heat,Lot,Form,Size,Quantity"
					cSQL = cSQL +",TestType,TestPackage,DelivService,ReturnSamples,SpeciDia,SpeciLoc"
					cSQL = cSQL +",TensileTest,TensileConf,TensileTemp,USonicTest,USonicType"
					cSQL = cSQL +",HardTest,HardConf,HardProf,IGCorrTest,StressTest,CharpyTest,CharpyTemp"
					cSQL = cSQL +") VALUES ("
					cSQL = cSQL +"'"+cPOitem+"'"
					cSQL = cSQL +","+STR(nHPAPO)+""
					cSQL = cSQL +","+STR(nItemPO,2,0)+""
					cSQL = cSQL +",'"+cSOitem+"'"
					cSQL = cSQL +","+STR(nSalesNum)+""
					cSQL = cSQL +","+STR(nItemSO,2,0)+""
					cSQL = cSQL +",'"+cAlloy+"'"
					cSQL = cSQL +",'"+cHeat+"'"
					cSQL = cSQL +",'"+cLot+"'"
					cSQL = cSQL +",'"+cForm+"'"
					cSQL = cSQL +","+STR(nSize,9,3)
					cSQL = cSQL +","+STR(nQuantity)
					cSQL = cSQL +",'"+cTestType+"'"
					cSQL = cSQL +",'"+cTestPackage+"'"
					cSQL = cSQL +",'"+cDelivService+"'"
					cSQL = cSQL +",'"+cReturnSamples+"'"
					cSQL = cSQL +",'"+cSpeciDia+"'"
					cSQL = cSQL +",'"+cSpeciLoc+"'"
					cSQL = cSQL +",'"+cTensileTest+"'"
					cSQL = cSQL +",'"+cTensileConf+"'"
					cSQL = cSQL +",'"+cTensileTemp+"'"
					cSQL = cSQL +",'"+cUSonicTest+"'"
					cSQL = cSQL +",'"+cUSonicType+"'"
					cSQL = cSQL +",'"+cHardTest+"'"
					cSQL = cSQL +",'"+cHardConf+"'"
					cSQL = cSQL +",'"+cHardProf+"'"
					cSQL = cSQL +",'"+cIGCorrTest+"'"
					cSQL = cSQL +",'"+cStressTest+"'"
					cSQL = cSQL +",'"+cCharpyTest+"'"
					cSQL = cSQL +",'"+cCharpyTemp+"'"
					cSQL = cSQL +")"
					
				ENDIF
				
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF		
				
				
				THISFORM.POTestingScreen("DISABLE")
				
			ENDIF
			***** End PO_Testing
		ENDIF
		
		IF lPOSaveOK 
			IF nSalesNum > 0
				Validate_Sales_ShipDue(cSOitem,ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		IF lPOSaveOK 
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.VALUE = 0
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.VALUE = 0
			THISFORM.POScreen("DISABLE")
			THISFORM.Show_Po()
			THISFORM.pf.pg_po.cmdPOEdit.CAPTION = "Edit PO"
			THISFORM.pf.pg_po.cmdPODelete.CAPTION = "Delete"
		
		
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.REFRESH
		ENDIF
		
		
		
		
		
	ENDPROC

	PROCEDURE po_valid
		PARAMETER lcPara
		*ThisForm.PO_Valid
		*"SAVE","EDIT","NEW","CANCEL","UNCANCEL","DELETE"
		
		PRIVATE cBuyFrom,nHpaPo
		PRIVATE nItemPo,cCompany,m.txtSalesP,m.txtPieces,m.txtAlloy,m.txtDispAlloy,m.txtStandSize,m.txtForm,m.txtThck,m.txtSz2,m.txtSz3
		PRIVATE m.txtP_lb,m.txtP_pc,m.txtP_ft,m.txtLotP,m.txtOtherP,m.txtOtherFld,m.txtOrder_Qty,nStockLst_QTY,nStockLst_P
		PRIVATE	m.txtOrderDate,m.txtDue_Min,m.txtDue_Max,m.txtHPA_Due_Min,m.txtHPA_Due_Max,m.txtReceipt,m.txtMisc_purch,m.txtCond_Spec, cSpecs 
		PRIVATE	cPOitem, m.SOitem, m.SalesQuote, m.Item
		PRIVATE m.txtPOSalesName, lServicesPO, lConvServ, lEquipment, m.cmbStock, m.txtShipVia, m.txtJobNumber,m.sheet_pk
		PRIVATE m.lRandLen, m.lMetric
		PRIVATE nLotCost
		PRIVATE lClone
		PRIVATE m.cAlloy, m.Length, m.dDueDate
		PRIVATE cMill,m.mweight
		PRIVATE lSQLgood,lMany_ID_Details
		lSQLgood = .T.
		
		lClone = .F.
		lMany_ID_Details = .F.
		
		PRIVATE cSalesP
		cSalesP		= PrepareSQLtxt(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtSalesP.VALUE,'SalesP',1,.F.)
		
		PRIVATE nStkMastCnt, nMaster_ID, nBrokerMaster_ID, nID_Detail
		nHpaPo		= PrepareSQLnum(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtHpaPo.VALUE,'HPAPO',-3)
		nItemPo		= PrepareSQLnum(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtItemPo.VALUE,'ItemPO',2,0)
		cPOitem		= Proper_PO_Item( STR(nHpaPo)+"-"+STR(nItemPo,2,0) )
		cMill		= PrepareSQLtxt(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtCompany.VALUE,"Mill",10,.F.,.T.)
		
		lServicesPO	= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.VALUE,'ServicesPO')
		lConvServ	= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.VALUE,'ConvServ')
		lEquipment	= PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkEquipment.VALUE,'Equipment')
		
		PRIVATE nStkMastID,nDecimal
		
		*Check
		IF TYPE('nHpaPo') = "C"
			nDecimal = SET("DECIMAL")
			SET DECIMAL TO 0
			nHpaPo = VAL(nHpaPo)
			SET DECIMAL TO nDecimal
		ENDIF
		
		*m.txtThck
		
		PRIVATE cSQLUpdate, cSQL_Master_PO
		PRIVATE cSQL,cSQLid, nSQLEXEC
		
		PRIVATE cSOitem, nItemSO, nSalesNum
		cSOitem	= Proper_SO_Item(SalesQuote.SoItem_A)
		nItemSO		= SalesQuote.Item_A
		nSalesNum	= SalesQuote.SalesNum_a
		IF cSOitem = Proper_SO_item( STR(0)+"-"+STR(0) )
			cSOItem = "STOCK"
			nSalesNum = 0
			nItemSO	 = 0
		ENDIF
		IF nSalesNum = 0
			cSOItem = "STOCK"
			nItemSO	 = 0
		ENDIF
		
		IF lServicesPO
			nSalesNum = 0
			cSOItem = "LabService"
		ENDIF
		IF lConvServ
			nSalesNum = 0
			cSOItem = "ConvertSVC"
		ENDIF
		IF lEquipment
			nSalesNum = 0
			cSOItem = "Equipment"
		ENDIF
		
		******************************
		nMaster_ID = 0
		
		PRIVATE nDecimal
		nDecimal = SET("DECIMAL")
		PRIVATE lPOSaveLst
		lPOSaveLst = .F.
		
		DO CASE
		CASE lcPara = "SAVE"
			*Check SigDim
			PRIVATE cForm, nSigDim 
			cForm	= PrepareSQLtxt(ThisForm.pf.pg_po.PgfPO.PgPODesc.cmbForm.Value,'Form',2,.T.)
			nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
			*returns TinyInt 0 Pc, 1 Weight, 2 Dim2, 3 Dim3, 4-,5-, 6 dim2*3
		
			PRIVATE nPieces,nThck,nSz2,nSz3,nPounds
			nPieces			= PrepareSQLnum(ThisForm.pf.pg_po.PgfPO.PgPODesc.txtPieces.VALUE,'Pieces',6,0)
			nThck			= PrepareSQLnum(ThisForm.pf.pg_po.PgfPO.PgPODesc.txtThck.VALUE,'Thck',10,4)
			nSz2			= PrepareSQLnum(ThisForm.pf.pg_po.PgfPO.PgPODesc.txtSz2.VALUE,'Sz2',9,3)
			nSz3			= PrepareSQLnum(ThisForm.pf.pg_po.PgfPO.PgPODesc.txtSz3.VALUE,'Sz3',9,3)
			nPounds			= PrepareSQLnum(ThisForm.pf.pg_po.PgfPO.PgPODesc.txtPounds.VALUE,'Pounds',9,1)
		
			IF nThck > 0
			ELSE
				MESSAGEBOX("This Form:'"+cForm+"' requires THCK to be entered!",16,"Cannot use 0 Thck for this Form! - Retry Save.")
				RETURN .F.
			ENDIF
		
			DO CASE
			CASE nSigDim = 0
				IF nPieces > 0
				ELSE
					MESSAGEBOX("This Form:'"+cForm+"' requires the number of Pieces to be entered!",16,"Cannot use 0 Pcs for this Form! - Retry Save.")
					RETURN .F.
				ENDIF
			CASE nSigDim = 1
				IF nPounds > 0
				ELSE
					MESSAGEBOX("This Form:'"+cForm+"' requires the number of Pounds to be entered!",16,"Cannot use 0 Pounds for this Form! - Retry Save.")
					RETURN .F.
				ENDIF
			CASE nSigDim = 2
				IF nSz2 > 0
				ELSE
					MESSAGEBOX("This Form:'"+cForm+"' requires Sz2 to be entered!",16,"Cannot use 0 Sz2 for this Form! - Retry Save.")
					RETURN .F.
				ENDIF
			CASE nSigDim = 3
				IF nSz3 > 0
				ELSE
					MESSAGEBOX("This Form:'"+cForm+"' requires Sz3 to be entered!",16,"Cannot use 0 Sz3 for this Form! - Retry Save.")
					RETURN .F.
				ENDIF
			CASE nSigDim = 6
				IF nSz2 > 0
				ELSE
					MESSAGEBOX("This Form:'"+cForm+"' requires Sz2 to be entered!",16,"Cannot use 0 Sz2 for this Form! - Retry Save.")
					RETURN .F.
				ENDIF
				IF nSz3 > 0
				ELSE
					MESSAGEBOX("This Form:'"+cForm+"' requires Sz3 to be entered!",16,"Cannot use 0 Sz3 for this Form! - Retry Save.")
					RETURN .F.
				ENDIF
			ENDCASE
		
			*****************************	
			IF EMPTY(nHpaPo)
				MESSAGEBOX( 'Enter PO first',48,'No PO number' )
				RETURN .F.
			ENDIF
		
			IF nItemPo < 1
				=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
				RETURN .F.
			ENDIF
		
			cCompany	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtCompany.Value,'Company',30)
			IF EMPTY(ALLTRIM(cCompany))
				=MESSAGEBOX("Purchase Order needs the Company Purchased from entered.",16,"Invalid input")
				RETURN .F.
			ENDIF
			
			PRIVATE dOrderDate,dDue_Min,dDue_Max, dHPA_Due_Min, dHPA_Due_Max
			dOrderDate	= PrepareSQLdate(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOrderDate.Value,'OrderDate')
			dDue_Min	= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Min.VALUE,'Due_Min')
			dDue_Max	= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Max.VALUE,'Due_Max')
			dHPA_Due_Min	= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtHPA_Due_Min.VALUE,'HPA_Due_Min')
			dHPA_Due_Max	= PrepareSQLdate(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtHPA_Due_Max.VALUE,'HPA_Due_Max')
			
		
			IF TYPE("dOrderDate") <> "D" OR EMPTY(dOrderDate)
				MESSAGEBOX( "You need an Order Date!"+CHR(13)+"I set to todays date.")
				ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOrderdate.Value = DATE()
				RETURN .F.
			ENDIF
			
			IF NOT lServicesPO
				IF EMPTY(dHPA_Due_Min) AND EMPTY(dHPA_Due_Max) 
					MESSAGEBOX("You did NOT enter an expected Due Date."+CHR(13)+"Vendor performance cannot be evaluated without these dates.",0+64,"No Expected date.")
					IF NOT EMPTY(dDue_Min) OR NOT EMPTY(dDue_Max) 
						*Set Expected Due min to latest vendor ship date
						dHPA_Due_Min = GetLatestDate( dDue_Max, dDue_Min )
					ENDIF
				ELSE
					*Check Vendor ship dates to the PO receive due date.
					PRIVATE dLatestDueIn
					dLatestDueIn = GetLatestDate( dHPA_due_min, dHPA_due_max )
					IF NOT EMPTY(dDue_Min)
						IF dDue_Min = GetLatestDate( dLatestDueIn, dDue_Min )
							MESSAGEBOX("Your 'Vendor ship by min' is less than the 'PO receive max'!",0+64,"PO receive is before ship min!")
						ENDIF
					ELSE
						IF NOT EMPTY(dDue_Max)
							IF dDue_Max = GetLatestDate( dLatestDueIn, dDue_Max )
								MESSAGEBOX("Your Vendor ship by max is less than the PO receive max!",0+64,"PO receive is before ship max!")
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				
				*Check PO receive due to the SO Ship Due date.
				PRIVATE dShipDue
				dShipDue = get_ShipDue(cSOitem,ThisForm.nConnHandle)
				IF VARTYPE(dShipDue) = "T"
					dShipDue = TTOD(dShipDue)
				ENDIF
				IF VARTYPE(dShipDue) = "D"
					IF NOT EMPTY(dShipDue)
						IF dHPA_due_min = GetLatestDate( dHPA_due_min, dShipDue )	
							dShipDue = dHPA_due_min	+2
							MESSAGEBOX("The ordered material for this SO "+ALLTRIM(cSOitem)+" was entered to not arrive before you need to ship it."+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+48,"SO was set be late!")
						ELSE
							IF dHPA_due_max = GetLatestDate( dHPA_due_min, dShipDue )		
								dShipDue = dHPA_due_max	+2
								MESSAGEBOX("The ordered material for this SO "+ALLTRIM(cSOitem)+" was entered to not arrive before you need to ship it, "+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+64,"SO could be late")
							ENDIF
						ENDIF
					ELSE	
						IF NOT EMPTY(dHPA_due_max)
							dShipDue = dHPA_due_max + 3
							MESSAGEBOX("No ShipDue date found!"+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+64,"No ShipDue date entered.")
						ELSE
							IF NOT EMPTY(dHPA_due_min )
								dShipDue = dHPA_due_min + 7
								MESSAGEBOX("No ShipDue date found!"+CHR(13)+"ShipDue from HPA automatically set to "+DTOC(dShipDue)+".",0+64,"No ShipDue date entered.")
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
			******************************
			IF EMPTY(dOrderdate)
				dOrderdate = DATE()
				MESSAGEBOX( "Orderdate was set to today!",0+48,"Orderdate error")
			ENDIF
			IF dOrderdate + 365 < DATE()
				IF MESSAGEBOX( "Order Date '"+ALLTRIM(DTOC(dOrderdate))+"' is more than 1 year old! "+CHR(13)+"Are you Sure you want to save this PO?",4+32,"Orderdate error")=6
					TrackMess("Editing old PO# "+ALLTRIM(STR(nHPApo))+". Order Date '"+ALLTRIM(DTOC(dOrderdate))+"' is more than 1 year old! "+" frmEdt.PO_Valid()")
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
			IF dOrderdate - 730 > DATE()
				MESSAGEBOX( "Orderdate is more than 2 years out!",0+16,"Orderdate error")
				RETURN .F.
			ENDIF
			IF NOT EMPTY(dDue_Min)
				IF dDue_Min+ 365 < DATE()
					MESSAGEBOX( "Due_Min is more than 1 year past due!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
				IF dDue_Min- 730 > DATE()
					MESSAGEBOX( "Due_Min is more than 2 years out!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
			ENDIF
			IF NOT EMPTY(dDue_Max)
				IF dDue_Max+ 365 < DATE()
					MESSAGEBOX( "Due_Max is more than 1 year past due!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
				IF dDue_Max- 730 > DATE()
					MESSAGEBOX( "Due_Max is more than 2 years out!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
			ENDIF
		
			IF NOT EMPTY(dHPA_Due_Min)
				IF dHPA_Due_Min+ 365 < DATE()
					MESSAGEBOX( "HPA_Due_Min is more than 1 year past due!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
				IF dHPA_Due_Min- 730 > DATE()
					MESSAGEBOX( "HPA_Due_Min is more than 2 years out!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
			ENDIF
			IF NOT EMPTY(dHPA_Due_Max)
				IF dHPA_Due_Max+ 365 < DATE()
					MESSAGEBOX( "HPA_Due_Max is more than 1 year past due!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
				IF dHPA_Due_Max- 730 > DATE()
					MESSAGEBOX( "HPA_Due_Max is more than 2 years out!",0+16,"Orderdate error")
					RETURN .F.
				ENDIF
			ENDIF
		
			******************************
			PRIVATE cAlloy, cStock
			cAlloy			= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtAlloy.VALUE,'Alloy',12,.F.)
			cStock			= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbStock.VALUE,'Stock',13,.F.)
		
			*All for Stock,Mostly Stock,Some Stock,No Stock,DO NOT Stock!
			IF cStock $ "All for Stock,Mostly Stock,Some Stock"
				*Alloy must be HPA Standard
				IF NOT IsHPA_Standard_Alloy(cAlloy,ThisForm.nConnHandle)
					PRIVATE cAlloyStandard 
					*GetAlloyStandard returns Density!!!!!
					cAlloyStandard = GetHPA_Standard_Alloy(cAlloy,ThisForm.nConnHandle)
					IF NOT EMPTY(cAlloyStandard )
						IF MESSAGEBOX("Alloy entered:"+ALLTRIM(cAlloy)+" is not a HPA Alloy Standard."+CHR(13)+"Select YES if you can use this Alloy name:"+ALLTRIM(cAlloyStandard)+".",4+16,"Cannot use this Alloy name for stock!") = 6 &&Yes
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtAlloy.Value = cAlloyStandard 
						ELSE
							MESSAGEBOX("Alloy entered:"+ALLTRIM(cAlloy)+" is not a HPA Alloy Standard."+CHR(13)+CHR(13)+"Cannot save till Alloy name is made a Standard!"+CHR(13)+"Use the 'Display Alloy' field for the supplier to see.",16,"Cannot use this Alloy name for stock!")
							RETURN .F.
						ENDIF
					ELSE
						MESSAGEBOX("Alloy entered:"+ALLTRIM(cAlloy)+" is not a HPA Alloy Standard."+CHR(13)+CHR(13)+"Cannot save till Alloy name is made a Standard!"+CHR(13)+"Use the 'Display Alloy' field for the supplier to see.",16,"Cannot use this Alloy name for stock!")
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
			
			
			PRIVATE cCC
			cCC	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbCC.VALUE,'CC',1,.F.)
			IF EMPTY(cCC)
				cCC = '1'
				ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbCC.VALUE = '1'
			ENDIF
			
			**************
			*Check Vendor Contact to Vendor
			PRIVATE nContactID, nVendCode
			*nVendCode	= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblVendCode.Caption,'VendCode',-3,0)
			nVendCode	= ThisForm.VendCode
			nContactID	= ThisForm.nContactID
			
			IF NOT EMPTY(nVendCode) AND NOT EMPTY(nContactID)
				IF nVendCode <> VendCode_ContactID(nContactID, ThisForm.nConnHandle)
					MESSAGEBOX("Vendor Contact does not match Vendor",0,"Fix Vendor Contact!")
					RETURN .F.
				ENDIF
			ENDIF
			**************
			PRIVATE cPOSalesName, cVendorContact
			cPOSalesName = PrepareSQLtxt(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPOSalesName.VALUE,"POSalesP",20,.F.,.T.)
			cVendorContact = PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cContact.Value,"Contact",30,.F.,.T.)
			
			IF LEN( ALLTRIM(cVendorContact) ) = 0
				MESSAGEBOX("Please Choose a Vendor Contact",0,"Cannot save without Vendor Contact.")
				RETURN .F.
			ENDIF
			IF NOT EMPTY(cPOSalesName)
				IF cPOSalesName != LEFT(cVendorContact,20)
					IF LEN(cPOSalesName) < 2
						MESSAGEBOX("PO Description page has 'Buy from Name' entered as '"+cPOSalesName+"'"+CHR(13)+;
							"Vendor Contact page has a name of '"+cVendorContact+"'"+CHR(13)+;
							"'"+ALLTRIM(cPOSalesName)+"' will be removed."+CHR(13)+;
							"'"+ALLTRIM(cVendorContact)+"' will be used.",0,"Change Vendor Name")
						THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPOSalesName.VALUE = LEFT(cVendorContact,20)
					ELSE
					
						IF MESSAGEBOX("PO Description page has 'Buy from Name' entered as '"+cPOSalesName+"'"+CHR(13)+;
							"Vendor Contact page has a name of '"+cVendorContact+"'"+CHR(13)+;
							"Do you want to correct this? (Y/N)",4+32,"Mismatch name!") = 6
							
							THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPOSalesName.VALUE = LEFT(cVendorContact,20)
							RETURN .F.
						ENDIF
					ENDIF
				ENDIF
			ELSE
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPOSalesName.VALUE = LEFT(cVendorContact,20)
			ENDIF
			
			**************
			PRIVATE nStandardSize, nSize, nCurrStandSize
			nSize			= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtThck.VALUE,'Thck',10,4)
			nCurrStandSize	= PrepareSQLnum(ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtStandSize.VALUE,'StandSize',10,4)
			nStandardSize = getStandardSize(nSize, ThisForm.nConnHandle)
			PRIVATE nPrevSize, nPrevStandardSize
					
			IF cStock $ "All for Stock,Mostly Stock,Some Stock"
				IF nStandardSize > 0
					IF nCurrStandSize = 0
						FOR nPrevSize = nSize TO 0 STEP -.001
							nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
							IF nPrevStandardSize <= nStandardSize 
								*This.Value = nPrevStandardSize
								ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStandSize.Value = nPrevStandardSize
								ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStandSize.Refresh
								
								EXIT
							ENDIF
						NEXT nPrevSize 
								
					ELSE
						IF nStandardSize != nSize
							MESSAGEBOX("Not a 'Standard Size'! "+ALLTRIM(STR(nSize,9,4))+CHR(13)+"You may need to adjust your Size Entered!"+CHR(13)+"Please use a dimension that is found in the Pricing table!",0+16,"Size Entered is not a Standard")
		
							FOR nPrevSize = nSize TO 0 STEP -.001
								nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
								IF nPrevStandardSize <= nStandardSize 
									*This.Value = nPrevStandardSize
									ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtStandSize.Value = nPrevStandardSize
									ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStandSize.Refresh
									EXIT
								ENDIF
							NEXT nPrevSize 
		
						ENDIF
					ENDIF
				ELSE
					MESSAGEBOX("Could not get a Standard Size!"+CHR(13)+"You may need to adjust your Size Entered!",0,"Error getting a Standard")
				ENDIF
			ELSE
				*Replace Blank Stand Size, but never warn!
				IF nStandardSize > 0
					IF nCurrStandSize = 0
						FOR nPrevSize = nSize TO 0 STEP -.001
							nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
							IF nPrevStandardSize <= nStandardSize 
								*This.Value = nPrevStandardSize
								ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStandSize.Value = nPrevStandardSize
								ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStandSize.Refresh
								
								EXIT
							ENDIF
						NEXT nPrevSize 
					ENDIF
				ENDIF				
			ENDIF
			
			
			*Check StockLst Price
			PRIVATE nStockLst_QTY, nStockLst_P
			nStockLst_QTY	= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStockLst_QTY.VALUE,'StockLst_QTY',-5)
			nStockLst_P		= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStockLst_P.VALUE,'StockLst_P',-5)
			
			IF nStockLst_QTY <=  0
				MESSAGEBOX("Purchase Orders are required to have a HPA Stock List standard UNIT value",48,"No Stock List Units.")
				RETURN .F.
			ENDIF
			IF nStockLst_P <= 0
				MESSAGEBOX("Purchase Orders are required to have a HPA Stock List PRICE standard value",48,"No Stock List Price.")
				RETURN .F.
			ENDIF
		
		CASE lcPara = "EDIT"
		
		*	IF SalesQuote.hpapo2 = THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtHpaPo.VALUE
		*		THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.VALUE = 1
		*		THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.VALUE = 1
		*		*THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.ENABLED = .F.
		*		MESSAGEBOX('This PO was automatically marked as a Service'+CHR(13)+""Please uncheck 'Service Only' if program was wrong.",0+48,'Service PO')
		*	ENDIF
			IF THISFORM.pf.pg_po.pgFPO.pgPOAddress.opgPOShipTo.VALUE > 1
				THISFORM.pf.pg_po.pgFPO.pgPOAddress.cmdPOSearchShipTo.ENABLED = .T.
				IF THISFORM.pf.pg_po.pgFPO.pgPOAddress.txtPOShipAddr.VALUE > 1
					THISFORM.pf.pg_po.pgFPO.pgPOAddress.cmdEditAddr.ENABLED =.T.
					THISFORM.pf.pg_po.pgFPO.pgPOAddress.cmdClearShip.ENABLED =.T.
				ENDIF
			ENDIF
			
		CASE lcPara = "NEWNEXT"
		
			IF SalesQuote.StartStock 
				PRIVATE cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
				cssAlloy	= ''
				cssForm		= ''
				cssCC		= ''
				nssPieces	= 0
				nssThck		= 0
				nssSz2		= 0
				nssSz3		= 0
				nssWeight	= 0
				DO GetStartingStock WITH Quotes.ID,ThisForm.nConnHandle,cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPieces.VALUE=nssPieces
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtAlloy.VALUE	=cssAlloy
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbForm.VALUE	=cssFORM
				ThisForm.pf.pg_po.pfFPO.pgPODesc.lblPerUnit.Caption	= FormUnitCaption(cssForm,.F.,.F.,ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbCC.VALUE	=cssCC
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtThck.VALUE	=nssThck
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtStandSize.VALUE	= getStandardSize(nssThck, ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz2.VALUE	=nssSz2
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz3.VALUE	=nssSz3
				ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOrder_Qty.Value = nssWeight
				
				IF cssFORM = "40" AND nssThck < .13
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 1
				ELSE
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 0
				ENDIF
			ELSE	
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPieces.VALUE=SalesQuote.Pieces
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtAlloy.VALUE	=SalesQuote.Alloy
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbForm.VALUE	=SalesQuote.FORM
				ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblPerUnit.Caption	= FormUnitCaption(SalesQuote.Form,.F.,.F.,ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbCC.VALUE	=SalesQuote.CC
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtThck.VALUE	=SalesQuote.Thck
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtStandSize.VALUE=getStandardSize(SalesQuote.Thck, ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz2.VALUE	=SalesQuote.Sz2
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz3.VALUE	=SalesQuote.Sz3
				
				
				IF SalesQuote.FORM = "40" AND SalesQuote.Thck < .13
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 1
				ELSE
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 0
				ENDIF
			ENDIF
			
			
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_lb.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_pc.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_ft.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtLotP.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOtherP.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOtherFld.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOrder_Qty.Value
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtJobNumber.VALUE=STR(SalesQuote.SalesNum_a)
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtOrderDate.VALUE=DATE()
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Min.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Max.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.pgFPO.pgPOAddress.txtReceipt.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.pgFPO.pgPOAddress.txtMisc_Purch.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtCond_Spec.Value
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbStock.VALUE = "No Stock"
			m.Stock="No Stock"
			
			IF PrepareSQLchk(SalesQuote.Metric,'Metric',.F.)
				ThisForm.pf.pg_po.pgfPO.pgPODesc.chkMetric.Value = 1
				ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Value = PrepareSQLtxt(SalesQuote.Sz1orig,'Sz1Orig',20)
				ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Value = PrepareSQLtxt(SalesQuote.Sz2orig,'Sz2Orig',20)
				ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Value = PrepareSQLtxt(SalesQuote.Sz3orig,'Sz3Orig',20)
			ENDIF
			
		
			THISFORM.pf.pg_po.chkCancelPO.VALUE = 0
			THISFORM.pf.pg_po.chkCancelPO.ENABLED =.T.
		
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.VALUE = 0
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.ENABLED = .T.
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.VALUE = 0
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.ENABLED = .T.
			
		CASE lcPara = "NEW"
			PRIVATE nCntPOitem 
			nCntPOitem = 0
			
			IF USED('cntPO')
				USE IN cntPO
			ENDIF
		
			IF cPOItem != Proper_PO_Item( "0-00")
				nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
			ENDIF
			
			IF nCntPOitem = 0
				*Try Just PO#	
				PRIVATE nCntPO 
				nCntPO = 0
				
				IF USED('cntPO')
					USE IN cntPO
				ENDIF
		
				SELECT 0
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPO')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPO' )
				ENDIF
		
				IF USED('cntPO')
					nCntPO = cntPO.CNTD
					USE IN cntPO
				ENDIF
		
				IF nCntPO > 0
				
					IF USED('tmpPOs')
						USE IN tmpPOs
					ENDIF
		
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT DISTINCT Company FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
					cSQL = cSQL + " AND HPAPO > 0"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOs')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOs' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOs' )
					ENDIF
		
					PRIVATE cSTR
					cSTR = ""
					IF USED('tmpPOs')
						SELECT tmpPOs
						nRecordCount = RECCOUNT('tmpPOs')
						SCAN
							nCurrentRecord = RECNO('tmpPOs')
							IF nRecordCount = 1
								cSTR = " "
							ELSE
								cSTR = CHR(13)+CHR(13)+"Answer no to see next one: "+ALLTRIM(STR(nCurrentRecord))+" of "+ALLTRIM(STR(nRecordCount))+"."
							ENDIF
							
							IF MESSAGEBOX("Is this PO item also to " + ALLTRIM(tmpPOs.Company)+" ?"+CHR(13); 
								+CHR(13)+"Do you want to clone?"+cSTR,4+32,"Clone This?")=6
								**+"(PO# "+ALLTRIM(STR(tmpPOs.hpapo))+" ?)"+CHR(13)
								
								lClone = .T.
								*                       1      2        3      4        5         6         7           8
								cSQL = "SELECT TOP 1 Company,hpapo,POSalesP,ShipVia,ShipWhere,POshipAddr,VendCode,ContactID FROM dbo.PurchaseOrder "
								cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
								cSQL = cSQL + " AND HPAPO > 0"
								cSQL = cSQL + " AND Company = '"+tmpPOs.Company+"'"
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOs2')
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOs2' )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOs2' )
								ENDIF
								
								IF USED('tmpPOs2')
								*              1     2       3       4        5         6         7        8
									SELECT Company,hpapo,POSalesP,ShipVia,ShipWhere,POshipAddr,VendCode,ContactID  FROM tmpPOs2 ;
										 INTO ARRAY acPOCompany 
										 **WHERE RECNO() = nCurrentRecord 
									USE IN tmpPOs2
								ELSE
									DECLARE acPOCompany(1,1)
									acPOCompany(1,1) = ''
								ENDIF
								
								EXIT
							ELSE
								*No Clone
								THISFORM.pf.pg_po.pgFPO.pgPOdesc.lblPeachID.Caption = ''
								THISFORM.pf.pg_po.pgFPO.pgPOdesc.lblVendCode.Caption = ''
								ThisForm.Vendcode = 0
								ThisForm.nContactID = 0
								
							ENDIF
						ENDSCAN
						USE IN tmpPOs
					ENDIF
				ENDIF
			ENDIF
		
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtItemPo.VALUE=1
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSalesP.VALUE=SalesQuote.SalesP
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtCompany.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgPODesc.lblVendCode.Caption = ''
			ThisForm.pf.pg_po.pgfPO.pgPODesc.lblPeachID.Caption	= ''
			
			IF SalesQuote.StartStock 
				PRIVATE cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
				cssAlloy	= ''
				cssForm		= ''
				cssCC		= ''
				nssPieces	= 0
				nssThck		= 0
				nssSz2		= 0
				nssSz3		= 0
				nssWeight	= 0
				DO GetStartingStock WITH Quotes.ID,ThisForm.nConnHandle,cssAlloy,cssForm,cssCC,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPieces.VALUE=nssPieces
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtAlloy.VALUE	=cssAlloy
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbForm.VALUE	=cssFORM
				ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblPerUnit.Caption	= FormUnitCaption(cssForm,.F.,.F.,ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbCC.VALUE	=cssCC
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtThck.VALUE	=nssThck
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtStandSize.VALUE	= getStandardSize(nssThck, ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz2.VALUE	=nssSz2
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz3.VALUE	=nssSz3
				ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOrder_Qty.Value = nssWeight
				
				IF cssFORM = "40" AND nssThck < .13
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 1
				ELSE
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 0
				ENDIF
			ELSE	
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPieces.VALUE=SalesQuote.Pieces
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtAlloy.VALUE	=SalesQuote.Alloy
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbForm.VALUE	=SalesQuote.FORM
				ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblPerUnit.Caption	= FormUnitCaption(SalesQuote.Form,.F.,.F.,ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbCC.VALUE	=SalesQuote.CC
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtThck.VALUE	=SalesQuote.Thck
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtStandSize.VALUE=getStandardSize(SalesQuote.Thck, ThisForm.nConnHandle)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz2.VALUE	=SalesQuote.Sz2
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtSz3.VALUE	=SalesQuote.Sz3
				
				
				IF SalesQuote.FORM = "40" AND SalesQuote.Thck < .13
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 1
				ELSE
					THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkSPS1.VALUE = 0
				ENDIF
			ENDIF
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_lb.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_pc.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtP_ft.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtLotP.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOtherP.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOtherFld.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtOrder_Qty.Value
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtJobNumber.VALUE=STR(SalesQuote.SalesNum_a)
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtOrderDate.VALUE=DATE()
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Min.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtDue_Max.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.pgFPO.pgPOAddress.txtReceipt.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.pgFPO.pgPOAddress.txtMisc_Purch.Value
			*ThisForm.pf.pg_po.pgFPO.pgPOdesc.txtCond_Spec.Value
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.cmbStock.VALUE = "No Stock"
			m.Stock="No Stock"
			
			IF PrepareSQLchk(SalesQuote.Metric,'Metric',.F.)
				ThisForm.pf.pg_po.pgfPO.pgPODesc.chkMetric.Value = 1
				ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Value = PrepareSQLtxt(SalesQuote.Sz1orig,'Sz1Orig',20)
				ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Value = PrepareSQLtxt(SalesQuote.Sz2orig,'Sz2Orig',20)
				ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Value = PrepareSQLtxt(SalesQuote.Sz3orig,'Sz3Orig',20)
			ENDIF
			
			IF lClone
				IF VARTYPE(acPOCompany(1,1)) = "C"
					IF EMPTY(acPOCompany(1,1))
						lClone = .F.
						MESSAGEBOX('Cannot Clone',0+16,'Error while Cloning')
					ENDIF
				ELSE
					lClone = .F.
					MESSAGEBOX('Cannot Clone',0+16,'Error while Cloning')
				ENDIF
			ENDIF
			
			IF lClone
				PRIVATE nNextItemPO
				nNextItemPO = GetNextPurchaseOrderItem( acPOCompany(1,2), ThisForm.nConnHandle )
		
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtHpaPo.VALUE		= acPOCompany(1,2)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtItemPo.VALUE	= nNextItemPO
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtCompany.VALUE	= acPOCompany(1,1)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtPOSalesName.VALUE	= acPOCompany(1,3)
				THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtShipVia.VALUE	= acPOCompany(1,4)
		
				THISFORM.pf.pg_po.pgFPO.pgPOAddress.txtHpaPo.VALUE = THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtHpaPo.VALUE
				THISFORM.pf.pg_po.pgFPO.pgPOAddress.txtItemPo.VALUE = THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtItemPo.VALUE
				*5-ShipWhere,6-POshipAddr,7-POpayAddr
				THISFORM.pf.pg_po.pgFPO.pgPOAddress.opgPOShipTo.VALUE = acPOCompany(1,5)
				
				ThisForm.Shipwherechange( acPOCompany(1,5),acPOCompany(1,1),'' ) &&(nShipWhere,cCompany,cCity)
				
				THISFORM.POShipAddr = PrepareSQLnum( acPOCompany(1,6),'POShipAddr',-3)
				THISFORM.pf.pg_po.pgFPO.pgPOAddress.txtPOShipAddr.VALUE = THISFORM.POShipAddr
				ThisForm.ShowPOShipAddr( THISFORM.POShipAddr )
		
				ThisForm.VendCode = PrepareSQLnum( acPOCompany(1,7), 'VendCode', -3)
				ThisForm.ShowVendCode( ThisForm.VendCode )
		
				ThisForm.nContactID = PrepareSQLnum( acPOCompany(1,8),'ContactID',-3)
				ThisForm.ShowVendorContact( ThisForm.nContactID )
			ELSE
				*New - init to PO Ship to HPA
				THISFORM.pf.pg_po.pgFPO.pgPOAddress.opgPOShipTo.VALUE = 1
				THISFORM.pf.pg_po.pgFPO.pgPOAddress.txtPOShipAddr.VALUE = 1
				*THISFORM.POShipAddr = 1
				m.POPayAddr = 1
				ThisForm.ShowPOShipAddr(1)
			ENDIF
		
			THISFORM.pf.pg_po.chkCancelPO.VALUE = 0
			THISFORM.pf.pg_po.chkCancelPO.ENABLED =.T.
		
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.VALUE = 0
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.ENABLED = .T.
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.VALUE = 0
			THISFORM.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.ENABLED = .T.
		
		CASE lcPara = "DELETE"
			*nItemPo = THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtItemPo.VALUE
			*cPOitem = (STR(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtHpaPo.VALUE,9))+"-"+IIF(nItemPo<10,"0"+STR(nItemPo,1,0),STR(nItemPo,2,0))
		
			IF MESSAGEBOX("Are you sure you want to Delete This PO-Item? "+ALLTRIM(cPOitem),4,"Cancel PO")= 6
		
				PurchaseOrder_POitem_Delete( cPOitem, ThisForm.nConnhandle, cSOitem ) 
				
				cBuyFrom	= ALLTRIM(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtCompany.VALUE)
				*m.SOitem 		= SalesQuote.SoItem_A
				IF SOUNDEX(SalesQuote.buyfrom) = SOUNDEX(cBuyFrom)
				
					SELECT SalesQuote
					nCurrRec = RECNO('SalesQuote')
					REPLACE SalesQuote.buyfrom	WITH "" IN SalesQuote FOR HPAPO = nHPAPO
					REPLACE SalesQuote.hpapo	WITH 0 IN SalesQuote FOR HPAPO = nHPAPO
					REPLACE SalesQuote.buyfrom2	WITH "" IN SalesQuote FOR HPAPO = nHPAPO
					REPLACE SalesQuote.hpapo2	WITH 0 IN SalesQuote For HPAPO = nHPAPO
					
					SELECT SalesQuote 
					IF nCurrRec > 0
						GOTO (nCurrRec)
					ENDIF
					
					cSQLUpdate = "UPDATE DBO.AllQuotes SET buyfrom=''"
					cSQLUpdate = cSQLUpdate + ",hpapo= 0"
					cSQLUpdate = cSQLUpdate + " WHERE SOitem=dbo.ProperSO('"+cSOitem+"')"
					cSQLUpdate = cSQLUpdate + " AND HPAPO = "+STR(nHPAPO)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL'  TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate)
					ENDDO
						
					cSQLUpdate = "UPDATE DBO.AllQuotes SET buyfrom2=''"
					cSQLUpdate = cSQLUpdate + ",hpapo2= 0"
					cSQLUpdate = cSQLUpdate + " WHERE SOitem=dbo.ProperSO('"+cSOitem+"')"
					cSQLUpdate = cSQLUpdate + " AND HPAPO2 = "+STR(nHPAPO)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL'  TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate)
					ENDDO	
				ENDIF
				
				ThisForm.PONewAdd = .F.
				ThisForm.POEditing = .F.
				THISFORM.POScreen("DISABLE")
				ThisForm.Show_Po()
				
			ENDIF
			
		CASE lcPara = "CANCEL"
			*nItemPo = THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtItemPo.VALUE
			*cPOitem = (STR(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtHpaPo.VALUE,9))+"-"+IIF(nItemPo<10,"0"+STR(nItemPo,1,0),STR(nItemPo,2,0))
			
			PRIVATE cBuyFrom
			cBuyFrom	= ALLTRIM(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtCompany.VALUE)
			IF SOUNDEX(SalesQuote.buyfrom) = SOUNDEX(cBuyFrom)
				SELECT SalesQuote
				REPLACE SalesQuote.buyfrom	WITH "" IN SalesQuote
				REPLACE SalesQuote.hpapo	WITH 0 IN SalesQuote
		
				cSQLUpdate = "UPDATE DBO.AllQuotes SET buyfrom=''"
				cSQLUpdate = cSQLUpdate + ",hpapo= 0"
				cSQLUpdate = cSQLUpdate + " WHERE SOitem=dbo.ProperSO('"+cSOitem+"')"
				cSQLUpdate = cSQLUpdate + " AND HPAPO = "+STR(nHPAPO)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL'  TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate)
				ENDDO
					
			ENDIF
			IF SOUNDEX(SalesQuote.buyfrom2) = SOUNDEX(cBuyFrom)
				SELECT SalesQuote
				REPLACE SalesQuote.buyfrom2 WITH "" IN SalesQuote
				REPLACE SalesQuote.hpapo2	 WITH 0 IN SalesQuote
		
				cSQLUpdate = "UPDATE dbo.AllQuotes SET buyfrom2=''"
				cSQLUpdate = cSQLUpdate + ",hpapo2= 0"
				cSQLUpdate = cSQLUpdate + " WHERE SOitem=dbo.ProperSO('"+cSOitem+"')"
				cSQLUpdate = cSQLUpdate + " AND HPAPO = "+STR(nHPAPO)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL'  TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate)
				ENDDO
					
			ENDIF
		
		*	IF cSOitem = Proper_SO_Item( "0-00")
				*Remove empty record 
				*DELETE from PurchaseOrder
		
			*Cancel from StockLst
		*	************************* StockLst SQL
			IF USED("StkMastID")
				USE IN StkMastID
			ENDIF
			cSQL_Master_PO="SELECT ID FROM dbo.StockLst_Master WHERE dbo.ProperPO(PO_Item) = dbo.ProperPO('"+cPOitem+"')"
			*Find all records used on this PO-item
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkMastID')
			ENDDO
					
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastID')
				lSQLgood = .F.
			ELSE
				SELECT StkMastID
				GO TOP
				DO WHILE NOT EOF('StkMastID')
					**DELETE Process, Detail, Master
		
					*GET ID_Detail for Process Delete
					IF USED("StkDetailID")
						USE IN StkDetailID
					ENDIF
					cSQL_Master_PO="SELECT ID,ID_Detail FROM dbo.StockLst_Detail WHERE ID = "+STR(StkMastID.ID)
		
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_PO, 'StkDetailID')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL'  TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master_PO, 'StkDetailID')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkDetailID')
						lSQLgood = .F.
					ELSE
						SELECT StkDetailID
						GO TOP
						DO WHILE NOT EOF('StkDetailID')
						
							*********************		
							IF USED("StkIDDetailP")
								USE IN StkIDDetailP
							ENDIF
							*Get ID_Detail_Process
							cSQLid = "SELECT ID_Detail_Process FROM dbo.StockLst_Process WHERE ID_Detail = "
							cSQLid = cSQLid + STR(StkDetailID.ID_Detail)+" AND dbo.ProperPO(PO_item) = dbo.ProperPO('"
							cSQLid = cSQLid + cPOitem+"')"
		
							SELECT 0
							nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQLid, 'StkIDDetailP')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL'  TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLid, 'StkIDDetailP')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLid,ThisForm.nConnHandle, nSQLEXEC, 'StkIDDetailP')
								lSQLgood = .F.
							ELSE
								IF TYPE("StkIDDetailP.ID_Detail_Process") = "N"
									nID_Detail_Process = StkIDDetailP.ID_Detail_Process
								ELSE
									nID_Detail_Process = 0
									lSQLgood = .F.
								ENDIF
							ENDIF
							
							IF USED("StkIDDetailP")
								USE IN StkIDDetailP
							ENDIF
							*********************		
		
							cSQLid = "INSERT INTO dbo.StockLst_Process_detail ("
							cSQLid = cSQLid+ "ID, ID_Detail"
							cSQLid = cSQLid+ ", ID_Detail_Process"
							cSQLid = cSQLid+ ", What ) VALUES ("
							cSQLid = cSQLid+ ""+STR(StkDetailID.ID)+","
							cSQLid = cSQLid+ ""+STR(StkDetailID.ID_Detail)+","
							cSQLid = cSQLid+ ""+STR(nID_Detail_Process)+","
							cSQLid = cSQLid+ "'"+"CANCEL"+"'"+")"
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL'  TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLid )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLid, ThisForm.nConnHandle, nSQLEXEC,'')
								lSQLgood = .F.
							ENDIF
		
							cSQL = "DELETE FROM dbo.StockLst_Process WHERE ID_Detail = "+STR(StkDetailID.ID_Detail)
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL'  TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
							ENDIF
		
							cSQL = "DELETE FROM dbo.StockLst_Detail WHERE ID_Detail = "+STR(StkDetailID.ID_Detail)
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL'  TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
								lSQLgood = .F.
							ENDIF
							
							cSQLid = "DELETE dbo.StockLst_Process_detail WHERE "
							cSQLid = cSQLid+ "[ID]="+STR(StkDetailID.ID)+""
							cSQLid = cSQLid+ " AND [ID_Detail]="+STR(StkDetailID.ID_Detail)+""
							cSQLid = cSQLid+ " AND [ID_Detail_Process]="+STR(nID_Detail_Process)+""
							cSQLid = cSQLid+ " AND [What]='"+"CANCEL"+"'"	
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL'  TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLid )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLid, ThisForm.nConnHandle, nSQLEXEC,'')
		*						lSQLgood = .F.
							ENDIF
		
							SELECT StkDetailID
							SKIP
						ENDDO
					ENDIF
					IF USED("StkDetailID")
						USE IN StkDetailID
					ENDIF
		
					cSQL = "DELETE FROM dbo.StockLst_Master WHERE ID = "+STR(StkMastID.ID)
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL'  TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
						lSQLgood = .F.
					ENDIF
		
					SELECT StkMastID
					SKIP
				ENDDO
			ENDIF
		
			IF USED("StkMastID")
				USE IN StkMastID
			ENDIF
		
		************************** StockLst SQL
			IF lSQLgood 
				PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle, .F. ) 
			ENDIF
			
			ThisForm.PONewAdd = .F.
			ThisForm.POEditing = .F.
			THISFORM.POScreen("DISABLE")
			ThisForm.Show_Po()
			
		CASE lcPara = "UNCANCEL"
		
			PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle, .T. ) 
			
			cBuyFrom	= ALLTRIM(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtCompany.VALUE)
		
			PRIVATE cSQLUpdate
			cSQLUpdate = "EXEC dbo.p_AllQuotes_AddPO "
			cSQLUpdate = cSQLUpdate + " @BuyFrom='"+STRTRAN(cBuyFrom,"'","''")+"'"
			cSQLUpdate = cSQLUpdate + ",@PO="+STR(nHpaPo)
			cSQLUpdate = cSQLUpdate + ",@SOitem='"+cSOitem+"'"
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLUpdate,ThisForm.nConnHandle, nSQLEXEC,'')
			ENDIF
			
			THISFORM.Show_Po()
		
		OTHERWISE
			MESSAGEBOX("No Parameter for PO Screen function",0,"PO_Valid")
		ENDCASE
		
	ENDPROC

	PROCEDURE refreshforms
		PARAMETER pForm
		*ThisForm.RefreshForms(Form)
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		IF GetFormCaptions(pForm,ThisForm.nConnHandle)
			IF USED('tmpFormCaptions')
				*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
					ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = RTRIM(tmpFormCaptions.txt2)
					ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = RTRIM(tmpFormCaptions.txt3)
					ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = tmpFormCaptions.use3rdDim
		*			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = tmpFormCaptions.use3rdDim
					ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = RTRIM(tmpFormCaptions.txt4)
				USE IN tmpFormCaptions
			ELSE
				TrackMess( "tmpFormCaptions is not used!"+" frmEdt.RefreshForms()")
			ENDIF
		ELSE
			TrackMess("GetFormCaptions returned False!"+" frmEdt.RefreshForms()")
		ENDIF
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
		
		IF ThisForm.POEditing
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
		ELSE
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
		ENDIF
		
		
		
		RETURN
		
		
		*********************************************************************************************************************************************************
		
		*********************************************************************************
		** CHANGES HERE MUST BE REPLICATED TO PurchaseOrder, EnterOrder and PackingSlip
		** Form Changes must be made to Proc_Quotes.prg **
		*********************************************************************************
		
		DO CASE
		*10,Bar,11,Flat Bar,12,Hex Bar,13,Square Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,
		*40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,
		*75,Fastener,80,Disk,90,Machined
		CASE pForm = "10" &&Bar
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Dia:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = ""
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = "Bar"
		
		CASE pForm = "11" &&Flat Bar
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Bar:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = "  X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = "Flat Bar"
		
		CASE pForm = "12" &&Hex Bar
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Hex:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = ""
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = "Hex Bar"
			
		CASE pForm = "20" &&Wire Spool
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Dia:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = "Pounds Spool"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = "Wire"
			
		CASE pForm = "21" &&Wire Cuts
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Dia:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = ["Cuts]
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = "Cut Wire"
			
		CASE pForm = "30" &&Coated Electrodes
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Dia:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = ["CE]
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = "Pound Can"
		
		CASE pForm = "40" &&Plate Sheet
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Thck:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = "  X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ4.Caption = "Plate/Sheet"
		
		CASE pForm = "51" &&Strip
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLTHCK.Caption = "Thck:"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ2.Caption = "X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ2.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.LBLSZ3.Caption = "  X"
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Visible = .T.
