	PROCEDURE calclotp
		*ThisForm.CalcLotP()
		
		Private zAmount, nPieces, lOnlyOther
		zAmount=0
		nPieces = PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
		IF nPieces = 0
			nPieces = 1
		ENDIF
		lOnlyOther = .F.
		
		DO CASE
		CASE SalesQuote.Weight > 0 AND SalesQuote.P_Lb > 0
			Zamount = SalesQuote.P_Lb * SalesQuote.Weight
		CASE SalesQuote.P_Ft > 0 
			IF Uses3rdDim( SalesQuote.Form, ThisForm.nConnHandle )
				Zamount = nPieces * SalesQuote.P_Ft * (SalesQuote.Sz3 / 12)
			ELSE
				Zamount = nPieces * SalesQuote.P_Ft * (SalesQuote.Sz2 / 12)
			ENDIF
		CASE SalesQuote.LotP > 0
		    Zamount = SalesQuote.LotP
		CASE SalesQuote.P_Pc > 0
		    Zamount = SalesQuote.P_Pc * nPieces
		CASE NOT EMPTY(SalesQuote.OtherFld) AND SalesQuote.OtherP != 0
			lOnlyOther = .T.
			IF "PER INCH" $ UPPER(SalesQuote.OtherFld)
				IF Uses3rdDim( SalesQuote.Form, ThisForm.nConnHandle )
					Zamount = nPieces * SalesQuote.OtherP * SalesQuote.Sz3 
				ELSE
					Zamount = nPieces * SalesQuote.OtherP * SalesQuote.Sz2 
				ENDIF
			ELSE
				MESSAGEBOX("Please fill in the Estimated Sales for this item!",48,"Could not calculate Sale!")
			ENDIF
		ENDCASE
		
		IF NOT lOnlyOther
			**Add others 
			IF NOT EMPTY(SalesQuote.OtherFld) AND SalesQuote.OtherP != 0
				Zamount = Zamount + SalesQuote.OtherP
			ENDIF
		ENDIF
		
		IF SalesQuote.Cuts > 0
			Zamount = Zamount + SalesQuote.Cuts
		ENDIF
		
		RETURN zAmount
		
	ENDPROC

	PROCEDURE calcpolotcost
		PARAMETER pSOitem, nQTY
		*ThisForm.CalcPOLotCost( m.SOitem, QTY )
		
		IF TYPE("pSOitem") != "C"
			RETURN 0
		ENDIF
		IF nQTY = 0
			nQTY = 1
		ENDIF
		
		IF USED('cntPO')
			USE IN cntPO
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT StockLst_QTY,StockLst_P,([StockLst_QTY] * [StockLst_P]) AS [LotCost] FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE [SOitem] = dbo.ProperSO('"+pSOitem+"') "
		cSQL = cSQL + " AND Cancelled =0"
		cSQL = cSQL + " AND Services =0"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPO' )
		ENDIF
		
		PRIVATE nAddCost,nStockCost,nStockLst_QTY 
		
		IF USED('cntPO')
			*SELECT LotCost FROM cntPO INTO ARRAY aPOCalc 
			nAddCost = 0
			nStockLst_QTY = 0
			SCAN
				nStockLst_QTY = nStockLst_QTY + StockLst_QTY
				
				nStockCost = StockLst_P * StockLst_QTY
				nAddCost = nAddCost + nStockCost 
			ENDSCAN
			
			GO TOP
			IF nStockLst_QTY*1.15 < nQTY
				IF nQTY*1.15 < nStockLst_QTY
					*More than 15% apart
					nTmpCost = StockLst_P * QTY
					IF MESSAGEBOX("Adding the Quantity for PO's for this SaleOrder item:"+ALLTRIM(pSOitem)+CHR(13)+"adds up to QTY of "+ALLTRIM(STR(nStockLst_QTY))+"."+CHR(13)+"The count the Order to use "+ALLTRIM(STR(nQTY))+CHR(13)+CHR(13)+"Do you want to use the cost as QTY of "+ALLTRIM(STR(nQTY))+" $"+ALLTRIM(STR(nTmpCost))+" for this item? (Y)"+CHR(13)+"The cost here is an estimate,"+CHR(13)+"the real cost will be entered after the incoming PO is received.",4,"Buying more htan sold?")=6
						nAddCost = nTmpCost 
					ENDIF
				ENDIF
			ENDIF
			USE IN cntPO
		ENDIF
		RETURN nAddCost 
		
	ENDPROC

	PROCEDURE calcstocklstcost
		*ThisForm.CalcStockLstCost()
		
		PRIVATE cSOitem, nItemSO, nSalesNum
		cSOitem	= Proper_SO_Item(SalesQuote.SoItem_A)
		
		PRIVATE nSQLEXEC, cSQL 
		cSQL = "SELECT M.Form, D.CostValue, P.Pweight, P.PPc FROM dbo.StockLst_Master M, dbo.StockLst_Detail D, dbo.StockLst_Process P "
		cSQL = cSQL + " WHERE M.ID = D.ID AND D.ID_Detail = P.ID_Detail AND P.SOitem = dbo.ProperSO('" + cSOitem+ "')"
		
		IF USED('tmpCalcStock')
			USE IN tmpCalcStock
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCalcStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCalcStock')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCalcStock')
			RETURN
		ENDIF
		
		PRIVATE nSOitemPOCost
		nSOitemPOCost = 0
		
		PRIVATE nCostBucket, nPU
		nCostBucket  = 0
		
		PRIVATE nPieces,nSz2,nSz3,nWeight
		nPieces	= IIF(SalesQuote.Pieces>0,SalesQuote.Pieces,1)
		nSz2	= SalesQuote.Sz2
		nSz3	= SalesQuote.Sz3
		nWeight = SalesQuote.Weight
		
		SELECT tmpCalcStock
		SCAN
			
			*SELECT SalesQuote
			nPU	= GetPUfromForm( SalesQuote.Form, ThisForm.nConnHandle )
			
			DO CASE
			CASE nPU = 1
				*SELECT SalesQuote
				nCostBucket = nCostBucket + (nWeight * tmpCalcStock.CostValue)
				nSOitemPOCost = ThisForm.CalcPOLotCost( cSOitem, tmpCalcStock.PWeight )
			CASE nPU = 2
				*Price Per Foot
				IF Uses3rdDim( SalesQuote.Form, ThisForm.nConnHandle )
					nCostBucket = nCostBucket + (nPieces * nSz3 * tmpCalcStock.CostValue)
					nSOitemPOCost = ThisForm.CalcPOLotCost( cSOitem, nPieces * nSz3 )
				ELSE
					nCostBucket = nCostBucket + (nPieces * nSz2 * tmpCalcStock.CostValue)
					nSOitemPOCost = ThisForm.CalcPOLotCost( cSOitem, nPieces * nSz2 )
				ENDIF
			CASE nPU = 3
				*Price Per Piece
				*SELECT SalesQuote    &&PPc holds PC and CostValue is in PC!
				nCostBucket = nCostBucket + (nPieces  * tmpCalcStock.CostValue)
				nSOitemPOCost = ThisForm.CalcPOLotCost( cSOitem, nPieces )
			ENDCASE
		
		ENDSCAN
		****************
		
		nCostBucket = ROUND( nCostBucket + nSOitemPOCost ,2)
		
		PRIVATE cSQLu, nSQLEXEC
		IF SalesQuote.ItemCost > 0 AND ( SalesQuote.ItemCost != nCostBucket )
			IF MESSAGEBOX("Do you want to replace your current Cost of $"+ALLTRIM(STR(SalesQuote.ItemCost))+CHR(13)+;
					"with the Inventory cost of $"+ALLTRIM(STR(nCostBucket))+" ?",4+32,"Item allready has a Cost." )= 6
				REPLACE ItemCost WITH nCostBucket IN SalesQuote
				
			
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + "ItemCost="+STR(SalesQuote.nCostBucket,9,2)+""
				cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSoItem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF
			ELSE
				REPLACE ItemCost WITH nCostBucket IN SalesQuote
				
			
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + "ItemCost="+STR(SalesQuote.nCostBucket,9,2)+""
				cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF		
			ENDIF
		ENDIF
		
		THISFORM.pf.pgQuote.txtItemCost.REFRESH()
		IF USED('tmpCalcStock')
			IF RECCOUNT("tmpCalcStock") > 0
				REPLACE inv WITH .T. IN SalesQuote
				THISFORM.pf.pgOrder.chkInv.REFRESH
				
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + " INV = 1"
				cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF
			ENDIF
			USE IN tmpCalcStock
		ENDIF
		
		RETURN nCostBucket 
	ENDPROC

	PROCEDURE calc_pgvalues
		*ThisForm.Calc_PgValues()
		
		Private cCurrTable
		cCurrTable = ALIAS()
		
		PRIVATE ncurrSalesNumRec
		SELECT SalesQuote
		nCurrSalesNumRec = RECNO('SalesQuote')
		
		ThisForm.pf.pgValue.GrdPrices.RecordSource = ""
		
		IF USED('SalesTotal')
			USE IN SalesTotal
		ENDIF
		PRIVATE cFileName
		cFileName = SYS(3)
		
		IF NOT USED('SalesTotal')
			CREATE TABLE ( SYS(5)+SYS(2003)+"\MEM\"+cFileName ) FREE (ItemSale Y,ItemCost Y, ItemPOCost Y,Item INT, Cncld l, SOitem CHAR(10))
			USE (SYS(5)+SYS(2003)+"\MEM\"+cFileName) EXCL ALIAS SalesTotal
			INSERT INTO SalesTotal (ItemSale,ItemCost,ItemPOCost,Item,Cncld,SOitem) VALUES (0.00,0.00,0.00,1,.F.,'0-01')
		*	SELECT 0.00 AS ItemSale, 0.00 AS ItemCost, 0.00 AS ItemPOCost, 1 AS Item, 0 AS Cncld, ' 0-01' AS SOitem FROM SalesQuote INTO TABLE SalesTotal
		ENDIF
		
		
		SET SAFETY OFF
		SELECT 0
		
		*SELECT ItemSale, ItemCost, 0.00 AS ItemPOCost, Item_A as Item, Cncld, SOitem FROM SalesQuote INTO TABLE SYS(5)+SYS(2003)+"\MEM\SalesTotal.dbf"
		SELECT ItemSale, ItemCost, 0.00 AS ItemPOCost, Item_A as Item, Cncld, SOitem FROM SalesQuote INTO TABLE SalesTotal
		
		
		PRIVATE nSumSale,nSumCost,nSumPOCost
		nSumSale = 0
		nSumCost = 0
		nSumPOCost = 0
		PRIVATE nItem
		nItem = 0
		
		
		SELECT SalesTotal
		GO TOP
		
		SCAN
			nItem = SalesTotal.item
			nSumSale  = nSumSale + ItemSale
			nSumCost  = nSumCost + ItemCost
			IF soITEM = '0-01'
				nPOCost = 0
			ELSE
				nPOCost = getPOCost_SOitem( SOitem, ThisForm.nConnHandle )
			ENDIF
			
			UPDATE SalesTotal SET ItemPOCost = nPOCost WHERE Item = nItem
			LOCATE FOR Item = nItem &&Get back, becuase the Update will take to EOF
			nSumPOCost = nSumPOCost + nPOCost
		ENDSCAN
		
		SELECT SalesTotal
		GO TOP
		
		ThisForm.pf.pgValue.GrdPrices.RecordSource = "SalesTotal"
		ThisForm.pf.pgValue.GrdPrices.RecordSourceType = 1
		ThisForm.pf.pgValue.GrdPrices.clmSale.ControlSource		= "SalesTotal.ItemSale"
		ThisForm.pf.pgValue.GrdPrices.clmCost.ControlSource		= "SalesTotal.ItemCost"
		ThisForm.pf.pgValue.GrdPrices.clmPOCost.ControlSource	= "SalesTotal.ItemPOCost"
		ThisForm.pf.pgValue.GrdPrices.clmProfit.ControlSource	= "(SalesTotal.ItemSale - SalesTotal.ItemCost - SalesTotal.ItemPOCost)"
		ThisForm.pf.pgValue.GrdPrices.clmItem.ControlSource		= "SalesTotal.item"
		ThisForm.pf.pgValue.GrdPrices.clmCncld.ControlSource	= "SalesTotal.Cncld"
		
		
		PRIVATE ntProfit, ntPercent
		ntProfit = nSumSale - nSumCost - nSumPOCost 
		IF nSumSale <> 0
			ntPercent = (ntProfit / nSumSale ) * 100
		ELSE
			ntPercent = 100
		ENDIF
		
		ThisForm.pf.pgValue.nSale.Value   = nSumSale
		ThisForm.pf.pgValue.nCost.Value   = nSumCost
		ThisForm.pf.pgValue.nPOCost.Value = nSumPOCost
		ThisForm.pf.pgValue.nProfit.Value = ntProfit 
		ThisForm.pf.pgValue.nPercent.Value = ntPercent
		
		ThisForm.pf.pgValue.nSale.Refresh
		ThisForm.pf.pgValue.nCost.Refresh
		ThisForm.pf.pgValue.nPOCost.Refresh
		ThisForm.pf.pgValue.nProfit.Refresh
		ThisForm.pf.pgValue.nPercent.Refresh
		
		IF ntProfit < 1
			ThisForm.pf.pgValue.nProfit.DisabledBackColor = RGB(255,0,0)
		ELSE
			ThisForm.pf.pgValue.nProfit.DisabledBackColor = RGB(212,208,200)
		ENDIF
		
		
		**************************
		IF NOT USED('SalesQuote')
			TrackError("SalesQuote table is gone!."+CHR(13)+"Current table is listed as '"+ALLTRIM(cCurrTable)+"'.","Calc_PgValues","frmEdt.Calc_PgValues",1)
		ENDIF
		
		SELECT SalesQuote
		IF ncurrSalesNumRec > RECCOUNT()
			GO BOTTOM
		ELSE
			GOTO (ncurrSalesNumRec)
		ENDIF
		
		IF !EMPTY(cCurrTable)
			IF USED(cCurrTable)
				SELECT (cCurrTable)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE ccaddress
		PARAMETER pAction
		PRIVATE nCardAddr
		DO CASE
		CASE pAction = "SHOW"
		
			nCardAddr =	ThisFormSet.frmCC.txtAddr1.txtSoldcode.VALUE
		
			IF USED( 'SoldAddr' )
				USE IN SoldAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr "
			cSQL = cSQL + " WHERE SoldCode = "+STR(nCardAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
