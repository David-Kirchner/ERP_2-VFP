	PROCEDURE frmEdt.pf.pgShipto.cmbPayment.Valid
		*ShowPaymentTypeText('1')
		* , Not Entered,STD TERMS,Standard Terms,COD,COD,PREPAID,Prepay/Credit Card,CANADA STD, Canada Standard,CANADA COD, Canada COD,CANADA PP, Canada Prepay,FOREIGNSTD, Foreign Standard,FOREIGNCOD, Foreign COD,FOREIGN PP, Foreign PrePay
		
		*WIRE TRANS,Wire Transfer,
		*HOLD 4 PAY,Hold for Payment
		
		IF This.Value = "STD TERMS" 
		
			PRIVATE cCompany, cCustomerID 
			IF NOT EMPTY(This.Parent.Parent.pgBillTo.txtCompany.Value)
				cCompany = ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value)
			ELSE
				cCompany = AllTrim(SalesQuote.Company)
			ENDIF
			cCustomerID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
			
			DO FORM forms\customerterms WITH cCompany, cCustomerID 
			
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF THISFORM.ShipAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?"+CHR(13)+"Answer NO to be able to abort this edit.",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			IF THISFORM.ShipAddr <> 0
				THISFORM.ShipAddr = 0
		
		*!*			IF THIS.PARENT.chkAllShipAddr.VALUE = 1
		*!*				mHoldRecordNum = 0
		*!*				mHoldRecordNum = RECNO('SalesQuote')
		*!*				REPLACE ALL pShipAddr WITH 0 IN SalesQuote
		*!*				IF mHoldRecordNum > 0
		*!*					GOTO (mHoldRecordNum) IN SalesQuote
		*!*				ELSE
		*!*					GOTO TOP
		*!*				ENDIF
		*!*			ELSE
		*!*				REPLACE pShipAddr WITH 0 IN SalesQuote
		*!*			ENDIF
		*		THIS.PARENT.numShipAddr.VALUE = 0
				THIS.PARENT.txtShipCode.VALUE = 0
			ENDIF
			
			ThisForm.Address_Screen("ShipToEdit")
			
			THIS.PARENT.cmdSearchShipTo.ENABLED = .T.
		
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
		
		ELSE
			IF THIS.PARENT.cmdEditShipTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
					IF USED( 'ShipAddr' )
						USE IN ShipAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.ShipAddr "
					cSQL = cSQL + " WHERE ShipCode = "+STR(THISFORM.ShipAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
					ENDIF
					IF USED('ShipAddr')
						*thisform.ShipAddr = ShipAddr.ShipCode	
						THIS.PARENT.txtShipCode.VALUE = ShipAddr.ShipCode
						THIS.PARENT.txtCompany.VALUE 	= ShipAddr.Company
						THIS.PARENT.txtAddr1.VALUE 		= ShipAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE 		= ShipAddr.Addr2
						THIS.PARENT.txtCity.VALUE 		= ShipAddr.City
						THIS.PARENT.txtST.VALUE 		= ShipAddr.ST
						THIS.PARENT.txtZip.VALUE 		= ShipAddr.Zip
						THIS.PARENT.txtCountry.VALUE 	= ShipAddr.Country
						THIS.PARENT.txtContact.VALUE 	= ShipAddr.Contact
						THIS.PARENT.txtPhone.VALUE 		= ShipAddr.Telephone
						THIS.PARENT.txtFax.VALUE 		= ShipAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE 		= ShipAddr.Email
						THIS.PARENT.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(ShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(ShipAddr.LastEdit,'LastEdit'))
						
						USE IN ShipAddr
					ENDIF
					ThisForm.Address_Screen("ShipToEdit")
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdCopyto.Click
		IF EMPTY(THIS.PARENT.PARENT.pgBillTo.txtSoldCode.VALUE)
		*need to populate billto be for Copying from billto
		
		*!*		IF THIS.PARENT.PARENT.pgBillTo.chkAllSoldAddr.VALUE = 1
		*!*			THISFORM.cmdTop.CLICK()
		*!*		ENDIF
		
			IF thisform.SoldAddr > 0
				* Have Address number!
				THIS.PARENT.PARENT.pgBillTo.txtSoldCode.VALUE = thisform.SoldAddr
				*THISFORM.SoldAddr = SalesQuote.pSoldAddr
		
		
		
				IF USED( 'SoldAddr' )
					USE IN SoldAddr
				ENDIF
				SELECT 0
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT * FROM dbo.SoldAddr "
				cSQL = cSQL + " WHERE SoldCode = "+STR(THISFORM.SoldAddr)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
				ENDIF
				IF USED('SoldAddr')
		*		IF SEEK(THISFORM.SoldAddr,"SoldAddr","SoldCode" ) &&Found the record
					THIS.PARENT.PARENT.pgBillTo.txtCompany.VALUE 	= SoldAddr.Company
					THIS.PARENT.PARENT.pgBillTo.txtAddr1.VALUE		= SoldAddr.Addr1
					THIS.PARENT.PARENT.pgBillTo.txtAddr2.VALUE		= SoldAddr.Addr2
					THIS.PARENT.PARENT.pgBillTo.txtCity.VALUE 		= SoldAddr.City
					THIS.PARENT.PARENT.pgBillTo.txtST.VALUE			= SoldAddr.ST
					THIS.PARENT.PARENT.pgBillTo.txtZip.VALUE		= SoldAddr.Zip
					THIS.PARENT.PARENT.pgBillTo.txtCountry.VALUE	= SoldAddr.Country
					THIS.PARENT.PARENT.pgBillTo.txtContact.VALUE	= SoldAddr.Contact
					THIS.PARENT.PARENT.pgBillTo.txtPhone.VALUE		= SoldAddr.Telephone
					THIS.PARENT.PARENT.pgBillTo.txtFax.VALUE		= SoldAddr.Fax_Number
					THIS.PARENT.PARENT.pgBillTo.txtEmail.VALUE		= SoldAddr.Email
					This.Parent.Parent.pgBillTo.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(SoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(SoldAddr.LastEdit,'LastEdit'))
					*ThisForm.Address_Screen("SoldToEdit")
					
					USE IN SoldAddr
					
				ENDIF
			ENDIF
		ENDIF
		***
		
		THISFORM.ShipAddr = 0
		THIS.PARENT.txtShipCode.VALUE	= 0 &&Blank- so save creates new ID
		*THIS.PARENT.numShipAddr.VALUE	= 0 
		THIS.PARENT.txtCompany.VALUE	= THIS.PARENT.PARENT.pgBillTo.txtCompany.VALUE
		THIS.PARENT.txtAddr1.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtAddr1.VALUE
		THIS.PARENT.txtAddr2.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtAddr2.VALUE
		THIS.PARENT.txtCity.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtCity.VALUE
		THIS.PARENT.txtST.VALUE			= THIS.PARENT.PARENT.pgBillTo.txtST.VALUE
		THIS.PARENT.txtZip.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtZip.VALUE
		THIS.PARENT.txtCountry.VALUE	= THIS.PARENT.PARENT.pgBillTo.txtCountry.VALUE
		THIS.PARENT.txtContact.VALUE	= THIS.PARENT.PARENT.pgBillTo.txtContact.VALUE
		THIS.PARENT.txtPhone.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtPhone.VALUE
		THIS.PARENT.txtFax.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtFax.VALUE
		THIS.PARENT.txtEmail.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtEmail.VALUE
		This.Parent.txtLastEdit.Value	= ""
		
		ThisForm.Address_Screen("ShipToSave")
		*wait window "Remember to Click Save on the Ship Address." NOWAIT
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdCopyto.When
		IF EMPTY(This.Parent.Parent.pgBillTo.txtSoldCode.Value)
			
		*	MESSAGEBOX('Must be in edit mode!')
		*	RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdCustomerTerms.Click
		PRIVATE cCompany
		IF NOT EMPTY(This.Parent.Parent.pgBillTo.txtCompany.Value)
			cCompany = ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value)
		ELSE
			cCompany = AllTrim(SalesQuote.Company)
		ENDIF
		
		IF FILE("forms\customerterms.scx")
			DO FORM forms\customerterms WITH cCompany 
		ELSE
			MESSAGEBOX("FILE customerterms.scx NOT FOUND!",0,'')
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdEditShipTo.Click
		
		IF THIS.CAPTION != "Save"
			ThisForm.Address_Screen("ShipToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ELSE
		
			PRIVATE	maxShipCode, maxSoldCode, oldShipCode, useShipCode, SaveAddr, msettalk
			PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnShipAddr
			PRIVATE lcContact,lcPhone,lcFax,lcEmail
			PRIVATE mHoldRecordNum
			maxShipCode = 0
			SaveAddr = .F.
			oldShipCode = 0
			useShipCode = 0
			
			*PrepareSQLtxt("High Performance Alloy's'",'Company',25)
			lcCompany =PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',30)
			lcAddr1 = PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',30)
			lcAddr2 = PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',30)
			lcCity  = PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',20)
			lcST    = PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',2)
			lcZip   = PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',12)
			lcCountry = PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',15)
			lcContact = PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',20)
			lcPhone = PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',12)
			lcFax	 = PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
			lcEmail = PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
			ldLastEdit = DATE()
			lnShipAddr = PrepareSQLnum(THISFORM.ShipAddr,'ShipAddr',-3,0)
			SaveAddress = .F.
		
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))
				SaveAddress = .T.
			ENDIF
		
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!")
				SaveAddress = .F.
			ENDIF
		
			IF SaveAddress 
				IF USED( 'delShipAddr' )
					USE IN delShipAddr
				ENDIF
				SELECT 0
				
				cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.ShipAddr "
				cSQL = cSQL + " WHERE "
				cSQL = cSQL + "Company = '"+lcCompany+"' AND "
				cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
				cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
				cSQL = cSQL + "City = '"+lcCity+"' AND "
				cSQL = cSQL + "ST = '"+lcST+"' AND " 
				cSQL = cSQL + "Zip = '"+lcZip+"' AND "
				cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
				cSQL = cSQL + "Contact = '"+lcContact+"' AND "
				cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
				cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
				cSQL = cSQL + "Email = '"+lcEmail+"' "
		*		cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnShipAddr))
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'delShipAddr' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'delShipAddr' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'delShipAddr')
				ENDIF
				
				IF USED('delShipAddr')
					IF delShipAddr.Cnt < 1
						SaveAddress = .T.
					ELSE
						SaveAddress = .F.
						*Already have exact Address
						
						IF USED("tmpCntShipCode")
							USE IN tmpCntShipCode
						ENDIF
						SELECT 0
						cSQL = "SELECT shipcode FROM dbo.ShipAddr"
						cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City = '"+lcCity+"'"
						cSQL = cSQL + " AND ST = '"+lcST+"'"
						cSQL = cSQL + " AND Zip = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'"
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
					*	cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnShipAddr))
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntShipCode')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntShipCode')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCntShipCode')
						ENDIF
						
						IF USED("tmpCntShipCode")
							IF VARTYPE(tmpCntShipCode.shipcode) = 'N'
								lnShipAddr = tmpCntShipCode.shipcode
								ThisForm.ShipAddr = lnShipAddr
							ENDIF
							USE IN tmpCntShipCode
						ENDIF
							
							
						*****
						
						IF EMPTY(THISFORM.ShipAddr)
		
							*Find the ShipCode and display it
							IF USED( 'shipcodeShipAddr' )
								USE IN shipcodeShipAddr
							ENDIF
							SELECT 0
							PRIVATE cSQL, nSQLEXEC
							cSQL = "SELECT shipcode FROM dbo.ShipAddr "
							cSQL = cSQL + " WHERE "
							cSQL = cSQL + "Company = '"+lcCompany+"' AND "
							cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
							cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
							cSQL = cSQL + "City  = '"+lcCity+"' AND "
							cSQL = cSQL + "ST    = '"+lcST+"' AND " 
							cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
							cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
							cSQL = cSQL + "Contact = '"+lcContact+"' AND "
							cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
							cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
							cSQL = cSQL + "Email = '"+lcEmail+"'"
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'shipcodeShipAddr' )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'shipcodeShipAddr' )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'shipcodeShipAddr')
							ENDIF
		
							IF USED('shipcodeShipAddr')
								IF shipcodeShipAddr.shipcode > 0
									THISFORM.ShipAddr = shipcodeShipAddr.shipcode
									THIS.PARENT.txtShipCode.REFRESH
								ENDIF
								USE IN shipcodeShipAddr
							ENDIF
						ENDIF  &&EMPTY(THISFORM.ShipAddr)
					ENDIF &&delShipAddr.Cnt
					
					USE IN delShipAddr
				ELSE &&USE IN delShipAddr
					SaveAddress = .F.
				ENDIF
			ENDIF &&IF SaveAddress
			
			*****
			
			IF SaveAddress
				PRIVATE	cSaveNew
		
				IF lnShipAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
					
					IF nSaveNew = 7 && No
						IF USED( 'cntSales_No' )
							USE IN cntSales_No
						ENDIF
						SELECT 0
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales_No "
						cSQL = cSQL + " WHERE PShipAddr= "+STR(lnShipAddr )
						cSQL = cSQL + " AND Sales_No.CNCLD = 0 AND Sales_No.CMPLT = 0"
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_No' )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSales_No')
						ENDIF
						IF cntSales_No.cnt > 0
							
							MESSAGEBOX("There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)+;
							ALLTRIM(STR(cntSales_No.cnt))+" unshipped Order(s) use the Address number "+;
							ALLTRIM(STR(lnShipAddr))+".",0+16,"CAUTION")
						ENDIF
						IF USED( 'cntSales_No' )
							USE IN cntSales_No
						ENDIF
						THISFORM.ShipAddr = lnShipAddr 
		*!*				RELEASE aCntShipAddr
					ENDIF
					
					IF nSaveNew = 6 && Yes
						IF MESSAGEBOX("Do you want to mark the old Address as INACTIVE ?"+CHR(13)+CHR(13)+;
							"Inactive address will not show when you search for an address."+CHR(13)+;
							"If the company has moved,"+CHR(13)+;
							"permantly leaving the address,"+CHR(13)+;
							"please mark the old address as inactive now.",4,"") = 6
							
							
							*Mark as InaActive
							PRIVATE cSQLu
							cSQLu= "UPDATE dbo.ShipAddr SET "
							cSQLu= cSQLu+" ShipAddr.InActive = 1"
							cSQLu= cSQLu+" WHERE shipcode = "+STR(lnShipAddr)
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
							ENDIF
							
						ENDIF
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
				IF nSaveNew = 6 && Yes, save as new
					****** big save procedure********
					IF THISFORM.ShipAddr > 0 &&Check old ShipCode to see if anything changed.
						*Check old ShipCode to see if anything changed
						IF USED( 'cntShipAddr' )
							USE IN cntShipAddr
						ENDIF
						SELECT 0
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS cnt FROM dbo.ShipAddr "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"' "
		*				cSQL = cSQL + " AND shipcode = "+STR(THISFORM.ShipAddr)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
						ENDIF
						IF USED('cntShipAddr')
							IF cntShipAddr.Cnt = 0
		*						*-no change - do not save
								*Did not find - Save
								SaveAddr = .T.
								oldShipCode = THISFORM.ShipAddr
							ELSE 
								*Found match - do not need to save
								SaveAddr = .F.
							ENDIF
						ELSE &&failed - add as new
							SaveAddr = .T.
						ENDIF 
						
					ELSE && No ShipCode - add if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							SaveAddr = .T.
						ELSE
							*No Company or Address to save! Clear!!!
							SaveAddr = .F.
						ENDIF
					ENDIF
		
					IF SaveAddr
						WAIT WINDOW "Saving 'Ship To' address." NOWAIT
		
						*save same as SoldCode (if avalable)
						IF THISFORM.SoldAddr <> THISFORM.ShipAddr
						
							IF USED("cntShipCode")
								USE IN cntShipCode
							ENDIF
							cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.ShipAddr"
							cSQL = cSQL + " WHERE ShipCode = "+STR(THISFORM.SoldAddr)
				
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipCode')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipCode')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipCode')
							ENDIF
							IF USED("cntShipCode")
								IF cntShipCode.cnt = 0
									*Not Found
									useShipCode = THISFORM.SoldAddr
								ENDIF
								USE IN cntShipCode
							ELSE
							ENDIF
						ENDIF
						IF useShipCode = 0 &&need to find a ShipCode
							*			Get next code maxShipCode
							MaxSoldCode = get_MaxSoldCode()
							*maxSoldCode = THISFORM.maxSoldCode()
							*maxShipCode = THISFORM.maxShipCode()
							MaxShipCode = get_MaxShipCode()
							useShipCode = MAX( maxSoldCode, maxShipCode )
		
						ENDIF
						IF useShipCode > 0 &&Save here
							THISFORM.ShipAddr = useShipCode
		
							THIS.PARENT.txtShipCode.VALUE = useShipCode
		*					THIS.PARENT.numShipAddr.VALUE = useShipCode
		
							Save_ShipAddrCode(useShipCode, "ShipAddr", oldShipCode, ThisForm.nConnHandle)
							
							IF ThisForm.SalesNum > 0
								*Save ShipCode now to Sales_No
								*so the ShipAddr insert trigger knows what Sales_No in email.
								cSQL = "UPDATE dbo.Sales_No SET pShipAddr = "+STR(useShipCode)+" WHERE SalesNum = "+STR(ThisForm.SalesNum)
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
								ENDDO
								
								IF nSQLEXEC < 0 &&Try again!, long triger
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
									ENDDO
								ENDIF
								
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
								ENDIF
							ENDIF
							
							PRIVATE cSQLi
							cSQLi = "INSERT INTO dbo.ShipAddr (shipcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email, Customer, LastEdit) VALUES "
							cSQLi = cSQLi+"("+STR(useShipCode)+""
							cSQLi = cSQLi+",'"+lcCompany+"'"
							cSQLi = cSQLi+",'"+lcAddr1+"'"
							cSQLi = cSQLi+",'"+lcAddr2+"'"
							cSQLi = cSQLi+",'"+lcCity+"'"
							cSQLi = cSQLi+",'"+lcST+"'"
							cSQLi = cSQLi+",'"+lcZip+"'"
							cSQLi = cSQLi+",'"+lcCountry+"'"
							cSQLi = cSQLi+",'"+lcContact+"'"
							cSQLi = cSQLi+",'"+lcPhone+"'"
							cSQLi = cSQLi+",'"+lcFax+"'"
							cSQLi = cSQLi+",'"+lcEmail+"'"
							cSQLi = cSQLi+",''"		&&+ALLTRIM(STR(useShipCode,10,0))+""
							cSQLi = cSQLi+",'"+DTOC(DATE())+"' )"
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi ,ThisForm.nConnHandle, nSQLEXEC ,'')
							ENDIF
							
							
							IF THISFORM.SoldAddr > 0
								Save_Sold_Ship(THISFORM.SoldAddr, useShipCode)
							ENDIF
							
							*****************
							
							IF ThisForm.SalesNum > 0
								IF Count_SOinPackingSlip_No( ThisForm.SalesNum, ThisForm.nConnHandle ) > 0
									MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
									"The Packing Slip database will be updated with this new address.",0+48,"")
		
									Update_ShipCodeinPackingSlip_No( useShipCode, ThisForm.SalesNum, ThisForm.nConnHandle )
		
								ENDIF
							ENDIF		
							******************
							THIS.PARENT.txtLastEdit.VALUE = DATE()
							THIS.PARENT.txtLastEdit.REFRESH
		
						ENDIF
						WAIT CLEAR
					ENDIF
				ELSE   &&IF nSaveNew = 6 && Yes
					*Save - not as new!
					*REPLACE DATA
						PRIVATE cSQLu
						cSQLu= "UPDATE dbo.ShipAddr SET "
						cSQLu= cSQLu+" Company='"+lcCompany+"'"
						cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
						cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
						cSQLu= cSQLu+",City='"+lcCity+"'"
						cSQLu= cSQLu+",ST='"+lcST+"'"
						cSQLu= cSQLu+",Zip='"+lcZip+"'"
						cSQLu= cSQLu+",Country='"+lcCountry+"'"
						cSQLu= cSQLu+",Contact='"+lcContact+"'"
						cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
						cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
						cSQLu= cSQLu+",Email='"+lcEmail+"'"
						cSQLu= cSQLu+",Customer="+ALLTRIM(STR(useShipCode,10,0))+""
						cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
						cSQLu= cSQLu+" WHERE ShipAddr.shipcode = "+STR(lnShipAddr)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
							
					THISFORM.UpdateCustID = .T.
		
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
				ENDIF  &&  &&IF nSaveNew = 6 && Yes
			ENDIF &&IF SaveAddress
			
			ThisForm.Address_Screen("ShipToEdit")
			THISFORM.cmdNext.SETFOCUS()
		
		
		ENDIF &&THIS.CAPTION = "Save"
		IF USED( 'delShipAddr' )
			USE IN delShipAddr
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdGetShipInfo.Click
		
		IF !Empty(ThisForm.ShipAddr)
		
			PRIVATE aShipInfo
			
		*	SELECT shiproute, instrct FROM shipaddr WHERE shipcode = ThisForm.ShipAddr INTO ARRAY aShipInfo
			IF USED( 'cntShipAddr' )
				USE IN cntShipAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT shiproute, instrct FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE "
			cSQL = cSQL + "shipcode = "+STR(THISFORM.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
			ENDIF
			
			IF TYPE("cntShipAddr.shiproute") = "C"
				This.Parent.txtShipRoute.Value = cntShipAddr.shiproute
				This.Parent.txtShipRoute.Refresh
			ENDIF
			
			IF TYPE("cntShipAddr.instrct") = "C"
				This.Parent.txtInstrct.Value = cntShipAddr.instrct 
				This.Parent.txtInstrct.Refresh
			ENDIF
			
			IF USED( 'cntShipAddr' )
				USE IN cntShipAddr
			ENDIF
		
		ELSE
		
			messagebox("ShipAddr code is empty",0,'')
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdPaymentStatus.Click
		IF FILE("forms\CustomerStatus.scx")
			DO FORM forms\CustomerStatus WITH SalesQuote.CustID, SalesQuote.Company, ThisForm.SoldAddr, ThisForm.nConnHandle 
		ELSE
			MESSAGEBOX("FILE CustomerStatus.scx NOT FOUND!",0,'')
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdPeach.Click
		PRIVATE cCompany, cCustID
		cCompany= AllTrim(SalesQuote.Company)
		cCustID = AllTrim(SalesQuote.CustID)
		
		IF FILE("forms\MatchCustomerID.scx")
			DO FORM forms\MatchCustomerID WITH cCustID, cCompany
		ELSE
			MESSAGEBOX("Could not find 'MatchCustomerID' to run",0+16,"Error")
		ENDIF
	ENDPROC

