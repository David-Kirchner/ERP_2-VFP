	PROCEDURE frmCC.txtCompany.GotFocus
		IF EMPTY(This.Value) AND This.Parent.cmdCCEditSoldTo.Caption = "Save"
			This.Value = SalesQuote.Company
			
			IF EMPTY(This.Parent.txtContact.Value)
				This.Parent.txtContact.Value = SalesQuote.name
			ENDIF
			IF EMPTY(This.Parent.txtPhone.Value)
				This.Parent.txtPhone.Value = SalesQuote.Phone+SalesQuote.Phone_ext
			ENDIF
			IF EMPTY(This.Parent.txtFax.Value)
				This.Parent.txtFax.Value = SalesQuote.Fax
			ENDIF
			IF EMPTY(This.Parent.txtEmail.Value	)
				This.Parent.txtEmail.Value = SalesQuote.Email
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmCC.txtExpireDd.Valid
		PRIVATE nVal
		IF VARTYPE(This.Value) = 'C'
			nVal = VAL(This.Value)
		ELSE
			nVal = This.Value
		ENDIF
		
		IF nVal < 0 OR nVal > 31
			MESSAGEBOX("Date can be only 1 to 31")
			This.Value = .NULL.
		ENDIF
		
	ENDPROC

	PROCEDURE frmCC.txtExpireMm.Valid
		PRIVATE nVal
		IF VARTYPE(This.Value) = 'C'
			nVal = VAL(This.Value)
		ELSE
			nVal = This.Value
		ENDIF
		
		IF nVal < 0 OR nVal > 12
			MESSAGEBOX("Month can be only 1 to 12")
			This.Value = .null.
		ENDIF
	ENDPROC

	PROCEDURE frmCC.txtExpireYYYY.Valid
		PRIVATE nVal
		
		IF VARTYPE(This.Value) = 'C'
			nVal = VAL(This.Value)
		ELSE
			nVal = This.Value
		ENDIF
		
		DO CASE
		CASE nVal < 1
			This.Value = .null.
		CASE nVal < 100 
			This.Value = 2000 + nVal
		CASE nVal < YEAR(DATE())
			MESSAGEBOX("Bad Year",0+48,"Past Due")
		*CASE nVal > 2000 AND nVal < YEAR(DATE())
		*	MESSAGEBOX("Bad Year",0+48,"Past Due")
		ENDCASE
		
		
	ENDPROC

	PROCEDURE frmCC.txtHolderName.When
		IF EMPTY(This.Value) AND This.Parent.cmdCCEdit.Caption = "Save"
			This.Value = SalesQuote.Name
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.cmdEdit.Valid
		******* Check Values before saving ******
		
		**check Send Email
		LOCAL llBlind, llEmailConf, llFaxConf, lSaveThis
		lSaveThis = .T.
		
		llEmailConf	= IIF( ThisForm.pf.pgBillto.chkEmail.Value  = 1, .T. , .F. ) 
		llFaxConf	= IIF( ThisForm.pf.pgBillto.chkFax.Value  = 1, .T. , .F. ) 
		
		IF llEmailConf AND EMPTY(ThisForm.pf.pgBillTo.txtEmail.Value)
			MESSAGEBOX("Send Shipping notice by Email is marked, but"+CHR(13)+"there is no Email address!")
		ENDIF  
		IF llFaxConf 
			IF EMPTY( ThisForm.pf.pgBillTo.txtFax.Value) AND EMPTY( ThisForm.pf.pgOrder.txtFax.Value ) 
				MESSAGEBOX("Send Shipping notice by Fax is marked, but"+CHR(13)+"there is no Fax Number!")
			ENDIF
		ENDIF
		
		** Check Hardwood print
		PRIVATE cBillCountry, cShipCountry, lFoundCountry, cBillCountryABV, cShipCountryABV
		cBillCountry = PADR(UPPER(ThisForm.pf.pgBillTo.txtCountry.Value),15," ")
		cShipCountry = PADR(UPPER(ThisForm.pf.pgShipto.txtCountry.Value),15," ")
		lFoundCountry = .F.
		
		IF NOT USED('HardWood')
			ThisForm.LoadHardwood()
		ENDIF
		
		SELECT HardWood
		INDEX ON Country TAG Country
		INDEX ON ABV TAG ABV
		
					
		IF NOT EMPTY(cShipCountry)
			SEEK cShipCountry ORDER Country IN HardWood
			IF FOUND("HardWood")
				IF NOT HardWood.Inactive
					lFoundCountry = .T.
				ENDIF
			ENDIF
			IF NOT lFoundCountry 
				IF LEN(ALLTRIM(cShipCountry)) = 2
					cShipCountryABV = LEFT(cShipCountry ,2)
					SEEK cShipCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							lFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry 		
				SEEK cShipCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						IF MESSAGEBOX("The Ship to COUNTRY was entered as "+cShipCountry+CHR(13)+;
						"Spelling is close, Is this the same as "+Hardwood.Country,4+32,"Sounds similiar." )=6
							lFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT EMPTY(cBillCountry)
			IF NOT lFoundCountry 
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						lFoundCountry = .T.
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry 
				IF LEN(ALLTRIM(cBillCountry )) = 2
					cBillCountryABV = LEFT(cBillCountry ,2)
					SEEK cBillCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							lFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry 
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						IF MESSAGEBOX("The Ship to COUNTRY was entered as "+cBillCountry+CHR(13)+;
						"Spelling is close, Is this the same as "+Hardwood.Country,4+32,"Sounds similiar." )=6
							lFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		PRIVATE cOther, lpOther
		lpOther	= IIF( ThisForm.pf.pgBillTo.chkpOther.VALUE = 1, .T. , .F. ) 
		
		IF lpOther
			cOther	= ThisForm.pf.pgBillTo.txtOther.VALUE 
			IF TYPE("cOther") = "N"
				cOther = STR(cOther)
			ENDIF
			IF TYPE("cOther") != "C"
				cOther = ""
				MESSAGEBOX(" On tab 'Bill To', The 'Other' field was not a character I can store."+CHR(13)+"The 'Other' field will not be saved!",0,"Data type Error")
			ENDIF	
		ELSE
			cOther = ""
		ENDIF
			
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		****
		
		**Check Conversion PO
		IF NOT ThisForm.CheckVendCode()
			RETURN .F.
		ENDIF
		
		*Check for Cancel
		*A Cancelled Order Save does not need and Amendment!
		PRIVATE lnSalesNum
		lnSalesNum	= THISFORM.SalesNum
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpSOCancel')
			USE IN tmpSOCancel
		ENDIF
		SELECT 0
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Sales_NO "
		cSQL = cSQL + " WHERE SalesNum = "+STR(lnSalesNum)+""
		cSQL = cSQL + " AND ISNULL([cncld],0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOCancel')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOCancel' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSOCancel')
		ENDIF
				
		IF USED('tmpSOCancel') 
			IF RECCOUNT('tmpSOCancel') > 0
				IF tmpSOCancel.CNTD > 0
					*Not Cancelled
				ELSE
					*Cancelled
					ThisForm.SaveSO()
					lSaveThis = .F.
					THISFORM.nPrintedSO = 0
				ENDIF
			ENDIF
			USE IN tmpSOCancel
		ENDIF
					
		
		
		******* Done Checking, get admendment #
		PRIVATE nAmendment, cAmendment
		nAmendment = PrepareSQLnum(ThisForm.pf.pgBillTo.txtAmendment.Value,'Amendment',2,0)
		IF EMPTY(nAmendment)
			nAmendment = 0
		ENDIF
		cAmendment = ALLTRIM(STR(nAmendment))
		
		IF THISFORM.nPrintedSO > 0
			IF MESSAGEBOX("This SO has allready been printed."+CHR(13)+"If you save again the AMENDMENT"+CHR(13)+"number ("+cAmendment+") will increment by one ("+ALLTRIM(STR(nAmendment+1))+")."+CHR(13)+CHR(13)+"Do you wish to save now?",4+32,"Save as amended?")= 6 &&Yes
				PRIVATE lForceChange
				lForceChange = .T.
				
				IF NOT Set_Sales_No_Changing( SalesQuote.SalesNum, ThisForm.nConnHandle, lForceChange )
					MESSAGEBOX("Could not set the 'Changing' field!"+CHR(13)+"Your SO will not increment to next version."+CHR(13)+"Try to save again!",0+48,"SQL Error- Not Saved.")
					lSaveThis = .F.	
				ELSE
					lSaveThis = .T.
					*nAdmendment = nAdmendment + 1
					*Check code at print time
				ENDIF
			ELSE
				lSaveThis = .F.
			ENDIF
		ENDIF
		
		
		IF lSaveThis
			IF ThisForm.CheckData4Save()
				IF ThisForm.SaveSO()
					IF ThisForm.nPrintedSO = 1
						MESSAGEBOX("This edit has been Saved,"+CHR(13)+;
							+CHR(13)+;
							"This edited order still needs to be printed with its edits.";
							,0+32,"Saved, now reprint." )
					
					ENDIF
				ENDIF
			ENDIF
				
			IF EMPTY(SalesQuote.CustID)
				PRIVATE cCustomerID
				DO FORM Forms\select_CustomerID WITH "SoldAddr", SalesQuote.company, ThisForm.SoldAddr, ThisForm.nConnHandle  TO cCustomerID
				IF NOT EMPTY(cCustomerID)
					PRIVATE nCurrentRec 
					nCurrentRec = RECNO('SalesQuote')
					SELECT SalesQuote
					REPLACE ALL CustID WITH cCustomerID
					GOTO (nCurrentRec)
					
					SaveCustID_AllQuotes(cCustomerID, SalesQuote.SalesNum, ThisForm.nConnHandle )
					
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.cmdExit.Click
		PRIVATE ncurrSalesNumRec, nTotalSalesNumCost, im, cTalkState
		
		IF ThisForm.nPrintedSO = 0
			IF MESSAGEBOX("This SalesOrder has not been marked as Printed."+CHR(13)+"The print routine also saves your work."+CHR(13)+"Make sure you have saved your work before you Exit."+CHR(13)+CHR(13)+"Are you sure you want to leave?",4+32,"Not Printed") = 7 &&NO
				RETURN .F.
			ENDIF
		ENDIF
		
		ThisForm.Release
		
		 
	ENDPROC

	PROCEDURE frmEdt.cmdFAXConfSO.Click
		
		THISFORM.cmdEdit.CLICK &&Save
		
		
		PRIVATE cQ_faxnm
		
		CLEAR TYPEAHEAD
		*WAIT WINDOW "Do you want to Preview / Print?(Y)" TO BLANK
		*IF UPPER(BLANK) = "Y"
		
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		
		
		**********************
		PRIVATE nSoldAddr
		nSoldAddr = PrepareSQLnum(ThisForm.SoldAddr,'SoldCode',-3)
		
		IF USED( 'SoldAddr' )
			USE IN SoldAddr
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.SoldAddr "
		cSQL = cSQL + " WHERE SoldCode = "+STR(nSoldAddr)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
		ENDIF
		
		*********************	
		PRIVATE nShipAddr
		nShipAddr = PrepareSQLnum(ThisForm.ShipAddr,'ShipCode',-3)
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE ShipCode = "+STR(nShipAddr)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		ENDIF
		
		*********************	
		IF USED( 'Sales_No' )
			USE IN Sales_No
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.Sales_No"
		cSQL = cSQL + " WHERE SalesNum = "+STR(SalesQuote.SalesNum)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Sales_No')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Sales_No')
		ENDIF
		**********************
		
		
		
		IF MESSAGEBOX("Do you want to Preview or Print?",4+32) = 6
			ThisForm.AlwaysOnTop = .F.
			ThisForm.AlwaysOnBottom = .T.
			ThisForm.Visible = .F.
			SELECT SalesQuote
			IF FILE('reports\ConfSalesOrder.FRX')
				REPORT FORM reports\ConfSalesOrder TO PRINTER PREVIEW IN SCREEN
				TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" frmEdt.cmdFAXConfSO.Click()" )
				Save_Sales_Status( ThisForm.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisForm.nConnHandle )
			ELSE
				IF FILE('\reports\ConfSalesOrder.FRX')
					REPORT FORM \reports\ConfSalesOrder TO PRINTER PREVIEW IN SCREEN
					TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" frmEdt.cmdFAXCONFSO.Click()" )
					Save_Sales_Status( ThisForm.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisForm.nConnHandle )
				ELSE
					WAIT WINDOW "Report form 'reports\ConfSalesOrder' not found" NOWAIT
					TrackMess("Report form 'reports\ConfSalesOrder' not found"+CHR(13)+" SO: "+ALLTRIM(STR(ThisForm.SalesNum))+" confirmation."+" frmEdt.cmdFaxConfSO.Click()")
				ENDIF
			ENDIF
			
			ThisForm.Visible = .T.
			ThisForm.AlwaysOnBottom = .F.
			ThisForm.AlwaysOnTop = .T.
			GO TOP IN SalesQuote
			
		ENDIF
		
		CLEAR TYPEAHEAD
		
		PRIVATE cQouteEmail, cQuoteName, lSendEmail = .T.
		cQouteEmail	= ALLTRIM(PrepareSQLtxt(SalesQuote.Email,'Email',60))
		cQuoteName	= PrepareSQLtxt(SalesQuote.Name,'Name',25)
		lSendEmail = .T.
		PRIVATE cEmail, cContact, cHomeSalesp 
		cHomeSalesp = ""
		cEmail = ALLTRIM(PrepareSQLtxt(ThisForm.pf.pgBillTo.txtEmail.Value,'Email',60))
		cContact = ALLTRIM(PrepareSQLtxt(ThisForm.pf.pgBillTo.txtContact.Value,'Contact',25))
		
		IF NOT EMPTY(cQouteEmail)
			PRIVATE cMessage
			cMessage = "Do you want to send an Email to "+ALLTRIM(cQuoteName)+CHR(13)+ALLTRIM(cQouteEmail)+"? (Y)"
			IF NOT EMPTY(cEmail)
				cMessage = cMessage+CHR(13)+"Answer No here to be able to Email to "+ALLTRIM(cContact)+CHR(13)+ALLTRIM(cEmail)+". (N)"
				cMessage = cMessage+CHR(13)+"There will be another prompt where you can Answer Yes to "+ALLTRIM(cEmail)+"."
			ENDIF
			IF MESSAGEBOX(cMessage,4+32,"Send Email") = 7 &&No
				lSendEmail = .F.
			
				IF NOT EMPTY(cEmail)
					cMessage = "Do you want to send an Email to "+ALLTRIM(cEmail)+"? (Y)"
					IF MESSAGEBOX(cMessage,4+32,"Send Email") = 6 &&yes
						lSendEmail = .T.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		
		IF lSendEmail &&Skip if allready selected not to email
			IF EMPTY(cQouteEmail)
		
				IF EMPTY(cEmail)
					MESSAGEBOX("No Email Address"+CHR(13)+"Enter the Email in the Qoute"+CHR(13)+"or Bill To address Tab",0,"Cannot Email!")
					lSendEmail = .F.
				ELSE
					IF MESSAGEBOX("Do you want to send an Email to "+ALLTRIM(cContact)+CHR(13)+cEmail+"?" ,4+32,"Send Email") = 6
						lSendEmail = .T.
					ENDIF
				ENDIF
				cQouteEmail = cEmail 
				
			ENDIF
		ENDIF
		
		IF lSendEmail 
			PRIVATE cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, cNewPDFName
			
			IF EMPTY(cHomeSalesp)
				cHomeSalesp = SalesQuote.SalesP
				WAIT WINDOW "SalesP was set to '"+cHomeSalesp+"'." NOWAIT
			ENDIF
		
			cFileName = EmailFileName("HPA_SO.PDF")	
		
			cEmailTo	= cQouteEmail 
			cEmailFrom	= SalesPEmail(SalesQuote.SalesP)
			cNewPDFName	= "HPA_Sales_Order_"+ALLTRIM(STR( ThisForm.SalesNum ))+".pdf"
			cSubject	= "Sales Order #"+ALLTRIM(STR( ThisForm.SalesNum ))+" Confirmation from High Performance Alloys"
			cMessage	= ""
			
		
		
			SELECT SalesQuote
			GO TOP IN SalesQuote
		
			DO WHILE FILE(cFileName)
				nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
				IF nMess = 7 &&No
					DELETE FILE (cFileName)
				ENDIF
			ENDDO
			
			loListener = NEWOBJECT("Listener", "Libs\Listener.VCX")	
					
			IF TYPE('loListener') = 'O'
				*-- Turn off UI feedback and user prompts at end of run
				loListener.QUIETMODE = .T.
				PRIVATE lcOutPutFileName, lcOutPutFilePath 
				lcOutPutFileName = JUSTSTEM(cFileName)
				lcOutPutFilePath = JUSTPATH(cFileName)
		
				IF NOT "FRX2ANY" $ SET("CLASSLIB")
					SET CLASSLIB TO 'LIBS\FRX2Any' ADDITIVE 
				ENDIF
		
				loListener.oFRX2Any = CREATEOBJECT('FRX2Any.PDFFile')
				
				IF TYPE('loListener.oFRX2Any') = 'O'
					loListener.oFRX2Any.UNLOCK('xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx')
					loListener.oFRX2Any.cExportFileName = lcOutPutFileName
					loListener.oFRX2Any.cSaveFolder     = lcOutPutFilePath
					loListener.oFRX2Any.nOutPutType     = 4 &&cnOUTPUT_FILE
									
					ThisForm.AlwaysOnBottom = .T.
					ThisForm.Visible = .F.
					SELECT SalesQuote
					IF FILE('\reports\ConfSalesOrder.FRX')
						REPORT FORM \reports\ConfSalesOrder Object loListener
					ELSE
						IF FILE('reports\ConfSalesOrder.FRX')
							REPORT FORM reports\ConfSalesOrder Object loListener
						ELSE
							WAIT WINDOW "Report form '\reports\ConfSalesOrder' not found" NOWAIT
						ENDIF
					ENDIF
					ThisForm.Visible = .T.
					ThisForm.AlwaysOnBottom = .F.
					ThisForm.AlwaysOnTop = .T.
					
					WAIT WINDOW "Making PDF" TIMEOUT 1	
					PRIVATE nCount
					nCount = 0
					DO WHILE NOT FILE(cFileName) AND nCount < 3
						WAIT WINDOW "Waiting for file:"+cFileName+" to be made." TIMEOUT 1
						nCount = nCount + 1
					ENDDO
		
					SET PRINTER OFF
					SET PRINTER TO DEFAULT
					GO TOP IN SalesQuote
					
					cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisForm.nConnHandle, cNewPDFName )
				
					DO CASE
					CASE "Mail queued" $ cAns
						WAIT WINDOW "Mail queued." NOWAIT
						TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" confirmation was Emailed to ("+cQouteEmail+") on ("+DTOC(DATE())+")"+" frmEdt.cmdFaxConfSO.Click()")
						Save_Sales_Status( ThisForm.SalesNum, 'Email', 'Email Sales Order Confirmation', ThisForm.nConnHandle )
					CASE NOT EMPTY(cAns)
						MESSAGEBOX( cANS,0,"SQL Returned Message!")
					OTHERWISE
						WAIT WINDOW "Email Complete" NOWAIT
						TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" confirmation was Emailed to ("+cQouteEmail+") on ("+DTOC(DATE())+")"+" frmEdt.cmdFaxConfSO.Click()")
						Save_Sales_Status( ThisForm.SalesNum, 'Email', 'Email Sales Order Confirmation', ThisForm.nConnHandle )
					ENDCASE
				ENDIF
			ENDIF
		ENDIF
		***********************************************
		
		ThisForm.pf.pgOrder.txtItem.Refresh()
		ThisForm.pf.pgQuote.txtItem.Refresh()
		*ThisForm.pf.pgQA.txtItem.Refresh()
		
		THISFORM.pf.pgQuote.txtItemSale.Refresh()
		THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
		GO TOP IN SalesQuote
		ThisForm.cmdTop.Click()
		
		IF USED('SoldAddr')
			USE IN SoldAddr
		ENDIF
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		IF USED('Sales_No')
			USE IN Sales_No
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.cmdNext.Click
		IF THISFORM.pf.ACTIVEPAGE = 1 OR THISFORM.pf.ACTIVEPAGE = 2 OR THISFORM.pf.ACTIVEPAGE = 6
		
			SELECT SalesQuote
			IF !EOF()
				SKIP 1 IN SalesQuote
			ENDIF
			IF EOF()
				WAIT WINDOW 'End of File' NOWAIT
				GO BOTTOM IN SalesQuote
			ENDIF
			
			THISFORM.ItemNumber = SalesQuote.ITEM_A
			THISFORM.REFRESH
			
			THISFORM.pf.pgOrder.txtItem.REFRESH()
			THISFORM.pf.pgQuote.txtItem.REFRESH()
			*ThisForm.pf.pgQA.txtItem.Refresh()
			
			THISFORM.pf.pgQuote.txtItemSale.Refresh()
			THISFORM.pf.pgQuote.txtItemCost.Refresh()
			
			IF THISFORM.pf.ACTIVEPAGE = 1
				ThisForm.ShowSalesQuote_Order()
			ENDIF
			ThisForm.Show_Po()
			THISFORM.pgRefresh()
			ThisForm.NewPage = .T.
		ELSE
			WAIT WINDOW 'Cannot change Sales Order Items on this tab.' NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE frmEdt.cmdPrev.Click
		IF THISFORM.pf.ACTIVEPAGE = 1 OR THISFORM.pf.ACTIVEPAGE = 2 OR THISFORM.pf.ACTIVEPAGE = 6
		*ACTIVEPAGE 1 is pgOrder, 2 is pgQuote, 6 is pg_PO
		
			SELECT SalesQuote
			IF !BOF()
				SKIP -1 IN SalesQuote
			ENDIF
			IF BOF()
				WAIT WINDOW 'Top of file' NOWAIT
				GO TOP IN SalesQuote
			ENDIF
			
			THISFORM.ItemNumber = SalesQuote.ITEM_A
			THISFORM.REFRESH
			THISFORM.pf.pgOrder.txtItem.REFRESH()
			THISFORM.pf.pgQuote.txtItem.REFRESH()
			*ThisForm.pf.pgQA.txtItem.Refresh()
			
			THISFORM.pf.pgQuote.txtItemSale.Refresh()
			THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
			ThisForm.RefreshQuotesForms(SalesQuote.Form)
			
			THISFORM.Show_Po()	
			THISFORM.pgRefresh()
			ThisForm.NewPage = .T.
		ELSE
			WAIT WINDOW 'Cannot change Sales Order Items on this tab.' NOWAIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEdt.cmdPrintAll.Click
		
		IF NOT ThisForm.CheckData4Save()
			RETURN .F.
		ENDIF
		
		PRIVATE lPrint 
		lPrint = .T.
		PRIVATE nAmendment 
		nAmendment = 0
		
		PRIVATE cSQLu, cSQL, nSQLEXEC 
		************
		*Check For Extension page needs
		
		IF USED('tmpSOitem_Len')
			USE IN tmpSOitem_Len
		ENDIF
		
		SELECT 0
		cSQL = "SELECT SOitem, LEN( CAST(Comments AS CHAR(1024)) ) AS Lngth "
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SalesNum = "+STR(ThisForm.SalesNum)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem_Len')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem_Len')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitem_Len')
		ENDIF
		
		
		IF USED('tmpSOitem_Len')
			SELECT tmpSOitem_Len
			COPY TO ARRAY aSOitem_Len
			USE IN tmpSOitem_Len
		ELSE
			DECLARE aSOitem_Len(1,2)
			aSOitem_Len(1,1) = ThisForm.SalesNum
			aSOitem_Len(1,2) = " "
		ENDIF
		
		*************
		
		nAmendment = PrepareSQLnum(ThisForm.pf.pgBillTo.txtAmendment.Value,'Amendment',2,0)
		IF EMPTY(nAmendment)
			nAmendment = 0
		ENDIF
		IF Sales_No_Changing(ThisForm.SalesNum,ThisForm.nConnHandle)   	&&If SO was Edited then SO was Changing
			nAmendment = nAmendment + 1									&& otherwise a reprint would not an Admendment!
		ENDIF
		
		IF ThisForm.nPrintedSO = 1
				
			IF MESSAGEBOX("This Order has allready been Printed."+CHR(13)+;
				"If you reprint this Order,"+CHR(13)+;
				"the previous paperwork must be destroyed"+CHR(13)+;
				"so this Order does not get duplicated."+CHR(13)+CHR(13)+;
				"The SO amendment number will be incremented to "+ALLTRIM(STR(nAmendment+1))+"."+CHR(13)+CHR(13)+;
				"Do you wish to reprint this Sales Order?";
				,4+32,"Print Again?") = 6
				
				lPrint = .T.
				nAmendment = nAmendment + 1	&&Because there is a reprint, there is a new Rev!
				
				*Track Usage
				TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" reprint warning display, Reprinted!" +" frmEdt.cmdPrintAll.Click()" )
				Save_Sales_Status( ThisForm.SalesNum, 'Reprint', 'Reprint Sales Order amendment:'+ALLTRIM(STR(nAmendment)), ThisForm.nConnHandle )
		
				ThisForm.pf.pgBillTo.txtAmendment.Value = nAmendment 
				ThisForm.pf.pgQA.txtVersion.Value = nAmendment
				ThisForm.pf.pgBillTo.txtAmendment.Visible = .T.
				ThisForm.pf.pgBillTo.lblAmendment.Visible = .T.
				
				TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" was amended to "+ALLTRIM(STR(nAmendment))+"."+" frmEdt.cmdPrintPO.Click()")
		
			ELSE
				lPrint = .F.
			ENDIF
		ENDIF
		
		IF lPrint 
			cSQLu = "UPDATE dbo.Sales_No SET "
			cSQLu = cSQLu + " PrintedSO='1'"
			cSQLu = cSQLu + ", Amendment="+ALLTRIM(STR( nAmendment ))
			cSQLu = cSQLu + ", ShopRecv='0'"
			cSQLu = cSQLu + ", Changing='0'"
			cSQLu = cSQLu + " WHERE SalesNum = "+STR(ThisForm.SalesNum)
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLU)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
			ELSE
				ThisForm.nPrintedSO = 1
				ThisForm.pf.pgBillTo.txtAmendment.Value = nAmendment 
				ThisForm.pf.pgQA.txtVersion.Value = nAmendment
				ThisForm.pf.pgBillTo.txtAmendment.Visible = .T.
				ThisForm.pf.pgBillTo.lblAmendment.Visible = .T.
			ENDIF
		
			
			*IF ThisForm.CheckData4Save()
			ThisForm.SaveSO()
			
			****************************************************
			*Track Usage
			TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" was printed in complete form on ("+DTOC(DATE())+")" +" frmEdt.cmdPrintPO.Click()" )
			Save_Sales_Status( ThisForm.SalesNum, 'Print', 'Print Sales Order', ThisForm.nConnHandle )
			
		
			IF FILE('REPORTS\SalesOrder02.FRX')
				RELEASE gShippingCopy
				PUBLIC gShippingCopy
				gShippingCopy= .F.
				
				PRIVATE cTrt_Lumber_Co
				IF USED('cntSales_No')
					USE IN cntSales_No
				ENDIF
				SELECT 0
				
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Sales_No "
				cSQL = cSQL + " WHERE SalesNum = "+STR(ThisForm.SalesNum)
				cSQL = cSQL + " AND trt_lumber = 1"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_No')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSales_No')
				ENDIF
				
				IF cntSales_No.cnt > 0
					cTrt_Lumber_Co = ThisForm.Treated_Lumber_Country()
					IF NOT EMPTY(cTrt_Lumber_Co)
						glTrt_lumber = .T.
					ELSE
						glTrt_lumber = .F.
					ENDIF	
				ELSE
					glTrt_lumber = .F.
				ENDIF
				
				IF USED("cntSales_No")
					USE IN cntSales_No
				ENDIF
		
		
				SELECT SalesQuote
				GO TOP IN SalesQuote
				
				**********************
				IF NOT ThisForm.SeekSoldCodeinSoldAddr(ThisForm.SoldAddr)
					MESSAGEBOX("No or bad 'Sold To Address'",0+16,"Could not get Address loaded.")
				ENDIF
				*********************	
				IF NOT ThisForm.SeekShipCodeinShipAddr(ThisForm.ShipAddr)
					MESSAGEBOX("No or bad 'Ship To Address'",0+16,"Could not get Address loaded.")
				ENDIF
				*********************	
				ThisForm.SeekSalesNuminSales_No(ThisForm.SalesNum)	
				*********************
				ThisForm.SeekStartingStockSalesNum(ThisForm.SalesNum)	
				*********************
				*ThisForm.SeekStartingStock(SalesQuote.ID)	
				*********************
				
				SET PRINTER OFF
				SET PRINTER TO DEFAULT
				
		*		PRIVATE nAnsPrint
				
		*		nAnsPrint= MESSAGEBOX("Do you want to print this order at Tipton?",4+32,"Printer 'Canon MF5700 Series'")
		*		IF nAnsPrint= 6
		*			SetPrinterTo("TIPTONSHOP")
		*		ENDIF
				
				SELECT SalesQuote
				WAIT WINDOW "Print SalesOrder to:" NOWAIT
				REPORT FORM reports\SalesOrder02 NOCONSOLE TO PRINTER PROMPT
						
				****
		
				GO TOP IN SalesQuote
				PRIVATE nItem
				IF FILE('REPORTS\WorkOrder_Ext.FRX')
		*			IF nAnsPrint= 6
		*				SetPrinterTo("TIPTONSHOP")
		*			ENDIF
					***********************************
					
					PRIVATE nLenaSOitem
					nLenaSOitem = ALEN(aSOitem_Len,1)
					IF nLenaSOitem > 0
						*Loop thru Items
						FOR nItem = 1 TO nLenaSOitem
							WAIT WINDOW "Print WorkOrder sheet to:" NOWAIT
							REPORT FORM reports\WorkOrder06 NOCONSOLE TO PRINTER PROMPT FOR SalesQuote.SoItem_A = aSOitem_Len(nItem,1)
					
							WAIT WINDOW "Work Order Page:"+ALLTRIM(STR(nItem)) TIMEOUT 4
									
							**Only print the Tipton Process' to Rainier
							*IF SalesQuote.GFM OR SalesQuote.Roll OR SalesQuote.Press OR SalesQuote.CG OR SalesQuote.Mach
							*	REPORT FORM reports\WorkOrder-Rainier NOCONSOLE TO PRINTER FOR SalesQuote.SoItem_A = aSOitem_Len(nItem,1)
							*ENDIF
							
							
							
							*Check For Extension page needs
							lWOext = .F.
							IF USED('tmpSOitem_Len2')
								USE IN tmpSOitem_Len2
							ENDIF
		
							SELECT 0
							cSQL = "SELECT Comments "
							cSQL = cSQL + " FROM dbo.AllQuotes "
							cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+aSOitem_Len(nItem,1)+"')"
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem_Len2')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem_Len2')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitem_Len2')
							ENDIF
		
		
							IF USED('tmpSOitem_Len2')
								IF LinesToPrint(tmpSOitem_Len2.Comments,50) >= 5
									lWOext = .T.
								ENDIF
								USE IN tmpSOitem_Len2
							ENDIF
							
							SELECT SalesQuote
							IF lWOext 
								WAIT WINDOW "Print WorkOrder EXTRA sheet to:" NOWAIT
								REPORT FORM reports\WorkOrder_Ext NOCONSOLE TO PRINTER PROMPT FOR SalesQuote.SoItem_A = aSOitem_Len(nItem,1)
							ENDIF
						NEXT nItem
					ENDIF
				ENDIF
				*****
				
				WAIT WINDOW "Print Shipping version of SO to:" NOWAIT
				gShippingCopy= .T.
				GO TOP IN SalesQuote
				REPORT FORM reports\SalesOrder02 NOCONSOLE TO PRINTER PROMPT
				SET PRINTER TO DEFAULT
				RELEASE gShippingCopy
				
				Check_SO_Terms(SalesQuote.SalesNum,ThisForm.nConnHandle)
				
				WAIT WINDOW 'PRINTED' NOWAIT
			ELSE
				WAIT WINDOW "Report form 'REPORTS\SalesOrder02.FRX' not found." NOWAIT
			ENDIF
		
			IF glTrt_lumber
				IF NOT EMPTY(cTrt_Lumber_Co)
		*			IF nAnsPrint= 6
		*				SetPrinterTo("TIPTONSHOP")
		*			ENDIF
					
					IF NOT USED('HardWood')
						ThisForm.LoadHardwood()
					ENDIF
					SELECT HardWood
					
					WAIT WINDOW "Print Hard Wood statement to:" NOWAIT
					REPORT FORM reports\HardWood FOR Country = cTrt_Lumber_Co NOCONSOLE TO PRINTER PROMPT
					WAIT WINDOW "Hard Wood Packaging Statement printed." NOWAIT
					
				ELSE
					MESSAGEBOX("Hard Wood Packaging Statement did not print for this Counrty",0,"Print Error")
				ENDIF
			ENDIF
		
			SELECT SalesQuote
		
			GO TOP IN SalesQuote
		
			ThisForm.pf.pgOrder.txtItem.Refresh()
			ThisForm.pf.pgQuote.txtItem.Refresh()
			*ThisForm.pf.pgQA.txtItem.Refresh()
			
			THISFORM.pf.pgQuote.txtItemSale.Refresh()
			THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
			ThisForm.cmdTop.Click()
		ENDIF &&lPrint 
		
		
		IF USED( 'Sales_No' )
			USE IN Sales_No
		ENDIF
				
		IF USED( 'SoldAddr' )
			USE IN SoldAddr
		ENDIF
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		
		IF USED( 'StartingStock' )
			USE IN StartingStock
		ENDIF
		
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		
		
		***Rev
		IF Have_Sales_No_Rev( ThisForm.Salesnum,ThisForm.nConnHandle )
			IF MESSAGEBOX("There are Revisions to this Sales Order"+CHR(13)+"Do you want to print the current Revision Report now ?",4+32,"Print Revision Report now?") = 6
				IF NOT USED('tmpSales_No_Rev')
					ThisForm.Show_QA()
				ENDIF
				
				IF USED('tmpSales_No_Rev')
					SELECT tmpSales_No_Rev
					IF FILE('REPORTS\Sales_No_Rev.FRX')
						REPORT FORM Reports\Sales_No_Rev NOCONSOLE PREVIEW
					ELSE
						MESSAGEBOX("Could not find Report Form",0+16,"File error")
					ENDIF
				ELSE
					MESSAGEBOX("Could open table tmpSales_No_Rev.",0+16,"File error")
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.cmdPrintSO.Click
		IF FILE('REPORTS\SalesOrder02.FRX')
			SELECT SalesQuote
			GO TOP IN SalesQuote
			
			**********************
			IF NOT ThisForm.SeekSoldCodeinSoldAddr(ThisForm.SoldAddr)
				MESSAGEBOX("No or bad 'Sold Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			IF NOT ThisForm.SeekShipCodeinShipAddr(ThisForm.ShipAddr)
				MESSAGEBOX("No or bad 'Ship Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			ThisForm.SeekSalesNuminSales_No(SalesQuote.SalesNum)	
			**********************
			
			
			RELEASE gShippingCopy
			PUBLIC gShippingCopy
			gShippingCopy= .F.
			
			SELECT SalesQuote
			ThisForm.AlwaysOnBottom = .T.
			ThisForm.AlwaysOnTop = .F.
			SET PRINTER TO DEFAULT
			WAIT WINDOW "Print SalesOrder to:" NOWAIT
			REPORT FORM reports\SalesOrder02 NOCONSOLE TO PRINTER PROMPT
			SET PRINTER TO DEFAULT
			ThisForm.AlwaysOnBottom = .F.
			ThisForm.AlwaysOnTop = .T.
		
			WAIT WINDOW 'PRINTED' NOWAIT
			
			RELEASE gShippingCopy
			
			*Track Usage
			TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" was printed as just a SO page on ("+DTOC(DATE())+")"+" frmEdt.cmdPrintSO.Click()" )
		
		ELSE
			WAIT WINDOW "Report form 'REPORTS\SalesOrder02.FRX' not found." NOWAIT
		ENDIF
		
		ThisForm.pf.pgOrder.txtItem.Refresh()
		ThisForm.pf.pgQuote.txtItem.Refresh()
		*ThisForm.pf.pgQA.txtItem.Refresh()
			
		THISFORM.pf.pgQuote.txtItemSale.Refresh()
		THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
		WAIT CLEAR
		
		ThisForm.cmdTop.Click()
		
		
		IF USED( 'SoldAddr' )
			USE IN SoldAddr
		ENDIF
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		IF USED( 'Sales_No' )
			USE IN Sales_No
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.cmdPrintWO.Click
		PRIVATE cSoItem 
		cSoItem = SalesQuote.SoItem_A
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE lWOext
		lWOext = .F.
		
		*******************************
		*Check For Extension page needs
		
		IF USED('tmpSOitem_Len')
			USE IN tmpSOitem_Len
		ENDIF
		
		SELECT 0
		cSQL = "SELECT Comments "
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSoItem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem_Len')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem_Len')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitem_Len')
		ENDIF
		
		
		IF USED('tmpSOitem_Len')
			IF LinesToPrint(tmpSOitem_Len.Comments,50) > 5
				lWOext = .T.
			ENDIF
			USE IN tmpSOitem_Len
		ENDIF
		
		IF FILE('REPORTS\WorkOrder06.FRX')
		
			IF NOT USED('HardWood')
				*USE HPA!HardWood SHARED IN 0
				ThisForm.LoadHardwood()
			
			ENDIF
		
			IF USED('cntSales_No')
				USE IN cntSales_No
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Sales_No "
			cSQL = cSQL + " WHERE SalesNum = "+STR(ThisForm.SalesNum)
			cSQL = cSQL + " AND trt_lumber = 0"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_No')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSales_No')
			ENDIF
			
			PRIVATE cTrt_Lumber_Co
			IF cntSales_No.cnt > 0
				cTrt_Lumber_Co = ThisForm.Treated_Lumber_Country()
				IF NOT EMPTY(cTrt_Lumber_Co)
					glTrt_lumber = .T.
				ELSE
					glTrt_lumber = .F.
				ENDIF
			ELSE
				glTrt_lumber = .F.
			ENDIF
			IF USED('cntSales_No')
				USE IN cntSales_No
			ENDIF
			
			*********************	
			ThisForm.SeekSalesNuminSales_No(SalesQuote.SalesNum)	
			*********************
			ThisForm.SeekStartingStock(SalesQuote.ID)	
			*********************
			
			ThisForm.AlwaysOnBottom = .T.
			SELECT SalesQuote
		
			SET PRINTER TO DEFAULT
			WAIT WINDOW "Print WorkOrder sheet to:" NOWAIT
			REPORT FORM reports\WorkOrder06 NOCONSOLE TO PRINTER PROMPT FOR SalesQuote.SoItem_A = cSoItem 
			WAIT WINDOW 'Printed WO' NOWAIT
			ThisForm.AlwaysOnBottom = .F.
			ThisForm.AlwaysOnTop = .T.
			glTrt_lumber = .F.	
			
			*Track Usage
			TrackMess("SO item "+ALLTRIM(cSoItem)+" was printed as just a WO on ("+DTOC(DATE())+")"+" frmEdt.cmdPrintWO.Click()" )
		
			
			IF glTrt_lumber
			  IF MESSAGEBOX("Do you wish to Print a 'Hard Wood Packaging Statement'?",4,"Print Statement?")=6
				IF NOT EMPTY(cTrt_Lumber_Co)
					WAIT WINDOW "Print Hard Wood statement to:" NOWAIT
					REPORT FORM reports\HardWood FOR Country = cTrt_Lumber_Co NOCONSOLE TO PRINTER PROMPT
					WAIT WINDOW "Hard Wood Packaging Statement printed." NOWAIT
				ELSE
					MESSAGEBOX("Hard Wood Packaging Statement did not print for this Counrty",0,"Print Error")
				ENDIF
			  ENDIF
			ENDIF
			
			IF lWOext 
				WAIT WINDOW "Print WorkOrder EXTRA sheet to:" NOWAIT
				REPORT FORM reports\WorkOrder_Ext NOCONSOLE TO PRINTER PROMPT FOR SalesQuote.SoItem_A = cSoItem 
				WAIT WINDOW 'Printed WO Extension page' NOWAIT
			ENDIF
			
			IF USED('StartingStock')
				USE IN StartingStock
			ENDIF
		ELSE
			WAIT WINDOW 'Report form not found' NOWAIT
		ENDIF
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		ThisForm.pf.pgOrder.txtItem.Refresh()
		ThisForm.pf.pgQuote.txtItem.Refresh()
		*ThisForm.pf.pgQA.txtItem.Refresh()
		
		THISFORM.pf.pgQuote.txtItemSale.Refresh()
		THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
		ThisForm.cmdTop.Click()
	ENDPROC

	PROCEDURE frmEdt.cmdPrintWOExt.Click
		PRIVATE cSoItem 
		cSoItem = SalesQuote.SoItem_A
		
		PRIVATE cSQL, nSQLEXEC
		
		
		
		*********************	
		ThisForm.SeekSalesNuminSales_No(SalesQuote.SalesNum)	
		*********************
		ThisForm.SeekStartingStock(SalesQuote.ID)	
		*********************
		
		ThisForm.AlwaysOnBottom = .T.
		SELECT SalesQuote
		
		SET PRINTER TO DEFAULT
		*	REPORT FORM reports\WorkOrder06 NOCONSOLE TO PRINTER PROMPT FOR SalesQuote.SoItem_A = cSoItem 
		WAIT WINDOW "Print WorkOrder EXTRA sheet to:" NOWAIT
		REPORT FORM reports\WorkOrder_Ext NOCONSOLE TO PRINTER PROMPT FOR SalesQuote.SoItem_A = cSoItem 
		
		WAIT WINDOW 'Printed WO Extension page' NOWAIT
		ThisForm.AlwaysOnBottom = .F.
		ThisForm.AlwaysOnTop = .T.
		glTrt_lumber = .F.	
		
		*Track Usage
		TrackMess("SO item "+ALLTRIM(cSoItem)+" was printed as just a WO EXTENSION on ("+DTOC(DATE())+")"+" frmEdt.cmdPrintWOExt.Click()")
		
		
		
		IF USED('StartingStock')
			USE IN StartingStock
		ENDIF
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		ThisForm.pf.pgOrder.txtItem.Refresh()
		ThisForm.pf.pgQuote.txtItem.Refresh()
		*ThisForm.pf.pgQA.txtItem.Refresh()
		
		THISFORM.pf.pgQuote.txtItemSale.Refresh()
		THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
		ThisForm.cmdTop.Click()
	ENDPROC

	PROCEDURE frmEdt.cmdProforma.Click
		
		THISFORM.cmdEdit.CLICK &&Save
		
		PRIVATE printfax,pageno,plineno,Q_faxnm ,qrfaxnum, ckoutput,m.sub ,m.v7,m.rcc,CNT,crecnum
		
		CLEAR TYPEAHEAD
		*WAIT WINDOW "Do you want to Preview / Print?(Y)" TO BLANK
		*IF UPPER(BLANK) = "Y"
		IF MESSAGEBOX("Do you want to Preview or Print?",4+32) = 6
		
			SELECT SalesQuote
			GO TOP IN SalesQuote
		
			**********************
			IF NOT ThisForm.SeekSoldCodeinSoldAddr(ThisForm.SoldAddr)
				MESSAGEBOX("No or bad 'Sold Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			IF NOT ThisForm.SeekShipCodeinShipAddr(ThisForm.ShipAddr)
				MESSAGEBOX("No or bad 'Ship Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			ThisForm.SeekSalesNuminSales_No(SalesQuote.SalesNum)	
			**********************
		
		
			ThisForm.AlwaysOnTop = .F.
			ThisForm.AlwaysOnBottom = .T.
			ThisForm.Visible = .F.
			SELECT SalesQuote
			GO TOP
			IF FILE('Reports\Proforma09.FRX')
				REPORT FORM reports\Proforma09 TO PRINTER PREVIEW IN SCREEN
			ELSE
				IF FILE('\Reports\Proforma09.FRX')
					REPORT FORM \reports\Proforma09 TO PRINTER PREVIEW IN SCREEN
				ELSE
					WAIT WINDOW "Report form 'reports\Proforma09' not found" TIMEOUT 4
				ENDIF
			ENDIF
			ThisForm.Visible = .T.
			ThisForm.AlwaysOnBottom = .F.
			ThisForm.AlwaysOnTop = .T.
			GO TOP IN SalesQuote
			
			TrackMess("Proforma "+ALLTRIM(STR(ThisForm.SalesNum))+" was printed on ("+DTOC(DATE())+")"+" frmEdt.cmdProforma.Click()")
			Save_Sales_Status( ThisForm.SalesNum, 'PrintPro', 'Print Proforma', ThisForm.nConnHandle )
		
		ENDIF
		
		CLEAR TYPEAHEAD
		*!*	IF MESSAGEBOX("Do you want to FAX?",4+32) = 6
		*!*		*MAKE SURE WINFAX IS known as a PRINTER
		*!*		nPrinters=APRINTERS(aaprinters)
		*!*		lWinFax = .F.
		*!*		FOR CT = 1 TO nPrinters
		*!*			IF aaprinters(CT,1)="WinFax"
		*!*				lWinFax = .T.
		*!*			ENDIF
		*!*		NEXT CT
		*!*		IF !lWinFax
		*!*			IF MESSAGEBOX("Did not find WinFax in list of printers."+CHR(13)+"Press 'Yes' to Abort"+CHR(13)+"'No' to attempt." ,4+16,"WinFax not a Print Device") = 6
		*!*				RETURN .F.
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		PRIVATE cFaxB, cFaxS, cFaxQ 
		*!*		cFaxB = ALLTRIM(ThisForm.pf.pgBillTo.txtFax.Value)
		*!*		cFaxS = ALLTRIM(ThisForm.pf.pgShipTo.txtFax.Value)
		*!*		cFaxQ = FaxProper( SalesQuote.Fax, SalesQuote.CountryC )
		
		*!*		DO FORM Forms\FaxNumber WITH cFaxB, cFaxS, cFaxQ, SalesQuote.Company,"FAX" TO Q_Faxnm
		
		*!*		IF EMPTY(Q_faxnm)
		*!*			DO FORM Forms\GetNumber WITH SalesQuote.Company,"FAX" TO Q_faxnm
		*!*		ENDIF
		
		*!*		IF EMPTY(Q_faxnm)
		*!*			MESSAGEBOX("No Fax number")
		*!*			RETURN .F.
		*!*		ENDIF
		
		*!*		PRIVATE oWFSend
		*!*		* Set the printer to WinFax to fax a report
		*!*		* if printer "WinFax" does not exist then they don't have
		*!*		* WinFax on the PC.  If it was renamed then tough.
		*!*		SET PRINTER TO NAME 'WinFax'
		*!*		oWFSend = CREATEOBJECT("WinFax.SDKSend")
		*!*		oWFSend.SetClientID( SalesQuote.SalesP )
		*!*		oWFSend.EnableBillingCodeKeyWords (0)  &&0=disabled
		*!*		oWFSend.SetUseCover (0)
		*!*		oWFSend.SetQuickCover (0)
		*!*		oWFSend.SetCoverFile ("CoverSheet")
		*!*		IF .F.
		*!*			oWFSend.SetCoverText ("CoverText")
		*!*		ENDIF
		*!*		oWFSend.SetResolution (1)
		*!*		oWFSend.SetDeleteAfterSend (0)  && set to 0 to not delete
		*!*		oWFSend.ShowCallProgess (1)
		*!*		oWFSend.ShowSendScreen (0)
		*!*		oWFSend.SetNumber(Q_faxnm)
		*!*		oWFSend.SetSubject("SalesOrder")
		*!*		oWFSend.SetCompany(SalesQuote.company)
		*!*		oWFSend.SetTo(SalesQuote.NAME)
		*!*		oWFSend.AddRecipient
		*!*		oWFSend.SetPrintFromApp(1)
		*!*		oWFSend.SEND (1)
		*!*		* SDK manual says usage is strongly recommended.
		*!*		oWFSend.LeaveRunning()
		
		
		
		*!*		SELECT SalesQuote
		*!*		GO TOP IN SalesQuote
		*!*		
		
		*!*		IF USED( 'SoldAddr' )
		*!*			USE IN SoldAddr
		*!*		ENDIF
		*!*		SELECT 0
		
		*!*		PRIVATE cSQL, nSQLEXEC
		*!*		cSQL = "SELECT * FROM dbo.SoldAddr"
		*!*		cSQL = cSQL + " WHERE SoldCode = "+STR(ThisForm.SoldAddr)
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr')
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
		*!*		ENDIF
		*!*		
		*!*	 	IF USED( 'ShipAddr' )
		*!*			USE IN ShipAddr
		*!*		ENDIF
		
		*!*		cSQL = "SELECT * FROM dbo.ShipAddr "
		*!*		cSQL = cSQL + " WHERE ShipCode = "+STR(ThisForm.ShipAddr)
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		*!*		ENDIF
		
		*!*		*********************	
		*!*		IF USED( 'Sales_No' )
		*!*			USE IN Sales_No
		*!*		ENDIF
		*!*		SELECT 0
		
		*!*		cSQL = "SELECT * FROM dbo.Sales_No"
		*!*		cSQL = cSQL + " WHERE SalesNum = "+STR(SalesQuote.SalesNum)
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Sales_No')
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Sales_No')
		*!*		ENDIF
		*!*		**********************
		*!*		
		*!*		SELECT SalesQuote
		*!*		GO TOP
		*!*		IF FILE('Reports\Proforma09.FRX')
		*!*			REPORT FORM Reports\Proforma09 NOCONSOLE TO PRINTER
		*!*		ELSE
		*!*			IF FILE('\Reports\Proforma09.FRX')
		*!*				REPORT FORM \Reports\Proforma09 NOCONSOLE TO PRINTER
		*!*			ELSE
		*!*				WAIT WINDOW "Report form 'Reports\Proforma09' not found" NOWAIT
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		GO TOP IN SalesQuote
		*!*		
		*!*		TrackMess("Proforma "+ALLTRIM(STR(ThisForm.SalesNum))+" was faxed to ("+Q_Faxnm+") on ("+DTOC(DATE())+")"+" frmEdt.cmdProforma.Click()")
		*!*		Save_Sales_Status( ThisForm.SalesNum, 'FaxPro', 'Fax Proforma', ThisForm.nConnHandle )
		*!*		
		
		
		*!*		**************************************
		*!*		*
		*!*		WAIT WINDOW NOWAIT 'Press Esc if Fax locks.'
		*!*		DO WHILE oWFSend.IsEntryIDReady(0) <> 1
		*!*			* Use this loop to make sure WinFax is ready for
		*!*			* the next fax before you exit this procedure.
		*!*			* Esc allows the user to exit if something hangs.
		*!*			IF LASTKEY() = 27
		*!*				EXIT
		*!*			ENDIF
		*!*		ENDDO
		*!*		WAIT CLEAR
		*!*		*
		*!*		* get the messageid for the conformation.
		*!*		mMessageId = oWFSend.GetEntryID(0)
		*!*		*
		*!*		***************************************************************
		*!*		*
		*!*		mError = oWFSend.GetLastError()
		*!*		IF mError <> 0
		*!*			=MESSAGEBOX('An error occured sending the fax.',48, 'Fax')
		*!*		ENDIF
		*!*		*
		
		*!*		oWFSend.Done()
		*!*		RELEASE oWFSend
		
		*!*		SET PRINTER OFF
		*!*		SET PRINTER TO DEFAULT
		
		*!*		WAIT WINDOW 'Fax routine done' NOWAIT
		*!*	ENDIF
		
		
		CLEAR TYPEAHEAD
		PRIVATE cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, cNewPDFName
		PRIVATE cEmail, cHomeSalesp 
		cHomeSalesp = ""
		
		IF MESSAGEBOX("Do you want to Email?",4+32) = 6
		
			
			cEmail = ALLTRIM(ThisForm.pf.pgBillTo.txtEmail.Value)
			IF EMPTY(cEmail)
				cEmail = ALLTRIM(SalesQuote.Email)
			ENDIF
			IF EMPTY(cEmail)
				cEmail = ALLTRIM(ThisForm.pf.pgShipTo.txtEmail.Value)
			ENDIF
			IF EMPTY(cEmail)
				MESSAGEBOX("Enter the Email in the Bill to Tab",0,"No Email Address")
				RETURN .F.
			ENDIF
			
			cFileName = EmailFileName("HPA_Proforma.PDF")
			cEmailTo	= cEmail
			cEmailFrom	= ALLTRIM(SalesPEmail( SalesQuote.SalesP ))
			cNewPDFName	= "HPA_Proforma_"+ALLTRIM(STR( ThisForm.SalesNum ))+".pdf"
			cSubject	= "Proforma #"+ALLTRIM(STR( ThisForm.SalesNum ))+" from High Performance Alloys"
			cMessage	= ""
		
			**********************
			IF USED( 'SoldAddr' )
				USE IN SoldAddr
			ENDIF
			SELECT 0
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr"
			cSQL = cSQL + " WHERE SoldCode = "+STR(ThisForm.SoldAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
			ENDIF
			
			********************************
			IF USED( 'ShipAddr' )
				USE IN ShipAddr
			ENDIF
			SELECT 0
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(ThisForm.ShipAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
			ENDIF
		
			*********************	
			IF USED( 'Sales_No' )
				USE IN Sales_No
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * FROM dbo.Sales_No"
			cSQL = cSQL + " WHERE SalesNum = "+STR(SalesQuote.SalesNum)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Sales_No')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Sales_No')
			ENDIF
			**********************
		
			DO WHILE FILE(cFileName),
				nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
				IF nMess = 7 &&No
					DELETE FILE (cFileName)
				ENDIF
			ENDDO
			
				
			loListener = NEWOBJECT("Listener", "Libs\Listener.VCX")	
					
			IF TYPE('loListener') = 'O'
				*-- Turn off UI feedback and user prompts at end of run
				loListener.QUIETMODE = .T.
				PRIVATE lcOutPutFileName, lcOutPutFilePath 
				lcOutPutFileName = JUSTSTEM(cFileName)
				lcOutPutFilePath = JUSTPATH(cFileName)
		
				IF NOT "FRX2ANY" $ SET("CLASSLIB")
					SET CLASSLIB TO 'LIBS\FRX2Any' ADDITIVE 
				ENDIF
		
				loListener.oFRX2Any = CREATEOBJECT('FRX2Any.PDFFile')
				
				IF TYPE('loListener.oFRX2Any') = 'O'
					loListener.oFRX2Any.UNLOCK('xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx')
					loListener.oFRX2Any.cExportFileName = lcOutPutFileName
					loListener.oFRX2Any.cSaveFolder     = lcOutPutFilePath
					loListener.oFRX2Any.nOutPutType     = 4 &&cnOUTPUT_FILE
									
					WAIT WINDOW "Making PDF" NOWAIT
					
		
					ThisForm.AlwaysOnBottom = .T.
					ThisForm.Visible = .F.
					SELECT SalesQuote
					GO TOP
					
					IF FILE('Reports\Proforma09.FRX')
						REPORT FORM Reports\Proforma09 Object loListener
					ELSE
						IF FILE('\Reports\Proforma09.FRX')
							REPORT FORM \Reports\Proforma09 Object loListener
						ELSE
							WAIT WINDOW "Report form 'Reports\Proforma09' not found" TIMEOUT 4
						ENDIF
					ENDIF
					
					ThisForm.Visible = .T.
					ThisForm.AlwaysOnBottom = .F.
					ThisForm.AlwaysOnTop = .T.
					
					GO TOP IN SalesQuote
					
					cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisForm.nConnHandle, cNewPDFName)
					
					DO CASE
					CASE "Mail queued" $ cAns
						WAIT WINDOW "Mail queued." NOWAIT
						TrackMess("SO "+ALLTRIM(STR(ThisForm.SalesNum))+" Proforma was Emailed to ("+cEmail+") on ("+DTOC(DATE())+")"+" frmEdt.cmdProforma.Click()")
						Save_Sales_Status( ThisForm.SalesNum, 'EmailPro', 'Email Proforma', ThisForm.nConnHandle )
					CASE NOT EMPTY(cAns)
						MESSAGEBOX( cANS,0,"SQL Returned Message!")
					OTHERWISE
						WAIT WINDOW "Email Complete" NOWAIT
						TrackMess("Proforma "+ALLTRIM(STR(ThisForm.SalesNum))+" was Emailed to ("+cEmail+") on ("+DTOC(DATE())+")"+" frmEdt.cmdProforma.Click()")
						Save_Sales_Status( ThisForm.SalesNum, 'EmailPro', 'Email Proforma', ThisForm.nConnHandle )
					ENDCASE
				ENDIF			
			ENDIF
		ENDIF
		
		GO TOP IN SalesQuote
		
		ThisForm.pf.pgOrder.txtItem.Refresh()
		ThisForm.pf.pgQuote.txtItem.Refresh()
		*ThisForm.pf.pgQA.txtItem.Refresh()
		
		THISFORM.pf.pgQuote.txtItemSale.Refresh()
		THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
		
		ThisForm.cmdTop.Click()
		
		IF USED('SoldAddr')
			USE IN SoldAddr
		ENDIF
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		IF USED('Sales_No')
			USE IN Sales_No
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.cmdTop.Click
		WAIT WINDOW "GO TOP in SalesQuote" NOWAIT
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		
		
		THISFORM.ItemNumber = SalesQuote.Item_A
		
		THISFORM.pf.pgOrder.txtItem.REFRESH()
		THISFORM.pf.pgQuote.txtItem.REFRESH()
		*ThisForm.pf.pgQA.txtItem.Refresh()
			
		THISFORM.pf.pgQuote.txtItemSale.Refresh()
		THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
		
		THISFORM.Show_Po()
		THISFORM.pgRefresh()
		
		
		
	ENDPROC

	PROCEDURE frmEdt.Destroy
		
		RELEASE aShipRoutes
	ENDPROC

	PROCEDURE frmEdt.Init
		PARAMETER nSalesnum, lNoSave
		
		*Do Form EnterOrder WITH 48383, NoSave
		
		PUBLIC glTrt_lumber
		glTrt_lumber = .F.
		
		PRIVATE cSQL,cSQLu, nSQLEXEC
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF	
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		SET PRINTER TO DEFAULT
		
		
		IF NOT TYPE("nSalesnum") = "N"
			=MESSAGEBOX("Enter Salesnumber in your quote page first",16,"Did not find Parameter Sales Number")
			RETURN .F.
		ENDIF
		THISFORM.Salesnum = nSalesnum
		
		IF VARTYPE(lNoSave) = "L"
			IF lNoSave
				ThisForm.cmdEdit.Visible = .F.
			ENDIF
		ENDIF
		
		IF USED("QuotesSO")
			USE IN QuotesSOw
		ENDIF
		IF USED("SalesQuote")
			USE IN SalesQuote
		ENDIF
		
		************************************************************
		WAIT WINDOW "Open SalesQuote" NOWAIT
		
		ThisForm.Refresh_SalesQuote(1)
		*ThisForm.didSOitemUseStock()
		ThisForm.didSOitem_UseStock()
		
		*****************************************************************
		
		SELECT SalesQuote
		IF RECCOUNT('SalesQuote') < 1
			MESSAGEBOX('No Records found!',0,"INIT")
			RETURN
		ENDIF
		
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		
		ThisForm.pf.pgOrder.chkService.Refresh
		ThisForm.pf.pgOrder.chkInv.Refresh
		ThisForm.pf.pgOrder.chkGFM.Refresh
		ThisForm.pf.pgOrder.chkRoll.Refresh
		ThisForm.pf.pgOrder.chkPress.Refresh
		ThisForm.pf.pgOrder.chkMach.Refresh
		ThisForm.pf.pgOrder.chkCg.Refresh
		ThisForm.pf.pgOrder.txtTol.Refresh
		ThisForm.pf.pgOrder.chkPlasma.Refresh
		ThisForm.pf.pgOrder.chkWJet.refresh
		ThisForm.pf.pgOrder.cmbCert.Refresh
		
		IF ISNULL(SalesQuote.ProcLoc)
			IF SalesQuote.Form = '40'
				REPLACE SalesQuote.ProcLoc WITH "W"
			ELSE
				REPLACE SalesQuote.ProcLoc WITH "T"
			ENDIF
		ENDIF
		ThisForm.pf.pgOrder.cmbProcLoc.Refresh
		
		ThisForm.pf.pgOrder.chkCancelItem.Refresh
		
		
		IF VARTYPE(SalesQuote.QA) = "L"
			ThisForm.pf.pgBillTo.chkQA.VALUE = IIF(SalesQuote.QA,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkQA.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.CofC) = "L"
			ThisForm.pf.pgBillTo.chkCofC.VALUE = IIF(SalesQuote.CofC,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkCofC.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.Merc) = "L"
			ThisForm.pf.pgBillTo.chkMercury.VALUE = IIF(SalesQuote.Merc,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkMercury.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pPO) = "L"
			ThisForm.pf.pgBillTo.chkpPO.VALUE = IIF(SalesQuote.pPO,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkpPO.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pPN) = "L"
			ThisForm.pf.pgBillTo.chkpPN.VALUE = IIF(SalesQuote.pPN,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkpPN.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pHeat) = "L"
			ThisForm.pf.pgBillTo.chkpHeat.VALUE = IIF(SalesQuote.pHeat,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkpHeat.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pSpec) = "L"
			ThisForm.pf.pgBillTo.chkpSpec.VALUE = IIF(SalesQuote.pSpec,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkpSpec.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pDesc) = "L"
			ThisForm.pf.pgBillTo.chkpDesc.VALUE = IIF(SalesQuote.pDesc,1,0)
		ELSE
			ThisForm.pf.pgBillTo.chkpDesc.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pOther) = "L"
			ThisForm.pf.pgBillTo.chkpOther.VALUE = IIF(SalesQuote.pOther,1,0)
			ThisForm.pf.pgBillTo.txtOther.VALUE = SalesQuote.Other
		ELSE
			ThisForm.pf.pgBillTo.chkpOther.VALUE = 0
			ThisForm.pf.pgBillTo.txtOther.VALUE = ""
		ENDIF
		
		*SalesQuote.ItemCost
		IF VARTYPE(SalesQuote.ItemCost) = "N"
			ThisForm.pf.pgQuote.txtItemCost.Value = SalesQuote.ItemCost
		ELSE
			ThisForm.pf.pgQuote.txtItemCost.Value = 0
		ENDIF
		IF VARTYPE(SalesQuote.ItemSale) = "N"
			ThisForm.pf.pgQuote.txtItemSale.Value = SalesQuote.ItemSale
		ELSE
			ThisForm.pf.pgQuote.txtItemSale.Value = 0
		ENDIF
		IF VARTYPE(SalesQuote.ShipON) = "L"
			ThisForm.pf.pgQuote.chkShipOn.Value = IIF(SalesQuote.ShipON,1,0)
		ELSE
			ThisForm.pf.pgQuote.chkShipOn.Value = 0
		ENDIF
		*!*	IF SalesQuote.EmailConf
		*!*		THISFORM.pf.pgBillTo.ChkEmail.VALUE = 1
		*!*	ELSE
		*!*		THISFORM.pf.pgBillTo.ChkEmail.VALUE = 0
		*!*	ENDIF
		
		*!*	IF SalesQuote.FaxConf
		*!*		THISFORM.pf.pgBillTo.ChkFax.VALUE = 1
		*!*	ELSE
		*!*		THISFORM.pf.pgBillTo.ChkFax.VALUE = 0
		*!*	ENDIF
		
		ThisForm.SoldAddr = 0
		ThisForm.ShipAddr = 0
		ThisForm.POShipAddr = 0
		
		WAIT WINDOW "Get Ship Route from Sales_No" NOWAIT
		PUBLIC aShipRoutes(1)
		DIMENSION aShipRoutes(1)
		
		*SELECT Sales_No
		*SET ORDER TO TAG UppShipRt
		
		
		IF USED("aSales_No")
			USE IN aSales_No
		ENDIF
		cSQL = "SELECT DISTINCT UPPER(ShipRoute) AS ShipRoute FROM dbo.Sales_No ORDER BY ShipRoute"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSales_No')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSales_No')
		ENDIF
		*SELECT DISTINCT UPPER(ShipRoute) FROM Sales_No INTO ARRAY aShipRoutes
		IF USED('aSales_No')
			SELECT aSales_No
			*COPY TO ARRAY aShipRoutes FIELDS ShipRoute
			SELECT ShipRoute FROM aSales_No INTO ARRAY aShipRoutes
			USE IN aSales_No
		ELSE
			aShipRoutes(1) = ""
		ENDIF
		
		
		WAIT WINDOW "Get from Sales_No" NOWAIT
		
		IF USED("aSalesNum")
			USE IN aSalesNum
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Sales_No WHERE Salesnum = "+STR(nSalesnum)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSalesNum')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSalesNum')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSalesNum')
		ENDIF
		
		
		IF USED('aSalesNum')
			*SalesRep
			IF TYPE("aSalesNum.Instrct") = "C"
				IF ISNULL(aSalesNum.pShipAddr)
					ThisForm.pf.pgShipto.txtInstrct.Value	= ""
				ELSE
					ThisForm.pf.pgShipto.txtInstrct.Value	= aSalesNum.Instrct
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.txtInstrct.Value	= ""
			ENDIF
			
			IF TYPE("aSalesNum.pSoldAddr") = "N"
				IF ISNULL(aSalesNum.pShipAddr)
					ThisForm.SoldAddr = 0
				ELSE
					ThisForm.SoldAddr = aSalesNum.pSoldAddr
				ENDIF
			ELSE
				ThisForm.SoldAddr = 0
			ENDIF
			
			IF TYPE("aSalesNum.pShipAddr") = "N"
				IF ISNULL(aSalesNum.pShipAddr)
					ThisForm.ShipAddr = 0
				ELSE
					ThisForm.ShipAddr = aSalesNum.pShipAddr
				ENDIF
			ELSE
				ThisForm.ShipAddr = 0
			ENDIF
			
			IF TYPE("aSalesNum.ShipRoute")="C"
				IF ISNULL(aSalesNum.PayType)
					ThisForm.pf.pgShipto.txtShipRoute.Value	= ' '
				ELSE
					ThisForm.pf.pgShipto.txtShipRoute.Value	= aSalesNum.ShipRoute
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.txtShipRoute.Value	= ' '
			ENDIF
			
			IF TYPE("aSalesNum.ShipPay") = "C"
				IF ISNULL(aSalesNum.PayType)
					ThisForm.pf.pgShipto.cmbFrtPayment.Value= ' '
				ELSE
					*Not Entered,STD TERMS,Standard Terms,COD,COD,CREDIT CRD,Credit Card,WIRE TRANS,Wire Transfer,HOLD 4 PAY,Hold for Payment,LINKPOINT,LinkPoint,PAYPAL,PayPal,PREPAID,Prepaid
					ThisForm.pf.pgShipto.cmbFrtPayment.Value= aSalesNum.ShipPay
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.cmbFrtPayment.Value= ' '
			ENDIF
				
			IF TYPE("aSalesNum.PayType") = "C"
				IF ISNULL(aSalesNum.PayType)
					ThisForm.pf.pgShipto.cmbPayment.Value	= ' '
					ThisForm.PaymentType							= ' '
				ELSE
					* , Not Entered,FRT COLLECT,Freight Collect,ADD FREIGHT,Add Freight to bill,FRT PREPAY,Freight covered in Sale Price,3RD PARTY,3rd Party Billing
					ThisForm.pf.pgShipto.cmbPayment.Value	= aSalesNum.PayType
					ThisForm.PaymentType							= aSalesNum.PayType
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.cmbPayment.Value	= ' '
				ThisForm.PaymentType							= ' '
			ENDIF
			
			IF EMPTY(ThisForm.PaymentType)
				PRIVATE cPaymentTypeNumber
				cPaymentTypeNumber = GetPayType( SalesQuote.CustID, SalesQuote.Company, ThisForm.SoldAddr, ThisForm.nConnHandle )
				IF cPaymentTypeNumber $ "OverLimit"
					MESSAGEBOX("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!",64,"Warning, Allready over credit Limit!")
					Trackmess("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!, before adding SO "+ALLTRIM(STR(nSalesnum))+" frmEdt.Init()")
					cPaymentTypeNumber = LEFT(cPaymentTypeNumber,1)
				ENDIF
				ThisForm.PaymentType = ShowPaymentTypeText(cPaymentTypeNumber)
				ThisForm.pf.pgShipto.cmbPayment.Value	= ThisForm.PaymentType
			ENDIF
			
			
			IF TYPE("aSalesNum.Paper_PO")= "L"
				IF ISNULL(aSalesNum.Blind)
					ThisForm.pf.pgShipto.chkReceivedPO.Value = 0
				ELSE
					ThisForm.pf.pgShipto.chkReceivedPO.Value = IIF(aSalesNum.Paper_PO,1,0)
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.chkReceivedPO.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.Blind")= "L"
				IF ISNULL(aSalesNum.Blind)
					ThisForm.pf.pgShipto.chkBlindSO.Value	= 0
				ELSE
					ThisForm.pf.pgShipto.chkBlindSO.Value	= IIF(aSalesNum.Blind,1,0)
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.chkBlindSO.Value	= 0
			ENDIF
			
			IF TYPE("aSalesNum.FaxConf") = "L"
				IF ISNULL(aSalesNum.FaxConf)
					THISFORM.pf.pgBillTo.ChkFax.VALUE = 0
				ELSE
					THISFORM.pf.pgBillTo.ChkFax.VALUE = IIF(aSalesNum.FaxConf,1,0)
				ENDIF
			ELSE
				THISFORM.pf.pgBillTo.ChkFax.VALUE = 0
			ENDIF
			
			IF TYPE("aSalesNum.EmailConf") = "L"
				IF ISNULL(aSalesNum.EmailConf)
					THISFORM.pf.pgBillTo.ChkEmail.VALUE = 0
				ELSE
					THISFORM.pf.pgBillTo.ChkEmail.VALUE = IIF(aSalesNum.EmailConf,1,0)
				ENDIF
			ELSE
				THISFORM.pf.pgBillTo.ChkEmail.VALUE = 0
			ENDIF
			
			IF TYPE("aSalesNum.FreightEst") = "N"
				IF ISNULL(aSalesNum.FreightEst)
					ThisForm.pf.pgShipto.txtFreightEst.Value = 0
				ELSE
					ThisForm.pf.pgShipto.txtFreightEst.Value = aSalesNum.FreightEst
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.txtFreightEst.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.PrintedSO") = "L"
				IF ISNULL(aSalesNum.PrintedSO)
					THISFORM.nPrintedSO = 0
				ELSE
					THISFORM.nPrintedSO = IIF(aSalesNum.PrintedSO,1,0)
				ENDIF
			ELSE
				THISFORM.nPrintedSO = 0
			ENDIF
			
			IF TYPE("aSalesNum.Addr_Ref") = "C"
				IF ISNULL(aSalesNum.Addr_Ref)
					ThisForm.pf.pgShipto.txtAddr_Ref.Value = ''
				ELSE
					ThisForm.pf.pgShipto.txtAddr_Ref.Value = aSalesNum.Addr_Ref
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.txtAddr_Ref.Value = ''
			ENDIF
			
			IF TYPE("aSalesNum.cncld")= "L"
				IF ISNULL(aSalesNum.cncld)
					ThisForm.pf.pgBillTo.chkCancel.Value = 0
				ELSE
					ThisForm.pf.pgBillTo.chkCancel.Value = IIF(aSalesNum.cncld,1,0)
				ENDIF
			ELSE
				ThisForm.pf.pgBillTo.chkCancel.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.TarfBill")= "C"
				IF ISNULL(aSalesNum.TarfBill)
					ThisForm.pf.pgShipto.cmbTarfBill.Value = ''
				ELSE
					ThisForm.pf.pgShipto.cmbTarfBill.Value = aSalesNum.TarfBill
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.cmbTarfBill.Value = ''
			ENDIF
			
			IF TYPE("aSalesNum.USA") = "L"
				ThisForm.pf.pgShipto.chkUSA.Value = IIF(aSalesNum.USA,1,0)
			ELSE
				ThisForm.pf.pgShipto.chkUSA.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.ECPC") = "L"
				IF ISNULL(aSalesNum.ECPC)
					ThisForm.pf.pgShipto.chkECPC.Value = 0
				ELSE
					ThisForm.pf.pgShipto.chkECPC.Value = IIF(aSalesNum.ECPC,1,0)
				ENDIF
			ELSE
				ThisForm.pf.pgShipto.chkECPC.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.Amendment") = "N"
				IF ISNULL(aSalesNum.Amendment) 
					ThisForm.pf.pgBillTo.txtAmendment.Value = 0
					ThisForm.pf.pgQA.txtVersion.Value = 0
					*ThisForm.pf.pgBillTo.txtAmendment.Visible = .F.
					*ThisForm.pf.pgBillTo.lblAmendment.Visible = .F.	
				ELSE
					ThisForm.pf.pgBillTo.txtAmendment.Value = aSalesNum.Amendment
					ThisForm.pf.pgQA.txtVersion.Value = aSalesNum.Amendment
					IF aSalesNum.Amendment > 0
						ThisForm.pf.pgBillTo.txtAmendment.Visible = .T.
						ThisForm.pf.pgBillTo.lblAmendment.Visible = .T.
					ELSE
						*ThisForm.pf.pgBillTo.txtAmendment.Visible = .F.
						*ThisForm.pf.pgBillTo.lblAmendment.Visible = .F.	
					ENDIF
				ENDIF
			ELSE
				ThisForm.pf.pgBillTo.txtAmendment.Value = 0
				ThisForm.pf.pgQA.txtVersion.Value = 0
				*ThisForm.pf.pgBillTo.txtAmendment.Visible = .F.
				*ThisForm.pf.pgBillTo.lblAmendment.Visible = .F.
			ENDIF
			
			IF TYPE("aSalesNum.Changing") = "L"
				IF aSalesNum.Changing
					MESSAGEBOX("This Order has been changed and the Version number has not been updated."+CHR(13)+"Save or Print this order to refresh the Version number!",0+64,"SO has changed!")
				ENDIF
			ENDIF
				
			USE IN aSalesNum
		
		ELSE
			*No record exists - INIT
			ThisForm.pf.pgShipto.cmbTarfBill.Value = "RECEPIENT"
			ThisForm.pf.pgShipto.chkUSA.Value = 1
		ENDIF
		***** End Sales_No
		
		IF ThisForm.ShipAddr > 0
			ThisForm.pf.pgShipto.txtShipCode.Value = ThisForm.ShipAddr
			
		*!*		IF NOT USED('ShipAddr')
		*!*			USE ShipAddr IN 0 ORDER TAG Shipcode
		*!*		ENDIF
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(ThisForm.ShipAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
			ENDIF
			SELECT aShipAddr
		*	IF SEEK(ThisForm.ShipAddr,"ShipAddr","ShipCode" ) &&Found the record
			IF USED('aShipAddr')
				ThisForm.pf.pgShipto.txtCompany.Value 	= aShipAddr.Company
				ThisForm.pf.pgShipto.txtAddr1.Value		= aShipAddr.Addr1	
				ThisForm.pf.pgShipto.txtAddr2.Value		= aShipAddr.Addr2
				ThisForm.pf.pgShipto.txtCity.Value 		= aShipAddr.City	
				ThisForm.pf.pgShipto.txtST.Value		= aShipAddr.ST
				ThisForm.pf.pgShipto.txtZip.Value		= aShipAddr.Zip
				ThisForm.pf.pgShipto.txtCountry.Value	= aShipAddr.Country
				ThisForm.pf.pgShipto.txtContact.Value	= aShipAddr.Contact
				ThisForm.pf.pgShipto.txtPhone.Value		= aShipAddr.Telephone
				ThisForm.pf.pgShipto.txtFax.Value		= aShipAddr.Fax_Number
				ThisForm.pf.pgShipto.txtEmail.Value		= aShipAddr.Email
				ThisForm.pf.pgShipto.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
					
				ThisForm.Address_Screen("ShipToEdit")
				
				USE IN aShipAddr
			ENDIF
		ENDIF
		IF ThisForm.SoldAddr > 0
			ThisForm.pf.pgBillto.txtSoldCode.Value = ThisForm.SoldAddr
			
		*!*		IF NOT USED('SoldAddr')
		*!*			USE SoldAddr IN 0 ORDER TAG soldcode
		*!*		ENDIF
			IF USED( 'SoldAddr' )
				USE IN SoldAddr
			ENDIF
			SELECT 0
			cSQL = "SELECT * FROM dbo.SoldAddr "
			cSQL = cSQL + " WHERE SoldCode = "+STR(ThisForm.SoldAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
			ENDIF
		
		*	SELECT SoldAddr
			IF USED('SoldAddr')
			*IF SEEK(ThisForm.SoldAddr,"SoldAddr","SoldCode" ) &&Found the record
				ThisForm.pf.pgBillto.txtCompany.Value 	= SoldAddr.Company
				ThisForm.pf.pgBillto.txtAddr1.Value		= SoldAddr.Addr1	
				ThisForm.pf.pgBillto.txtAddr2.Value		= SoldAddr.Addr2
				ThisForm.pf.pgBillto.txtCity.Value 		= SoldAddr.City	
				ThisForm.pf.pgBillto.txtST.Value		= SoldAddr.ST
				ThisForm.pf.pgBillto.txtZip.Value		= SoldAddr.Zip
				ThisForm.pf.pgBillto.txtCountry.Value	= SoldAddr.Country
				ThisForm.pf.pgBillto.txtContact.Value	= SoldAddr.Contact
				ThisForm.pf.pgBillto.txtPhone.Value		= SoldAddr.Telephone
				ThisForm.pf.pgBillto.txtFax.Value		= SoldAddr.Fax_Number
				ThisForm.pf.pgBillto.txtEmail.Value		= SoldAddr.Email
				ThisForm.pf.pgBillto.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(SoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(SoldAddr.LastEdit,'LastEdit'))
						
				ThisForm.Address_Screen("SoldToEdit")
				
				USE IN SoldAddr
			ENDIF
		ENDIF
		
		
		*****
		SELECT SalesQuote
		PRIVATE lnATlt, lcrLeadTime, ldLTDate, lnLTVal
		lcrLeadTime = ''
		SCAN
		*	IF VARTYPE(SalesQuote.ShipDue) = "T"
		*		SalesQuote.ShipDue = TTOD(SalesQuote.ShipDue)
		*	ENDIF
			IF EMPTY(SalesQuote.ShipDue) OR SalesQuote.ShipDue = CTOD("01/01/1900")
				IF NOT EMPTY(SalesQuote.LeadTime)
					
					*Duplicate changes here with select4order.cmdDone4Order.Click
					IF CTOD(SalesQuote.LeadTime) != CTOD("  /  /  ")
						*Allready in Date Format
						ldLTDate = CTOD(SalesQuote.LeadTime)
					ELSE
						lnATlt = AT("-",SalesQuote.LeadTime)
						lcrLeadTime  = IIF(lnATlt > 0,SUBSTR(SalesQuote.LeadTime,lnATlt+1) ,SalesQuote.LeadTime)
						lnLTVal = VAL(lcrLeadTime )
			
						IF "WK" $ UPPER(lcrLeadTime ) OR  "WEEK" $ UPPER(lcrLeadTime )
							IF lnLTVal > 0
								ldLTDate = DATE()+ (lnLTVal * 7) && num * 7Days/week
							ELSE
								ldLTDate = DATE()+ 7 &&1wk
							ENDIF
						ELSE
							IF lnLTVal > 0
								ldLTDate = DATE() + (lnLTVal) && num of days
							ELSE
								ldLTDate = DATE()+1	 && could not parse data
							ENDIF
						ENDIF
					ENDIF
					
					IF AT( "/", lcrLeadTime  , 2 )>0 OR AT( "-", lcrLeadTime  , 2 )>0 
						**MUST BE A DATE!
						ldLTDate = CTOD(lcrLeadTime)
					ENDIF
					
				ELSE
					ldLTDate = DATE()+1
					
				ENDIF
		
		
				**Correct for weekends
				DO CASE
				CASE DOW(ldLTDate) = 7 &&Saterday
					ldLTDate = ldLTDate + 2
				CASE DOW(ldLTDate ) = 1 &&Sun
					ldLTDate = ldLTDate + 1
				ENDCASE
				
				IF NOT EMPTY(ldLTDate)
					REPLACE ShipDue WITH ldLTDate IN SalesQuote
				
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu + "ShipDue='"+IIF(EMPTY(ldLTDate),'',DTOC(ldLTDate))+"'"
					cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+SalesQuote.SoItem_a+"')"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!, long triger
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
					ENDIF	
				ENDIF
			ENDIF
		
			IF EMPTY(SalesQuote.ItemSale) OR VARTYPE(SalesQuote.ItemSale)="X" 
				SELECT SalesQuote
				PRIVATE nCalcLotP 
				nCalcLotP = THISFORM.CalcLotp()
				ThisForm.UpdtItemSale(nCalcLotP)
			ENDIF
			
		ENDSCAN  &&Salesnum
		
		PUBLIC ARRAY gaPoItems(1)
		gaPoItems(1) = ''
		PUBLIC ARRAY gaContactIDs(1)
		gaContactIDs(1) = 0
		PUBLIC ARRAY gaPOcompany(1)
		gaPOcompany(1) = ""
		
		
		GO TOP
		WAIT CLEAR
		
		IF USED( 'aShipAddr' )
			USE IN aShipAddr
		ENDIF
		ThisForm.VendCode = 0
	ENDPROC

	PROCEDURE frmEdt.Load
		IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		IF VARTYPE(gnConnHandle) = "N"
			IF gnConnHandle > 0
				ThisForm.nConnhandle = gnConnHandle
			ELSE
				STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle &&gnSOch
			ENDIF
		ELSE
			STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle
		ENDIF
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		ENDIF
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.chkCancel.Click
		PRIVATE lnSalesNum
		lnSalesNum	= THISFORM.SalesNum
		
		PRIVATE lCancel
		lCancel = PrepareSQLchk( This.Value, 'Cancel')
		
		
		IF MESSAGEBOX("All Items will be for this order will be changed,"+CHR(13)+"as soon as you click Yes'"+CHR(13)+CHR(13)+"Are you sure you want to continue ?",4,'')=6
			IF lCancel 
				IF Cancel_SO(lnSalesNum, ThisForm.nConnHandle)
				
					UPDATE SalesQuote SET ;
						Cncld = .T.;
						WHERE SalesNum_a = lnSalesNum
						
								
		*!*				PRIVATE nAmendment 
		*!*				*nAmendment = PrepareSQLnum(ThisForm.pf.pgBillTo.txtAmendment.Value,'Amendment',2,0)
		*!*				nAmendment = PrepareSQLnum(This.parent.txtAmendment.Value,'Amendment',2,0)
		*!*				IF EMPTY(nAmendment)
		*!*					nAmendment = 0
		*!*				ENDIF
		*!*				nAmendment = nAmendment + 1
		*!*				*ThisForm.pf.pgBillTo.txtAmendment.Value = nAmendment 
		*!*				This.parent.txtAmendment.Value = nAmendment 
		*!*				This.parent.parent.pgQA.txtVersion.Value = nAmendment
					 
					ThisForm.SaveSO()
					
					MESSAGEBOX("Please call shop to get paperwork stopped."+CHR(13)+"Reprint SalesOrder now as Cancelled.",0+64,"Inform shop of this Cancel!")
						
				ELSE
		*			IF HaveSODeletePermision(0)  -Now inside Calcel_SO proc
		*				IF MESSAGEBOX("Do you want to use your Administrator rights to force a Cancel?"+CHR(13)+CHR(13)+"Normal users could not cancel this order.",4+32,"Force Cancel?") = 6
							*No code needed
		*				ELSE
							This.Value = 0
							RETURN .F.
		*				ENDIF
		*			ENDIF
		*		ELSE
					This.Value = 0	
				ENDIF
			ELSE
				*UN CANCEL
				Update_Ship_Cncld(.F.,lnSalesNum,ThisForm.nConnHandle)
				
				UPDATE SalesQuote SET ;
					Cncld = .F.;
					WHERE SalesNum_a = lnSalesNum
				
				cSQLu = "UPDATE dbo.Sales_No SET "
				cSQLu = cSQLu + "Cncld = '0'"
				cSQLu = cSQLu + ", ShopRecv='0'"
				cSQLu = cSQLu + " WHERE SalesNum = "+STR(lnSalesNum)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLU)
				ENDDO
				
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				ENDIF
				
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + "Cncld = '0'"
				cSQLu = cSQLu + " WHERE SalesNum = "+STR(lnSalesNum)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLU)
				ENDDO
			
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				ENDIF
				
				MESSAGEBOX("The 'Cancelled' mark has been removed for Sales Order #"+ALLTRIM(STR(lnSalesNum))+CHR(13)+CHR(13)+"This SO is also considered 'Not Received' by shop"+CHR(13)+"Please call and confirm about 'Sales Order print Receiving' with shop if you do not reprint this.",0+48,'Un Cancelled')
				
				TrackMess("Sales Order #"+ALLTRIM(STR(lnSalesNum))+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" frmEdt.chkCancel.Click()" )
				Save_Sales_Status( lnSalesNum, 'UNCancel', 'UN-Cancelled Sales Order.', ThisForm.nConnHandle )
				
		
		
		*!*			PRIVATE nAmendment 
		*!*			*nAmendment = PrepareSQLnum(ThisForm.pf.pgBillTo.txtAmendment.Value,'Amendment',2,0)
		*!*			nAmendment = PrepareSQLnum(This.parent.txtAmendment.Value,'Amendment',2,0)
		*!*			IF EMPTY(nAmendment)
		*!*				nAmendment = 0
		*!*			ENDIF
		*!*			nAmendment = nAmendment + 1
		*!*			*ThisForm.pf.pgBillTo.txtAmendment.Value = nAmendment 
		*!*			This.parent.txtAmendment.Value = nAmendment 
		*!*			This.parent.parent.pgQA.txtVersion.Value = nAmendment
				 
				ThisForm.SaveSO()
				
				MESSAGEBOX("Please call shop to get paperwork started."+CHR(13)+"Reprint SalesOrder now.",0+64,"Inform shop of this order!")
		
		
			ENDIF
			
			This.Parent.Parent.pgOrder.chkCancelItem.Refresh
		
		
		ELSE
			*unClick
			IF THIS.VALUE = 1
				THIS.VALUE = 0
			ELSE
				THIS.VALUE = 1
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.ChkEmail.Click
