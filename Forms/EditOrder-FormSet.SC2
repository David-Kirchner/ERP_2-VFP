	PROCEDURE frmEdt.pf.pgBillTo.Click
		*!*	IF This.chkAllSoldAddr.Value = 1
		*!*		ThisForm.cmdTop.Click()
		*!*	ENDIF
		IF This.cmdEditSoldTo.CAPTION = "Save"
			RETURN
		ENDIF
		
		IF ThisForm.SoldAddr > 0
			PRIVATE cCustomerID 
			cCustomerID = GetCustomerID_with_SoldCode(ThisForm.SoldAddr,ThisForm.nConnHandle)
			IF EMPTY(cCustomerID)
				This.cmdCustomerID.Caption = 'Get CustomerID'
			ELSE
				IF VAL(cCustomerID) = 0
					This.cmdCustomerID.Caption = 'Get CustomerID'
				ELSE
					This.cmdCustomerID.Caption = cCustomerID 
				ENDIF
			ENDIF
			
			PRIVATE nIND_Type
			nIND_Type = getIND_Type( "SOLDADDR", ThisForm.SoldAddr, ThisForm.nConnHandle)
			IF nIND_Type > 0
				This.lblIndType.Caption = STR(nInd_Type)
				This.lblIndType.Visible = .T.
			ELSE
				This.lblIndType.Caption = ''
				This.lblIndType.Visible = .F.
			ENDIF
		ENDIF
		
		thisform.Refresh()
		
		RETURN
		
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF THISFORM.SoldAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6 &&Yes
			IF THISFORM.SoldAddr <> 0
				THISFORM.SoldAddr = 0
		
		*!*			IF THIS.PARENT.chkAllSoldAddr.VALUE = 1
		*!*				mHoldRecordNum = 0
		*!*				mHoldRecordNum = RECNO('SalesQuote')
		*!*				REPLACE ALL pSoldAddr WITH 0 IN SalesQuote
		*!*				IF mHoldRecordNum > 0
		*!*					GOTO (mHoldRecordNum) IN SalesQuote
		*!*				ELSE
		*!*					GOTO TOP
		*!*				ENDIF
		*!*			ELSE
		*!*				REPLACE pSoldAddr WITH 0 IN SalesQuote
		*!*			ENDIF
		*		THIS.PARENT.numSoldAddr.VALUE = 0
				THIS.PARENT.txtSoldCode.VALUE = 0
			ENDIF
			
			ThisForm.Address_Screen("SoldToEdit")
			
			THIS.PARENT.cmdSearchSoldTo.ENABLED = .T.
		
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
		ELSE
			IF THIS.PARENT.cmdEditSoldTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
		
					IF USED( 'aSoldAddr' )
						USE IN aSoldAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.SoldAddr"
					cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(THISFORM.SoldAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
					ENDIF
					
					
					IF USED('aSoldAddr')
						*THISFORM.SoldAddr = aSoldAddr( 1, 1 )
						THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
						THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
						THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
						THIS.PARENT.txtCity.VALUE = aSoldAddr.City
						THIS.PARENT.txtST.VALUE = aSoldAddr.ST
						THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
						THIS.PARENT.txtCountry.VALUE = aSoldAddr.Country
						THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
						THIS.PARENT.txtPhone.VALUE = aSoldAddr.Telephone
						THIS.PARENT.txtFax.VALUE = aSoldAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
						THIS.PARENT.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
					
						USE IN aSoldAddr
					ENDIF
					
					ThisForm.Address_Screen("SoldToEdit")
		
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.cmdCustomerID.Click
		lcCurrTable = ALIAS()
		
		
		DO FORM Forms\select_CustomerID WITH "SoldAddr",SalesQuote.company,ThisForm.SoldAddr,ThisForm.nConnHandle  TO cCustomerID
		
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF VARTYPE(cCustomerID)="C"
			IF NOT EMPTY(cCustomerID)
				This.Caption = cCustomerID 
				
				PRIVATE nCurrentRec 
				nCurrentRec = RECNO('SalesQuote')
				SELECT SalesQuote
				REPLACE ALL CustID WITH cCustomerID
				GOTO (nCurrentRec)
				
				SaveCustID_AllQuotes(cCustomerID, SalesQuote.SalesNum, ThisForm.nConnHandle )
				
			ELSE
				This.Caption = 'Get CustomerID'
			ENDIF
		ELSE
			This.Caption = 'Get CustomerID'
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.cmdEditSoldTo.Click
		PRIVATE	maxSoldCode, maxShipCode, oldSoldCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnSoldAddr
		PRIVATE lcContact,lcPhone,lcFax,lcEmail
		
		*PrepareSQLtxt("High Performance Alloy's'",'Company',25)
		lcCompany =PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',30)
		lcAddr1 = PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',30)
		lcAddr2 = PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',30)
		lcCity  = PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',20)
		lcST    = PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',2)
		lcZip   = PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',12)
		lcCountry = PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',15)
		lcContact = PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',20)
		lcPhone = PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',12)
		lcFax	 = PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
		lcEmail = PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		ldLastEdit = DATE()
		lnSoldAddr = THISFORM.SoldAddr
		
		
		SaveAddr = .F.
		SaveAddress = .F.
		oldSoldCode = 0
		IF THIS.CAPTION = "Save"
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))
				SaveAddress = .T.
			ENDIF
		
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!",0,'')
				SaveAddress = .F.
				RETURN .F.
			ENDIF
			
			*Check Data
			
			IF USED("cntSoldCode")
				USE IN cntSoldCode
			ENDIF
			SELECT 0
			cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.SoldAddr"
			cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
			cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
			cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
			cSQL = cSQL + " AND City = '"+lcCity+"'"
			cSQL = cSQL + " AND ST = '"+lcST+"'"
			cSQL = cSQL + " AND Zip = '"+lcZip+"'"
			cSQL = cSQL + " AND Country = '"+lcCountry+"'"
			cSQL = cSQL + " AND Contact = '"+lcContact+"'"
			cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
			cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
			cSQL = cSQL + " AND Email = '"+lcEmail+"'"
		*	cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSoldCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSoldCode')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSoldCode')
			ENDIF
			
			IF USED("cntSoldCode")
				IF cntSoldCode.cnt = 0
					SaveAddress = .T.
				ELSE
					SaveAddress = .F.
					*Already have exact Address
					
					IF USED("tmpCntSoldCode")
						USE IN tmpCntSoldCode
					ENDIF
					SELECT 0
					cSQL = "SELECT SoldCode FROM dbo.SoldAddr"
					cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
					cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
					cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
					cSQL = cSQL + " AND City = '"+lcCity+"'"
					cSQL = cSQL + " AND ST = '"+lcST+"'"
					cSQL = cSQL + " AND Zip = '"+lcZip+"'"
					cSQL = cSQL + " AND Country = '"+lcCountry+"'"
					cSQL = cSQL + " AND Contact = '"+lcContact+"'"
					cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
					cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
					cSQL = cSQL + " AND Email = '"+lcEmail+"'"
				*	cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntSoldCode')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntSoldCode')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCntSoldCode')
					ENDIF
					
					IF USED("tmpCntSoldCode")
						IF VARTYPE(tmpCntSoldCode.SoldCode) = 'N'
							lnSoldAddr = tmpCntSoldCode.SoldCode
							ThisForm.SoldAddr = lnSoldAddr 
						ENDIF
						USE IN tmpCntSoldCode
					ENDIF
						
						
					*****
				
					IF EMPTY(ThisForm.SoldAddr)
						*Find the SoldCode and display it
		
						IF USED("delSoldCode")
							USE IN delSoldCode
						ENDIF
						SELECT 0
						cSQL = "SELECT SoldCode FROM dbo.SoldAddr"
						cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City = '"+lcCity+"'"
						cSQL = cSQL + " AND ST = '"+lcST+"'"
						cSQL = cSQL + " AND Zip = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'"
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
						*cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'delSoldCode')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'delSoldCode')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'delSoldCode')
						ENDIF
		
						IF USED('delSoldCode')
							THISFORM.SoldAddr = delSoldCode.SoldCode
							THIS.PARENT.txtSoldCode.Value = delSoldCode.SoldCode
							THIS.PARENT.txtSoldCode.REFRESH
							
							USE IN delSoldCode
							
						ENDIF
					ELSE
						
						*Not changed
					ENDIF
				ENDIF
				
				IF USED("cntSoldCode")
					USE IN cntSoldCode
				ENDIF
			ELSE
				SaveAddress = .F.
			ENDIF
			
			IF SaveAddress
				****** big save procedure********
				PRIVATE	nSaveNew
		
				IF lnSoldAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
					
					IF nSaveNew = 7 && No
						IF USED("cntSales_No")
							USE IN cntSales_No
						ENDIF
						SELECT 0
						cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales_No "
						cSQL = cSQL + " WHERE PShipAddr = "+STR(lnSoldAddr )
						cSQL = cSQL + " and Sales_No.CNCLD = 0 AND Sales_No.CMPLT = 0"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_No')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSales_No')
						ENDIF
		
						IF USED('cntSales_No')
							IF cntSales_No.Cnt > 0
								MESSAGEBOX("There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)+;
								ALLTRIM(STR(cntSales_No.Cnt))+" unshipped Order(s) use the Address number "+;
								ALLTRIM(STR(lnSoldAddr ))+".",0+16,"CAUTION")
							ENDIF
							THISFORM.SoldAddr = lnSoldAddr
							USE IN cntSales_No
						ENDIF
					ENDIF
					IF nSaveNew = 6 && Yes
						IF MESSAGEBOX("Do you want to mark the old Address as INACTIVE ?"+CHR(13)+CHR(13)+;
							"Inactive address will not show when you search for an address."+CHR(13)+;
							"If the company has moved,"+CHR(13)+;
							"permantly leaving the address,"+CHR(13)+;
							"please mark the old address as inactive now.",4,"") = 6
							
							*Mark as InaActive
							PRIVATE cSQLu
							cSQLu= "UPDATE dbo.SoldAddr SET "
							cSQLu= cSQLu+" InActive = 1 "
							cSQLu= cSQLu+" WHERE soldcode = "+STR(lnSoldAddr)
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
							ENDIF
							
						ENDIF
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
				IF nSaveNew = 6 && Yes, save as new
		
					*	Get maxSoldCode
					*maxSoldCode = THISFORM.maxSoldCode()
					*maxShipCode = THISFORM.maxShipCode()
					MaxSoldCode=get_MaxSoldCode()
					MaxShipCode=get_MaxShipCode()
		
					maxSoldCode= MAX( maxSoldCode, maxShipCode )
					maxSoldCode = maxSoldCode + 2 &&leave space for Shipto Edits
		
					IF THISFORM.SoldAddr > 0
						*	*Check old SoldCode to see if anything changed.
						IF USED("aSoldAddr")
							USE IN aSoldAddr
						ENDIF
						SELECT 0
						cSQL = "SELECT * FROM dbo.SoldAddr"
						cSQL = cSQL + " WHERE SoldCode = "+STR(THISFORM.SoldAddr)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
						ENDIF
						
						IF USED('aSoldCode')
							IF aSoldAddr.soldcode = THISFORM.SoldAddr AND ;
									aSoldAddr.Company = lcCompany AND ;
									aSoldAddr.Addr1	= lcAddr1 AND ;
									aSoldAddr.Addr2	= lcAddr2 AND ;
									aSoldAddr.City	= lcCity AND ;
									aSoldAddr.ST		= lcST AND ;
									aSoldAddr.Zip		= lcZip AND ;
									aSoldAddr.Country	= lcCountry AND ;
									aSoldAddr.Contact	= lcContact AND ;
									aSoldAddr.Telephone	= lcPhone AND ;
									aSoldAddr.Fax_Number= lcFax AND ;
									aSoldAddr.Email		= lcEmail
								*no change - do not save
							ELSE &&did not match all Fields - Save
								SaveAddr = .T.
								oldSoldCode = THISFORM.SoldAddr
							ENDIF
						ELSE &&Seek failed - add as new
							SaveAddr = .T.
						ENDIF
					ELSE && No SoldCode just add new if have data
						IF LEN(lcCompany+lcAddr1) > 1
							SaveAddr = .T.
						ELSE
							SaveAddr = .T.
						ENDIF
					ENDIF
		
		
					IF SaveAddr
						DO WHILE FoundSoldCode( maxSoldCode ,ThisForm.nConnHandle)
							maxSoldCode = maxSoldCode + 1
						ENDDO
		
						THIS.PARENT.txtSoldCode.VALUE = maxSoldCode
		*				THIS.PARENT.numSoldAddr.VALUE = maxSoldCode
						THISFORM.SoldAddr = maxSoldCode
		
		
						Save_ShipAddrCode(maxSoldCode, ALLTRIM(STR(maxSoldCode,10,0)), oldSoldCode, ThisForm.nConnHandle)
		
						cSQLi = "INSERT INTO dbo.SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number,Email,Customer, LastEdit ) VALUES ("
						cSQLi = cSQLi + STR(maxSoldCode)
						cSQLi = cSQLi+",'"+lcCompany+"'"
						cSQLi = cSQLi+",'"+lcAddr1+"'"
						cSQLi = cSQLi+",'"+lcAddr2+"'"
						cSQLi = cSQLi+",'"+lcCity+"'"
						cSQLi = cSQLi+",'"+lcST+"'"
						cSQLi = cSQLi+",'"+lcZip+"'"
						cSQLi = cSQLi+",'"+lcCountry+"'"
						cSQLi = cSQLi+",'"+lcContact+"'"
						cSQLi = cSQLi+",'"+lcPhone+"'"
						cSQLi = cSQLi+",'"+lcFax+"'"
						cSQLi = cSQLi+",'"+lcEmail+"'"
						cSQLi = cSQLi + ",''"		&&+ALLTRIM(STR(maxSoldCode,10,0))+""
						cSQLi = cSQLi + ",'"+DTOC(DATE())+"')"
						
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
						
						THISFORM.UpdateCustID = .T.
		
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
							
							*****************
							
							IF ThisForm.SalesNum > 0
								IF Count_SOinPackingSlip_No( ThisForm.SalesNum,ThisForm.nConnHandle ) > 0
		
									MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
									"The Packing Slip database will be updated with this new address.",0+48,"")
									
									Update_SoldCodeinPackingSlip_No( maxSoldCode, ThisForm.SalesNum, ThisForm.nConnHandle )
		
								ENDIF
							
							ENDIF
							******************
							
						IF THISFORM.ShipAddr > 0
							Save_Sold_Ship(maxSoldCode, THISFORM.ShipAddr, ThisForm.nConnHandle )
						ELSE
							*a new sold to was added * no ship addr exist * copy to ship addr
							IF THIS.PARENT.PARENT.pgShipTo.cmdEditShipTo.CAPTION = "Edit"
								IF MESSAGEBOX("Ship to address is empty."+CHR(10)+CHR(13)+"Do you want to copy this billing address to start a shipping address?", 4+32,"Copy to Ship To?")=6
									ThisForm.Address_Screen("ShipToSave")
									THIS.PARENT.PARENT.pgShipTo.txtCompany.VALUE = THIS.PARENT.txtCompany.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtAddr1.VALUE   = THIS.PARENT.txtAddr1.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtAddr2.VALUE   = THIS.PARENT.txtAddr2.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtCity.VALUE    = THIS.PARENT.txtCity.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtST.VALUE      = THIS.PARENT.txtST.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtZip.VALUE     = THIS.PARENT.txtZip.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtCountry.VALUE = THIS.PARENT.txtCountry.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtContact.VALUE = THIS.PARENT.txtContact.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtPhone.VALUE   = THIS.PARENT.txtPhone.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtFax.VALUE  	 = THIS.PARENT.txtFax.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtEmail.VALUE   = THIS.PARENT.txtEmail.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtLastEdit.VALUE = ""
									WAIT WINDOW "Remember to Click Save on the Ship Address." NOWAIT
								ENDIF
							ENDIF
						ENDIF
						*		WAIT WINDOW "Edit is only saved to this Sales Order when Print is successfull." NOWAIT
					ENDIF
				ELSE  &&nSaveNew = 6 && Yes, save as new
			
					*Save - not as new!
					*REPLACE DATA
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.SoldAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
		*			cSQLu= cSQLu+",Customer="+ALLTRIM(STR(useShipCode,10,0))+""
					cSQLu= cSQLu+ ",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+ " WHERE soldcode = "+STR(lnSoldAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
						
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
				ENDIF
			ENDIF
		
			ThisForm.Address_Screen("SoldToEdit")
			THISFORM.cmdNext.SETFOCUS()
		
		ELSE &&Caption was Edit
			ThisForm.Address_Screen("SoldToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.cmdIND_Type.Click
		PRIVATE nSoldAddr
		nSoldAddr = PrepareSQLnum(ThisForm.SoldAddr,'SoldAddr',-3)
		IF nSoldAddr > 0
			DO FORM Forms\IND_Type WITH nSoldAddr,'SoldAddr'
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.cmdSearchSoldTo.Click
		Private matchCodes, nNewSoldToCode, lcCurrTable 
		nNewSoldToCode = 0
		matchCodes = 0
		lcCurrTable = ALIAS()
		IF NOT USED('SALESQUOTE')
			MESSAGEBOX("'SALESQUOTE' table is not opened.",16,"Error")
			RETURN
		ENDIF
		
		PRIVATE cUseCompany
		cUseCompany = PrepareSQLtxt(SalesQuote.Company,"Company",30)
		
		IF EMPTY(cUseCompany)
			cUseCompany = PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30)
		ELSE
			IF NOT EMPTY( PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30) )
				IF cUseCompany != PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30)
					IF MESSAGEBOX("The Search will be on the Company name Quoted: "+cUseCompany+CHR(13)+"Answer No to use the name: "+PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30),3,"Search for "+cUseCompany  )=7
						cUseCompany = PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		DO FORM Forms\SearchForm WITH "SoldAddr",cUseCompany,ThisForm.nConnHandle  TO nNewSoldToCode
		*DO FORM SearchForm WITH "SoldAddr",Quotes.company  TO nNewSoldToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nNewSoldToCode > 0
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr"
			cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nNewSoldToCode)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
			ENDIF
			IF USED( 'aSoldAddr' )
				THISFORM.SoldAddr = aSoldAddr.SoldCode
				THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
				THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
				THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
				THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
				THIS.PARENT.txtCity.VALUE = aSoldAddr.City
				THIS.PARENT.txtST.VALUE = aSoldAddr.ST
				THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
				THIS.PARENT.txtCountry.VALUE = aSoldAddr.Country
				THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
				THIS.PARENT.txtPhone.VALUE = aSoldAddr.TelePhone
				THIS.PARENT.txtFax.VALUE = aSoldAddr.Fax_Number
				THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
				THIS.PARENT.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
				
				ThisForm.Address_Screen("SoldToEdit")
							
				*****************
				IF ThisForm.SalesNum > 0
					IF Count_SOinPackingSlip_No( ThisForm.SalesNum,ThisForm.nConnHandle ) > 0
						MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
						"The Packing Slip database will be updated with this new address.",0+48,;
						"A Packing Slip with the old address has allready been Printed!")
						
						Update_SoldCodeinPackingSlip_No(ThisForm.SoldAddr, ThisForm.SalesNum, ThisForm.nConnHandle )
					ENDIF
				ENDIF		
				******************
				USE IN aSoldAddr
				
			ENDIF
		
			IF EMPTY(This.Parent.Parent.pgShipTo.txtCompany.Value);
			 AND EMPTY(This.Parent.Parent.pgShipTo.txtAddr1.Value);
			  AND EMPTY(This.Parent.Parent.pgShipTo.txtAddr2.Value);
			   AND EMPTY(This.Parent.Parent.pgShipTo.txtCity.Value);
			    AND EMPTY(This.Parent.Parent.pgShipTo.txtST.Value);
			     AND EMPTY(This.Parent.Parent.pgShipTo.txtZip.Value);
			      AND EMPTY(This.Parent.Parent.pgShipTo.txtCountry.Value)
		*		fill Shipto values
		*		use last Shipto assigned to this SoldTo
		
				IF thisform.SoldAddr > 0
		*			if SoldAddr soldCode lookup links in Sold_Ship
		
					PRIVATE nUseShipCode 
					nUseShipCode = Get_ShipCodeinSoldShip(thisform.SoldAddr,ThisForm.nConnHandle)			
		*			SELECT TOP 1 ShipCode FROM HPA!Sold_Ship WHERE SoldCode = thisform.SoldAddr ORDER BY ShipCode DESC INTO ARRAY aShipCode
					IF nUseShipCode  > 0
						matchCodes = nUseShipCode 
						WAIT WINDOW "Found 'Ship To' address last used with this 'Bill To' address!" NOWAIT
					ENDIF
					
					
					PRIVATE cCustomerID 
					cCustomerID = GetCustomerID_with_SoldCode(thisform.SoldAddr,ThisForm.nConnHandle)
					IF EMPTY(cCustomerID)
						This.parent.cmdCustomerID.Caption = 'Get CustomerID'
					ELSE
						IF VAL(cCustomerID) = 0
							This.parent.cmdCustomerID.Caption = 'Get CustomerID'
						ELSE
							This.parent.cmdCustomerID.Caption = cCustomerID 
						ENDIF
					ENDIF
		
		
				ENDIF
		
				IF matchCodes = 0
					IF USED("cntSoldAddr")
						USE IN cntSoldAddr
					ENDIF
					cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.SoldAddr"
					cSQL = cSQL + " WHERE Customer = '"+STR(thisform.SoldAddr)+"'"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSoldAddr')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSoldAddr')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSoldAddr')
					ENDIF
					IF USED("cntSoldAddr")
						USE IN cntSoldAddr
						*Get the SoldCode
						matchCodes = Get_SoldCode_CustomerinSoldAddr( STR(thisform.SoldAddr,10,0), ThisForm.nConnHandle)
					ENDIF
		
				ENDIF
				
				IF USED("tempShipAddr")
					USE IN tempShipAddr
				ENDIF
				
				SELECT 0
				cSQL = "SELECT * FROM dbo.ShipAddr WHERE ShipAddr.ShipCode = "+STR(matchCodes) 
				*INTO CURSOR tempShipAddr NOFILTER
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tempShipAddr')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tempShipAddr')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tempShipAddr')
				ENDIF
			
				SELECT tempShipAddr
				GO BOTTOM IN tempShipAddr
				
				SELECT SalesQuote
				
				IF NOT EMPTY(tempShipAddr.ShipCode)
					thisform.ShipAddr = tempShipAddr.ShipCode
					This.Parent.Parent.pgShipTo.txtShipCode.Value 	= tempShipAddr.ShipCode
		*			This.Parent.Parent.pgShipto.numShipAddr.Value	= tempShipAddr.ShipCode
					This.Parent.Parent.pgShipTo.txtCompany.Value 	= tempShipAddr.Company
					This.Parent.Parent.pgShipTo.txtAddr1.Value 		= tempShipAddr.Addr1
					This.Parent.Parent.pgShipTo.txtAddr2.Value 		= tempShipAddr.Addr2
					This.Parent.Parent.pgShipTo.txtCity.Value 		= tempShipAddr.City
					This.Parent.Parent.pgShipTo.txtST.Value 		= tempShipAddr.ST
					This.Parent.Parent.pgShipTo.txtZip.Value 		= tempShipAddr.zip
					This.Parent.Parent.pgShipTo.txtCountry.Value 	= tempShipAddr.Country
					This.Parent.Parent.pgShipTo.txtContact.Value 	= tempShipAddr.Contact
					This.Parent.Parent.pgShipTo.txtPhone.Value 		= tempShipAddr.Telephone
					This.Parent.Parent.pgShipTo.txtFax.Value 		= tempShipAddr.Fax_Number
					This.Parent.Parent.pgShipTo.txtEmail.Value 		= tempShipAddr.Email
					This.Parent.Parent.pgShipTo.txtLastEdit.Value 	= IIF(EMPTY(PrepareSQLdate(tempShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(tempShipAddr.LastEdit,'LastEdit'))
					
					IF NOT EMPTY( tempShipAddr.ShipRoute )
						This.Parent.Parent.pgShipTo.txtShipRoute.Value 	= tempShipAddr.ShipRoute
					ENDIF
					IF NOT EMPTY( tempShipAddr.Instrct )
						This.Parent.Parent.pgShipTo.txtInstrct.Value 	= tempShipAddr.Instrct
					ENDIF
					IF VARTYPE( tempShipAddr.Blind ) = "L"
						This.Parent.Parent.pgShipTo.chkBlindSO.Value	= tempShipAddr.Blind
					ENDIF
					IF NOT EMPTY( tempShipAddr.PayType )
						This.Parent.Parent.pgShipTo.cmbPayment.Value	= tempShipAddr.PayType
					ENDIF
					IF NOT EMPTY( tempShipAddr.ShipPay )
						This.Parent.Parent.pgShipTo.cmbFrtPayment.Value	= tempShipAddr.ShipPay
					ENDIF	
						
					ThisForm.Address_Screen("ShipToEdit")
					*WAIT CLEAR	
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.lblBillToCountry.Click
		PRIVATE cSQL_tmpCountries, nSQLEXEC, cCurrTable
		cCurrTable = ALIAS()
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		cSQL_tmpCountries="SELECT CountryCode AS CC, CountryDesc FROM dbo.Countries"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_tmpCountries,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountries')
		ELSE
			DEFINE WINDOW output FROM 12,1 TO 23,40 TITLE 'Countries' CLOSE FLOAT GROW ZOOM
			ACTIVATE WINDOW output
			SELECT tmpCountries
			BROWSE IN WINDOW output NODELETE NOEDIT NOAPPEND
			DEACTIVATE WINDOW output
			RELEASE WINDOW output
		ENDIF
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		IF NOT EMPTY(cCurrTable)
			SELECT (cCurrTable)
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgBillTo.txtCompany.GotFocus
		IF EMPTY(This.Value) AND This.Parent.cmdEditSoldTo.Caption = "Save"
			This.Value = SalesQuote.Company
			
			IF EMPTY(This.Parent.txtContact.Value)
				This.Parent.txtContact.Value = SalesQuote.name
			ENDIF
			IF EMPTY(This.Parent.txtPhone.Value)
				This.Parent.txtPhone.Value = ALLTRIM(SalesQuote.CountryC)+ALLTRIM(SalesQuote.Phone)+IIF(!EMPTY(SalesQuote.Phone_ext),"x"+ALLTRIM(SalesQuote.Phone_ext),"")
			ENDIF
			IF EMPTY(This.Parent.txtFax.Value)
				This.Parent.txtFax.Value = ALLTRIM(SalesQuote.CountryC)+SalesQuote.Fax
			ENDIF
			IF EMPTY(This.Parent.txtEmail.Value	)
				This.Parent.txtEmail.Value = SalesQuote.Email
			ENDIF
			
			ThisForm.Address_Screen("SoldToSave")
		ENDIF
	ENDPROC

	PROCEDURE frmEdt.pf.pgOrder.chkCancelItem.Click
		PRIVATE lCancel
		lCancel = PrepareSQLchk( This.Value, 'Cancel')
		
		PRIVATE cSOitem
		cSOitem = SalesQuote.SoItem_A
		
		
		IF lCancel 
			*Check to see if Shipped!
			
			PRIVATE cSQL, nSQLEXEC
			PRIVATE nCntSOitemShipped
			nCntSOitemShipped = 0
			
			IF USED('tmpSOshipped')
				USE IN tmpSOshipped
			ENDIF
		
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Sales "
			cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
			cSQL = cSQL + " AND ISNULL([cncld],0) = 0"  &&NOT Cancelled
			cSQL = cSQL + " AND ("
			cSQL = cSQL + " ISNULL([cmplt],0) = 1"    &&Complete
			cSQL = cSQL + " OR ISNULL([pckd],0) = 1"  &&Packaged
		*	cSQL = cSQL + " OR ISNULL([prcp],0) = 1"  &&Process in Progress
			cSQL = cSQL + " OR ISNULL([prcd],0) = 1"  &&Processing Done
			cSQL = cSQL + " )"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOshipped')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOshipped' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOshipped' )
			ENDIF
		
			IF USED('tmpSOshipped')
				IF tmpSOshipped.CNTD > 0
					nCntSOitemShipped= tmpSOshipped.CNTD
				ENDIF
				USE IN tmpSOshipped
			ENDIF
			
			IF nCntSOitemShipped > 0
			
				IF USED('tmpSOshipped')
					USE IN tmpSOshipped
				ENDIF
		
				SELECT 0
				cSQL = "SELECT [cncld],[cmplt],[pckd],[prcp],[prcd] FROM dbo.Sales "
				cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOshipped')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOshipped' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOshipped' )
				ENDIF
				
				PRIVATE cMess
				
				IF USED('tmpSOshipped')
					IF RECCOUNT('tmpSOshipped') > 0
						cMess = "Cannot change this SOitem:"+cSOitem+CHR(13)
						cMess = cMess + "Cancelled="+IIF(tmpSOshipped.cncld,'T','F')+CHR(13)
						cMess = cMess + "Complete="+IIF(tmpSOshipped.cmplt,'T','F')+CHR(13)
						cMess = cMess + "Packed="+IIF(tmpSOshipped.pckd,'T','F')+CHR(13)
						cMess = cMess + "In Process="+IIF(tmpSOshipped.prcp,'T','F')+CHR(13)
						cMess = cMess + "Process Done="+IIF(tmpSOshipped.prcd,'T','F')+CHR(13)
					ENDIF
					USE IN tmpSOshipped
				ENDIF
			
				IF EMPTY(cMess)
					cMess = "Cannot change this!"+CHR(13)+"SO-item has Shipped or has been Packed"
				ENDIF
			
				IF HaveSODeletePermision(0)
					IF MESSAGEBOX("Do you want to use your Administrator rights to force a Cancel?"+CHR(13)+CHR(13)+"Normal users could not cancel this order.",4+32,"Force Cancel?") = 6
						*No code needed
					ELSE
						This.Value = 0
						RETURN .F.
					ENDIF
				ELSE
					MESSAGEBOX(cMess,0+48,"Not Allowed to change now!")
					This.Value = 0
					RETURN .F.
				ENDIF
			ENDIF
			
			***********************
			*Check for PO
			PRIVATE nCntPOitem 
			nCntPOitem = 0
		
		*	nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
			IF USED('tmpPOp')
				USE IN tmpPOp
			ENDIF
		
			SELECT 0
			cSQL = "SELECT COUNT(poItem) AS CNTD FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
			cSQL = cSQL + " AND [cancelled] = 0"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
			ENDIF
		
			IF USED('tmpPOp')
				IF tmpPOp.CNTD > 0
					nCntPOitem = tmpPOp.CNTD
				ENDIF
				USE IN tmpPOp
			ENDIF
		
			IF nCntPOitem > 0
				MESSAGEBOX( "Found "+ALLTRIM(STR(nCntPOitem))+" Purchase Order item"+IIF(nCntPOitem>1,"s","")+" for this Sales Order item."+CHR(13)+;
				  "Check to see if this PO needs to be cancelled also."+;
				  "These cannot be automatically cancelled, you must check yourself!",0,"Item is still on Order!")
				  
				  *PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle )
			ENDIF
			
			***********************
			
			IF MESSAGEBOX("Are you sure you want to Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Cancel?") = 6
				*Cancel SO Item
				IF Cancel_SOitem( cSOitem, SalesQuote.SalesNum_A, ThisForm.nConnHandle )
				
				ENDIF
				
		
			ENDIF
		ELSE
			TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" frmEdt.chkCancelItem.Click()" )
			Save_SOitem_Status( cSOitem, SalesQuote.SalesNum_A, 'Cancel', 'Cancelled SO-Item', ThisForm.nConnHandle )
		ENDIF
		
		
		MESSAGEBOX( "You must click 'SAVE' to make this change permanent.",0+64,"Click to Save.")
	ENDPROC

	PROCEDURE frmEdt.pf.pgOrder.chkInv.Click
		PRIVATE nDecimal
			
		IF SalesQuote.inv
			PRIVATE cSoItem, nBuyCost 
		*	cSoItem = SalesQuote.SoItem_a
			cSOitem	= Proper_SO_Item(SalesQuote.SoItem_A)
			nBuyCost = PrepareSQLnum(This.Parent.Parent.pgQuote.txtItemCost.Value,'ItemCost',9,2)
			*SalesQuote.ItemCost
		
			REPLACE ItemCost WITH nBuyCost IN SalesQuote
			
			IF !EMPTY(nBuyCost)
				PRIVATE cSQLu, nSQLEXEC
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + "ItemCost="+STR(nBuyCost,9,2)+""
				cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSoItem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
			                       
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
					
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				ENDIF
			ENDIF
		ENDIF
		
		IF SalesQuote.Inv AND SalesQuote.Services
			MESSAGEBOX("You cannot have 'Inv' and 'Service' selected on same item.",48,"Please choose only one!")
		ENDIF
	ENDPROC

