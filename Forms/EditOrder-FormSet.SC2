	PROCEDURE frmPO.cmdPODelete.Click
		IF THIS.CAPTION = "Delete"
			THISFORM.PO_Valid("DELETE")
			THISFORM.POScreen("CLEAR")
		ELSE
		  IF THIS.CAPTION = "Cancel" &&"ABORT SAVE"
			IF 6=MESSAGEBOX("Do you want to ignore any changes since last save?",4+32,'Cancel Edit')
				ThisForm.PONewAdd = .F.
				ThisForm.POEditing = .F.
				THISFORM.POScreen("DISABLE")
				THISFORM.POScreen("CLEAR")
				THISFORM.Show_Po()
				THISFORM.POTestingScreen("DISABLE")
				This.Caption = "Delete"
				This.Parent.cmdPOEdit.Caption = "Edit PO"
			ENDIF
		  ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.cmdPOEdit.Click
		IF THIS.CAPTION = "Save PO"
			IF THISFORM.PO_VALID("SAVE")
				IF ThisForm.PO_SaveAdd("SAVE")
					ThisForm.PONewAdd = .F.
					ThisForm.POEditing = .F.
					THISFORM.POScreen("DISABLE")
					ThisForm.Show_Po()
				ELSE
					ThisForm.PONewAdd = .F.
					ThisForm.POEditing = .T.
					THISFORM.POScreen("ENABLE")
					THISFORM.PO_VALID("EDIT")	
					*ThisForm.PO_SaveAdd("EDIT")
					This.Caption = "Edit"
				ENDIF
			ELSE
			ENDIF
		ELSE
			IF THIS.CAPTION = "Edit PO"
				ThisForm.PONewAdd = .F.
				ThisForm.POEditing = .T.
				THISFORM.POScreen("ENABLE")
				THISFORM.PO_VALID("EDIT")
				
				ThisForm.RefreshForms( This.Parent.pgfPO.pgPODesc.cmbForm.Value )
		
				*ThisForm.PO_SaveAdd("EDIT")
				IF This.parent.pgfPO.ActivePage=3 &&POTesting
					PRIVATE lcPOitem
					lcPOitem = Proper_PO_Item( This.parent.lstPoItems.Value )
					IF ThisForm.POEditing 
						lcPOitem = Proper_PO_Item( STR(This.parent.pgPODesc.txtHpapo.Value)+"-"+STR(This.parent.pgPODesc.txtItemPo.Value) )
					ENDIF
					IF Proper_PO_Item(lcPOitem)!='        0-00'
						ThisForm.POitem = lcPOitem 
					ENDIF
					IF Count_POIteminPO_Testing( lcPOitem, ThisForm.nConnHandle ) = 0
						IF MESSAGEBOX("Do you want to store Testing info with this PO?",4+32,"Create a Testing PO?")=6
							ThisForm.ShowPOTesting( 'NEW' )
						ELSE
							ThisForm.ShowPOTesting( 'BLANK' )
						ENDIF
					ELSE
						ThisForm.ShowPOTesting( lcPOitem )
						THISFORM.POTestingScreen("ENABLE")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.cmdPoNext.Click
		ThisForm.cmdNext.Click
	ENDPROC

	PROCEDURE frmPO.cmdPoPrev.Click
		ThisForm.cmdPrev.Click
		
	ENDPROC

	PROCEDURE frmPO.cmdPrintPO.Click
		PRIVATE cPOCompany, cPOName, lPrintSheetPk, lPrintEvenCancelled
		cPOCompany	= ALLTRIM(This.Parent.pgfPO.pgPODesc.txtCompany.VALUE)
		cPOName		= ALLTRIM(This.Parent.pgfPO.pgPODesc.txtPOSalesName.VALUE)
		lPrintSheetPk = .F.
		lPrintEvenCancelled = .T.
		
		PRIVATE nHpaPo
		nHpaPo = PrepareSQLnum(This.Parent.pgfPO.pgPODesc.txtHpapo.VALUE,'HPAPO',-3)
		
		PRIVATE nContactID
		nContactID = PrepareSQLnum(ThisForm.nContactID,'ContactID',-3)
		
		PRIVATE nCntPOitem 
		nCntPOitem = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle, 'Cancelled' )
		
		IF nCntPOitem > 0
			IF MESSAGEBOX("Do you want the Cancelled item"+IIF(nCntPOitem>1,"'s",'')+" to be printed ?",4+32,"Found Cancelled item"+IIF(nCntPOitem>1,"'s",'')+" in this PO")= 6
				lPrintEvenCancelled = .T.
			ELSE
				lPrintEvenCancelled = .F.
			ENDIF
		ENDIF
		
		IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle, 'Sheet_PK' ) > 0
			lPrintSheetPk = .T.
		ENDIF
		
		*!*	 SEEK nHpaPo IN PurchaseOrder ORDER TAG HpaPO
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE HpaPO = "+STR(nHpaPo)+""
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PurchaseOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PurchaseOrder' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
		ENDIF
		
		SELECT PurchaseOrder
		INDEX ON ValPOitem(POitem) TAG VALPOitem
		SET ORDER TO VALPOitem
		
		PRIVATE lFoundVendor
		lFoundVendor = SelectVendor(PurchaseOrder.VendCode, PurchaseOrder.Company, ThisForm.nConnHandle)
		
		PRIVATE cSQL, nSQLEXEC
		**Get ShipAddr **
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE ShipCode = "+STR(PurchaseOrder.POShipAddr)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		ENDIF
		
		**Get VendorContact **
		SelectVendorContact(PurchaseOrder.ContactID,ThisForm.nConnHandle)
		
		IF nHpaPo > 0
		*	THISFORM.VISIBLE = .F.
			IF MESSAGEBOX("Do You want to Print/Preview this PO:"+ALLTRIM(STR(nHpaPo))+"?",4+32,'You must preview to print.') = 6
				ThisForm.AlwaysOnTop = .F.
				
				SELECT PurchaseOrder
				IF NOT lPrintSheetPk
					IF lPrintEvenCancelled
						*do NOT Print Sheet Packing Instructions
						*NC is to Not print Cancelled items
						IF FILE('\reports\PurchaseOrder09.FRX')
							REPORT FORM \reports\PurchaseOrder09.FRX FOR HpaPo = nHpaPo PREVIEW
							IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
								REPORT FORM \reports\PurchaseOrder09.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
							ENDIF
						ELSE
							IF FILE('reports\PurchaseOrder09.FRX')
								REPORT FORM reports\PurchaseOrder09.FRX FOR HpaPo = nHpaPo PREVIEW
								IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
									REPORT FORM reports\PurchaseOrder09.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
								ENDIF
							ELSE
								WAIT WINDOW "Report form '\reports\PurchaseOrder09' not found" NOWAIT
							ENDIF
						ENDIF
					ELSE
						IF FILE('\reports\PurchaseOrder09nc.FRX')
							REPORT FORM \reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo PREVIEW
							IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
								REPORT FORM \reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
							ENDIF
						ELSE
							IF FILE('reports\PURCHASEORDER09nc.FRX')
								REPORT FORM reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo PREVIEW
								IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
									REPORT FORM reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
								ENDIF
							ELSE
								WAIT WINDOW "Report form 'reports\PurchaseOrder09nc' not found" NOWAIT
							ENDIF
						ENDIF
					ENDIF
				ELSE
					*Print Sheet Pack Policy
					IF lPrintEvenCancelled
						IF FILE('\reports\PurchaseOrder09_sheet.FRX')
							REPORT FORM \reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo PREVIEW
							IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
								REPORT FORM \reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
							ENDIF
						ELSE
							IF FILE('reports\PurchaseOrder09_sheet.FRX')
								REPORT FORM reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo PREVIEW
								IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
									REPORT FORM reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
								ENDIF
							ELSE
								WAIT WINDOW "Report form 'reports\PurchaseOrder09_sheet' not found" NOWAIT
							ENDIF
						ENDIF
					ELSE
						IF FILE('\reports\PurchaseOrder09_sheetNC.FRX')
							REPORT FORM \reports\PurchaseOrder09_sheetNC.FRX FOR HpaPo = nHpaPo PREVIEW
							IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
								REPORT FORM \reports\PurchaseOrder09_sheetNC.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
							ENDIF
						ELSE
							IF FILE('reports\PurchaseOrder09_sheetNC.FRX')
								REPORT FORM reports\PurchaseOrder09_sheetNC.FRX FOR HpaPo = nHpaPo PREVIEW
								IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
									REPORT FORM reports\PurchaseOrder09_sheetNC.FRX FOR HpaPo = nHpaPo PREVIEW &&NOCONSOLE TO PRINTER
								ENDIF
							ELSE
								WAIT WINDOW "Report form 'reports\PurchaseOrder09_sheetNC' not found" NOWAIT
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				
				ThisForm.AlwaysOnTop = .T.
				
			ENDIF
			*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-**-
		*!*		IF MESSAGEBOX("Do You want to Fax this?",4+32,'') = 6
		*!*			
		*!*			PRIVATE lWinFax, lMSFax, nPrinters
		*!*			*MAKE SURE WINFAX IS known as a PRINTER
		*!*			nPrinters=APRINTERS(aaprinters)
		*!*			lWinFax = .F.
		*!*			lMSFax = .F.
		*!*			FOR CT = 1 TO nPrinters
		*!*				IF aaprinters(CT,1)="WinFax"
		*!*					lWinFax = .T.
		*!*				ENDIF
		*!*				IF aaprinters(CT,1)="Fax"
		*!*					lMSFax = .T.
		*!*				ENDIF
		*!*			NEXT CT
		*!*			IF !lWinFax AND !lMSFax 
		*!*				IF MESSAGEBOX("Did not find WinFax or Windows Fax in list of printers."+CHR(13)+"Press 'Yes' to Abort"+CHR(13)+"'No' to atempt." ,4+16,"WinFax not a Print Device") = 6
		*!*	*				THISFORM.VISIBLE = .T.
		*!*					RETURN .F.
		*!*				ENDIF
		*!*			ENDIF
		
		
		*!*			Q_faxnm=""
		
		*!*			IF nContactID > 0
		*!*				Q_faxnm  = VendorContactFax_ContactID(nContactID,ThisForm.nConnhandle)
		*!*			ENDIF
		*!*			IF EMPTY(Q_faxnm)
		*!*				DO FORM Forms\GetNumber WITH cPOCompany,"FAX" TO Q_faxnm
		*!*			ENDIF
		*!*			
		*!*			IF EMPTY(Q_faxnm)
		*!*				MESSAGEBOX("No Fax number",0,'')
		*!*	*			THISFORM.VISIBLE = .T.
		*!*				RETURN .F.
		*!*			ENDIF
		*!*	        
		*!*			Q_faxnm = FaxProper( Q_faxnm )
		
		*!*			IF lMSFax AND NOT lWinFax 
		*!*				SET PRINTER TO NAME 'Fax'
		*!*				
		*!*				PRIVATE FaxServer, lcMachine, FaxDoc  
		*!*				FaxServer=createobject('FAXCOMEX.faxserver')
		*!*				lcMachine = GETWORDNUM(SYS(0),1) && somewhat simpler code; wOOdy
		*!*				FaxServer.Connect( lcMachine )
		*!*				FaxDoc = CreateObject("FAXCOMEX.FaxDocument")
		*!*				FaxDoc.DocumentName = "PurchaseOrder"
		*!*				FaxDoc.Recipients.Add (Q_faxnm)
		*!*			ELSE
		*!*				PRIVATE oWFSend
		*!*				* Set the printer to WinFax to fax a report
		*!*				* if printer "WinFax" does not exist then they don't have WinFax on the PC.  If it was renamed then tough.
		*!*				SET PRINTER TO NAME 'WinFax'
		*!*				*
		*!*				oWFSend = CREATEOBJECT("WinFax.SDKSend")
		*!*				oWFSend.SetClientID(SalesQuote.SalesP)
		*!*				*
		*!*				oWFSend.EnableBillingCodeKeyWords (0)  &&0=disabled
		*!*				oWFSend.SetUseCover (0)
		*!*				oWFSend.SetQuickCover (0)
		*!*				oWFSend.SetCoverFile ("CoverSheet")
		*!*				IF .F.
		*!*					oWFSend.SetCoverText ("CoverText")
		*!*				ENDIF
		*!*				oWFSend.SetResolution (1)
		*!*				oWFSend.SetDeleteAfterSend (0)  && set to 0 to not delete
		*!*				oWFSend.ShowCallProgess (1)
		*!*				oWFSend.ShowSendScreen (0)
		*!*				**************************************************************
		*!*				*
		*!*				*DO \Progs\wfxpara.prg WITH q_faxnm,TIME(),DATE(),Quotes.name,Quotes.company,"Quotation","FAX",STR(Quotes.inqnum,8),"sndquote",.T.,.T.
		
		*!*				oWFSend.SetNumber(Q_faxnm)
		*!*				oWFSend.SetSubject("PurchaseOrder")
		*!*				oWFSend.SetCompany(cPOCompany)
		*!*				oWFSend.SetTo(cPOName)
		*!*				oWFSend.AddRecipient
		*!*				* Tell WinFax we are going to print a report to it.
		*!*				oWFSend.SetPrintFromApp(1)
		*!*				oWFSend.SEND (1)
		*!*				* SDK manual says usage is strongly recommended.
		*!*				oWFSend.LeaveRunning()
		*!*				**************************************
		*!*			ENDIF
				
		*!*			* Put your report here
		*!*			SELECT PurchaseOrder
		*!*			IF lPrintSheetPk
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('\reports\PurchaseOrder09_sheet.FRX')
		*!*						REPORT FORM \reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						IF FILE('reports\PurchaseOrder09_sheet.FRX')
		*!*							REPORT FORM reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*						ELSE
		*!*							WAIT WINDOW "Report form '\reports\PurchaseOrder09_sheet' not found" NOWAIT
		*!*						ENDIF
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('\reports\PurchaseOrder09_sheetnc.FRX')
		*!*						REPORT FORM \reports\PurchaseOrder09_sheetnc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						IF FILE('\reports\PurchaseOrder09_sheetnc.FRX')
		*!*							REPORT FORM \reports\PurchaseOrder09_sheetnc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*						ELSE
		*!*							WAIT WINDOW "Report form '\reports\PurchaseOrder09_sheetnc' not found" NOWAIT
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*			ELSE
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('\reports\PurchaseOrder09_sheetnc.FRX')
		*!*						REPORT FORM \reports\PurchaseOrder09_sheetnc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						IF FILE('reports\PurchaseOrder09_sheetnc.FRX')
		*!*							REPORT FORM reports\PurchaseOrder09_sheetnc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*						ELSE
		*!*							WAIT WINDOW "Report form '\reports\PurchaseOrder09' not found" NOWAIT
		*!*						ENDIF
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('\reports\PurchaseOrder09nc.FRX')
		*!*						REPORT FORM \reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						IF FILE('reports\PurchaseOrder09nc.FRX')
		*!*							REPORT FORM reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*						ELSE
		*!*							WAIT WINDOW "Report form '\reports\PurchaseOrder09nc' not found" NOWAIT
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		
		*!*			IF lMSFax AND NOT lWinFax 
		*!*				JobID = 0
		*!*				JobID = FaxDoc.ConnectedSubmit(FaxServer)
		*!*				INKEY(1)
		*!*				IF JobID > 0
		*!*					=MESSAGEBOX('An error occured sending the fax.',48, 'Fax')
		*!*				ENDIF
		*!*				
		*!*				RELEASE FaxServer
		*!*				RELEASE FaxDoc
		*!*			ELSE
		*!*				**************************************
		*!*				*
		*!*				WAIT WINDOW NOWAIT 'Press Esc if Fax locks.'
		*!*				DO WHILE oWFSend.IsEntryIDReady(0) <> 1
		*!*					* Use this loop to make sure WinFax is ready for
		*!*					* the next fax before you exit this procedure.
		*!*					* Esc allows the user to exit if something hangs.
		*!*					IF LASTKEY() = 27
		*!*						EXIT
		*!*					ENDIF
		*!*				ENDDO
		*!*				WAIT CLEAR
		*!*				*
		*!*				* get the messageid for the conformation.
		*!*				mMessageId = oWFSend.GetEntryID(0)
		*!*				*
		*!*				***************************************************************
		*!*				*
		*!*				mError = oWFSend.GetLastError()
		*!*				IF mError <> 0
		*!*					=MESSAGEBOX('An error occured sending the fax.',48, 'Fax')
		*!*				ENDIF
		*!*				*
		
		*!*				oWFSend.Done()
		*!*				RELEASE oWFSend
		*!*			ENDIF
		*!*			
		*!*			
		*!*			SET PRINTER OFF
		*!*			SET PRINTER TO DEFAULT
		
		*!*			WAIT WINDOW 'Fax routine done' NOWAIT
		*!*		ENDIF
			
			*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
		***************************************************	
			IF MESSAGEBOX("Do You want to Email this?",4+32,'') = 6
		
		
				PRIVATE cEmail,	cEmailTo,cEmailFrom,cFileName,cFileName2,cNewPDFName,cSubject,cMessage
				PRIVATE nPrinters,lWinFax,CT
				cEmailFrom = ""
				
				IF TYPE("LoginServer") != "C"
					IF FILE(SYS(5)+SYS(2003)+"\MEM\"+"HPASetup.MEM")
						RESTORE FROM (SYS(5)+SYS(2003)+"\MEM\"+"HPASetup.MEM") ADDITIVE
					ELSE
						MESSAGEBOX("RESTORE FROM HPASetup.MEM ADDITIVE",0,"File Not Found!")
						RETURN .F.
					ENDIF
				ENDIF
			
				cEmailTo = ""
				IF nContactID = 0
					MESSAGEBOX("No Vendor Email Address!"+CHR(13)+"Vendor Contact was not saved to PO!",48,"Need Email address.")
					DO FORM Forms\GetNumber WITH cPOCompany,"EMAIL" TO cEmailTo
				ELSE
					cEmailTo = VendorContactEmail_ContactID(nContactID,ThisForm.nConnhandle)
				ENDIF
				IF EMPTY(cEmailTo)
					MESSAGEBOX("Did not get Vendor Email Address!"+CHR(13)+"Vendor Contact may not have been saved to PO!",48,"Need Email address.")
					DO FORM Forms\GetNumber WITH cPOCompany,"EMAIL" TO cEmailTo
				ENDIF
		
				IF EMPTY(cEmailTo)
					MESSAGEBOX("No Email Address",0+16,"Cannot procede")
					RETURN .F.
				ENDIF
				
				cEmailFrom	= ALLTRIM(SalesPEmail( SalesQuote.SalesP ))
				cFileName = EmailFileName("HPA_PO.PDF")
				
				cNewPDFName	= "PO_"+ALLTRIM(STR(nHpaPo))+".pdf"
				cSubject	= "PO# "+ALLTRIM(STR(nHpaPo))+" from High Performance Alloys."
				cMessage	= ""
		
			
				SELECT Quotes
				DO WHILE FILE(cFileName)
					nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+cFileName+" already exists"+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
					IF nMess = 7 &&No
						DELETE FILE (cFileName)
					ENDIF
				ENDDO
				
				THISFORM.AlwaysOnBottom = .T.
		
		*******************************************************
				*-- Get a reference to the Listener class from the Listener.vcx
				loListener = NEWOBJECT("Listener", "Libs\Listener.VCX")	
						
				IF TYPE('loListener') = 'O'
					*-- Turn off UI feedback and user prompts at end of run
					loListener.QUIETMODE = .T.
					PRIVATE lcOutPutFileName, lcOutPutFilePath 
					lcOutPutFileName = JUSTSTEM(cFileName)
					lcOutPutFilePath = JUSTPATH(cFileName)
		
					IF NOT "FRX2ANY" $ SET("CLASSLIB")
						SET CLASSLIB TO 'LIBS\FRX2Any' ADDITIVE 
					ENDIF
		
					loListener.oFRX2Any = CREATEOBJECT('FRX2Any.PDFFile')
					
					IF TYPE('loListener.oFRX2Any') = 'O'
						loListener.oFRX2Any.UNLOCK('xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx')
						loListener.oFRX2Any.cExportFileName = lcOutPutFileName
						loListener.oFRX2Any.cSaveFolder     = lcOutPutFilePath
						loListener.oFRX2Any.nOutPutType     = 4 &&cnOUTPUT_FILE
										
						WAIT WINDOW "Making PDF" NOWAIT
						
						*ThisForm.Visible = .F.
						SELECT PurchaseOrder
						IF lPrintSheetPk
							IF lPrintEvenCancelled
								IF FILE('\reports\PurchaseOrder09_sheet.FRX')
									REPORT FORM \reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo Object loListener
								ELSE
									IF FILE('reports\PurchaseOrder09_sheet.FRX')
										REPORT FORM reports\PurchaseOrder09_sheet.FRX FOR HpaPo = nHpaPo Object loListener
									ELSE
										WAIT WINDOW "Report form '\reports\PurchaseOrder09_sheet' not found" NOWAIT
									ENDIF
								ENDIF
							ELSE
								IF FILE('\reports\PurchaseOrder09_sheetnc.FRX')
									REPORT FORM \reports\PurchaseOrder09_sheetnc.FRX FOR HpaPo = nHpaPo Object loListener
								ELSE
									IF FILE('reports\PurchaseOrder09_sheetnc.FRX')
										REPORT FORM reports\PurchaseOrder09_sheetnc.FRX FOR HpaPo = nHpaPo Object loListener
									ELSE
										WAIT WINDOW "Report form '\reports\PurchaseOrder09_sheetnc' not found" NOWAIT
									ENDIF
								ENDIF
							ENDIF
						ELSE
							IF lPrintEvenCancelled
								IF FILE('\reports\PurchaseOrder09.FRX')
									REPORT FORM \reports\PurchaseOrder09.FRX FOR HpaPo = nHpaPo Object loListener
								ELSE
									IF FILE('reports\PurchaseOrder09.FRX')
										REPORT FORM reports\PurchaseOrder09.FRX FOR HpaPo = nHpaPo Object loListener
									ELSE
										WAIT WINDOW "Report form '\reports\PurchaseOrder09' not found" NOWAIT
									ENDIF
								ENDIF
							ELSE
								IF FILE('\reports\PurchaseOrder09nc.FRX')
									REPORT FORM \reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo Object loListener
								ELSE
									IF FILE('reports\PurchaseOrder09nc.FRX')
										REPORT FORM reports\PurchaseOrder09nc.FRX FOR HpaPo = nHpaPo Object loListener
									ELSE
										WAIT WINDOW "Report form '\reports\PurchaseOrder09nc' not found" NOWAIT
									ENDIF
								ENDIF
							ENDIF
						ENDIF
		
						THISFORM.AlwaysOnBottom = .F.
						THISFORM.ALWAYSONTOP = .T.
		
						SET PRINTER OFF
						SET PRINTER TO DEFAULT
		
						PRIVATE cAns
						cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisForm.nConnhandle, cNewPDFName)
		
						DO CASE
						CASE "Mail queued" $ cAns
							WAIT WINDOW "Mail queued." NOWAIT
							TrackMess("PO "+ALLTRIM(STR(nHpaPo))+" Purchase Order was Emailed to ("+cEmailTo+") on ("+DTOC(DATE())+")"  +" frmEdt.cmdPrintPO.Click()")
						CASE NOT EMPTY(cAns)
							MESSAGEBOX( cANS,0,"SQL Returned Message!")
						OTHERWISE
							WAIT WINDOW "Email Complete" NOWAIT
							TrackMess("Purchase Order "+ALLTRIM(STR(nHpaPo))+" was Emailed to ("+cEmailTo+") on ("+DTOC(DATE())+")" +" frmEdt.cmdPrintPO.Click()" )
						ENDCASE
					ENDIF
				ENDIF
			ENDIF	
		ELSE
			MESSAGEBOX("No HPA PO Number!!!")
		ENDIF
		
		SELECT SalesQuote
		ThisForm.pf.pgOrder.txtItem.Refresh()
		ThisForm.pf.pgQuote.txtItem.Refresh()
		
		THISFORM.pf.pgQuote.txtItemSale.Refresh()
		THISFORM.pf.pgQuote.txtItemCost.Refresh()
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPO.cmdPrintPO.When
		IF THIS.CAPTION = "Print PO"
		
			IF EMPTY(This.Parent.pgfPO.pgPODesc.txtHpapo.VALUE)
				WAIT WINDOW 'Enter PO first' NOWAIT
				RETURN .F.
			ENDIF
		
			IF This.Parent.pgfPO.pgPODesc.txtItemPo.VALUE < 1
				=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
				RETURN .F.
			ENDIF
		
			IF EMPTY(ALLTRIM(This.Parent.pgfPO.pgPODesc.txtCompany.VALUE))
				=MESSAGEBOX("Purchase Order needs the Company Purchased from entered.",16,"Invalid input")
				RETURN .F.
			ENDIF
		ELSE
		
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.lstPoItems.Click
		PRIVATE lcPOitem, nCntPOitem
		lcPOitem = Proper_PO_Item( This.Value )
		nCntPOitem = Count_POIteminPurchaseOrder( lcPOitem, ThisForm.nConnHandle )
		
		
		IF USED('tmpPOitemDetail')
			USE IN tmpPOitemDetail
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.PurchaseOrder "
		IF nCntPOitem = 0
			cSQL = cSQL + " WHERE 0>0"
			ThisForm.POitem = ''
		ELSE
			cSQL = cSQL + " WHERE POitem = '"+lcPOitem +"'"
			ThisForm.POitem = lcPOitem 
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitemDetail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOitemDetail' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOitemDetail' )
		ENDIF
		
		IF USED('tmpPOitemDetail')
			*check Show_PO() for fields that need to be flipped on/off
			IF VARTYPE(tmpPOitemDetail.PoItem) = "C"
				SELECT tmpPoItemDetail 
				SCATTER MEMVAR MEMO 
				*Strip Time from Date
				m.OrderDate	= PrepareSQLdate(m.OrderDate,'OrderDate')
				m.Due_Min	= PrepareSQLdate(m.Due_Min,'Due_Min')
				m.Due_Max	= PrepareSQLdate(m.Due_Max,'Due_Max')
				m.HPA_Due_Min	= PrepareSQLdate(m.HPA_Due_Min,'HPA_Due_Min')
				m.HPA_Due_Max	= PrepareSQLdate(m.HPA_Due_Max,'HPA_Due_Max')
				IF tmpPoItemDetail.Cancelled
					This.Parent.chkCancelPO.Value = 1
				ELSE
					This.Parent.chkCancelPO.Value = 0
				ENDIF
				This.Parent.chkCancelPO.Enabled = .T.
				This.Parent.chkDeliveredPO.Value = IIF(ISNULL(tmpPoItemDetail.Delivered),0,tmpPoItemDetail.Delivered)
		
				This.Parent.pgfPO.pgPODesc.chkSPS1.Value = IIF(ISNULL(tmpPoItemDetail.Sheet_pk),0,tmpPoItemDetail.Sheet_pk)
				This.Parent.pgfPO.pgPODesc.chkServicesPO.Value = IIF(ISNULL(tmpPoItemDetail.Services),0,tmpPoItemDetail.Services)
				This.Parent.pgfPO.pgPODesc.chkConvServ.Value = IIF(ISNULL(tmpPoItemDetail.ConvServ),0,tmpPoItemDetail.ConvServ)
				This.Parent.pgfPO.pgPODesc.chkRandLen.Value = IIF(ISNULL(tmpPoItemDetail.RandLen),0,tmpPoItemDetail.RandLen)
				This.Parent.pgfPO.pgPODesc.chkMetric.Value = IIF(ISNULL(tmpPoItemDetail.Metric),0,tmpPoItemDetail.Metric)
				
				This.parent.pgfPO.pgPODesc.txtStockLst_QTY.Value = PrepareSQLnum(tmpPoItemDetail.StockLst_QTY,'StockLst_QTY',-5)
				This.parent.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(tmpPoItemDetail.StockLst_P,'StockLst_P',-5)
				
				IF tmpPoItemDetail.VendCode > 0
		*				ThisForm.pf.pg_po.pgfPO.pgPODesc.chkVendor.VALUE	= .T.
					ThisForm.VendCode	= PrepareSQLnum(tmpPoItemDetail.VendCode,'VendCode',-3)
					ThisForm.nContactID	= PrepareSQLnum(tmpPoItemDetail.ContactID,'ContactID',-3)
					This.parent.pgfPO.pgPODesc.lblVendCode.Caption	= STR(tmpPoItemDetail.VendCode)
					This.parent.pgfPO.pgVendor.txtVendCode.Value	= tmpPoItemDetail.VendCode
					This.parent.pgfPO.pgPODesc.lblPeachID.Caption = getPeachID_VendCode(tmpPoItemDetail.VendCode)
				ELSE
					ThisForm.VendCode	= 0
					ThisForm.nContactID	= 0
		*				ThisForm.pf.pg_po.pgfPO.pgPODesc.chkVendor.VALUE	= .F.
					This.parent.pgfPO.pgPODesc.lblVendCode.Caption = ''
					This.parent.pgfPO.pgVendor.txtVendCode.Value	= 0
					This.parent.pgfPO.pgPODesc.lblPeachID.Caption = ''
				ENDIF
		
				This.Parent.cmdPOAdd.Enabled = .T.
				This.Parent.cmdPrintPO.Enabled = .T.
				This.Parent.cmdPODelete.Enabled = .T.
				This.Parent.cmdPOEdit.Enabled = .T.
		
				IF TYPE("m.ShipWhere") != "N"
					m.ShipWhere = 0
				ENDIF
				ThisForm.ShipWhereChange(m.ShipWhere) &&,cCompany,cCity
				
				IF TYPE("m.POShipAddr") != "N"
					m.POShipAddr= 0
				ENDIF
				
				ThisForm.POShipAddr = tmpPoItemDetail.POShipAddr
				
				IF TYPE("m.VendCode") != "N"
					m.VendCode = 0
				ENDIF
				IF ISNULL(tmpPoItemDetail.CC)
					m.CC = '1'
				ENDIF
				This.Parent.pgfPO.pgPOAddress.opgPOShipTo.Refresh
				This.Parent.pgfPO.pgPOAddress.txtPOShipAddr.Refresh
				This.parent.pgfPO.pgVendor.txtVendCode.Refresh
				
				This.Parent.REFRESH
				This.Parent.pgfPO.pgPODesc.Refresh
				This.Parent.pgfPO.pgPOAddress.Refresh
			ELSE
				SELECT tmpPoItemDetail 
				SCATTER MEMVAR MEMO BLANK
				*Strip Time from Date
				m.OrderDate	= PrepareSQLdate(m.OrderDate,'OrderDate')
				m.Due_Min	= PrepareSQLdate(m.Due_Min,'Due_Min')
				m.Due_Max	= PrepareSQLdate(m.Due_Max,'Due_Max')
				m.HPA_Due_Min	= PrepareSQLdate(m.HPA_Due_Min,'HPA_Due_Min')
				m.HPA_Due_Max	= PrepareSQLdate(m.HPA_Due_Max,'HPA_Due_Max')
				
				This.Parent.chkCancelPO.Value = 0
				This.Parent.chkCancelPO.Enabled = .T.
				This.Parent.chkDeliveredPO.Value = 0
				This.Parent.pgfPO.pgPODesc.chkSPS1.Value = 0
				This.Parent.pgfPO.pgPODesc.chkServicesPO.Value = 0
				This.Parent.pgfPO.pgPODesc.chkConvServ.Value = 0
				This.Parent.pgfPO.pgPODesc.chkRandL.Value = 0
				
				This.parent.pgfPO.pgPODesc.txtStockLst_QTY.Value = 0
				This.parent.pgfPO.pgPODesc.txtStockLst_P.Value = 0
		
				This.Parent.cmdPOAdd.Enabled = .T.
				This.Parent.cmdPODelete.Enabled = .F.
				This.Parent.cmdPOEdit.Enabled = .F.
		
				IF TYPE("m.ShipWhere") != "N"
					m.ShipWhere = 0
				ENDIF
				ThisForm.ShipWhereChange(1)
				
				IF TYPE("m.POShipAddr") != "N"
					m.POShipAddr = 1
					ThisForm.POShipAddr = 1
				ENDIF
				
				IF TYPE("m.VendCode") != "N"
					m.VendCode = 0
				ENDIF
				IF TYPE("m.CC") != "C"
					m.CC = '1'
				ENDIF
				This.Parent.pgfPO.pgPOAddress.opgPOShipTo.Refresh
				This.Parent.pgfPO.pgPOAddress.txtPOShipAddr.Refresh
				
				This.Parent.REFRESH
				This.Parent.pgfPO.pgPODesc.Refresh
				This.Parent.pgfPO.pgPOAddress.Refresh
			ENDIF
			
			USE IN tmpPOitemDetail
		ENDIF
		
		
		This.Parent.pgfPO.pgPOAddress.txtHpapo.Value = This.Parent.pgfPO.pgPODesc.txtHpapo.Value
		This.Parent.pgfPO.pgPOAddress.txtItemPo.Value = This.Parent.pgfPO.pgPODesc.txtItemPo.Value
		
		
		ThisForm.ShowPOShipAddr( ThisForm.POShipAddr )
		
		ThisForm.ShowVendCode( ThisForm.VendCode )
		
		ThisForm.GetVendorContacts( ThisForm.nContactID )
		ThisForm.ShowVendorContact( ThisForm.nContactID )
		
		ThisForm.RefreshForms( This.Parent.pgfPO.pgPODesc.cmbForm.Value )
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPOAddress.cmbRemoteStock.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpRemoteStock')
			SELECT tmpRemoteStock
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT Location FROM dbo.StockLst_Location WITH(NOLOCK) WHERE RemoteStock = 1"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRemoteStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRemoteStock')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpRemoteStock')
		ENDIF
		
		DIMENSION aRemoteStock(1)
		*aRemoteStock(1,1) = "1"
		*aRemoteStock(1,2) = "Anneal"
		
		IF USED('tmpRemoteStock')
			SELECT * FROM tmpRemoteStock INTO ARRAY aRemoteStock
			
			USE IN tmpRemoteStock
		ENDIF
		
		This.Clear
		This.ColumnCount = 1
		This.NumberOfElements=ALEN(aRemoteStock)
		This.BoundColumn = 1
		This.ColumnWidths = "115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aRemoteStock,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aRemoteStock(I, 1),I,1)
		ENDFOR
		
		this.addListitem("*",I+1,1)
		
		This.Value = "*"
		*This.Value = "1"
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPOAddress.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF THISFORM.POShipAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
		
			ThisForm.Address_Screen("POShiptoSave")
			THIS.PARENT.cmdPOSearchShipTo.ENABLED = .T.
		
			ThisForm.VendCodeClear()
		ELSE
			IF THIS.PARENT.cmdEditAddr.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
		
					IF USED( 'aShipAddr' )
						USE IN aShipAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.ShipAddr "
					cSQL = cSQL + " WHERE ShipCode = "+STR(THISFORM.POShipAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
					ENDIF
					IF USED('aShipAddr')
						*thisform.ShipAddr = ShipAddr.ShipCode	
						THISFORM.POShipAddr = aShipAddr.ShipCode
						THIS.PARENT.txtPOShipAddr.VALUE = aShipAddr.ShipCode
						*THIS.PARENT.txtShipCode.VALUE	= aShipAddr.ShipCode
						THIS.PARENT.txtCompany.VALUE 	= aShipAddr.Company
						THIS.PARENT.txtAddr1.VALUE 		= aShipAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE 		= aShipAddr.Addr2
						THIS.PARENT.txtCity.VALUE 		= aShipAddr.City
						THIS.PARENT.txtST.VALUE 		= aShipAddr.ST
						THIS.PARENT.txtZip.VALUE 		= aShipAddr.Zip
						THIS.PARENT.txtCountry.VALUE 	= aShipAddr.Country
						THIS.PARENT.txtContact.VALUE 	= aShipAddr.Contact
						THIS.PARENT.txtPhone.VALUE 		= aShipAddr.Telephone
						THIS.PARENT.txtFax.VALUE 		= aShipAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE 		= aShipAddr.Email
						THIS.PARENT.txtLastEdit.VALUE	= PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')
						
						USE IN aShipAddr
					ENDIF
					
					ThisForm.Address_Screen("POShipToEdit")
		
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPOAddress.cmdEditAddr.Click
		PRIVATE	maxSoldCode, maxShipCode, oldSoldCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit, lnPOShipAddr 
		PRIVATE lcContact,lcPhone,lcFax,lcEmail
		
		lcCompany =THIS.PARENT.txtCompany.VALUE
		lcAddr1 = THIS.PARENT.txtAddr1.VALUE
		lcAddr2 = THIS.PARENT.txtAddr2.VALUE
		lcCity  = THIS.PARENT.txtCity.VALUE
		lcST    = THIS.PARENT.txtST.VALUE
		lcZip   = THIS.PARENT.txtZip.VALUE
		lcCountry = THIS.PARENT.txtCountry.VALUE
		lcContact = THIS.PARENT.txtContact.VALUE
		lcPhone	  = THIS.PARENT.txtPhone.VALUE
		lcFax	  = THIS.PARENT.txtFax.VALUE
		lcEmail	  = THIS.PARENT.txtEmail.VALUE
		ldLastEdit = DATE()
		
		*Check Data
		lcCompany	= PrepareSQLtxt( lcCompany,'Company',30 )
		lcAddr1		= PrepareSQLtxt( lcAddr1,'Addr1', 30 )
		lcAddr2		= PrepareSQLtxt( lcAddr2,'Addr2', 30 )
		lcCity		= PrepareSQLtxt( lcCity,'City', 20 )
		lcST		= PrepareSQLtxt( lcST,'ST', 2 )
		lcZip		= PrepareSQLtxt( lcZip,'Zip', 12 )
		lcCountry	= PrepareSQLtxt( lcCountry,'Country', 15 )
		lcContact	= PrepareSQLtxt( lcContact,'Contact', 20 )
		lcPhone		= PrepareSQLtxt( lcPhone,'Phone', 12 )
		lcFax		= PrepareSQLtxt( lcFax,'Fax', 12 )
		lcEmail		= PrepareSQLtxt( lcEmail,'Email', 60 )
		*ldLastEdit
		
		lnPOShipAddr = IIF(THISFORM.POShipAddr>0,THISFORM.POShipAddr, IIF(THISFORM.ShipAddr>0, THISFORM.ShipAddr, 0))
		*POShipAddr
		SaveAddr = .F.
		SaveAddress = .F.
		oldSoldCode = 0
		PRIVATE OLDSHIPCODE
		OLDSHIPCODE = 0
		
		IF THIS.CAPTION = "Save"
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))
				SaveAddress = .T.
			ENDIF
		
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!",0,'')
				SaveAddress = .F.
				RETURN .F.
			ENDIF
		
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(lnPOShipAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
			ENDIF
		
			IF USED('cntShipAddr')
				IF cntShipAddr.CNT > 0
					SaveAddress = .T.
					*Already have exact Address
					IF EMPTY(THISFORM.POShipAddr)
						*Find the ShipCode and display it
		
						IF USED( 'shipcode_ShipAddr' )
							USE IN shipcode_ShipAddr
						ENDIF
						SELECT 0
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT shipcode FROM dbo.ShipAddr "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"'"
		*				cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnPOShipAddr ))
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'shipcode_ShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'shipcode_ShipAddr' )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'shipcode_ShipAddr')
						ENDIF
						IF USED( 'shipcode_ShipAddr' )
							IF VARTYPE(shipcode_ShipAddr.shipcode) = "N"
								IF shipcode_ShipAddr.shipcode > 0
									THISFORM.POShipAddr = shipcode_ShipAddr.shipcode
									THIS.PARENT.txtPOShipAddr.REFRESH
								ENDIF			
							ENDIF
						
							USE IN shipcode_ShipAddr
						ENDIF
			
					ENDIF
				ELSE
					SaveAddress = .F.
				ENDIF
			ELSE
				SaveAddress = .F.
			ENDIF
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
		
		
		
			IF SaveAddress
				****** big save procedure********
				PRIVATE	cSaveNew
		
				IF lnPOShipAddr > 0
					IF lnPOShipAddr < 6
						*DO NOT overwrite the HPA locations!
						MESSAGEBOX( "You cannot edit the default HPA address'!"+CHR(13)+"This address will be saved as a new Address Code.",0+48,'Create new address')
						cSaveNew = 6
					ELSE
						cSaveNew = MESSAGEBOX("Use NO to save the address edits."+CHR(13)+"Use NEW address only when Company has moved."+CHR(13)+CHR(13)+"Save as new Address?",4+32,"Is this a New Address?")
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					cSaveNew = 6
				ENDIF
		
				IF cSaveNew = 6 && Yes, save as new
		
					*	Get maxSoldCode
					*maxSoldCode = THISFORM.maxSoldCode()
					*maxShipCode = THISFORM.maxShipCode()
					MaxSoldCode=get_MaxSoldCode()
					MaxShipCode=get_MaxShipCode()
					
					maxSoldCode= MAX( maxSoldCode, maxShipCode )
					maxSoldCode = maxSoldCode + 2 &&leave space for Shipto Edits
		
		*			IF NOT USED('ShipAddrCode')
		**				USE ShipAddrCode IN 0
		*			ENDIF
		
					IF lnPOShipAddr > 0
						*Check old ShipCode to see if anything changed
						IF USED( 'cntShipAddr' )
							USE IN cntShipAddr
						ENDIF
						SELECT 0
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS cnt FROM dbo.ShipAddr "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"' "
		*				cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(THISFORM.POShipAddr))
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
						ENDIF
						IF USED('cntShipAddr')
							IF cntShipAddr.Cnt = 0
		*						no change - do not save
								SaveAddr = .F.
							ELSE &&did not match all Fields - Save
								SaveAddr = .T.
								oldShipCode = THISFORM.POShipAddr 
							ENDIF
						ELSE &&failed - add as new
							SaveAddr = .T.
						ENDIF 
					ELSE && No SoldCode just add new if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							SaveAddr = .T.
						ELSE
							SaveAddr = .T.
						ENDIF
					ENDIF
		
		
					IF SaveAddr
						DO WHILE FoundShipCode( maxShipCode, ThisForm.nConnHandle )
							maxShipCode = maxShipCode + 1
						ENDDO
		
						THIS.PARENT.txtPOShipAddr.VALUE = maxShipCode
		*				THIS.PARENT.numSoldAddr.VALUE = maxSoldCode
						ThisForm.POShipAddr = maxSoldCode
		
						Save_ShipAddrCode(maxShipCode, ALLTRIM(STR(maxShipCode,10,0)), oldShipCode, ThisForm.nConnHandle)
						
						PRIVATE cSQLi
						cSQLi = "INSERT INTO dbo.ShipAddr (shipcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email,Customer, LastEdit) VALUES "
						cSQLi = cSQLi+"("+STR(maxShipCode)+""
						cSQLi = cSQLi+",'"+lcCompany+"'"
						cSQLi = cSQLi+",'"+lcAddr1+"'"
						cSQLi = cSQLi+",'"+lcAddr2+"'"
						cSQLi = cSQLi+",'"+lcCity+"'"
						cSQLi = cSQLi+",'"+lcST+"'"
						cSQLi = cSQLi+",'"+lcZip+"'"
						cSQLi = cSQLi+",'"+lcCountry+"'"
						cSQLi = cSQLi+",'"+lcContact+"'"
						cSQLi = cSQLi+",'"+lcPhone+"'"
						cSQLi = cSQLi+",'"+lcFax+"'"
						cSQLi = cSQLi+",'"+lcEmail+"'"
						cSQLi = cSQLi+",''"		&&+STR(maxShipCode)+""
						cSQLi = cSQLi+",'"+IIF(EMPTY(ldLastEdit),'',DTOC(ldLastEdit))+"' )"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
						
		
						THISFORM.UpdateCustID = .T.
		
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
		
					ENDIF
				ELSE
					*Save - not as new!
					*REPLACE DATA
		
		*!*	*			UPDATE ShipAddr SET ;
		*!*					Company = lcCompany, ;
		*!*					Addr1 = lcAddr1, ;
		*!*					Addr2 = lcAddr2, ;
		*!*					City  = lcCity, ;
		*!*					ST    = lcST, ;
		*!*					Zip   = lcZip, ;
		*!*					Country = lcCountry, ;
		*!*					Contact = lcContact, ;
		*!*					Telephone = lcPhone, ;
		*!*					Fax_Number = lcFax, ;
		*!*					Email = lcEmail, ;
		*!*					LastEdit = ldLastEdit ;
		*!*					WHERE shipcode =  lnPOShipAddr
		
					*	THISFORM.UpdateCustID = .T.
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.ShipAddr SET "
					cSQLu= cSQLu+"Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
					cSQLu= cSQLu+",Customer=''"
					cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+" WHERE shipcode = "+STR(lnPOShipAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
					
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
				ENDIF
			ENDIF
			
		
			
			ThisForm.Address_Screen("POShipToEdit")
			THISFORM.cmdNext.SETFOCUS()
		
		ELSE &&Caption was Edit
			ThisForm.Address_Screen("POShiptoSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPOAddress.cmdPOSearchShipTo.Click
		Private matchCodes, nNewShipToCode, lcCurrTable 
		nNewShipToCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		
		PRIVATE cCompany
		cCompany = ALLTRIM(SalesQuote.company)
		
		IF EMPTY(cCompany)
			cCompany = This.Parent.cmbRemoteStock.Value 
			IF cCompany = "*"
				cCompany = ''
			ENDIF
		ENDIF	
		
		DO FORM Forms\SearchForm WITH "ShipAddr",cCompany  TO nNewShipToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nNewShipToCode > 0
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(nNewShipToCode)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
			ENDIF
					
			IF USED('aShipAddr') 
				ThisForm.POShipAddr = aShipAddr.ShipCode
				This.Parent.txtPOShipAddr.Value = aShipAddr.ShipCode
		*		This.Parent.numShipAddr.Value = aShipAddr
				This.Parent.txtCompany.Value = aShipAddr.Company
				This.Parent.txtAddr1.Value = aShipAddr.Addr1
				This.Parent.txtAddr2.Value = aShipAddr.Addr2
				This.Parent.txtCity.Value = aShipAddr.City
				This.Parent.txtST.Value = aShipAddr.ST
				This.Parent.txtZip.Value = aShipAddr.Zip
				This.Parent.txtCountry.Value = aShipAddr.Country
				This.Parent.txtContact.Value = aShipAddr.Contact
				This.Parent.txtPhone.Value = aShipAddr.Telephone
				This.Parent.txtFax.Value = aShipAddr.Fax_Number
				This.Parent.txtEmail.Value = aShipAddr.Email
				This.Parent.txtLastEdit.Value = PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')
				
				ThisForm.Address_Screen("POShipToEdit")
			EndIf
		
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPOAddress.opgPOShipTo.InteractiveChange
		*!*	PRIVATE cCompany, cCity
		*!*	cCompany = UPPER(ALLTRIM(This.Parent.txtCompany.Value))
		*!*	cCity	= UPPER(ALLTRIM(This.Parent.txtCity.Value))
		
		*!*	ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Visible = .T.
		*!*	ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Visible = .T.
		*!*	ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Visible = .T.
		
		*!*	DO CASE
		*!*	CASE This.Value = 1
		*!*		IF NOT ( UPPER(cCompany) = "HIGH PERFORMANCE ALLOYS" AND UPPER(cCity) = "TIPTON" )
		*!*			ThisForm.POShipTO(1)
		*!*		ENDIF
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		*!*	CASE This.Value = 5
		*!*		IF NOT ( UPPER(cCompany) = "HIGH PERFORMANCE ALLOYS" AND UPPER(cCity) = "WINDFALL" )
		*!*			ThisForm.POShipTO(5)
		*!*		ENDIF
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		*!*		
		*!*	OTHERWISE
		*!*	*!*		IF !EMPTY(cCompany)
		*!*	*!*			IF MESSAGEBOX( "Do you want to overwrite the current Address",4,"PO Ship to" ) = 6
		*!*	*!*				ThisForm.POShipTO( This.Value)
		*!*	*!*			ENDIF
		*!*	*!*		ELSE
		*!*	*!*			ThisForm.POShipTO( This.Value)
		*!*	*!*		ENDIF
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
		*!*	ENDCASE
		
		ThisForm.ShipWhereChange(This.Value,This.Parent.txtCompany.Value,This.Parent.txtCity.Value)
		
		PRIVATE nShipWhere
		nShipWhere = This.Value
		
		DO CASE
		CASE nShipWhere = 1
			*HPA Tipton
		*	This.parent.parent.pgDesc.cmbShipWhere
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 1
		CASE nShipWhere = 2
			*DIRECT
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 2
		CASE nShipWhere = 3
			*Blind
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 3
		CASE nShipWhere = 4
			*Service
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 4
		CASE nShipWhere = 5
			*HPA Windfall
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 5
		CASE nShipWhere = 6
			*RemoteStock
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 6
		ENDCASE
		This.parent.parent.pgPODesc.cmbShipWhere.Refresh
		
		*1 HPA Tipton,2 DIRECT,3 Blind,4 Service,5 HPA Windfall,6 RemoteStock
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPOAddress.txtCompany.GotFocus
		IF EMPTY(This.Value) AND This.Parent.cmdEditAddr.Caption = "Save"
			This.Value = SalesQuote.Company
			
			IF EMPTY(This.Parent.txtContact.Value)
				This.Parent.txtContact.Value = SalesQuote.name
			ENDIF
			IF EMPTY(This.Parent.txtPhone.Value)
				This.Parent.txtPhone.Value = SalesQuote.Phone+SalesQuote.Phone_ext
			ENDIF
			IF EMPTY(This.Parent.txtFax.Value)
				This.Parent.txtFax.Value = SalesQuote.Fax
			ENDIF
			IF EMPTY(This.Parent.txtEmail.Value	)
				This.Parent.txtEmail.Value = SalesQuote.Email
			ENDIF
		ENDIF
	ENDPROC

