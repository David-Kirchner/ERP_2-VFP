		IF ThisForm.POEditing
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
		ENDIF
		
		PRIVATE lServices,lConvServ,lEquipment
		lServices = PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkServicesPO.Value,'Services')
		lConvServ = PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkConvServ.Value,'ConvServ')
		lEquipment = PrepareSQLchk(ThisForm.pf.pg_po.pgFPO.pgPOdesc.chkEquipment.Value,'Equipment')
		ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblPerUnit.Caption	= FormUnitCaption(pForm,lServices,lConvServ,lEquipment,ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE refreshitem
		THISFORM.ItemNumber = SalesQuote.ITEM_A
		
		THISFORM.pf.pgOrder.txtItem.REFRESH()
		THISFORM.pf.pgQuote.txtItem.REFRESH()
		*ThisForm.pf.pgQA.txtItem.Refresh()
	ENDPROC

	PROCEDURE refreshposcreen
		PARAMETER pForm
		*********************************************************************************
		** CHANGES HERE MUST BE REPLICATED TO PurchaseOrder, EnterOrder and PackingSlip
		** Form Changes must be made to Proc_Quotes.prg **
		*********************************************************************************
		*RefreshPOscreen()
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		IF GetFormCaptions(pForm,ThisForm.nConnHandle)
			IF USED('tmpFormCaptions')
				*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
				ThisForm.pf.pgQuote.LBLTHCK.Caption = RTRIM(tmpFormCaptions.txt1)
				ThisForm.pf.pgQuote.LBLSZ2.Caption = RTRIM(tmpFormCaptions.txt2)
				ThisForm.pf.pgQuote.LBLSZ3.Caption = RTRIM(tmpFormCaptions.txt3)
				ThisForm.pf.pgQuote.txtSZ3.Enabled = tmpFormCaptions.use3rdDim
				ThisForm.pf.pgQuote.txtSZ3.Visible = tmpFormCaptions.use3rdDim
				ThisForm.pf.pgQuote.LBLSZ4.Caption = RTRIM(tmpFormCaptions.txt4)
				USE IN tmpFormCaptions
			ELSE
				TrackMess( "tmpFormCaptions is not used!"+" frmEdt.RefreshPOscreen()")
			ENDIF
		ELSE
			TrackMess("GetFormCaptions returned False!"+" frmEdt.RefreshPOscreen()")
		ENDIF
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
		
		IF ThisForm.POEditing
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .T.
		ELSE
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSZ3.Enabled = .F.
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE refreshquotesforms
		PARAMETER pForm
		*********************************************************************************
		** CHANGES HERE MUST BE REPLICATED TO PurchaseOrder, EnterOrder and PackingSlip
		** Form Changes must be made to Proc_Quotes.prg **
		*********************************************************************************
		*RefreshQuotesForms()
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		SELECT 0
		
		IF VARTYPE(pForm) != "C"
			pForm = ""
		ENDIF
		IF NOT EMPTY(pForm)
			IF GetFormCaptions(pForm,ThisForm.nConnHandle)
				IF USED('tmpFormCaptions')
					*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
						ThisForm.pf.pgQuote.LBLTHCK.Caption = tmpFormCaptions.txt1
			*			ThisForm.pf.pgQuote.LBLSZ2.Visible = .T.
						ThisForm.pf.pgQuote.LBLSZ2.Caption = tmpFormCaptions.txt2
			*			ThisForm.pf.pgQuote.txtSZ2.Visible = .T.
			*			ThisForm.pf.pgQuote.LBLSZ3.Visible = .F.
						ThisForm.pf.pgQuote.LBLSZ3.Caption = tmpFormCaptions.txt3
						ThisForm.pf.pgQuote.txtSZ3.Visible = tmpFormCaptions.use3rdDim
			*			ThisForm.pf.pgQuote.txtSZ3.Enabled = tmpFormCaptions.use3rdDim
			*			ThisForm.pf.pgQuote.LBLSZ4.Visible = .T.
						ThisForm.pf.pgQuote.LBLSZ4.Caption = tmpFormCaptions.txt4
						? tmpFormCaptions.lblSz2Vis
						? tmpFormCaptions.lblSz3Vis
						? tmpFormCaptions.use3rdDim
						? tmpFormCaptions.Sz3Enable
						? tmpFormCaptions.lblSz4Vis
					USE IN tmpFormCaptions
				ELSE
					TrackMess( "tmpFormCaptions is not used!"+" frmEdt.RefreshForms()")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions returned False!"+" frmEdt.RefreshForms()")
			ENDIF
		ELSE
			*No pForm
		ENDIF
		
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
		RETURN
		
		
	ENDPROC

	PROCEDURE refresh_salesquote
		PARAMETERS nRecNo
		*ThisForm.Refresh_SalesQuote(1)
		
		IF VARTYPE(nRecNo) != "N"
			nRecNo = 1
		ENDIF
		
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		SELECT 0
		
		cSQL = " SELECT "
		cSQL = cSQL + "  A.Company,A.name,A.phone,A.phone_ext,A.fax,A.phone_ext,A.email,A.PO_num,A.alloy,a.form,A.cc,A.pieces,A.thck,A.Sz2,A.sz3,A.weight,A.descript"
		cSQL = cSQL + " ,a.p_lb,A.p_pc,A.p_ft,a.cuts,A.otherfld,A.otherp,A.lotp,A.lotcost,A.leadtime,A.cweight,A.cp_lb,A.cp_lb,A.cp_pcc,A.cthk"
		cSQL = cSQL + " ,A.clotcp,A.clotp,A.ccut,A.Inqdate,A.Inqnum,A.InqNumP,A.SalesP"
		cSQL = cSQL + " ,A.HPApo,A.POitem,A.saledate,A.shipdate,A.buyfrom,A.buycost,A.buyfrom2,A.HPApo2,A.open_,A.Bracket,A.CustID,A.QuoteMemo,A.Comments"
		cSQL = cSQL + " ,A.CountryC,A.Country,A.Services,A.RandLen,A.Metric,A.StartStock,A.TN,A.sz1orig,A.sz2orig,A.sz3orig,A.QuoteDate"
		cSQL = cSQL + " ,A.Cover,A.cut,A.ID,A.line1,A.WO,A.CutOptions "
		cSQL = cSQL + " ,A.SalesNum AS SalesNum_a, A.SOitem AS SOitem_a, A.Item AS Item_a "
		cSQL = cSQL + " ,S.soitem,S.salesnum,S.item,S.orderspec,S.s_instrct,S.inv,S.gfm,S.roll,S.press,S.mach,S.cg,S.plasma,S.WJet,S.cert,S.heat"
		cSQL = cSQL + " ,S.converpo,S.converter,S.conversion,S.converfrt,S.conversent,S.converretu,S.itemtot,S.shipdue,S.shipped,S.qshipped,S.qbackorder,S.matlwt "
		cSQL = cSQL + " ,S.cncld,S.cmplt,S.partno,S.itemcost,S.itemsale,S.gs_cost,S.gs_sale,S.gs_cmplt,S.rma_no,S.qa,S.cofc,s.merc,S.ppo,S.ppn,S.pheat,S.pspec,S.pdesc,S.pother,S.other "
		cSQL = cSQL + " ,S.prcp,S.prcd,S.pckd,S.urgent,S.shipon,S.Tol,S.JobHours,S.ProcLoc "
		cSQL = cSQL + " FROM dbo.AllQuotes A "
		cSQL = cSQL + " INNER JOIN dbo.Sales S ON A.SOitem = S.SOitem "
		cSQL = cSQL + " WHERE A.SalesNum = "+STR(THISFORM.Salesnum)
		cSQL = cSQL + " ORDER BY A.Item "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SalesQuote')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SalesQuote')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SalesQuote')
		ENDIF
		
		
		IF nRecNo <= RECCOUNT('SalesQuote')
			GOTO nRecNo IN SalesQuote
		ENDIF
		
		ThisForm.pf.pgOrder.chkService.Refresh
		ThisForm.pf.pgOrder.chkInv.Refresh
		ThisForm.pf.pgOrder.chkGfm.Refresh
		ThisForm.pf.pgOrder.chkRoll.Refresh
		ThisForm.pf.pgOrder.chkPress.Refresh
		ThisForm.pf.pgOrder.chkMach.Refresh
		ThisForm.pf.pgOrder.chkCG.Refresh
		ThisForm.pf.pgOrder.chkPlasma.Refresh
		ThisForm.pf.pgOrder.chkWJet.Refresh
		
		
	ENDPROC

	PROCEDURE savecontactid
		*ThisForm.SaveContactID()
			
		PRIVATE lSaveOK, lAbort
		lSaveOK = .T.
		lAbort = .F.
		
		IF NOT USED('Vendor')
			MESSAGEBOX("Did not find the Vendor"+CHR(13)+"Please choose the Vendor first.",64,"No Vendor")
			RETURN .F.
		ENDIF
		
		SELECT VENDOR
		PRIVATE lSQLgood
		lSQLgood = .T.
		
		PRIVATE nContactID,nVendCode,cContact,cPhone,cCellPhone,cFax,cEmail
		PRIVATE cAddr1,cAddr2,cCity,cST,cZip,cCountry
		PRIVATE lQuality,dlastSurveySent,dlastSurveyReceived,cJobTitle,nSurveyPriority,lInactive
		
		nContactID	= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgVendorContact.nContactID.Value,'ContactID',-3)
		nVendCode	= PrepareSQLnum(ThisForm.VendCode,'VendCode',-3) 
		cContact	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cContact.Value,'Contact',30)
		cPhone		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cPhone.Value,'Phone',20)
		cCellPhone	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCellPhone.Value,'CellPhone',20)
		cFax		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cFax.Value,'Fax',20)
		cEmail		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cEmail.Value,'Email',60)
		cAddr1		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cAddr1.Value,'Addr1',30)
		cAddr2		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cAddr2.Value,'Addr2',30)
		cCity		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCity.Value,'City',20)
		cST			= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cSt.Value,'ST',2)
		cZip		= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cZip.Value,'Zip',12)
		cCountry	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCountry.Value,'Country',15)
		lQuality	= PrepareSQLchk(ThisForm.pf.pg_po.pgfPO.pgVendorContact.chkQuality,'Quality')
		dlastSurveySent	= PrepareSQLdate(ThisForm.pf.pg_po.pgfPO.pgVendorContact.dlastSurveySent,'lastSurveySent')
		dlastSurveyReceived	= PrepareSQLdate(ThisForm.pf.pg_po.pgfPO.pgVendorContact.dlastSurveyReceived,'lastSurveyReceived')
		cJobTitle	= PrepareSQLtxt(ThisForm.pf.pg_po.pgfPO.pgVendorContact.cJobTitle.Value,'JobTitle',50)
		nSurveyPriority	= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgVendorContact.nSurveyPriority.Value,'SurveyPriority',-3)
		lInactive	= PrepareSQLchk(ThisForm.pf.pg_po.pgfPO.pgVendorContact.chkVCinactive,'Inactive')
		
		**Check Data
		IF nVendCode = 0
			MESSAGEBOX("Cannot save with out a VendCode",0+16,"Save Error")
			RETURN .F.
		ENDIF
		
		***********
		IF lSaveOK 
			IF EMPTY(cContact)
				MESSAGEBOX("You must enter a 'Contact' name !",48,"No Vendor Contact - Cannot save.")
				lSaveOK = .F.
			ENDIF
		ENDIF
		
		*****
		
		IF lSaveOK
			IF nContactID > 0
			
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.VendorContact SET "
				cSQLu = cSQLu + " Contact='"+cContact+"'"
				cSQLu = cSQLu + ",Phone='"+cPhone+"'"
				cSQLu = cSQLu + ",CellPhone='"+cCellPhone+"'"
				cSQLu = cSQLu + ",Fax='"+cFax+"'"
				cSQLu = cSQLu + ",Email='"+cEmail+"'"
				cSQLu = cSQLu + ",Addr1='"+cAddr1+"'"
				cSQLu = cSQLu + ",Addr2='"+cAddr2+"'"
				cSQLu = cSQLu + ",City='"+cCity+"'"
				cSQLu = cSQLu + ",ST='"+cST+"'"
				cSQLu = cSQLu + ",Zip='"+cZip+"'"
				cSQLu = cSQLu + ",Country='"+cCountry+"'"
		*		cSQLu = cSQLu + ",Quality='"+IIF(lQuality,'1','0')+"'"
		*		cSQLu = cSQLu + ",lastSurveySent='"+IIF(EMPTY(dlastSurveySent),'',DTOC(dlastSurveySent))+"'"		
		*		cSQLu = cSQLu + ",lastSurveyReceived='"+IIF(EMPTY(dlastSurveyReceived),'',DTOC(dlastSurveyReceived))+"'"
				cSQLu = cSQLu + ",JobTitle='"+cJobTitle+"'"
		*		cSQLu = cSQLu + ",SurveyPriority="+STR(nSurveyPriority)
				cSQLu = cSQLu + ",Inactive='"+IIF(lInactive,'1','0')+"'"
				cSQLu = cSQLu + " WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
					lSaveOK = .F.
				ELSE
					TrackMess( "Update Vendor ContactID:"+ALLTRIM(STR(nContactID))+" with the VendCode"+ALLTRIM(STR(nVendCode)) +" frmEdt.SaveContactID()")
				ENDIF
					
			ELSE
			
				IF USED('VendorContact_ins')
					USE IN VendorContact_ins
				ENDIF
				SELECT 0
			
				PRIVATE cSQLi
				cSQLi = "EXEC dbo.p_VendorContact_ins "
				cSQLi = cSQLi + " @VendCode="+STR(nVendCode)+""
				cSQLi = cSQLi + ",@Contact='"+cContact+"'"
				cSQLi = cSQLi + ",@Phone='"+cPhone+"'"
				cSQLi = cSQLi + ",@CellPhone='"+cCellPhone+"'"
				cSQLi = cSQLi + ",@Fax='"+cFax+"'"
				cSQLi = cSQLi + ",@Email='"+cEmail+"'"
				cSQLi = cSQLi + ",@Addr1='"+cAddr1+"'"
				cSQLi = cSQLi + ",@Addr2='"+cAddr2+"'"
				cSQLi = cSQLi + ",@City='"+cCity+"'"
				cSQLi = cSQLi + ",@ST='"+cST+"'"
				cSQLi = cSQLi + ",@Zip='"+cZip+"'"
				cSQLi = cSQLi + ",@Country='"+cCountry+"'"
				cSQLi = cSQLi + ",@Quality='"+IIF(lQuality,'1','0')+"'"
				cSQLi = cSQLi + ",@lastSurveySent='"+IIF(EMPTY(dlastSurveySent),'',DTOC(dlastSurveySent))+"'"		
				cSQLi = cSQLi + ",@lastSurveyReceived='"+IIF(EMPTY(dlastSurveyReceived),'',DTOC(dlastSurveyReceived))+"'"
				cSQLi = cSQLi + ",@JobTitle='"+cJobTitle+"'"
				cSQLi = cSQLi + ",@SurveyPriority="+STR(nSurveyPriority)
				
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'VendorContact_ins' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'VendorContact_ins' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'VendorContact_ins' )
					lSaveOK = .F.
				ELSE
					*get inserted ContactID
					IF USED('VendorContact_ins')
						IF VARTYPE(VendorContact_ins.ContactID) = "N"
							nContactID=VendorContact_ins.ContactID
						ENDIF
						USE IN VendorContact_ins
					
						TrackMess( "Added Vendor ContactID:"+ALLTRIM(STR(nContactID))+" as VendCode"+ALLTRIM(STR(nVendCode))+" frmEdt.SaveContactID()" )
					ENDIF
				ENDIF
		
		
			ENDIF
		ENDIF
		****
		IF lSaveOK 
			*Saved
		
			ThisForm.GetVendorContacts(nContactID)
		
		ELSE
			*Did not Save!
			RETURN .F.
		ENDIF
		
		*ThisForm.frmVendor.Pf.PgAdd.REFRESH
		RETURN .T.
		
		
		
		
	ENDPROC

	PROCEDURE savequote
		*ThisForm.SaveQuote()
		
		PRIVATE nRecNo
		nRecNo = RECNO('SalesQuote')
		
		*Store OldData to compare changes with StockLst_Process
		PRIVATE cPO_NumO,cAlloyO,cFormO,cCCO,nPiecesO,nThckO,nSz2O,nSz3O,nWeightO
		cPO_NumO	= ''
		cAlloyO	= ''
		cFormO	= ''
		cCCO	= ''
		nPiecesO= 0
		nThckO	= 0
		nSz2O	= 0
		nSz3O	= 0
		nWeightO	= 0
		
		IF USED('tmpAQO')
			USE IN tmpAQO
		ENDIF
		SELECT 0
		
		cSQL = "SELECT PO_Num,Alloy,Form,CC,Pieces,Thck,Sz2,Sz3,Weight"
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE AllQuotes.ID = " + ALLTRIM(STR(SalesQuote.ID))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL, 'tmpAQO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpAQO')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'tmpAQO')
		ENDIF
		
		IF USED('tmpAQO')
			IF RECCOUNT('tmpAQO') > 0
				cPO_NumO= tmpAQO.PO_Num
				cAlloyO	= tmpAQO.Alloy
				cFormO	= tmpAQO.Form
				cCCO	= tmpAQO.CC
				nPiecesO= tmpAQO.Pieces
				nThckO	= tmpAQO.Thck
				nSz2O	= tmpAQO.Sz2
				nSz3O	= tmpAQO.Sz3
				nWeightO= tmpAQO.Weight
			ENDIF
			USE IN tmpAQO
		ENDIF
		
		***********************************
		PRIVATE cCompany,cName,cPhone,cPhone_Ext
		PRIVATE cPO_Num,cAlloy,cForm,cCC,nPieces,nThck,nSz2,nSz3,nWeight
		PRIVATE cDescript,nP_Lb,nP_Pc,nP_Ft,nCuts,cOtherFld,nOtherP,nLotP,nLotCost
		PRIVATE cLeadTime,cQComments,cCountryC,lServices,lRandLen,lMetric
		
		cCompany	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtCompany.Value,'Company',30)
		cName		= PrepareSQLtxt(ThisForm.pf.pgQuote.txtName.Value,'Name',25)
		lServices	= PrepareSQLchk(ThisForm.pf.pgQuote.chkService.Value,'Service')
		lRandLen	= PrepareSQLchk(ThisForm.pf.pgQuote.chkRL.Value,'RL')
		lMetric		= PrepareSQLchk(ThisForm.pf.pgQuote.chkMetric.Value,'Metric')
		cCountryC	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtCountryC.Value,'CountryC',10)
		cPhone		= PrepareSQLtxt(ThisForm.pf.pgQuote.txtPhone.Value,'Phone',10)
		cPhone_Ext	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtPhone_Ext.Value,'Phone_Ext',6)
		cPO_Num		= PrepareSQLtxt(ThisForm.pf.pgQuote.txtPO_NUM.Value,'PO_Num',17)
		cAlloy		= PrepareSQLtxt(ThisForm.pf.pgQuote.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisForm.pf.pgQuote.cmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisForm.pf.pgQuote.cmbCC.Value,'CC',1)
		nPieces		= PrepareSQLnum(ThisForm.pf.pgQuote.txtPieces.Value,'Pieces',7,0)
		nThck		= PrepareSQLnum(ThisForm.pf.pgQuote.txtTHCK.Value,'Thck',10,4)
		nSz2		= PrepareSQLnum(ThisForm.pf.pgQuote.txtSz2.Value,'Sz2',9,3)
		nSz3		= PrepareSQLnum(ThisForm.pf.pgQuote.txtSz3.Value,'Sz3',9,3)
		nWeight		= PrepareSQLnum(ThisForm.pf.pgQuote.txtWeight.Value,'Weight',8,1)
		cDescript	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtDESCRIPT.Value,'Descript',50)
		nP_Lb		= PrepareSQLnum(ThisForm.pf.pgQuote.txtP_lb.Value,'P_Lb',8,2)
		nP_Pc		= PrepareSQLnum(ThisForm.pf.pgQuote.txtP_pc.Value,'P_Pc',9,2)
		nP_Ft		= PrepareSQLnum(ThisForm.pf.pgQuote.txtP_ft.Value,'P_Ft',8,2)
		nCuts		= PrepareSQLnum(ThisForm.pf.pgQuote.txtCuts.Value,'Cuts',6,0)
		cOtherFld	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtOtherFld.Value,'OtherFld',10)
		nOtherP		= PrepareSQLnum(ThisForm.pf.pgQuote.txtOtherP.Value,'OtherP',8,2)
		nLotP		= PrepareSQLnum(ThisForm.pf.pgQuote.txtLotP.Value,'LotP',9,2)
		nLotCost	= PrepareSQLnum(ThisForm.pf.pgQuote.txtItemCost.Value,'LotCost',9,2)
		cLeadTime	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtLeadTime.Value,'LeadTime',15)
		cQComments	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtQComments.Value,'Comments',0)
		
		SELECT 0
		
		PRIVATE cUpdate
		cUpdate = "UPDATE dbo.AllQuotes SET "
		cUpdate = cUpdate + " COMPANY='"+cCompany+"'"
		cUpdate = cUpdate + ",NAME='"+cName+"'"
		cUpdate = cUpdate + ",PHONE='"+cPhone+"'"
		cUpdate = cUpdate + ",PHONE_EXT='"+cPhone_Ext+"'"
		cUpdate = cUpdate + ",PO_NUM='"+cPO_Num+"'"
		cUpdate = cUpdate + ",ALLOY='"+cAlloy+"'"
		cUpdate = cUpdate + ",FORM='"+cForm+"'"
		cUpdate = cUpdate + ",CC='"+cCC+"'"
		cUpdate = cUpdate + ",PIECES="+STR(nPieces,7,0)+""
		cUpdate = cUpdate + ",THCK="+STR(nThck,10,4)+""
		cUpdate = cUpdate + ",SZ2="+STR(nSz2,9,3)+""
		cUpdate = cUpdate + ",SZ3="+STR(nSz3,9,3)+""
		cUpdate = cUpdate + ",Weight="+STR(nWeight,8,1)+""
		cUpdate = cUpdate + ",DESCRIPT='"+cDescript+"'"
		cUpdate = cUpdate + ",P_lb="+STR(nP_Lb,8,2)+""
		cUpdate = cUpdate + ",P_pc="+STR(nP_Pc,9,2)+""
		cUpdate = cUpdate + ",P_ft="+STR(nP_Ft,8,2)+""
		cUpdate = cUpdate + ",cuts="+STR(nCuts,6,0)+""
		cUpdate = cUpdate + ",OtherFld='"+cOtherFld+"'"
		cUpdate = cUpdate + ",OtherP="+STR(nOtherP,8,2)+""
		cUpdate = cUpdate + ",LotP="+STR(nLotP,9,2)+""
		cUpdate = cUpdate + ",LotCost="+STR(nLotCost,9,2)+""
		cUpdate = cUpdate + ",LeadTime='"+cLeadTime+"'"
		*	cUpdate = cUpdate + ",QuoteMemo='"+PrepareSQLtxt(oQ.QuoteMemo,'Quote Memo',-1)+"'"
		cUpdate = cUpdate + ",Comments='"+cQComments+"'"
		cUpdate = cUpdate + ",CountryC='"+cCountryC+"'"
		*	cUpdate = cUpdate + ",Country='"+PrepareSQLtxt(oQ.Country,'Country',20)+"'"
		cUpdate = cUpdate + ",Services="+IIF(lServices,"1","0")+""
		cUpdate = cUpdate + ",RandLen="+IIF(lRandLen,"1","0")+""
		cUpdate = cUpdate + ",Metric="+IIF(lMetric,"1","0")+""
		cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(SalesQuote.ID))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cUpdate)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cUpdate )
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cUpdate,ThisForm.nConnHandle, nSQLEXEC,'')
			MESSAGEBOX("Data could not be saved at the SQL Server."+CHR(13)+CHR(13)+"Your edit will show on this screen and print on the report,"+CHR(13)+;
			"the data will revert to orignal when refreshed from the SQL Server."+CHR(13)+CHR(13)+"Edit and Try to save again!",0,"SQL Error")
		ELSE
			*Successfully Saved to Allquotes
			*Check Price
			*****************************************************************
			PRIVATE nCalcLotP 
			nCalcLotP = THISFORM.CalcLotp()
			IF NOT USED('SalesTotal')
				WAIT WINDOW "Going back for 'SalesTotal'" TIMEOUT 2
				ThisForm.Calc_PgValues()
			ENDIF
			
			SELECT SalesTotal
			REPLACE ItemSale WITH nCalcLotP IN SalesTotal
			
			SELECT SalesQuote
			REPLACE ItemSale WITH nCalcLotP IN SalesQuote
		
			*ThisForm.UpdtItemSale(nCalcLotP)
			
			*****************************************************************
			*Save to Sales
			PRIVATE cPartNo, cOrderSpec, cHeat, cS_Instrct, llShipOn, dShipDue
			cPartNo		= PrepareSQLtxt(ThisForm.pf.pgQuote.txtPartNo.Value,'PartNo',100)
			cOrderSpec	= PrepareSQLtxt(ThisForm.pf.pgQuote.txtOrderSpec.Value,'OrderSpec',60)
			cHeat		= PrepareSQLtxt(ThisForm.pf.pgQuote.txtHeat.Value,'Heat',50)
			cS_Instrct	= PrepareSQLtxt(ThisForm.pf.pgQuote.editItemInstruc.Value,'S_Instruct',-1)
			llShipOn	= PrepareSQLchk(ThisForm.pf.pgQuote.chkShipOn.Value,'ShipOn',.F.)
			dShipDue	= PrepareSQLdate(ThisForm.pf.pgQuote.txtShipDue.Value,'ShipDue')
				
			cSQLu = "UPDATE dbo.Sales SET "
			cSQLu = cSQLu + " ShipON="+IIF(llShipOn,"1","0")+""
			cSQLu = cSQLu + ",PartNo='"+cPartNo+"'"
			cSQLu = cSQLu + ",OrderSpec='"+cOrderSpec+"'"
			cSQLu = cSQLu + ",Heat='"+cHeat+"'"
			cSQLu = cSQLu + ",S_Instrct='"+cS_Instrct+"'"
			cSQLu = cSQLu + ",ShipDue= '"+IIF(EMPTY(dShipDue),'',DTOC(dShipDue))+"'"
			cSQLu = cSQLu + ",ItemSale= "+STR(nCalcLotP,9,2)
			cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+SalesQuote.SoItem_A+"')"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
			ENDIF
			
			*****************************************************************
			*Save to Ship
			cSQL = "UPDATE dbo.SHIP SET	"
			cSQL = cSQL + "Salesp = '"+PrepareSQLtxt(Quotes.Salesp,'SalesP',1)+"'"
			cSQL = cSQL + ",Company = '"+PrepareSQLtxt(Quotes.company,'Company',30)+"'"
			cSQL = cSQL + ",PO_Num = '"+PrepareSQLtxt(Quotes.PO_Num,'PO_Num',17)+"'"
			cSQL = cSQL + ",Alloy = '"+PrepareSQLtxt(Quotes.alloy,'Alloy',12)+"'"
			cSQL = cSQL + ",OrderDate = '"+IIF(EMPTY(Quotes.SaleDate),'',DTOC(Quotes.SaleDate))+"'"
			cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+SalesQuote.SOitem_a+"')"
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			ELSE	
				IF ThisForm.nPrintedSO = 1
					MESSAGEBOX("This SalesOrder will now be listed as 'NOT Printed'",0+64,"You must reprint with the new edit.")
					
					cSQL = "UPDATE dbo.Sales_No SET	"
					cSQL = cSQL + " PrintedSO=0 "
					cSQL = cSQL + ",Changing=1 "
					cSQL = cSQL + " WHERE SalesNum = "+STR(SalesQuote.SalesNum)
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!, long triger
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
					ELSE
						ThisForm.nPrintedSO = 0
					ENDIF
					
				ENDIF	
			ENDIF
			
			*****************************************************************
			*Adjust StockLst_Process
			PRIVATE lSOitemUseInv
			lSOitemUseInv = .F.
			
			IF USED('cntdUseINV')
				USE IN cntdUseINV
			ENDIF
		
			SELECT 0
		
			cSQL = "SELECT COUNT(*) AS Cntd "
			cSQL = cSQL + " FROM dbo.StockLst_Process "
			cSQL = cSQL + " WHERE SOitem = '"+SalesQuote.SOitem_A+"'"
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntdUseINV')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntdUseINV')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntdUseINV')
			ENDIF
		
			IF USED('cntdUseINV')
				IF cntdUseINV.Cntd > 0
					*Found a Inventory selected process!
					lSOitemUseInv = .T.
				ENDIF
				USE IN cntdUseINV
			ENDIF
			
			IF lSOitemUseInv 	
				*
				IF USED('tmpUseINV')
					USE IN tmpUseINV
				ENDIF
		
				SELECT 0
		
				cSQL = "SELECT SOitem,PO_item,SalesPerson,StartDate,DueDate,Comment"
				cSQL = cSQL + ",AllowSub,PWeight,PPc,PFT"
				cSQL = cSQL + ",PU,QTY,Pounds,ID_Detail,ID_Detail_Process"
				cSQL = cSQL + " FROM dbo.StockLst_Process "
				cSQL = cSQL + " WHERE Process_ID='SELECTED  '"
				cSQL = cSQL + " AND SOitem = '"+SalesQuote.SOitem_A+"'"
		*			cSQL = cSQL + " UNION "
		*			cSQL = cSQL + " SELECT SOitem,PO_item,SalesPerson,StartDate,DueDate,Comment "
		*			cSQL = cSQL + ",AllowSub,PWeight,PPc,PFT,PU,ID_Detail,ID_Detail_Process "
		*			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		*			cSQL = cSQL + " WHERE Process_ID='SELECTED  '"
		*			cSQL = cSQL + " AND SOitem = '"+SalesQuote.SOitem_A+"'"
		
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUseINV')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntdUseINV')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntdUseINV')
				ENDIF
		
				IF USED('cntdUseINV')
					IF RECCOUNT('cntdUseINV') > 1
						MESSAGEBOX("Found multiple records in StockLst_Process as 'Selected' for this SO item."+CHR(13)+"Please correct!",48,"Cannot auto adjust Selected Stock")
					ENDIF
					IF RECCOUNT('cntdUseINV') = 1
						cSQL=''
						
						*Check if a selected stock has changed
						PRIVATE nPWeightS,nPPcS,nPFTS,nPUS,nQTYS,nPoundsS,nID_Detail_ProcessS
						nPWeightS= PrepareSQLnum(cntdUseINV.PWeight,'Weight',9,1)
						nPPcS	= PrepareSQLnum(cntdUseINV.PPc,'PPc',-3)
						nPFTS	= PrepareSQLnum(cntdUseINV.PFT,'PFt',-5)
						nPUS	= PrepareSQLnum(cntdUseINV.PU,'PU',-1)
						nQTYS	= PrepareSQLnum(cntdUseINV.QTY,'QTY',-5)
						nPoundsS= PrepareSQLnum(cntdUseINV.Pounds,'Pounds',9,1)
						nID_Detail_ProcessS = PrepareSQLnum(cntdUseINV.ID_Detail_Process,'ID_Detail_Process',-3)
						
						IF nPUS = 0
							nPUS = GetPUfromForm(cForm, ThisForm.nConnHandle)
						ENDIF
						
						PRIVATE nQTY_now, nPounds, nPU_now
						nQTY_now = Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,nWeight,0,ThisForm.nConnHandle)
						nPounds = CalcWeight(nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)				
						nPU_now = GetPUfromForm(cForm, ThisForm.nConnHandle)
						
						IF nQTYS > 0 OR nPoundsS > 0
		    				*Found Something Selected
							
							IF nQTY_now > 0
								IF nQTY_now * 1.15 < nQTYS
									IF MESSAGEBOX("Weight is now more than 15% greater than was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
										cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)+", Pounds="+STR(nQTY_now,9,1)
										cSQL = cSQL + ", PU="+STR(nPU_now)
										cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_ProcessS)
									ENDIF
								ENDIF
								IF nQTY_now * .85 > nQTYS
									IF MESSAGEBOX("Weight is now more than 15% less than was seleted!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
										cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)+", Pounds="+STR(nQTY_now,9,1)
										cSQL = cSQL + ", PU="+STR(nPU_now)
										cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_ProcessS)
									ENDIF
								ENDIF	
								
							ENDIF
						ELSE
							*Use the old procedure of PWeight,PPc and PFt
								
							DO CASE
							CASE nPUS = 1
								*Compare Weight
								IF nPWeightS * 1.15 < nPounds
									IF MESSAGEBOX("Old Weight is more than 15% greater than was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
										cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)+", Pounds="+STR(nPounds,9,1)
										cSQL = cSQL + ",PWeight=0, PPc=0, PFT=0, PU="+STR(nPU_now)
										cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_ProcessS)
									ENDIF
								ENDIF
								IF nPWeightS * .85 > nPounds
									IF MESSAGEBOX("Old Weight is more than 15% less than was seleted!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
										cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)+", Pounds="+STR(nPounds,9,1)
										cSQL = cSQL + ",PWeight=0, PPc=0, PFT=0, PU="+STR(nPU_now)
										cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_ProcessS)
									ENDIF
								ENDIF	
							CASE nPUS = 2
								*Compare Length
								*nThckO,nSz2O,nSz3O
								IF nPFTS > 0
									IF nQTY_now > 0
										IF nPFTS != nQTY_now 
											IF MESSAGEBOX("Number of FT has changed from what was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
												cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)+", Pounds="+STR(nPounds,9,1)
												cSQL = cSQL + ",PWeight=0, PPc=0, PFT=0, PU="+STR(nPU_now)
												cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_ProcessS)
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							CASE nPUS = 3
								*Compare PCs
								IF nQTY_now > 0
									IF nPPcS > 0
										IF nQTY_now != nPPcS
											IF MESSAGEBOX("Number of PC has changed from what was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
												cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)+", Pounds="+STR(nPounds,9,1)
												cSQL = cSQL + ",PWeight=0, PPc=0, PFT=0, PU="+STR(nPU_now)
												cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_ProcessS)
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							OTHERWISE
							
							ENDCASE
						ENDIF		
						******************
						IF LEN(cSQL) > 0
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
							ELSE
								WAIT WINDOW "Successfully updated selected stock!" NOWAIT
							ENDIF
		
						ENDIF
						
					ENDIF
				ENDIF
			ENDIF
			
			*****************************************************************
			ThisForm.Refresh_SalesQuote(nRecNo)		
			*****************************************************************
		ENDIF
		
	ENDPROC

	PROCEDURE saveso
		*ThisForm.SaveSO()
		
		PRIVATE lReturn 
		lReturn = .T.
		
		PRIVATE mHoldRecordNum, cSQLUpdate  
		mHoldRecordNum = 0
			
		SELECT SalesQuote
		mHoldRecordNum = RECNO('SalesQuote')
		
		IF mHoldRecordNum > RECCount('SalesQuote')
			mHoldRecordNum = SalesQuote.item_A
		ENDIF
		IF mHoldRecordNum < 1
			IF Reccount('SalesQuote') >= SalesQuote.item_A
				mHoldRecordNum = SalesQuote.item_A
			ENDIF
		ENDIF
		
		*Get Variable
		LOCAL llpaper_po, lcPayType, lcShipPay, lcShipRoute, lnFreightEst, lcAddr_Ref, lcInstrct 
		LOCAL llBlind, llEmailConf, llFaxConf, lcTarfBill, llUSA
		LOCAL lnShipAddr, lnSoldAddr, llPrintedSO
		PRIVATE lnSalesNum,lnAmendment,lECPC
		              
		lnSalesNum	= PrepareSQLnum( ThisForm.pf.pgOrder.txtSalesnum.Value,'SalesNum',-3)
		llpaper_po	= PrepareSQLchk( THISFORM.pf.pgShipto.chkReceivedPO.VALUE,'PaperPO',.T. ) 
		lnAmendment = PrepareSQLnum( ThisForm.pf.pgBillTo.txtAmendment.Value,'Amendment',2,0)
		lECPC		= PrepareSQLchk( ThisForm.pf.pgShipto.chkECPC.VALUE,'ECPC',.F.)
		
		lcPayType	= PrepareSQLtxt( THISFORM.pf.pgShipto.cmbPayment.VALUE,'PayType',10)
		IF EMPTY(lcPayType)
			lcPayType = ' '
		ENDIF
		lcShipPay	= PrepareSQLtxt( THISFORM.pf.pgShipto.cmbFrtPayment.VALUE,'ShipPay',11)
		lcShipRoute	= PrepareSQLtxt( THISFORM.pf.pgShipto.txtShipRoute.VALUE,'ShipRoute',20)
		lnFreightEst= PrepareSQLnum( THISFORM.pf.pgShipto.txtFreightEst.VALUE,'FreightEst',9,2)
		lcAddr_Ref	= PrepareSQLtxt( THISFORM.pf.pgShipto.txtAddr_Ref.VALUE,'Addr_ref',40)
		lcInstrct	= PrepareSQLtxt( THISFORM.pf.pgShipto.txtInstrct.VALUE,'Instrct',100)
		llBlind		= PrepareSQLchk( ThisForm.pf.pgShipto.chkBlindSO.Value,'Blind',.F.) 
		lcTarfBill	= PrepareSQLtxt( ThisForm.pf.pgShipto.cmbTarfBill.Value,'TarfBill',10)
		llUSA		= PrepareSQLchk( ThisForm.pf.pgShipto.chkUSA.Value,'USA',.T.)
		llEmailConf	= PrepareSQLchk( ThisForm.pf.pgBillto.chkEmail.Value,'EmailConf',.F.)
		llFaxConf	= PrepareSQLchk( ThisForm.pf.pgBillto.chkFax.Value,'FaxConf',.F.)
		
		lnShipAddr	= THISFORM.ShipAddr
		lnSoldAddr	= THISFORM.SoldAddr
		llPrintedSO	= IIF(ThisForm.nPrintedSO=0, .F.,.T.)
		*Test
		PRIVATE nDecimal
		nDecimal = SET("DECIMAL")
		
		IF TYPE("lnSalesNum") = "C"
			SET DECIMAL TO 0
			lnSalesNum= VAL(lnSalesNum)
			SET DECIMAL TO nDecimal 
		ENDIF
		IF TYPE("lnFreightEst") = "C"
			SET DECIMAL TO 2
			lnFreightEst = VAL(lnFreightEst)
			SET DECIMAL TO nDecimal 
		ENDIF
		
		PRIVATE lQA,lCofC,lMercury,lpPO,lpPN,lpHeat,lpSpec,lpDesc,lpOther,cOther
		lQA		= PrepareSQLchk( ThisForm.pf.pgBillTo.chkQA.VALUE,'QA', .F. ) 
		lCofC	= PrepareSQLchk( ThisForm.pf.pgBillTo.chkCofC.VALUE,'CofC', .F. ) 
		lMercury= PrepareSQLchk( ThisForm.pf.pgBillTo.chkMercury.VALUE,'Mercury', .F. ) 
		lpPO	= PrepareSQLchk( ThisForm.pf.pgBillTo.chkpPO.VALUE,'pPO', .F. ) 
		lpPN	= PrepareSQLchk( ThisForm.pf.pgBillTo.chkpPN.VALUE,'pPN', .F. ) 
		lpHeat	= PrepareSQLchk( ThisForm.pf.pgBillTo.chkpHeat.VALUE,'pHeat', .F. ) 
		lpSpec	= PrepareSQLchk( ThisForm.pf.pgBillTo.chkpSpec.VALUE,'pSpec',.F.) 
		lpDesc	= PrepareSQLchk( ThisForm.pf.pgBillTo.chkpDesc.VALUE,'pDesc',.F.) 
		lpOther	= PrepareSQLchk( ThisForm.pf.pgBillTo.chkpOther.VALUE,'pOther?',.F.)
		
		IF lpOther
			cOther	= PrepareSQLtxt(ThisForm.pf.pgBillTo.txtOther.VALUE,'Other',30)
			IF TYPE("cOther") = "N"
				cOther = STR(cOther)
			ENDIF
			IF TYPE("cOther") != "C"
				cOther = ""
			ENDIF	
		ELSE
			cOther = ""
		ENDIF
		
		PRIVATE cBillCountry, cShipCountry, llFoundCountry, cBillCountryABV, cShipCountryABV
		cBillCountry = PADR(UPPER(ThisForm.pf.pgBillTo.txtCountry.Value),15," ")
		cShipCountry = PADR(UPPER(ThisForm.pf.pgShipto.txtCountry.Value),15," ")
		llFoundCountry = .F.
		
		IF NOT USED('HardWood')
			ThisForm.LoadHardwood()
			
			SELECT HardWood
			INDEX ON Country TAG Country
			INDEX ON ABV TAG ABV
		ENDIF
		
		IF NOT EMPTY(cShipCountry)
			SEEK cShipCountry ORDER Country IN HardWood
			IF FOUND("HardWood")
				IF NOT HardWood.Inactive
					llFoundCountry = .T.
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				IF LEN(ALLTRIM(cShipCountry)) = 2
					cShipCountryABV = LEFT(cShipCountry ,2)
					SEEK cShipCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							llFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				SEEK cShipCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						llFoundCountry = .T.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT EMPTY(cBillCountry)
			IF NOT llFoundCountry 
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						llFoundCountry = .T.
					ENDIF
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				IF LEN(ALLTRIM(cBillCountry )) = 2
					cBillCountryABV = LEFT(cBillCountry ,2)
					SEEK cBillCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							llFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						llFoundCountry = .T.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		* end check for bad values
		*********************************
		
		SELECT SalesQuote
		*SAVE Sales info that appears on all WO pages
		REPLACE ALL SalesQuote.QA WITH lQA,;
		 SalesQuote.cofc WITH lCofC,;
		 SalesQuote.Merc WITH lMercury,;
		 SalesQuote.pPO WITH lpPO,;
		 SalesQuote.pPN WITH lpPN,;
		 SalesQuote.pHeat WITH lpHeat,;
		 SalesQuote.pSpec WITH lpSpec,;
		 SalesQuote.pDesc WITH lpDesc,;
		 SalesQuote.pOther WITH lpOther,;
		 SalesQuote.Other WITH cOther IN SalesQuote
		
		cSQL = "UPDATE dbo.Sales SET "
		cSQL = cSQL + " QA = "+ IIF(lQA,'1','0') +","
		cSQL = cSQL + " cofc = "+ IIF(lCofC,'1','0') +","
		cSQL = cSQL + " Merc = "+ IIF(lMercury,'1','0') +","
		cSQL = cSQL + " pPO = "+ IIF(lpPO,'1','0') +","
		cSQL = cSQL + " pPN = "+ IIF(lpPN,'1','0') +","
		cSQL = cSQL + " pHeat = "+ IIF(lpHeat,'1','0') +","
		cSQL = cSQL + " pSpec = "+ IIF(lpSpec,'1','0') +","
		cSQL = cSQL + " pDesc = "+ IIF(lpDesc,'1','0') +","
		cSQL = cSQL + " pOther = "+ IIF(lpOther,'1','0') +","
		cSQL = cSQL + " Other = '"+ ALLTRIM(cOther)+"'"
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(lnSalesNum ))
		
		WAIT WINDOW "UPDATE dbo.Sales " NOWAIT
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
			lReturn = .F.
		ENDIF
		
		
		**Update dbo.Sales ALL
		PRIVATE cOrderSpec, cs_Instrct, lInv, lGFM, lRoll, lPress, lMach, lCG, cTol, lPlasma, lWJet
		PRIVATE nCert,cProcLoc,cheat,nConverPO,cConverter,cConversion,cConverFrt
		PRIVATE dConverSent,dConverRetu,llShipOn ,dShipDue,dShipped
		PRIVATE nqShipped,nqBackOrder,nMatlWt
		PRIVATE lcncld,lcmplt,cPartNo,nItemCost,nItemSale,nRMA_No, cSoItem
		
		SELECT SalesQuote
		SCAN
			cOrderSpec = PrepareSQLtxt(SalesQuote.OrderSpec,'Order Spec',60,.F.)
			IF VARTYPE(cOrderSpec) != "C"
				cOrderSpec  = ' '
			ENDIF
			cs_Instrct = PrepareSQLtxt(SalesQuote.s_Instrct,'Special Instructions',0,.f.)
			IF VARTYPE(cs_Instrct) != "C"
				cs_Instrct = ' '
			ENDIF
			lInv = PrepareSQLchk(SalesQuote.Inv,'INV')
			IF VARTYPE(lInv) != "L"
				lInv = .F.
			ENDIF
			lGFM = PrepareSQLchk(SalesQuote.GFM,'GFM')
			IF VARTYPE(lGFM) != "L"
				lGFM = .F.
			ENDIF
			lRoll = PrepareSQLchk(SalesQuote.Roll,'Roll')
			IF VARTYPE(lRoll) != "L"
				lRoll = .F.
			ENDIF
			lPress = PrepareSQLchk(SalesQuote.Press,'Press')
			IF VARTYPE(lPress) != "L"
				lPress = .F.
			ENDIF
			lMach = PrepareSQLchk(SalesQuote.MACH,'Mach')
			IF VARTYPE(lMach ) != "L"
				lMach = .F.
			ENDIF
			lCG	= PrepareSQLchk(SalesQuote.CG,'CG')
			IF VARTYPE(lCG) != "L"
				lCG = .F.
			ENDIF
			cTol = PrepareSQLtxt(SalesQuote.Tol,'Tolerence',20)
			IF lCG AND EMPTY(cTol)
				MESSAGEBOX("Please enter a CG Tolerence on SO-Item:"+ALLTRIM(SalesQuote.SoItem_a)+"!",0+64,"Found CG job with no Tolerence.")
			ENDIF
			lPlasma = PrepareSQLchk(SalesQuote.Plasma,'Plasma')
			IF VARTYPE(lPlasma) != "L"
				lPlasma = .F.
			ENDIF
			lWJet = PrepareSQLchk(SalesQuote.WJet,'WJet')
			IF VARTYPE(lWJet) != "L"
				lWJet = .F.
			ENDIF
			nCert = PrepareSQLnum(SalesQuote.Cert,'Cert',-1)
			IF VARTYPE(nCert ) != "N"
				nCert = 0
			ENDIF
			cProcLoc = PrepareSQLtxt(SalesQuote.ProcLoc,'ProcLoc',1)
			IF VARTYPE(cProcLoc) != "C"
				cProcLoc = ''
			ENDIF
			cHeat = PrepareSQLtxt(SalesQuote.heat,'Heat',30,.F.)
			IF VARTYPE(cHeat) != "C"
				cHeat = ' '
			ENDIF
			nConverPO = PrepareSQLnum(SalesQuote.ConverPO,'Convert PO',9,0)
			IF VARTYPE(nConverPO ) != "N"
				nConverPO = 0
			ENDIF
			cConverter = PrepareSQLtxt(SalesQuote.Converter,'Converter',15,.F.)
			IF VARTYPE(cConverter) != "C"
				cConverter = ' '
			ENDIF
			cConversion = PrepareSQLtxt(SalesQuote.Conversion,'Conversion',40,.F.)
			IF VARTYPE(cConversion) != "C"
				cConversion = ' '
			ENDIF
			cConverFrt = PrepareSQLtxt(SalesQuote.ConverFrt,'Convert Frt',10,.F.)
			IF VARTYPE(cConverFrt) != "C"
				cConverFrt = ' '
			ENDIF
			dConverSent = PrepareSQLdate(SalesQuote.ConverSent,'Convert Sent',.T.)
			IF VARTYPE(dConverSent) != "D" AND VARTYPE(dConverSent) != "T"
				dConverSent = CTOD("  /  /    ")
			ENDIF
			IF dConverSent = CTOD("01/01/1900")
				 dConverSent = CTOD("  /  /  ")
			ENDIF
			dConverRetu = PrepareSQLdate(SalesQuote.ConverRetu,'Convert Return',.T.)
			IF VARTYPE(dConverRetu) != "D" AND VARTYPE(dConverRetu) != "T"
				dConverRetu = CTOD("  /  /    ")
			ENDIF
			IF dConverRetu = CTOD("01/01/1900")
				 dConverRetu = CTOD("  /  /  ")
			ENDIF
		
			llShipOn = PrepareSQLchk( ThisForm.pf.pgQuote.chkShipOn.Value,'ShipOn',.F.)
			dShipDue = PrepareSQLdate(SalesQuote.ShipDue,'Ship Due',.T.)
			IF EMPTY(dShipDue)
				MESSAGEBOX("Please use a Ship Due Date.",0+48,"ShipDue is Empty")
			ENDIF
			IF VARTYPE(dShipDue) != "D" AND VARTYPE(dShipDue) != "T"
				dShipDue = CTOD("  /  /    ")
			ENDIF
			IF dShipDue < DATE()-30
				MESSAGEBOX("The ShipDue date is allready over 30 days Late")
				IF dShipDue < DATE()-356
					MESSAGEBOX("Resetting ShipDue to 1 year ago.",0+16,"Please check your dates!")
					dShipDue = DATE()-356
					
				ENDIF
			ELSE
				IF dShipDue > DATE()+365
					MESSAGEBOX("The ShipDue date over 1 year from now!")
					IF dShipDue > DATE()+730
						dShipDue = DATE()+365
						MESSAGEBOX("Resetting ShipDue to 1 year from now.",0+16,"Please check your dates!")
					ENDIF
				ENDIF
			ENDIF	
			dShipped = PrepareSQLdate(SalesQuote.Shipped,'Shipped')
			IF VARTYPE(dShipped) != "D" AND VARTYPE(dShipped) != "T"
				dShipped = CTOD("  /  /    ")
			ENDIF
			nqShipped = PrepareSQLnum(SalesQuote.qShipped,'Quantity Shipped',10,0)
			IF VARTYPE(nqShipped) != "N"
				nqShipped = 0
			ENDIF
			nqBackOrder = PrepareSQLnum(SalesQuote.qBackOrder,'Quantity on Back Order',10,0)
			IF VARTYPE(nqBackOrder) != "N"
				nqBackOrder = 0
			ENDIF
			nMatlWt = PrepareSQLnum(SalesQuote.matlWt,'Material Weight',9,1)
			IF VARTYPE(nMatlWt) != "N"
				nMatlWt = 0
			ENDIF
			lCncld = PrepareSQLchk(SalesQuote.cncld,'Cancelled')
			IF VARTYPE(lCncld) != "L"
				lCncld = .F.
			ENDIF
			*cmplt is only changed with a shipment or packingslip, unless PO has ship direct to customer!
			*lcmplt = PrepareSQLchk(SalesQuote.cmplt,'Complete')
			*IF VARTYPE(lcmplt ) != "L"
			*	lcmplt = .F.
			*ENDIF
			cPartNo = PrepareSQLtxt(SalesQuote.PartNo,'Part Number',100,.F.)
			IF VARTYPE(cPartNo) != "C"
				cPartNo = ' '
			ENDIF
			nItemCost = PrepareSQLnum(SalesQuote.ItemCost,'Item Cost',9,2)
			IF VARTYPE(nItemCost ) != "N"
				nItemCost = 0
			ENDIF
			nItemSale = PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',9,2)
			IF VARTYPE(nItemSale) != "N"
				nItemSale = 0
			ENDIF
			nRMA_No = PrepareSQLnum(SalesQuote.RMA_No,'RMA No',10,0)
			IF VARTYPE(nRMA_No ) != "N"
				nRMA_No = 0
			ENDIF
			
			PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU
			nQuoted_PU	= GetPUfromForm( SalesQuote.Form, ThisForm.nConnHandle )
			nQuoted_QTY	= Get_QTY( SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.Weight, nQuoted_PU, ThisForm.nConnHandle)
			nQuoted_Total = SalesQuote.ItemSale
			
			IF nQuoted_QTY > 0
				nQuoted_P	= nQuoted_Total/ nQuoted_QTY
			ELSE
				nQuoted_P	= 0
			ENDIF
		
			cSoItem = Proper_SO_item( SalesQuote.SoItem_a )
			
			
			cSQLu = "UPDATE dbo.Sales SET "
			cSQLu = cSQLu + " OrderSpec='"+ALLTRIM(cOrderSpec)+"'"
			cSQLu = cSQLu + ",s_Instrct='"+ALLTRIM(cs_Instrct)+"'"
			cSQLu = cSQLu + ",inv="+IIF(lInv,"1","0")
			cSQLu = cSQLu + ",gfm="+IIF(lGfm,"1","0")
			cSQLu = cSQLu + ",roll="+IIF(lRoll,"1","0")
			cSQLu = cSQLu + ",press="+IIF(lPress,"1","0")
			cSQLu = cSQLu + ",mach="+IIF(lMach,"1","0")
			cSQLu = cSQLu + ",cg="+IIF(lCG,"1","0")
			cSQLu = cSQLu + ",Plasma="+IIF(lPlasma,"1","0")
			cSQLu = cSQLu + ",WJet="+IIF(lWJet,"1","0")
			cSQLu = cSQLu + ",cert="+STR(nCert)
			cSQLu = cSQLu + ",heat='"+ALLTRIM(cheat)+"'"
			cSQLu = cSQLu + ",ConverPO="+STR(nConverPO)
			cSQLu = cSQLu + ",Converter='"+ALLTRIM(cConverter)+"'"
			cSQLu = cSQLu + ",Conversion='"+ALLTRIM(cConversion)+"'"
			cSQLu = cSQLu + ",ConverFrt='"+ALLTRIM(cConverFrt)+"'"
			cSQLu = cSQLu + ",ConverSent='"+IIF(EMPTY(dConverSent),'',DTOC(dConverSent))+"'"
			cSQLu = cSQLu + ",ConverRetu='"+IIF(EMPTY(dConverRetu),'',DTOC(dConverRetu))+"'"
			cSQLu = cSQLu + ",ShipON="+IIF(llShipOn,"1","0")
			cSQLu = cSQLu + ",ShipDue='"+IIF(EMPTY(dShipDue),'',DTOC(dShipDue))+"'"
			cSQLu = cSQLu + ",Shipped='"+IIF(EMPTY(dShipped),'',DTOC(dShipped))+"'"
			cSQLu = cSQLu + ",qShipped="+STR(nqShipped,10,0)
			cSQLu = cSQLu + ",qBackOrder="+STR(nqBackOrder,10,0)
			cSQLu = cSQLu + ",matlWt="+STR(nMatlWt,9,1)
			cSQLu = cSQLu + ",cncld="+IIF(lcncld,"1","0")
		*	cSQLu = cSQLu + ",cmplt="+IIF(lcmplt,"1","0")  &&Update with ship or PackingSlip, unless PO has ship direct
			cSQLu = cSQLu + ",PartNo='"+ALLTRIM(cPartNo)+"'"
			cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
			cSQLu = cSQLu + ",ItemSale="+STR(nItemSale,9,2)
			cSQLu = cSQLu + ",RMA_No="+ALLTRIM(STR(nRMA_No))
			cSQLu = cSQLu + ",Tol='"+ALLTRIM(cTol)+"'"
			cSQLu = cSQLu + ",ProcLoc='"+cProcLoc+"'"
			
			cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
			cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
			cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4)
			cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
						
			cSQLu = cSQLu + " WHERE SOitem = '"+cSoItem+"'"
		
			WAIT WINDOW "UPDATE dbo.Sales " NOWAIT
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
				lReturn = .F.
			ENDIF
			
			
			IF lCncld 
				*Remove Cancelled process from StockLst and BrokerLst
				
				cSQL = "DELETE FROM dbo.StockLst_Process "
				cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSoItem+"')"
				cSQL = cSQL + " AND Process_ID = 'SELECTED  '"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
					lReturn = .F.
				ENDIF
				
				*************
				cSQL = "DELETE FROM dbo.BrokerLst_Process "
				cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSoItem+"')"
				cSQL = cSQL + " AND Process_ID = 'SELECTED  '"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
					lReturn = .F.
				ENDIF
				
				
			ENDIF
		ENDSCAN
		
		
		
		IF VARTYPE(lnSoldAddr) != "N"
			lnSoldAddr = 0
		ENDIF
		IF VARTYPE(lnShipAddr) != "N"
			lnShipAddr= 0
		ENDIF
		
		IF VARTYPE(llpaper_po) != "L"
			llpaper_po = .F.
		ENDIF
		IF VARTYPE(llBlind) != "L"
			llBlind= .F.
		ENDIF
		IF VARTYPE(llFaxConf) != "L"
			llFaxConf= .F.
		ENDIF
		IF VARTYPE(llEmailConf) != "L"
			llEmailConf= .F.
		ENDIF
		IF VARTYPE(lnFreightEst) != "N"
			lnFreightEst = 0
		ENDIF
		IF VARTYPE(llPrintedSO) != "L"
			llPrintedSO = .F.
		ENDIF
		
		IF VARTYPE(llFoundCountry) != "L"
			llFoundCountry = .F.
		ENDIF
		
		IF VARTYPE(llUSA) != "L"
			llUSA= .F.
		ENDIF
		
		
		IF VARTYPE(lnAmendment) != "N"
			lnAmendment = 0
		ENDIF
		IF EMPTY(lnAmendment)
			lnAmendment = 0
		ENDIF
		IF Sales_No_Changing(lnSalesNum,ThisForm.nConnHandle) &&Also Alerts Shop of Changing SO!
			lnAmendment = lnAmendment + 1
		ENDIF
		IF VARTYPE(lECPC) != "L"
			lECPC = .F.
		ENDIF
		
		*Check to See if Sales_No Exist to Update
		
		PRIVATE nCountSales_No
		nCountSales_No = Count_SOinSales_No(lnSalesNum ,ThisForm.nConnHandle,'')
		IF nCountSales_No = 0
		
			*Add Sales_No
			PRIVATE cSalesRep,nSOItemTot
			cSalesRep = SalesPDescription(SalesQuote.SalesP)
			nSOItemTot	= 1
			
			nSOItemTot = Count_SOinSales_No( lnSalesNum, ThisForm.nConnHandle )
			
			cSQL = "INSERT INTO dbo.Sales_No (SalesNum,SalesRep,ItemTot) VALUES ("+ALLTRIM(STR(lnSalesNum ))
			cSQL = cSQL +",'"+cSalesRep+"',"+STR(nSOItemTot)+")"  
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
				lReturn = .F.
			ENDIF
		ENDIF
		
		PRIVATE lCancelSO
		lCancelSO = PrepareSQLchk(ThisForm.pf.pgBillTo.chkCancel.Value,'Cancel')
		
		cSQL = "UPDATE dbo.Sales_No SET "
		cSQL = cSQL + "instrct= '"+ALLTRIM(lcInstrct) +"'"
		cSQL = cSQL + ",pSoldAddr= "+ALLTRIM(STR(lnSoldAddr))+""
		cSQL = cSQL + ",pShipAddr= "+ALLTRIM(STR(lnShipAddr))+""
		cSQL = cSQL + ",shiproute= '"+ALLTRIM(lcShipRoute)+"'"
		cSQL = cSQL + ",ShipPay= '"+lcShipPay+"'"
		cSQL = cSQL + ",PayType= '"+lcPayType+"'"
		cSQL = cSQL + ",Paper_PO	= "+IIF(llpaper_po,'1','0')+""
		cSQL = cSQL + ",Blind= "+IIF(llBlind,'1','0')+""
		cSQL = cSQL + ",FaxConf= "+IIF(llFaxConf,'1','0')+""
		cSQL = cSQL + ",EmailConf= "+IIF(llEmailConf,'1','0')+""
		cSQL = cSQL + ",FreightEst= "+STR(lnFreightEst)+""
		cSQL = cSQL + ",PrintedSO= "+IIF(llPrintedSO,'1','0')+""
		cSQL = cSQL + ",Addr_Ref= '"+lcAddr_Ref+"'"
		cSQL = cSQL + ",trt_lumber= "+IIF(llFoundCountry,'1','0')+""
		cSQL = cSQL + ",TarfBill= '"+lcTarfBill+"'"
		cSQL = cSQL + ",USA= "+IIF(llUSA,'1','0')+""
		cSQL = cSQL + ",Amendment= "+STR(lnAmendment,2,0)+""
		cSQL = cSQL + ",ECPC= "+IIF(lECPC,'1','0')+""
		cSQL = cSQL + ",Changing=0 "+" "
		cSQL = cSQL + ",Cncld="+IIF(lCancelSO,'1','0')+"" 
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(lnSalesNum ))
			
		WAIT WINDOW "UPDATE dbo.Sales_No " NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
			lReturn = .F.
		ELSE
		*!*		*Check to see if All Sales is Cancelled
		*!*		IF Count_SOinSales( lnSalesNum, ThisForm.nConnHandle, 'NotCancelled' ) = 0
		*!*			*Make Sales_No Cancelled
		*!*			cSQLu = "UPDATE dbo.Sales_No SET "
		*!*			cSQLu = cSQLu + "Cncld = '1'"
		*!*			cSQLu = cSQLu + ", ShopRecv='1'"
		*!*			cSQLu = cSQLu + " WHERE SalesNum = "+STR(lnSalesNum)
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!, long triger
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
		*!*				ENDDO
		*!*			ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
		*!*			ELSE
		*!*				ThisForm.pf.pgQA.txtVersion.Value = lnAmendment
		*!*				ThisForm.pf.pgBillTo.txtAmendment.Value = lnAmendment
		*!*			ENDIF	
		*!*		ENDIF 
			
			ThisForm.pf.pgQA.txtVersion.Value = lnAmendment
			ThisForm.pf.pgBillTo.txtAmendment.Value = lnAmendment
		ENDIF
		
		WAIT WINDOW "Data has been Stored!" NOWAIT
		
		LOCAL lcSOitem
		SELECT SalesQuote
		SCAN
			lcSOitem = Proper_SO_item( SalesQuote.SOitem_A )
			IF EMPTY(lcSOitem)
				lcSOitem = Proper_SO_Item(SalesQuote.SOitem_B)
			ENDIF
			********Update Ship
			IF SalesQuote.cncld 
				* Update Ship - Cancelled
				cSQL = "UPDATE dbo.Ship SET	"
				cSQL = cSQL + "[cncld] = '1'"
				cSQL = cSQL + ",Salesp = '"+PrepareSQLtxt(SalesQuote.Salesp,'SalesP',1)+"'"
				cSQL = cSQL + ",company = '"+PrepareSQLtxt(SalesQuote.company,'Company',30)+"'"
				cSQL = cSQL + ",PO_Num = '"+PrepareSQLtxt(SalesQuote.PO_Num,'PO_Num',17)+"'"
				cSQL = cSQL + ",alloy = '"+PrepareSQLtxt(SalesQuote.alloy,'Alloy',12)+"'"
				cSQL = cSQL + ",duedate = '"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
				*cSQL = cSQL + "	WHERE SOitem = dbo.ProperSO('"+lcSOItem+"')"
				cSQL = cSQL + "	WHERE SOitem = '"+lcSOItem+"'"
				
				WAIT WINDOW "UPDATE dbo.Ship " NOWAIT
		
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				ENDIF
			ELSE
				* Update Ship - Not Cancelled
				PRIVATE nCountShip
				nCountShip = Count_ShipbySOitem( lcSOItem, ThisForm.nConnHandle, '' )
				
				IF nCountShip > 0 Then
				
					cSQL = "UPDATE dbo.Ship SET	"
					cSQL = cSQL + "[cncld] = '0'"
					cSQL = cSQL + ",Salesp = '"+PrepareSQLtxt(SalesQuote.Salesp,'SalesP',1)+"'"
					cSQL = cSQL + ",company = '"+PrepareSQLtxt(SalesQuote.company,'Company',30)+"'"
					cSQL = cSQL + ",PO_Num = '"+PrepareSQLtxt(SalesQuote.PO_Num,'PO_Num',17)+"'"
					cSQL = cSQL + ",alloy = '"+PrepareSQLtxt(SalesQuote.alloy,'Alloy',12)+"'"
					cSQL = cSQL + ",duedate = '"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
					cSQL = cSQL + "	WHERE SOitem = dbo.ProperSO('"+lcSOItem+"')"
					
					WAIT WINDOW "UPDATE dbo.Ship" NOWAIT
		
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
						lReturn = .F.
					ENDIF
				ELSE
		 			cSQL = "INSERT INTO dbo.Ship "
		 			cSQL = cSQL + "(SalesNum,Salesp,OrderDate,company,PO_Num,alloy,duedate,SOitem,Item,cncld,qShipped,[Complete]) VALUES ("
		 			cSQL = cSQL + ""+STR(PrepareSQLnum(SalesQuote.SalesNum_a,'SalesNum',-3,0),10,0)+""
					cSQL = cSQL + ",'"+PrepareSQLtxt(SalesQuote.Salesp,'SalesP',1)+"'"
					cSQL = cSQL + ",'"+DTOC(DATE())+"'"
					cSQL = cSQL + ",'"+PrepareSQLtxt(SalesQuote.company,'Company',30)+"'"
					cSQL = cSQL + ",'"+PrepareSQLtxt(SalesQuote.PO_Num,'PO_Num',17)+"'"
					cSQL = cSQL + ",'"+PrepareSQLtxt(SalesQuote.alloy,'Alloy',12)+"'"
					cSQL = cSQL + ",'"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
					cSQL = cSQL + ",'"+Proper_SO_Item(SalesQuote.SoItem_A)+"'"
					cSQL = cSQL + ",'"+STR(PrepareSQLnum(SalesQuote.Item_A,'Item',2,0),2,0)+"'"
					cSQL = cSQL + ",0,0,0"+")"
					
					WAIT WINDOW "INSERT dbo.Ship " NOWAIT
		
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
				ENDIF
			ENDIF	&&End Update Ship
		
			***** Save Production order 
			IF UPPER(SalesQuote.Company) = "HIGH PERFORMANCE ALLOYS"
				IF SalesQuote.cncld 
					*Remove from BrokerLst
					
				ELSE
					*Check BrokerLst for Insert or Update
					
				ENDIF
			ENDIF
			
			***** ...Lst_Process
			IF NOT EMPTY(SalesQuote.shipdue) OR SalesQuote.ShipDue = CTOD("01/01/1900")
				IF NOT ISNULL(SalesQuote.shipdue)
					cSQLUpdate = "UPDATE dbo.StockLst_Process "
					cSQLUpdate = cSQLUpdate + " SET DueDate = '"+IIF(EMPTY(SalesQuote.shipdue),'',DTOC(SalesQuote.shipdue))+"'"
					cSQLUpdate = cSQLUpdate + " WHERE SOitem = dbo.ProperSO('"+lcSOitem+"')"
					cSQLUpdate = cSQLUpdate + " AND Process_ID = 'SELECTED  '"
					
					WAIT WINDOW "UPDATE dbo.StockLst_Process " NOWAIT
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLUpdate,ThisForm.nConnHandle, nSQLEXEC,'')
					ENDIF
		
		***			****
					cSQLUpdate = "UPDATE dbo.BrokerLst_Process "
					cSQLUpdate = cSQLUpdate + " SET DueDate = '"+IIF(EMPTY(SalesQuote.shipdue),'',DTOC(SalesQuote.shipdue))+"'"
					cSQLUpdate = cSQLUpdate + " WHERE SOitem = dbo.ProperSO('"+lcSOitem+"')"
					cSQLUpdate = cSQLUpdate + " AND Process_ID = 'SELECTED  '"
					
					WAIT WINDOW "UPDATE dbo.BrokerLst_Process " NOWAIT
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLUpdate)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLUpdate)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLUpdate,ThisForm.nConnHandle, nSQLEXEC,'')
					ENDIF
		
				ENDIF
			ENDIF
			
			WAIT WINDOW "Validate_Sales_ShipDue() " NOWAIT
			Validate_Sales_ShipDue(lcSOitem,ThisForm.nConnHandle)
			
		ENDSCAN
		
		IF THISFORM.ShipAddr > 0 AND THISFORM.SoldAddr > 0
			WAIT WINDOW "Save_Sold_Ship() " NOWAIT
			Save_Sold_Ship(THISFORM.SoldAddr, THISFORM.ShipAddr, ThisForm.nConnHandle)
		ENDIF
		
		ThisForm.cmdFAXConfSO.Enabled = .T.
		THISFORM.cmdProforma.ENABLED = .T.
		
		
		WAIT CLEAR
		
		SELECT SalesQuote
		*ThisForm.Refresh &&Does not work with the Value page
		IF mHoldRecordNum > 0
			GOTO (mHoldRecordNum) IN SalesQuote
		ELSE
			GOTO TOP
		ENDIF
		
		RETURN lReturn
		
	ENDPROC

	PROCEDURE seekccsoldcodeinsoldaddr
		PARAMETERS nSoldCode
		*ThisForm.SeekCcSoldCodeinSoldAddr(ThisForm.ccSoldAddr)
		
		IF VARTYPE(nSoldCode) != "N"
			RETURN .F.
		ENDIF
		
		IF USED( 'ccSoldAddr' )
			USE IN ccSoldAddr
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.SoldAddr"
		cSQL = cSQL + " WHERE SoldCode = "+STR(nSoldCode)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ccSoldAddr')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ccSoldAddr')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ccSoldAddr')
		ENDIF
		
		IF !USED( 'ccSoldAddr' )
			cSQL = "SELECT * FROM dbo.SoldAddr"
			cSQL = cSQL + " WHERE 0>0"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ccSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ccSoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ccSoldAddr')
				RETURN .F.
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE seeksalesnumincreditcd
		PARAMETERS nSalesNum
		*ThisForm.SeekSalesNuminCreditCd()
		
		IF VARTYPE(nSalesNum) != "N"
			RETURN .F.
