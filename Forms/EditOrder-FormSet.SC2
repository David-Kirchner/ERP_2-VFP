	PROCEDURE frmEdt.pf.pgQuote.txtPieces.Valid
		PRIVATE cAlloy, cForm, nPieces, nThck, nSz2, nSz3
		cAlloy		= PrepareSQLtxt(This.Parent.txtAlloy.VALUE,'Alloy',12,.F.)
		cForm		= PrepareSQLtxt(This.Parent.cmbForm.VALUE,'Form',2,.T.)
		nPieces		= PrepareSQLnum(This.Value,'Pieces',-3)
		nThck		= PrepareSQLnum(This.Parent.txtThck.VALUE,'Thck',10,4)
		nSz2		= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
		nSz3		= PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
		PRIVATE nPounds, nWeight
		nPounds		= CalcWeight (nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)
		nWeight		= PrepareSQLnum(This.Parent.txtWeight.Value,'Weight',9,1)
		
		IF nPounds > 0
			IF nWeight > 0
				IF ROUND(nPounds,0) != ROUND(nWeight,0)
					IF MESSAGEBOX("Calculated weight is "+ALLTRIM(STR(nPounds,9,1))+"."+CHR(13)+"Quoted weight is "+ALLTRIM(STR(nWeight,9,1))+"."+CHR(13)+CHR(13)+"Do you want to use the calculated Weight?",4+48,"Replace Quoted Weight?") = 6
						This.Parent.txtWeight.Value = nPounds
						SELECT SalesQuote
						REPLACE SalesQuote.Weight WITH nPounds
					ENDIF
				ENDIF
			ELSE
				*nWeight is zero
				This.Parent.txtWeight.Value = nPounds
				SELECT SalesQuote
				REPLACE SalesQuote.Weight WITH nPounds
			ENDIF
		ENDIF		
		
	ENDPROC

