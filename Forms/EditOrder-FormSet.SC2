	PROCEDURE frmPO.pgfPO.pgPODesc.lblPerUnit.Click
		PRIVATE cForm,cUnit,nStockLst_P
		cForm	= PrepareSQLtxt(This.parent.cmbForm.Value,'Form',2)
		cUnit	= FormUnitPrice( cForm, ThisForm.nConnHandle )
		nStockLst_P = PrepareSQLnum(This.parent.txtStockLst_P.Value,'StockLst_P',-5)
		
		PRIVATE nOrder_Qty, nStockLst_QTY,nOrig_StockLst_QTY
		nOrder_Qty			= PrepareSQLnum(This.parent.txtOrder_Qty.Value,'Order_Qty',11,3)
		nOrig_StockLst_QTY	= PrepareSQLnum(This.parent.txtStockLst_QTY.Value,'StockLst_QTY',-5)
		nStockLst_QTY = 0
		
		PRIVATE nP_lb, nP_pc, nP_ft, nLotP, nOtherP, cOtherFld, nPieces
		nP_lb			= PrepareSQLnum(This.parent.txtP_lb.VALUE,'P_Lb',8,2)
		nP_pc			= PrepareSQLnum(This.parent.txtP_pc.VALUE,'P_Pc',9,2)
		nP_ft			= PrepareSQLnum(This.parent.txtP_ft.VALUE,'P_Ft',8,2)
		nLotP			= PrepareSQLnum(This.parent.txtLotP.VALUE,'LotP',9,2)
		nOtherP			= PrepareSQLnum(This.parent.txtOtherP.VALUE,'OtherP',8,2)
		cOtherFld		= PrepareSQLtxt(This.parent.txtOtherFld.VALUE,'OtherFld',10,.F.)
		nPieces			= PrepareSQLnum(This.parent.txtPieces.VALUE,'Pieces',6,0)
		
		
		PRIVATE nCalcStockLst_QTY  
		nCalcStockLst_QTY  = 0	
		*Get nCalcStockLst_QTY 
		DO CASE
		CASE cUnit = "LB"
			PRIVATE cAlloy, cForm, nThck, nSz2, nSz3
			cAlloy			= PrepareSQLtxt(This.Parent.txtAlloy.VALUE,'Alloy',12,.F.)
			cForm			= PrepareSQLtxt(This.Parent.cmbForm.VALUE,'Form',2,.T.)
			nThck			= PrepareSQLnum(This.Parent.txtThck.VALUE,'Thck',10,4)
			nSz2			= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
			nSz3			= PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
			
			nCalcStockLst_QTY = CalcWeight (nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)
			
			IF nOrder_Qty > 0
				*may have LBS estimated
				IF nOrder_Qty < nStockLst_QTY * 1.1  AND  nOrder_Qty > nStockLst_QTY * .9
					*Calculated LBS are within 10%, use the estimated nOrder_Qty
					nStockLst_QTY = nOrder_Qty
				ENDIF
			ENDIF
			
		CASE cUnit = "PC"
			nCalcStockLst_QTY = nPieces
		CASE cUnit = "FT"
			IF Uses3rdDim( cForm )
				nLength = PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
			ELSE
				nLength	= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
			ENDIF
			nCalcStockLst_QTY = nPieces * nLength / 12
		OTHERWISE
			nCalcStockLst_QTY = 0
		ENDCASE
		
		IF nCalcStockLst_QTY > 0
			IF nOrig_StockLst_QTY > 0
			
				IF nCalcStockLst_QTY <> nOrig_StockLst_QTY 
					IF MESSAGEBOX("The Quantity was originally listed as: "+STR(nOrig_StockLst_QTY,10,3)+CHR(13)+;
					              "    The Quantity is now calculated as: "+STR(nCalcStockLst_QTY ,10,3)+CHR(13)+;
					              +CHR(13)+"Do you wish to use the calculated Quantity?",4+32,"Use new calculation?") = 6
						
						nStockLst_QTY = nCalcStockLst_QTY 
						This.parent.txtStockLst_QTY.Value = nCalcStockLst_QTY 
						This.parent.txtStockLst_QTY.Refresh
					ELSE
						nStockLst_QTY = nOrig_StockLst_QTY 
					ENDIF
				ELSE
					nStockLst_QTY = nOrig_StockLst_QTY 
				ENDIF
		
			ENDIF
		ELSE
			nStockLst_QTY = nOrig_StockLst_QTY 
		ENDIF
		*******************
		
		IF nStockLst_QTY = 0
			*BAD
			MESSAGEBOX("Please Enter the StockLst Quantity first."+CHR(13)+"'Units to be priced' field.",48,"Could not calculate Stock List Quantity")
			RETURN .F.
		ENDIF
		
		PRIVATE nCalcUnitPrice
		nCalcUnitPrice = 0.00
		
		DO CASE
		CASE cUnit = "LB"
			nCalcUnitPrice = nP_lb
		CASE cUnit = "PC"
			nCalcUnitPrice = nP_Pc
		CASE cUnit = "FT"
			nCalcUnitPrice = nP_Ft
		ENDCASE
		
		PRIVATE lServices,lConvServ
		lServices = PrepareSQLchk( This.parent.chkServicesPO.Value, 'ServicesPO' )
		lConvServ = PrepareSQLchk( This.parent.chkConvServ.Value, 'ConvServ' )
			
		IF nCalcUnitPrice > 0
			This.Caption = FormUnitCaption(cForm,lServices,lConvServ,ThisForm.nConnHandle)
		ELSE
			*Need to work out the price
			IF nLotP > 0
				nCalcUnitPrice = nLotP / nStockLst_QTY
			ELSE
				IF nP_pc > 0
					nCalcUnitPrice = (nP_pc*nPieces) / nStockLst_QTY
				ELSE
					IF nP_ft > 0
						PRIVATE nTotalFT, cForm, nThck, nSz2, nSz3, nLength
						cForm			= PrepareSQLtxt(This.Parent.cmbForm.VALUE,'Form',2,.T.)
						nThck			= PrepareSQLnum(This.Parent.txtThck.VALUE,'Thck',10,4)
						nSz2			= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
						nSz3			= PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
								
						IF Uses3rdDim( cForm )
							nLength = PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
						ELSE
							nLength	= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
						ENDIF
						nTotalFT = nPieces * nLength / 12
						
						nCalcUnitPrice = nTotalFT / nStockLst_QTY
					ELSE
						*BAD
						MESSAGEBOX("Could not Calculate the 'Price Per Unit'"+CHR(13)+"Please enter by hand.",48,"Calc Error")
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		IF nOtherP > 0
			*Add Other price into Per Unit Value
			PRIVATE nTotalValue
			nTotalValue = (nCalcUnitPrice * nStockLst_QTY) + nOtherP 
			IF nTotalValue > 0
				nCalcUnitPrice = nTotalValue / nStockLst_QTY
				MESSAGEBOX("Calculated price per unit is now="+ALLTRIM(STR(nCalcUnitPrice))+CHR(13)+"with the 'Other Price' add in to total.",64,"Calculated Price.")
			ENDIF
			IF nStockLst_P <> nCalcUnitPrice
				MESSAGEBOX("Calculated price per unit is now="+ALLTRIM(STR(nCalcUnitPrice)),64,"Calculated Price.")
			ENDIF
		ENDIF
		
		This.parent.txtStockLst_P.Value = nCalcUnitPrice
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.lblPounds.Click
		*PROCEDURE GetWeight
		*PARAMETER nPieces,cAlloy,cForm,nThck,nSz2,nSz3,pConnHandle
		*nLBS = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,pConnHandle)
		*EXEC dbo.p_GetWeight ()
		
		PRIVATE nPieces,cAlloy,cForm,nThck,nSz2,nSz3
		This.parent
		nPieces	= PrepareSQLnum(This.parent.txtPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(This.parent.cmbForm.Value,'Form',2)
		nThck	= PrepareSQLnum(This.parent.txtThck.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(This.parent.txtSz2.Value,'Sz2',10,3)
		nSz3	= PrepareSQLnum(This.parent.txtSz3.Value,'Sz3',10,3)
		
		PRIVATE nLBS
		nLBS = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,ThisForm.nConnHandle)
		This.parent.txtPounds.Value = nLBS
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.lblStockLst_QTY.Click
		PRIVATE cForm,cUnit
		cForm	= PrepareSQLtxt(This.parent.cmbForm.Value,'Form',2)
		cUnit	= FormUnitPrice( cForm, ThisForm.nConnHandle )
		
		PRIVATE nOrder_Qty, nStockLst_QTY
		nOrder_Qty		= PrepareSQLnum(This.parent.txtOrder_Qty.Value,'Order_Qty',11,3)
		nStockLst_QTY	= PrepareSQLnum(This.parent.txtStockLst_QTY.Value,'StockLst_QTY',-5)
		
		PRIVATE nPieces
		nPieces	= PrepareSQLnum(This.parent.txtPieces.VALUE,'Pieces',6,0)
		
		
		IF nStockLst_QTY = 0
			*Get nStockLst_QTY
			DO CASE
			CASE cUnit = "LB"
		*		nOrder_Qty =  dbo.GetWeight('1','C-276','40',1,12,48)
		*		CalcWeight (nPieces, cAlloy, cForm, nThickness, nSize2, nSize3, pConnHandle)
				
				PRIVATE cAlloy, cForm, nThck, nSz2, nSz3
				cAlloy			= PrepareSQLtxt(This.Parent.txtAlloy.VALUE,'Alloy',12,.F.)
				cForm			= PrepareSQLtxt(This.Parent.cmbForm.VALUE,'Form',2,.T.)
				nThck			= PrepareSQLnum(This.Parent.txtThck.VALUE,'Thck',10,4)
				nSz2			= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
				nSz3			= PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
				
				nStockLst_QTY = CalcWeight (nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)
				
				IF nOrder_Qty > 0
					IF nPieces = 0 
						nStockLst_QTY = nOrder_Qty 
					ELSE
						*may have LBS estimated
						IF nOrder_Qty < nStockLst_QTY * 1.1  AND  nOrder_Qty > nStockLst_QTY * .9
							*Calculated LBS are within 10%, use the estimated nOrder_Qty
							nStockLst_QTY = nOrder_Qty
						ENDIF
					ENDIF 
				ENDIF
			CASE cUnit = "PC"
				nStockLst_QTY = nPieces
			CASE cUnit = "FT"
				IF Uses3rdDim( cForm )
					nLength = PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
				ELSE
					nLength	= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
				ENDIF
				nStockLst_QTY = nPieces * nLength / 12
			OTHERWISE
				nStockLst_QTY = 0
			ENDCASE
			
			IF nStockLst_QTY > 0
				WAIT WINDOW "Calculated the Stock List Quantity and saved "+ALLTRIM(STR(nStockLst_QTY))+" to 'Units to be priced' field." TIMEOUT 1
				This.parent.txtStockLst_QTY.Value = nStockLst_QTY
				This.parent.txtStockLst_QTY.Refresh
			ENDIF
		ENDIF
		
		IF nStockLst_QTY = 0
			IF nOrder_Qty > 0
				*Use the Order Qty
				nStockLst_QTY = nOrder_Qty
				This.parent.txtStockLst_QTY.Value = nOrder_Qty
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtAlloy.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr, cSearchStrOrig, lcTryAlloy 
		nInsertionPt  = THIS.SELSTART
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		lcSearchStr = PrepareSQLtxt(cSearchStrOrig,'Alloy',12)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,nInsertionPt )
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig 
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = nInsertionPt 
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
				
				PRIVATE cDisplayAlloy
				cDisplayAlloy = PrepareSQLtxt(This.parent.txtDispAlloy.Value,'DisplayAlloy',20)
				
				IF NOT EMPTY(cDisplayAlloy)
					IF NOT CheckDisplayAlloyforAlloy(cDisplayAlloy, cAlloyStandard, ThisForm.nConnHandle)
						MESSAGEBOX("Display Alloy:"+ALLTRIM(cDisplayAlloy)+" has never been purchased as HPA Alloy:"+ALLTRIM(cAlloyStandard)+"!",0+48,"Check your Display Alloy!")
					ENDIF
				ENDIF
				
				
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtCompany.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr,cSearchStrOrig, lcTryVendor
		nInsertionPt  = THIS.SELSTART
		IF EMPTY(This.Value)
			* Nothing to Validate
			RETURN .T.
		ENDIF
			
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		lcSearchStr = PrepareSQLtxt(cSearchStrOrig,'Company',30)
		lcTryVendor  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryVendor = ALLTRIM(SearchVendorCompany(lcSearchStr,"BEGINS", ThisForm.nConnHandle ))
			IF NOT EMPTY(lcTryVendor)		
				IF UPPER(lcSearchStr) = UPPER(SUBSTR(lcTryVendor,1,nInsertionPt ))
					THIS.VALUE=lcTryVendor
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=cSearchStrOrig
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = nInsertionPt 
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtCompany.LostFocus
		=insmode(.T.)
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtCompany.Valid
		PRIVATE lcSearchStr, cSearchStrOrig, lcTryVendor, nInsertionPt 
		nInsertionPt  = THIS.SELSTART
		IF EMPTY(This.Value)
			RETURN .T.
		ENDIF
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		lcSearchStr = PrepareSQLtxt(cSearchStrOrig,'Company',30)
		lcTryVendor  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryVendor = ALLTRIM( SearchVendorCompany(lcSearchStr,"BEGINS",ThisForm.nConnHandle ) )
			IF NOT EMPTY(lcTryVendor)		
				IF UPPER(lcSearchStr) = UPPER(SUBSTR(lcTryVendor,1,nInsertionPt ))
					THIS.VALUE=lcTryVendor
					THIS.FORECOLOR = RGB(0,0,0)
					
					PRIVATE nVendCode 
					nVendCode = getVendCode_Company(lcSearchStr,ThisForm.nConnHandle)
					IF VARTYPE(ThisForm.VendCode)!="N"
						ThisForm.VendCode = 0
					ENDIF
					IF ThisForm.VendCode = 0
						ThisForm.VendCode = nVendCode
					ELSE
						IF ThisForm.VendCode > 0
						
							ThisForm.CheckVendCode() &&Check SO item for using a PO for Conversion Services
							
							IF ThisForm.VendCode != nVendCode
								IF nVendCode > 0
									PRIVATE cOldVendorCompany, cCurVendorCompany
									cOldVendorCompany = getVendor_Company_VendCode(ThisForm.VendCode,ThisForm.nConnHandle)
									cCurVendorCompany = getVendor_Company_VendCode(nVendCode,ThisForm.nConnHandle)
									MESSAGEBOX("This Vendor "+ALLTRIM(cCurVendorCompany)+" has a preferred VendCode of "+ALLTRIM(STR(nVendCode))+CHR(13)+"Vendor was "+ALLTRIM(cOldVendorCompany)+" with VendCode="+ALLTRIM(STR(ThisForm.VendCode))+CHR(13)+"The Vendor Address was updated on this PO."+CHR(13)+"Check Vendor Contact for this address.",0+48,"Please recheck Vendor Address and Contact")
									
									TrackMess("Salesnum:"+ALLTRIM(STR(Thisform.SalesNum))+" POitem:"+ALLTRIM(ThisForm.POitem)+" This Vendor "+ALLTRIM(lcSearchStr)+" has a preferred VendCode of "+ALLTRIM(STR(nVendCode))+CHR(13)+"Vendor was "+ALLTRIM(cOldVendorCompany)+" with VendCode="+ALLTRIM(STR(ThisForm.VendCode))+CHR(13)+"The Vendor Address was updated on this PO."+CHR(13)+"Check Vendor Contact for this address."+" frmEdt.txtCompany.Valid()")
		
									IF ThisForm.FillVendorAddr(nVendCode)
										ThisForm.Address_Screen("VendorEdit")
										*ThisForm.VendCode = nVendCode
									ENDIF							
		
									
									ThisForm.nContactID = 0
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					
					PRIVATE cVendorCompany
					cVendorCompany = ALLTRIM(This.Parent.Parent.PgVendor.txtCompany.Value)
					IF lcTryVendor != cVendorCompany 
						MESSAGEBOX("This Vendor name:"+lcTryVendor +CHR(13)+"is different from the name used on the Vendor Address tab."+CHR(13)+cVendorCompany+CHR(13)+"Please correct Vendor Address name.",0+48,"Different Vendor names.") 
					
					ENDIF
				ELSE
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
					WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig 
				THIS.FORECOLOR = RGB(255,0,0)
				WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
			ENDIF
		ELSE
			WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtDispAlloy.Valid
		PRIVATE cAlloy ,cAlloyStandard
		cAlloyStandard = PrepareSQLtxt(This.Value,'DisplayAlloy',20)
		cAlloy = PrepareSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
		
		IF NOT EMPTY(cAlloy)
			IF NOT EMPTY(cAlloyStandard)
		
				IF NOT CheckDisplayAlloyforAlloy(cAlloy, cAlloyStandard, ThisForm.nConnHandle)
					MESSAGEBOX("Display Alloy to Vendor:"+ALLTRIM(cAlloy)+" has never been purchased as HPA Alloy:"+ALLTRIM(cAlloyStandard)+"!",0+48,"Check your Display Alloy!")
				ENDIF
				
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtDue_max.Valid
		PRIVATE vDate, dDate
		vDate = This.Value
		
		IF VARTYPE(vDate) = "T"
			dDate = TTOD(vDate)
			This.Value = dDate
		ENDIF
		IF VARTYPE(vDate) = "D"
			dDate = vDate
		ENDIF
		IF VARTYPE(vDate) = "C"
			dDate = CTOD(vDate)
			This.Value = dDate
		ENDIF
		
		
		
		IF dDate != CTOD("  /  /  ")
			*Have a date
			IF dDate > DATE() + 1095 
				*3 Years Ahead
				MESSAGEBOX("This date field is for OVER 3 years ahead!",0,"PO Valid")
			ENDIF
			IF dDate < DATE() - 90
				*3 Years Ahead
				MESSAGEBOX("This date field is for 3 months ago!",0,"PO Valid")
			ENDIF
		ENDIF
		
		PRIVATE dDue_Min
		dDue_Min = PrepareSQLDate(This.parent.txtDue_min.Value,'Due_Min')
		IF NOT EMPTY(dDue_Min) AND NOT EMPTY(dDate)
			IF dDue_Min > GetLatestDate( dDue_Min, dDate )
				MESSAGEBOX("Your min date("+DTOC(dDue_Min)+") is greater then your max date("+DTOC(dDate)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		PRIVATE dHPA_Due_Min
		dHPA_Due_Min = PrepareSQLDate(This.parent.txtHPA_Due_min.Value,'HPA_Due_Min')
		IF NOT EMPTY(dHPA_Due_Min) AND NOT EMPTY(dDate)
			IF dDate > GetLatestDate( dHPA_Due_Min, dDate )
				MESSAGEBOX("Your max Vendor ship date("+DTOC(dDate)+") is past the expected min receive date("+DTOC(dHPA_Due_Min)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		PRIVATE dHPA_Due_Max
		dHPA_Due_Max = PrepareSQLDate(This.parent.txtHPA_Due_max.Value,'HPA_Due_Max')
		IF NOT EMPTY(dHPA_Due_Max) AND NOT EMPTY(dDate)
			IF dDate > GetLatestDate( dHPA_Due_Max, dDate )
				MESSAGEBOX("Your max Vendor ship date("+DTOC(dDate)+") is past the expected max receive date("+DTOC(dHPA_Due_Max)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		
		
	ENDPROC

