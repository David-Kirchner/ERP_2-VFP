		ENDCASE
		
	ENDPROC

	PROCEDURE ccscreen
		Parameter pAction
		
		DO CASE
		CASE pAction = "ENABLE"
				ThisFormSet.frmCC.txtAddr1.txtHolderName.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.cmbCardtype.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtCardNo1.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtCardNo.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtCardNo4.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtCCV.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtExpireDd.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtExpireMm.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtSale.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtShipIns.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtTotalamt.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtAuthNo.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.txtAuthDate.ENABLED = .T.
		
		CASE pAction = "DISABLE"
				ThisFormSet.frmCC.txtAddr1.txtHolderName.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.cmbCardtype.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtCardNo1.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtCardNo.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtCardNo4.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtCCV.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtExpireDd.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtExpireMm.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtSale.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtShipIns.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtTotalamt.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtAuthNo.ENABLED = .F.
				ThisFormSet.frmCC.txtAddr1.txtAuthDate.ENABLED = .F.
		
		ENDCASE
	ENDPROC

	PROCEDURE check4poitem
		PRIVATE nHpaPo,m.nItemPO,m.cPOItem
		*ThisFormSet.Check4POItem()
		
		*nHpaPo		= ThisForm.pf.pgAdd.pfAdd.pgDesc.txtHPApo.VALUE
		nHpaPo		= ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHpaPo.Value
		*m.nItemPo		= ThisForm.pf.pgAdd.pfAdd.pgDesc.txtItempo.VALUE
		m.nItemPo		= ThisForm.pf.pg_po.pgfPO.pgPODesc.txtItempo.Value
		
		IF TYPE('nHpaPo') = "C"
			nHpaPo = VAL(nHpaPo)
		ENDIF
		IF EMPTY(nHpaPo)
			RETURN .F.
		ENDIF
		
		IF TYPE('m.itemPO') = "C"
			m.nItemPO= VAL(m.itemPO)
		ENDIF
			
		PRIVATE nCntPOitem	
		nCntPOitem = 0
		
		IF nHpaPo > 0 AND m.nItemPO > 0
		
			cPOItem = Proper_PO_item( STR(nHpaPo)+"-"+STR(m.nItemPO,2,0) )
			nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
				
			*SEEK cPOItem IN PurchaseOrder ORDER POItem
			IF nCntPOitem > 0
				*Found PO Item!
			
		*		ThisForm.pf.pgAdd.pfAdd.pgPODesc.Edit1.Value = "Item "+ALLTRIM(STR(nItemPO,2,0))+" allready entered."+CHR(13)+"Found PO :"+m.cPOItem
		*		ThisForm.pf.pgAdd.pfAdd.pgPODesc.Edit1.refresh
				PRIVATE nMessAns
				nMessAns = MESSAGEBOX("PO - Item allready entered"+CHR(13)+;
				"Item number '"+STR(nItemPO,2,0)+"' cannot be used again."+CHR(13)+CHR(13)+;
				"Do you want to edit this item?"+CHR(13)+CHR(13)+;
				"Answer no if you need to change Item.",4+32,"Can not enter twice")
				
				IF nMessAns = 6  &&Edit PO Item
					ThisForm.POEditing = .T.
					
					IF USED('tmpPO')
						USE IN tmpPO
					ENDIF
					
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE POitem = '"+m.cPOItem+"'"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO' )
					ENDIF
					
					IF USED('tmpPO')
						IF NOT EOF('tmpPO')
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHpaPo.Value		= tmpPO.HPAPo
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtItempo.VALUE	= tmpPO.ItemPO
							*ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSalesNum.VALUE	= tmpPO.SalesNum   &&Keep as String , becuase could be STOCK
							*ThisForm.pf.pg_po.pgfPO.pgPODesc.txtitem.VALUE		= tmpPO.item
							
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSalesP.VALUE	= tmpPO.SalesP
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtCompany.VALUE	= tmpPO.Company
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtAlloy.VALUE		= tmpPO.Alloy
							ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbForm.VALUE		= tmpPO.Form
							ThisForm.pf.pg_po.pgFPO.pgPOdesc.lblPerUnit.Caption	= FormUnitCaption(tmpPO.Form,tmpPO.Services,tmpPO.ConvServ,ThisForm.nConnHandle)
							ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbCC.VALUE		= tmpPO.CC
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOrder_Qty.VALUE	= tmpPO.Order_Qty
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtPieces.VALUE	= tmpPO.Pieces
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtThck.VALUE		= tmpPO.Thck
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSz2.VALUE		= tmpPO.Sz2
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtSz3.VALUE		= tmpPO.Sz3
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStockLst_QTY.VALUE	= PrepareSQLnum(tmpPO.StockLst_QTY,'StockLst_QTY',-5)
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStockLst_P.VALUE	= PrepareSQLnum(tmpPO.StockLst_P,'StockLst_P',-5)
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtP_lb.VALUE		= tmpPO.P_lb
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtP_pc.VALUE		= tmpPO.P_pc
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtP_ft.VALUE		= tmpPO.P_ft
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtLotP.VALUE		= tmpPO.LotP
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOtherP.VALUE	= tmpPO.OtherP
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOtherFld.VALUE	= tmpPO.OtherFld
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtOrderDate.VALUE	= tmpPO.OrderDate
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtDue_Min.VALUE	= tmpPO.Due_Min
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtDue_Max.VALUE	= tmpPO.Due_Max
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHPA_Due_Min.VALUE	= tmpPO.HPA_Due_Min
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHPA_Due_Max.VALUE	= tmpPO.HPA_Due_Max
							*Received 
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtCond_Spec.VALUE	= tmpPO.Cond_Spec
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtMisc_purch.VALUE= tmpPO.Misc_purch
							*Heat 
							*Cert 
							*ProcLoc
							*Receipt 
							*Delivered 
							*Cancelled 
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtPOSalesName.VALUE	= tmpPO.POSalesP
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtShipVia.VALUE	= tmpPO.ShipVia
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtJobNumber.VALUE	= tmpPO.JobNumber
							ThisForm.pf.pg_po.pgfPO.pgPODesc.chkServicesPO.VALUE= tmpPO.Services
							ThisForm.pf.pg_po.pgfPO.pgPODesc.chkConvServ.VALUE	= tmpPO.ConvServ
							ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbStock.VALUE		= tmpPO.Stock
							ThisForm.pf.pg_po.pgfPO.pgPODesc.chkSPS1.VALUE		= tmpPO.Sheet_PK
							ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.VALUE	= tmpPO.ShipWhere
							ThisForm.pf.pg_po.pgfPO.pgPOAddress.opgPOShipTo.Value 	= tmpPO.ShipWhere
							ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.Value = tmpPO.POShipAddr
							ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmbRemoteStock.Value = IIF(EMPTY(tmpPO.ShipLocation),'*',tmpPO.ShipLocation)
							ThisForm.ShipWhereChange(tmpPO.ShipWhere)  &&must call After getting POShipAddr
							
							ThisForm.POShipAddr = tmpPO.POShipAddr
							ThisForm.VendCode	= tmpPO.VendCode
							ThisForm.ShowPOShipAddr(tmpPO.POShipAddr)
							ThisForm.ShowVendCode(tmpPO.VendCode)  &&must call After getting VendCode
							ThisForm.nContactID = tmpPO.ContactID
									
							ThisForm.pf.pg_po.pgfPO.pgPODesc.chkRandLen.VALUE		= tmpPO.RandLen
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtDispAlloy.VALUE		= PrepareSQLtxt(tmpPO.DispAlloy,'DispAlloy',20,.f.)
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStandSize.VALUE		= tmpPO.StandSize
							ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtReceipt.Value 	= PrepareSQLtxt(tmpPO.Receipt,'Reciept',-1,.F.)			
							ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtTerms.Value 		= PrepareSQLtxt(tmpPO.Terms,'Terms',50,.F.)
							ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtFOB.Value 		= PrepareSQLtxt(tmpPO.FOB,'FOB',50,.F.)
							
							ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Value 		= PrepareSQLtxt(tmpPO.Sz1Orig,'Sz1Orig',20,.F.)
							ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Value 		= PrepareSQLtxt(tmpPO.Sz2Orig,'Sz2Orig',20,.F.)
							ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Value 		= PrepareSQLtxt(tmpPO.Sz3Orig,'Sz3Orig',20,.F.)
							
							
		*					ThisForm.pf.pg_po.pgfPO.pgPODesc.cmdPOAdd.Caption	= "Save"
		*					ThisForm.pf.pg_po.pgfPO.pgPODesc.cmdClone.Caption = "Just make a Clone"
		*					ThisForm.pf.pg_po.pgfPO.pgPODesc.cmdClone.Enabled = .T.
							
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHpapo.Enabled = .F.
							ThisForm.pf.pg_po.pgfPO.pgPODesc.txtItempo.Enabled = .F.
							
							ThisForm.pf.pg_po.pgfPO.pgPODesc.refresh
							
						ENDIF
						USE IN tmpPO
					ENDIF	
				ELSE
					*Do not Edit Found PO item
					
					*Get Next Available PO number
					IF USED('cntPOitemMax')
						USE IN cntPOitemMax
					ENDIF
					
					SELECT 0
					cSQL = "SELECT MAX(ItemPO) AS MaxItemPO FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE HpaPO = "+STR(nHpaPo)+""
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPOitemMax')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPOitemMax' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPOitemMax' )
					ENDIF
					
					IF USED('cntPOitemMax')
						m.itemPO = cntPOitemMax.MaxItemPO + 1 
						ThisForm.pf.pg_po.pgfPO.pgPODesc.txtItempo.Value = m.itemPO
						ThisForm.pf.pg_po.pgfPO.pgPODesc.txtItempo.Refresh
						ThisForm.pf.pg_po.pgfPO.pgPODesc.Refresh
		
						USE IN cntPOitemMax
					ENDIF
				ENDIF
			ELSE
				**Not found!
				*Check to see if it could be the next PO number to use
				
				*Get Next Available PO number
				PRIVATE nNextPO 
				nNextPO = GetNextPurchaseOrder ( ThisForm.nConnHandle )
				
				IF nHpaPo + 10 < nNextPO 
					ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHpaPo.Value = nNextPO 
					MESSAGEBOX("Purchase Order number too large:"+ALLTRIM(STR(nHpaPo))+CHR(13)+"A valid Purchase Order number has been inserted:"+ALLTRIM(STR(nNextPO))+CHR(13)+CHR(13)+"If you where trying to edit an exisiting PO, try again."+CHR(13)+"The number used was not found!",48,"Error with Purchase Order number!")
					RETURN .T.
				ELSE
					RETURN .T.
				ENDIF
			ENDIF
		ELSE &&IF nHpaPo > 0 AND nItemPO > 0
			** need number first!
			RETURN .T. 
		ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE checkcc
		PARAMETER pAction
		
		IF TYPE("pAction") != "C"
			pAction = ""
		ENDIF
		
		PRIVATE nFirst, cMiddle , nLast, nMiddle1, nMiddle2
		PRIVATE lcCardType
		
		nFirst		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCardno1.Value,'CardNo1',4,0)
		cMiddle 	= ThisFormSet.frmCC.txtAddr1.txtCardno.Value
		nMiddle1 	= PrepareSQLnum(LEFT(cMiddle,4),'CardNo2',4,0)
		nMiddle2 	= PrepareSQLnum(RIGHT(cMiddle,4),'CardNo3',4,0)
		nLast		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCardno4.Value,'CardNo4',4,0)
		lcCardType 	= ThisFormSet.frmCC.txtAddr1.cmbCardType.Value
		
		
		DO CASE
		CASE pAction = "FIRST"
			IF nFirst < 0 OR nFirst > 9999
				MESSAGEBOX("This must be 4 Digits long",0,"Wrong number of Digits!")
		*		RETURN .F.
			ENDIF
		CASE pAction = "MIDDLE"
			IF nMiddle1 + nMiddle2 < 0 OR nMiddle1+nMiddle2 > 99999999
				MESSAGEBOX("This must be 8 Digits long",0,"Wrong number of Digits!")
		*		RETURN .F.
			ENDIF
		CASE pAction = "LAST"
			IF lcCardType = "AMEX"
				IF nLast <  0 OR nLast > 999
					MESSAGEBOX("This must be 3 Digits long",0,"Wrong number of Digits!")
		*			RETURN .F.
				ENDIF
			ELSE
				IF nLast < 0 OR  nLast > 9999
					MESSAGEBOX("This must be 4 Digits long",0,"Wrong number of Digits!")
		*			RETURN .F.
				ENDIF
			ENDIF
		OTHERWISE
		
		ENDCASE
		
		RETURN .T.
	ENDPROC

	PROCEDURE checkdata4save
		*ThisForm.CheckData4Save()
		
		PRIVATE cTol,lCG,llShipOn,dShipDue
		PRIVATE lReturn
		lReturn = .T.
		
		SELECT SalesQuote
		
		PRIVATE nRecNum
		nRecNum = RECNO('SalesQuote')
		
		SCAN
			lCG	 = PrepareSQLchk(SalesQuote.CG,'CG')
			cTol = PrepareSQLtxt(SalesQuote.Tol,'Tolerence',20)
			IF lCG AND EMPTY(cTol)
				MESSAGEBOX("Please enter a CG Tolerence on SO-Item:"+ALLTRIM(SalesQuote.SoItem_a)+"!",0+64,"Found CG job with no Tolerence.")
				lReturn = .F.
			ENDIF
			llShipOn = PrepareSQLchk( ThisForm.pf.pgQuote.chkShipOn.Value,'ShipOn',.F.)
			dShipDue = PrepareSQLdate(SalesQuote.ShipDue,'Ship Due',.T.)
			IF EMPTY(dShipDue)
				MESSAGEBOX("Please use a Ship Due Date.",0+48,"ShipDue is Empty")
				ThisForm.pf.pgQuote.txtShipdue.Value = DATE()+7
				lReturn = .F.
			ENDIF
			IF VARTYPE(dShipDue) != "D" AND VARTYPE(dShipDue) != "T"
				dShipDue = CTOD("  /  /    ")
			ENDIF
			IF dShipDue < DATE()-30
				MESSAGEBOX("The ShipDue date is allready over 30 days Late")
				IF dShipDue < DATE()-356
					MESSAGEBOX("Resetting ShipDue to 1 year ago.",0+16,"Please check your dates!")
					dShipDue = DATE()-356
					ThisForm.pf.pgQuote.txtShipdue.Value = dShipDue 
					lReturn = .F.
				ENDIF
			ELSE
				IF dShipDue > DATE()+365
					MESSAGEBOX("The ShipDue date over 1 year from now!")
					IF dShipDue > DATE()+730
						dShipDue = DATE()+365
						MESSAGEBOX("Resetting ShipDue to 1 year from now.",0+16,"Please check your dates!")
						ThisForm.pf.pgQuote.txtShipdue.Value = dShipDue 
						lReturn = .F.
					ENDIF
				ENDIF
			ENDIF	
		ENDSCAN
		
		SELECT SalesQuote
		IF nRecNum > 0 AND nRecNum <= RECCOUNT('SalesQuote')
			GOTO (nRecNum)
		ENDIF
		
		RETURN lReturn 
			
	ENDPROC

	PROCEDURE checkvendcode
		*ThisForm.CheckVendCode()
		**Check SO item for using a PO for Conversion Services
		
		*ThisForm.VendCode = nVendCode 
		PRIVATE lReturn
		lReturn = .T.
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT SalesQuote
		PRIVATE nSQrecnum
		nSQrecnum = RECNO('SalesQuote')
		
		
		PRIVATE cSOitem, nItem
		DECLARE aSOitems[1,2]
		nItem = 0
		
		SELECT 0
		
		SELECT SoItem_A, ConverPO FROM SalesQuote INTO ARRAY aSOitems WHERE LEN(Proper_SO_Item(SalesQuote.SoItem_A))>1
		
		
		IF USED('tmpIsConversion')
			USE IN tmpIsConversion
		ENDIF
		PRIVATE cSQL, nSQLEXEC
			
		PRIVATE nItemI, nConverPO,nHPApo, cPOitem, cCompany 
		FOR nItemI = 1 TO ALEN(aSOitems,1)
			*Check SO item for using a PO for Conversion Services
			*SELECT VendCode from dbo.PurchaseOrder PO,  WHERE PO.SOitem = aSOitems( nItemI )
			cSQL = "SELECT dbo.f_Is_IND_Type( V.VendCode, 2048 ) AS IsIND "
			cSQL = cSQL + ",PO.HPApo, PO.POitem, PO.Company "
			cSQL = cSQL + " FROM dbo.PurchaseOrder PO"
			cSQL = cSQL + " INNER JOIN Vendor AS V ON V.VendCode = PO.VendCode"
			cSQL = cSQL + " WHERE PO.SOitem = '"+aSOitems( nItemI, 1 )+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpIsConversion')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpIsConversion' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpIsConversion' )
			ENDIF
		
			IF USED('tmpIsConversion')
				IF VARTYPE(tmpIsConversion.IsIND) ="N" 
					IF tmpIsConversion.IsIND = 1
						nConverPO = aSOitems( nItemI, 2 )
						IF VARTYPE(ConverPO ) = 'N'
							IF EMPTY(ConverPO)
								*Must mark as Conversion
								
								nHPApo	= tmpIsConversion.HPApo
								cPOitem	= tmpIsConversion.POitem
								cCompany = tmpIsConversion.Company
								MESSAGEBOX("PO:"+ALLTRIM(STR(nHPApo))+" to Company:"+ALLTRIM(cCompany)+CHR(13)+"is a Conversion company!",0+48,"Please fill in Converter information.")
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				USE IN tmpIsConversion
			ENDIF
		
		NEXT nItemI
		
		*!*	PRIVATE nConverPO,cConverter,cConversion
		*!*		nConverPO = PrepareSQLnum(SalesQuote.ConverPO,'Convert PO',9,0)
		*!*		cConverter = PrepareSQLtxt(SalesQuote.Converter,'Converter',15,.F.)
		*!*		cConversion = PrepareSQLtxt(SalesQuote.Conversion,'Conversion',40,.F.)
		
		
		
		*Move SalesQuote back to orig record
		SELECT SalesQuote
		IF nSQrecnum > 0
			GOTO nSQrecnum 
		ELSE
			GO TOP
		ENDIF
		
		
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lReturn
	ENDPROC

	PROCEDURE creditcard
		PARAMETERS pAction
		*ThisForm.CreditCard()
		
		PRIVATE nDecimal
		nDecimal = SET("DECIMAL")
		
		LOCAL nCCSO
		nCCSO = ThisFormSet.frmCC.txtAddr1.txtSalesnum.VALUE
		IF TYPE("nCCSO") <> "N"
			SET DECIMAL TO 0
			nCCSO = VAL(nCCSO)
			SET DECIMAL TO nDecimal
		ENDIF
		IF EMPTY(nCCSO)
			nCCSO = SalesQuote.salesnum_A
		ENDIF
		
		DO CASE
		CASE pAction = "EDIT"
		CASE pAction = "NEW"
		*New Initialize
			ThisFormSet.frmCC.txtAddr1.txtSalesnum.VALUE = THISFORM.Salesnum
		
			IF THISFORM.SoldAddr > 0
				ThisFormSet.frmCC.txtAddr1.txtSoldcode.VALUE = THISFORM.SoldAddr
				ThisFormSet.frmCC.txtAddr1.txtCompany.VALUE	= THISFORM.pf.pgBillTo.txtCompany.VALUE
				ThisFormSet.frmCC.txtAddr1.txtAddr1.VALUE		= THISFORM.pf.pgBillTo.txtAddr1.VALUE
				ThisFormSet.frmCC.txtAddr1.txtAddr2.VALUE		= THISFORM.pf.pgBillTo.txtAddr2.VALUE
				ThisFormSet.frmCC.txtAddr1.txtCity.VALUE		= THISFORM.pf.pgBillTo.txtCity.VALUE
				ThisFormSet.frmCC.txtAddr1.txtST.VALUE		= THISFORM.pf.pgBillTo.txtST.VALUE
				ThisFormSet.frmCC.txtAddr1.txtZip.VALUE		= THISFORM.pf.pgBillTo.txtZip.VALUE
				ThisFormSet.frmCC.txtAddr1.txtCountry.VALUE	= THISFORM.pf.pgBillTo.txtCountry.VALUE
				ThisFormSet.frmCC.txtAddr1.txtContact.VALUE	= THISFORM.pf.pgBillTo.txtContact.VALUE
				ThisFormSet.frmCC.txtAddr1.txtPhone.VALUE		= THISFORM.pf.pgBillTo.txtPhone.VALUE
				ThisFormSet.frmCC.txtAddr1.txtFax.VALUE		= THISFORM.pf.pgBillTo.txtFax.VALUE
				ThisFormSet.frmCC.txtAddr1.txtEmail.VALUE		= THISFORM.pf.pgBillTo.txtEmail.VALUE
				ThisFormSet.frmCC.txtAddr1.txtLastEdit.VALUE	= THISFORM.pf.pgBillTo.txtLastEdit.VALUE
		
		
			ELSE
				ThisFormSet.frmCC.txtAddr1.txtSoldcode.VALUE = 0
			ENDIF
			IF TYPE("ThisForm.pf.pgValue.nSale.Value") = "N"
				ThisFormSet.frmCC.txtAddr1.txtSale.VALUE = NTOM(THISFORM.pf.pgValue.nSale.VALUE)
			ENDIF
		
		CASE pAction = "SAVE"
		
			LOCAL lccHolderName, lccCardType, lccCardNo1, lccCardNo4, lccCCV, lccExpireDd, lccExpireMm, lccExpireYyyy
			LOCAL lccSoldCode, lccSale, lccShipIns, lccTotalamt, lccAuthNo, lccAuthDate
		
			lccHolderName	= PrepareSQLtxt(ThisFormSet.frmCC.txtAddr1.txtHolderName.VALUE,'HolderName',50,.F.)
			lccCardType		= ThisFormSet.frmCC.txtAddr1.cmbCardtype.VALUE
			lccCardNo1		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCardNo1.VALUE,'CardNo1',4,0)
			lccCardNo4		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCardNo4.VALUE,'CardNo4',4,0)
			lccCCV			= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCCV.VALUE,'CCV',3,0)
			lccExpireDd		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtExpireDd.VALUE,'ExpireDD',2,0)
			lccExpireMm		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtExpireMm.VALUE,'ExpireMM',2,0)
			lccExpireYyyy	= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.VALUE,'ExpireYYYY',4,0)
			lccSoldCode		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtSoldcode.VALUE,'SoldCode',10,0)
			lccSale			= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtSale.VALUE,'Sale',-5)
			lccShipIns		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtShipIns.VALUE,'ShipIns',-5)
			lccTotalamt		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtTotalamt.VALUE,'TotalAmt',-5)
			lccAuthNo		= PrepareSQLtxt(ThisFormSet.frmCC.txtAddr1.txtAuthNo.VALUE,'AuthNo',20,.F.)
			lccAuthDate		= PrepareSQLdate(ThisFormSet.frmCC.txtAddr1.txtAuthdate.VALUE,'AuthDate')
		
			PRIVATE lFoundSOCC
			lFoundSOCC = FoundCCforSO(nCCSO,ThisForm.nConnHandle)
		
			IF lFoundSOCC 
				*UPDATE
				PRIVATE cSQL, nSQLEXEC
				cSQL = "UPDATE dbo.CreditCd SET "
				cSQL = cSQL + "	HolderName='"+lccHolderName+"'"
				cSQL = cSQL + ",CardType = '"+lccCardType+"'"
				cSQL = cSQL + ",CardNo1 = "+STR(lccCardNo1,4,0)
				cSQL = cSQL + ",CardNo4 = "+STR(lccCardNo4,4,0)
				cSQL = cSQL + ",CCV = "+STR(lccCCV,3,0)
				cSQL = cSQL + ",ExpireDd = "+IIF(lccExpireDd=0,'Null',STR(lccExpireDd,2,0))+""
				cSQL = cSQL + ",ExpireMM = "+IIF(lccExpireMm=0,'Null',STR(lccExpireMm,2,0))+""
				cSQL = cSQL + ",ExpireYYYY = "+IIF(lccExpireYyyy=0,'Null',STR(lccExpireYyyy,4,0))+""
				cSQL = cSQL + ",SoldCode = "+STR(lccSoldCode,10,0)
				cSQL = cSQL + ",Sale = "+STR(lccSale,10,4)
				cSQL = cSQL + ",ShipIns = "+STR(lccShipIns,10,4)
				cSQL = cSQL + ",Totalamt = "+STR(lccTotalamt,10,4)
				cSQL = cSQL + ",AuthNo = '"+lccAuthNo+"'"
				cSQL = cSQL + ",AUTHDate = '"+IIF(EMPTY(lccAuthDate),'',DTOC(lccAuthDate))+"'"
				cSQL = cSQL + "	WHERE SalesNum = "+STR(nSalesNum)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
		
			ELSE
				*ADD
				PRIVATE cSQL, nSQLEXEC
				cSQL = "INSERT INTO dbo.CreditCd ("
				cSQL = cSQL + "Salesnum, HolderName, CardType, CardNo1, CardNo4, CCV, ExpireDD, ExpireMM, ExpireYYYY,"
				cSQL = cSQL + "SoldCode, Sale, ShipIns, Totalamt, AuthNo, AUTHDate) "
				cSQL = cSQL + "VALUES ("
				cSQL = cSQL + STR(nCCSO,10,0)
				cSQL = cSQL + ",'"+lccHolderName+"'"
				cSQL = cSQL + ",'"+lccCardType+"'"
				cSQL = cSQL + ","+STR(lccCardNo1,4,0)+""
				cSQL = cSQL + ","+STR(lccCardNo4,4,0)+""
				cSQL = cSQL + ","+STR(lccCCV,4,0)+""
				cSQL = cSQL + ","+IIF(lccExpireDd=0,'Null',STR(lccExpireDd,2,0))+""
				cSQL = cSQL + ","+IIF(lccExpireMm=0,'Null',STR(lccExpireMm,2,0))+""
				cSQL = cSQL + ","+IIF(lccExpireYyyy=0,'Null',STR(lccExpireYyyy,4,0))+""
				cSQL = cSQL + ","+STR(lccSoldCode,10,0)+""
				cSQL = cSQL + ","+STR(lccSale,10,4)+""
				cSQL = cSQL + ","+STR(lccShipIns,10,4)+""
				cSQL = cSQL + ","+STR(lccTotalamt,10,4)+""
				cSQL = cSQL + ",'"+lccAuthNo+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(lccAuthDate),'',DTOC(lccAuthDate))+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
			ENDIF
		
		
		*CASE pAction = "CANCEL"
		*	ThisFormSet.frmCC.txtAddr1.txtSalesnum.Value	= 0
		
		CASE pAction = "INIT"
		
			PRIVATE lFoundSOCC
			lFoundSOCC = FoundCCforSO(nCCSO,ThisForm.nConnHandle)
			IF lFoundSOCC 
			
				cSQL = "SELECT * FROM dbo.CreditCd "
				cSQL = cSQL +" WHERE Salesnum = "+STR(SalesQuote.salesnum_A)
		
				IF USED('tmpCCSO')
					USE IN tmpCCSO
				ENDIF
				
				SELECT 0
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpCCSO' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCCSO' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC,'tmpCCSO' )
				ENDIF
				
				IF USED('tmpCCSO')
					m.ccSalesNum	= tmpCCSO.SalesNum
					m.ccHolderName	= tmpCCSO.HolderName
					m.ccCardType	= tmpCCSO.CardType
					m.ccCardNo1		= tmpCCSO.CardNo1
					m.ccCardNo4		= tmpCCSO.CardNo4
					m.ccCCV			= tmpCCSO.CCV
					m.ccExpireDD	= tmpCCSO.ExpireDD
					m.ccExpireMD	= tmpCCSO.ExpireMM
					m.ccExpireYYYY	= tmpCCSO.ExpireYYYY
					m.ccSoldCode	= tmpCCSO.SoldCode
					THISFORM.ccSoldAddr = tmpCCSO.SoldCode
					m.ccSale		= tmpCCSO.Sale
					m.ccShipIns		= tmpCCSO.ShipIns
					m.ccTotalamt	= tmpCCSO.Totalamt
					m.ccAuthNo		= tmpCCSO.AuthNo
					m.ccAuthDate	= tmpCCSO.AUTHDate
		
					ThisFormSet.frmCC.txtAddr1.txtHolderName.REFRESH
					ThisFormSet.frmCC.txtAddr1.cmbCardtype.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtSalesnum.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtCardNo1.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtCardNo4.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtCCV.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtExpireDd.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtExpireMm.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtSoldcode.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtSale.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtShipIns.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtTotalamt.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtAuthNo.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtAuthdate.REFRESH
					
					USE IN tmpCCSO
				ENDIF
				
				IF NOT EMPTY(m.ccSoldCode)
					THISFORM.CCAddress("SHOW")
				ENDIF
				ThisFormSet.frmCC.txtAddr1.cmdCCPrint.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.cmdCCEdit.CAPTION = "Edit"
			ELSE
				pAction = "CLEAN"
			ENDIF
		
		ENDCASE
		
		
		IF pAction = "CLEAN"
			THISFORM.ccSoldAddr = 0
			ThisFormSet.frmCC.txtAddr1.txtSalesnum.VALUE	= 0
			ThisFormSet.frmCC.txtAddr1.txtHolderName.VALUE= ""
			ThisFormSet.frmCC.txtAddr1.cmbCardtype.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCardNo1.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCardNo.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCardNo4.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCCV.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtExpireDd.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtExpireMm.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.VALUE	= ""
		
			ThisFormSet.frmCC.txtAddr1.txtSale.VALUE		= NTOM(0)
			ThisFormSet.frmCC.txtAddr1.txtShipIns.VALUE	= NTOM(0)
			ThisFormSet.frmCC.txtAddr1.txtTotalamt.VALUE	= NTOM(0)
		
			ThisFormSet.frmCC.txtAddr1.txtAuthNo.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtAuthdate.VALUE	= CTOD("  /  /  ")
		
			ThisFormSet.frmCC.txtAddr1.txtCompany.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtAddr1.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtAddr2.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtCity.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtST.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtZip.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtCountry.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtContact.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtPhone.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtFax.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtEmail.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtLastEdit.VALUE	= CTOD("  /  /  ")
		
			ThisFormSet.frmCC.txtAddr1.cmdCCEdit.CAPTION = "Add New"
		ENDIF
		
	ENDPROC

	PROCEDURE deletecontactid
		PARAMETERS pAction
		*ThisForm.CreditCard()
		
		PRIVATE nDecimal
		nDecimal = SET("DECIMAL")
		
		LOCAL nCCSO
		nCCSO = ThisFormSet.frmCC.txtAddr1.txtSalesnum.VALUE
		IF TYPE("nCCSO") <> "N"
			SET DECIMAL TO 0
			nCCSO = VAL(nCCSO)
			SET DECIMAL TO nDecimal
		ENDIF
		IF EMPTY(nCCSO)
			nCCSO = SalesQuote.salesnum_A
		ENDIF
		
		DO CASE
		CASE pAction = "EDIT"
		CASE pAction = "NEW"
		*New Initialize
			ThisFormSet.frmCC.txtAddr1.txtSalesnum.VALUE = THISFORM.Salesnum
		
			IF THISFORM.SoldAddr > 0
				ThisFormSet.frmCC.txtAddr1.txtSoldcode.VALUE = THISFORM.SoldAddr
				ThisFormSet.frmCC.txtAddr1.txtCompany.VALUE	= THISFORM.pf.pgBillTo.txtCompany.VALUE
				ThisFormSet.frmCC.txtAddr1.txtAddr1.VALUE		= THISFORM.pf.pgBillTo.txtAddr1.VALUE
				ThisFormSet.frmCC.txtAddr1.txtAddr2.VALUE		= THISFORM.pf.pgBillTo.txtAddr2.VALUE
				ThisFormSet.frmCC.txtAddr1.txtCity.VALUE		= THISFORM.pf.pgBillTo.txtCity.VALUE
				ThisFormSet.frmCC.txtAddr1.txtST.VALUE		= THISFORM.pf.pgBillTo.txtST.VALUE
				ThisFormSet.frmCC.txtAddr1.txtZip.VALUE		= THISFORM.pf.pgBillTo.txtZip.VALUE
				ThisFormSet.frmCC.txtAddr1.txtCountry.VALUE	= THISFORM.pf.pgBillTo.txtCountry.VALUE
				ThisFormSet.frmCC.txtAddr1.txtContact.VALUE	= THISFORM.pf.pgBillTo.txtContact.VALUE
				ThisFormSet.frmCC.txtAddr1.txtPhone.VALUE		= THISFORM.pf.pgBillTo.txtPhone.VALUE
				ThisFormSet.frmCC.txtAddr1.txtFax.VALUE		= THISFORM.pf.pgBillTo.txtFax.VALUE
				ThisFormSet.frmCC.txtAddr1.txtEmail.VALUE		= THISFORM.pf.pgBillTo.txtEmail.VALUE
				ThisFormSet.frmCC.txtAddr1.txtLastEdit.VALUE	= THISFORM.pf.pgBillTo.txtLastEdit.VALUE
		
		
			ELSE
				ThisFormSet.frmCC.txtAddr1.txtSoldcode.VALUE = 0
			ENDIF
			IF TYPE("ThisForm.pf.pgValue.nSale.Value") = "N"
				ThisFormSet.frmCC.txtAddr1.txtSale.VALUE = NTOM(THISFORM.pf.pgValue.nSale.VALUE)
			ENDIF
		
		CASE pAction = "SAVE"
		
			LOCAL lccHolderName, lccCardType, lccCardNo1, lccCardNo4, lccCCV, lccExpireDd, lccExpireMm, lccExpireYyyy
			LOCAL lccSoldCode, lccSale, lccShipIns, lccTotalamt, lccAuthNo, lccAuthDate
		
			lccHolderName	= PrepareSQLtxt(ThisFormSet.frmCC.txtAddr1.txtHolderName.VALUE,'HolderName',50,.F.)
			lccCardType		= ThisFormSet.frmCC.txtAddr1.cmbCardtype.VALUE
			lccCardNo1		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCardNo1.VALUE,'CardNo1',4,0)
			lccCardNo4		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCardNo4.VALUE,'CardNo4',4,0)
			lccCCV			= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtCCV.VALUE,'CCV',3,0)
			lccExpireDd		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtExpireDd.VALUE,'ExpireDD',2,0)
			lccExpireMm		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtExpireMm.VALUE,'ExpireMM',2,0)
			lccExpireYyyy	= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.VALUE,'ExpireYYYY',4,0)
			lccSoldCode		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtSoldcode.VALUE,'SoldCode',10,0)
			lccSale			= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtSale.VALUE,'Sale',-5)
			lccShipIns		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtShipIns.VALUE,'ShipIns',-5)
			lccTotalamt		= PrepareSQLnum(ThisFormSet.frmCC.txtAddr1.txtTotalamt.VALUE,'TotalAmt',-5)
			lccAuthNo		= PrepareSQLtxt(ThisFormSet.frmCC.txtAddr1.txtAuthNo.VALUE,'AuthNo',20,.F.)
			lccAuthDate		= PrepareSQLdate(ThisFormSet.frmCC.txtAddr1.txtAuthdate.VALUE,'AuthDate')
		
			PRIVATE lFoundSOCC
			lFoundSOCC = FoundCCforSO(nCCSO,ThisForm.nConnHandle)
		
			IF lFoundSOCC 
				*UPDATE
				PRIVATE cSQL, nSQLEXEC
				cSQL = "UPDATE dbo.CreditCd SET "
				cSQL = cSQL + "	HolderName='"+lccHolderName+"'"
				cSQL = cSQL + ",CardType = '"+lccCardType+"'"
				cSQL = cSQL + ",CardNo1 = "+STR(lccCardNo1,4,0)
				cSQL = cSQL + ",CardNo4 = "+STR(lccCardNo4,4,0)
				cSQL = cSQL + ",CCV = "+STR(lccCCV,3,0)
				cSQL = cSQL + ",ExpireDd = "+IIF(lccExpireDd=0,'Null',STR(lccExpireDd,2,0))+""
				cSQL = cSQL + ",ExpireMM = "+IIF(lccExpireMm=0,'Null',STR(lccExpireMm,2,0))+""
				cSQL = cSQL + ",ExpireYYYY = "+IIF(lccExpireYyyy=0,'Null',STR(lccExpireYyyy,4,0))+""
				cSQL = cSQL + ",SoldCode = "+STR(lccSoldCode,10,0)
				cSQL = cSQL + ",Sale = "+STR(lccSale,10,4)
				cSQL = cSQL + ",ShipIns = "+STR(lccShipIns,10,4)
				cSQL = cSQL + ",Totalamt = "+STR(lccTotalamt,10,4)
				cSQL = cSQL + ",AuthNo = '"+lccAuthNo+"'"
				cSQL = cSQL + ",AUTHDate = '"+IIF(EMPTY(lccAuthDate),'',DTOC(lccAuthDate))+"'"
				cSQL = cSQL + "	WHERE SalesNum = "+STR(nSalesNum)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
		
			ELSE
				*ADD
				PRIVATE cSQL, nSQLEXEC
				cSQL = "INSERT INTO dbo.CreditCd ("
				cSQL = cSQL + "Salesnum, HolderName, CardType, CardNo1, CardNo4, CCV, ExpireDD, ExpireMM, ExpireYYYY,"
				cSQL = cSQL + "SoldCode, Sale, ShipIns, Totalamt, AuthNo, AUTHDate) "
				cSQL = cSQL + "VALUES ("
				cSQL = cSQL + STR(nCCSO,10,0)
				cSQL = cSQL + ",'"+lccHolderName+"'"
				cSQL = cSQL + ",'"+lccCardType+"'"
				cSQL = cSQL + ","+STR(lccCardNo1,4,0)+""
				cSQL = cSQL + ","+STR(lccCardNo4,4,0)+""
				cSQL = cSQL + ","+STR(lccCCV,4,0)+""
				cSQL = cSQL + ","+IIF(lccExpireDd=0,'Null',STR(lccExpireDd,2,0))+""
				cSQL = cSQL + ","+IIF(lccExpireMm=0,'Null',STR(lccExpireMm,2,0))+""
				cSQL = cSQL + ","+IIF(lccExpireYyyy=0,'Null',STR(lccExpireYyyy,4,0))+""
				cSQL = cSQL + ","+STR(lccSoldCode,10,0)+""
				cSQL = cSQL + ","+STR(lccSale,10,4)+""
				cSQL = cSQL + ","+STR(lccShipIns,10,4)+""
				cSQL = cSQL + ","+STR(lccTotalamt,10,4)+""
				cSQL = cSQL + ",'"+lccAuthNo+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(lccAuthDate),'',DTOC(lccAuthDate))+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
			ENDIF
		
		
		*CASE pAction = "CANCEL"
		*	ThisFormSet.frmCC.txtAddr1.txtSalesnum.Value	= 0
		
		CASE pAction = "INIT"
		
			PRIVATE lFoundSOCC
			lFoundSOCC = FoundCCforSO(nCCSO,ThisForm.nConnHandle)
			IF lFoundSOCC 
			
				cSQL = "SELECT * FROM dbo.CreditCd "
				cSQL = cSQL +" WHERE Salesnum = "+STR(SalesQuote.salesnum_A)
		
				IF USED('tmpCCSO')
					USE IN tmpCCSO
				ENDIF
				
				SELECT 0
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpCCSO' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCCSO' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC,'tmpCCSO' )
				ENDIF
				
				IF USED('tmpCCSO')
					m.ccSalesNum	= tmpCCSO.SalesNum
					m.ccHolderName	= tmpCCSO.HolderName
					m.ccCardType	= tmpCCSO.CardType
					m.ccCardNo1		= tmpCCSO.CardNo1
					m.ccCardNo4		= tmpCCSO.CardNo4
					m.ccCCV			= tmpCCSO.CCV
					m.ccExpireDD	= tmpCCSO.ExpireDD
					m.ccExpireMD	= tmpCCSO.ExpireMM
					m.ccExpireYYYY	= tmpCCSO.ExpireYYYY
					m.ccSoldCode	= tmpCCSO.SoldCode
					THISFORM.ccSoldAddr = tmpCCSO.SoldCode
					m.ccSale		= tmpCCSO.Sale
					m.ccShipIns		= tmpCCSO.ShipIns
					m.ccTotalamt	= tmpCCSO.Totalamt
					m.ccAuthNo		= tmpCCSO.AuthNo
					m.ccAuthDate	= tmpCCSO.AUTHDate
		
					ThisFormSet.frmCC.txtAddr1.txtHolderName.REFRESH
					ThisFormSet.frmCC.txtAddr1.cmbCardtype.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtSalesnum.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtCardNo1.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtCardNo4.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtCCV.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtExpireDd.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtExpireMm.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtSoldcode.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtSale.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtShipIns.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtTotalamt.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtAuthNo.REFRESH
					ThisFormSet.frmCC.txtAddr1.txtAuthdate.REFRESH
					
					USE IN tmpCCSO
				ENDIF
				
				IF NOT EMPTY(m.ccSoldCode)
					THISFORM.CCAddress("SHOW")
				ENDIF
				ThisFormSet.frmCC.txtAddr1.cmdCCPrint.ENABLED = .T.
				ThisFormSet.frmCC.txtAddr1.cmdCCEdit.CAPTION = "Edit"
			ELSE
				pAction = "CLEAN"
			ENDIF
		
		ENDCASE
		
		
		IF pAction = "CLEAN"
			THISFORM.ccSoldAddr = 0
			ThisFormSet.frmCC.txtAddr1.txtSalesnum.VALUE	= 0
			ThisFormSet.frmCC.txtAddr1.txtHolderName.VALUE= ""
			ThisFormSet.frmCC.txtAddr1.cmbCardtype.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCardNo1.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCardNo.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCardNo4.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtCCV.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtExpireDd.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtExpireMm.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtExpireYyyy.VALUE	= ""
		
			ThisFormSet.frmCC.txtAddr1.txtSale.VALUE		= NTOM(0)
			ThisFormSet.frmCC.txtAddr1.txtShipIns.VALUE	= NTOM(0)
			ThisFormSet.frmCC.txtAddr1.txtTotalamt.VALUE	= NTOM(0)
		
			ThisFormSet.frmCC.txtAddr1.txtAuthNo.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtAuthdate.VALUE	= CTOD("  /  /  ")
		
			ThisFormSet.frmCC.txtAddr1.txtCompany.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtAddr1.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtAddr2.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtCity.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtST.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtZip.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtCountry.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtContact.VALUE	= ""
			ThisFormSet.frmCC.txtAddr1.txtPhone.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtFax.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtEmail.VALUE		= ""
			ThisFormSet.frmCC.txtAddr1.txtLastEdit.VALUE	= CTOD("  /  /  ")
		
			ThisFormSet.frmCC.txtAddr1.cmdCCEdit.CAPTION = "Add New"
		ENDIF
		
	ENDPROC

	PROCEDURE didsoitem_usestock
		*ThisForm.didSOitem_UseStock()
		
		IF USED('tmpUseINV')
			USE IN tmpUseINV
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS Cntd "
		cSQL = cSQL + " FROM dbo.StockLst_Process "
		cSQL = cSQL + " WHERE SOitem = '"+SalesQuote.SOitem_A+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUseINV')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUseINV')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpUseINV')
		ENDIF
		
		IF USED('tmpUseINV')
			IF tmpUseINV.Cntd > 0
				*Found a Inventory selected process!
				SELECT SalesQuote
				REPLACE SalesQuote.INV WITH .T.
				
			ENDIF
			USE IN tmpUseINV
		ENDIF
		
		ThisForm.pf.pgOrder.chkInv.Refresh
	ENDPROC

	PROCEDURE editcontactscreen
		PARAMETERS nShow
		*ThisForm.EditContactScreen( 1 )
		* 
		
		PRIVATE lShowEdit
		lShowEdit = .F.
		
		IF VARTYPE(nShow) = 'N'
			IF nShow = 0
				lShowEdit = .F.
			ENDIF
			IF nShow = 1
				lShowEdit = .T.
			ENDIF
		ENDIF
		
		IF lShowEdit
		*	ThisForm.Editing = .T.
				
			ThisForm.Address_Screen('ContactToSave')
			
			WITH ThisForm.pf.pg_po.pgfPO.pgVendorContact
				.cContact.ReadOnly = .F.
				.cPhone.ReadOnly = .F.
				.cCellPhone.ReadOnly = .F.
				.cFax.ReadOnly = .F.
				.cEmail.ReadOnly = .F.
				.cAddr1.ReadOnly = .F.
				.cAddr2.ReadOnly = .F.
				.cCity.ReadOnly = .F.
				.cST.ReadOnly = .F.
				.cZip.ReadOnly = .F.
				.cCountry.ReadOnly = .F.
		*		.chkQuality.ReadOnly = .F.
		*		.dLastSurveySent.ReadOnly = .F.
		*		.dLastSurveyReceived.ReadOnly = .F.
				.cJobTitle.ReadOnly = .F.
		*		.nSurveyPriority.ReadOnly = .F.
				.chkVCinactive.ReadOnly = .F.
				.cmdSaveToPO.Enabled = .F.
			ENDWITH
			
		ELSE
		*	ThisForm.Editing = .F.
		
			ThisForm.Address_Screen('ContactToEdit')
			
			WITH ThisForm.pf.pg_po.pgfPO.pgVendorContact
				.cContact.ReadOnly = .T.
				.cPhone.ReadOnly = .T.
				.cCellPhone.ReadOnly = .T.
				.cFax.ReadOnly = .T.
				.cEmail.ReadOnly = .T.
				.cAddr1.ReadOnly = .T.
				.cAddr2.ReadOnly = .T.
				.cCity.ReadOnly = .T.
				.cST.ReadOnly = .T.
				.cZip.ReadOnly = .T.
				.cCountry.ReadOnly = .T.
				.chkQuality.ReadOnly = .T.
				.dLastSurveySent.ReadOnly = .T.
				.dLastSurveyReceived.ReadOnly = .T.
				.cJobTitle.ReadOnly = .T.
				.nSurveyPriority.ReadOnly = .T.
				.chkVCinactive.ReadOnly = .T.
				.cmdSaveToPO.Enabled = .T.
			ENDWITH
		ENDIF
	ENDPROC

	PROCEDURE fillvendoraddr
		PARAMETERS nVendCode
		*ThisForm.FillVendorAddr(nVendCode)
		
		IF USED( 'Vendor' )
			USE IN Vendor
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.Vendor "
		cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
			RETURN .F.
		ENDIF
				
		IF USED('Vendor') 
			*ThisForm.VendCode= Vendor.VendCode
			ThisForm.VendCode = Vendor.VendCode
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtVendCode.Value = Vendor.VendCode
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtCompany.Value = Vendor.Company
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtAddr1.Value = Vendor.Addr1
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtAddr2.Value = Vendor.Addr2
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtCity.Value = Vendor.City
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtST.Value = Vendor.ST
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtZip.Value = Vendor.Zip
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtCountry.Value = Vendor.Country
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtLastEdit.Value = PrepareSQLdate(Vendor.LastEdit,'LastEdit')
			ThisForm.pf.pg_po.pgfPO.pgVendor.QAApproved1.Value	= PrepareSQLchk(Vendor.QAApproved,'QAApproved')
			ThisForm.pf.pg_po.pgfPO.pgVendor.Metal1.Value 	= PrepareSQLchk(Vendor.Metal,'Metal')
			ThisForm.pf.pg_po.pgfPO.pgVendor.INACTIVE1.Value = PrepareSQLchk(Vendor.Inactive,'Inactive')
			
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtPeachID.Value = getPeachID_VendCode(Vendor.VendCode,ThisForm.nConnHandle)
			ThisForm.pf.pg_po.pgfPO.pgVendor.chkVendorPOConf.Value	= PrepareSQLchk(VendorPOConf_POitem(ThisForm.POitem,ThisForm.nConnHandle),'VedorPOConf')
			
			ThisForm.pf.pg_po.pgfPO.pgVendor.Vend_Notes.Value = getVendor_Notes_VendCode(Vendor.VendCode,ThisForm.nConnHandle)
			ThisForm.pf.pg_po.pgfPO.pgVendor.Vend_Print.Value = getVendor_Print_VendCode(Vendor.VendCode,ThisForm.nConnHandle)
			
			ThisForm.pf.pg_po.pgfPO.pgPODesc.lblVendCode.Caption = STR(nVendCode)
			ThisForm.pf.pg_po.pgfPO.pgPODesc.lblPeachID.Caption	= getPeachID_VendCode(nVendCode)
							
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE getvendorcontacts
		PARAMETERS nContactID
		*ThisForm.GetVendorContacts(nContactID)
		
		IF VARTYPE(nContactID)!="N"
			nContactID = 0
		ENDIF
		
		PRIVATE nVendCode 
		nVendCode = ThisForm.VendCode
		
		IF USED('VendorContacts')
		*	ThisForm.pf.pg_po.pgfPO.pgVendorContact.lstContactID.RowSource = ''
			USE IN VendorContacts
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.VendorContact WITH(NOLOCK) "
		cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'VendorContacts')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'VendorContacts' )
		ENDIF
		
		SELECT VendorContacts
		INDEX ON ContactID TAG ContactID
		SET ORDER TO ContactID
		
		SELECT ContactID FROM VendorContacts INTO ARRAY gaContactIDs
		GO TOP
		
		IF RECCOUNT('VendorContacts') < 1
			DIMENSION gaContactIDs(1)
			gaContactIDs(1) = 0
		ENDIF
		ThisForm.pf.pg_po.pgfPO.pgVendorContact.lstContactID.NumberOfElements = ALEN(gaContactIDs,1)
		ThisForm.pf.pg_po.pgfPO.pgVendorContact.lstContactID.RowSourceType = 5
		ThisForm.pf.pg_po.pgfPO.pgVendorContact.lstContactID.RowSource = 'gaContactIDs'
		ThisForm.pf.pg_po.pgfPO.pgVendorContact.lstContactID.Refresh
		
		IF nContactID = 0
			nContactID = VendorContacts.ContactID
		ENDIF
		
		ThisForm.ShowVendorContact(nContactID)
	ENDPROC

	PROCEDURE inventoryform
		PARAMETER lcForm
		
		IF TYPE("lcForm") != "C"
			RETURN ''
		ENDIF
		
		PRIVATE lcInvForm
		lcInvForm = ''
		** Used to Find in Price Table!
		*FormDescription( lcForm, lcInvForm )
		lcInvForm = FormDescription( lcForm )
		
		
		*!*	PRIVATE lcInvForm
		*!*	DO CASE
		*!*	CASE lcForm= "10" && bar
		*!*		lcInvForm = "10"
		*!*	CASE lcForm= "11" &&Flat bar
		*!*		lcInvForm = "40"
		*!*		
		*!*	CASE lcForm= "12" && Hex bar
		*!*		lcInvForm = "12"
		*!*	CASE lcForm= "13" && Square bar
		*!*		lcInvForm = "13"
		*!*		
		*!*	CASE lcForm= "20" && Wire Spool
		*!*		lcInvForm = "20"
		*!*	CASE lcForm= "21" && Wire Cuts
		*!*		lcInvForm = "20"
		*!*		
		*!*	CASE lcForm= "30" && Coated Electrodes
		*!*		lcInvForm = "30"
		*!*	CASE lcForm= "40" && Plate/Sheet
		*!*		lcInvForm = "40"
		*!*	CASE lcForm= "51" && Strip
		*!*		lcInvForm = "40"
		*!*	CASE lcForm= "60" && Tube
		*!*		lcInvForm = "60"
		*!*	CASE lcForm= "65" && Pipe
		*!*		lcInvForm = "65"
		*!*	CASE lcForm = "66" && Nipple
		*!*		lcInvForm = "66"
		*!*	CASE lcForm = "67" && Elbow
		*!*		lcInvForm = "67"
		*!*	CASE lcForm = "68" && tee
		*!*		lcInvForm = "68"
		*!*	CASE lcForm = "69" && reducer
		*!*		lcInvForm = "69"	
		*!*	CASE lcForm= "70" && Flanges
		*!*		lcInvForm = "70"
		*!*	CASE lcForm= "72" && Machined
		*!*		lcInvForm = "72"
		*!*	CASE lcForm= "75" && Fasteners
		*!*		lcInvForm = "75"
		*!*	CASE lcForm = "80"  &&Cut Disk
		*!*		lcInvForm = "40"
		*!*	OTHERWISE
		*!*		lcInvForm = lcForm
		*!*	ENDCASE
		
		RETURN lcInvForm 
		
	ENDPROC

	PROCEDURE loadhardwood
		*ThisForm.LoadHardwood()
		
		PRIVATE cSQL,nSQLEXEC 
		
		IF USED('HardWood')
			SELECT HardWood
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT [country]"
		cSQL = cSQL + " ,[abv]"
		cSQL = cSQL + " ,[summary]"
		cSQL = cSQL + " ,[webpage]"
		cSQL = cSQL + " ,[printout]"
		cSQL = cSQL + " ,[inactive]"
		cSQL = cSQL + " FROM [dbo].[hardwood]"
		  		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'HardWood')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'HardWood')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'HardWood')
		ENDIF
		
	ENDPROC

	PROCEDURE loadstocklst
		PRIVATE  lOK
		lOK = .F.
		
		
		PRIVATE cSQL_Master, cSQL_Detail, cSQL_Process
		PRIVATE nSQLEXEC
		
		cSQL_Master="SELECT * FROM StockLst_Master " &&ORDER BY
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master, 'StockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Master, 'StockLst_Master')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Master,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master')
		ELSE
		
			SELECT StockLst_Master
		*	INDEX ON Alloy TAG Alloy
		*	INDEX ON Alloy+FORM TAG AlloyForm
		*	INDEX ON Alloy+FORM+STR(Size,9,3) TAG StockLst
		*	INDEX ON Alloy+FORM+COND+STR(SIZE,9,3)+HEAT TAG AFCSH
		
			***************
		
			IF USED("StockLst_Detail")
				SELECT StockLst_Detail
			ELSE
				SELECT 0
			ENDIF
			cSQL_Detail="SELECT * FROM StockLst_Detail ORDER BY ID"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail, 'StockLst_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Detail, 'StockLst_Detail')
			ENDDO
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Detail,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail')
			ELSE
				*SELECT StockLst_Detail
				*INDEX ON ID TAG DetailID
				*SET RELATION TO ID INTO StockLst_Detail IN StockLst_Master
		
				cSQL_Process = "SELECT * FROM StockLst_Process ORDER BY ID_Detail"
		
				IF USED("StockLst_Process")
					SELECT StockLst_Process
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process, 'StockLst_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL'  TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_Process, 'StockLst_Process')
				ENDDO
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process')
				ELSE
					lOK = .T.
				ENDIF
			ENDIF
		ENDIF
		
		IF lOK
		
		ELSE
			= MESSAGEBOX('Error getting Data!'+CHR(13)+"Closing NOW!", 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE pgrefresh
		WAIT WINDOW "Page Refresh" NOWAIT
		DO CASE
			CASE ThisForm.pf.ActivePage = 1
				ThisForm.pf.pgOrder.Refresh()
				ThisForm.pf.pgQuote.Refresh()
			CASE ThisForm.pf.ActivePage = 2
				ThisForm.pf.pgOrder.Refresh()
				ThisForm.pf.pgQuote.Refresh()
			CASE ThisForm.pf.ActivePage = 3
				ThisForm.pf.pgValue.Refresh()
			CASE ThisForm.pf.ActivePage = 4
				ThisForm.pf.pgBillTo.Refresh()
			CASE ThisForm.pf.ActivePage = 5
				ThisForm.pf.pgShipTo.Refresh()
			CASE ThisForm.pf.ActivePage = 6
				ThisForm.pf.pg_PO.Refresh()
			CASE ThisForm.pf.ActivePage = 7
				ThisFormSet.frmCC.txtAddr1.Refresh()
			CASE ThisForm.pf.ActivePage = 8
				ThisForm.pf.pgQA.Refresh()		
		ENDCASE
		WAIT CLEAR
	ENDPROC

