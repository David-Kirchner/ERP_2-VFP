	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdAdd.Click
		*Add
		This.Enabled = .F.
		
		This.parent.cmdEdit.Caption = "Save"
		This.parent.cmdDelete.Caption = "Cancel"
		
		ThisForm.EditContactScreen( 1 )
		ThisForm.ShowVendorContact( 0 )
		
		This.parent.nContactID.Value = 0
		ThisForm.nContactID = 0
		
		This.parent.cContact.SetFocus
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdAdd.When
		IF ThisForm.VendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then add the Vendor Contact.",48,"Cannot Add")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdDelete.Click
		IF THIS.Caption = "Delete"
			*Delete
			PRIVATE nContactID
		*	nContactID = PrepareSQLnum(This.Parent.nContactID.Value,'Contact',-3)
			nContactID = PrepareSQLnum(ThisForm.nContactID,'Contact',-3)
			
			ThisForm.DeleteContactID(nContactID)
			
			This.parent.cmdAdd.Enabled = .T.
			This.parent.cmdEdit.Caption = "Edit"
		*	THIS.Caption = "Cancel"
		ELSE
			*Cancel
			ThisForm.EditContactScreen(0)
			This.parent.cmdAdd.Enabled = .T.
			This.parent.cmdEdit.Caption = "Edit"
			THIS.Caption = "Delete"
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdDelete.When
		IF ThisForm.nContactID = 0 AND THIS.Caption = "Delete"
			MESSAGEBOX("No contact to delete.",48,"Cannot Delete")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdEdit.Click
		IF THIS.Caption = "Edit"
			*Edit
			ThisForm.EditContactScreen( 1 )
			
			This.parent.cmdAdd.Enabled = .F.
			This.parent.cmdDelete.Caption = "Cancel"
			THIS.Caption = "Save"
		ELSE
			*Save
			IF ThisForm.SaveContactID()
				ThisForm.EditContactScreen(0)
				
				This.parent.cmdAdd.Enabled = .T.
				This.parent.cmdDelete.Caption = "Delete"
				THIS.Caption = "Edit"
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdEdit.When
		IF ThisForm.VendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then edit the Vendor Contact.",48,"Cannot Edit")
			RETURN .F.
		ENDIF
		
		IF ThisForm.nContactID = 0 AND THIS.Caption = "Edit"
			MESSAGEBOX("Add a Contact First.",48,"Cannot Edit")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdSavetoPO.Click
		PRIVATE nContactID, cContact, nVendCode, nHPAPO
		nContactID	= PrepareSQLnum(This.parent.nContactID.Value,'ContactID',-3)
		cContact	= PrepareSQLtxt(This.parent.cContact.Value,'Contact',20)
		
		IF nContactID = 0
			MESSAGEBOX("Please Select a Contact to Save with this PO.",48,"Cannot save with PO.")
			RETURN .F.
		ENDIF
		
		*nVendCode = ThisForm.VendCode
		ThisForm.nContactID = nContactID
		nHPAPO	= This.parent.parent.pgPODesc.txtHpaPo.Value
		
		PRIVATE lPOSaveOK 
		lPOSaveOK = .F.
		
		PRIVATE cSQLu
		cSQLu = "UPDATE dbo.PurchaseOrder SET "
		cSQLu = cSQLu + " ContactID="+ALLTRIM(STR(nContactID))
		cSQLu = cSQLu + " ,POsalesP='"+cContact+"'"
		cSQLu = cSQLu + " WHERE HPAPO = "+ALLTRIM(STR(nHPAPO))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
			lPOSaveOK  = .F.
		ELSE
			lPOSaveOK = .T.
		*	TrackMess( "Updated POitem:"+ALLTRIM(cPOitem)+" for SOitem:"+cSOItem+" from EnterOrder.")
		*	Save_SOitem_Status( cSOItem, nHPApo, 'PO', 'Updated POitem:'+ALLTRIM(cPOitem), ThisForm.nConnHandle )
			
			This.parent.parent.pgPODesc.txtPOSalesName.VALUE = cContact
			ThisForm.nContactID = nContactID
			
			MESSAGEBOX("Contact Saved with PO.",64,"Saved!")
		ENDIF
		
		IF lPOSaveOK 
			This.parent.lblSaveContact.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.cmdSavetoPO.When
		IF ThisForm.VendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then add the Vendor Contact.",48,"Cannot Save")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgVendorContact.lstContactID.InteractiveChange
		PRIVATE nContactID
		
		
		IF VARTYPE(This.Value) = "N"
			nContactID = gaContactIDs(This.Value,1)
		ENDIF
		IF VARTYPE(This.Value) = "C"
			nContactID = VAL(This.Value)
		ENDIF
		
		ThisForm.ShowVendorContact( nContactID )
	ENDPROC

	PROCEDURE frmQA.cmdAdd.Click
		IF THIS.Caption = "Add"
			This.Caption = "Save"
			This.parent.cmdEdit.Visible = .F.
			This.parent.cmdCancelEdit.Visible = .T.
			This.parent.cmdAmendmentsPrint.Visible = .F.
			
			This.Parent.edtVersionComments.Value = ""
			This.Parent.edtVersionComments.ReadOnly = .F.
			ThisForm.Sales_No_RevID = 0
			This.Parent.edtVersionComments.SetFocus
			
		ELSE
			This.Caption = "Add"
			This.parent.cmdEdit.Visible = .T.
			This.parent.cmdCancelEdit.Visible = .F.
			This.parent.cmdAmendmentsPrint.Visible = .T.
		
			This.Parent.edtVersionComments.ReadOnly = .T.
			
			PRIVATE nSalesNum,nVER,cComment,nSales_No_RevID
			nSalesNum	= ThisForm.Salesnum
			nVER		= This.parent.txtVersion.Value
			cComment	= PrepareSQLtxt(This.Parent.edtVersionComments.Value,'Comment',-1)
			nSales_No_RevID	= ThisForm.Sales_No_RevID
			
			IF nSales_No_RevID = 0
				*Add
				
				PRIVATE cSQL,nSQLEXEC 
				cSQL= "INSERT INTO dbo.Sales_No_Rev ([SalesNum],[VER],[Comment]) VALUES ("
				cSQL = cSQL +""+STR(nSalesNum)
				cSQL = cSQL +","+STR(nVER)
				cSQL = cSQL +",'"+cComment+"'" +")"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF
		
				
			ELSE
				*UPDATE
				PRIVATE cSQL,nSQLEXEC 
				cSQL= "UPDATE dbo.Sales_No_Rev SET "
				cSQL= cSQL+ "Comment= '"+cComment+"'"
				cSQL= cSQL+ " WHERE ID="+STR(nSales_No_RevID)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF
			ENDIF
			
			ThisForm.Show_QA()
		ENDIF
	ENDPROC

	PROCEDURE frmQA.cmdAmendmentsPrint.Click
		IF USED('tmpSales_No_Rev')
		
		
			REPORT FORM Reports\Sales_No_Rev NOCONSOLE PREVIEW
		
		ENDIF
	ENDPROC

	PROCEDURE frmQA.cmdCancelEdit.Click
		This.parent.cmdAmendmentsPrint.Visible = .T.
		This.Visible = .f.
		This.Parent.cmdEdit.Visible = .T.
		This.parent.cmdAdd.Caption = "Add"
		This.parent.cmdAdd.Visible = .T.
		This.parent.edtVersionComments.ReadOnly = .T.
		
		ThisForm.Show_QA()
		
	ENDPROC

	PROCEDURE frmQA.cmdEdit.Click
		This.parent.cmdAmendmentsPrint.Visible = .F.
		This.parent.cmdCancelEdit.Visible = .T.
		This.Visible = .f.
		This.parent.cmdAdd.Caption = "Save"
		This.parent.cmdAdd.Visible = .T.
		This.parent.edtVersionComments.ReadOnly = .F.
		This.Parent.edtVersionComments.SetFocus
		
	ENDPROC

	PROCEDURE frmQA.grdAmend.AfterRowColChange
		LPARAMETERS nColIndex
		
		This.parent.txtVer.Value = tmpSales_No_Rev.VER
		This.parent.txtVerDate.Value = tmpSales_No_Rev.When
		This.parent.edtVersionComments.Value = tmpSales_No_Rev.Comment
		ThisForm.Sales_No_RevID = tmpSales_No_Rev.ID
		
		This.parent.cmdAdd.Visible = .T.
		This.parent.cmdAdd.Caption = "Add"
		This.parent.cmdEdit.Visible = .T.
		This.parent.cmdCanceledit.Visible = .F.
		This.parent.cmdAmendmentsPrint.Visible = .T.
		
	ENDPROC

	PROCEDURE frmQA.Label1.Click
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD "
		cSQL = cSQL + " FROM dbo.Quotes_PMI"
		cSQL = cSQL + " WHERE AQ_ID_Curr = "+STR(nQuotes_ID)
		
		IF USED("tmpPMIcount")
			USE IN tmpPMIcount
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPMIcount')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPMIcount')
		ENDDO
		IF nSQLEXEC < 0
		ENDIF
		
		IF USED('tmpPMIcount')
			IF RECCOUNT('tmpPMIcount') > 0
			
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
