		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'CreditCd')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'CreditCd')
		ENDIF
		
		IF USED('CreditCd')
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
		
	ENDPROC

