	PROCEDURE frmPO.pgfPO.pgPODesc.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode WITH(NOLOCK)"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.Clear
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		This.Value = "1"
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.cmbForm.Valid
		*RowSource=10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
		PRIVATE nTHCK, cForm
		nTHCK = This.parent.txtThck.Value
		cForm = This.Value  &&This.parent.cmbForm.Value
		
		IF TYPE('nthck') = "N" AND TYPE('cForm')="C"
			IF nthck > 0 AND nthck < .125 AND cForm = "40"
				This.Parent.chkSPS1.Value = 1
			ENDIF
		ENDIF
		
		ThisForm.RefreshForms(This.Value)
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.cmbShipWhere.Init
		This.Style = 2
		This.RowSourceType = 1
		This.RowSource = getShipWhereString()
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.cmbShipWhere.InteractiveChange
		
		*ThisForm.Shipwherechange(nShipWhere,cCompany,cCity)
		PRIVATE nShipWhere,cCompany,cCity
		nShipWhere = This.Value
		cCompany = This.parent.parent.pgPOAddress.txtCompany.Value 
		cCity = This.parent.parent.pgPOAddress.txtCity.Value 
		
		*ThisForm.Shipwherechange(This.Value,This.parent.txtCompany.Value,This.parent.txtCity.Value)
		ThisForm.Shipwherechange(nShipWhere,cCompany,cCity)
		
		*rowsource='HPA Tipton,Direct2Cust,Blind,Service_Conv,HPA Windfall'
		*1 HPA Tipton,2 DIRECT,3 Blind,4 Service,5 HPA Windfall,6 RemoteStock
		DO CASE
		CASE nShipWhere = 1
			*HPA Tipton
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 1
		*	ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 1
		CASE nShipWhere = 2
			*DIRECT
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 2
		*	ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 2
		CASE nShipWhere = 3
			*Blind
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 3
		*	ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 3
		CASE nShipWhere = 4
			*Service
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 4
		*	ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 4
		CASE nShipWhere = 5
			*HPA Windfall
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 5
		*	ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 5
		CASE nShipWhere = 6
			*RemoteStock
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 6
		*	ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = 6
		ENDCASE
		
		This.parent.parent.pgPOAddress.opgPOShipTo.Refresh
		*ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Refresh
	ENDPROC

