	PROCEDURE frmPO.pgfPO.pgPODesc.txtOrder_Qty.Valid
		PRIVATE nOrder_Qty, nLotP
		nOrder_Qty		= PrepareSQLnum(This.VALUE,'Order_Qty',11,3)
		nLotP			= PrepareSQLnum(This.parent.txtLotP.VALUE,'LotP',9,2)
		
		IF nOrder_Qty < 1
			IF nLotP > 0
				*Default to 1 on LotPrice
		*		nOrder_Qty = 1
				This.VALUE = 1
			ELSE
				MESSAGEBOX("Please enter the number of units to be priced.",48,"Units priced is empty!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtPOSalesName.InteractiveChange
		PRIVATE cSearchStr, cSearchStrOrig, cTryVContact
		PRIVATE nInsertionPt
		nInsertionPt = THIS.SELSTART
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		cSearchStr = PrepareSQLtxt(cSearchStrOrig,'Contact',30)
		cTryVContact  = ''
		
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(ThisForm.VendCode,'VendCode',-3)
		
		IF nVendCode > 0
			IF !EMPTY(cSearchStr)
				cTryVContact = SearchVendCodeContact( nVendCode, cSearchStr, ThisForm.nConnHandle ) 
				cTryVContact = ALLTRIM( cTryVContact )
				IF NOT EMPTY(cTryVContact)		
					IF UPPER(cSearchStr) = UPPER(SUBSTR(cTryVContact,1,nInsertionPt))
						*Good
						THIS.VALUE=cTryVContact
						THIS.FORECOLOR = RGB(0,0,0)				
					ELSE
						*Not Good
						THIS.VALUE=cSearchStrOrig 
						THIS.FORECOLOR = RGB(255,0,0)
					ENDIF
				ELSE
			*		*No replacement
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
				THIS.VALUE=SPACE(0)
			ENDIF
			THIS.SELSTART = nInsertionPt
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtPOSalesName.LostFocus
		=insmode(.T.)
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtPOSalesName.Valid
		PRIVATE cSearchStr,cSearchStrOrig, cTryVContact
		*PRIVATE nInsertionPt
		*nInsertionPt = THIS.SELSTART
		*cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		cSearchStrOrig = (This.Value)
		cSearchStr = PrepareSQLtxt(cSearchStrOrig,'Contact',30)
		cTryVContact  = ''
		
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(ThisForm.VendCode,'VendCode',-3)
		
		IF nVendCode > 0
			IF !EMPTY(cSearchStr)
				cTryVContact = SearchVendCodeContact( nVendCode, cSearchStr, ThisForm.nConnHandle ) 
				cTryVContact = ALLTRIM( cTryVContact )
				IF NOT EMPTY(cTryVContact)		
					IF UPPER(cSearchStr) = UPPER(cTryVContact)
						*Good
						THIS.VALUE=cTryVContact
						THIS.FORECOLOR = RGB(0,0,0)				
					ELSE
						*Not Good
						WAIT WINDOW "This Vendor Contact Does not match contacts available for Vendor" NOWAIT
						THIS.VALUE=cSearchStrOrig 
						THIS.FORECOLOR = RGB(255,0,0)
					ENDIF
				ELSE
			*		*No replacement
					WAIT WINDOW "This Vendor Contact Does not match contacts available for Vendor" NOWAIT
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ENDIF
			IF LEN(cSearchStr) = 1
				MESSAGEBOX("Please Enter a more Descriptive Vendor Contact Name",48,"No Initials for Vendor Name!")
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtP_ft.Valid
		IF This.Value > 0
			IF EMPTY(This.Parent.txtOrder_Qty.VALUE)
				IF This.Parent.txtsZ3.Value > 0
					IF This.Parent.txtPieces.VALUE > 1
						This.Parent.txtOrder_Qty.VALUE = This.Parent.txtPieces.VALUE * This.Parent.txtsZ3.Value / 12
					ELSE
						This.Parent.txtOrder_Qty.VALUE = This.Parent.txtsZ3.Value / 12
					ENDIF
				ELSE
					IF This.Parent.txtSz2.Value > 0
						IF This.Parent.txtPieces.VALUE > 1
							This.Parent.txtOrder_Qty.VALUE = This.Parent.txtPieces.VALUE * This.Parent.txtSz2.Value / 12
						ELSE
							This.Parent.txtOrder_Qty.VALUE = This.Parent.txtSz2.Value / 12
						ENDIF
					ENDIF
				ENDIF
			ELSE
				*WAIT WINDOW "Units to be priced allready has value. Clear to recalc!" NOWAIT
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtP_lb.Valid
		IF This.Value > 0
			IF EMPTY(This.Parent.txtOrder_Qty.VALUE)
				IF SalesQuote.Weight > 0
					This.Parent.txtOrder_Qty.VALUE = SalesQuote.Weight
				ENDIF
			ELSE
				*WAIT WINDOW "Units to be priced allready has value. Clear to recalc!" NOWAIT
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtP_pc.Valid
		IF This.Value > 0
			IF EMPTY(This.Parent.txtOrder_Qty.VALUE)
				IF SalesQuote.Pieces > 0
					This.Parent.txtOrder_Qty.VALUE = SalesQuote.Pieces 
				ENDIF
			ELSE
				*WAIT WINDOW "Units to be priced allready has value. Clear to recalc!" NOWAIT
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtThck.Valid
		PRIVATE nTHCK, cForm
		nTHCK = This.Value
		cForm = This.parent.cmbForm.Value
		
		IF TYPE('nTHCK') = "N" AND TYPE('cForm')="C"
			IF nTHCK > 0 AND nTHCK < .125 AND cForm = "40"
				This.Parent.chkSPS1.Value = 1
			ENDIF
		ENDIF
		
		IF TYPE('nTHCK') = "N" 
			IF nTHCK > 0
				PRIVATE nCurrStandSize,nStandardSize
				*IF cStock $ "All for Stock,Mostly Stock,Some Stock"
				nCurrStandSize	= PrepareSQLnum(This.parent.txtStandSize.VALUE,'StandSize',10,4)
				nStandardSize	= getStandardSize(nTHCK , ThisForm.nConnHandle)
						
				IF nStandardSize > 0
					PRIVATE nPrevSize, nPrevStandardSize
					
					IF nCurrStandSize = 0
						FOR nPrevSize = nTHCK TO 0 STEP -.001
							nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
							IF nPrevStandardSize <= nStandardSize 
								*This.Value = nPrevStandardSize
								This.parent.txtStandSize.Value = nPrevStandardSize
								This.parent.txtStandSize.Refresh
								
								EXIT
							ENDIF
						NEXT nPrevSize 
								
					ELSE
						IF nStandardSize != nCurrStandSize 
							*MESSAGEBOX("Not a 'Standard Size'! "+ALLTRIM(STR(nSize,9,4))+CHR(13)+"You may need to adjust your Stand Size!"+CHR(13)+"Please use a dimension that is found in the Pricing table as Standard!",0+16,"Size Entered is not a Standard")
							
							FOR nPrevSize = nTHCK TO 0 STEP -.001
								nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
								IF nPrevStandardSize <= nStandardSize 
									*This.Value = nPrevStandardSize
									This.parent.txtStandSize.Value = nPrevStandardSize
									This.parent.txtStandSize.Refresh
									
									EXIT
								ENDIF
							NEXT nPrevSize 
		
						ENDIF
		
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgTestPO.Click
		PRIVATE lcPOitem
		lcPOitem = Proper_PO_Item( This.parent.parent.lstPoItems.Value )
		
		IF ThisForm.POEditing 
			lcPOitem = Proper_PO_Item( STR(This.parent.pgPODesc.txtHpapo.Value)+"-"+STR(This.parent.pgPODesc.txtItemPo.Value) )
		ENDIF
		
		***Refresh PO_Testing screen
		PRIVATE nCountPOTesting
		nCountPOTesting = Count_POIteminPO_Testing( lcPOitem, ThisForm.nConnHandle )
		
		IF nCountPOTesting = 0
			*Add
			IF ThisForm.POEditing 
				IF MESSAGEBOX("Do you want to store Testing info with this PO?",4+32,"Create a Testing PO?")=6
					ThisForm.ShowPOTesting( 'NEW' )
				ELSE
					ThisForm.ShowPOTesting( 'BLANK' )
				ENDIF
			ELSE
				MESSAGEBOX("Nothing to Show."+CHR(13)+"Place the PO in Editing mode to add 'Testing' data.",0+64,"No Testing data to show")
				
				ThisForm.ShowPOTesting( 'BLANK' )
				
			ENDIF
		ELSE
			*Get data
			WAIT WINDOW "Retrieveing PO Testing data" Nowait
			ThisForm.ShowPOTesting( lcPOitem )
			WAIT CLEAR
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgTestPO.pgfTesting.pgMaterial.cmbSetDefaults.Valid
		PRIVATE cDefault
		cDefault = This.Value
		
		IF cDefault != "No change"
			IF MESSAGEBOX("This will overwrite existing data!"+CHR(13)+"Unless you cancel this PO Edit."+CHR(13)+CHR(13)+"Do you want to continue with defaults?",0+32,"Overwrite with new default data?")=7
				RETURN .F.
			ENDIF
		ENDIF
		
		DO CASE
		CASE cDefault = "No change"
			*No Change
		CASE cDefault = "6B"
			This.parent.ogTestType.Value = 2
			This.parent.ogTestPackage.Value = 1
			*This.parent.ogDelivery.Value = 1
