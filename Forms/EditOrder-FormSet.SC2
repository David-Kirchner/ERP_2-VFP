	PROCEDURE frmCC.cmbCardType.Valid
		IF m.cccardtype = "AMEX"
			This.Parent.lblLast4.Caption = "Last 3"
		ELSE
			This.Parent.lblLast4.Caption = "Last 4"
		ENDIF
	ENDPROC

	PROCEDURE frmCC.cmdCCEdit.Click
		DO CASE
		CASE This.Caption = "Add New"
			ThisForm.ccScreen("ENABLE")
			ThisForm.CreditCard("NEW")
			ThisForm.Address_Screen("CCSoldtoSave")
			
			This.Caption = "Save"
			This.Parent.cmdCCPrint.Caption = "Cancel"
			This.Parent.cmdCCPrint.Enabled = .T.
			
		CASE This.Caption = "Edit"
			ThisForm.ccScreen("ENABLE")
			ThisForm.CreditCard("EDIT")
			ThisForm.Address_Screen("CCSoldtoSave")
			
			This.Caption = "Save"
			This.Parent.cmdCCPrint.Caption = "Cancel"
			This.Parent.cmdCCPrint.Enabled = .T.
		
		CASE This.Caption = "Save"
			ThisForm.ccScreen("DISABLE")
			ThisForm.CreditCard("SAVE")
			ThisForm.Address_Screen("CCSoldtoEdit")
			
			This.Caption = "Edit"
			This.Parent.cmdCCPrint.Caption = "Print"
		
			
			IF !EMPTY(This.Parent.txtSalesnum.Value)
				This.Parent.cmdCCPrint.Enabled = .T.
			ELSE
				This.Parent.cmdCCPrint.Enabled = .F.
			ENDIF
		ENDCASE
	ENDPROC

	PROCEDURE frmCC.cmdCCEditSoldTo.Click
		PRIVATE	maxSoldCode, maxShipCode, oldSoldCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnSoldAddr
		PRIVATE lcContact,lcPhone,lcFax,lcEmail
		
		lcCompany =PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',30)
		lcAddr1 = PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',30)
		lcAddr2 = PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',30)
		lcCity  = PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',20)
		lcST    = PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',2)
		lcZip   = PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',12)
		lcCountry = PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',15)
		lcContact = PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',20)
		lcPhone = PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',12)
		lcFax	 = PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
		lcEmail = PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		ldLastEdit = DATE()
		lnSoldAddr = IIF(THISFORM.ccSoldAddr>0,THISFORM.ccSoldAddr,THISFORM.SoldAddr)
		
		SaveAddr = .F.
		SaveAddress = .F.
		oldSoldCode = 0
		IF THIS.CAPTION = "Save"
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))
				SaveAddress = .T.
			ENDIF
		
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!")
				SaveAddress = .F.
				RETURN .F.
			ENDIF
		
			IF USED("cntSoldCode")
				USE IN cntSoldCode
			ENDIF
			SELECT 0
			cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.SoldAddr"
			cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
			cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
			cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
			cSQL = cSQL + " AND City = '"+lcCity+"'"
			cSQL = cSQL + " AND ST = '"+lcST+"'"
			cSQL = cSQL + " AND Zip = '"+lcZip+"'"
			cSQL = cSQL + " AND Country = '"+lcCountry+"'"
			cSQL = cSQL + " AND Contact = '"+lcContact+"'"
			cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
			cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
			cSQL = cSQL + " AND Email = '"+lcEmail+"'"
		*	cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSoldCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSoldCode')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSoldCode')
			ENDIF
			IF USED("cntSoldCode")
				IF cntSoldCode.cnt = 0
					SaveAddress = .T.
				ELSE
					SaveAddress = .F.
					*Already have exact Address
		
					IF EMPTY(THISFORM.SoldAddr)
						*Find the SoldCode and display it
		
		*				IF aCodeUsed(1) > 0
							THISFORM.ccSoldAddr = lnSoldAddr
							THIS.PARENT.txtSoldCode.REFRESH
		*				ENDIF
					ELSE
						*Not changed
					ENDIF
				ENDIF
			ELSE
				SaveAddress = .F.
			ENDIF
		
			IF SaveAddress
				****** big save procedure********
				PRIVATE	cSaveNew
		
				IF lnSoldAddr > 0
					IF lnSoldAddr < 6
						*DO NOT overwrite the HPA locations!
						MESSAGEBOX( "You cannot edit the default HPA address'!"+CHR(13)+"This address will be saved as a new Address Code.",0+48,'Create new address')
						cSaveNew = 6
					ELSE
						cSaveNew = MESSAGEBOX("Use NO to save the address edits."+CHR(13)+"Use NEW address only when Company has moved."+CHR(13)+CHR(13)+"Save as new Address?",4+32,"Is this a New Address?")
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					cSaveNew = 6
				ENDIF
		
				IF cSaveNew = 6 && Yes, save as new
		
					*	Get maxSoldCode
					*maxSoldCode = THISFORM.maxSoldCode()
					*maxShipCode = THISFORM.maxShipCode()
					MaxSoldCode=get_MaxSoldCode()
					MaxShipCode=get_MaxShipCode()
					
					maxSoldCode= MAX( maxSoldCode, maxShipCode )
					maxSoldCode = maxSoldCode + 2 &&leave space for Shipto Edits
		
					IF THISFORM.SoldAddr > 0
						*	*Check old SoldCode to see if anything changed.
		*				IF NOT USED('SoldAddr')
		*					USE SoldAddr IN 0 ORDER TAG soldcode
		*				ENDIF
		*				SELECT SoldAddr
		*				IF SEEK(THISFORM.SoldAddr,"SoldAddr","SoldCode" )
		
						IF USED("aSoldAddr")
							USE IN aSoldAddr
						ENDIF
						SELECT 0
						cSQL = "SELECT * FROM dbo.SoldAddr"
						cSQL = cSQL + " WHERE SoldCode = "+STR(THISFORM.SoldAddr)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
						ENDIF
						
						IF USED('aSoldAddr')
							IF aSoldAddr.soldcode = THISFORM.ccSoldAddr AND ;
									aSoldAddr.Company = THIS.PARENT.txtCompany.VALUE AND ;
									aSoldAddr.Addr1	= THIS.PARENT.txtAddr1.VALUE AND ;
									aSoldAddr.Addr2	= THIS.PARENT.txtAddr2.VALUE AND ;
									aSoldAddr.City	= THIS.PARENT.txtCity.VALUE AND ;
									aSoldAddr.ST		= THIS.PARENT.txtST.VALUE AND ;
									aSoldAddr.Zip		= THIS.PARENT.txtZip.VALUE AND ;
									aSoldAddr.Country	= THIS.PARENT.txtCountry.VALUE AND ;
									aSoldAddr.Contact	= THIS.PARENT.txtContact.VALUE AND ;
									aSoldAddr.Telephone	= THIS.PARENT.txtPhone.VALUE AND ;
									aSoldAddr.Fax_Number	= THIS.PARENT.txtFax.VALUE AND ;
									aSoldAddr.Email		= THIS.PARENT.txtEmail.VALUE
								*no change - do not save
							ELSE &&did not match all Fields - Save
								SaveAddr = .T.
								oldSoldCode = THISFORM.ccSoldAddr
							ENDIF
							
							USE IN aSoldAddr
							
						ELSE &&Seek failed - add as new
							SaveAddr = .T.
						ENDIF
					ELSE && No SoldCode just add new if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							SaveAddr = .T.
						ELSE
							SaveAddr = .T.
						ENDIF
					ENDIF
		
		
					IF SaveAddr
						DO WHILE FoundSoldCode( maxSoldCode,ThisForm.nConnHandle )
							maxSoldCode = maxSoldCode + 1
						ENDDO
		
						THIS.PARENT.txtSoldCode.VALUE = maxSoldCode
		*				THIS.PARENT.numSoldAddr.VALUE = maxSoldCode
						THISFORM.ccSoldAddr = maxSoldCode
						Save_ShipAddrCode(maxSoldCode, ALLTRIM(STR(maxSoldCode,10,0)), oldSoldCode,ThisForm.nConnHandle)
		
		*				INSERT INTO SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number,Email,Customer, LastEdit ) VALUES ;
							(maxSoldCode, THIS.PARENT.txtCompany.VALUE, THIS.PARENT.txtAddr1.VALUE, THIS.PARENT.txtAddr2.VALUE, THIS.PARENT.txtCity.VALUE,  THIS.PARENT.txtST.VALUE, THIS.PARENT.txtZip.VALUE, THIS.PARENT.txtCountry.VALUE, THIS.PARENT.txtContact.VALUE, THIS.PARENT.txtPhone.VALUE, THIS.PARENT.txtFax.VALUE, THIS.PARENT.txtEmail.VALUE, ALLTRIM(STR(maxSoldCode,10,0)), DATE())
		
						cSQLi = "INSERT INTO dbo.SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number,Email,Customer, LastEdit ) VALUES ("
						cSQLi = cSQLi + STR(maxSoldCode)
						cSQLi = cSQLi+",'"+lcCompany+"'"
						cSQLi = cSQLi+",'"+lcAddr1+"'"
						cSQLi = cSQLi+",'"+lcAddr2+"'"
						cSQLi = cSQLi+",'"+lcCity+"'"
						cSQLi = cSQLi+",'"+lcST+"'"
						cSQLi = cSQLi+",'"+lcZip+"'"
						cSQLi = cSQLi+",'"+lcCountry+"'"
						cSQLi = cSQLi+",'"+lcContact+"'"
						cSQLi = cSQLi+",'"+lcPhone+"'"
						cSQLi = cSQLi+",'"+lcFax+"'"
						cSQLi = cSQLi+",'"+lcEmail+"'"
						cSQLi = cSQLi + ",''"		&&+ALLTRIM(STR(maxSoldCode,10,0))+""
						cSQLi = cSQLi + ",'"+DTOC(DATE())+"')"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
		
		
						THISFORM.UpdateCustID = .T.
		
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
		
					ENDIF
				ELSE
					*Save - not as new!
					*REPLACE DATA
					
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.SoldAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
		*			cSQLu= cSQLu+",Customer="+ALLTRIM(STR(useShipCode,10,0))+""
					cSQLu = cSQLu + ",LastEdit='"+DTOC(DATE())+"'"
					cSQLu = cSQLu + " WHERE soldcode = "+STR(lnSoldAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
		
					*	THISFORM.UpdateCustID = .T.
		
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
				ENDIF
			ENDIF
		
			ThisForm.Address_Screen("CCAddrToEdit")
			THISFORM.cmdNext.SETFOCUS()
		
		ELSE &&Caption was Edit
			ThisForm.Address_Screen("CCAddrToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE frmCC.cmdCCPrint.Click
		IF THIS.CAPTION = "Print"
			
			**********************
			IF NOT ThisForm.SeekccSoldCodeinSoldAddr(ThisForm.ccSoldAddr)
				MESSAGEBOX("No or bad Credit Card 'Sold To' Address",0+16,"Could not get Address loaded.")
			ENDIF
			**********************
			IF NOT ThisForm.SeekSoldCodeinSoldAddr(ThisForm.SoldAddr)
				MESSAGEBOX("No or bad 'Sold To Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			IF NOT ThisForm.SeekShipCodeinShipAddr(ThisForm.ShipAddr)
				MESSAGEBOX("No or bad 'Ship To Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			ThisForm.SeekSalesNuminSales_No(SalesQuote.SalesNum)	
			**********************
			
			IF NOT ThisForm.SeekSalesNuminCreditCd(SalesQuote.SalesNum)
				MESSAGEBOX("No or bad 'CreditCard record.'",0+16,"Could not get CreditCd loaded.")
			ENDIF
			
			ThisForm.AlwaysOnBottom = .T.
			ThisForm.AlwaysOnTop = .F.
				
			IF !EMPTY(THIS.PARENT.txtSalesnum.VALUE)
				cNotSaved = ALLTRIM(This.Parent.txtCardno.Value)
				IF FILE("Reports\CreditInfo.Frx")
					REPORT FORM Reports\CreditInfo PREVIEW FOR CreditCd.SalesNum = THIS.PARENT.txtSalesnum.VALUE
				ELSE &&NOCONSOLE 
					IF FILE("\Reports\CreditInfo.Frx")
						REPORT FORM \Reports\CreditInfo PREVIEW FOR CreditCd.SalesNum = THIS.PARENT.txtSalesnum.VALUE
					ELSE
						IF FILE("Quotes\Reports\CreditInfo.Frx")
							REPORT FORM Quotes\Reports\CreditInfo PREVIEW FOR CreditCd.SalesNum = THIS.PARENT.txtSalesnum.VALUE
						ELSE
							MESSAGEBOX("REPORT FROM CreditInfo NOT FOUND",0,"Cannot Print")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			ThisForm.AlwaysOnBottom = .F.
			ThisForm.AlwaysOnTop = .T.
		ENDIF
		
		IF THIS.CAPTION = "Cancel"
			THISFORM.ccScreen("DISABLE")
		
			ThisForm.Address_Screen("CCSoldtoEdit")
			
			THISFORM.CreditCard("INIT")
					
			THIS.CAPTION = "Print"
			THIS.PARENT.cmdCCEdit.CAPTION = "Edit"
			IF !EMPTY(THIS.PARENT.txtSalesnum.VALUE)
				THIS.ENABLED = .T.
			ELSE
				THIS.ENABLED = .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmCC.cmdCCSearchSoldTo.Click
		Private matchCodes, nNewccSoldToCode , lcCurrTable 
		nNewccSoldToCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		
		DO FORM Forms\SearchForm WITH "SoldAddr", SalesQuote.company  TO nNewccSoldToCode 
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nNewccSoldToCode > 0
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr"
			cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nNewccSoldToCode )
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
			ENDIF
			IF USED( 'aSoldAddr' )
				thisform.ccSoldAddr = aSoldAddr.SoldCode
				This.Parent.txtSoldCode.Value = aSoldAddr.SoldCode
		*		This.Parent.numSoldAddr.Value = aSoldAddr.SoldCode
				This.Parent.txtCompany.Value = aSoldAddr.Company
				This.Parent.txtAddr1.Value = aSoldAddr.Addr1
				This.Parent.txtAddr2.Value = aSoldAddr.Addr2
				This.Parent.txtCity.Value = aSoldAddr.City
				This.Parent.txtST.Value = aSoldAddr.ST
				This.Parent.txtZip.Value = aSoldAddr.Zip
				This.Parent.txtCountry.Value = aSoldAddr.Country
				This.Parent.txtContact.Value = aSoldAddr.Contact
				This.Parent.txtPhone.Value = aSoldAddr.TelePhone
				This.Parent.txtFax.Value = aSoldAddr.Fax_Number
				This.Parent.txtEmail.Value = aSoldAddr.Email
				This.Parent.txtLastEdit.Value = PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')
				
				ThisForm.Address_Screen("CCSoldtoEdit")
				
				USE IN aSoldAddr
			EndIf
		
		ENDIF
	ENDPROC

	PROCEDURE frmCC.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF THISFORM.ccSoldAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			IF THISFORM.ccSoldAddr <> 0
			
				THISFORM.ccSoldAddr = 0
				THIS.PARENT.txtSoldCode.VALUE = 0
		
				ThisForm.Address_Screen("ccSoldToSave")
			ENDIF
		
			THIS.PARENT.cmdCCSearchSoldTo.ENABLED = .T.
		
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
		ELSE
			IF THIS.PARENT.cmdCCEditSoldTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
					IF USED( 'aSoldAddr' )
						USE IN aSoldAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.SoldAddr"
					cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(THISFORM.ccSoldAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
					ENDIF
					IF USED( 'aSoldAddr' )
						THISFORM.ccSoldAddr = aSoldAddr.SoldCode
						THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
						THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
						THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
						THIS.PARENT.txtCity.VALUE = aSoldAddr.City
						THIS.PARENT.txtST.VALUE = aSoldAddr.ST
						THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
						THIS.PARENT.txtCountry.VALUE = aSoldAddr.Country
						THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
						THIS.PARENT.txtPhone.VALUE = aSoldAddr.TelePhone
						THIS.PARENT.txtFax.VALUE = aSoldAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
						THIS.PARENT.txtLastEdit.VALUE = PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')
						
						USE IN aSoldAddr
					ENDIF
		
					ThisForm.Address_Screen("ccSoldToEdit")
		
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

