	PROCEDURE frmEdt.pf.pgShipto.cmdSaveShipInfo.Click
		PRIVATE cShipRoute, cInstrct
		cShipRoute	= PrepareSQLtxt(This.Parent.txtShipRoute.Value,"ShipRoute",50)
		cInstrct	= PrepareSQLtxt(This.Parent.txtInstrct.Value,"Instruct",100)
		
		IF !Empty(ThisForm.ShipAddr)
			
			PRIVATE cSQLu, nSQLEXEC 
			cSQLu= "UPDATE dbo.ShipAddr SET "
			cSQLu= cSQLu+" shiproute = '"+cShipRoute+"',"
			cSQLu= cSQLu+" instrct = '"+cInstrct+"'"
			cSQLu= cSQLu+", LastEdit=GetDate() "
			cSQLu= cSQLu+" WHERE shipcode = "+STR(ThisForm.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		ELSE
			messagebox("ShipAddr Code is empty",0,'')
		ENDIF
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdSearchShipTo.Click
		PRIVATE matchCodes, nNewShipToCodem, lcCurrTable
		nNewShipToCode = 0
		matchCodes = 0
		PRIVATE nUseSoldCodes 
		
		lcCurrTable = ALIAS()
		IF NOT USED('SALESQUOTE')
			MESSAGEBOX("'SALESQUOTE' table is not opened.",16,"Error")
			RETURN
		ENDIF
		
		PRIVATE cUseCompany
		cUseCompany = PrepareSQLtxt(SalesQuote.Company,"Company",30)
		
		IF EMPTY(cUseCompany)
			cUseCompany = PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30)
		ELSE
			IF NOT EMPTY( PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30) )
				IF cUseCompany != PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30)
					IF MESSAGEBOX("The Search will be on the Company name Quoted: "+cUseCompany+CHR(13)+"Answer No to use the name: "+PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30),3,"Search for "+cUseCompany  )=7
						cUseCompany = PrepareSQLtxt(This.Parent.txtCompany.Value,"Company",30)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		DO FORM Forms\SearchForm WITH "ShipAddr",cUseCompany,ThisForm.nConnHandle TO nNewShipToCode
		*DO FORM SearchForm WITH "ShipAddr",Quotes.company TO nNewShipToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		ENDIF
		IF nNewShipToCode > 0
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(nNewShipToCode)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
			ENDIF
			IF USED( 'aShipAddr' )
				THISFORM.ShipAddr = aShipAddr.ShipCode
				THIS.PARENT.txtShipCode.VALUE = aShipAddr.ShipCode
				THIS.PARENT.txtCompany.VALUE = aShipAddr.company
				THIS.PARENT.txtAddr1.VALUE = aShipAddr.Addr1
				THIS.PARENT.txtAddr2.VALUE = aShipAddr.Addr2
				THIS.PARENT.txtCity.VALUE = aShipAddr.City
				THIS.PARENT.txtST.VALUE = aShipAddr.ST
				THIS.PARENT.txtZip.VALUE = aShipAddr.Zip
				THIS.PARENT.txtCountry.VALUE = aShipAddr.Country
				THIS.PARENT.txtContact.VALUE = aShipAddr.Contact
				THIS.PARENT.txtPhone.VALUE = aShipAddr.Telephone
				THIS.PARENT.txtFax.VALUE = aShipAddr.Fax_Number
				THIS.PARENT.txtEmail.VALUE = aShipAddr.Email
				This.parent.txtLastEdit.Value = IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
		
				
				IF NOT EMPTY( aShipAddr.shiproute )
					THIS.PARENT.txtShipRoute.VALUE = aShipAddr.shiproute
				ENDIF
				IF NOT EMPTY( aShipAddr.instrct )
					THIS.PARENT.txtInstrct.VALUE = aShipAddr.instrct
				ENDIF
				IF VARTYPE( aShipAddr.Blind )= "L"
					This.Parent.chkBlindSO.Value = IIF(aShipAddr.Blind,1,0)
				ENDIF
				IF NOT EMPTY( aShipAddr.PayType )
					This.Parent.cmbPayment.Value = aShipAddr.PayType
				ENDIF
				IF NOT EMPTY( aShipAddr.ShipPay )
					This.Parent.cmbFrtPayment.Value = aShipAddr.ShipPay
				ENDIF
				
				ThisForm.Address_Screen("ShipToEdit")
				
				*****************
				IF ThisForm.SalesNum > 0
					IF Count_SOinPackingSlip_No( ThisForm.SalesNum, ThisForm.nConnHandle ) > 0
						MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
						"The Packing Slip database will be updated with this new address.",0+48,;
						"A Packing Slip with the old address has allready been Printed!")
						
						Update_ShipCodeinPackingSlip_No( ThisForm.ShipAddr, ThisForm.SalesNum, ThisForm.nConnHandle )
					ENDIF
				ENDIF		
				******************
				
				USE IN aShipAddr
			ENDIF
		
			*Check BillToAddress
			IF EMPTY(This.Parent.Parent.pgBillTo.txtCompany.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtAddr1.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtAddr2.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtCity.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtST.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtZip.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtCountry.Value)
		
				*See if billing address can be filled in.
				IF USED( 'delSoldAddr' )
					USE IN delSoldAddr
				ENDIF
				SELECT 0
		
				cSQL = "SELECT TOP 1 Sold_Ship.SoldCode"
				cSQL = cSQL + " FROM dbo.Sold_Ship, dbo.SoldAddr "
				cSQL = cSQL + " WHERE Sold_Ship.SoldCode = SoldAddr.SoldCode "
				cSQL = cSQL + " AND SoldAddr.InActive = 0 "
				cSQL = cSQL + " AND Sold_Ship.ShipCode = "+STR(nNewShipToCode)
				cSQL = cSQL + " ORDER BY Sold_Ship.SoldCode"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'delSoldAddr')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'delSoldAddr')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'delSoldAddr')
				ENDIF
				IF USED( 'delSoldAddr' )
					IF VARTYPE(	delSoldAddr.SoldCode ) = "N"
					
						WAIT WINDOW "Found 'Bill To' address last used with this 'Sold To' address!" NOWAIT
						nUseSoldCodes = delSoldAddr.SoldCode
						USE IN delSoldAddr
		
						IF USED( 'aSoldAddr' )
							USE IN aSoldAddr
						ENDIF
						SELECT 0
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT * FROM dbo.SoldAddr"
						cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nUseSoldCodes)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
						ENDIF
						IF USED( 'aSoldAddr' )
							THISFORM.SoldAddr = aSoldAddr.SoldCode
							THIS.PARENT.PARENT.pgBillTo.txtSoldCode.VALUE = aSoldAddr.SoldCode
			*				THIS.PARENT.PARENT.pgBillTo.numSoldAddr.VALUE = aSoldAddr
							THIS.PARENT.PARENT.pgBillTo.txtCompany.VALUE = aSoldAddr.Company
							THIS.PARENT.PARENT.pgBillTo.txtAddr1.VALUE = aSoldAddr.Addr1
							THIS.PARENT.PARENT.pgBillTo.txtAddr2.VALUE = aSoldAddr.Addr2
							THIS.PARENT.PARENT.pgBillTo.txtCity.VALUE = aSoldAddr.City
							THIS.PARENT.PARENT.pgBillTo.txtST.VALUE = aSoldAddr.ST
							THIS.PARENT.PARENT.pgBillTo.txtZip.VALUE = aSoldAddr.Zip
							THIS.PARENT.PARENT.pgBillTo.txtCountry.VALUE = aSoldAddr.Country
							THIS.PARENT.PARENT.pgBillTo.txtContact.VALUE = aSoldAddr.Contact
							THIS.PARENT.PARENT.pgBillTo.txtPhone.VALUE = aSoldAddr.TelePhone
							THIS.PARENT.PARENT.pgBillTo.txtFax.VALUE = aSoldAddr.Fax_Number
							THIS.PARENT.PARENT.pgBillTo.txtEmail.VALUE = aSoldAddr.Email
							THIS.PARENT.PARENT.pgBillTo.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
							
							ThisForm.Address_Screen("SoldToEdit")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEdt.pf.pgShipto.cmdShipAddGet.Click
		IF !Empty(ThisForm.ShipAddr)
		
		*	PRIVATE aShipInfo
		
			*SELECT Blind, PayType, ShipPay  FROM shipaddr WHERE shipcode = ThisForm.ShipAddr INTO ARRAY aShipInfo
			IF USED('delShipAddr')
				USE IN delShipAddr
			ENDIF
			SELECT 0
			
			PRIVATE cSQL, nSQLEXEC 
			cSQL= "SELECT Blind, PayType, ShipPay FROM dbo.ShipAddr"
			cSQL= cSQL+" WHERE ShipAddr.shipcode = "+STR(ThisForm.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'delShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'delShipAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'delShipAddr')
			ENDIF
				
		
		
			IF TYPE("delShipAddr.Blind") = "L"
				This.Parent.chkBlindSO.Value = IIF(delShipAddr.Blind, 0,1)
				This.Parent.chkBlindSO.Refresh
			ENDIF
			
			IF TYPE("delShipAddr.PayType") = "C"
				This.Parent.cmbPayment.Value = delShipAddr.PayType
				This.Parent.cmbPayment.Refresh
			ENDIF
		
			IF TYPE("delShipAddr.ShipPay") = "C"
				This.Parent.cmbFrtPayment.Value = delShipAddr.ShipPay
				This.Parent.cmbFrtPayment.Refresh
			ENDIF
			
			IF USED('delShipAddr')
				USE IN delShipAddr
			ENDIF
		ELSE
		
			MESSAGEBOX("ShipAddr code is empty",0,'')
		ENDIF
	ENDPROC

