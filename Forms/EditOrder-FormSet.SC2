			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
			ENDIF
			IF USED( 'SoldAddr' )
		*		THISFORM.ShipAddr = SoldAddr.ShipCode
