	PROCEDURE frmPO.pgfPO.pgPODesc.cmdEditVendors.Click
		PRIVATE m.Company, nVendCode
		nVendCode = PrepareSQLnum(ThisForm.Vendcode,'VendCode',-3)
		m.Company = PrepareSQLtxt(This.Parent.txtCompany.Value,'Company',30)
		Private nTop
		
		IF nVendCode > 0
			nTop = ThisForm.Top  &&2008-08 Operator/operand type mismatch.
			ThisForm.Top = 400
			DO FORM Forms\Vendor11.SCX WITH nVendCode 
			ThisForm.Top = nTop
		ELSE
			IF TYPE("m.Company") = "C"
				nTop = ThisForm.Top
				ThisForm.Top = 400
				IF !EMPTY(m.Company) 
					DO FORM Forms\Vendor11.SCX WITH m.Company
				ELSE
					DO FORM Forms\Vendor11.SCX
				ENDIF
				ThisForm.Top = nTop
			ELSE
				DO FORM Forms\Vendor11.SCX
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.cmdGetPO.Click
		*IF NOT EMPTY( gaPoItems(1,1) )
		PRIVATE nFoundHPAPO
		nFoundHPAPO = 0
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED("tmpPONum")
			USE IN tmpPONum
		ENDIF
		IF NOT EMPTY( SalesQuote.SalesNum )
			SELECT 0
			cSQL = "SELECT DISTINCT HPAPo FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE SalesNum = "+STR(SalesQuote.SalesNum)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPONum' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL, 'tmpPONum' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPONum')
			ENDIF
		ENDIF
		
		PRIVATE nRecords, nCurrRec, cVendor
		IF USED('tmpPONum')
			IF RECCOUNT('tmpPONum') > 0
				IF MESSAGEBOX("Do you wish to continue with a PO allready started?"+CHR(13)+"Answer YES to continue the PO number!"+CHR(13)+"Answer NO to start with a New PO number!",4+48,"Found PO's allready for this Sales Order.")=7 &&No
					*Start new PO
					This.Parent.txtHpapo.Value = GetNextPurchaseOrder(ThisForm.nConnHandle)
					This.parent.txtItempo.Value = 1
					
					This.Parent.txtSalesp.Value = AppSetup_Login_SalesP()
					
					ThisForm.POScreen("ENABLE")
					ThisForm.PO_VALID("NEW")
		
					ThisForm.PONewAdd = .T.
				ELSE	
					*Continue with existing PO
					*make sure Vendor/Vendor Contact are filled the same!	
					SELECT tmpPONum
					nRecords = RECCOUNT('tmpPONum')
					SCAN
						nCurrRec = RECNO('tmpPONum')
						nFoundHPAPO = tmpPONum.HPAPo	
						cVendor = Get_BuyfrominPurchaseOrder(nFoundHPAPO, ThisForm.nConnHandle )		
						IF nCurrRec < nRecords
							IF MESSAGEBOX("This is PO "+ALLTRIM(STR(nCurrRec))+" of "+ALLTRIM(STR(nRecords))+" HPA PO's "+CHR(13)+'Do you want to Add to this PO: '+ALLTRIM(STR(nFoundHPAPO))+" ?"+CHR(13)+"Vendor: "+cVendor,4+48,'Found PO '+ALLTRIM(STR(nFoundHPAPO))) = 6
								*Add item to PO!
								This.Parent.txtItempo.Value = GetNextPurchaseOrderItem(nFoundHPAPO, ThisForm.nConnHandle)
								
								ThisForm.POScreen("ENABLE")
								ThisForm.PO_VALID("NEW")
								
								ThisForm.PONewAdd = .T.
								ThisForm.POEditing = .T.
								
								ThisForm.POsetVendor(nFoundHPAPO)
								
								This.Parent.txtCompany.SetFocus()
								EXIT
							ENDIF
						ELSE
							IF MESSAGEBOX('Are you sure you want to Add another item to this PO: '+ALLTRIM(STR(nFoundHPAPO))+" ?"+CHR(13)+"Vendor: "+cVendor,4+48,'Found PO '+ALLTRIM(STR(nFoundHPAPO))) = 6
								This.Parent.txtItempo.Value = GetNextPurchaseOrderItem(nFoundHPAPO, ThisForm.nConnHandle)
								This.Parent.txtHpapo.Value = nFoundHPAPO
								This.Parent.txtSalesP.VALUE=SalesQuote.SalesP
								This.Parent.txtStockLst_QTY.Value = 0
								*This.Parent.txtStockLst_P.Value = 0
								
								ThisForm.POsetVendor(nFoundHPAPO)
								ThisForm.POScreen("ENABLE")
								ThisForm.PO_VALID("NEWNEXT")
								
								ThisForm.PONewAdd = .T.
								ThisForm.POEditing = .T.
								
								This.Parent.txtCompany.SetFocus()
								EXIT
							ENDIF
						ENDIF
						LOOP
					ENDSCAN
				ENDIF
			ELSE  &&RECCOUNT('tmpPONum') > 0
				This.Parent.txtHpapo.Value = GetNextPurchaseOrder(ThisForm.nConnHandle)
				ThisForm.POScreen("ENABLE")
				ThisForm.PO_VALID("NEW")
				ThisForm.PONewAdd = .T.
			ENDIF
			USE IN tmpPOnum
		ELSE  &&USED('tmpPONum')
			This.Parent.txtHpapo.Value = GetNextPurchaseOrder(ThisForm.nConnHandle)
			ThisForm.POScreen("ENABLE")
			ThisForm.PO_VALID("NEW")
			ThisForm.PONewAdd = .T.
		ENDIF
		
		This.Parent.Parent.pgPOAddress.txtHpapo.Value = This.Parent.txtHpapo.Value
		This.parent.parent.pgPOAddress.txtItempo.Value = This.parent.txtItempo.Value
		*ThisForm.RefreshForms( This.Parent.pgfPO.pgPODesc.cmbForm.Value )
		ThisForm.POEditing = .T.
		ThisForm.RefreshForms( This.Parent.cmbForm.Value )
		
	ENDPROC

