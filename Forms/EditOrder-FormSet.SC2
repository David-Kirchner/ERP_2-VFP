	ENDPROC

	PROCEDURE posetvendor
		PARAMETERS nHPAPO
		*ThisForm.POsetVendor(nFoundHPAPO)
		
		IF USED('tmpPOs')
			USE IN tmpPOs
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT TOP 1 Company,POSalesP,ShipVia,ShipWhere,POShipAddr,VendCode,ContactID FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOs')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOs' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOs' )
		ENDIF
		
		IF USED('tmpPOs')
			
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtCompany.VALUE		= tmpPOs.Company
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtPOSalesName.VALUE	= tmpPOs.POSalesP
			ThisForm.pf.pg_po.pgfPO.pgPODesc.txtShipVia.VALUE		= tmpPOs.ShipVia
		
			ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.VALUE 	= tmpPOs.ShipWhere
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.opgPOShipTo.VALUE 	= tmpPOs.ShipWhere
			IF VARTYPE( tmpPOs.POShipAddr ) = "N"
				THISFORM.POShipAddr = tmpPOs.POShipAddr
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.VALUE	= tmpPOs.POShipAddr
				m.POShipAddr = tmpPOs.POShipAddr
				ThisForm.ShowPOShipAddr( tmpPOs.POShipAddr )
			ELSE
				THISFORM.POShipAddr = 0
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.VALUE	= 0
				m.POShipAddr = 0
				ThisForm.ShowPOShipAddr( 0 )
			ENDIF
			ThisForm.ShowVendCode( tmpPOs.VendCode )
			ThisForm.ShowVendorContact( tmpPOs.ContactID )
			
			USE IN tmpPOs
		ENDIF
		
	ENDPROC

	PROCEDURE poshipto
		PARAMETER nOption
		
		DO CASE
		CASE nOption = 1
			* HPA
			ThisForm.ShowPOShipAddr(1)
			
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		CASE nOption = 2
			*Direct, use same as ShipTO
			IF ThisForm.ShipAddr > 0
				ThisForm.ShowPOShipAddr(ThisForm.ShipAddr)
			ELSE
				**Clear
				*ThisForm.ShipToClear()	
			ENDIF
		
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.	
		CASE nOption = 3
			*Direct, use same as ShipTo
			*Prepare for BLIND statement
			IF ThisForm.POShipAddr > 0
				ThisForm.ShowPOShipAddr(ThisForm.POShipAddr)
			ELSE
				**Clear
				ThisForm.ShipToClear()
			ENDIF
		
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		CASE nOption = 4
			*for Service- Enable Search
			IF ThisForm.POShipAddr > 0
				ThisForm.ShowPOShipAddr(ThisForm.POShipAddr)
			ELSE
				**Clear
				ThisForm.ShipToClear()	
			ENDIF
			
			IF ThisForm.POEditing
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ELSE
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
				ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			ENDIF
		CASE nOption = 5
			* HPA
			ThisForm.ShowPOShipAddr(2)
			
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		ENDCASE
		
		IF USED('ShipAddr')
			USE IN ShipAddr
		ENDIF
		
	ENDPROC

	PROCEDURE potestingscreen
