	PROCEDURE address_screen
		PARAMETER WhereWhat
		*ThisForm.Address_Screen()
		
		DO CASE
			CASE WhereWhat = "OrderToEdit"
				ThisForm.cmdTop.Enabled = .T.
				ThisForm.cmdPrev.Enabled = .T.
				ThisForm.cmdNext.Enabled = .T.
				ThisForm.cmdEdit.Enabled = .T.
				ThisForm.cmdPrintAll.Enabled = .T.
				ThisForm.cmdPrintWO.Enabled = .T.
				THISFORM.cmdPrintWOExt.ENABLED = .T.
				ThisForm.cmdPrintSO.Enabled = .T. 
				ThisForm.cmdFAXConfSO.Enabled = .T.
				ThisForm.cmdProforma.Enabled = .T.
				ThisForm.cmdExit.Enabled = .T.
				
				WITH ThisForm.pf
		*		.pgOrder.Enabled = .T.
				.pgQuote.Enabled = .T.
				.pgValue.Enabled = .T.
				.pgBillTo.Enabled = .T.
				.pgShipto.Enabled = .T.
				.pg_PO.Enabled = .T.
				.pgCreditCard.ENABLED = .T.
				.pgQA.ENABLED = .T.
		
				.pgQuote.cmdPrev.ENABLED = .T.
				.pgQuote.cmdNext.ENABLED = .T.
				.pgQuote.cmdP.ENABLED = .T.
				.pgQuote.cmdN.ENABLED = .T.
				ENDWITH
		
			CASE WhereWhat = "OrderToSave"
				ThisForm.cmdTop.Enabled = .F.
				ThisForm.cmdPrev.Enabled = .F.
				ThisForm.cmdNext.Enabled = .F.
				ThisForm.cmdEdit.Enabled = .F.
				ThisForm.cmdPrintAll.Enabled = .F.
				ThisForm.cmdPrintWO.Enabled = .F.
				THISFORM.cmdPrintWOExt.ENABLED = .F.
				ThisForm.cmdPrintSO.Enabled = .F. 
				ThisForm.cmdFAXConfSO.Enabled = .F.
				ThisForm.cmdProforma.Enabled = .F.
				ThisForm.cmdExit.Enabled = .F.
				
				WITH ThisForm.pf
		*		.pgOrder.Enabled = .F.
				.pgQuote.Enabled = .F.
				.pgValue.Enabled = .F.
				.pgBillTo.Enabled = .F.
				.pgShipto.Enabled = .F.
				.pg_PO.Enabled = .F.
				.pgCreditCard.ENABLED = .F.
				.pgQA.ENABLED = .F.
				
				.pgQuote.cmdPrev.ENABLED = .F.
				.pgQuote.cmdNext.ENABLED = .F.
				.pgQuote.cmdP.ENABLED = .F.
				.pgQuote.cmdN.ENABLED = .F.
				ENDWITH
		******
			CASE WhereWhat = "QuoteToEdit"
				ThisForm.cmdTop.Enabled = .T.
				ThisForm.cmdPrev.Enabled = .T.
				ThisForm.cmdNext.Enabled = .T.
				ThisForm.cmdEdit.Enabled = .T.
				ThisForm.cmdPrintAll.Enabled = .T.
				ThisForm.cmdPrintWO.Enabled = .T.
				THISFORM.cmdPrintWOExt.ENABLED = .T.
				ThisForm.cmdPrintSO.Enabled = .T. 
				ThisForm.cmdFAXConfSO.Enabled = .T.
				ThisForm.cmdProforma.Enabled = .T.
				ThisForm.cmdExit.Enabled = .T.
				
				WITH ThisForm.pf
				.pgOrder.Enabled = .T.
		*		.pgQuote.Enabled = .T.
				.pgValue.Enabled = .T.
				.pgBillTo.Enabled = .T.
				.pgShipto.Enabled = .T.
				.pg_PO.Enabled = .T.
				.pgCreditCard.ENABLED = .T.
				.pgQA.ENABLED = .T.
		
				.pgQuote.cmdPrev.ENABLED = .T.
				.pgQuote.cmdNext.ENABLED = .T.
				.pgQuote.cmdP.ENABLED = .T.
				.pgQuote.cmdN.ENABLED = .T.
				ENDWITH
			CASE WhereWhat = "QuoteToSave"
				ThisForm.cmdTop.Enabled = .F.
				ThisForm.cmdPrev.Enabled = .F.
				ThisForm.cmdNext.Enabled = .F.
				ThisForm.cmdEdit.Enabled = .F.
				ThisForm.cmdPrintAll.Enabled = .F.
				ThisForm.cmdPrintWO.Enabled = .F.
				THISFORM.cmdPrintWOExt.ENABLED = .F.
				ThisForm.cmdPrintSO.Enabled = .F. 
				ThisForm.cmdFAXConfSO.Enabled = .F.
				ThisForm.cmdProforma.Enabled = .F.
				ThisForm.cmdExit.Enabled = .F.
				
				WITH ThisForm.pf
				.pgOrder.Enabled = .F.
		*		.pgQuote.Enabled = .F.
				.pgValue.Enabled = .F.
				.pgBillTo.Enabled = .F.
				.pgShipto.Enabled = .F.
				.pg_PO.Enabled = .F.
				.pgCreditCard.ENABLED = .F.
				.pgQA.ENABLED = .F.
				
				.pgQuote.cmdPrev.ENABLED = .F.
				.pgQuote.cmdNext.ENABLED = .F.
				.pgQuote.cmdP.ENABLED = .F.
				.pgQuote.cmdN.ENABLED = .F.
				ENDWITH
		******
			CASE WhereWhat = "SoldToEdit" &&Caption will say EDIT
				WITH ThisForm.pf.pgBillTo
				.cmdEditSoldTo.Caption = "Edit"
				.txtCompany.Enabled = .F.
				.txtAddr1.Enabled = .F.
				.txtAddr2.Enabled = .F.
				.txtCity.Enabled = .F.
				.txtST.Enabled = .F.
				.txtZip.Enabled = .F.
				.txtCountry.Enabled = .F.
				.txtContact.Enabled = .F.
				.txtPhone.Enabled = .F.
				.txtFax.Enabled = .F.
				.txtEmail.Enabled = .F.
				
				.cmdSearchSoldTo.Enabled = .T.
		
				.lblSaveSoldTo.Caption = ""
				
				.chkQA.Enabled = .T.
				.chkCofC.Enabled = .T.
				.chkMercury.Enabled = .T.
				.chkpPO.Enabled = .T.
				.chkpPN.Enabled = .T.
				.chkpHeat.Enabled = .T.
				.chkpSpec.Enabled = .T.
				.chkpDesc.Enabled = .T.
				.chkpOther.Enabled = .T.
				.txtOther.Enabled = .T.
				
				.ChkEmail.Enabled = .T.
				.ChkFax.Enabled = .T.
				.ChkCancel.Enabled = .T.
				ENDWITH
				
				ThisForm.cmdTop.Enabled = .T.
				ThisForm.cmdPrev.Enabled = .T.
				ThisForm.cmdNext.Enabled = .T.
				ThisForm.cmdEdit.Enabled = .T.
				ThisForm.cmdPrintAll.Enabled = .T.
				ThisForm.cmdPrintWO.Enabled = .T.
				THISFORM.cmdPrintWOExt.ENABLED = .T.
				ThisForm.cmdPrintSO.Enabled = .T.
				ThisForm.cmdFAXConfSO.Enabled = .T.
				ThisForm.cmdProforma.Enabled = .T.
				ThisForm.cmdExit.Enabled = .T.
				
				WITH ThisForm.pf
				.pgOrder.Enabled = .T.
				.pgQuote.Enabled = .T.
				.pgValue.Enabled = .T.
				.pgShipto.Enabled = .T.
				.pg_po.Enabled = .T.
				.pgCreditCard.ENABLED = .T.
				.pgQA.ENABLED = .T.
				
				.pgBillTo.txtSoldCode.Refresh
		*		.pgBillTo.numSoldAddr.Refresh
				ENDWITH
			CASE WhereWhat = "SoldToSave"
				WITH ThisForm.pf.pgBillTo
				.cmdEditSoldTo.Caption = "Save"
				.txtCompany.Enabled = .T.
				.txtAddr1.Enabled = .T.
				.txtAddr2.Enabled = .T.
				.txtCity.Enabled = .T.
				.txtST.Enabled = .T.
				.txtZip.Enabled = .T.
				.txtCountry.Enabled = .T.
				.txtContact.Enabled = .T.
				.txtPhone.Enabled = .T.
				.txtFax.Enabled = .T.
				.txtEmail.Enabled = .T.
				
				.cmdSearchSoldTo.Enabled = .F.
		
				.lblSaveSoldTo.Caption = "Save or Clear to Continue."
				
				.chkQA.Enabled = .F.
				.chkCofC.Enabled = .F.
				.chkMercury.Enabled = .F.
				.chkpPO.Enabled = .F.
				.chkpPN.Enabled = .F.
				.chkpHeat.Enabled = .F.
				.chkpSpec.Enabled = .F.
				.chkpDesc.Enabled = .F.
				.chkpOther.Enabled = .F.
				.txtOther.Enabled = .F.
				
				.ChkEmail.Enabled = .F.
				.ChkFax.Enabled = .F.
				.ChkCancel.Enabled = .F.
				ENDWITH
				
				ThisForm.cmdTop.Enabled = .F.
				ThisForm.cmdPrev.Enabled = .F.
				ThisForm.cmdNext.Enabled = .F.
				ThisForm.cmdEdit.Enabled = .F.
				ThisForm.cmdPrintAll.Enabled = .F.
				ThisForm.cmdPrintWO.Enabled = .F.
				THISFORM.cmdPrintWOExt.ENABLED = .F.
				ThisForm.cmdPrintSO.Enabled = .F.
				ThisForm.cmdFAXConfSO.Enabled = .F.
				ThisForm.cmdProforma.Enabled = .F.
				ThisForm.cmdExit.Enabled = .F.
				
				WITH ThisForm.pf
				.pgOrder.Enabled = .F.
				.pgQuote.Enabled = .F.
				.pgValue.Enabled = .F.
				.pgShipto.Enabled = .F.
				.pg_PO.Enabled = .F.
				.pgCreditCard.ENABLED = .F.
				.pgQA.ENABLED = .F.
				ENDWITH
				IF EMPTY(ThisForm.pf.pgBillTo.txtCompany.Value)
					ThisForm.pf.pgBillTo.txtCompany.Value = SalesQuote.Company
				ENDIF
		
			CASE WhereWhat = "ShipToEdit"
				WITH ThisForm.pf.pgShipTo
				.cmdEditShipTo.Caption = "Edit"
				.txtCompany.Enabled = .F.
				.txtAddr1.Enabled = .F.
				.txtAddr2.Enabled = .F.
				.txtCity.Enabled = .F.
				.txtST.Enabled = .F.
				.txtZip.Enabled = .F.
				.txtCountry.Enabled = .F.
				.txtContact.Enabled = .F.
				.txtPhone.Enabled = .F.
				.txtFax.Enabled = .F.
				.txtEmail.Enabled = .F.
				
				.cmdSearchShipTo.Enabled = .T.
				.cmdCopyto.Enabled = .T.  &&Maybee not
				.lblSaveShipTo.Caption = ""
				
				.chkBlindSO.Enabled = .T.
				.chkReceivedPO.Enabled = .T.
				.cmbPayment.Enabled = .T.
				.cmdCustomerTerms.Enabled = .T.
				.cmbFrtPayment.Enabled = .T.
				.txtShipRoute.Enabled = .T.
				.txtFreightEst.Enabled = .T.
				.txtAddr_ref.Enabled = .T.
				.txtInstrct.Enabled = .T.
				.cmdSaveShipInfo.Enabled = .T.
				.cmdGetShipInfo.Enabled = .T.
				.cmdRemoveShipInfo.Enabled = .T.
				.cmbTarfBill.Enabled = .T.
				.chkUSA.Enabled = .T.
				ENDWITH
				
				ThisForm.cmdTop.Enabled = .T.
				ThisForm.cmdPrev.Enabled = .T.
				ThisForm.cmdNext.Enabled = .T.
				ThisForm.cmdEdit.Enabled = .T.
				ThisForm.cmdPrintAll.Enabled = .T.
				ThisForm.cmdPrintWO.Enabled = .T.
				THISFORM.cmdPrintWOExt.ENABLED = .t.
				ThisForm.cmdPrintSO.Enabled = .T. 
				ThisForm.cmdFAXConfSO.Enabled = .T.
				ThisForm.cmdProforma.Enabled = .T.
				ThisForm.cmdExit.Enabled = .T.
				
				WITH ThisForm.pf
				.pgOrder.Enabled = .T.
				.pgQuote.Enabled = .T.
				.pgValue.Enabled = .T.
				.pgBillTo.Enabled = .T.
				.pg_PO.Enabled = .T.
				.pgCreditCard.ENABLED = .T.
				.pgQA.ENABLED = .T.
				ENDWITH
				
				ThisForm.pf.pgShipto.txtShipCode.Refresh
		*		ThisForm.pf.pgShipto.numShipAddr.Refresh
				
				PRIVATE cShipToCountry
				cShipToCountry = ThisForm.pf.pgShipTo.txtCountry.Value
				IF ( EMPTY(cShipToCountry) OR cShipToCountry = "USA" OR cShipToCountry = "US " ) AND ThisForm.pf.pgShipto.chkUSA.Value = 0
					ThisForm.pf.pgShipto.chkUSA.Value = 1
					IF !EMPTY(ThisForm.pf.pgShipto.cmbTarfBill.Value) AND ThisForm.pf.pgShipto.cmbTarfBill.Value != "RECEPIENT"
						MESSAGEBOX( "Please Enter a ShipTo Country before using the "+CHR(13)+"'Foreign Duty billed to' tariff bill setting.",0,"No country, marked as USA!" )
					ENDIF
				ENDIF
			CASE WhereWhat = "ShipToSave"
				WITH ThisForm.pf
				.pgShipTo.cmdEditShipTo.Caption = "Save"
				.pgShipTo.txtCompany.Enabled = .T.
				.pgShipTo.txtAddr1.Enabled = .T.
				.pgShipTo.txtAddr2.Enabled = .T.
				.pgShipTo.txtCity.Enabled = .T.
				.pgShipTo.txtST.Enabled = .T.
				.pgShipTo.txtZip.Enabled = .T.
				.pgShipTo.txtCountry.Enabled = .T.
				.pgShipTo.txtContact.Enabled = .T.
				.pgShipTo.txtPhone.Enabled = .T.
				.pgShipTo.txtFax.Enabled = .T.
				.pgShipTo.txtEmail.Enabled = .T.
				
				.pgShipTo.cmdSearchShipTo.Enabled = .F.
				.pgShipto.cmdCopyto.Enabled = .F.
				.pgShipto.lblSaveShipTo.Caption = "Save or Clear to Continue."
				
				.pgShipto.chkBlindSO.Enabled = .F.
				.pgShipto.chkReceivedPO.Enabled = .F.
				.pgShipto.cmbPayment.Enabled = .F.
				.pgShipto.cmdCustomerTerms.Enabled = .F.
				.pgShipto.cmbFrtPayment.Enabled = .F.
