	PROCEDURE showvendcode
		PARAMETER pnVendCode
		*ThisForm.ShowVendCode()
		
		IF VARTYPE(pnVendCode) != 'N'
			ThisForm.VendCodeClear()
			RETURN .F.
		ENDIF
		
		WAIT WINDOW "ShowVendCode" NOWAIT
		
		PRIVATE nVendCode, lBlank
		lBlank = .F.
		nVendCode = pnVendCode 
		
		
		IF NOT EMPTY(nVendCode)
			IF TYPE("nVendCode") = "N"
				IF nVendCode > 0
					*Get Address and Show
		
					IF USED( 'Vendor' )
						USE IN Vendor
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.Vendor "
					cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Vendor')
					ENDIF
					IF USED('Vendor')
						ThisForm.VendCode 	= Vendor.VendCode	
		*				ThisForm.nContactID = 0 && reset!
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtVendCode.VALUE	= Vendor.VendCode 
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtCompany.VALUE 	= Vendor.Company
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtAddr1.VALUE 	= Vendor.Addr1
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtAddr2.VALUE 	= Vendor.Addr2
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtCity.VALUE		= Vendor.City
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtST.VALUE 		= Vendor.ST
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtZip.VALUE 		= Vendor.Zip
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtCountry.VALUE 	= Vendor.Country
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtLastEdit.VALUE	= PrepareSQLdate(Vendor.LastEdit,'LastEdit')
						ThisForm.pf.pg_po.pgfPO.pgVendor.QAApproved1.Value	= PrepareSQLchk(Vendor.QAApproved,'QAApproved')
						ThisForm.pf.pg_po.pgfPO.pgVendor.Metal1.Value 		= PrepareSQLchk(Vendor.Metal,'Metal')
						ThisForm.pf.pg_po.pgfPO.pgVendor.Inactive1.Value 	= PrepareSQLchk(Vendor.Inactive,'Inactive')
						ThisForm.pf.pg_po.pgfPO.pgVendor.txtPeachID.Value 	= PrepareSQLtxt(Vendor.PeachID,'PeachID',20)
		*				ThisForm.pf.pg_po.pgfPO.pgVendor.chkVendorPOConf	= PrepareSQLchk(PurchaseOrder.VendorPOConf,'VedorPOConf')
						ThisForm.pf.pg_po.pgfPO.pgVendor.chkVendorPOConf.Value	= PrepareSQLchk(VendorPOConf_POitem(ThisForm.POitem,ThisForm.nConnHandle),'VedorPOConf')
						ThisForm.pf.pg_po.pgfPO.pgVendor.Vend_Notes.Value	= PrepareSQLtxt(Vendor.Vend_Notes,'Vend_Notes',-1)
						ThisForm.pf.pg_po.pgfPO.pgVendor.Vend_Print.Value	= PrepareSQLtxt(Vendor.Vend_Print,'Vend_Print',-1)
						
						ThisForm.pf.pg_po.pgfPO.pgPODesc.lblVendCode.Caption	= STR(Vendor.VendCode)
						ThisForm.pf.pg_po.pgfPO.pgPODesc.lblPeachID.Caption		= PrepareSQLtxt(Vendor.PeachID,'PeachID',20)
						ThisForm.pf.pg_po.pgfPO.pgPODesc.txtCompany.Value		= Vendor.Company
						
		*				USE IN Vendor
					ENDIF
				ELSE
					lBlank = .T.
				ENDIF
			ELSE
				lBlank = .T.
			ENDIF
		ELSE
			lBlank = .T.
		ENDIF
		
		***********************
		IF lBlank
			*Show blanks
		
			Thisform.VendCode = 0
			ThisForm.nContactID	= 0
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtVendCode.VALUE	= 0
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtCompany.VALUE 	= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtAddr1.VALUE 	= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtAddr2.VALUE 	= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtCity.VALUE 		= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtST.VALUE 		= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtZip.VALUE 		= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtCountry.VALUE 	= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtLastEdit.VALUE	=  CtoD("  /  /  ")
			ThisForm.pf.pg_po.pgfPO.pgVendor.QAApproved1.Value 	= 0
			ThisForm.pf.pg_po.pgfPO.pgVendor.Metal1.Value 		= 0
			ThisForm.pf.pg_po.pgfPO.pgVendor.Inactive1.Value 	= 0
			ThisForm.pf.pg_po.pgfPO.pgVendor.txtPeachID.Value 	= 0
			ThisForm.pf.pg_po.pgfPO.pgVendor.chkVendorPOConf.Value = 0
			ThisForm.pf.pg_po.pgfPO.pgVendor.Vend_Notes.Value	= ''
			ThisForm.pf.pg_po.pgfPO.pgVendor.Vend_Print.Value	= ''
		
			ThisForm.pf.pg_po.pgfPO.pgVendor.cmdPOSearchBuyFrom.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgVendor.cmdEditAddr.Enabled = .F.
			ThisForm.pf.pg_po.pgfPO.pgVendor.cmdClearShip.Enabled = .F.
		
			ThisForm.pf.pg_po.pgfPO.pgPODesc.lblVendCode.Caption	= ''
			ThisForm.pf.pg_po.pgfPO.pgPODesc.lblPeachID.Caption		= ''
		ELSE
			ThisForm.pf.pg_po.pgfPO.pgVendor.cmdPOSearchBuyFrom.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgVendor.cmdEditAddr.Enabled = .T.
			ThisForm.pf.pg_po.pgfPO.pgVendor.cmdClearShip.Enabled = .T.
			
		ENDIF
		
		***********************
		IF USED('VendorContacts')
			USE IN VendorContacts
		ENDIF
		
		SELECT 0
		cSQL = "SELECT * FROM dbo.VendorContact "
		cSQL = cSQL + " WHERE VendCode = "+STR(ThisForm.VendCode)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'VendorContacts')
		ENDIF
		IF USED('VendorContacts')
			INDEX ON ContactID TAG ContactID
			SET ORDER TO TAG ContactID
		ENDIF
		
		
	ENDPROC

	PROCEDURE showvendorcontact
		PARAMETERS nContactID
		
		*ThisForm.ShowVendorContact(VendorContacts.ContactID)
		
		IF VARTYPE(nContactID)!="N"
			MESSAGEBOX("ThisForm.ShowVendorContact(VendorContacts.ContactID)",16,"Error")
			RETURN
		ENDIF
		
		*********************************
		IF nContactID = 0
			
			PRIVATE nVendCode
			nVendCode = PrepareSQLnum(ThisForm.VendCode,'VendCode',-3)
			
			IF USED('tVendorContact')	
				USE IN tVendorContact
			ENDIF
			SELECT 0
			
			PRIVATE cContact
			cContact = VendorContact_ContactID(nContactID,ThisForm.nConnHandle)
			
			cSQL = "SELECT TOP 1 ContactID FROM dbo.VendorContact WHERE Contact LIKE '%"+ALLTRIM(cContact)+"%'"
			cSQL = cSQL + " AND VendCode = "+ALLTRIM(STR(nVendCode))
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tVendorContact' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tVendorContact' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tVendorContact' )
				lSaveOK = .F.
			ENDIF
		
			IF USED('tVendorContact')
				IF VARTYPE(tVendorContact.ContactID) = "N"
					nContactID = tVendorContact.ContactID
				ENDIF
						
				USE IN tVendorContact
			
			ENDIF
		ENDIF	
		*********************************	
		
		SELECT VendorContacts
		SEEK nContactID
		
		IF FOUND()
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.nContactID.Value	= PrepareSQLnum(VendorContacts.ContactID,'ContactID',-3)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cContact.Value		= PrepareSQLtxt(VendorContacts.Contact,'Contact',30)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cPhone.Value		= PrepareSQLtxt(VendorContacts.Phone,'Phone',20)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCellPhone.Value	= PrepareSQLtxt(VendorContacts.CellPhone,'CellPhone',20)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cFax.Value			= PrepareSQLtxt(VendorContacts.Fax,'Fax',20)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cEmail.Value		= PrepareSQLtxt(VendorContacts.Email,'Email',60)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cAddr1.Value		= PrepareSQLtxt(VendorContacts.Addr1,'Addr1',30)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cAddr2.Value		= PrepareSQLtxt(VendorContacts.Addr2,'Addr2',30)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCity.Value			= PrepareSQLtxt(VendorContacts.City,'City',20)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cST.Value			= PrepareSQLtxt(VendorContacts.ST,'ST',2)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cZip.Value			= PrepareSQLtxt(VendorContacts.Zip,'Zip',12)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCountry.Value		= PrepareSQLtxt(VendorContacts.Country,'Country',15)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.chkQuality.Value	= PrepareSQLchk(VendorContacts.Quality,'Quality')
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.dLastSurveySent.Value	= PrepareSQLdate(VendorContacts.LastSurveySent,'LastSurveySent')
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.dLastSurveyReceived.Value	= PrepareSQLdate(VendorContacts.LastSurveyReceived,'LastSurveyReceived')
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cJobTitle.Value		= PrepareSQLtxt(VendorContacts.JobTitle,'JobTitle',50)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.nSurveyPriority.Value	= PrepareSQLnum(VendorContacts.SurveyPriority,'SurveyPriority',-3)
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.chkVCinactive.Value = PrepareSQLchk(VendorContacts.Inactive,'Inactive')
		
			
			PRIVATE nHPAPO
			nHPAPO 	= PrepareSQLnum(THISFORM.pf.pg_po.pgFPO.pgPOdesc.txtHpaPo.VALUE,'HPAPO',-3)
			IF VendorContactID_PO(nContactID,nHPAPO,ThisForm.nConnHandle)
		*		ThisForm.pf.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .F.
				ThisForm.pf.pg_po.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
			ELSE
		*		ThisForm.pf.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .T.
				ThisForm.pf.pg_po.pgfPO.pgVendorContact.lblSaveContact.Visible = .T.
			ENDIF
		ELSE
			*Not Found!
		
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.nContactId.Value = 0
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cContact.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cPhone.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCellPhone.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cFax.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cEmail.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cAddr1.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cAddr2.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCity.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cST.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cZip.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cCountry.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.chkQuality.Value = 0
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.dLastSurveySent.Value = CTOD("  /  /  ")
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.dLastSurveyReceived.Value = CTOD("  /  /  ")
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.cJobTitle.Value = ''
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.nSurveyPriority.Value = 0
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.chkVCinactive.Value = 0
		
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
			
		ENDIF
		
		ThisForm.nContactID = nContactID
		
		PRIVATE nHPAPO
		
		nHPAPO 	= PrepareSQLnum(ThisForm.pf.pg_po.pgfPO.pgPODesc.txtHpapo.VALUE,'HPAPO',-3)
		IF nHPAPO > 0
			IF VendorContactID_PO(nContactID,nHPAPO,ThisForm.nConnHandle)
				ThisForm.pf.pg_po.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
		*		ThisForm.pf.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .F.
			ELSE
				ThisForm.pf.pg_po.pgfPO.pgVendorContact.lblSaveContact.Visible = .T.
		*		ThisForm.pf.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .T.
			ENDIF
		ELSE
			ThisForm.pf.pg_po.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
		*	ThisForm.pf.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE show_po
		*ThisForm.Show_PO()
		
		PRIVATE nCntPOitem 
		nCntPOitem = 0
		
		IF ThisForm.PONewAdd OR ThisForm.POEditing 
			RETURN .F.
		ENDIF
		
		IF THISFORM.pf.pg_po.cmdPOEdit.CAPTION = "Edit PO" OR ThisForm.NewPage
			ThisForm.NewPage = .F.
			IF TYPE("SalesQuote.SoItem_A") = "C" AND NOT EMPTY(SalesQuote.SoItem_A)
				
				DIMENSION gaPoItems(1)
				gaPoItems(1) = ""
		
				WAIT WINDOW 'SELECT POitem' NOWAIT
		
				IF USED("tmpPOitem")
					USE IN tmpPOitem
				ENDIF
				
				SELECT 0
				cSQL = "SELECT PoItem FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+SalesQuote.SoItem_A+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitem' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL, 'tmpPOitem' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOitem')
				ENDIF
				
				IF USED('tmpPOitem')
					SELECT * FROM tmpPOitem INTO ARRAY gaPoItems
					USE IN tmpPOitem
				ENDIF
				
				IF NOT EMPTY(gaPoItems(1))
					*Have good PO item, get Data
					*PoItem = STR(PONum,10)+"-"+STR(Item,2)			
		
					WAIT WINDOW 'SELECT * FROM dbo.PurchaseOrder' NOWAIT
		
					IF USED('tmpPoItemDetail')
						USE IN tmpPoItemDetail
					ENDIF
					
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE POitem = dbo.ProperPO('"+gaPoItems(1)+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPoItemDetail')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPoItemDetail' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPoItemDetail' )
					ENDIF
					
					IF USED('tmpPoItemDetail')
						IF VARTYPE(tmpPoItemDetail.POitem) = "C"
							nCntPOitem = 1
						ENDIF
					*	USE IN tmpPOp
					ENDIF
						
					IF nCntPOitem > 0					
		
						SELECT tmpPoItemDetail
						SCATTER MEMVAR MEMO
						
						*Get rid of nulls when editing old PO's
						ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStockLst_QTY.Value = PrepareSQLnum(tmpPoItemDetail.StockLst_QTY,'StockLst_QTY',-5)
						ThisForm.pf.pg_po.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(tmpPoItemDetail.StockLst_P,'StockLst_P',-5)
						
						*Strip Time from Date
						m.OrderDate	= PrepareSQLdate(m.OrderDate,'OrderDate')
						m.Due_Min	= PrepareSQLdate(m.Due_Min,'Due_Min')
						m.Due_Max	= PrepareSQLdate(m.Due_Max,'Due_Max')
						m.HPA_Due_Min	= PrepareSQLdate(m.HPA_Due_Min,'HPA_Due_Min')
						m.HPA_Due_Max	= PrepareSQLdate(m.HPA_Due_Max,'HPA_Due_Max')
						
						ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Value = tmpPoItemDetail.ShipWhere
						
						ThisForm.POitem		= m.POitem
						ThisForm.POShipAddr = m.POShipAddr
						m.SalesP = tmpPoItemDetail.SalesP
						
						IF tmpPoItemDetail.Cancelled
							ThisForm.pf.pg_po.chkCancelPO.Value = 1
							ThisForm.pf.pg_po.chkCancelPO.Enabled = .F.
						ELSE
							ThisForm.pf.pg_po.chkCancelPO.Value = 0
							ThisForm.pf.pg_po.chkCancelPO.Enabled = .T.
						ENDIF
						ThisForm.pf.pg_po.chkDeliveredPO.Value = IIF(tmpPoItemDetail.Delivered, 1,0)
						
						PRIVATE nVendCode
						nVendCode = PrepareSQLnum(tmpPoItemDetail.VendCode,'VendCode',-3)
						IF nVendCode > 0
		*						ThisForm.pf.pg_po.pgfPO.pgPODesc.chkVendor.VALUE		= .T.
							ThisForm.VendCode = nVendCode
							ThisForm.nContactID = tmpPoItemDetail.ContactID
							ThisForm.pf.pg_po.pgfPO.pgPODesc.lblVendCode.Caption	= STR(nVendCode)
							ThisForm.pf.pg_po.pgfPO.pgPODesc.lblPeachID.Caption		= getPeachID_VendCode(nVendCode)
						ELSE
							ThisForm.pf.pg_po.pgfPO.pgPODesc.lblVendCode.Caption	= ''
							ThisForm.pf.pg_po.pgfPO.pgPODesc.lblPeachID.Caption	= ''
							ThisForm.VendCode = 0
							ThisForm.nContactID = 0
						ENDIF
						
						ThisForm.POShipAddr = tmpPoItemDetail.POShipAddr
						THISFORM.pf.pg_po.cmdPOEdit.CAPTION = "Edit PO"
						*Check lstPoItems.Click
						ThisForm.pf.pg_po.cmdPrintPO.Enabled = .T.
						ThisForm.pf.pg_po.cmdPOEdit.Enabled = .T.
						ThisForm.pf.pg_po.cmdPODelete.Enabled = .T.
					ELSE
						*INIT Blank
						SELECT tmpPoItemDetail
						SCATTER MEMVAR MEMO BLANK
						*Strip Time from Date
						m.OrderDate	= PrepareSQLdate(m.OrderDate,'OrderDate')
						m.Due_Min	= PrepareSQLdate(m.Due_Min,'Due_Min')
						m.Due_Max	= PrepareSQLdate(m.Due_Max,'Due_Max')
						m.HPA_Due_Min	= PrepareSQLdate(m.HPA_Due_Min,'HPA_Due_Min')
						m.HPA_Due_Max	= PrepareSQLdate(m.HPA_Due_Max,'HPA_Due_Max')
						
						ThisForm.POitem		= ''
						ThisForm.POShipAddr = 1
						ThisForm.pf.pg_Po.Refresh()
						ThisForm.pf.pg_po.pgFPO.pgPOdesc.Refresh()
						ThisForm.pf.pg_po.pgFPO.pgAddress.Refresh()
						
						*Check lstPoItems.Click
						m.POSalesName = ""
						ThisForm.pf.pg_po.chkCancelPO.Value = 0
						ThisForm.pf.pg_po.chkCancelPO.Enabled = .T.
						ThisForm.pf.pg_po.chkDeliveredPO.Value = 0
						ThisForm.pf.pg_po.cmdPrintPO.Enabled = .F.
						ThisForm.pf.pg_po.cmdPOEdit.Enabled = .F.
						ThisForm.pf.pg_po.cmdPODelete.Enabled = .F.
						ThisForm.POShipAddr = 1
						
						ThisForm.VendCode = 0
						ThisForm.nContactID = 0
					ENDIF
					IF USED('tmpPoItemDetail')
						USE IN tmpPoItemDetail
					ENDIF
				ELSE  &&NOT EMPTY(gaPoItems(1))
				
					WAIT WINDOW 'SELECT TOP 1 * FROM PurchaseOrder' NOWAIT
					IF USED('tmpPoItemDetail')
						USE IN tmpPoItemDetail
					ENDIF
					
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT TOP 1 * FROM dbo.PurchaseOrder "
					cSQL = cSQL + " ORDER BY PoItem "  &&DESC
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPoItemDetail')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPoItemDetail' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPoItemDetail' )
					ENDIF
					
					IF USED('tmpPoItemDetail')
						SELECT tmpPoItemDetail
					ENDIF
					SCATTER MEMVAR MEMO BLANK
					*Strip Time from Date
					m.OrderDate	= PrepareSQLdate(m.OrderDate,'OrderDate')
					m.Due_Min	= PrepareSQLdate(m.Due_Min,'Due_Min')
					m.Due_Max	= PrepareSQLdate(m.Due_Max,'Due_Max')
					m.HPA_Due_Min	= PrepareSQLdate(m.HPA_Due_Min,'HPA_Due_Min')
					m.HPA_Due_Max	= PrepareSQLdate(m.HPA_Due_Max,'HPA_Due_Max')
					
					*Check lstPoItems.Click
					m.POSalesName  = ""
					ThisForm.pf.pg_po.chkCancelPO.Value = 0
					ThisForm.pf.pg_po.chkCancelPO.Enabled = .T.
					ThisForm.pf.pg_po.chkDeliveredPO.Value = 0
					ThisForm.pf.pg_po.cmdPrintPO.Enabled = .F.
					ThisForm.pf.pg_po.cmdPOEdit.Enabled = .F.
					ThisForm.pf.pg_po.cmdPODelete.Enabled = .F.
					ThisForm.POShipAddr = 1
					
					ThisForm.VendCode = 0
					ThisForm.nContactID = 0
				ENDIF
				ThisForm.pf.pg_po.chkCancelPO.Enabled = .T.
				
			ELSE
				*NONE!
				ThisForm.POitem		= ''	
				ThisForm.POShipAddr = 1
				ThisForm.pf.pg_po.cmdPOEdit.Enabled = .F.
				ThisForm.pf.pg_po.cmdPODelete.Enabled = .F.
				ThisForm.pf.pg_po.chkCancelPO.Enabled = .F.
				DIMENSION gaPoItems(1)
				gaPoItems(1)=""
				
				ThisForm.VendCode = 0
				ThisForm.nContactID = 0
			ENDIF
		
			ThisForm.pf.pg_po.lstPoItems.NumberOfElements = ALEN(gaPoItems,1)
			ThisForm.pf.pg_po.lstPoItems.REFRESH
			
			ThisForm.pf.pg_po.REFRESH
			ThisForm.pf.pg_po.lstPoItems.SETFOCUS
		ENDIF
		
		IF USED("tmpPoItemDetail")
			USE IN tmpPoItemDetail
		ENDIF
		IF USED("tmpPOitem")
			USE IN tmpPOitem
		ENDIF
		
		ThisForm.RefreshForms( ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbForm.Value )
		
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.opgPOShipTo.Refresh
		IF ThisForm.pf.pg_po.pgfPO.pgPOAddress.opgPOShipTo.Value > 1
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Visible = .T.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Visible = .T.
		ELSE
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Visible = .F.
			ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Visible = .F.
		ENDIF
		
		
		WITH ThisForm.pf.pg_po.pgfPO.pgPODesc
			.txtSalesp.Refresh
			.txtHpaPO.Refresh
			.txtItemPO.Refresh
			.txtCompany.Refresh
		*		.chkVendor.Refresh
			.txtPieces.Refresh
			.txtAlloy.Refresh
			.cmbForm.Refresh
			.cmbCC.Refresh
			.txtThck.Refresh
			.txtSz2.Refresh
			.txtSz3.Refresh
			.chkRandLen.Refresh
			.chkMetric.Refresh
		*		.chkVendor.Refresh
			.txtStockLst_QTY.Refresh
			.txtStockLst_P.Refresh
			.txtCond_Spec.Refresh
			.txtMisc_Purch.Refresh
			.txtP_Lb.Refresh
			.txtP_Pc.Refresh
			.txtP_Ft.Refresh
			.txtLotP.Refresh
			.txtOtherP.Refresh
			.txtOtherFld.Refresh
			.txtOrder_Qty.Refresh
			.cmbStock.Refresh
			.cmbShipWhere.Refresh
			.txtDispAlloy.Refresh
			.txtStandSize.Refresh
			.chkSPS1.Refresh
			.chkServicesPO.Refresh
			.chkConvServ.Refresh
			.txtOrderDate.Refresh
			.txtDue_Min.Refresh
			.txtDue_Max.Refresh
			.txtHPA_Due_Min.Refresh
			.txtHPA_Due_Max.Refresh
			.txtPOSalesName.Refresh
			.txtJobNumber.Refresh
			.txtShipVia.Refresh
		ENDWITH
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.opgPOShipTo.Refresh
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtReceipt.Refresh
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtTerms.Refresh
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtFOB.Refresh
		
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtHpapo.Value = ThisForm.pf.pg_po.pgfPO.pgPOdesc.txtHpapo.Value
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtItemPo.Value = ThisForm.pf.pg_po.pgfPO.pgPOdesc.txtItemPo.Value
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtHpapo.Refresh
		ThisForm.pf.pg_po.pgfPO.pgPOAddress.txtItemPo.Refresh
		
		ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Refresh
		ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Refresh
		ThisForm.pf.pg_po.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Refresh
		
		*	ThisForm.ShowPOShipAddr( ThisForm.POShipAddr )
		**Show PO Ship Addr
		
		IF USED( 'aShipAddr' )
			USE IN aShipAddr
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE ShipCode = "+STR(ThisForm.POShipAddr)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
		ENDIF
		IF USED('aShipAddr')
			*thisform.POShipAddr = aShipAddr.ShipCode	
			
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtPOShipAddr.VALUE = aShipAddr.ShipCode
			*ThisForm.pf.pg_po.pgfPO.pgPOAddress.numShipAddr.Value 	= aShipAddr.ShipCode
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCompany.VALUE 	= aShipAddr.Company
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtAddr1.VALUE 		= aShipAddr.Addr1
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtAddr2.VALUE 		= aShipAddr.Addr2
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCity.VALUE 		= aShipAddr.City
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtST.VALUE 		= aShipAddr.ST
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtZip.VALUE 		= aShipAddr.Zip
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtCountry.VALUE 	= aShipAddr.Country
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtContact.VALUE 	= aShipAddr.Contact
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtPhone.VALUE 		= aShipAddr.Telephone
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtFax.VALUE 		= aShipAddr.Fax_Number
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtEmail.VALUE 		= aShipAddr.Email
			THISFORM.pf.pg_po.pgfPO.pgPOAddress.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
			
			*ThisForm.ShipWhereChange(aShipAddr.ShipCode,aShipAddr.Company,aShipAddr.City)
			
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
		ENDIF
		
		*************
		ThisForm.ShowVendCode( ThisForm.VendCode )
		*************
		ThisForm.GetVendorContacts( ThisForm.nContactID )
		*************
		*ThisForm.ShowVendorContact( ThisForm.nContactID )
		*************
		
		WAIT CLEAR
	ENDPROC

	PROCEDURE show_qa
		WAIT WINDOW "Show_QA()" NOWAIT
		*ThisForm.Show_QA()
		
		IF USED('tmpSales_No_Rev')
			ThisForm.pf.pgQA.grdAmend.RecordSource = ""
			USE IN tmpSales_No_Rev
		ENDIF
		
		SELECT 0
		cSQL = "SELECT [ID],[SalesNum],[WHEN],[Ver],[Comment] "
		cSQL = cSQL + " FROM dbo.Sales_No_Rev "
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisForm.SalesNum))
		cSQL = cSQL + " ORDER BY [WHEN] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_No_Rev")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_No_Rev')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_No_Rev')
		ENDIF
		
		PRIVATE lShowRev
		lShowRev = .T.
		
		IF USED('tmpSales_No_Rev')
			IF RECCOUNT('tmpSales_No_Rev') > 0
				ThisForm.pf.pgQA.grdAmend.RecordSource = "tmpSales_No_Rev"
				ThisForm.pf.pgQA.grdAmend.AfterRowColChange
			ELSE
				lShowRev = .F.
			ENDIF
		ELSE
			lShowRev = .F.
		ENDIF
		
		IF lShowRev
			ThisForm.pf.pgQA.grdAmend.Visible = .T.
			ThisForm.pf.pgQA.lblVer.Visible = .T.
			ThisForm.pf.pgQA.lblVerDate.Visible = .T.
			ThisForm.pf.pgQA.txtVer.Visible = .T.
			ThisForm.pf.pgQA.txtVerDate.Visible = .T.
			
			ThisForm.pf.pgQA.cmdAdd.Visible = .T.
			ThisForm.pf.pgQA.cmdEdit.Visible = .T.
			ThisForm.pf.pgQA.cmdCancelEdit.Visible = .F.
			ThisForm.pf.pgQA.cmdAmendmentsPrint.Visible = .T.
			
			ThisForm.Sales_No_RevID = tmpSales_No_Rev.ID
		ELSE
			ThisForm.pf.pgQA.grdAmend.Visible = .F.
			ThisForm.pf.pgQA.lblVer.Visible = .F.
			ThisForm.pf.pgQA.lblVerDate.Visible = .F.
			ThisForm.pf.pgQA.txtVer.Visible = .F.
			ThisForm.pf.pgQA.txtVerDate.Visible = .F.
		
			ThisForm.pf.pgQA.cmdAdd.Visible = .T.
			ThisForm.pf.pgQA.cmdEdit.Visible = .F.
			ThisForm.pf.pgQA.cmdCancelEdit.Visible = .F.
			ThisForm.pf.pgQA.cmdAmendmentsPrint.Visible = .F.
			
			ThisForm.Sales_No_RevID = 0
		ENDIF
		
		
		WAIT CLEAR
	ENDPROC

	PROCEDURE stocklst_process_custom_save
		PARAMETERS nID_Detail, cSOitem, cSalesPerson, nPWeight, nPPC, pComment, dDueDate, cPoItem, cTBL
		*ThisForm.StockLst_Process_Custom_Save( nID_Detail, cSOitem, cSalesPerson, nPWeight, nPPC, cComment, dDueDate, cPoItem, 'StockLst' )
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE dStartDate, cAllowSub
		PRIVATE cProcess_ID, cProcessor, cComment
		
		dStartDate 	= DATE()
		cAllowSub 	= 'N'
		cProcess_ID = "SELECTED"
		
		PRIVATE cMach_User, cUserName 
		cMach_User = SYS(0)
		cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		
		cProcessor	= PrepareSQLtxt(cUserName,'User',20)
		IF VARTYPE(pComment) != "C"
			pComment = ""
		ENDIF
		
			cComment = "Custom Stock - Do not select as typical stock!" 
			cComment = cComment+CHR(13)+"This SELECTED process was created for the PO item:"+ALLTRIM(cPoItem)+"."
		
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		
		**Check for existing Proc
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		cSQL = "SELECT ID_Detail_Process FROM "+IIF( ALLTRIM(cTBL) = "StockLst", "dbo.StockLst_Process ", "dbo.BrokerLst_Process ")
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " AND Process_ID = 'SELECTED'"
		*cSQL = cSQL + " AND SOitem = dbo.ProperSO('"+cSOitem+"')"
		cSQL = cSQL + " AND PO_item = dbo.ProperPO('"+cPoItem+"')"
		cSQL = cSQL + " AND Comment LIKE 'Custom Stock - Do not select as typical stock!%'"
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF VARTYPE(tmpID_Detail_Process.ID_Detail_Process) = "N"
				nID_Detail_Process = tmpID_Detail_Process.ID_Detail_Process
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
					
					
		
		IF nID_Detail_Process = 0
			*New Process
			cProcess_ID = "SELECTED"
			*p_StockLst_Process_ins
			IF cTBL = "StockLst"
				cSQLi = "EXEC p_StockLst_Process_ins2 "
			ELSE
				cSQLi = "EXEC p_BrokerLst_Process_ins2 "
			ENDIF
			cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@salesperson = '"+STRTRAN(cSalesPerson,"'","''")+"'"
			cSQLi = cSQLi + ",@startdate = '"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
			cSQLi = cSQLi + ",@duedate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+STRTRAN(cAllowSub,"'","''")+"'"
			cSQLi = cSQLi + ",@pWeight = "+STR(nPWeight,9,2)
			cSQLi = cSQLi + ",@PPc = "+STR(nPPc)
			cSQLi = cSQLi + ",@PFt = "+STR(nPFt,10,4)
			cSQLi = cSQLi + ",@PU = "+STR(nPU)
			cSQLi = cSQLi + ",@SOitem = '"+STRTRAN(cSOitem,"'","''")+"'"
			cSQLi = cSQLi + ",@PO_item = '"+STRTRAN(cPO_Item,"'","''")+"'"
			cSQLi = cSQLi + ",@Process_ID = '"+STRTRAN(cProcess_ID,"'","''")+"'"
			cSQLi = cSQLi + ",@Processor = '"+STRTRAN(cProcessor,"'","''")+"'"
			cSQLi = cSQLi + ",@Comment = '"+STRTRAN(cComment,"'","''")+"'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			
			IF nSQLEXEC < 1
				SQLExecError(cSQLi,THISFORM.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC p_StockLst_Process_ins2","p_StockLst_Process_ins","EnterOrder.StockLst_Process_Save()",99)
			ELSE
		
		*		=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Detail_Process")
					nID_Detail_Process = tmpID_Detail_Process.exp		
					USE IN tmpID_Detail_Process
				ELSE
					nID_Detail_Process = 0
				ENDIF
		
			ENDIF
			
		ELSE
			*Update
			IF cTBL = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Process SET "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Process SET "
			ENDIF
			cSQL = cSQL+ " SOitem = dbo.ProperSO('"+STRTRAN(cSOitem,"'","''")+"')"
			cSQL = cSQL+ ",PO_item = dbo.ProperPO('"+STRTRAN(cPO_Item,"'","''")+"')"
			cSQL = cSQL+ ",SalesPerson= '"+STRTRAN(cSalesPerson,"'","''")+"'"
			cSQL = cSQL+ ",StartDate='"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
			cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQL = cSQL+ ",AllowSub='"+STRTRAN(cAllowSub,"'","''")+"'"
			cSQL = cSQL+ ",PWeight="+STR(nPWeight,9,2)
			cSQL = cSQL+ ",PPc="+STR(nPPc)
			cSQL = cSQL+ ",PFt="+STR(nPFt,10,4)
			cSQL = cSQL+ ",PU="+STR(nPU)
			cSQL = cSQL+ ",Process_ID='"+STRTRAN(cProcess_id,"'","''")+"'"
			cSQL = cSQL+ ",Processor='"+STRTRAN(cProcessor,"'","''")+"'"
			cSQL = cSQL+ ",Comment='"+STRTRAN(cComment,"'","''")+"'"
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL,THISFORM.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
		
			ENDIF
		ENDIF
		
		IF lOK 
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE stocklst_process_remove_custom
		PARAMETERS nID_Detail, cPoItem, cTableName
		*ThisForm.StockLst_Process_Remove_Custom( nID_Detail, cPoItem, 'StockLst' )
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		
		*cComment = "Custom Stock - Do not select as typical stock!" 
		
		IF UPPER(cTableName) != "STOCKLST"
			*came from Broker- Find nID_Detail of StockLst to Delete
			
			nID_Detail = 0
			IF USED("tmpID_Detail_ProcessIDD")
				USE IN tmpID_Detail_ProcessIDD
			ENDIF
			
			cSQL = "SELECT ID_Detail FROM dbo.StockLst_Process "
			cSQL = cSQL + " WHERE Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND PO_item = dbo.ProperPO('"+cPoItem+"')"
			cSQL = cSQL + " AND Comment LIKE 'Custom Stock - Do not select as typical stock!%'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_ProcessIDD')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_ProcessIDD' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_ProcessIDD' )
			ENDIF
		
			IF USED('tmpID_Detail_ProcessIDD')
				IF VARTYPE(tmpID_Detail_ProcessIDD.ID_Detail) = "N"
					nID_Detail = tmpID_Detail_ProcessIDD.ID_Detail
				ENDIF
				USE IN tmpID_Detail_ProcessIDD
			ENDIF
						
			cTableName = "StockLst"
		ENDIF
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		**Check for existing Proc
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		cSQL = "SELECT ID_Detail_Process FROM dbo.StockLst_Process "
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " AND Process_ID = 'SELECTED'"
		*cSQL = cSQL + " AND SOitem = dbo.ProperSO('"+cSOitem+"')"
		cSQL = cSQL + " AND PO_item = dbo.ProperPO('"+cPoItem+"')"
		cSQL = cSQL + " AND Comment LIKE 'Custom Stock - Do not select as typical stock!%'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF VARTYPE(tmpID_Detail_Process.ID_Detail_Process) = "N"
				nID_Detail_Process = tmpID_Detail_Process.ID_Detail_Process
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
		IF nID_Detail_Process > 0
			*DELETE
			cSQL = "DELETE FROM dbo.StockLst_Process "
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL,THISFORM.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
		
			ENDIF
		ENDIF
		
		IF lOK 
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE stocklst_process_save
		PARAMETERS nID_Detail, cSOitem, cSalesPerson, nPWeight, nPPC, nPFt, nPU, cComment, dDueDate, cPoItem, cTBL
		*ThisForm.StockLst_Process_Save( nID_Detail, cSOitem, cSalesPerson, nPWeight, nPPC, nPFt, nPU, cComment, dDueDate, cPoItem, 'StockLst' )
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE dStartDate, cAllowSub
		PRIVATE cProcess_ID, cProcessor, cComment
		
		dStartDate 	= DATE()
		cAllowSub 	= 'N'
		cProcess_ID = "SELECTED"
		cPo_Item = cPoItem
		
		PRIVATE cMach_User, cUserName 
		cMach_User = SYS(0)
		cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		
		cProcessor	= PrepareSQLtxt(cUserName,'User',20)
		cComment	= "This SELECTED process was created for SOitem:"+ALLTRIM(cSOitem)+" when the PO item:"+ALLTRIM(cPoItem)+" was saved."
		
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		
		**Check for existing Proc
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		cSQL = "SELECT ID_Detail_Process FROM "+IIF( cTBL = "StockLst", "dbo.StockLst_Process ", "dbo.BrokerLst_Process ")
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " AND Process_ID = 'SELECTED'"
		cSQL = cSQL + " AND SOitem = dbo.ProperSO('"+cSOitem+"')"
		cSQL = cSQL + " AND PO_item = dbo.ProperPO('"+cPoItem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF VARTYPE(tmpID_Detail_Process.ID_Detail_Process) = "N"
				nID_Detail_Process = tmpID_Detail_Process.ID_Detail_Process
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
					
					
		
		IF nID_Detail_Process = 0
			*New Process
			cProcess_ID = "SELECTED"
			*p_StockLst_Process_ins
			IF cTBL = "StockLst"
				cSQLi = "EXEC p_StockLst_Process_ins2 "
			ELSE
				cSQLi = "EXEC p_BrokerLst_Process_ins2 "
			ENDIF
			cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+STRTRAN(cSalesPerson,"'","''")+"'"
			cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+STRTRAN(cAllowSub,"'","''")+"'"
			cSQLi = cSQLi + ",@PWeight = "+STR(npWeight,9,2)
			cSQLi = cSQLi + ",@PPc = "+STR(npPc)
			cSQLi = cSQLi + ",@PFt = "+STR(nPFt,10,4)
			cSQLi = cSQLi + ",@PU = "+STR(nPU)
			cSQLi = cSQLi + ",@SOitem = '"+STRTRAN(cSOitem,"'","''")+"'"
			cSQLi = cSQLi + ",@PO_item = '"+STRTRAN(cPO_Item,"'","''")+"'"
			cSQLi = cSQLi + ",@Process_ID = '"+STRTRAN(cProcess_ID,"'","''")+"'"
			cSQLi = cSQLi + ",@Processor = '"+STRTRAN(cProcessor,"'","''")+"'"
			cSQLi = cSQLi + ",@Comment = '"+STRTRAN(cComment,"'","''")+"'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			
			IF nSQLEXEC < 1
				SQLExecError(cSQLi,THISFORM.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC p_StockLst_Process_ins2","p_StockLst_Process_ins","EnterOrder.StockLst_Process_Save()",100)
			ELSE
		
		*		=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Detail_Process")
					nID_Detail_Process = tmpID_Detail_Process.exp		
					USE IN tmpID_Detail_Process
				ELSE
					nID_Detail_Process = 0
				ENDIF
		
			ENDIF
			
		ELSE
			*Update
			IF cTBL = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Process SET "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Process SET "
			ENDIF
			cSQL = cSQL+ " SOitem= dbo.ProperSO('"+STRTRAN(cSOitem,"'","''")+"')"
			cSQL = cSQL+ ",PO_item= dbo.ProperPO('"+STRTRAN(cPO_Item,"'","''")+"')"
			cSQL = cSQL+ ",SalesPerson='"+STRTRAN(cSalesPerson,"'","''")+"'"
			cSQL = cSQL+ ",StartDate='"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
			cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQL = cSQL+ ",AllowSub='"+STRTRAN(cAllowSub,"'","''")+"'"
			cSQL = cSQL+ ",PWeight="+STR(nPWeight,9,2)
			cSQL = cSQL+ ",PPc="+STR(nPPC)
			cSQL = cSQL+ ",PFt="+STR(nPFt,10,4)
			cSQL = cSQL+ ",PU="+STR(nPU)
			cSQL = cSQL+ ",Process_ID='"+STRTRAN(cProcess_id,"'","''")+"'"
			cSQL = cSQL+ ",Processor='"+STRTRAN(cProcessor,"'","''")+"'"
			cSQL = cSQL+ ",Comment='"+STRTRAN(cComment,"'","''")+"'"
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL,THISFORM.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
		*		=SQLCOMMIT(ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		IF lOK 
			*THISFORM.RELEASE
		ENDIF
		
		
	ENDPROC

	PROCEDURE sumstocklstcost
		*sumStockLstCost()
		*THISFORM.pf.pgQuote.txtItemCost.REFRESH()
		*THISFORM.pf.pgOrder.chkInv.REFRESH
		
		PRIVATE nCurrSalesNumRec
		SELECT SalesQuote
		nCurrSalesNumRec = RECNO('SalesQuote')
		
		PRIVATE nSQLEXEC, cSQL
		
		cSQL = "SELECT p.SOitem "
		cSQL = cSQL + ",SUM( dbo.f_CalcStkCost(M.Form,P.PPc,D.Dim2,D.Dim3,P.PWeight,D.CostValue) ) AS Cost "
		cSQL = cSQL + ", 0 AS CostValue "
		cSQL = cSQL + ",SUM(P.Pweight) AS Pweight "
		cSQL = cSQL + ",SUM(P.PFt) AS PFt "
		cSQL = cSQL + ",SUM(P.PPc) AS PPc "
		cSQL = cSQL + ",SUM(P.PU) AS PU "
		cSQL = cSQL + " FROM dbo.StockLst_Master M, dbo.StockLst_Detail D, dbo.StockLst_Process P "
		cSQL = cSQL + " WHERE M.ID = D.ID AND D.ID_Detail = P.ID_Detail AND P.SOitem LIKE '%"
		cSQL = cSQL + ALLTRIM(STR(ThisForm.SalesNum,7,0)) + "-[0-9][0-9]'"
		cSQL = cSQL + " GROUP BY p.SOitem"
		*cSQL = cSQL + ", M.Form " 
		
		
		*!*	cSQL = "SELECT p.SOitem, D.CostValue, P.Pweight, P.PFt, P.PPc, P.PU"
		*!*	cSQL = cSQL + " FROM dbo.StockLst_Master M, dbo.StockLst_Detail D, dbo.StockLst_Process P "
		*!*	cSQL = cSQL + " WHERE M.ID = D.ID AND D.ID_Detail = P.ID_Detail AND P.SOitem LIKE '%"
		*!*	cSQL = cSQL + ALLTRIM(STR(ThisForm.SalesNum,7,0)) + "-[0-9][0-9]'"
		*!*	*cSQL = cSQL + " GROUP BY p.SOitem, M.Form "  --Cannot Group without using SUM(
		
		IF USED('tmpSumSoStock')
			SELECT tmpSumSoStock
			USE IN tmpSumSoStock
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSumSoStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumSoStock')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSumSoStock')
			RETURN
		ENDIF
		
		PRIVATE cCurrSOitem
		SELECT tmpSumSoStock
		IF RECCOUNT("tmpSumSoStock") > 0
			SCAN
				cCurrSOitem = tmpSumSoStock.SOitem
				*nStkCost = Calc_TotalValue(D.CostValue, P.Pweight, P.PFt, P.PPc, P.PU)
				nStkCost = tmpSumSoStock.Cost
				 
				SELECT SalesQuote
				LOCATE FOR SOitem_A = cCurrSOitem 
				IF FOUND('SalesQuote')
					IF SalesQuote.ItemCost > 0 AND ( ROUND( SalesQuote.ItemCost ,2) != ROUND( nStkCost ,2) )
						IF MESSAGEBOX("Do you want to replace your current Cost of $"+ALLTRIM(STR(SalesQuote.ItemCost,10,4))+CHR(13)+;
								"with the Inventory cost of $"+ALLTRIM(STR(nStkCost,10,4))+" ?"+CHR(13)+CHR(13)+;
								"SO item:"+SalesQuote.SOitem_A+CHR(13)+;
								" "+SalesQuote.Descript,4+32,"Item allready has a cost entered." )= 6
							REPLACE ItemCost WITH nStkCost IN SalesQuote
							REPLACE Inv WITH .T. IN SalesQuote
						ENDIF
					ELSE
						REPLACE ItemCost WITH nStkCost IN SalesQuote
						REPLACE Inv WITH .T. IN SalesQuote
					ENDIF
			*		ThisForm.frmEdt.pf.pgOrder.chkInv.REFRESH
					ThisForm.pf.pgOrder.chkInv.Refresh
				ENDIF
				SELECT tmpSumSoStock
			ENDSCAN
		ENDIF
		
		IF USED('tmpSumSoStock')
			USE IN tmpSumSoStock
		ENDIF
		
		**Look for Heat/Lot Selected
		
		
		cSQL = "SELECT p.SOitem, m.Heat, p.Comment "
		cSQL = cSQL + " FROM dbo.StockLst_Master M, dbo.StockLst_Detail D, dbo.StockLst_Process P "
		cSQL = cSQL + " WHERE M.ID = D.ID AND D.ID_Detail = P.ID_Detail AND P.SOitem LIKE '%"
		cSQL = cSQL + ALLTRIM(STR(ThisForm.SalesNum,7,0)) + "-[0-9][0-9]' AND AllowSub = 'N'"
		
		
		IF USED('tmpSelStock')
			USE IN tmpSelStock
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSelStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSelStock')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSelStock')
		ELSE
			SELECT tmpSelStock
			IF RECCOUNT("tmpSelStock") > 0
				PRIVATE cCurSOitem, cHeat, cS_instrct
				GO TOP
				SCAN
					cCurSOitem = tmpSelStock.SOitem
					cHeat = PrepareSQLtxt(tmpSelStock.Heat,'Heat',30,.F.)
					*cS_instrct = ALLTRIM( PrepareSQLtxt(tmpSelStock.Comment,'Comment',0,.F.) )
					
					SELECT SalesQuote
					
					IF cHeat != "Due In"
						REPLACE ALL Heat WITH cHeat IN SalesQuote FOR SalesQuote.SOitem_a = cCurSOitem 
						*REPLACE ALL S_instrct WITH cS_instrct IN SalesQuote FOR SOitem = cCurSOitem 
						
						PRIVATE cSQLu, nSQLEXEC
						cSQLu = "UPDATE dbo.Sales SET "
						cSQLu = cSQLu + "Heat ='"+cHeat+"'"
						cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cCurSOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!, long triger
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
						ENDIF
						
						
					ENDIF
							
					SELECT tmpSelStock
				ENDSCAN
			ENDIF	
		ENDIF
		IF USED('tmpSelStock')
			USE IN tmpSelStock
		ENDIF
		
		SELECT SalesQuote
		IF nCurrSalesNumRec > RECCOUNT()
			GO BOTTOM
		ELSE
			GOTO (nCurrSalesNumRec)
		ENDIF
		
		ThisForm.pf.pgQuote.txtHeat.Refresh
		
	ENDPROC

	PROCEDURE treated_lumber_country
		IF THISFORM.SoldAddr > 0 AND EMPTY(THISFORM.pf.pgBillTo.txtSoldCode.VALUE)
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr "
			cSQL = cSQL + " WHERE SoldCode = "+STR(THISFORM.SoldAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
			ENDIF
					
			IF USED('aSoldAddr') 
		*		thisform.POSoldAddr = aSoldAddr.SoldCode
		*		This.Parent.txtPOSoldAddr.Value = aSoldAddr.SoldCode
		*		This.Parent.numSoldAddr.Value = aSoldAddr
				THISFORM.pf.pgBillTo.txtCompany.Value = aSoldAddr.Company
				THISFORM.pf.pgBillTo.txtAddr1.Value = aSoldAddr.Addr1
				THISFORM.pf.pgBillTo.txtAddr2.Value = aSoldAddr.Addr2
				THISFORM.pf.pgBillTo.txtCity.Value = aSoldAddr.City
				THISFORM.pf.pgBillTo.txtST.Value = aSoldAddr.ST
				THISFORM.pf.pgBillTo.txtZip.Value = aSoldAddr.Zip
				THISFORM.pf.pgBillTo.txtCountry.Value = aSoldAddr.Country
				THISFORM.pf.pgBillTo.txtContact.Value = aSoldAddr.Contact
				THISFORM.pf.pgBillTo.txtPhone.Value = aSoldAddr.Telephone
				THISFORM.pf.pgBillTo.txtFax.Value = aSoldAddr.Fax_Number
				THISFORM.pf.pgBillTo.txtEmail.Value = aSoldAddr.Email
				THISFORM.pf.pgBillTo.txtLastEdit.Value = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
				
				
				USE IN aSoldAddr
			ENDIF		
		ENDIF
		
		IF THISFORM.ShipAddr > 0 AND EMPTY(THISFORM.pf.pgShipto.txtShipCode.VALUE)
		
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			SELECT 0
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(ThisForm.ShipAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
			ENDIF
			
			IF USED('aShipAddr') 
				THISFORM.pf.pgShipto.txtCompany.VALUE 	= aShipAddr.Company
				THISFORM.pf.pgShipto.txtAddr1.VALUE		= aShipAddr.Addr1
				THISFORM.pf.pgShipto.txtAddr2.VALUE		= aShipAddr.Addr2
				THISFORM.pf.pgShipto.txtCity.VALUE 		= aShipAddr.City
				THISFORM.pf.pgShipto.txtST.VALUE		= aShipAddr.ST
				THISFORM.pf.pgShipto.txtZip.VALUE		= aShipAddr.Zip
				THISFORM.pf.pgShipto.txtCountry.VALUE	= aShipAddr.Country
				THISFORM.pf.pgShipto.txtContact.VALUE	= aShipAddr.Contact
				THISFORM.pf.pgShipto.txtPhone.VALUE		= aShipAddr.Telephone
				THISFORM.pf.pgShipto.txtFax.VALUE		= aShipAddr.Fax_Number
				THISFORM.pf.pgShipto.txtEmail.VALUE		= aShipAddr.Email
				THISFORM.pf.pgShipto.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
				
				USE IN aShipAddr
			ENDIF
		ENDIF
		
		
		PRIVATE cBillCountry, cShipCountry, lFoundCountry, cBillCountryABV, cShipCountryABV
		cBillCountry = PADR(UPPER(THISFORM.pf.pgBillTo.txtCountry.VALUE),15," ")
		cShipCountry = PADR(UPPER(THISFORM.pf.pgShipto.txtCountry.VALUE),15," ")
		lFoundCountry = .F.
		
		PRIVATE cHoldCountryName
		cHoldCountryName = ""
		
		IF NOT USED('HardWood')
			ThisForm.LoadHardwood()
		ENDIF
		
		SELECT HardWood
		INDEX ON Country TAG Country
		INDEX ON ABV TAG ABV
		
		
		IF NOT EMPTY(cShipCountry)
			SEEK cShipCountry ORDER Country IN HardWood
			IF FOUND("HardWood")
				IF NOT HardWood.Inactive
					lFoundCountry = .T.
					cHoldCountryName = cShipCountry
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				IF LEN(ALLTRIM(cShipCountry)) = 2
					cShipCountryABV = LEFT(cShipCountry ,2)
					SEEK cShipCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							lFoundCountry = .T.
							cHoldCountryName = HardWood.Country
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				SEEK cShipCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						lFoundCountry = .T.
						cHoldCountryName = cShipCountry
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT EMPTY(cBillCountry)
			IF NOT lFoundCountry
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						lFoundCountry = .T.
						cHoldCountryName = cBillCountry
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				IF LEN(ALLTRIM(cBillCountry )) = 2
					cBillCountryABV = LEFT(cBillCountry ,2)
					SEEK cBillCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							lFoundCountry = .T.
							cHoldCountryName = HardWood.Country
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						lFoundCountry = .T.
						cHoldCountryName = cBillCountry
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		RETURN cHoldCountryName
		
	ENDPROC

	PROCEDURE updtitemsale
		PARAMETER nSalePrice
		*ThisForm.UpdtItemSale(SalesQuote.cLotP)
		**nSalePrice is a Total
		
		PRIVATE lnSalesNum, cSOitem
		lnSalesNum = SalesQuote.SalesNum
		cSOitem =  SalesQuote.SOitem
		
		PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU
		nQuoted_PU	= GetPUfromForm( SalesQuote.Form, ThisForm.nConnHandle )
		nQuoted_QTY	= Get_QTY( SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.Weight, nQuoted_PU, ThisForm.nConnHandle)
		
		IF VARTYPE(nSalePrice) != "N"
			nSalePrice = SalesQuote.ItemSale
		ENDIF
		nQuoted_Total = nSalePrice  
		
		
		IF nQuoted_QTY > 0
			nQuoted_P	= nQuoted_Total/ nQuoted_QTY
		ELSE
			nQuoted_P	= 0
		ENDIF
		
		
		PRIVATE cSQLu, nSQLEXEC
		IF TYPE("nSalePrice") = "N"
		  IF nSalePrice > 0
			IF SalesQuote.ItemSale > 0
				IF ROUND(SalesQuote.ItemSale,2) != ROUND(nSalePrice,2)
					IF MESSAGEBOX( "Sales Price is entered as $"+ALLTRIM(STR(SalesQuote.ItemSale,9,2))+CHR(13)+;
					"Your edit calculates to a price of $"+ALLTRIM(STR(nSalePrice,9,2))+CHR(13)+CHR(13)+;
					"Do you want to use the new calculated number?",4+32,"Update Sale Price")=6
						
						REPLACE SalesQuote.ItemSale WITH nSalePrice IN SalesQuote
						ThisForm.pf.pgQuote.txtItemSale.Refresh
						*ThisForm.pf.pgQA.txtItem.Refresh()
						
						nSalePrice = PrepareSQLNum(nSalePrice,'ItemSale',9,2)
						
						cSQLu = "UPDATE dbo.Sales SET "
						cSQLu = cSQLu + " ItemSale = "+STR(nSalePrice,18,4)
						cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
						cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
						cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4)
						cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
						cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!, long triger
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
						ENDIF
				
					ENDIF
				ENDIF
			ELSE
		*		No Price set
				REPLACE SalesQuote.ItemSale WITH nSalePrice IN SalesQuote
				ThisForm.pf.pgQuote.txtItemSale.Refresh
				*ThisForm.pf.pgQA.txtItem.Refresh()
				
				nSalePrice = PrepareSQLNum(nSalePrice,'ItemSale',9,2)
				
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + "ItemSale = "+STR(nSalePrice,9,2)
				cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long trigger
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF
		
			ENDIF
		  ENDIF
		ELSE
		*	MESSAGEBOX("UpdtItemSale() expected a Number")
		ENDIF
	ENDPROC

