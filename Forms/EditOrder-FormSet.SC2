	PROCEDURE frmPO.pgfPO.pgPODesc.txtLotp.Valid
		IF This.Value > 0
			IF EMPTY(This.Parent.txtOrder_Qty.VALUE)
				This.Parent.txtOrder_Qty.VALUE = 1
			ELSE
				*WAIT WINDOW "Units to be priced allready has value. Clear to recalc!" NOWAIT
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.pgfPO.pgPODesc.txtOrderdate.Valid
		PRIVATE vDate, dDate
		vDate = This.Value
		
		IF VARTYPE(vDate) = "T"
			dDate = TTOD(vDate)
			This.Value = dDate
		ENDIF
		IF VARTYPE(vDate) = "D"
			dDate = vDate
		ENDIF
		IF VARTYPE(vDate) = "C"
			dDate = CTOD(vDate)
			This.Value = dDate
		ENDIF
		
		
		
		IF dDate != CTOD("  /  /  ")
			*Have a date
			IF dDate > DATE() + 1095 
