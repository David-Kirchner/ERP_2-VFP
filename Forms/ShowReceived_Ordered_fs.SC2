	PROCEDURE create_incoming_process
		PARAMETERS pStockTable,pTableID_Detail,pSOitem,pPOitem,  nPounds
		*can create an Partial Incoming process
		*Returns nID_Detail_Process
		
		PRIVATE cStockTable,nTableID_Detail,cSOitem,cPOitem,nReceivingID
		PRIVATE nID_Detail
		IF VARTYPE(pStockTable)="C"
			cStockTable = pStockTable
		ELSE
			TrackError("bad variable","Receiving:Receiving_Create_Incoming_Process(cTableName:NO TABLE ,nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")" ,"Shop_StockLst_Edit:Receiving_Create_LstProcess",LINENO())
			cStockTable = "N"
		ENDIF
		IF VARTYPE(pTableID_Detail)="N"
			nTableID_Detail = pTableID_Detail
			nID_Detail = nTableID_Detail
		ELSE
			nTableID_Detail = 0
			nID_Detail = nTableID_Detail
		ENDIF
		IF VARTYPE(pSOitem)="C"
			cSOitem = pSOitem
		ELSE
			cSOitem = "N"
		ENDIF
		IF VARTYPE(pPOitem)="C"
			cPOitem = pPOitem
		ELSE
			cPOitem= "N"
		ENDIF
		
		nReceivingID = 0
		
		*TrackMess("Receiving:Receiving_Create_Incoming_Process(cTableName:"+cStockTable+",nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")" )
		
		IF cStockTable = "N"
			RETURN 0
		ENDIF
		
		*nTableID_Detail = get_ID_Detail_with_POitem(pPOitem, pStockTable, ThisFormSet.nConnHandle)
		IF EMPTY(nTableID_Detail)
			nTableID_Detail = get_ID_Detail_with_SOitem(cSOitem, cStockTable, "", ThisFormSet.nConnHandle)
			TrackMess("Receiving:Receiving_Create_Incoming_Process(cTableName:"+cStockTable+",nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
		ENDIF
		
		IF EMPTY(nTableID_Detail)
			RETURN 0
		ENDIF
		
		PRIVATE cUser,cSalesPerson, cAllowSub,dStartDate,dDueDate, nID_Detail_Process 
		PRIVATE npWeight,npPc,cProcess_ID,cProcessor,cComment
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		cUser	= LEFT( SUBSTR(SYS(0), AT("#",SYS(0))+1 ), 20)
		cSalesPerson = PrepareSQLtxt( cUser,'SalesPerson', 20)
		cAllowSub	= "N"
		npWeight	= 0
		npPc		= 0
		dStartDate	= DATE()
		dDueDate	= DATE()
		nID_Detail_Process = 0
		
		cProcess_ID		= "INCOMING"
		cProcessor		= LEFT( ALLTRIM(SYS(0))+" "+DTOC(date())+" "+time(), 20)
		cProcessor		= PrepareSQLtxt( cProcessor,'Processor',20)
		cComment 		= "Created INCOMING, no ReceivingID yet"
		*nReceivingID	= PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		
		
		*****************************
		*Check for Existing 'INCOMING'
		
		IF USED('tmpPO_IDDP')
			USE IN tmpPO_IDDP
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID_Detail_Process FROM "
		IF cStockTable="B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		ELSE
			cSQL = cSQL + " dbo.StockLst_Process "
		ENDIF
		cSQL  = cSQ + " WHERE ID_Detail = "+STR(nID_Detail)+""
		cSQL  = cSQ + " AND Process_ID = 'INCOMING'"
		cSQL  = cSQ + " AND ReceivingID = 0"
		cSQL  = cSQ + " AND PO_Item = '"+cPoItem+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_IDDP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_IDDP')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_IDDP')
		ENDIF
		
		IF USED('tmpPO_IDDP')
			IF RECCOUNT('tmpPO_IDDP') > 0
				nID_Detail_Process  = PrepareSQLnum(tmpPO_IDDP.ID_Detail_Process,'ID_Detail_Process',-3)
			ENDIF
			USE IN tmpPO_IDDP
			RETURN nID_Detail_Process
		ENDIF
		
		
		******************************
		PRIVATE nPU, nQTY, nP
		nPU	= 0
		nQTY = 0
		nP = 0
		
		IF USED('tmpPO_QTY')
			USE IN tmpPO_QTY
		ENDIF
		SELECT 0
		
		cSQL = "SELECT StockLst_QTY, StockLst_P, dbo.f_GetFormPU(Form) AS S_PU"
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPoItem+"')" 
		cSQL = cSQL + " AND ISNULL(Reconciled,0)=0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_QTY')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_QTY')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_QTY')
		*	TrackError("Could not EXEC dbo.p_StockLst_Process_ins3",PrepareSQLtxt(cSQLi,"cSQL",-1),"Receive_Edit.Receiving_Create_Incoming_Process()",LINENO())
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nQTY = PrepareSQLnum(tmpID_Detail_Process.StockLst_QTY,'S_QTY',-5)
				nP   = PrepareSQLnum(tmpID_Detail_Process.StockLst_P,'S_P',-5)
				nPU  = PrepareSQLnum(tmpID_Detail_Process.S_PU,'PU',-1)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		******************************
		IF nPU + nQTY + nP = 0
			SELECT Receiving
			RETURN 0
		ENDIF
		*****************************
		
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		IF cStockTable="B"
			cSQLi = "EXEC dbo.p_BrokerLst_Process_ins5 "
		ELSE
			cSQLi = "EXEC dbo.p_StockLst_Process_ins5 "
		ENDIF
		
		cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@StartDate = '"+DTOC( DATE() )+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
		cSQLi = cSQLi + ",@PU = "+STR(nPU)
		cSQLi = cSQLi + ",@QTY = "+STR(nQTY,18,4)
		cSQLi = cSQLi + ",@Pounds= "+STR(nPounds,9,1)
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		
		cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"  
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID= "+STR(nReceivingID)+""
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
			TrackError("p_StockLst_Process_ins5",PrepareSQLtxt(cSQLi,"cSQL",-1),"Receive_Edit.Receiving_Create_Incoming_Process()",LINENO())
		ELSE
			*PRIVATE cText
			*cText = "INFO: Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID))+' Receive_Edit.ReceivingSaveID_Master'+"ProcessID="+STR(tmpID_Detail_Process.EXP)+" StockTable="+cStockTable+" PO item="+cPOitem
			*MESSAGEBOX( "Created Process"+CHR(13)+"ProcessID="+STR(tmpID_Detail_Process.EXP)+CHR(13)+"StockTable="+pStockTable+CHR(13)+"PO item="+pPOitem,0+48,"INFO: Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID)) )
			*TrackMess(cText)
			*\Progs\ErrorHandlerlog(0,"ProcessID="+STR(tmpID_Detail_Process.EXP)+" StockTable="+pStockTable+" PO item="+pPOitem,"INFO Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID)),'Receive_Edit.ReceivingSaveID_Master',277)
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		SELECT Receiving
		RETURN nID_Detail_Process 
	ENDPROC

	PROCEDURE create_partial_stock
		*ThisFormSet.Create_Partial_Stock()
			*INSERT
			IF USED('tmpID_Master')
				USE IN tmpID_Master
			ENDIF
		
			cSQLi = "EXEC dbo.p_BrokerLst_Master_ins2 "
			cSQLi = cSQLi+ " @Alloy ='"+cAlloy+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Form ='"+cForm+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@CC ='"+cCC+"'"
			cSQLi = cSQLi+ ",@Size ="+STR(nThck,9,3)+""   &&NOT NULL
			cSQLi = cSQLi+ ",@Cond ='"+cCond+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@MWeight ="+STR(nStockLst_QTY,18,4)+"" &&Init with 0 **STR(IIF(ISNULL(mweight),0,mweight),9,2)+""
			cSQLi = cSQLi+ ",@Specs ='"+cSpecs+"'"
			cSQLi = cSQLi+ ",@Heat ='"+'Due In'+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Lot =''"
			cSQLi = cSQLi+ ",@Paid ="+STR(nStockLst_P,18,4)+""
			cSQLi = cSQLi+ ",@PO_Item ='"+cPoItem+"'"
			cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQLi = cSQLi+ ",@Mill =''"
			cSQLi = cSQLi+ ",@StkDate =''"
			cSQLi = cSQLi+ ",@History =''"
			cSQLi = cSQLi+ ",@Num = 0"
			cSQLi = cSQLi+ ",@POStatus ='D'"
			cSQLi = cSQLi+ ",@BrandName ='"+cBrandName+"'"
			cSQLi = cSQLi+ ",@From_ID =0"
			cSQLi = cSQLi+ ",@Melt='"+cMelt+"'"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Master')
			ENDDO
			IF nSQLEXEC < 1
				SQLEXECError(cSQLi,ThisFormSet.nConnHandle)
				nMaster_ID = 0
				lSQLgood = .F.
			ELSE
				IF USED('tmpID_Master')
					nMaster_ID = tmpID_Master.EXP
					USE IN tmpID_Master
					IF nMaster_ID > 0
						cSQL_M_Update = "UPDATE dbo.BrokerLst_Master SET "
						cSQL_M_Update = cSQL_M_Update +" CL ='"+cCL+"'"
						cSQL_M_Update = cSQL_M_Update +" WHERE ID = "+STR(nMaster_ID )
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
						ENDIF
					
					ENDIF
					
				ELSE
					nMaster_ID = 0
				ENDIF
			ENDIF
			
		 	IF nMaster_ID > 0
				*INSERT Detail
		
				IF USED('tmpID_Detail')
					USE IN tmpID_Detail
				ENDIF
				SELECT 0
		
				cSQLi = "EXEC dbo.p_BrokerLst_Detail_ins "
				cSQLi = cSQLi + " @size_h ="+'NULL'
				cSQLi = cSQLi + ",@size_l ="+'NULL'
				cSQLi = cSQLi + ",@pc ="+ STR(nPieces,10,0)
				cSQLi = cSQLi + ",@dim1 =" + STR(IIF(ISNULL(nThck),0,nThck),18,4)
				cSQLi = cSQLi + ",@dim2 =" + STR(IIF(ISNULL(nSz2),0,nSz2),18,4)
				cSQLi = cSQLi + ",@dim3 =" + STR(IIF(ISNULL(nSz3),0,nSz3),18,4)
				cSQLi = cSQLi + ",@length ="+"'Listing created from new PO:"+ALLTRIM(STR(nHpaPo))+" needed for a SO:"+ALLTRIM(STR(nSalesNum))+".'"
				cSQLi = cSQLi + ",@weight =" + STR(nPounds,9,2)
				cSQLi = cSQLi + ",@costvalue =" + STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,4)
				cSQLi = cSQLi + ",@descript ='"+"'"
				cSQLi = cSQLi + ",@location ='"+"'"
				cSQLi = cSQLi + ",@floorstatus ='"+"'"
				cSQLi = cSQLi + ",@class ='"+"'"
				cSQLi = cSQLi + ",@unit ='"+cLstDetailUnit+"'"
				cSQLi = cSQLi + ",@RandLen ="+IIF(lRandLen,"1","0")	&&'"+"'"
				cSQLi = cSQLi + ",@ID ="+STR(nMaster_ID )
				cSQLi = cSQLi + ",@ID_Detail_Process ="+STR(nID_Detail_Process)
		
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQLi,ThisFormSet.nConnHandle)
					lSQLgood = .F.
				ELSE
					IF USED('tmpID_Detail')
						nID_Detail = tmpID_Detail.EXP
						USE IN tmpID_Detail
		
						*Now update what does not fit in SP p_StockLst_Detail_ins
						cSQL_Detail_Update = "UPDATE dbo.BrokerLst_Detail SET "
						cSQL_Detail_Update = cSQL_Detail_Update +" location ='"+cShipLocation+"'"
		
						cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " 	+ STR(nStockLst_QTY,18,4) + ""
						cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " 		+ STR(nStockLst_P,18,4) + ""
						cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = "  + STR(nS_Total,18,4) + ""
						cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " 	+ STR(nS_PU) + ""
		
						cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID_Detail = "+STR(nID_Detail)
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail_Update )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail_Update )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL_Detail_Update,ThisFormSet.nConnHandle,nSQLEXEC )
						ENDIF
		
					ELSE
						*Insert Failed
						SQLEXECError(cSQLi,ThisFormSet.nConnHandle)
						lSQLgood = .F.
						MESSAGEBOX('Could not SAVE detail',0,'Error')
					ENDIF
				ENDIF	
			ENDIF
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		ThisFormSet.Create_Incoming_Process(cTableName,nTableID_Detail,pSOitem,ThisFormSet.cPOitem,nPounds)
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS cPOitem, cAlloy,cHeat,nPieces,nActualW,cDescription,nReceivingID
		*DO FORM Forms\ShowReceived_Ordered WITH cPOitem, cAlloy,cHeat,nPieces,nActualW,cDescription,nReceivingID TO lRollBack
		*DO FORM Forms\ShowReceived_Ordered WITH '   505757-01', 'B-2','',7,15,'1.004',0  TO lRollBack
		
		IF VARTYPE(cPOitem) != "C"
			cPOitem = ''
		ENDIF
		IF cPOitem = Proper_PO_Item('')
			ThisFormSet.lReturn = .T.
			ThisFormSet.Release
		ENDIF
		IF VARTYPE(nReceivingID)!= "N"
			nReceivingID = 0
		ENDIF
		ThisFormSet.nReceivingID = ABS(nReceivingID)   &&Inverted means New ID, just ADDed
		
		ThisFormSet.frmReceived_Ordered.lblSummary.Caption = "Summary for PO-item: "+ALLTRIM(cPOitem)
		ThisFormSet.cPOitem = cPOitem
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPO')	
			USE IN tmpPO
		ENDIF
		
		cSQL = "SELECT Company,Alloy,Form,CC,CL,Thck,sz2,sz3,Pieces,Order_QTY,Services,ConvServ,Equipment,Delivered,Reconciled "
		cSQL = cSQL+" FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO')
		ENDIF
		
		IF USED('tmpPO')	
			IF RECCOUNT('tmpPO') > 0
				ThisFormSet.frmReceived_Ordered.txtCompany.Value	= tmpPO.Company
				ThisFormSet.frmReceived_Ordered.txtAlloyPO.Value	= tmpPO.Alloy
				ThisFormSet.frmReceived_Ordered.txtForm.Value		= tmpPO.Form
				*ThisFormSet.frmReceived_Ordered.txtCC.Value		= tmpPO.CC
				*ThisFormSet.frmReceived_Ordered.txtCL.Value		= tmpPO.CL
				ThisFormSet.frmReceived_Ordered.txtThck.Value		= tmpPO.Thck
				ThisFormSet.frmReceived_Ordered.txtSz2.Value		= tmpPO.sz2
				ThisFormSet.frmReceived_Ordered.txtSz3.Value		= tmpPO.sz3
				ThisFormSet.frmReceived_Ordered.txtPiecesPO.Value	= tmpPO.Pieces
				ThisFormSet.frmReceived_Ordered.txtOrder_QTY.Value	= tmpPO.Order_QTY
				ThisFormSet.frmReceived_Ordered.chkServicesPO.Value	= tmpPO.Services
				ThisFormSet.frmReceived_Ordered.chkConvServ.Value	= tmpPO.ConvServ
				ThisFormSet.frmReceived_Ordered.chkEquipment.Value	= tmpPO.Equipment
				ThisFormSet.frmReceived_Ordered.chkComplete.Value	= tmpPO.Delivered
				ThisFormSet.frmReceived_Ordered.chkReconciled.Value	= tmpPO.Reconciled	
				
			ENDIF
			USE IN tmpPO
		ENDIF
		************************
		*cAlloy,cHeat,nPieces,nActualW,cDescription
		
		ThisFormSet.frmReceived_Ordered.txtAlloy.Value		= PrepareSQLtxt(cAlloy,'Alloy',12)
		ThisFormSet.frmReceived_Ordered.txtHeat.Value		= PrepareSQLtxt(cHeat,'Heat',30)
		ThisFormSet.frmReceived_Ordered.txtPieces.Value	= PrepareSQLnum(nPieces,'Pieces',-3)
		ThisFormSet.frmReceived_Ordered.txtActualW.Value	= PrepareSQLnum(nActualW,'ActualW',9,1)
		ThisFormSet.frmReceived_Ordered.edtDescription.Value = PrepareSQLtxt(cDescription,'Description',-1)
		
		************************
		cSQL = "SELECT Alloy,Heat,Pieces,ActualW, LEFT(Description,200) AS [Description],Cancelled,ID "
		cSQL = cSQL+" FROM dbo.Receiving "
		cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		IF ThisFormSet.nReceivingID > 0
			cSQL = cSQL+" OR ID = "+STR(ThisFormSet.nReceivingID)
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceive')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceive')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpReceive')
		ENDIF
		
		PRIVATE m.nPastTotal
		m.nPastTotal = 0
		
		IF USED('tmpReceive')	
			IF RECCOUNT('tmpReceive') > 0
			
				SET TALK OFF
				SUM ActualW TO m.nPastTotal WHILE ID <> ABS(nReceivingID)
		
				*m.nPastTotal = m.nPastTotal - nActualW
				ThisFormSet.frmReceived_Ordered.txtPastTotal.Value = m.nPastTotal
				GO TOP
				
				ThisFormSet.frmReceived_Ordered.edtAllDescription.Value = tmpReceive.Description
				ThisFormSet.frmReceived_Ordered.grdReceive.RecordSource = 'tmpReceive'
				
				IF nReceivingID > 0
					ThisFormSet.frmReceived_Ordered.grdReceive.SetAll("dynamicbackcolor","IIF(ID="+STR(nReceivingID)+",RGB(128,255,128),IIF(tmpReceive.cancelled, RGB(255,220,220), RGB(255,255,255)))", "Column")
				ELSE
					ThisFormSet.frmReceived_Ordered.grdReceive.SetAll("dynamicbackcolor","IIF(tmpReceive.cancelled, RGB(255,220,220), RGB(255,255,255))", "Column")
				ENDIF
				
				ThisFormSet.frmReceived_Ordered.grdReceive.Visible = .T.
			ENDIF
			*USE IN tmpReceive
		ENDIF
		
		IF nReceivingID > 0
			*Change Screen to an EDIT not Add!
			ThisFormSet.frmReceived_Ordered.Shape1.Visible = .F.
			ThisFormSet.frmReceived_Ordered.lblThisReceive.Visible = .F.
			ThisFormSet.frmReceived_Ordered.lblAlloy.Visible = .F.
			ThisFormSet.frmReceived_Ordered.txtAlloy.Visible = .F.
			ThisFormSet.frmReceived_Ordered.txtlblHeat.Visible = .F.
			ThisFormSet.frmReceived_Ordered.txtHeat.Visible = .F.
			ThisFormSet.frmReceived_Ordered.lblPieces.Visible = .F.
			ThisFormSet.frmReceived_Ordered.txtPieces.Visible = .F.
			ThisFormSet.frmReceived_Ordered.lblActualLbs.Visible = .F.
			ThisFormSet.frmReceived_Ordered.txtActualW.Visible = .F.
			ThisFormSet.frmReceived_Ordered.lblDescript.Visible = .F.
			ThisFormSet.frmReceived_Ordered.edtDescription.Visible = .F.
			
			ThisFormSet.frmReceived_Ordered.cmdJustEdit.Visible = .T.
			ThisFormSet.frmReceived_Ordered.cmdCancel.Visible = .F.
			ThisFormSet.frmReceived_Ordered.cmdGood.Visible = .F.
			ThisFormSet.frmReceived_Ordered.cmdGoodCmplt.Visible = .F.
		ENDIF
		
		PRIVATE nOrder_QTY, nActualW, nQTY_Diff
		nOrder_QTY 	= PrepareSQLnum(ThisFormSet.frmReceived_Ordered.txtOrder_QTY.Value,'Order_QTY',9,1)
		nActualW	= PrepareSQLnum(ThisFormSet.frmReceived_Ordered.txtActualW.Value,'ActualW',9,1)
		nQTY_Diff 	= nOrder_QTY - m.nPastTotal &&+ nActualW
		
		ThisFormSet.frmReceived_Ordered.txtQTY_Diff.Value = ABS(nQTY_Diff)
		
		*Show Red if 10% off
		IF ( (m.nPastTotal + nActualW + 100 ) > (nOrder_QTY+100) * 1.2 ) OR ( (m.nPastTotal + nActualW + 100 ) * 1.2 < (nOrder_QTY+100) )
			*240,240,240
			ThisFormSet.frmReceived_Ordered.txtlblQTY_Diff.BackColor = RGB(255,0,0)
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_HPA.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpReceive')	
			USE IN tmpReceive
		ENDIF
		
		
		RETURN ThisFormSet.lReturn
	ENDPROC

	PROCEDURE frmPartial.cmdAbortP.Click
		IF MESSAGEBOX("Are you sure you want to Abort this Patrial Incoming?",4+32,"Cancel")=6
		*	ThisFormSet.frmReceived_Ordered.lReturn = 0
			thisformSet.lReturn=0
			ThisForm.Release
			ThisFormSet.Release
		ENDIF
	ENDPROC

	PROCEDURE frmPartial.cmdSaveP.Click
		*Retrieve Process Detail before Delete
		**
		PRIVATE cSOitem,cPOitem,cSalesPerson,dStartDate,dDueDate,cComment,cProcess_ID
		PRIVATE cProcessor,cAllowSub,nPWeight,nPPc,nPFT,nPU,nQTY,nPounds
		PRIVATE nID_Detail ,nID_Detail_Process ,nReceivingID ,nWO
		
		*Fill with default
		cSOitem	= PrepareSQLtxt('','SOitem',-10)
		cPOitem	= PrepareSQLtxt('','POitem',12)
		cSalesPerson = PrepareSQLtxt('','SalesPerson',20)
		StartDate = PrepareSQLdate(DATE(),'StartDate')
		dDueDate = GetLatestDate( PrepareSQLdate('','DueDate'), DATE()+2 )
		cComment = PrepareSQLtxt( '','Comment',100)
		cProcess_ID	= "PartRecv"
		cProcessor = "Shop"
		cAllowSub = 'Y'
		nPPc	= PrepareSQLnum(0,'pPC',-3)
		nPFT	= PrepareSQLnum(0,'pFt',-5)
		nPU		= PrepareSQLnum(0,'PU',-1)
		nQTY	= 0
		nPounds	= 0
		nID_Detail			= 0
		nID_Detail_Process	= 0
		nReceivingID	= 0
		nWO				= 0
		
		**********************************
		PRIVATE lDeleteProcess
		lDeleteProcess = .F.
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = "SELECT * "
		IF lStockLst
			cSQL = cSQL + " FROM dbo.StockLst_Process "
		ELSE
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		ENDIF
		
		cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='PartRecv')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStkProc')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStkProc')
		ENDIF
			
		IF USED('tmpStkProc')	
			IF RECCOUNT('tmpStkProc') > 0
				cSOitem	= PrepareSQLtxt(tmpStkProc.SOitem,'SOitem',-10)
				cPOitem	= PrepareSQLtxt(tmpStkProc.PO_item,'POitem',12)
				cSalesPerson = PrepareSQLtxt(tmpStkProc.SalesPerson,'SalesPerson',20)
				dStartDate = PrepareSQLdate(tmpStkProc.StartDate,'StartDate')
				dDueDate = GetLatestDate( PrepareSQLdate(tmpStkProc.DueDate,'DueDate'), DATE()+2 )
				cComment = PrepareSQLtxt( tmpStkProc.Comment,'Comment',100)
				cProcess_ID	= "PartRecv"
				cProcessor = "Shop"
				cAllowSub = 'Y'
				*nPWeight
				nPPc	= PrepareSQLnum(tmpStkProc.PPC,'pPC',-3)
				nPFT	= PrepareSQLnum(tmpStkProc.pFT,'pFt',-5)
				nPU		= PrepareSQLnum(tmpStkProc.PU,'PU',-1)
				*nQTY	
				*nPounds
				nID_Detail			= 0
				nID_Detail_Process	= 0
				*nReceivingID
				nWO		= PrepareSQLnum(tmpStkProc.WO,'WO',-3)
				lDeleteProcess = .T.
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		***********************************	
		* Delete INCOMING Process
		IF lDeleteProcess 
			cSQL = " DELETE "
			IF lStockLst
				cSQL = cSQL + " FROM dbo.StockLst_Process "
			ELSE
				cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			ENDIF
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
			cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='PartRecv')"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			ENDDO
			
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		************
		*Retrieve PO QTY else use PartRecv
		
		IF USED('tmpPOqty')	
			USE IN tmpPOqty
		ENDIF
		
		cSQL = " SELECT Order_QTY, Order_PU "
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOqty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOqty')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOqty')
		ENDIF
		
		IF USED('tmpPOqty')
			IF RECCOUNT('tmpPOqty') > 0
				nPoQTY = PrepareSQLnum(tmpPOqty.Order_QTY,'Order_QTY',-5)
				IF nPU = 0
					nPU = PrepareSQLnum(tmpPOqty.Order_PU,'Order_PU',-1)
				ENDIF
			ENDIF
			USE IN tmpPOqty
		ENDIF
		
		
		********************
		*Get weight
		DO CASE
		CASE nPU = 1
			nPounds = nQTY_Diff
		CASE nPU = 2
			*QTY is Feet
			nPounds = 0
		CASE nPU = 3
			*QTY is PC
			nPounds = 0
		ENDCASE
			
		
		********************
		*Create new Stock\Broker record for new Partial Receive!
		*
		*Create Master
		*
		
		***********************
		*CREATE Detail
		*
		
		***********************
		*Create Process Partial
		
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		IF lStockLst
			cSQLi = "EXEC dbo.p_StockLst_Process_ins5 "		
		ELSE
			cSQLi = "EXEC dbo.p_BrokerLst_Process_ins5 "
		ENDIF
		
		cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""		&&The computer does not Select ID_Detail, should be 0
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@StartDate = '"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"		&&cAllowSub = 'Y'
		cSQLi = cSQLi + ",@PU = "+STR(nPU)
		cSQLi = cSQLi + ",@QTY = "+STR(nQTY,18,4)
		cSQLi = cSQLi + ",@Pounds= "+STR(nPounds,9,1)
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		
		cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"   &&cProcess_ID	= "PartRecv"
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"		&&cProcessor = "Shop"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID= "+STR(nReceivingID)+""		&&Should be 0
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
			TrackError("p_StockLst_Process_ins5",PrepareSQLtxt(cSQLi,"cSQL",-1),"Receive_Edit.Receiving_Create_Incoming_Process()",LINENO())
		ELSE
			*PRIVATE cText
			*cText = "INFO: Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID))+' Receive_Edit.ReceivingSaveID_Master'+"ProcessID="+STR(tmpID_Detail_Process.EXP)+" StockTable="+cStockTable+" PO item="+cPOitem
			*MESSAGEBOX( "Created Process"+CHR(13)+"ProcessID="+STR(tmpID_Detail_Process.EXP)+CHR(13)+"StockTable="+pStockTable+CHR(13)+"PO item="+pPOitem,0+48,"INFO: Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID)) )
			*TrackMess(cText)
			*\Progs\ErrorHandlerlog(0,"ProcessID="+STR(tmpID_Detail_Process.EXP)+" StockTable="+pStockTable+" PO item="+pPOitem,"INFO Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID)),'Receive_Edit.ReceivingSaveID_Master',277)
		ENDIF
		
		 	
		
		
		*****
		ThisFormSet.lReturn = 1
		ThisForm.Release
		ThisFormSet.Release
	ENDPROC

	PROCEDURE frmReceived_Ordered.cmdCancel.Valid
		IF MESSAGEBOX("Are you sure you want to Abort this receive?",4+32,"Cancel")=6
		*	ThisFormSet.frmReceived_Ordered.lReturn = 0
			thisformSet.lReturn=0
			ThisForm.Release
			ThisFormSet.Release
			
		ENDIF
		
	ENDPROC

	PROCEDURE frmReceived_Ordered.cmdGood.Valid
		**Not Complete
		
		PRIVATE nQTY_Diff, nOrder_QTY, nMess, nPastTotal, nActualW, lCreatePartRecv 
		nQTY_Diff = PrepareSQLnum(ThisForm.txtQTY_Diff.Value,'QTY_Diff',9,1)
		nOrder_QTY 	= PrepareSQLnum(ThisForm.txtOrder_QTY.Value,'Order_QTY',9,1)
		nPastTotal 	= PrepareSQLnum(ThisForm.txtPastTotal.Value,'PastTotal',9,1)
		nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)
		lCreatePartRecv = .F.
		
		IF (( nPastTotal + nActualW +100 ) < (nOrder_QTY+100) * 1.2 ) AND (( nPastTotal + nActualW + 100 ) > (nOrder_QTY+100) / 1.2)
			nMess = MESSAGEBOX("The Quantity Ordered to Quantity Received is real the close!"+CHR(13)+CHR(13)+;
			"Are you sure you DO NOT want to mark this as a COMPLETE Receive?"+CHR(13)+;
			"Answer No here to go back and mark as COMPLETE."+CHR(13)+;
			"Answer Yes to continue as 'UN COMPLETE'."+CHR(13),4+32,"Not Completed?")
			IF nMess != 6
				RETURN .F.
			ELSE
				lCreatePartRecv = .T.
				TrackMess("The POitem: '"+ThisFormSet.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nOrder_QTY))+"."+CHR(13)+"The QTY this Received is "+ALLTRIM(STR(nActualW))+"."+CHR(13)+"The total QTY Received is "+ALLTRIM(STR(nPastTotal))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisFormSet.nReceivingID))+"." +CHR(13)+"User override the 15% 'looks complete' message and saved as NOT complete.")
			ENDIF
		ENDIF
		
		**************************
		*Check POStatus
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOStat')	
			USE IN tmpPOStat
		ENDIF
		
		cSQL = 		  " SELECT POStatus, 'S' AS TBL "
		cSQL = cSQL + " FROM dbo.StockLst_Master "
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT POStatus, 'B' AS TBL "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master "
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOStat')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOStat')
		ENDIF
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor, lStockLst
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		lStockLst = .F.
		
		IF USED('tmpPOStat')	
			IF RECCOUNT('tmpPOStat') > 0
				IF tmpPOStat.TBL = 'S'
					lStockLst = .T.
				ENDIF
				
				cPOStatus = PrepareSQLtxt(tmpPOstat.POStatus,'POStatus',1)
				
				SCAN
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatus = "Due In"
						lDueIn = .T.
					CASE cPOStatus = "P"	
						cPOStatus = "Partial Receive"
						lPartialReceive = .T.
					CASE cPOStatus = "W"	
						cPOStatus = "Waiting for Bill"
						lWaitingforBill = .T.
					CASE cPOStatus = "A"	
						cPOStatus = "Accounted for"
						lAccountedfor = .T.
					ENDCASE
				ENDSCAN
			ENDIF
			USE IN tmpPOStat
		ENDIF
		
		**********************
		PRIVATE nMess, lClearIncomingProcess, lIncoming
		nMess = 0
		
		lClearIncomingProcess = .F.
		lIncoming = .F.
		
		IF lAccountedfor 
			*Do Nothing
			lClearIncomingProcess = .T.
		ELSE
			IF lWaitingforBill 
				*Do Nothing
				lCreatePartRecv = .T.
			ELSE
				IF lDueIn 
					nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Due In' flag."+CHR(13)+"This POitem will still be listed as Partial Receive.",4+64,"PO status will be listed as 'Partial Receive'.")
				ELSE
					IF lPartialReceive 
						nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will still be listed as Partial Receive.",4+64,"PO status will be listed as 'Partial Receive'.")		
					ENDIF
				ENDIF
				IF nMess = 6
					lCreatePartRecv = .T.
					IF lStockLst
						cSQL = " UPDATE dbo.StockLst_Master "
					ELSE
						cSQL = " UPDATE dbo.BrokerLst_Master "
					ENDIF
					cSQL = cSQL + " SET POStatus = 'P'"
					cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					ENDDO
					
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
					ELSE 
						*MESSAGEBOX(cSQL,0,"Success")
		
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		***********************
		PRIVATE nPoQTY
		nPoQTY = 0 
		PRIVATE nIncoming_OrigQTY
		nIncoming_OrigQTY = 0
		
		IF lCreatePartRecv
		*!*		PRIVATE cSOitem,cPOitem,cSalesPerson,dStartDate,dDueDate,cComment,cProcess_ID
		*!*	    PRIVATE cProcessor,cAllowSub,nPWeight,nPPc,nPFT,nPU,nQTY,nPounds
		*!*		PRIVATE nID_Detail ,nID_Detail_Process ,nReceivingID ,nWO
			
			*How much is still expected
			*nQTY_Diff
			
			IF USED('tmpStkProc')	
				USE IN tmpStkProc
			ENDIF
		
			cSQL = " SELECT QTY, Process_ID, 'Process' AS Process, 0 AS QTY_Due "
			IF lStockLst
				cSQL = cSQL + " FROM dbo.StockLst_Process "
			ELSE
				cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			ENDIF
			cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
			cSQL = cSQL + " UNION"
			cSQL = cSQL + " SELECT QTY, Process_ID, 'Orig' AS Process, QTY_Due "
			IF lStockLst
				cSQL = cSQL + " FROM dbo.StockLst_Process_Orig "
			ELSE
				cSQL = cSQL + " FROM dbo.BrokerLst_Process_Orig "
			ENDIF
			cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStkProc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStkProc')
			ENDDO
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOStat')
			ENDIF
		
			IF USED('tmpStkProc')
				IF RECCOUNT('tmpStkProc') > 0
					PRIVATE nAddQTY, lFoundPartial
					nAddQTY = 0 
					lFoundPartial = .F.
					SCAN
						IF Process = 'Orig'
							lFoundPartial = .T.
						ENDIF
					ENDSCAN
		
					nIncoming_OrigQTY = 0
					
					LOCATE FOR Process_ID = 'INCOMING' AND Process = 'Orig' 
					IF FOUND()	
						nIncoming_OrigQTY = tmpStkProc.QTY
					ENDIF
					
					SCAN
						IF lFoundPartial 
							*IF tmpStkProc.Process_ID = 'INCOMING' AND tmpStkProc.Process = 'Orig' 
							*	nAddQTY = nAddQTY  + tmpStkProc.QTY
							*	lIncoming = .T.
							*ENDIF
							*IF tmpStkProc.Process_ID = 'PartRecv' AND tmpStkProc.Process = 'Orig' 
							*	nAddQTY = nAddQTY  - tmpStkProc.QTY
							*ENDIF				
						ELSE
							IF tmpStkProc.Process_ID = 'INCOMING' AND tmpStkProc.Process = 'Process' 
								nAddQTY = nAddQTY  + tmpStkProc.QTY
								lIncoming = .T.
							ENDIF
							IF tmpStkProc.Process_ID = 'PartRecv' AND tmpStkProc.Process = 'Process' 
								nAddQTY = nAddQTY  + tmpStkProc.QTY_Due
							ENDIF
						ENDIF				
					ENDSCAN
				ENDIF
				USE IN tmpStkProc
			ENDIF
			
			***
			*Calc INCOMING and PartRecv
			IF nIncoming_OrigQTY > 0
				*Needs to be what is still DUE 
				nAddQTY = nIncoming_OrigQTY - nAddQTY  
			ELSE
				nAddQTY = nAddQTY 
			ENDIF
			
			
		
			********************************
			*Show Expanded screen and ask for Details
			ThisFormSet.frmReceived_Ordered.Visible = .F.
			ThisFormSet.frmPartial.Visible = .T.
			
			ThisFormSet.frmPartial.txtAlloyPOP.Value	= ThisFormSet.frmReceived_Ordered.txtalloyPO.Value
			ThisFormSet.frmPartial.txtFormP.Value 	= ThisFormSet.frmReceived_Ordered.txtForm.Value
			ThisFormSet.frmPartial.txtThckP.Value		= ThisFormSet.frmReceived_Ordered.txtThck.Value
			ThisFormSet.frmPartial.txtSz2P.Value		= ThisFormSet.frmReceived_Ordered.txtSz2.Value
			ThisFormSet.frmPartial.txtSz3P.Value		= ThisFormSet.frmReceived_Ordered.txtSz3.Value
			
			ThisFormSet.frmPartial.txtPiecesP.Value	= ThisFormSet.frmReceived_Ordered.txtPieces.Value
			ThisFormSet.frmPartial.txtOrder_QTYP.Value= ThisFormSet.frmReceived_Ordered.txtQTY_Diff.Value
			
		ENDIF
			
		
	ENDPROC

	PROCEDURE frmReceived_Ordered.cmdGoodCmplt.Valid
		PRIVATE nQTY_Diff, nOrder_QTY, nMess, nPastTotal, nActualW
		nQTY_Diff = PrepareSQLnum(ThisForm.txtQTY_Diff.Value,'QTY_Diff',9,1)
		nOrder_QTY 	= PrepareSQLnum(ThisForm.txtOrder_QTY.Value,'Order_QTY',9,1)
		nPastTotal 	= PrepareSQLnum(ThisForm.txtPastTotal.Value,'PastTotal',9,1)
		nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)
		
		IF (( nPastTotal + nActualW +100) * 1.2 < (nOrder_QTY+100) ) OR (( nPastTotal + nActualW + 100 ) > (nOrder_QTY+100) * 1.2 )
			nMess = MESSAGEBOX("The Quantity Ordered to Quantity Received is more the 15% off!"+CHR(13)+CHR(13)+"Are you sure you want to make this as a COMPLETE receive?",4+32,"Complete?")
			IF nMess != 6
				RETURN .F.
			ELSE
				TrackMess("The POitem: '"+ThisFormSet.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nOrder_QTY))+"."+CHR(13)+"The QTY this Received is "+ALLTRIM(STR(nActualW))+"."+CHR(13)+"The total QTY Received is "+ALLTRIM(STR(nPastTotal))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisFormSet.nReceivingID))+"." +CHR(13)+"User override the 15% Error message and saved as complete.")
			ENDIF
		ENDIF
		
		**************************
		*Check POStatus
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOStat')	
			USE IN tmpPOStat
		ENDIF
		
		cSQL = 		  " SELECT POStatus, 'S' AS TBL "
		cSQL = cSQL + " FROM dbo.StockLst_Master "
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT POStatus, 'B' AS TBL "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master "
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOStat')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOStat')
		ENDIF
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor, lStockLst
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		lStockLst = .F.
		
		IF USED('tmpPOStat')	
			IF RECCOUNT('tmpPOStat') > 0
				IF tmpPOStat.TBL = 'S'
					lStockLst = .T.
				ENDIF
				
				cPOStatus = PrepareSQLtxt(tmpPOstat.POStatus,'POStatus',1)
				
				SCAN
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatus = "Due In"
						lDueIn = .T.
					CASE cPOStatus = "P"	
						cPOStatus = "Partial Receive"
						lPartialReceive = .T.
					CASE cPOStatus = "W"	
						cPOStatus = "Waiting for Bill"
						lWaitingforBill = .T.
					CASE cPOStatus = "A"	
						cPOStatus = "Accounted for"
						lAccountedfor = .T.
					ENDCASE
				ENDSCAN
			ENDIF
			USE IN tmpPOStat
		ENDIF
		
		**********************
		PRIVATE nMess, lClearIncomingProcess
		nMess = 0
		lClearIncomingProcess = .F.
		
		IF lAccountedfor 
			*Do Nothing
			lClearIncomingProcess = .T.
		ELSE
			IF lWaitingforBill 
				*Do Nothing
				lClearIncomingProcess = .T.
			ELSE
				IF lDueIn 
					nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Due In' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Due In'.",4+64,"PO status will be listed as Complete.")
				ELSE
					IF lPartialReceive 
						nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"PO status will be listed as Complete.")		
					ENDIF
				ENDIF
				IF nMess = 6
					lClearIncomingProcess = .T.
					IF lStockLst
						cSQL = " UPDATE dbo.StockLst_Master "
					ELSE
						cSQL = " UPDATE dbo.BrokerLst_Master "
					ENDIF
					cSQL = cSQL + " SET POStatus = 'W'"
					cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					ENDDO
					
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
					ELSE 
						*MESSAGEBOX(cSQL,0,"Success")
		
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		***********************
		IF lClearIncomingProcess
			cSQL = " DELETE "
			IF lStockLst
				cSQL = cSQL + " FROM dbo.StockLst_Process "
			ELSE
				cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			ENDIF
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
			cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='PartRecv')"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			ENDDO
			
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		*****
		ThisFormSet.lReturn = 2
		ThisForm.Release
		ThisformSet.Release
		
	ENDPROC

	PROCEDURE frmReceived_Ordered.cmdJustEdit.Valid
		**************************
		*Check POStatus
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOStat')	
			USE IN tmpPOStat
		ENDIF
		
		cSQL = 		  " SELECT POStatus, 'S' AS TBL "
		cSQL = cSQL + " FROM dbo.StockLst_Master "
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT POStatus, 'B' AS TBL "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master "
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOStat')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOStat')
		ENDIF
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor, lStockLst
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		lStockLst = .F.
		
		IF USED('tmpPOStat')	
			IF RECCOUNT('tmpPOStat') > 0
				IF tmpPOStat.TBL = 'S'
					lStockLst = .T.
				ENDIF
				
				cPOStatus = PrepareSQLtxt(tmpPOstat.POStatus,'POStatus',1)
		
				SCAN
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatus = "Due In"
						lDueIn = .T.
					CASE cPOStatus = "P"	
						cPOStatus = "Partial Receive"
						lPartialReceive = .T.
					CASE cPOStatus = "W"	
						cPOStatus = "Waiting for Bill"
						lWaitingforBill = .T.
					CASE cPOStatus = "A"	
						cPOStatus = "Accounted for"
						lAccountedfor = .T.
					ENDCASE
				ENDSCAN
			ENDIF
			USE IN tmpPOStat
		ENDIF
		
		**********************
		PRIVATE nMess
		nMess = 0
		
		IF lAccountedfor 
			*Do Nothing
		ELSE
			IF lWaitingforBill 
				*Do Nothing
			ELSE
				IF lDueIn 
					nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Due In' flag."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"If you know otherwise click (N) to mark as complete."+CHR(13)+"Yes to ignore.",4+64,"No need to change PO status.")
				ELSE
					IF lPartialReceive 
						nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"If you know otherwise click (N) to mark as complete."+CHR(13)+"Yes to ignore.",4+64,"No need to change PO status.")		
					ENDIF
				ENDIF
				IF nMess = 6
					IF lStockLst
						cSQL = " UPDATE dbo.StockLst_Master "
					ELSE
						cSQL = " UPDATE dbo.BrokerLst_Master "
					ENDIF
					cSQL = cSQL + " SET POStatus = 'W'"
					cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					ENDDO
					
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
					ELSE 
						*MESSAGEBOX(cSQL,0,"Success")
		
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		
		
		*****
		ThisFormSet.lReturn = 1
		ThisForm.Release
		ThisFormSet.Release
		
		
	ENDPROC

