	PROCEDURE grdSales_No.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Refresh_SalesNo(ChooseSales_No.SalesNum)
		
	ENDPROC

	PROCEDURE grd_SOitem.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Refresh_SOitem()
	ENDPROC

	PROCEDURE lblSalesNumber.Click
		PRIVATE nSalesNum
		nSalesNum = PrepareSQLnum(ChooseSales_No.SalesNum,'SalesNum',-3)
		IF nSalesNum > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_SO(nSalesNum,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE txtSalesOrder.Valid
		IF !EMPTY(THIS.Value)
			*ThisForm.cmdFind.Click
			SELECT ChooseSales_No
			*SEEK THIS.Value ORDER SalesNum
			LOCATE FOR SalesNum = This.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				THIS.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
			ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

ENDDEFINE
