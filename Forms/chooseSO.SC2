	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pWhat
		*DO FORM Forms\ChooseSO WITH "ChooseSO" TO nSO
		*ThisForm.pWhat = "ChooseSO"
		*ThisForm.pWhat = "ReviewSO"
		
		IF VARTYPE(pWhat) = "C"
			ThisForm.pWhat = pWhat
		ELSE
			ThisForm.pWhat = ''
		ENDIF
		ThisForm.HoldNumber = 0
		
		DO CASE
		CASE ThisForm.pWhat = "ChooseSO"
		CASE ThisForm.pWhat = "ReviewSO"
			**already in persuit of SOi review
		*	ThisForm.cmdReviewSOi.Visible = .F.
			ThisForm.Load_Sales_No(-1)
			ThisForm.grdSales_No.RecordSource='ChooseSales_No'
		
		OTHERWISE
		ENDCASE
		
		ThisForm.RefreshScreen()
		ThisForm.Refresh_SalesNo()
		
		ThisForm.txtSalesOrder.SetFocus
		
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLstringCONNECT()
		
		ThisForm.Load_Sales_No(0)
		
		
	ENDPROC

	PROCEDURE load_sales_no
		PARAMETERS pnSalesNum
		*ThisForm.Load_Sales_No()
		PRIVATE nSalesNum
		nSalesNum = PrepareSQLnum(pnSalesNum,'SalesNum',-3)
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("ChooseSales_No")
			ThisForm.grdSales_No.RecordSource = ''
			USE IN ChooseSales_No
			
		ENDIF
		SELECT 0
		
		cSQL="SELECT SN.SalesNum,SN.ItemTot,SN.SalesRep,SN.pShipAddr,SN.pSoldAddr,SN.ShipRoute,SN.ShipPay,SN.PayType "
		
		cSQL=cSQL+" ,CASE WHEN (SELECT SUM(CAST(ISNULL(Hold,0) AS INT)) "
		cSQL=cSQL+" FROM dbo.Sales S WITH(NOLOCK) WHERE S.SalesNum = SN.SalesNum)=0 THEN 0 ELSE 1 END AS Hold "
		
		cSQL=cSQL+" ,ISNULL((SELECT TOP 1 What FROM dbo.Sales_Hold_Status SH WHERE SH.SalesNum = SN.SalesNum ),'') AS What "
		
		cSQL=cSQL+" ,CASE WHEN (SELECT SUM(CAST(ISNULL(Hold,0) AS INT)) "
		cSQL=cSQL+" FROM dbo.Sales S WITH(NOLOCK) WHERE S.SalesNum = SN.SalesNum)=0 THEN '' ELSE "
		cSQL=cSQL+" ( SELECT TOP 1 ISNULL(What,'') FROM dbo.Sales_Hold_Status SH WHERE SH.SalesNum = SN.SalesNum )"
		cSQL=cSQL+" END AS WhyHold "
		 
		cSQL=cSQL+" FROM dbo.Sales_No SN WITH(NOLOCK) "
		
		IF nSalesNum = -1
			cSQL=cSQL+" WHERE SN.SalesNum IN ( "
			cSQL=cSQL+" SELECT DISTINCT SalesNum FROM dbo.Sales WHERE ISNULL(Review,0) = 0 "
			cSQL=cSQL+" AND ISNULL(cncld,0) = 0 AND ISNULL(cmplt,0) = 0 "
			cSQL=cSQL+" ) "
		ENDIF
		cSQL=cSQL+" ORDER BY SN.SalesNum DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ChooseSales_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ChooseSales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ChooseSales_No' )
		ENDIF
		
		
		IF USED('ChooseSales_No')
			SELECT ChooseSales_No
			IF nSalesNum > 0
				LOCATE FOR SalesNum = nSalesNum
			ELSE
				GO TOP
				IF RECCOUNT() > 8
					SKIP 8
				ENDIF
			ENDIF
			
		ELSE
			MESSAGEBOX("Could not load 'Sales_No'",0,"SQL Error")
			RETURN TO MASTER
		ENDIF
		
		**called from Load, before Init runs.
	ENDPROC

	PROCEDURE refreshscreen
		ThisForm.txtSalesNum.Refresh
		ThisForm.txtSalesRep.Refresh
		ThisForm.txtpShipAddr.Refresh
		ThisForm.txtpSoldAddr.Refresh
		ThisForm.txtShipRoute.Refresh
		ThisForm.txtShipPay.Refresh
		ThisForm.txtPayType.Refresh
		ThisForm.txtItemTot.Refresh
		ThisForm.chkHold.Refresh
		ThisForm.txtWhyHold.Refresh
	ENDPROC

	PROCEDURE refresh_salesno
		PARAMETERS pSalesNum
		*ThisForm.Refresh_SalesNo()
		
		PRIVATE nSalesNum
		IF VARTYPE(pSalesNum)="N"
			nSalesNum = pSalesNum
		ELSE
			nSalesNum = ThisForm.txtSalesNum.Value
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpSOitem")
			ThisForm.grd_SOitem.RecordSource = ''
			
			USE IN tmpSOitem
		ENDIF
		SELECT 0
		
		cSQL="SELECT S.SOitem, ISNULL(S.RVW_Stock,0) AS RVW_Stock, ISNULL(S.RVW_Prod,0) AS RVW_Prod, S.Review_Date "
		cSQL=cSQL+" ,S.ShipDue, S.cncld, S.cmplt, S.WO, S.PT_Total "
		cSQL=cSQL+" ,dbo.f_DescriptCL(AQ.Alloy,AQ.CC,AQ.CL,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS DescriptCL "
		cSQL=cSQL+" FROM dbo.Sales S WITH(NOLOCK) "
		cSQL=cSQL+" inner join dbo.AllQuotes AQ WITH(NOLOCK) ON S.SOitem=AQ.SOitem "
		cSQL=cSQL+" WHERE S.SalesNum = "+STR(nSalesNum)
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitem' )
		ENDIF
		
		
		IF USED('tmpSOitem')
			SELECT tmpSOitem
			ThisForm.grd_SOitem.RecordSource = 'tmpSOitem'
			ThisForm.grd_SOitem.Refresh
			
			ThisForm.Refresh_SOitem()
			
		ENDIF
		
		
		
		ThisForm.RefreshScreen()
		
		
		
	ENDPROC

	PROCEDURE refresh_soitem
		*ThisForm.Refresh_SOitem()
		
		ThisForm.txtDescript.Value = tmpSOitem.DescriptCL
		ThisForm.chkRVW_Stock.Value	= tmpSOitem.RVW_Stock
		ThisForm.chkRVW_Prod.Value	= tmpSOitem.RVW_Prod
		
		ThisForm.txtReview_Date.Value = IIF( ISNULL(tmpSOitem.Review_Date), '', tmpSOitem.Review_Date )
		
		ThisForm.chkCncld.Value = tmpSOitem.cncld
		ThisForm.chkCmplt.Value = tmpSOitem.cmplt
		
		ThisForm.txtShipDue.Value = tmpSOitem.ShipDue
		ThisForm.txtWO.Value = tmpSOitem.WO
		
		ThisForm.txtPT_Total.Value = PrepareSQLnum(tmpSOitem.PT_Total,'Total',9,2)
		
	ENDPROC

	PROCEDURE Unload
		IF USED('ChooseSales_No')
			USE IN ChooseSales_No
		ENDIF
		
		IF USED("Quotes")
			USE IN Quotes
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		IF ThisForm.pWhat = "ChooseSO"
			RETURN ThisForm.HoldNumber
		ENDIF
		IF ThisForm.pWhat = "ReviewSO"
			RETURN ThisForm.HoldNumber
		ENDIF
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdEditHoldStatus.Click
		
		PRIVATE nSalesNum, cSOitem
		nSalesNum = PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		cSOitem = Proper_SO_item( ALLTRIM(STR(nSalesNum))+"-01")
		
		IF nSalesNum > 0
			DO FORM Forms\SOitem_Status WITH cSOitem,ThisForm.nConnHandle
		ENDIF
		
		
		*MESSAGEBOX("This screen does not show individual items."+CHR(13)+"The next window will let you choose by Item",64,"Please use next sreen.")
		*DO FORM Forms\Select_SO-item WITH nSO
		
	ENDPROC

	PROCEDURE cmdFind.Click
		IF ThisForm.txtSalesOrder.Value > 0
			SELECT ChooseSales_No
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			LOCATE FOR SalesNum = ThisForm.txtSalesOrder.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				ThisForm.txtSalesOrder.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
			ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
			IF VARTYPE(ThisForm.grdSales_No.clmSO)="O"
				ThisForm.grdSales_No.clmSO.SetFocus()
			ELSE
				MESSAGEBOX("Lost the SalesOrder table"+CHR(13)+"Restart the App.",0,"Error")
			ENDIF
		ELSE
			WAIT WINDOW "Enter Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdItem.Click
		
		PRIVATE nSO
		nSO = PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		DO FORM Forms\Select_SO-item WITH nSO
	ENDPROC

	PROCEDURE cmdRefresh.Click
		ThisForm.Load_Sales_No(ThisForm.txtSalesNum.Value)
		
		ThisForm.grdSales_No.RecordSource='ChooseSales_No'
		ThisForm.grdSales_No.SetFocus()
		ThisForm.Refresh_SalesNo()
	ENDPROC

	PROCEDURE cmdRefresh_UnReviewed.Click
		ThisForm.Load_Sales_No(-1)
		*SELECT DISTINCT SalesNum FROM dbo.Sales WHERE ISNULL(Review,0) = 0 AND ISNULL(cncld,0) = 0 AND ISNULL(cmplt,0) = 0
		ThisForm.grdSales_No.RecordSource='ChooseSales_No'
		ThisForm.grdSales_No.SetFocus()
		ThisForm.Refresh_SalesNo()
	ENDPROC

	PROCEDURE cmdReviewSOi.Click
		PRIVATE cSOitem
		cSOitem = tmpSOitem.SOitem
		PRIVATE lCncld, lCmplt
		*ThisForm.chkRVW_Stock.Value
		*ThisForm.chkRVW_Prod.Value
		lCncld = PrepareSQLlogic(ThisForm.chkCncld.Value,'cncld',.F.)
		lCmplt = PrepareSQLlogic(ThisForm.chkCmplt.Value,'cmplt',.F.)
		
		IF ThisForm.pWhat = "ReviewSO"
			ThisForm.HoldNumber = tmpSOitem.SOitem
			ThisForm.Release
		ELSE
			IF NOT lCncld 
				IF NOT lCmplt
					DO FORM forms\Sales_Review WITH tmpSOitem.SOitem
					ThisForm.Refresh_SalesNo()
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF ThisForm.pWhat = "ChooseSO" OR ThisForm.pWhat = "ReviewSO"
			ThisForm.HoldNumber = Choosesales_No.SalesNum
			ThisForm.Release
		ELSE
			ThisForm.HoldNumber = Choosesales_No.SalesNum
			ThisForm.Visible = .F.
			
			WAIT WINDOW "Getting Selected SO..." NOWAIT
			
			PRIVATE cSQL, nSQLEXEC
		
			IF USED("Quotes")
				SELECT Quotes
			ELSE
				SELECT 0
			ENDIF
		
			cSQL="SELECT * FROM dbo.AllQuotes WHERE SalesNum = "+ALLTRIM(STR(ChooseSales_No.Salesnum))
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Quotes')
			ENDIF
			
			DO FORM Forms\EDITSALESORDER WITH ChooseSales_No.Salesnum
			*DO FORM Forms\EditSalesOrder WITH ChooseSales_No.Salesnum
			
			ThisForm.Visible = .T.
			ThisForm.Load_Sales_No(ThisForm.HoldNumber)
			ThisForm.grdSales_No.RecordSource='ChooseSales_No'
			ThisForm.Refresh_SalesNo()
			
		ENDIF
	ENDPROC

	PROCEDURE cmdViewTrack.Click
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpSOtrack")
			SELECT tmpSOtrack
		ELSE
			SELECT 0
		ENDIF
		
		nSalesNum = ChooseSales_No.Salesnum
		
		cSQL = "Select mess1, errordate, Machine FROM dbo.NR_UserTrack WHERE mess1 LIKE '%"+ ALLTRIM(STR(nSalesNum)) +"%' "
		cSQL = cSQL + " AND mess1 NOT LIKE 'Quote was cloned to %'"
		cSQL = cSQL + " ORDER BY ErrorDate DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOtrack')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOtrack')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOtrack")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOtrack")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOtrack')
		ENDIF
		
		IF USED('tmpSOtrack')
			IF RECCOUNT('tmpSOtrack') > 0
				BROWSE
			ELSE
				MESSAGEBOX("Not Found",64,"No Data")
			ENDIF
		ENDIF
			
		
	ENDPROC

