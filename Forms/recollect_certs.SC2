	PROCEDURE frmRecollectCerts.cmdERPCert.Click
		
		PRIVATE cHeat,nLot,cLot,cType
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',40))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		
		IF "HPA " $ UPPER(cLot)
			cLot = SUBSTR(UPPER(cLot),AT("HPA ",UPPER(cLot))+4)
		ENDIF
		IF "HPA" $ UPPER(cLot)
			cLot = SUBSTR(UPPER(cLot),AT("HPA",UPPER(cLot))+3)
		ENDIF
		
		DO CASE 
		CASE cLot = "G"
			cType = "GFM"
			nLot  = VAL(SUBSTR(cLot,AT("G",UPPER(cLot))+1))
		CASE cLot = "R"
			cType = "ROLL"
			nLot  = VAL(SUBSTR(cLot,AT("R",UPPER(cLot))+1))
		CASE cLot = "L"
			cType = "LakeErie"
			nLot  = VAL(SUBSTR(cLot,AT("L",UPPER(cLot))+1))
		OTHERWISE
			cType = ''
			nLot  = VAL(ALLTRIM(cLot))
		ENDCASE
			
			
		*DO FORMS\Certs WITH cHEAT, nLOT, cType
		DO FORM forms\SQL_certs.scx WITH cHEAT, cLOT, cType
		
		
		
		
		
		
	ENDPROC

