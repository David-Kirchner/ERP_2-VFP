		Declare Integer ShellExecute In shell32.Dll ;
		   INTEGER hndWin, ;
		   STRING cAction, ;
		   STRING cFileName, ;
		   STRING cParams, ;
		   STRING cDir, ;
		   INTEGER nShowWin
		   
		   ShellExecute(0,"open",cFileName,"","",1)
		   
