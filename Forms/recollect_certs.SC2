	PROCEDURE Init
		PARAMETER pAlloy,pForm,pThck,pHeat,pLot,pnID,pnConn
		*DO FORM "forms\Recollect_Certs.scx" WITH 'C-276','40',2.5,'Z12345','',0,0
		*DO FORM "forms\Recollect_Certs.scx" WITH pAlloy,pForm,pThck,pHeat,pLot,pnID,pnConn
		
		**************************************************************************
		*This Form lives as a Window in Shop_StockLst_Edit - Repeat edit there.
		**************************************************************************
		
		PUBLIC nCertImage1
		nCertImage1 = ''
		PUBLIC ARRAY aCertImage(1)
		
		
		
		IF TYPE("pAlloy")="C"
			ThisFormSet.frmRecollectCerts.txtAlloy.Value = pAlloy
		ELSE
			ThisFormSet.frmRecollectCerts.txtAlloy.Value = ""
		ENDIF
		
		IF TYPE("pForm")="C"
			ThisFormSet.frmRecollectCerts.txtForm.Value = pForm
		ELSE
			ThisFormSet.frmRecollectCerts.txtForm.Value = ""
		ENDIF
		
		IF TYPE("pThck")="N"
			ThisFormSet.frmRecollectCerts.txtThck.Value = pThck
		ELSE
			ThisFormSet.frmRecollectCerts.txtThck.Value = 0.0000
		ENDIF
		
		IF TYPE("pHeat")="C"
			ThisFormSet.frmRecollectCerts.txtHeat.Value = pHeat
		ELSE
			ThisFormSet.frmRecollectCerts.txtHeat.Value = ""
		ENDIF
		
		IF TYPE("pLot")="C"
			ThisFormSet.frmRecollectCerts.txtLot.Value = pLot
		ELSE
			ThisFormSet.frmRecollectCerts.txtLot.Value = ""
		ENDIF
		
		IF TYPE("pnID")="N"
			ThisFormSet.nStockLst_ID = pnID
		ELSE
			ThisFormSet.nStockLst_ID = 0
		ENDIF
		************
		IF TYPE("pnConn")="N"
			IF pnConn > 0
				ThisFormSet.nConnHandle= pnConn
				ThisFormSet.CloseConnection = .F.
			ELSE
				ThisFormSet.nConnHandle= get_SQLSTRINGCONNECT()
				ThisFormSet.CloseConnection = .T.
			ENDIF
		ELSE
			ThisFormSet.nConnHandle= get_SQLSTRINGCONNECT()
			ThisFormSet.CloseConnection = .T.
		ENDIF
		
		IF ThisFormSet.nConnHandle< 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			RETURN .F.
			ThisFormSet.frmRecollectCerts.Release
		ENDIF
		************
		*ThisFormSet.frmRecollectCerts.Desktop = .T.
		*ThisFormSet.frmCerts.Desktop = .T.
		
		
		ThisFormSet.frmRecollectCerts.AlwaysOnTop = .T.
		ThisFormSet.frmRecollectCerts.AlwaysOnTop = .F.
		*ThisFormSet.frmCerts.AlwaysOnTop = .T.
		*ThisFormSet.frmCerts.AlwaysOnTop = .F.
		
		IF NOT EMPTY(ThisFormSet.frmRecollectCerts.txtHeat.Value) AND NOT EMPTY(ThisFormSet.frmRecollectCerts.txtThck.Value) AND NOT EMPTY(ThisFormSet.frmRecollectCerts.txtForm.Value) AND NOT EMPTY(ThisFormSet.frmRecollectCerts.txtAlloy.Value)
			ThisFormSet.frmRecollectCerts.cmdSearch.Click
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		IF ThisFormSet.CloseConnection 
			= SQLDISCONNECT( ThisFormSet.nConnHandle )
		ENDIF
		
		IF WEXIST("frmStockLst_SQL_Maint")
			ACTIVATE WINDOW frmStockLst_SQL_Maint
		ENDIF
		
		IF WEXIST("frmStockLst_SQL_Quotes")
			ACTIVATE WINDOW frmStockLst_SQL_Quotes
		ENDIF
		
		
	ENDPROC

