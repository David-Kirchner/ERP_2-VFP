	PROCEDURE frmCerts.cmdAllOutlook.Click
		
		
		IF MESSAGEBOX("Do you want to send email from Outlook?",4+64,"Email")=6
			
			TRY
			
				***************************************
				PRIVATE cFileName
				
				********************************
				#DEFINE olFolderInbox 6
				#DEFINE olFolderOutbox 4
				#DEFINE olMailItem 0
				#DEFINE olRecipient 4
				#DEFINE olRecipients 17
				#DEFINE IMPORTANCENORMAL 1
				loApp=CreateObject("Outlook.Application")
				loNamespace = loApp.GetNamespace("MAPI")
				loFolder = loNamespace.GetDefaultFolder(olFolderInbox)
				loEMailItem = loFolder.Items.Add(olMailItem)
				loEmailItem.Subject = "HPA Cert"
				loEmailItem.Importance = IMPORTANCENORMAL
				loEmailItem.HTMLBody = [<html><font face = "Arial">];
				+ [<font size = 2> <font color = 0>Space Alloys USA Cert</font></html>]
				
				FOR i = 1 TO This.Parent.lstCertImages.NumberOfElements 
					cFileName = ThisForm.txtUJC.Value +"\"+ This.Parent.lstCertImages.List(i)
					loEmailItem.Attachments.Add(cFileName)
				ENDFOR
		
				loemailitem.Display()
				*loEmailItem.Send
				*loApp.Quit()
				release loApp, loEmailItem
				
				WAIT WINDOW "Click on the blinking Outlook window to address you Email" NOWAIT
			CATCH
				MESSAGEBOX("Could not start Outlook")
			ENDTRY
			
		ENDIF
	ENDPROC

	PROCEDURE frmCerts.cmdIExplorer.Click
		PRIVATE cFileName
		cFileName = "file://" + ThisForm.txtUJC.Value +"\"+ UPPER(ThisForm.lstCertImages.List(ThisForm.lstCertImages.ListIndex))
		
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
		
		*loIE = Createobject("internetexplorer.application")
		*loIE.Visible = .T.
		*loIE.Navigate( cFileName )
		
		PRIVATE loHyperlink 
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cFileName )
		RELEASE loHyperlink
		
		
	ENDPROC

