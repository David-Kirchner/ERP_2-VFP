	PROCEDURE addrecord
		*ThisForm.AddRecord()
		PRIVATE nNewID_Sources
		nNewID_Sources = 0
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('ID_Sources')	
			USE IN ID_Sources
		ENDIF
		
		PRIVATE cCompany,nContact_ID,nVendCode
		cCompany	= PrepareSQLtxt(ThisForm.cmbCompany.Value,'Company',30)
		nContact_ID = PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		nVendCode	= PrepareSQLnum(ThisForm.VendCode1.Value,'VendCode',-3)
		
		ThisForm.cCompany = cCompany
		ThisForm.nContact_ID = nContact_ID
		ThisForm.nVendCode = nVendCode
		
		cSQL = "EXEC [dbo].[p_Sources_ins] "
		cSQL = cSQL + "@Company='"+cCompany+"'"
		cSQL = cSQL + ",@Alloy='"+' '+"'"
		cSQL = cSQL + ",@Alloy_AKA='"+' '+"'"
		cSQL = cSQL + ",@UNS='"+' '+"'"
		cSQL = cSQL + ",@Spec='"+' '+"'"
		cSQL = cSQL + ",@F10="+'0'
		cSQL = cSQL + ",@F20="+'0'
		cSQL = cSQL + ",@F30="+'0'
		cSQL = cSQL + ",@F40="+'0'
		cSQL = cSQL + ",@F60="+'0'
		cSQL = cSQL + ",@F65="+'0'
		cSQL = cSQL + ",@F70="+'0'
		cSQL = cSQL + ",@F75="+'0'
		cSQL = cSQL + ",@Notes='"+' '+"'"
		cSQL = cSQL + ",@Stk="+'0'
		cSQL = cSQL + ",@MK="+'0'
		cSQL = cSQL + ",@ID="+STR(nContact_ID)
			
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ID_Sources')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ID_Sources')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ID_Sources")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ID_Sources")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'ID_Sources')
			MESSAGEBOX('Unable to Add SQL record',0+48,'Error')
			RETURN
		ELSE
			IF USED('ID_Sources')
				IF VARTYPE(ID_Sources.EXP) = "N"
					nNewID_Sources = ID_Sources.EXP
				ENDIF
				USE IN ID_Sources
			ENDIF
		ENDIF
		
		IF nNewID_Sources > 0
			ThisForm.Reload( nNewID_Sources )
		ENDIF
		
		*Replace Fields
		ThisForm.cmbCompany.Value = cCompany
		ThisForm.ID1.Value 		= nContact_ID 
		ThisForm.VendCode1.Value = nVendCode
		
		*ThisForm.cCompany = cCompany
		*ThisForm.nContact_ID = nContact_ID
		*ThisForm.nVendCode = nVendCode
		
	ENDPROC

	PROCEDURE buttonrefresh
		* This is a generic routine which refreshes the buttons
		* for appropriate table environments.
		IF SELECT()# ThisForm.nWorkArea
			SELECT (ThisForm.nWorkArea)
		ENDIF
		
		*ThisForm.SetAllProp()
		ThisForm.cmdFind.Enabled = !ThisForm.EditMode
		ThisForm.cmdPrint.Enabled =  !ThisForm.EditMode
		ThisForm.cmdExit.Enabled =  !ThisForm.EditMode
		ThisForm.cmdDelete.Enabled =  !ThisForm.EditMode AND !ISREADONLY()
		*ThisForm.SetCaption()
	ENDPROC

	PROCEDURE filteralloyrefresh
		*ThisForm.FilterAlloyRefresh()
		
		*aFilterAlloy
		*SELECT DISTINCT Alloy FROM tmpAlloy ORDER BY Alloy INTO ARRAY aFilterAlloy
		
		ThisForm.Refresh
		
		PRIVATE cCompany
		cCompany = PrepareSQLtxt(ThisForm.cmbCompany.Value,'Company',30)
		
		
		IF USED('tmpCompAlloy')	
			USE IN tmpCompAlloy
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT DISTINCT Alloy FROM dbo.Sources WHERE Company = '"+cCompany+"' ORDER BY Alloy"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCompAlloy')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCompAlloy')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCompAlloy")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCompAlloy")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCompAlloy')
			RETURN
		ELSE
			IF USED('tmpCompAlloy')
				*PUBLIC ARRAY aAlloyAlloy(1)
				*SELECT DISTINCT Alloy FROM tmpCompAlloy ORDER BY Alloy INTO ARRAY aAlloyAlloy
				
				PUBLIC ARRAY aFilterAlloy(1)
				SELECT DISTINCT Alloy FROM tmpCompAlloy ORDER BY Alloy INTO ARRAY aFilterAlloy
				
		*		ThisForm.cmbFilterAlloy.RowSource = aFilterAlloy
				ThisForm.cmbFilterAlloy.NumberOfElements = ALEN(aFilterAlloy,1)
						
				ThisForm.cmbFilterAlloy.Value = Sources.Alloy
				
				ThisForm.cmbFilterAlloy.Refresh
				
				USE IN tmpCompAlloy
			ENDIF
		ENDIF
		
		SELECT Sources
	ENDPROC

	PROCEDURE getgridref
		* Check if we have a grid
		LOCAL aMems,nTotMem,i
		THIS.GridRef = ""
		IF TYPE("THISFORM") = "O"
			DIMENSION aMems[1]
			nTotMem = AMEMBERS(aMems,THISFORM,2)
			WITH THISFORM
				FOR i = 1 TO m.nTotMem 
					IF UPPER(EVAL("."+aMems[m.i]+".BaseClass")) = "GRID"
						THIS.GridRef = aMems[m.i]
						WITH EVAL("."+THIS.GridRef)
							* Check if we have a view and get Tag property
							THIS.ViewType = CURSORGETPROP('sourcetype',.RecordSource)
							THIS.GridAlias = .RecordSource
							IF THIS.ViewType # 3
								THIS.ViewKey = .Tag
								THIS.ParentKey = .Comment
							ENDIF
						ENDWITH				
						EXIT
					ENDIF
				ENDFOR
			ENDWITH
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		SELECT Sources
		ThisForm.cmbCompany.Value = Sources.Company
		ThisForm.cmbCompany.Refresh
	ENDPROC

	PROCEDURE initvars
								
		#DEFINE C_NOUPDATEVIEW_LOC	"Edits to one or more of the Views may not be permanent. "+;
									"To remedy this, ensure the View's Send SQL Updates checkbox is checked in the View Designer."
		#DEFINE C_READONLY_LOC		"The table is Read-Only. You will not be able to edit it."
		
		LOCAL aTablesUsed,nTablesUsed,i,aMems,nTotMem,cWizFile,lShowedMess,cDataEnvRef
		DIMENSION aTablesUsed[1]
		DIMENSION aMems[1]
		
		* This routine sets the member variables
		ThisForm.ViewKey = ""
		ThisForm.ParentKey = ""
		ThisForm.ViewType = 3
		ThisForm.GridAlias = ""
		ThisForm.TopFile = .F.
		ThisForm.EndFile = .F.
		ThisForm.AddMode = .F.
		
		ThisForm.nWorkArea = SELECT()
		ThisForm.oldSetDelete = SET("DELETED")
		SET DELETED ON
		ThisForm.oldReprocess = SET("REPROCESS")
		SET REPROCESS TO 0
		
		* These properties should not be used. They are reserved for use by
		* the Preview button of the Form Wizards.
		ThisForm.PreviewMode = IIF(TYPE("ThisForm.PreviewMode")#"L",.F.,ThisForm.PreviewMode)
		ThisForm.PreviewInit = IIF(TYPE("ThisForm.PreviewInit")#"L",.T.,ThisForm.PreviewInit)
		
		* Check for data environment
		DO CASE
		CASE TYPE("THISFORM.DataEnvironment") = "O"
			ThisForm.UseDataEnv = .T.
			nTotMem = AMEMBERS(aMems,THISFORM.DataEnvironment,2)
			cDataEnvRef = "THISFORM.DataEnvironment"
		CASE TYPE("THISFORMSET.DataEnvironment") = "O"
			ThisForm.UseDataEnv = .T.
			nTotMem = AMEMBERS(aMems,THISFORMSET.DataEnvironment,2)
			cDataEnvRef = "THISFORMSET.DataEnvironment"
			IF TYPE("THISFORM")="O" AND !THISFORM.VISIBLE 
				THISFORM.VISIBLE = .T.
			ENDIF
		OTHERWISE
			ThisForm.UseDataEnv = .F.
		ENDCASE
		
		IF ThisForm.UseDataEnv
			WITH EVAL(m.cDataEnvRef)
				* Check for relation
				FOR i = 1 TO m.nTotMem
					IF UPPER(EVAL("."+aMems[m.i]+".BaseClass")) = "RELATION"
						ThisForm.oDataRelation = m.cDataEnvRef+"."+aMems[m.i]
						EXIT
					ENDIF
				ENDFOR
				
				* Check for Views
				FOR i = 1 TO m.nTotMem
					IF UPPER(EVAL("."+aMems[m.i]+".BaseClass")) = "CURSOR"
						WITH EVAL("."+aMems[m.i])
							IF CURSORGETPROP("SourceType",.Alias)#3 AND ;
								!CURSORGETPROP("offline",.Alias)
								* Check if we need to requery for deleted records.
								* -- Note: Parameterized views are not requeried so all
								* records will be brought over. To remedy this situation
								* you can place a SET DELETED ON command in the
								* BeforeOpenTables event of the DataEnvironment.
								IF ThisForm.oldSetDelete = "OFF" AND ATC("?",CURSORGETPROP("SQL",.Alias))=0
									=REQUERY(.Alias)
								ENDIF
								* Check if updates are made
								IF !CURSORGETPROP("SendUpdates",.Alias) AND !m.lShowedMess
									=MESSAGEBOX(C_NOUPDATEVIEW_LOC)
									lShowedMess = .T.
								ENDIF
							ENDIF
						ENDWITH
					ENDIF
				ENDFOR
			ENDWITH
		ENDIF
		
		ThisForm.EditMode = IIF(TYPE("ThisForm.EditMode")#"L",.F.,ThisForm.EditMode)
		
		IF ISREADONLY()
			WAIT WINDOW C_READONLY_LOC TIMEOUT 2
			ThisForm.EditMode = .F.
		ENDIF
		
		* Disable appropriate buttons
		ThisForm.cmdAdd.Enabled = !ISREADONLY()
		ThisForm.cmdEdit.Enabled = !ISREADONLY()
		ThisForm.cmdDelete.Enabled = !ISREADONLY()
		
		IF ThisForm.PreviewMode
			RETURN
		ENDIF
		
		ThisForm.GetGridRef()
		
		IF ThisForm.UseDataEnv
			RETURN
		ENDIF
		
		* The following code is here to support forms not using a DataEnvironment.
		ThisForm.oldSetFields = SET("FIELDS")
		SET FIELDS OFF
		ThisForm.oldMultiLocks = SET("MULTILOCKS")
		SET MULTILOCKS ON
		ThisForm.oldRefresh = SET("REFRESH")
		SET REFRESH TO 5
		IF !EMPTY(ALIAS())
			ThisForm.oldBuffering=CursorGetProp("buffering")
			m.nTablesUsed = AUSED(aTablesUsed)
			FOR i = 1 TO m.nTablesUsed
				IF CursorGetProp('sourcetype',aTablesUsed[m.i,1])#3	&&skip for views
					=CursorSetProp("buffering",5,aTablesUsed[m.i,1])	&&optimistic table buffering
				ENDIF
			ENDFOR
		ENDIF
		GO TOP
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('Sources')	
			USE IN Sources
		ENDIF
		
		********************
		
		cSQL = "SELECT * FROM dbo.Sources ORDER BY Company,Alloy"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sources')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sources')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sources")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sources")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Sources')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT Sources
			ThisForm.nWorkArea = SELECT(0)
			*INDEX ON ID TAG rID
		*	INDEX ON UPPER(Company) TAG UppCompany
		ENDIF
		SELECT Sources
		*SET ORDER TO TAG UppCompany
		
		***************************
		PUBLIC ARRAY aSrcCompany(1)
		PRIVATE nSQLEXEC, cSQL
		IF USED('SourcePH')	
			USE IN SourcePH
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		*cSQL = "SELECT Company FROM dbo.SourcePH ORDER BY Company"
		cSQL = "SELECT DISTINCT Company FROM dbo.Sources ORDER BY Company"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SourcePH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SourcePH')
			RETURN
		ELSE
			IF USED('SourcePH')
				SELECT SourcePH
				SELECT DISTINCT UPPER(Company) FROM SourcePH INTO ARRAY aSrcCompany
				USE IN SourcePH
			ENDIF
		ENDIF
		
		
		IF USED('tmpAlloy')	
			USE IN tmpAlloy
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		*cSQL = "SELECT Alloy FROM dbo.Alloy ORDER BY Alloy" --may not match with Sources Table
		cSQL = "SELECT DISTINCT Alloy FROM dbo.Sources ORDER BY Alloy"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloy')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloy')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloy")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloy")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpAlloy')
			RETURN
		ELSE
			IF USED('tmpAlloy')
				PUBLIC ARRAY aAlloyAlloy(1)
				SELECT DISTINCT Alloy FROM tmpAlloy ORDER BY Alloy INTO ARRAY aAlloyAlloy
				
				PUBLIC ARRAY aFilterAlloy(1)
				SELECT DISTINCT Alloy FROM tmpAlloy ORDER BY Alloy INTO ARRAY aFilterAlloy
				
				USE IN tmpAlloy
			ENDIF
		ENDIF
		
		SELECT Sources
		*SET ORDER TO TAG Company
	ENDPROC

	PROCEDURE navrefresh
		**** Navigational Button Handling ****
		LOCAL OldLockScreen,KeyValue,cFiltExpr
		*m.OldLockScreen = THISFORM.LockScreen
		*THISFORM.LockScreen = .T.
		
		IF SELECT()#ThisForm.nWorkArea 
			SELECT (ThisForm.nWorkArea )
		ENDIF
		
		IF !ThisForm.EditMode
		
			* Check for bottom of file
			ThisForm.EndFile = EOF() OR ThisForm.EndFile
		
			* Test to see we are on last record
			IF !ThisForm.EndFile
				SKIP
				ThisForm.EndFile = EOF()
				SKIP -1
			ELSE
				GO BOTTOM
			ENDIF
		
			* Check for top of file
			ThisForm.TopFile = BOF() OR EOF() OR ThisForm.TopFile
		
			* Test to see if we are on first record
			IF !ThisForm.TopFile
				SKIP -1
				ThisForm.TopFile = BOF()
				IF !ThisForm.TopFile
					SKIP
				ENDIF	
			ENDIF
		
			IF ThisForm.TopFile
				GO TOP
			ENDIF
		
		ENDIF
		
		ThisForm.cmdTop.Enabled  = !ThisForm.TopFile AND !ThisForm.EditMode
		ThisForm.cmdPrev.Enabled = !ThisForm.TopFile AND !ThisForm.EditMode
		ThisForm.cmdNext.Enabled = !ThisForm.EndFile AND !ThisForm.EditMode
		ThisForm.cmdEnd.Enabled  = !ThisForm.EndFile AND !ThisForm.EditMode
		
		* Check if no records in query set
		DO CASE
		CASE ThisForm.PreviewMode OR ISREADONLY()
			* Nothing
		*CASE ThisForm.EditMode AND CURSORGETPROP("BUFFERING")=1
		*	ThisForm.cmdEdit.Enabled = .F.
		CASE ThisForm.EditMode
			ThisForm.cmdEdit.Enabled = .T.
		CASE RECCOUNT()=0 OR BOF() OR EOF()
			ThisForm.cmdEdit.Enabled = .F.
			ThisForm.cmdDelete.Enabled = .F.
		CASE !ThisForm.cmdEdit.Enabled
			ThisForm.cmdEdit.Enabled = .T.
			ThisForm.cmdDelete.Enabled = .T.
		ENDCASE
		
		ThisForm.Notes1.Value = Sources.Notes
		
		THISFORM.Refresh()
		*THISFORM.LockScreen = m.OldLockScreen
		
	ENDPROC

	PROCEDURE reload
		PARAMETERS pnID_Sources
		*ThisForm.Reload(nID_Sources)
		
		PRIVATE nnID_Sources
		IF VARTYPE(pnID_Sources) = "N"
			nID_Sources = pnID_Sources
		ELSE
			nID_Sources = 0
		ENDIF
			
		PRIVATE nSQLEXEC, cSQL
		IF USED('Sources')	
			USE IN Sources
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Sources ORDER BY Company,Alloy"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sources')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sources')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sources")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sources")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Sources')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT Sources
			ThisForm.nWorkArea = SELECT(0)
			*INDEX ON ID TAG rID
		*	INDEX ON UPPER(Company) TAG UppCompany
		*	SET ORDER TO TAG UppCompany
			
			IF nID_Sources > 0
				LOCATE FOR ID_Sources = nID_Sources
			ENDIF
		
		ENDIF
		
		ThisForm.NavRefresh()
		
	ENDPROC

	PROCEDURE saverecord
		*ThisForm.SaveRecord()
		
		PRIVATE cCompany,cAlloy,cAlloy_AKA
		PRIVATE cUNS,cSpec,lF10,lF20,lF30,lF40,lF60,lF65,lF70,lF75
		PRIVATE cNotes,lStk,lMK,nID,nID_Sources
		
		cCompany	= PrepareSQLtxt(ThisForm.cmbCompany.Value,'Company',30)
		cAlloy		= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cAlloy_AKA	= PrepareSQLtxt(ThisForm.Alloy_AKA1.Value,'Alloy',12)
		cUNS		= PrepareSQLtxt(ThisForm.UNS1.Value,'UNS',6)
		cSpec		= PrepareSQLtxt(ThisForm.Spec1.Value,'SPEC',50)
		lF10		= PrepareSQLchk(ThisForm.F101.Value,'F10')
		lF20		= PrepareSQLchk(ThisForm.F201.Value,'F20')
		lF30		= PrepareSQLchk(ThisForm.F301.Value,'F30')
		lF40		= PrepareSQLchk(ThisForm.F401.Value,'F40')
		lF60		= PrepareSQLchk(ThisForm.F601.Value,'F60')
		lF65		= PrepareSQLchk(ThisForm.F651.Value,'F65')
		lF70		= PrepareSQLchk(ThisForm.F701.Value,'F70')
		lF75		= PrepareSQLchk(ThisForm.F751.Value,'F75')
		cNotes		= PrepareSQLtxt(ThisForm.Notes1.Value,'Notes',-1)
		lStk		= PrepareSQLchk(ThisForm.Stk1.Value,'F75')
		lMK			= PrepareSQLchk(ThisForm.MK1.Value,'F75')
		nID			= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		nID_Sources	= PrepareSQLnum(ThisForm.ID_Sources1.Value,'ID Sources',-3)
		
		
		cSQL = "UPDATE dbo.Sources SET "
		cSQL = cSQL + "	[Company]='"+cCompany+"'"
		cSQL = cSQL + ",[Alloy]='"+cAlloy+"'"
		cSQL = cSQL + ",[Alloy_AKA]='"+cAlloy_AKA+"'"
		cSQL = cSQL + ",[UNS]='"+cUNS+"'"
		cSQL = cSQL + ",[Spec]='"+cSpec+"'"
		cSQL = cSQL + ",[F10]="+IIF(VARTYPE(lF10)="L",IIF(lF10,'1','0'),'0')
		cSQL = cSQL + ",[F20]="+IIF(VARTYPE(lF20)="L",IIF(lF20,'1','0'),'0')
		cSQL = cSQL + ",[F30]="+IIF(VARTYPE(lF30)="L",IIF(lF30,'1','0'),'0')
		cSQL = cSQL + ",[F40]="+IIF(VARTYPE(lF40)="L",IIF(lF40,'1','0'),'0')
		cSQL = cSQL + ",[F60]="+IIF(VARTYPE(lF60)="L",IIF(lF60,'1','0'),'0')
		cSQL = cSQL + ",[F65]="+IIF(VARTYPE(lF65)="L",IIF(lF65,'1','0'),'0')
		cSQL = cSQL + ",[F70]="+IIF(VARTYPE(lF70)="L",IIF(lF70,'1','0'),'0')
		cSQL = cSQL + ",[F75]="+IIF(VARTYPE(lF75)="L",IIF(lF75,'1','0'),'0')
		cSQL = cSQL + ",[Notes]='"+cNotes+"'"
		cSQL = cSQL + ",[Stk]="+IIF(VARTYPE(lStk)="L",IIF(lSTK,'1','0'),'0')
		cSQL = cSQL + ",[MK]="+IIF(VARTYPE(lMK)="L",IIF(lMK,'1','0'),'0')
		cSQL = cSQL + ",[ID]="+STR(nID)
		cSQL = cSQL + " WHERE [ID_Sources] = "+STR( nID_Sources )
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL  )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		ENDIF
		
		ThisForm.Reload(nID_Sources)
		
	ENDPROC

