	PROCEDURE Unload
		IF used('Sources')
			USE IN Sources
		ENDIF
		
		IF ThisForm.lCloseAlloys
			USE IN Alloys
		ENDIF
		
		*USES Private Data Sesion
		*CLOSE DATABASES ALL
		
		IF ThisForm.nConnHandle > 0
			SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
	ENDPROC

	PROCEDURE ALLOY_AKA1.Valid
		PRIVATE cAlloyAKA, cAlloy
		cAlloyAKA = THIS.VALUE
		
		
		IF TYPE("cAlloyAKA") = "C"
		
			cAlloy = THISFORM.cmbAlloy.VALUE
			
			IF EMPTY('cAlloy')
				RETURN .T.
			ENDIF
			
			IF TYPE("cAlloy") = "C"
			
			
				PRIVATE cAlloyStandard
		
				IF NOT EMPTY(cAlloyAKA)
					cAlloyStandard = GetAlloyStandard( cAlloyAKA, ThisForm.nConnHandle )
					
					IF EMPTY(cAlloyStandard)
						IF MESSAGEBOX("Do you want to save this Alloy AKA:"+cAlloyAKA+CHR(10)+"to Alloy:"+cAlloy ,3+32,"AKA not found!") = 6
							*save
							INSERT_AlloyAKA( cAlloy, cAlloyAKA, ThisForm.nConnHandle )
						ENDIF
					ELSE
						* Have AlloyAKA
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmbAlloy.InteractiveChange
		*aAlloyAlloy
		LOCAL cGetExpr,cSavePoint,m.cAlloy
		SELECT Sources
		SET FILTER TO
		m.cSavePoint = SET("POINT")
		SET POINT TO "."
		m.cAlloy = This.Value
		m.cGetExpr = "Alloy=["+ALLTRIM( cAlloy )+" ]"
		SET POINT TO &cSavePoint
		IF !EMPTY(m.cGetExpr)
			SET FILTER TO &cGetExpr
			ThisForm.lblFilter.Caption = cGetExpr
			LOCATE
			* Check if no records found
			IF EOF()
				MESSAGEBOX("This Alloy does not exits for the Company",0,"No Records found" )
				*ThisForm.ChangedFilter = .T.
				RETURN
			ENDIF
			*ThisForm.ChangedFilter = .F.		&&good query
			
			IF EOF() AND BOF()
				SET FILTER TO 
				ThisForm.lblFilter.Caption = ''
			ENDIF
			
			ThisForm.EndFile = EOF()
			ThisForm.TopFile = BOF()
			
			ThisForm.cmdPrev.Enabled = .t.
			ThisForm.cmdNext.Enabled = .t.
		
			ThisForm.NavRefresh()
		ELSE
			LOCATE
		ENDIF
	ENDPROC

	PROCEDURE cmbAlloy.Valid
		IF ThisForm.EditMode
			RETURN
		ENDIF
		
	ENDPROC

	PROCEDURE cmbCompany.InteractiveChange
		*aSrcCompany
		IF NOT ThisForm.EditMode
			*Move record, locate
				
			LOCAL cGetExpr,cSavePoint,m.cCompany
			SELECT Sources
			SET FILTER TO
			m.cSavePoint = SET("POINT")
			SET POINT TO "."
			m.cCompany = This.Value
			m.cGetExpr = "Company=["+ALLTRIM( cCompany )+"]"
			SET POINT TO &cSavePoint
			IF !EMPTY(m.cGetExpr)
				SET FILTER TO &cGetExpr
				ThisForm.lblFilter.Caption = cGetExpr
				
				IF EOF() AND BOF()
					SET FILTER TO 
					ThisForm.lblFilter.Caption = ''
					
				ENDIF
				
				SELECT Sources
				LOCATE &&FOR Company = cCompany 
				
				ThisForm.EndFile = EOF()
				ThisForm.TopFile = BOF()
				
				ThisForm.cmdPrev.Enabled = .t.
				ThisForm.cmdNext.Enabled = .t.
		
				ThisForm.FilterAlloyRefresh()
				ThisForm.NavRefresh()
		
			ELSE
				LOCATE
			ENDIF
		ELSE
			*Just Show so Value can be Picked to Save!
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmbCompany.Valid
		IF ThisForm.EditMode
			RETURN
		ENDIF
		
	ENDPROC

	PROCEDURE cmbFilterAlloy.InteractiveChange
		IF ThisForm.EditMode
			*Edit Mode
			ThisForm.Alloy1.Value = This.Alloy
		ELSE
			PRIVATE cAlloy
			cAlloy = This.Value
			SELECT Sources
			LOCATE FOR Alloy = cAlloy
		
			* Check if no records found
			IF EOF()
				MESSAGEBOX("This Alloy does not exits for the Company",0,"No Records found" )
				*ThisForm.ChangedFilter = .T.
				RETURN
			ENDIF
			*ThisForm.ChangedFilter = .F.		&&good query
				
			ThisForm.EndFile = EOF()
			ThisForm.TopFile = BOF()
		
			ThisForm.cmdPrev.Enabled = .t.
			ThisForm.cmdNext.Enabled = .t.
		
			ThisForm.NavRefresh()
		ENDIF
		
	ENDPROC

	PROCEDURE cmbFilterAlloy.Valid
		IF ThisForm.EditMode
			*RETURN
		ENDIF
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		
		LOCAL oSearchDlog,oAddRec,cChildAlias,cPapaAlias,i,lPrimeKey
		LOCAL cPapaKey,cChildKey,nSaveSess,oRel,cTagName,lBadViewKey,nSaveRec,nSaveRec2
		LOCAL lBadChildKey,lUpdatableParentKey,lNoSendParentUpdates,lNoSendChildUpdates
		
		IF THIS.Caption = "\<Add"
			** Code for adding record
			ThisForm.OldAlias = ALIAS()	&&save alias in case reverting
			ThisForm.OldRec = RECNO()	&&save record in case reverting
			lPrimeKey = .F.					&&is child key primary index
			ThisForm.AddRecord()  &&inserts a blank to get the ID to Save as Edit.
			ThisForm.SetScreen("EDIT")
			This.Caption = "\<Save"
			ThisForm.cmdEdit.Caption = "\<Revert"
		ELSE
			** Code for saving record
			ThisForm.SaveRecord()
			This.Caption = "\<Add"
			ThisForm.cmdEdit.Caption = "\<Edit"
			
			ThisForm.SetScreen("SHOW")
		ENDIF
		
		
		ThisForm.EditMode = !ThisForm.EditMode
		ThisForm.AddMode = ThisForm.EditMode
		ThisForm.TopFile = .F.
		*THISFORM.LockScreen = .T.
		ThisForm.ButtonRefresh()
		
		ThisForm.NavRefresh()
		*THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE cmdDelete.Click
		LOCAL cGetExpr
		cGetExpr = ThisForm.lblFilter.Caption
		
		SET FILTER TO 
		
		PRIVATE nNextID, nCurrID
		nCurrID = Sources.ID_Sources
		
		IF NOT EOF('Sources')
			SKIP 1 IN Sources
			nNextID = Sources.ID_Sources
		ELSE
			IF NOT BOF('Sources')
				SKIP -1 IN Sources
				nNextID = Sources.ID_Sources
			ELSE
				nNextID = 0
			ENDIF
		ENDIF
		
		IF MESSAGEBOX("Are you sure you want to delete this record?",36,"Delete?") = 6
			
			PRIVATE nSQLEXEC, cSQL
		
			cSQL = "DELETE FROM dbo.Sources WHERE ID_Sources="+STR(nCurrID)
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
				RETURN
			ELSE
				ThisForm.Reload(nNextID)
			ENDIF
			
		*	THISFORM.LockScreen = .T.
			ThisForm.ButtonRefresh()
			ThisForm.NavRefresh()
		*	THISFORM.LockScreen = .F.
		ENDIF
		
		IF !EMPTY(m.cGetExpr)
			SET FILTER TO &cGetExpr
			ThisForm.lblFilter.Caption = cGetExpr
			LOCATE
		ENDIF
		
		IF THISFORM.ShowWindow = 2 
			Activate Window (THISFORM.Name)
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDeleteCompany.Click
		PRIVATE cCompany
		cCompany = PrepareSQLtxt(ThisForm.cmbCompany.Value,'Company',30)
		
		IF LEN(Company) = 0
			RETURN .F.
		ENDIF
		
		IF MESSAGEBOX("Are you sure you want to delete this Company? "+cCompany,36,"Delete?") = 6
			PRIVATE nID_Sources, nID_Contact
			nID_Sources = PrepareSQLnum(ThisForm.ID_Sources1.Value,'ID_Sources',-3)
			nID_Contact = PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
			
			PRIVATE nSQLEXEC, cSQL
		
			cSQL = "DELETE FROM dbo.Sources WHERE Company='"+cCompany+"'"
			IF nID_Sources > 0
				cSQL = cSQL + " OR ID_Sources ="+STR(nID_Sources)
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
				RETURN .F.
			ENDIF
		
			cSQL = "DELETE FROM dbo.SourcePH WHERE Company='"+cCompany+"'"
			IF nID_Contact > 0
				cSQL = cSQL + " OR ID="+STR(nID_Contact)
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
				RETURN .F.
			ELSE
				ThisForm.Reload()
			ENDIF
			
		*	THISFORM.LockScreen = .T.
			ThisForm.ButtonRefresh()
			ThisForm.NavRefresh()
		*	THISFORM.LockScreen = .F.
		ENDIF
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF THIS.Caption = "\<Edit"
			*Edit
			ThisForm.EditMode = .T.
			ThisForm.OldAlias = ALIAS()	&&save alias in case reverting
			ThisForm.OldRec = RECNO()	&&save record in case reverting
		
			ThisForm.SetScreen("EDIT")
			ThisForm.cmdAdd.Caption = "\<Save"
			This.Caption = "\<Revert"
		ELSE
			*Revert
		
			*IF ThisForm.EditMode	
			* Go back to original place
			ThisForm.EditMode = .F.
			ThisForm.SetScreen("SHOW")
			ThisForm.OldAlias = ALIAS()	&&save alias in case reverting
			ThisForm.OldRec = RECNO()	&&save record in case reverting
		
			ThisForm.cmdAdd.Caption = "\<Add"
			This.Caption = "\<Edit"
		ENDIF
		
		** Editing record
		ThisForm.EditMode = !ThisForm.EditMode
		ThisForm.AddMode = .F.
		*THISFORM.LockScreen = .T.
		ThisForm.ButtonRefresh()
		
		ThisForm.NavRefresh()
		*THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE cmdEnd.Click
		SELECT (ThisForm.nWorkArea)
		GO BOTTOM
		ThisForm.TopFile = .F.
		ThisForm.EndFile = .T.
		ThisForm.NavRefresh()
	ENDPROC

	PROCEDURE cmdExit.Click
		THISFORM.Release
	ENDPROC

	PROCEDURE cmdFind.Click
		RETURN
		
		LOCAL oSearchDlog
		LOCAL lVisChange,lStateChange
		
		* Check if SDI Window
		IF THISFORM.ShowWindow = 2 
			IF !_VFP.Visible
				_VFP.Visible = .T.
				lVisChange = .T.
			ENDIF
			IF _SCREEN.WindowState = 1
				_SCREEN.WindowState = 0
				lStateChange = .T.
			ENDIF
		ENDIF
		
		oSearchDlog = CREATE("searchform")
		oSearchDlog.SHOW()
		
		IF m.lVisChange
			_VFP.Visible = .F.
		ENDIF
		IF m.lStateChange 
			_SCREEN.WindowState = 1
		ENDIF
		
		IF THISFORM.ShowWindow = 2 
			Activate Window (THISFORM.Name)
		ENDIF
		
		* Reset from prior
		ThisForm.TopFile = .F.
		ThisForm.EndFile = .F.
		ThisForm.NavRefresh()
		
		ThisForm.lblFilter.Caption = SET('FILTER')
	ENDPROC

	PROCEDURE cmdNext.Click
		SELECT (ThisForm.nWorkArea)
		IF !EOF()
			SKIP 1
		ENDIF
		
		ThisForm.EndFile = EOF()
		ThisForm.TopFile = BOF()
		
		ThisForm.NavRefresh()
		
	ENDPROC

	PROCEDURE cmdPrev.Click
		SELECT (ThisForm.nWorkArea)
		IF !BOF()
			SKIP -1
		ENDIF
		
		ThisForm.TopFile = BOF()
		ThisForm.EndFile = EOF()
		
		ThisForm.NavRefresh()
	ENDPROC

	PROCEDURE cmdPrint.Click
		RETURN
		
		#DEFINE C_MAKEREPO_LOC			"Could not locate a report to print. Create new one?"
		#DEFINE C_NOOPEN_LOC					"Error opening table. Unable to print report."
		#DEFINE C_GETFILEPROMPT_LOC		"Pick report:"
		
		LOCAL cRepName,nSaveSess,cSaveAlias,cSaveSource,cSaveData 
		
		cSaveAlias = ALIAS()
		cSaveSource = CURSORGETPROP("SourceName")
		cSaveData = CURSORGETPROP("Database")
		cDiffSource = ""
		cRepName = LEFT(ALIAS(),8)+".FRX"
		nSaveSess = SET("DATASESSION")
		
		* Handling for Private data sessions
		#IF 0
			IF m.nSaveSess # 1
				SET DATASESSION TO 1
				SELECT 0
				IF !EMPTY(m.cSaveData)
					OPEN DATABASE (m.cSaveData)
				ENDIF
				IF USED(m.cSaveAlias)
					SELECT (m.cSaveAlias)
					IF CURSORGETPROP("SourceName")#m.cSaveSource
						cDiffSource = CURSORGETPROP("SourceName")
						USE IN (m.cSaveAlias)
						SELECT 0
					ENDIF
				ENDIF	
				IF EMPTY(ALIAS())
					USE (m.cSaveSource) AGAIN ALIAS (m.cSaveAlias) SHARED
					IF EMPTY(ALIAS())
						=MESSAGEBOX(C_NOOPEN_LOC)
						RETURN
					ENDIF
				ENDIF
			ENDIF
		#ENDIF
		
		IF FILE(m.cRepName)
			REPORT FORM (m.cRepName) PREVIEW NOWAIT
		ELSE
			m.cRepName = GETFILE("frx",C_GETFILEPROMPT_LOC,"",1)
			IF !EMPTY(m.cRepName)
				IF FILE(m.cRepName)
					* User pressed Open button
					REPORT FORM (m.cRepName) PREVIEW NOWAIT
				ELSE
					* User pressed New button
					DO HOME()+"wizards\wzreport.app" WITH ALIAS(), "AUTOREPORT"
				ENDIF
			ENDIF
		ENDIF
		
		* Private data session code
		#IF 0
			IF !EMPTY(cDiffSource)
				USE (m.cDiffSource) IN 0
			ENDIF
			SET DATASESSION TO m.nSaveSess
			SELECT (m.cSaveAlias)
		#ENDIF
		
		IF THISFORM.ShowWindow = 2 
			Activate Window (THISFORM.Name)
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSeeAll.Click
		SET FILTER TO 
		ThisForm.lblFilter.Caption = ''
		
		ThisForm.EndFile = EOF()
		ThisForm.TopFile = BOF()
		
		ThisForm.cmdPrev.Enabled = .t.
		ThisForm.cmdNext.Enabled = .t.
	ENDPROC

	PROCEDURE cmdTop.Click
		SELECT (ThisForm.nWorkArea)
		LOCATE
		ThisForm.TopFile = .T.
		ThisForm.EndFile = EOF()
		ThisForm.NavRefresh()
	ENDPROC

	PROCEDURE lblAddCompanyName.Click
		nID = PrepareSQLnum( ThisForm.ID1.Value,'ID',-3)
		IF nID = 0
			DO FORM Forms\SourcePH
		ELSE
			DO FORM Forms\SourcePH WITH nID 
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE lblVenCode.Click
		nVendCode = PrepareSQLnum( ThisForm.VendCode1.Value,'VendCode',-3)
		IF nVendCode = 0
			DO FORM Forms\Vendor 
		ELSE
			DO FORM Forms\Vendor WITH nVendCode 
		ENDIF
	ENDPROC

ENDDEFINE
