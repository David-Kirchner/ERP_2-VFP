	PROCEDURE delete_rtr_detail		&& A Deleted Process will auto mark the rtr_Detail as Finished. Remove from rtr_Detail table so tigger [StockLst_Process_Delete]
		*ThisForm.Delete_rtr_Detail()
		*TrackError("Did not get a TBL","cTBL:"+pTBL+"  nID_Detail="+STR(nID_Detail),"ShowProcess:Init",LINENO())
		
		PRIVATE cTBL, nID_Detail_Process, nWO, cSOitem, cPOitem
		cTBL			= PrepareSQLtxt(ThisForm.TBL1.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		*nWO 			= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		*cSOitem			= PrepareSQLtxt(ThisForm.SOITEM1.Value,'SOitem',10)
		*cPOitem			= PrepareSQLtxt(ThisForm.POITEM1.Value,'POitem',12)
		
		
		PRIVATE cSQL, nSQLEXEC
			
		cSQL = "DELETE FROM dbo.rtr_Detail "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " WHERE TBL = 'S' "
		CASE cTBL = "B"
			cSQL = cSQL + " WHERE TBL = 'B' "
		CASE cTBL = "W"
			cSQL = cSQL + " WHERE TBL = 'W' "
		OTHERWISE
			TrackError("Did not get a TBL","cTBL:"+cTBL+"  ID_Detail_Process="+STR(nID_Detail_Process),"ShowProcess:Delete_rtr_Detail()",LINENO())
		ENDCASE
		cSQL = cSQL + " AND ID_Detail_Process = "+STR(nID_Detail_Process)
		cSQL = cSQL + " AND [Finished] = 0"	&&Do not remove Finished=1
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '' )
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE Init
		PARAMETER pSalesNum
		*DO FORM Forms\Show_SO_mess WITH nSalesNum
		*DO FORM Forms\Show_SO_mess WITH 108096
		
		PRIVATE nSalesNum
		nSalesNum = 0
		IF VARTYPE(pSalesNum) = 'N'
			nSalesNum = pSalesNum 
		ENDIF
		
		
		PRIVATE cSalesNum
		cSalesNum = ALLTRIM(STR(nSalesNum))
		
		IF LEN(cSalesNum) < 4
			cSalesNum = "108096"
		ENDIF
		
		***********************
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM "
		cSQL = cSQL + " HPAlloyNR.dbo.UserTrack "
		cSQL = cSQL + " WHERE mess1 LIKE '%"+cSalesNum+"%'"
		cSQL = cSQL + "  Order By errordate DESC "
		
		
		
		IF USED("tmpUserTrack")
			SELECT tmpUserTrack
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUserTrack')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUserTrack')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpUserTrack' )
			RETURN
		ENDIF
		
		IF RECCOUNT('tmpUserTrack') < 1
			RETURN
		ENDIF
		
		SELECT tmpUserTrack
		
		PUBLIC ARRAY gaID(1)
		IF RECCOUNT('tmpUserTrack') > 0
			SELECT ID FROM tmpUserTrack INTO ARRAY gaID ORDER BY ID
			
			SELECT tmpUserTrack
			GO TOP
		ELSE
			gaID(1) = "None"
		ENDIF
		
		ThisForm.lstItems.RowSource = "gaID"
		ThisForm.lstItems.ColumnCount = ALEN(gaID,1)
		
		IF ALEN(gaID,1) > 0
			IF VARTYPE(gaID(1)) != "C"	&& BigINT is Char
				gaID(1) = "0"
			ENDIF
			
			ThisForm.lstItems.Value = gaID(1)
			ThisForm.lstItems.SetFocus
			
		ENDIF
		
		ThisForm.Refresh_tmpUserTrack()
		
		********************************
		
		ThisForm.AlwaysOnTop = .T.
		ThisForm.AlwaysOnTop = .F.
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE refresh_stocklst_process
		*ThisForm.Refresh_StockLst_Process()
		
		*ThisForm.lstItems.Value = StockLst_Process.SOitem
		*ThisForm.lstItems.Value = StockLst_Process.ID_Detail_Process
		
		SCATTER MEMVAR
		
		ThisForm.Refresh
		
		
		PRIVATE MasterLB,MasterProcLB,DetailLB,DetailProcLB
		MasterLB		= 0
		MasterProcLB	= 0
		DetailLB		= 0
		DetailProcLB	= 0
		
		IF USED('tmpProcess_LBs')
			USE IN tmpProcess_LBs
		ENDIF
		
		SELECT 0
		
		DO CASE
		CASE StockLst_Process.TBL = "S"
			cSQL_SP = "SELECT * FROM dbo.TVF_Stock_Process_QTY("+STR(m.ID_Detail)+");"
			*cSQL_SP = "EXEC dbo.p_Process_QTY "+STR(m.ID_Detail)
			*nMasterLBS,nMasterQTY,nDetailLBS,nDetailQTY,nMProcLBS,nMProcQTY,nDProcLBS,nDProcQTY
		CASE StockLst_Process.TBL = "B"
			cSQL_SP = "SELECT * FROM dbo.TVF_Broker_Process_QTY("+STR(m.ID_Detail)+");"
			*cSQL_SP = "EXEC dbo.p_BrokerLst_Process_QTY "+STR(m.ID_Detail)
		CASE StockLst_Process.TBL = "W"
			cSQL_SP = "SELECT * FROM dbo.TVF_WIP_Process_QTY("+STR(m.ID_Detail)+");"
			*cSQL_SP = "EXEC dbo.p_WIP_Process_QTY "+STR(m.ID_Detail)
		ENDCASE
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_SP, 'tmpProcess_LBs' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL_SP,'tmpProcess_LBs' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_SP, ThisForm.nConnHandle, nSQLEXEC, 'tmpProcess_LBs' )
		ELSE
			IF USED('tmpProcess_LBs')
				IF RECCOUNT('tmpProcess_LBs') > 0
					
					PRIVATE nMasterQTY, nDetailQTY, nDSelectedQTY, nMSelectedQTY, nDNoSubQTY
					nMasterQTY	= PrepareSQLnum(tmpProcess_LBs.MasterQTY,'MasterQTY',-3)
					nDetailQTY	= PrepareSQLnum(tmpProcess_LBs.DetailQTY,'DetailQTY',-3)
					nDSelectedQTY	= PrepareSQLnum(tmpProcess_LBs.DSelectedQTY,'DSelectedQTY',-3)
					nMSelectedQTY	= PrepareSQLnum(tmpProcess_LBs.MSelectedQTY,'MSelectedQTY',-3)
					nDNoSubQTY	= PrepareSQLnum(tmpProcess_LBs.DNoSubQTY,'DNoSubQTY',-3)
					
					ThisForm.lblMasterQTY.Caption = ALLTRIM(STR(nMasterQTY))
					ThisForm.lblMSelectedQTY.Caption = ALLTRIM(STR(nMSelectedQTY))
					
					ThisForm.lblDetailQTY.Caption = ALLTRIM(STR(nDetailQTY))
					ThisForm.lblDSelectedQTY.Caption = ALLTRIM(STR(nDSelectedQTY))
					ThisForm.lblMSelectedQTY.Caption = ALLTRIM(STR(nMSelectedQTY))
					
					ThisForm.lblDNoSubQTY.Caption = ALLTRIM(STR(nDNoSubQTY))
					
					***
		*!*				ThisForm.lblMasterBalance.Caption = ALLTRIM(STR(nMasterLBS-nMProcLBS))
		*!*				IF (nMasterLBS-nMProcLBS) < 0
		*!*					ThisForm.lblMasterBalance.ForeColor = RGB(255,0,0)
		*!*				ELSE
		*!*					ThisForm.lblMasterBalance.ForeColor = RGB(0,0,0)
		*!*				ENDIF
		*!*				**
		*!*				ThisForm.lblMasterBQTY.Caption = ALLTRIM(STR(nMasterQTY-nMProcQTY))
		*!*				IF (nMasterQTY-nMProcQTY) < 0
		*!*					ThisForm.lblMasterBQTY.ForeColor = RGB(255,0,0)
		*!*				ELSE
		*!*					ThisForm.lblMasterBQTY.ForeColor = RGB(0,0,0)
		*!*				ENDIF
		*!*				***
		*!*				IF NOT ISNULL(nDetailLBS) AND NOT ISNULL(nDProcLBS)
		*!*					ThisForm.lblDetailBalance.Caption = ALLTRIM(STR(nDetailLBS - nDProcLBS))
		*!*					IF (nDetailLBS - nDProcLBS) < 0
		*!*						ThisForm.lblDetailBalance.ForeColor = RGB(255,0,0)
		*!*					ELSE
		*!*						ThisForm.lblDetailBalance.ForeColor = RGB(0,0,0)
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisForm.lblDetailBalance.Caption = ''
		*!*				ENDIF
		*!*				**
		*!*				IF NOT ISNULL(nDetailQTY) AND NOT ISNULL(nDProcQTY)
		*!*					ThisForm.lblDetailBQTY.Caption = ALLTRIM(STR(nDetailQTY - nDProcQTY))
		*!*					IF (nDetailQTY - nDProcQTY) < 0
		*!*						ThisForm.lblDetailBQTY.ForeColor = RGB(255,0,0)
		*!*					ELSE
		*!*						ThisForm.lblDetailBQTY.ForeColor = RGB(0,0,0)
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisForm.lblDetailBQTY.Caption = ''
		*!*				ENDIF
					***
				ENDIF
				USE IN tmpProcess_LBs
			ENDIF
		ENDIF
		
		*************************************************
		ThisForm.txtStock1.Value = ''
		IF USED('tmpStock')
			USE IN tmpStock
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SM.Alloy, dbo.f_DescriptionMetricReport(PC, Form, Dim1, Dim2, Dim3, Weight, RandLen, 0, '', '', '') AS Descript"
		cSQL = cSQL + ",CC,CL,SD.S_QTY, SM.Heat, SM.lot, Length, Specs "
		
		DO CASE
		CASE StockLst_Process.TBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail SD "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master SM ON SD.ID = SM.ID "
		CASE StockLst_Process.TBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail SD "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master SM ON SD.ID = SM.ID "
		CASE StockLst_Process.TBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Detail SD "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master SM ON SD.ID = SM.ID "
		ENDCASE
		cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(StockLst_Process.ID_Detail)
			
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStock' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL,'tmpStock' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStock' )
		ELSE
			IF USED('tmpStock')
				IF RECCOUNT('tmpStock') > 0
					PRIVATE cMess
					cMess = ALLTRIM(tmpStock.Alloy)+" "
					cMess = cMess + ALLTRIM(tmpStock.Descript)+" "
					cMess = cMess + ALLTRIM(tmpStock.CC)+""
					cMess = cMess + ALLTRIM(tmpStock.CL)+" "
					cMess = cMess + "QTY:"+ALLTRIM( Remove0(tmpStock.S_QTY,10,0))+" "
					cMess = cMess + ALLTRIM(tmpStock.Heat)+" "
					cMess = cMess + ALLTRIM(tmpStock.Lot)+" "
					cMess = cMess + ALLTRIM(tmpStock.Length)+" "
					cMess = cMess + ALLTRIM(tmpStock.Specs)+" "
					
					ThisForm.txtStock1.Value = cMess
				ENDIF
				USE IN tmpStock
			ENDIF
		ENDIF
		
		SELECT StockLst_Process
	ENDPROC

	PROCEDURE refresh_tmpusertrack
		*ThisForm.Refresh_tmpUserTrack()
		
		SCATTER MEMVAR
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE Unload
		SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF NOT EMPTY( ThisForm.PrevTable )
			IF USED( ThisForm.PrevTable )
				SELECT (ThisForm.PrevTable)
			ENDIF
		ENDIF
		
		*IF WEXIST("frmStockLst_SQL_Quotes")
		*	ACTIVATE WINDOW frmStockLst_SQL_Quotes
		*ENDIF
		
	ENDPROC

	PROCEDURE cmdNext.Click
		SELECT tmpUserTrack
		IF !EOF('tmpUserTrack')
			SKIP 1 IN tmpUserTrack
			ThisForm.lstItems.Value = tmpUserTrack.ID
		ENDIF
		IF EOF('tmpUserTrack')
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN tmpUserTrack
		ENDIF
		
		ThisForm.Refresh_tmpUserTrack()
	ENDPROC

	PROCEDURE cmdPrev.Click
		
		SELECT tmpUserTrack
		IF !BOF('tmpUserTrack')
			SKIP -1 IN tmpUserTrack
			ThisForm.lstItems.Value = tmpUserTrack.ID
		ENDIF
		IF EOF('tmpUserTrack')
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN tmpUserTrack
		ENDIF
		
		
		ThisForm.Refresh_tmpUserTrack()
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE lstItems.Click
		
		PRIVATE cID
		cID = PrepareSQLtxt(This.Value,'ID',20)
		
		SELECT tmpUserTrack
		LOCATE FOR ID = cID
		*SEEK nID_Detail_Process ORDER ID_Detail_Process IN StockLst_Process
		
		ThisForm.Refresh_tmpUserTrack()
		
	ENDPROC

ENDDEFINE
