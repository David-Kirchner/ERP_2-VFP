	PROCEDURE editvendor
		PARAMETERS pVendCode
		*ThisForm.EditVendor(nVendCode)
		
		PRIVATE nVendCode
		IF TYPE("pVendCode") != "N"
			*Error
			RETURN .F.
		ELSE
			nVendCode = pVendCode
		ENDIF
		
		PRIVATE nCntVend	
		nCntVend = 0
		
		IF USED('cntVendor')
			USE IN cntVendor
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Vendor "
		cSQL = cSQL + " WHERE VendCode = "+ALLTRIM(STR(nVendCode))
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendor')
		
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendor' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendor")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendor")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendor' )
		ENDIF
		
		IF USED('cntVendor')
			nCntVendor = cntVendor.CNTD
			USE IN cntVendor
		ENDIF
		
		IF nCntVendor > 0
			IF USED('tmpVendor')
				USE IN tmpVendor
			ENDIF
			
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.Vendor "
			cSQL = cSQL + " WHERE VendCode = "+ALLTRIM(STR(nVendCode))
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpVendor')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpVendor' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpVendor' )
			ENDIF
			
			IF USED('tmpVendor')
				IF VARTYPE(tmpVendor.VendCode) = "N"
					
					ThisFormSet.EditScreen(1)
					
					ThisFormset.frmVendor.pf.pgAdd.nVendCode.Value	= tmpVendor.VendCode
					ThisFormSet.frmVendor.Pf.PgAdd.cCompany.Value	= ShowSQLtxt(tmpVendor.Company,'Company',100)
					ThisFormSet.frmVendor.Pf.PgAdd.cAddr1.Value		= ShowSQLtxt(tmpVendor.Addr1,'Addr1',100)
					ThisFormSet.frmVendor.Pf.PgAdd.cAddr2.Value		= ShowSQLtxt(tmpVendor.Addr2,'Addr2',100)
					ThisFormSet.frmVendor.Pf.PgAdd.cAddrPOB.Value	= ShowSQLtxt(tmpVendor.AddrPOB,'AddrPOB',30)
					ThisFormSet.frmVendor.Pf.PgAdd.cCity.Value		= ShowSQLtxt(tmpVendor.City,'City',50)
					ThisFormSet.frmVendor.Pf.PgAdd.cST.Value		= ShowSQLtxt(tmpVendor.ST,'ST',50)
					ThisFormSet.frmVendor.Pf.PgAdd.cZip.Value		= ShowSQLtxt(tmpVendor.Zip,'Zip',50)
					ThisFormSet.frmVendor.Pf.PgAdd.cCountry.Value	= ShowSQLtxt(tmpVendor.Country,'Country',50)
					ThisFormSet.frmVendor.Pf.PgAdd.cWebsite.Value	= ShowSQLtxt(tmpVendor.Website,'Website',50)
					ThisFormSet.frmVendor.Pf.PgAdd.cVend_Notes.Value	= ShowSQLtxt(tmpVendor.Vend_Notes,'Vend_Notes',-1)
					ThisFormSet.frmVendor.Pf.PgAdd.cVend_Print.Value	= ShowSQLtxt(tmpVendor.Vend_Print,'Vend_Print',-1)
					ThisFormSet.frmVendor.Pf.PgAdd.cPeachID.Value		= ShowSQLtxt(tmpVendor.PeachID,'PeachID',20)
					ThisFormSet.frmVendor.Pf.PgAdd.opgQAApproved.Value	= PrepareSQLnum(tmpVendor.QAApproved,'QAApproved',-1)
					ThisFormSet.frmVendor.Pf.PgAdd.nQASurveyContactID.Value	= PrepareSQLnum(tmpVendor.QASurveyContactID,'QASurveyContactID',-3)
					ThisFormset.frmVendor.pf.pgAdd.dQASurveyDate.Value	= PrepareSQLdate(tmpVendor.QASurveyDate,'QASurveyDate')
					ThisFormset.frmVendor.pf.pgAdd.Inactive.Value	= PrepareSQLchk(tmpVendor.Inactive,'Inactive')
					ThisFormset.frmVendor.pf.pgAdd.metal.Value		= PrepareSQLchk(tmpVendor.Metal,'Metal')
					ThisFormset.frmVendor.pf.pgAdd.chkDLA_BMS.Value		= PrepareSQLchk(tmpVendor.DLA_BMS,'DLA_BMS')
					ThisFormset.frmVendor.pf.pgAdd.dLastEdit.Value	= PrepareSQLdate(tmpVendor.LastEdit,'LastEdit')
		
		
					ThisFormSet.VendCode = tmpVendor.VendCode
		*			ThisFormSet.ShowVendCode(tmpVendor.VendCode)  &&must call After getting VendCode
				
					ThisFormset.frmVendor.pf.pgAdd.cmdAdd.Caption	= "\<Save"
					
					ThisFormset.frmVendor.pf.pgAdd.Refresh
					ThisFormset.frmVendor.pf.ActivePage = 1
					ThisFormset.frmVendor.pf.PgAdd.CCompany.SetFocus
					
					*ThisFormSet.Pageframe1.pgAdd.pfAdd.pgDesc.txtCompany.SetFocus()
				ENDIF
				USE IN tmpVendor
			ENDIF	
				
		ELSE
			MESSAGEBOX("VendCode "+ALLTRIM(STR(nVendCode ))+" was not found!",0,"No Edit")
		ENDIF
		
	ENDPROC

	PROCEDURE getvendor
		PARAMETERS nVendCode
		*ThisFormSet.GetVendor(VendCode)
		
		IF VARTYPE(nVendCode) = "N"
			ThisFormset.frmVendor.pf.pgView.grdVendor.RecordSource = ''
		ENDIF
		
		PRIVATE lInit
		lInit = .F.
		IF VARTYPE(nVendCode) = "C"
			IF nVendCode = "INIT"
				lInit = .T.
			ENDIF
		ENDIF
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.Vendor WITH(NOLOCK) "
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Vendor')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Vendor' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Vendor")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Vendor")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'Vendor' )
		ENDIF
		
		SELECT Vendor
		INDEX ON VendCode TAG VendCode
		INDEX ON Company TAG Company
		INDEX ON PeachID TAG PeachID
		
		
		SET ORDER TO VendCode
		SELECT Company FROM Vendor INTO ARRAY gaVendorCompany
		IF NOT lInit
		*	ThisFormset.frmSearch.cmbVendorCompany.RowSource = 'gaVendorCompany'
		ENDIF
		
		IF VARTYPE(nVendCode) = "N"
			SET ORDER TO VendCode
			SEEK nVendCode
			
			
			DO CASE
			CASE ThisFormset.frmVendor.pf.pgView.ogOrder.Value = 1
				SET ORDER TO VendCode
			CASE ThisFormset.frmVendor.pf.pgView.ogOrder.Value = 2
				SET ORDER TO TAG Company
			CASE ThisFormset.frmVendor.pf.pgView.ogOrder.Value = 3
				SET ORDER TO TAG PeachID
			OTHERWISE
				SET ORDER TO VendCode
			ENDCASE
		ELSE
			SET ORDER TO VendCode
			GO BOTTOM
		
			IF RECNO('Vendor') > 10
				SKIP -2
				ThisFormSet.VendCode = Vendor.VendCode
				
			ENDIF
		ENDIF
		
		IF NOT lInit 
			ThisFormset.frmVendor.pf.pgView.grdVendor.RecordSource = 'Vendor'
		ENDIF
		
		ThisFormSet.VendCode = Vendor.VendCode
	ENDPROC

	PROCEDURE getvendorcontacts
		PARAMETERS nContactID
		*ThisFormSet.GetVendorContacts(nContactID)
		
		IF VARTYPE(nContactID)!="N"
			nContactID = 0
		ENDIF
		
		PRIVATE nVendCode 
		nVendCode = ThisFormSet.VendCode
		
		IF USED('VendorContacts')
			USE IN VendorContacts
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.VendorContact WITH(NOLOCK) "
		cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'VendorContacts')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'VendorContacts' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "VendorContacts")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "VendorContacts")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'VendorContacts' )
		ENDIF
		
		SELECT VendorContacts
		INDEX ON ContactID TAG ContactID
		SET ORDER TO ContactID
		
		SELECT ContactID FROM VendorContacts INTO ARRAY gaContactIDs
		GO TOP
		
		IF RECCOUNT('VendorContacts') < 1
			DIMENSION gaContactIDs(1)
			gaContactIDs(1) = 0
		ENDIF
		
		ThisFormset.frmContact.lstContactID.RowSource = 'gaContactIDs'
		ThisFormset.frmContact.lstContactID.Refresh
		
		IF nContactID = 0
			nContactID = VendorContacts.ContactID
		ENDIF
		
		ThisFormSet.ShowVendorContact(nContactID)
	ENDPROC

	PROCEDURE Init
		PARAMETER pParameter, nSourcePhID
		*DO FORM Forms\Vendor11 WITH nVendCode, nSourcePhID
		
		*ThisFormSet.Pageframe1.pgEdit.Grid1.RecordSource = 'PurchaseOrder'
		
		PUBLIC ARRAY gaContactIDs(1)
		PUBLIC ARRAY gaVendorCompany(1)
		
		ThisFormSet.GetVendorContacts()
		
		ThisFormSet.RefreshViewTab()
		ThisFormset.frmVendor.pf.ActivePage = 2
		ThisFormset.frmVendor.pf.pgView.grdVendor.SetFocus
		
		*ThisFormset.frmSearch.cmbVendorCompany.RowSource = 'gaVendorCompany'
		
		IF TYPE("pParameter") = "N"
			nVendCode = pParameter
			IF nVendCode > 0
				SELECT Vendor
				LOCATE FOR VENDCODE = nVendCode 
				
				IF FOUND()
					*Found Code, now show by Company Order
					ThisFormset.frmVendor.pf.pgView.ogOrder.Value = 2
					SET ORDER TO Company			
		
					ThisFormset.frmVendor.PF.pgView.grdVendor.Refresh()
					ThisFormSet.RefreshViewTab()
					
					ThisFormSet.frmSearch.PF.pgVendCode.txtSearchCompany.Value = nVendCode 
					ThisFormSet.frmSearch.PF.PgCompany.txtSearchCompany.Value = Vendor.Company
					
					ThisFormset.frmVendor.PF.pgView.grdVendor.SetFocus
				ELSE
					MESSAGEBOX("VendCode "+ALLTRIM(STR(nVendCode))+" was not found",0,"Vendor not found!")
				ENDIF	
			ENDIF
		ENDIF
		IF TYPE("pParameter") = "C"
			SELECT Vendor
			LOCATE FOR UPPER(Company) = UPPER(ALLTRIM( pParameter))
			IF NOT FOUND()
				LOCATE FOR UPPER(LEFT(Company,10)) = UPPER(LEFT(pParameter,10))
				IF NOT FOUND()
					LOCATE FOR UPPER(LEFT(Company,8)) = UPPER(LEFT(pParameter,8))
					IF NOT FOUND()
						LOCATE FOR UPPER(LEFT(Company,6)) = UPPER(LEFT(pParameter,6))
						IF NOT FOUND()
							LOCATE FOR UPPER(LEFT(Company,4)) = UPPER(LEFT(pParameter,4))
							IF NOT FOUND()
								MESSAGEBOX("Vender "+ALLTRIM(pParameter)+" was not found",0,"Vendor not found!")
							ELSE
								ThisFormSet.frmSearch.PF.PgCompany.txtSearchCompany.Value = UPPER(LEFT(pParameter,4))
							ENDIF
						ELSE
							ThisFormSet.frmSearch.PF.PgCompany.txtSearchCompany.Value = UPPER(LEFT(pParameter,6))
						ENDIF
					ELSE
						ThisFormSet.frmSearch.PF.PgCompany.txtSearchCompany.Value = UPPER(LEFT(pParameter,8))
					ENDIF
				ELSE
					ThisFormSet.frmSearch.PF.PgCompany.txtSearchCompany.Value = UPPER(LEFT(pParameter,10))
				ENDIF
			ELSE
				ThisFormSet.frmSearch.PF.PgCompany.txtSearchCompany.Value = pParameter
			ENDIF
			
			ThisFormset.frmVendor.PF.pgView.grdVendor.Refresh()
			ThisFormSet.RefreshViewTab()
		
		ENDIF
		
		IF VARTYPE(nSourcePhID) = 'N'
			ThisFormSet.nSourcePhID = nSourcePhID
			ThisFormSet.frmVendor.cmdSaveToSourcePH.Visible = .T.
		ELSE
			ThisFormSet.nSourcePhID = 0
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		*ThisFormSet.GetPurchaseOrders(-720)
		ThisFormSet.GetVendor('INIT')
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE refreshviewtab
		*ThisFormSet.RefreshViewTab()
		
		ThisFormSet.frmVendor.Pf.pgView.cCompany.Value	= ShowSQLtxt(Vendor.Company,'Company',100)
		ThisFormSet.frmVendor.Pf.pgView.cAddr1.Value	= ShowSQLtxt(Vendor.Addr1,'Addr1',100)
		ThisFormSet.frmVendor.Pf.pgView.cAddr2.Value	= ShowSQLtxt(Vendor.Addr2,'Addr2',100)
		ThisFormSet.frmVendor.Pf.pgView.cAddrPOB.Value	= ShowSQLtxt(Vendor.AddrPOB,'AddrPOB',30)
		ThisFormSet.frmVendor.Pf.pgView.cCity.Value		= ShowSQLtxt(Vendor.City,'City',50)
		ThisFormSet.frmVendor.Pf.pgView.cST.Value		= ShowSQLtxt(Vendor.ST,'ST',50)
		*ThisFormSet.frmVendor.Pf.pgView.cZip.Value		= ShowSQLtxt(Vendor.Zip,'Zip',50)
		*ThisFormSet.frmVendor.Pf.pgView.cCountry.Value	= ShowSQLtxt(Vendor.Country,'Country',50)
		ThisFormSet.frmVendor.Pf.pgView.cWebsite.Value	= ShowSQLtxt(Vendor.Website,'Website',50)
		
		ThisFormSet.frmVendor.Pf.pgView.cVend_Notes.Value	= ShowSQLtxt(Vendor.Vend_Notes,'Vend_Notes',-1)
		ThisFormSet.frmVendor.Pf.pgView.cVend_Print.Value	= ShowSQLtxt(Vendor.Vend_Print,'Vend_Print',-1)
		
		ThisFormSet.frmVendor.Pf.pgView.opgQAApproved.Value	= PrepareSQLnum(Vendor.QAApproved,'QAApproved',-1)
		ThisFormSet.frmVendor.Pf.pgView.nQASurveyContactID.Value	= PrepareSQLnum(Vendor.QASurveyContactID,'QASurveyContactID',-3)
		ThisFormset.frmVendor.pf.pgView.dQASurveyDate.Value	= PrepareSQLdate(Vendor.QASurveyDate,'QASurveyDate')
		
		ThisFormSet.frmVendor.Pf.pgView.cPeachID.Value	= ShowSQLtxt(Vendor.PeachID,'PeachID',20)
		ThisFormset.frmVendor.pf.pgView.Inactive.Value	= PrepareSQLchk(Vendor.Inactive,'Inactive')
		ThisFormset.frmVendor.pf.pgView.Metal.Value		= PrepareSQLchk(Vendor.Metal,'Metal')
		*ThisFormset.frmVendor.pf.pgView.chkDLA_BMS.Value	= PrepareSQLchk(Vendor.DLA_BMS,'DLA_BMS')
		ThisFormset.frmVendor.pf.pgView.dLastEdit.Value	= PrepareSQLdate(Vendor.LastEdit,'LastEdit')
		
		ThisFormSet.VendCode = Vendor.VendCode
		ThisFormSet.GetVendorContacts()
	ENDPROC

	PROCEDURE resetaddvars
		*ThisFormSet.ResetAddvars()
		
		ThisFormset.frmVendor.pf.pgAdd.nVendCode.Value = 0
		ThisFormset.frmVendor.pf.pgAdd.cCompany.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cAddr1.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cAddr2.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cAddrPOB.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cCity.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cST.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cCountry.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cZip.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cWebsite.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.opgQAApproved.Value = 0
		ThisFormset.frmVendor.pf.pgAdd.nQASurveyContactID.Value = 0
		ThisFormset.frmVendor.pf.pgAdd.dQASurveyDate.Value = CTOD("  /  /  ")
		ThisFormset.frmVendor.pf.pgAdd.cVend_Notes.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cVend_Print.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.cPeachID.Value = ''
		ThisFormset.frmVendor.pf.pgAdd.Inactive.Value = 0
		ThisFormset.frmVendor.pf.pgAdd.Metal.Value = 0
		ThisFormset.frmVendor.pf.pgAdd.chkDLA_BMS.Value = 0
		ThisFormset.frmVendor.pf.pgAdd.dLastEdit.Value = CTOD("  /  /  ")
		
		
		ThisFormSet.EditMode = .F.
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		*ThisForm.SaveAdd()
		
		IF pSaveType != "C"
			pSaveType = ""
		ENDIF
		*"SAVE" - Check for Rename Updates
			
		PRIVATE lSaveOK, lAbort
		lSaveOK = .T.
		lAbort = .F.
		
		SELECT VENDOR
		PRIVATE lSQLgood, lMany_ID_Details 
		lSQLgood = .T.
		lMany_ID_Details = .F.
		
		
		PRIVATE nVendCode,cCompany,cAddr1,cAddr2,cAddrPOB,cCity,cST,cZip,cCountry
		PRIVATE cWebsite,nInd_Type,cVend_Notes,cVend_Print,cPeachID
		PRIVATE nQAApproved,nQASurveyContactID,dQASurveyDate,lInactive,lMetal,lDLA_BMS,dLastEdit
		
		nVendCode	= PrepareSQLnum(ThisFormSet.frmVendor.Pf.PgAdd.nVendCode.Value,'VendCode',-3,0)
		cCompany	= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cCompany.Value,'Company',100,.F.)
		cAddr1		= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cAddr1.Value,'Addr1',100,.F.)
		cAddr2		= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cAddr2.Value,'Addr2',100,.F.)
		cAddrPOB	= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cAddrPOB.Value,'AddrPOB',30,.F.)
		cCity		= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cCity.Value,'City',50,.F.)
		cST			= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cST.Value,'ST',50,.F.)
		cZip		= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cZip.Value,'Zip',50,.F.)
		cCountry	= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cCountry.Value,'Country',50,.F.)
		cWebsite	= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cWebsite.Value,'Website',30,.F.)
		cVend_Notes	= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cVend_Notes.Value,'Vend_Notes',-1,.F.)
		cVend_Print	= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cVend_Print.Value,'Vend_Print',-1,.F.)
		cPeachID	= PrepareSQLtxt(ThisFormSet.frmVendor.Pf.PgAdd.cPeachID.Value,'PeachID',20,.F.)
		nQAApproved	= PrepareSQLnum(ThisFormSet.frmVendor.Pf.PgAdd.opgQAApproved.Value,'QAApproved',-1)
		nQASurveyContactID	= PrepareSQLnum(ThisFormSet.frmVendor.Pf.PgAdd.nQASurveyContactID.Value,'QASurveyContactID',-3,0)
		dQASurveyDate	= PrepareSQLdate(ThisFormset.frmVendor.pf.pgAdd.dQASurveyDate.Value,'QASurveyDate')
		lInactive	= PrepareSQLchk(ThisFormset.frmVendor.pf.pgAdd.Inactive.Value,'Inactive')
		lMetal		= PrepareSQLchk(ThisFormset.frmVendor.pf.pgAdd.metal.Value,'Metal')
		lDLA_BMS	= PrepareSQLchk(ThisFormset.frmVendor.pf.pgAdd.chkDLA_BMS.Value,'DLA_BMS')
		dLastEdit	= PrepareSQLdate(ThisFormset.frmVendor.pf.pgAdd.dLastEdit.Value,'LastEdit')
		nInd_Type = PrepareSQLnum(ThisFormset.frmVendor.pf.pgAdd.nInd_Type.Value,'Ind_Type',-3)
		
		IF lSaveOK
			IF pSaveType = "MAKECLONE"
				
				WAIT WINDOW "New Vendor Ready to edit and save!" NOWAIT
				RETURN
			ENDIF
		ENDIF
		
		**Check Data
		IF nVendCode = 0
			MESSAGEBOX("Cannot save with out a VendCode",0+16,"Save Error")
			RETURN .F.
		ENDIF
		
		***********
		IF lSaveOK 
			IF EMPTY(cCompany)
				MESSAGEBOX("You must enter a 'Buy from Company' name !",48,"No Vendor - Cannot save.")
				lSaveOK = .F.
			ENDIF
		ENDIF
		
		*!*	*****
		*!*	PRIVATE lFoundCompanyMatchandCode
		*!*	lFoundCompanyMatchandCode= .F.
		*!*	IF lSaveOK
		*!*		
		*!*		IF USED('cntCompanyMatch')
		*!*			USE IN cntCompanyMatch
		*!*		ENDIF
		
		*!*		SELECT 0
		*!*		PRIVATE cSQL, nSQLEXEC
		*!*		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Vendor"
		*!*		cSQL = cSQL + " AND VendCode = "+ALLTRIM(STR(nVendCode))
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntCompanyMatch')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntCompanyMatch' )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Vendor")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Vendor")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntCompanyMatch' )
		*!*		ENDIF
		
		*!*		IF USED('cntCompanyMatch')
		*!*			lFoundCompanyMatchandCode = cntCompanyMatch.CNTD > 0
		*!*			USE IN cntCompanyMatch
		*!*		ENDIF
		*!*	ENDIF		
		*!*	*****
		*!*	PRIVATE lFoundCompanyMatchnotCode
		*!*	lFoundCompanyMatchnotCode = .F.
		*!*	IF lSaveOK
		*!*		
		*!*		IF USED('cntCompanyMatch')
		*!*			USE IN cntCompanyMatch
		*!*		ENDIF
		
		*!*		SELECT 0
		*!*		PRIVATE cSQL, nSQLEXEC
		*!*		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Vendor"
		*!*		cSQL = cSQL + " AND VendCode <> "+ALLTRIM(STR(nVendCode))
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntCompanyMatch')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntCompanyMatch' )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Vendor")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Vendor")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntCompanyMatch' )
		*!*		ENDIF
		
		*!*		IF USED('cntCompanyMatch')
		*!*			lFoundCompanyMatchnotCode = cntCompanyMatch.CNTD > 0
		*!*			USE IN cntCompanyMatch
		*!*		ENDIF
		*!*	ENDIF		
		*!*	*****
		
		IF lSaveOK
			PRIVATE lVendCodeExists
			lVendCodeExists = VendCodeExists( nVendCode, ThisFormSet.nConnHandle )
		
			IF NOT lVendCodeExists
				IF USED('tmpVendCode')
					USE IN tmpVendCode
				ENDIF
				SELECT 0
				
				PRIVATE cSQLi
				cSQLi = "EXEC [dbo].[p_Vendor_ins] "
				cSQLi = cSQLi + " @company='"+cCompany+"'"
				cSQLi = cSQLi + ",@addr1='"+cAddr1+"'"
				cSQLi = cSQLi + ",@addr2='"+cAddr2+"'"
				cSQLi = cSQLi + ",@city='"+cCity+"'"
				cSQLi = cSQLi + ",@st='"+cST+"'"
				cSQLi = cSQLi + ",@zip='"+cZip+"'"
				cSQLi = cSQLi + ",@country='"+cCountry+"'"
			
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpVendCode' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi, 'tmpVendCode' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpVendCode")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpVendCode")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC,'tmpVendCode' )
					lSaveOK = .F.
				ENDIF
				IF USED('tmpVendCode')
					IF VARTYPE(tmpVendCode.EXP) = "N"
						nVendCode = tmpVendCode.EXP
						TrackMess( "Added Vendor:"+ALLTRIM(cCompany)+" as VendCode"+ALLTRIM(STR(nVendCode)) )
						lVendCodeExists = .T.
					ENDIF
					USE IN tmpVendCode
				ENDIF
			ENDIF
			
			IF lVendCodeExists	
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.Vendor SET "
				cSQLu = cSQLu + " Company='"+cCompany+"'"
				cSQLu = cSQLu + ",Addr1='"+cAddr1+"'"
				cSQLu = cSQLu + ",Addr2='"+cAddr2+"'"
				cSQLu = cSQLu + ",AddrPOB='"+cAddrPOB+"'"
				cSQLu = cSQLu + ",City='"+cCity+"'"
				cSQLu = cSQLu + ",ST='"+cST+"'"
				cSQLu = cSQLu + ",Zip='"+cZip+"'"
				cSQLu = cSQLu + ",Country='"+cCountry+"'"
				cSQLu = cSQLu + ",Website='"+cWebsite+"'"
				cSQLu = cSQLu + ",Ind_Type="+STR(nInd_Type)
				cSQLu = cSQLu + ",Vend_Notes='"+cVend_Notes+"'"
				cSQLu = cSQLu + ",Vend_Print='"+cVend_Print+"'"
				cSQLu = cSQLu + ",PeachID='"+cPeachID+"'"
				cSQLu = cSQLu + ",QAApproved="+STR(nQAApproved)
				cSQLu = cSQLu + ",QASurveyContactID="+STR(nQASurveyContactID)
				cSQLu = cSQLu + ",QASurveyDate='"+IIF(EMPTY(dQASurveyDate),'',DTOC(dQASurveyDate))+"'"
				cSQLu = cSQLu + ",Inactive="+IIF(lInactive,'1','0')
				cSQLu = cSQLu + ",Metal="+IIF(lMetal,'1','0')
				cSQLu = cSQLu + ",DLA_BMS="+IIF(lDLA_BMS,'1','0')
				cSQLu = cSQLu + ",LastEdit='"+IIF(EMPTY(dLastEdit),'',DTOC(dLastEdit))+"'"
				cSQLu = cSQLu + " WHERE VendCode = "+ALLTRIM(STR(nVendCode)) 
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
					lSaveOK = .F.
				ELSE
					TrackMess( "Updateded Vendor:"+ALLTRIM(cCompany)+" with the VendCode"+ALLTRIM(STR(nVendCode)) )
				ENDIF
					
			ELSE
		
			ENDIF
		ENDIF
		****
		IF lSaveOK 
			*Saved
		
		
			IF pSaveType = "SAVE"
				*Refresh Data!
				ThisFormSet.GetVendor(nVendCode)
					
				ThisFormSet.ResetAddVars()
			
			ENDIF
			ThisFormSet.EditMode = .F.
		ELSE
			*Did not Save!
			RETURN .F.
		ENDIF
		
		ThisFormSet.frmVendor.Pf.PgAdd.REFRESH
		RETURN .T.
		
		
		
		
	ENDPROC

	PROCEDURE savecontactid
		*ThisFormSet.SaveContactID()
			
		PRIVATE lSaveOK, lAbort
		lSaveOK = .T.
		lAbort = .F.
		
		SELECT VENDOR
		PRIVATE lSQLgood
		lSQLgood = .T.
		
		PRIVATE nContactID,nVendCode,cContact,cPhone,cCellPhone,cFax,cEmail
		PRIVATE cAddr1,cAddr2,cCity,cST,cZip,cCountry
		PRIVATE lQuality,dlastSurveySent,dlastSurveyReceived,cJobTitle,nSurveyPriority,lInactive
		
		nContactID	= PrepareSQLnum(ThisFormset.frmContact.nContactID.Value,'ContactID',-3)
		nVendCode	= PrepareSQLnum(ThisFormset.VendCode,'VendCode',-3)
		cContact	= PrepareSQLtxt(ThisFormSet.frmContact.cContact.Value,'Contact',100)
		cPhone		= PrepareSQLtxt(ThisFormSet.frmContact.cPhone.Value,'Phone',50)
		cCellPhone	= PrepareSQLtxt(ThisFormSet.frmContact.cCellPhone.Value,'CellPhone',20)
		cFax		= PrepareSQLtxt(ThisFormSet.frmContact.cFax.Value,'Fax',20)
		cEmail		= PrepareSQLtxt(ThisFormSet.frmContact.cEmail.Value,'Email',60)
		cAddr1		= PrepareSQLtxt(ThisFormSet.frmContact.cAddr1.Value,'Addr1',100)
		cAddr2		= PrepareSQLtxt(ThisFormSet.frmContact.cAddr2.Value,'Addr2',100)
		cCity		= PrepareSQLtxt(ThisFormSet.frmContact.cCity.Value,'City',50)
		cST			= PrepareSQLtxt(ThisFormSet.frmContact.cSt.Value,'ST',50)
		cZip		= PrepareSQLtxt(ThisFormSet.frmContact.cZip.Value,'Zip',50)
		cCountry	= PrepareSQLtxt(ThisFormSet.frmContact.cCountry.Value,'Country',50)
		lQuality	= PrepareSQLchk(ThisFormSet.frmContact.chkQuality,'Quality')
		dlastSurveySent	= PrepareSQLdate(ThisFormSet.frmContact.dlastSurveySent,'lastSurveySent')
		dlastSurveyReceived	= PrepareSQLdate(ThisFormSet.frmContact.dlastSurveyReceived,'lastSurveyReceived')
		cJobTitle	= PrepareSQLtxt(ThisFormSet.frmContact.cJobTitle.Value,'JobTitle',50)
		nSurveyPriority	= PrepareSQLnum(ThisFormSet.frmContact.nSurveyPriority.Value,'SurveyPriority',-3)
		lInactive	= PrepareSQLchk(ThisFormSet.frmContact.chkVCinactive,'Inactive')
		
		**Check Data
		IF nVendCode = 0
			MESSAGEBOX("Cannot save with out a VendCode",0+16,"Save Error")
			RETURN .F.
		ENDIF
		
		***********
		IF lSaveOK 
			IF EMPTY(cContact)
				MESSAGEBOX("You must enter a 'Contact' name !",48,"No Vendor Contact - Cannot save.")
				lSaveOK = .F.
			ENDIF
		ENDIF
		
		*****
		
		IF lSaveOK
			IF nContactID > 0
			
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.VendorContact SET "
				cSQLu = cSQLu + " Contact='"+cContact+"'"
				cSQLu = cSQLu + ",Phone='"+cPhone+"'"
				cSQLu = cSQLu + ",CellPhone='"+cCellPhone+"'"
				cSQLu = cSQLu + ",Fax='"+cFax+"'"
				cSQLu = cSQLu + ",Email='"+cEmail+"'"
				cSQLu = cSQLu + ",Addr1='"+cAddr1+"'"
				cSQLu = cSQLu + ",Addr2='"+cAddr2+"'"
				cSQLu = cSQLu + ",City='"+cCity+"'"
				cSQLu = cSQLu + ",ST='"+cST+"'"
				cSQLu = cSQLu + ",Zip='"+cZip+"'"
				cSQLu = cSQLu + ",Country='"+cCountry+"'"
				cSQLu = cSQLu + ",Quality='"+IIF(lQuality,'1','0')+"'"
				cSQLu = cSQLu + ",lastSurveySent='"+IIF(EMPTY(dlastSurveySent),'',DTOC(dlastSurveySent))+"'"		
				cSQLu = cSQLu + ",lastSurveyReceived='"+IIF(EMPTY(dlastSurveyReceived),'',DTOC(dlastSurveyReceived))+"'"
				cSQLu = cSQLu + ",JobTitle='"+cJobTitle+"'"
				cSQLu = cSQLu + ",SurveyPriority="+STR(nSurveyPriority)
				cSQLu = cSQLu + ",Inactive='"+IIF(lInactive,'1','0')+"'"
				cSQLu = cSQLu + " WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
					lSaveOK = .F.
				ELSE
					TrackMess( "Update Vendor ContactID:"+ALLTRIM(STR(nContactID))+" with the VendCode"+ALLTRIM(STR(nVendCode)) )
				ENDIF
					
			ELSE
			
				IF USED('VendorContact_ins')
					USE IN VendorContact_ins
				ENDIF
				SELECT 0
			
				PRIVATE cSQLi
				cSQLi = "EXEC dbo.p_VendorContact_ins "
				cSQLi = cSQLi + " @VendCode="+STR(nVendCode)+""
				cSQLi = cSQLi + ",@Contact='"+cContact+"'"
				cSQLi = cSQLi + ",@Phone='"+cPhone+"'"
				cSQLi = cSQLi + ",@CellPhone='"+cCellPhone+"'"
				cSQLi = cSQLi + ",@Fax='"+cFax+"'"
				cSQLi = cSQLi + ",@Email='"+cEmail+"'"
				cSQLi = cSQLi + ",@Addr1='"+cAddr1+"'"
				cSQLi = cSQLi + ",@Addr2='"+cAddr2+"'"
				cSQLi = cSQLi + ",@City='"+cCity+"'"
				cSQLi = cSQLi + ",@ST='"+cST+"'"
				cSQLi = cSQLi + ",@Zip='"+cZip+"'"
				cSQLi = cSQLi + ",@Country='"+cCountry+"'"
				cSQLi = cSQLi + ",@Quality='"+IIF(lQuality,'1','0')+"'"
				cSQLi = cSQLi + ",@lastSurveySent='"+IIF(EMPTY(dlastSurveySent),'',DTOC(dlastSurveySent))+"'"		
				cSQLi = cSQLi + ",@lastSurveyReceived='"+IIF(EMPTY(dlastSurveyReceived),'',DTOC(dlastSurveyReceived))+"'"
				cSQLi = cSQLi + ",@JobTitle='"+cJobTitle+"'"
				cSQLi = cSQLi + ",@SurveyPriority="+STR(nSurveyPriority)
				
		*		cSQLi = cSQLi + "(VendCode,Contact,Phone,CellPhone,Fax,Email"
		*		cSQLi = cSQLi + ",Addr1,Addr2,City,ST,Zip,Country"
		*		cSQLi = cSQLi + ",Quality,lastSurveySent,lastSurveyReceived,JobTitle,SurveyPriority"
		*		cSQLi = cSQLi + ") VALUES ("
		*		cSQLi = cSQLi + STR(nVendCode)
		*		cSQLi = cSQLi + ",'"+cContact+"'"
		*		cSQLi = cSQLi + ",'"+cPhone+"'"
		*		cSQLi = cSQLi + ",'"+cCellPhone+"'"
		*		cSQLi = cSQLi + ",'"+cFax+"'"
		*		cSQLi = cSQLi + ",'"+cEmail+"'"
		*		cSQLi = cSQLi + ",'"+cAddr1+"'"
		*		cSQLi = cSQLi + ",'"+cAddr2+"'"
		*		cSQLi = cSQLi + ",'"+cCity+"'"
		*		cSQLi = cSQLi + ",'"+cST+"'"
		*		cSQLi = cSQLi + ",'"+cZip+"'"
		*		cSQLi = cSQLi + ",'"+cCountry+"'"
		**		cSQLi = cSQLi + ",'"+IIF(lQuality,'1','0')+"'"
		*		cSQLi = cSQLi + ",'"+IIF(EMPTY(dlastSurveySent),'',DTOC(dlastSurveySent))+"'"		
		*		cSQLi = cSQLi + ",'"+IIF(EMPTY(dlastSurveyReceived),'',DTOC(dlastSurveyReceived))+"'"
		*		cSQLi = cSQLi + ",'"+cJobTitle+"'"
		*		cSQLi = cSQLi + ","+STR(nSurveyPriority)
		*		cSQLi = cSQLi + ")"
			
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'VendorContact_ins' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi, 'VendorContact_ins' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "VendorContact_ins")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "VendorContact_ins")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC, 'VendorContact_ins' )
					lSaveOK = .F.
				ELSE
					*get inserted ContactID
					IF USED('VendorContact_ins')
						IF VARTYPE(VendorContact_ins.ContactID) = "N"
							nContactID=VendorContact_ins.ContactID
						ENDIF
						USE IN VendorContact_ins
					
						TrackMess( "Added Vendor ContactID:"+ALLTRIM(STR(nContactID))+" as VendCode"+ALLTRIM(STR(nVendCode)) )
					ENDIF
				ENDIF
		
		
			ENDIF
		ENDIF
		****
		IF lSaveOK 
			*Saved
		
			ThisFormSet.GetVendorContacts(nContactID)
		
		ELSE
			*Did not Save!
			RETURN .F.
		ENDIF
		
		*ThisFormSet.frmVendor.Pf.PgAdd.REFRESH
		RETURN .T.
		
		
		
		
	ENDPROC

	PROCEDURE showvendorcontact
		PARAMETERS nContactID
		*ThisFormSet.ShowVendorContact(VendorContacts.ContactID)
		
		IF NOT USED('VendorContacts')
			WAIT WINDOW "Lost Vendors, reloading..." Nowait
			ThisFormSet.GetVendor()
		ENDIF
		
		IF VARTYPE(VendorContacts.ContactID)!="N"
			MESSAGEBOX('Error')
			RETURN
		ENDIF
		
		SELECT VendorContacts
		SEEK nContactID
		
		IF FOUND()
			ThisFormset.frmContact.nContactID.Value	= PrepareSQLnum(VendorContacts.ContactID,'ContactID',-3)
			ThisFormset.frmContact.cContact.Value	= ShowSQLtxt(VendorContacts.Contact,'Contact',100)
			ThisFormset.frmContact.cPhone.Value		= ShowSQLtxt(VendorContacts.Phone,'Phone',50)
			ThisFormset.frmContact.cCellPhone.Value	= ShowSQLtxt(VendorContacts.CellPhone,'CellPhone',20)
			ThisFormset.frmContact.cFax.Value		= ShowSQLtxt(VendorContacts.Fax,'Fax',20)
			ThisFormset.frmContact.cEmail.Value		= ShowSQLtxt(VendorContacts.Email,'Email',60)
			ThisFormset.frmContact.cAddr1.Value		= ShowSQLtxt(VendorContacts.Addr1,'Addr1',100)
			ThisFormset.frmContact.cAddr2.Value		= ShowSQLtxt(VendorContacts.Addr2,'Addr2',100)
			ThisFormset.frmContact.cCity.Value		= ShowSQLtxt(VendorContacts.City,'City',50)
			ThisFormset.frmContact.cST.Value		= ShowSQLtxt(VendorContacts.ST,'ST',50)
			ThisFormset.frmContact.cZip.Value		= ShowSQLtxt(VendorContacts.Zip,'Zip',50)
			ThisFormset.frmContact.cCountry.Value	= ShowSQLtxt(VendorContacts.Country,'Country',50)
			ThisFormset.frmContact.chkQuality.Value	= PrepareSQLchk(VendorContacts.Quality,'Quality')
			ThisFormset.frmContact.dLastSurveySent.Value	= PrepareSQLdate(VendorContacts.LastSurveySent,'LastSurveySent')
			ThisFormset.frmContact.dLastSurveyReceived.Value	= PrepareSQLdate(VendorContacts.LastSurveyReceived,'LastSurveyReceived')
			ThisFormset.frmContact.cJobTitle.Value			= ShowSQLtxt(VendorContacts.JobTitle,'JobTitle',50)
			ThisFormset.frmContact.nSurveyPriority.Value	= PrepareSQLnum(VendorContacts.SurveyPriority,'SurveyPriority',-3)
			ThisFormset.frmContact.chkVCinactive.Value		= PrepareSQLchk(VendorContacts.Inactive,'Inactive')
		ELSE
			ThisFormset.frmContact.nContactId.Value = 0
			ThisFormset.frmContact.cContact.Value = ''
			ThisFormset.frmContact.cPhone.Value = ''
			ThisFormset.frmContact.cCellPhone.Value = ''
			ThisFormset.frmContact.cFax.Value = ''
			ThisFormset.frmContact.cEmail.Value = ''
			ThisFormset.frmContact.cAddr1.Value = ''
			ThisFormset.frmContact.cAddr2.Value = ''
			ThisFormset.frmContact.cCity.Value = ''
			ThisFormset.frmContact.cST.Value = ''
			ThisFormset.frmContact.cZip.Value = ''
			ThisFormset.frmContact.cCountry.Value = ''
			ThisFormset.frmContact.chkQuality.Value = 0
			ThisFormset.frmContact.dLastSurveySent.Value = CTOD("  /  /  ")
			ThisFormset.frmContact.dLastSurveyReceived.Value = CTOD("  /  /  ")
			ThisFormset.frmContact.cJobTitle.Value = ''
			ThisFormset.frmContact.nSurveyPriority.Value = 0
			ThisFormset.frmContact.chkVCinactive.Value = 0
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		
		
		= SQLDISCONNECT( ThisFormSet.nConnHandle )
		
		
	ENDPROC

	PROCEDURE frmContact.cmdAdd.Click
		*Add
		This.Enabled = .F.
		
		ThisForm.cmdEdit.Caption = "Save"
		ThisForm.cmdDelete.Caption = "Abort"
		
		ThisFormSet.EditContactScreen( 1 )
		
		ThisForm.nContactID.Value = 0
		ThisForm.cContact.SetFocus
		
	ENDPROC

	PROCEDURE frmContact.cmdAdd.When
		IF ThisFormSet.VendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then add the Vendor Contact.",48,"Cannot Add")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmContact.cmdDelete.Click
		IF THIS.Caption = "Delete"
			*Delete
			PRIVATE nContactID
			nContactID = PrepareSQLnum(ThisForm.nContactID.Value,'Contact',-3)
			ThisFormSet.DeleteContactID(nContactID)
			
			ThisForm.cmdAdd.Enabled = .T.
			ThisForm.cmdEdit.Caption = "Edit"
		*	THIS.Caption = "Cancel"
		ELSE
			*Cancel
			ThisFormSet.EditContactScreen(0)
			ThisForm.cmdAdd.Enabled = .T.
			ThisForm.cmdEdit.Caption = "Edit"
			THIS.Caption = "Delete"
		ENDIF
	ENDPROC

	PROCEDURE frmContact.cmdDelete.When
		PRIVATE nContactID
		nContactID = PrepareSQLnum(ThisForm.nContactID.Value,'Contact',-3)
		
		IF THIS.Caption = "Delete"
			IF nContactID = 0 
				MESSAGEBOX("No contact to delete.",48,"Cannot Delete")
				RETURN .F.
			ENDIF
		ELSE
			*Abort
			ThisForm.cmdEdit.Caption = "Edit"
			This.Caption = "Delete"
			ThisFormSet.ShowVendorContact(nContactID)
		ENDIF
		
	ENDPROC

	PROCEDURE frmContact.cmdEdit.Click
		IF THIS.Caption = "Edit"
			*Edit
			ThisFormSet.EditContactScreen( 1 )
			
			ThisForm.cmdAdd.Enabled = .F.
			ThisForm.cmdDelete.Caption = "Abort"
			THIS.Caption = "Save"
		ELSE
			*Save
			IF ThisFormSet.SaveContactID()
				ThisFormSet.EditContactScreen(0)
				
				ThisForm.cmdAdd.Enabled = .T.
				ThisForm.cmdDelete.Caption = "Delete"
				THIS.Caption = "Edit"
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmContact.cmdEdit.When
		IF ThisFormSet.VendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then edit the Vendor Contact.",48,"Cannot Edit")
			RETURN .F.
		ENDIF
		
		IF THIS.Caption = "Edit"
			PRIVATE nContactID
			nContactID = PrepareSQLnum(ThisForm.nContactID.Value,'Contact',-3)
			IF nContactID = 0 
				MESSAGEBOX("Add a Contact First.",48,"Cannot Edit")
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmContact.cmdMove.Click
		*Move
		*This.Enabled = .F.
		
		ThisForm.cmdEdit.Caption = "Edit"
		ThisForm.cmdDelete.Caption = "Delete"
		
		*ThisFormSet.EditContactScreen( 1 )
		
	ENDPROC

	PROCEDURE frmContact.cmdMove.When
		IF ThisFormSet.VendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then add the Vendor Contact.",48,"Cannot Move")
			RETURN .F.
		ENDIF
		
		IF ThisForm.cmdEdit.Caption = "Edit" AND ThisForm.cmdDelete.Caption = "Delete"
			
		ELSE
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE frmContact.lstContactID.InteractiveChange
		ThisFormSet.ShowVendorContact(This.Value)
	ENDPROC

	PROCEDURE frmSearch.pf.pgCompany.cmdSearchShow.Click
		PRIVATE cCompany1,cCompany2
		cCompany1 = PrepareSQLtxt(This.parent.txtSearchCompany.Value,'Company',30)
		cCompany2 = PrepareSQLtxt(This.parent.txtCompany.Value,'Company',30)
		
		PRIVATE lContains,nGoToRecNo 
		lContains = ( This.parent.ogp.Value = 2 )
		
		IF lContains
			IF NOT EMPTY(cCompany1)
				*Good
				SELECT Vendor
				SET ORDER TO TAG Company
		
				LOCATE FOR LIKE( UPPER(ALLTRIM(cCompany1))+"*",UPPER(Company))
						
				IF NOT FOUND()
					MESSAGEBOX("Company '"+cCompany1+"' not Found",0+48,"Not Found")
					nGoToRecNo = RECNO(0)
					IF nGoToRecNo > 0
						GOTO (nGoToRecNo)
					ENDIF
				ENDIF
				
				ThisFormset.frmVendor.pf.pgView.grdVendor.Refresh
				ThisFormset.frmVendor.pf.pgView.SetFocus
				ThisFormset.frmVendor.pf.pgView.grdVendor.SetFocus
				
			ENDIF
		ELSE
			IF NOT EMPTY(cCompany1)
				*Good
				SELECT Vendor
				SET ORDER TO Company
				SEEK cCompany1
				IF NOT FOUND()
					MESSAGEBOX("Company '"+cCompany1+"' not Found",0+48,"Not Found")
					nGoToRecNo = RECNO(0)
					IF nGoToRecNo > 0
						GOTO (nGoToRecNo)
					ENDIF
		
				ENDIF
				
				ThisFormset.frmVendor.pf.pgView.grdVendor.Refresh
				ThisFormset.frmVendor.pf.pgView.SetFocus
				ThisFormset.frmVendor.pf.pgView.grdVendor.SetFocus
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmSearch.pf.pgCompany.txtSearchCompany.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryVendor
		lnInsertionPt = THIS.SELSTART
		ThisFormSet.VendorInsPt = lnInsertionPt 
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		ThisFormSet.VendorSearchStr = lcSearchStr
		lcTryVendor  = ''
		
		PRIVATE nSearchStyle, cSearchStyle
		nSearchStyle = This.parent.ogp.Value
		cSearchStyle = IIF(nSearchStyle=1,"BEGINS","CONTAINS")
		
		IF !EMPTY(lcSearchStr)
		
			lcTryVendor = ALLTRIM(SearchVendorCompany(lcSearchStr, cSearchStyle, ThisFormSet.nConnHandle ))
			
			IF NOT EMPTY(lcTryVendor)
					
				IF UPPER(lcSearchStr) = UPPER(SUBSTR(lcTryVendor,1,lnInsertionPt))
					*Good
					*THIS.VALUE=lcTryVendor
					THIS.FORECOLOR = RGB(0,0,0)
					This.parent.txtCompany.Value = lcTryVendor
					ThisFormSet.VendorCompanyFound = lcTryVendor
				ELSE
				
					IF UPPER(lcSearchStr) $ UPPER(lcTryVendor)
						*Found Middle
						*THIS.VALUE=lcTryVendor
						THIS.FORECOLOR = RGB(0,0,0)
						This.parent.txtCompany.Value = lcTryVendor
						ThisFormSet.VendorCompanyFound = lcTryVendor
					ELSE
						*Bad
					*	THIS.VALUE=lcSearchStr
						THIS.FORECOLOR = RGB(255,0,0)
						This.parent.txtCompany.Value = ""
						ThisFormSet.VendorCompanyFound = ''
					ENDIF
				ENDIF
			ELSE
		*		*No replacement - BAD
				*THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
				This.parent.txtCompany.Value = ""
				ThisFormSet.VendorCompanyFound = ""
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
			This.parent.txtCompany.Value = ""
			ThisFormSet.VendorCompanyFound = ""
		ENDIF
		
		THIS.SELSTART = lnInsertionPt
		*ThisFormSet.VendorInsPt = lnInsertionPt 
	ENDPROC

	PROCEDURE frmSearch.pf.pgCompany.txtSearchCompany.LostFocus
		=insmode(.T.)
		
	ENDPROC

