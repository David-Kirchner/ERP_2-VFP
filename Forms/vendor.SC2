	PROCEDURE deletecontactid
		PARAMETERS nContactID
		*ThisFormSet.DeleteContactID(nContactID)
		
		IF VARTYPE(nContactID)!="N"
			MESSAGEBOX("No ContactID in DeleteContactID",16,"Error")
			RETURN .F.
		ENDIF
		IF nContactID < 1
			MESSAGEBOX("No ContactID in DeleteContactID",16,"Error")
			RETURN .F.
		ENDIF
		
		PRIVATE lOKtoDelete,lSaveOK 
		lOKtoDelete = .T.
		lSaveOK 	= .T.
		
		PRIVATE cSQL, nSQLEXEC
		
		
		***************************************
		*QASurveyContactID 
		
		IF USED('cntVendor')	
			USE IN cntVendor
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.Vendor WHERE QASurveyContactID = "+ALLTRIM(STR(nContactID)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendor' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendor' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendor")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendor")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendor' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendor')
			IF cntVendor.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendor
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in Vendor table as the Survey Contact!"+CHR(13)+"Edit Survey ContactID first",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		
		*******************************
		*ContactID used in another PO
		
		IF USED('cntVendorContact')	
			USE IN cntVendorContact
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.PurchaseOrder WHERE ContactID= "+ALLTRIM(STR(nContactID)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendorContact' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorContact")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorContact')
			IF cntVendorContact.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorContact
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in another Purchase Order!",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		**************************************
		
		cSQL = "DELETE FROM dbo.VendorContact "
		cSQL = cSQL + " WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			lSaveOK = .F.
		ELSE
			TrackMess( "Deleted Vendor ContactID:"+ALLTRIM(STR(nContactID)) )
			ThisFormSet.GetVendorContacts(0)
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE deletevendor
		*ThisFormSet.DeleteVendor()
		PRIVATE nVendCode
		nVendCode = ThisFormSet.VendCode
		PRIVATE lOKtoDelete 
		lOKtoDelete = .T.
		
		PRIVATE cSQL, nSQLEXEC
		**************************
		IF USED('cntVendor')	
			USE IN cntVendor
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.VendorContact WHERE VendCode = "+ALLTRIM(STR(nVendCode)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendor' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendor' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendor")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendor")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendor' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendor')
			IF cntVendor.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendor
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This Vendor has a Contact!"+CHR(13)+"Delete Contacts first",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		
		**************************
		
		IF USED('cntVendorInPO')	
			USE IN cntVendorInPO
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.PurchaseOrder WHERE VendCode = "+ALLTRIM(STR(nVendCode)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntVendorInPO' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntVendorInPO' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorInPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntVendorInPO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntVendorInPO' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorInPO')
			IF cntVendorInPO.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorInPO
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This Vendor is used in PurchaseOrder!"+CHR(13)+"Rename Vendor in PO's first",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		
		**************************
		
		cSQL = "DELETE FROM dbo.Vendor "
		cSQL = cSQL + " WHERE VendCode = "+ALLTRIM(STR(nVendCode)) 
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			lSaveOK = .F.
		ELSE
			TrackMess( "Deleted Vendor WHERE VendCode = "+ALLTRIM(STR(nVendCode))  )
			*ThisFormSet.GetVendorContacts(0)
			ThisFormSet.GetVendor(0)
			
		ENDIF
		
		RETURN .T.
	ENDPROC

