		*!*	PRIVATE nSearchStyle, cSearchStyle
		*!*	nSearchStyle = This.parent.ogp.Value
		*!*	cSearchStyle = IIF(nSearchStyle=1,"BEGINS","CONTAINS")
		
		
		*!*	PRIVATE lcTryVendor
		*!*	lcTryVendor = ALLTRIM(SearchVendorCompany(cVendorCompanyFound, cSearchStyle, ThisFormSet.nConnHandle ))
		*!*		
		
		*!*	IF NOT EMPTY(lcTryVendor)		
		*!*		THIS.VALUE=lcTryVendor
		*!*		THIS.FORECOLOR = RGB(0,0,0)
		*!*	ELSE
		*!*		THIS.FORECOLOR = RGB(255,0,0)
		*!*		WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE frmVendor.cmdDelete.Click
		ThisFormSet.DeleteVendor()
	ENDPROC

	PROCEDURE frmVendor.cmdDelete.When
		RETURN !ThisFormSet.EditMode
	ENDPROC

	PROCEDURE frmVendor.cmdEdit.Click
		
		ThisFormSet.EditMode = .T.
		ThisForm.cmdPrint.Enabled = .F.
		This.Enabled = .F.
		ThisForm.cmdDelete.Enabled = .F.
		ThisFormSet.frmContact.Enabled = .F.
		
		ThisFormSet.EditVendor(Vendor.VendCode)
		
		
		
	ENDPROC

	PROCEDURE frmVendor.cmdEdit.When
		RETURN !ThisFormSet.EditMode
	ENDPROC

	PROCEDURE frmVendor.cmdIND_Type.Click
		DO FORM Forms\IND_Type WITH Vendor.VendCode,'Vendor'
		
		
		
		
	ENDPROC

	PROCEDURE frmVendor.cmdIND_Type.When
		RETURN !ThisFormSet.EditMode
	ENDPROC

	PROCEDURE frmVendor.cmdPrint.Valid
		*!*	PRIVATE cPOCompany, cPOName, cSalesP, lPrintSheetPk, lPrintEvenCancelled
		*!*	cPOCompany	= PurchaseOrder.Company
		*!*	cPOName		= PurchaseOrder.POSalesP
		*!*	cSalesP		= PurchaseOrder.SalesP
		*!*	lPrintSheetPk = .F.
		*!*	lPrintEvenCancelled = .T.
		
		*!*	SELECT PurchaseOrder
		*!*	*SET ORDER TO POItemPO
		*!*	*SET ORDER TO POitem
		*!*	*INDEX ON ValPOitem(POitem) TAG VALPOitem
		*!*	SET ORDER TO VALPOitem
		
		
		*!*	PRIVATE nHpaPo
		*!*	nHpaPo = PurchaseOrder.HpaPo
		*!*	IF TYPE("nHpaPo") = "C"
		*!*		nHpaPo = VAL(nHpaPo)
		*!*	ENDIF
		*!*	PRIVATE nSalesNum
		*!*	nSalesNum= PurchaseOrder.SalesNum
		*!*	IF TYPE("nSalesNum") = "C"
		*!*		nSalesNum= VAL(nSalesNum)
		*!*	ENDIF
		*!*	IF TYPE("nSalesNum") != "N"
		*!*		nSalesNum = 0
		*!*	ENDIF
		
		*!*	nCntPOitem = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle, 'Cancelled' )
		
		*!*	IF nCntPOitem > 0
		*!*		IF MESSAGEBOX("Do you want the Cancelled item"+IIF(nCntPOitem>1,"'s",'')+" to be printed ?",4+32,"Found Cancelled item"+IIF(nCntPOitem>1,"'s",'')+" in this PO")= 6
		*!*			lPrintEvenCancelled = .T.
		*!*		ELSE
		*!*			lPrintEvenCancelled = .F.
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	nSheetPk = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle, 'Sheet_PK' )
		*!*	*SELECT COUNT(*) FROM PurchaseOrder WHERE PurchaseOrder.HpaPo = nHpaPo AND PurchaseOrder.Sheet_Pk=0 INTO ARRAY anSheetPk
		*!*	IF nSheetPk > 0
		*!*		lPrintSheetPk = .T.
		*!*	ENDIF
		
		*!*	SELECT PurchaseOrder
		*!*	*PRIVATE cSafety 
		*!*	*cSafety = SET("SAFETY")
		*!*	*SET SAFETY OFF
		*!*	*INDEX ON HPAPo TAG HPAPo
		*!*	*IF cSafety = "ON"
		*!*	*	SET SAFETY ON
		*!*	*ENDIF
		*!*	*SEEK nHpaPo IN PurchaseOrder ORDER TAG HpaPO
		
		*!*	PRIVATE lFoundVendor
		*!*	*SEEK UPPER(PurchaseOrder.Company) IN VENDOR ORDER TAG UPPCompany
		*!*	lFoundVendor = SelectVendor(PurchaseOrder.VendCode, PurchaseOrder.Company, ThisFormSet.nConnHandle)
		
		*!*	PRIVATE cSQL, nSQLEXEC
		*!*	IF USED('ShipAddr')
		*!*		SELECT ShipAddr
		*!*	ELSE
		*!*		SELECT 0
		*!*	ENDIF
		
		*!*	cSQL="SELECT * FROM dbo.ShipAddr WHERE "
		*!*	IF PurchaseOrder.POShipAddr < 1
		*!*		cSQL = cSQL + "0>0"
		*!*	ELSE
		*!*		cSQL = cSQL + " ShipCode = "+STR(PurchaseOrder.POShipAddr)
		*!*	ENDIF
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle)
		*!*	ENDIF
		
		
		
		*!*	*Only ShipWhere 2,3,4 will print, 1 will Default to the usuall ERP_Loc1
		
		*!*	IF nHpaPo > 0
		*!*		ThisFormSet.VISIBLE = .F.
		*!*		IF MESSAGEBOX("Do You want to Print/Preview this?",4+32,'You must preview to print.') = 6
		*!*			SELECT PurchaseOrder
		*!*			IF NOT lPrintSheetPk
		*!*				*do NOT Print Sheet Packing Instructions
		*!*				*NC is to Not print Cancelled items
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('reports\PurchaseOrder26.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo PREVIEW
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							REPORT FORM reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo TO PRINTER Prompt
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26' not found" NOWAIT
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('reports\PurchaseOrder26nc.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo  AND !purchaseorder.cancelled PREVIEW
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							REPORT FORM reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo AND !purchaseorder.cancelled TO PRINTER PROMPT
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26nc' not found" NOWAIT
		*!*					ENDIF
		*!*				ENDIF
		*!*			ELSE
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('reports\PurchaseOrder26_sheet.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo PREVIEW
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							REPORT FORM reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo TO PRINTER PROMPT
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheet' not found" NOWAIT
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('reports\PurchaseOrder26_sheetNC.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26_sheetNC.FRX FOR HpaPo = nHpaPo AND !purchaseorder.cancelled PREVIEW
		*!*						IF MESSAGEBOX("Do you need a second print?",4+32,'Reprint.') = 6
		*!*							REPORT FORM reports\PurchaseOrder26_sheetNC.FRX FOR HpaPo = nHpaPo AND !purchaseorder.cancelled TO PRINTER PROMPT
		*!*						ENDIF
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheetNC' not found" NOWAIT
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		
		*!*		ENDIF
		*!*		IF MESSAGEBOX("Do You want to Fax this?",4+32,'') = 6
		*!*			
		*!*			PRIVATE lWinFax, lMSFax, nPrinters
		*!*			*MAKE SURE WINFAX IS known as a PRINTER
		*!*			nPrinters=APRINTERS(aaprinters)
		*!*			lWinFax = .F.
		*!*			lMSFax = .F.
		*!*			FOR CT = 1 TO nPrinters
		*!*				IF aaprinters(CT,1)="WinFax"
		*!*					lWinFax = .T.
		*!*				ENDIF
		*!*				IF aaprinters(CT,1)="Fax"
		*!*					lMSFax = .T.
		*!*				ENDIF
		*!*			NEXT CT
		*!*			IF !lWinFax AND !lMSFax 
		*!*				IF MESSAGEBOX("Did not find WinFax or Windows Fax in list of printers."+CHR(13)+"Press 'Yes' to Abort"+CHR(13)+"'No' to atempt." ,4+16,"WinFax not a Print Device") = 6
		*!*					ThisFormSet.VISIBLE = .T.
		*!*					RETURN .F.
		*!*				ENDIF
		*!*			ENDIF
		
		
		*!*			Q_faxnm=""
		*!*			IF lFoundVendor
		*!*				IF !EMPTY(Vendor.Fax_Number)
		*!*					Q_faxnm = Vendor.Fax_Number
		*!*				ENDIF
		*!*			ENDIF
		*!*			IF EMPTY(Q_faxnm)
		*!*				DO FORM Forms\GetNumber WITH cPOCompany,"FAX" TO Q_faxnm
		*!*			ENDIF
		*!*			
		*!*			IF EMPTY(Q_faxnm)
		*!*				MESSAGEBOX("No Fax number",0,'')
		*!*				ThisFormSet.VISIBLE = .T.
		*!*				RETURN .F.
		*!*			ENDIF
		*!*	        
		*!*			Q_faxnm = FaxProper( Q_faxnm )
		
		*!*			IF lMSFax AND NOT lWinFax 
		*!*				SET PRINTER TO NAME 'Fax'
		*!*				
		*!*				PRIVATE FaxServer, lcMachine, FaxDoc  
		*!*				FaxServer=createobject('FAXCOMEX.faxserver')
		*!*				lcMachine = GETWORDNUM(SYS(0),1) && somewhat simpler code; wOOdy
		*!*				FaxServer.Connect( lcMachine )
		
		*!*				FaxDoc = CreateObject("FAXCOMEX.FaxDocument")
		*!*				*FaxDoc.Body = "c:\SampleFax.txt"
		*!*				FaxDoc.DocumentName = "PurchaseOrder"
		*!*				FaxDoc.Recipients.Add (Q_faxnm)
		*!*				
		*!*				*FaxDoc.Sender.Name = "David"
		*!*				*FaxDoc.Sender.FaxNumber = "7656758871"
		
		*!*				*SetCompany(cPOCompany)
		*!*				*SetTo(cPOName)
		
		*!*			ELSE
		*!*				PRIVATE oWFSend
		*!*				* Set the printer to WinFax to fax a report
		*!*				* if printer "WinFax" does not exist then they don't have
		*!*				* WinFax on the PC.  If it was renamed then tough.
		*!*				SET PRINTER TO NAME 'WinFax'
		*!*				*
		*!*				oWFSend = CREATEOBJECT("WinFax.SDKSend")
		*!*				oWFSend.SetClientID(cSalesP) &&SalesQuote.SalesP
		*!*				*
		*!*				oWFSend.EnableBillingCodeKeyWords (0)  &&0=disabled
		*!*				*
		*!*				**************************************************************
		*!*				* Cover page stuff
		*!*				* -------------------
		*!*				oWFSend.SetUseCover (0)
		*!*				oWFSend.SetQuickCover (0)
		*!*				oWFSend.SetCoverFile ("CoverSheet")
		*!*				*
		*!*				* Even if SetUseCover is set to (0) if you use this
		*!*				* you get a cover page. If mCoverText is an empty string
		*!*				* WinFax pops up a window for you to enter the cover text
		*!*				IF .F.
		*!*					oWFSend.SetCoverText ("CoverText")
		*!*				ENDIF
		*!*				**************************************************************
		*!*				*
		*!*				* set resolution to 1 for fine, else 0 (takes much longer to send)
		*!*				oWFSend.SetResolution (1)
		*!*				*
		*!*				oWFSend.SetDeleteAfterSend (0)  && set to 0 to not delete
		*!*				*
		*!*				**************************************************************
		*!*				* Turn Status windows on and off
		*!*				* -------------------------------
		*!*				* ShowCallProgress = 1 shows only the smaller progress window
		*!*				*                  = 0 shows no window
		*!*				oWFSend.ShowCallProgess (1)
		*!*				*
		*!*				* If this is set to 1 then you get the full WinFAx window.
		*!*				* I don't recommend it.
		*!*				oWFSend.ShowSendScreen (0)
		*!*				**************************************************************
		*!*				*
		*!*				*DO \Progs\wfxpara.prg WITH q_faxnm,TIME(),DATE(),Quotes.name,Quotes.company,"Quotation","FAX",STR(Quotes.inqnum,8),"sndquote",.T.,.T.
		
		*!*				oWFSend.SetNumber(Q_faxnm)
		*!*				oWFSend.SetSubject("PurchaseOrder")
		*!*				oWFSend.SetCompany(cPOCompany)
		*!*				oWFSend.SetTo(cPOName)
		*!*				*oWFSend.SetCompany(Quotes.company)
		*!*				*oWFSend.SetTo(Quotes.NAME)
		*!*				*
		*!*				* enters the suff above
		*!*				oWFSend.AddRecipient
		*!*				*
		*!*				* Tell WinFax we are going to print a report to it.
		*!*				oWFSend.SetPrintFromApp(1)
		*!*				oWFSend.SEND (1)
		*!*				*
		*!*				* A most important line.
		*!*				* SDK manual says usage is strongly recommended.
		*!*				oWFSend.LeaveRunning()
		*!*				*
		*!*				**************************************
		*!*			ENDIF
		*!*			
		*!*			* Put your report here
		*!*			SELECT PurchaseOrder
		*!*			IF lPrintSheetPk
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('reports\PurchaseOrder26_sheet.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheet' not found" NOWAIT
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('reports\PurchaseOrder26_sheetnc.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26_sheetnc.FRX FOR HpaPo = nHpaPo AND !purchaseorder.cancelled NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheetnc' not found" NOWAIT
		*!*					ENDIF
		*!*				ENDIF
		*!*			ELSE
		*!*				IF lPrintEvenCancelled
		*!*					IF FILE('reports\PurchaseOrder26.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26' not found" NOWAIT
		*!*					ENDIF
		*!*				ELSE
		*!*					IF FILE('reports\PurchaseOrder26nc.FRX')
		*!*						REPORT FORM reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo AND !purchaseorder.cancelled NOCONSOLE TO PRINTER
		*!*					ELSE
		*!*						WAIT WINDOW "Report form 'reports\PurchaseOrder26NC' not found" NOWAIT
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		
		*!*			IF lMSFax AND NOT lWinFax 
		*!*				JobID = 0
		*!*				JobID = FaxDoc.ConnectedSubmit(FaxServer)
		*!*				INKEY(1)
		*!*				IF JobID > 0
		*!*					=MESSAGEBOX('An error occured sending the fax.',48, 'Fax')
		*!*				ENDIF
		*!*				
		*!*				RELEASE FaxServer
		*!*				RELEASE FaxDoc
		*!*			ELSE
		*!*				**************************************
		*!*				*
		*!*				WAIT WINDOW NOWAIT 'Press Esc if Fax locks.'
		*!*				DO WHILE oWFSend.IsEntryIDReady(0) <> 1
		*!*					* Use this loop to make sure WinFax is ready for
		*!*					* the next fax before you exit this procedure.
		*!*					* Esc allows the user to exit if something hangs.
		*!*					IF LASTKEY() = 27
		*!*						EXIT
		*!*					ENDIF
		*!*				ENDDO
		*!*				WAIT CLEAR
		*!*				*
		*!*				* get the messageid for the conformation.
		*!*				mMessageId = oWFSend.GetEntryID(0)
		*!*				*
		*!*				***************************************************************
		*!*				*
		*!*				mError = oWFSend.GetLastError()
		*!*				IF mError <> 0
		*!*					=MESSAGEBOX('An error occured sending the fax.',48, 'Fax')
		*!*				ENDIF
		*!*				*
		
		*!*				oWFSend.Done()
		*!*				RELEASE oWFSend
		*!*			ENDIF
		*!*			
		*!*			
		*!*			SET PRINTER OFF
		*!*			SET PRINTER TO DEFAULT
		
		*!*			WAIT WINDOW 'Fax routine done' NOWAIT
		*!*		ENDIF
		*!*		
		*!*		
		*!*		CLEAR TYPEAHEAD
		*!*		PRIVATE cEmailTo, cEmailFrom, cFileName,  cSubject, cMessage, cNewPDFName
		*!*		PRIVATE cEmail 
		
		*!*		IF MESSAGEBOX("Do you want to Email?",4+32) = 6
		*!*			IF FILE('reports\PurchaseOrder26.FRX')
		*!*				
		*!*				cEmail = ""
		*!*				IF lFoundVendor
		*!*					IF !EMPTY(Vendor.EMAIL)
		*!*						cEmail  = Vendor.EMAIL
		*!*					ENDIF
		*!*				ENDIF
		*!*				IF EMPTY(cEmail )
		*!*					DO FORM Forms\GetNumber WITH cPOCompany,"EMAIL" TO cEmail 
		*!*				ENDIF
		
		*!*				IF EMPTY(cEmail )
		*!*					MESSAGEBOX("No Email Address")
		*!*					RETURN .F.
		*!*				ENDIF
		
		*!*				cEmailTo	= cEmail
		*!*				cEmailFrom	= SalesPEmail( cSalesP )  &&SalesQuote.SalesP
		*!*				
		*!*				cFileName = EmailFileName("HPA_Reports_PurchaseOrder.PDF")
		
		*!*	*!*				Local loListener As "PdfListener" Of "Pdfx.vcx"
		*!*	*!*				loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
		*!*	*!*				loListener.cCodePage="CP1252" &&CodePage
		*!*	*!*				loListener.cTargetFileName = cFileName
		*!*	*!*				loListener.QuietMode=.F.
		*!*	*!*				loListener.lCanPrint=.T.
		*!*	*!*				loListener.lCanEdit=.F.
		*!*	*!*				loListener.lCanCopy=.T.
		*!*	*!*				loListener.lCanAddNotes=.F.
		*!*	*!*				loListener.lEncryptDocument=.F.
		*!*	*!*				loListener.cMasterPassword=''
		*!*	*!*				loListener.cUserPassword=''
		*!*	*!*				loListener.lOpenViewer=.T.
		*!*		
		*!*				cNewPDFName	= "HPA_PO_"+ALLTRIM(STR( nHpaPo ))+"-"+ALLTRIM(STR( nSalesNum ))+".pdf"
		*!*				cSubject	= "Purchase Order #"+ALLTRIM(STR( nHpaPo ))+"-"+ALLTRIM(STR( nSalesNum ))+" from Space Alloys USA"
		*!*				cMessage	= "Purchase Order #"+ALLTRIM(STR( nHpaPo ))+"-"+ALLTRIM(STR( nSalesNum ))+" from Space Alloys USA"
		*!*				
		*!*				DO WHILE FILE(cFileName),
		*!*					nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
		*!*					IF nMess = 7 &&No
		*!*						DELETE FILE (cFileName)
		*!*					ENDIF
		*!*				ENDDO
		*!*				
		*!*	*******************************************************
		*!*				*-- Get a reference to the Listener class from the Listener.vcx
		*!*				loListener = NEWOBJECT("Listener", "Libs\Listener.VCX")	
		*!*					
		*!*				IF TYPE('loListener') = 'O'
		*!*					*-- Turn off UI feedback and user prompts at end of run
		*!*					loListener.QUIETMODE = .T.
		*!*						
		*!*					lcOutPutFileName = JUSTSTEM(cFileName)
		*!*					lcOutPutFilePath = JUSTPATH(cFileName)
		
		*!*					*lcFRX2AnyLibrary = 'FRX2Any'	 
		*!*					*SET CLASSLIB TO &lcFRX2AnyLibrary IN Libs\FRX2Any.APP ALIAS FRX2Any			
		*!*					IF NOT "FRX2ANY" $ SET("CLASSLIB")
		*!*						SET CLASSLIB TO 'LIBS\FRX2Any' ADDITIVE 
		*!*					ENDIF
		*!*		
		*!*					loListener.oFRX2Any = CREATEOBJECT('FRX2Any.PDFFile')
		
		*!*					IF TYPE('loListener.oFRX2Any') = 'O'
		*!*					*-- Unlock FRX2Any
		*!*						loListener.oFRX2Any.UNLOCK('140601-150910-000255-INGGKG-FONEHK-PFJXPJ-MSJVGJ-AFKLQH')
		
		*!*					*-- NOTE: loListener.oFRX2Any.cExportFileName should not include file extension. For example: loListener.oFRX2Any.cExportFileName = "ReportOutput"
		*!*						loListener.oFRX2Any.cExportFileName = lcOutPutFileName
		
		*!*					*-- NOTE: loListener.oFRX2Any.cSaveFolder should contain only path to the output file. For example: loListener.oFRX2Any.cSaveFolder = "c:\MyApp\MyOutPut\"
		*!*						loListener.oFRX2Any.cSaveFolder     = lcOutPutFilePath
		
		*!*					*-- Specifies that output file will be displayed after creation
		*!*						*loListener.oFRX2Any.nOutPutType     = cnOUTPUT_SCREEN
		*!*						loListener.oFRX2Any.nOutPutType     = 4 &&cnOUTPUT_FILE
		*!*						
		*!*					*-- Default value is cnIMAGE_OUTPUT_FILE_FORMAT_GIF
		*!*					*	loListener.oFRX2Any.nImageFileType  = 4 &&cnIMAGE_OUTPUT_FILE_FORMAT_TIF
		*!*					
		*!*	*				REPORT FORM reports\LakeErie_log RECORD (curgrec) TO PRINT PROMPT NOCONSOLE OBJECT loListener
		*!*						WAIT WINDOW "Making PDF" NOWAIT
		*!*						ThisFormSet.Visible = .F.
		*!*						SELECT PurchaseOrder
		*!*						IF lPrintSheetPk
		*!*							IF lPrintEvenCancelled
		*!*								IF FILE('reports\PurchaseOrder26_sheet.FRX')
		*!*									*REPORT FORM \reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER 
		*!*									REPORT FORM reports\PurchaseOrder26_sheet.FRX FOR HpaPo = nHpaPo Object loListener
		*!*								ELSE
		*!*									WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheet' not found" NOWAIT
		*!*								ENDIF
		*!*							ELSE
		*!*								IF FILE('reports\PurchaseOrder26_sheetnc.FRX')
		*!*									*REPORT FORM \reports\PurchaseOrder26_sheetnc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*									REPORT FORM reports\PurchaseOrder26_sheetNC.FRX FOR HpaPo = nHpaPo AND !purchaseorder.cancelled Object loListener
		*!*								ELSE
		*!*									WAIT WINDOW "Report form 'reports\PurchaseOrder26_sheetnc' not found" NOWAIT
		*!*								ENDIF
		*!*							ENDIF
		*!*						ELSE
		*!*							IF lPrintEvenCancelled
		*!*								IF FILE('reports\PurchaseOrder26.FRX')
		*!*									*REPORT FORM \reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*									REPORT FORM reports\PurchaseOrder26.FRX FOR HpaPo = nHpaPo Object loListener
		*!*								ELSE
		*!*									WAIT WINDOW "Report form 'reports\PurchaseOrder26' not found" NOWAIT
		*!*								ENDIF
		*!*							ELSE
		*!*								IF FILE('reports\PurchaseOrder26nc.FRX')
		*!*									*REPORT FORM \reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo NOCONSOLE TO PRINTER
		*!*									REPORT FORM reports\PurchaseOrder26nc.FRX FOR HpaPo = nHpaPo AND !purchaseorder.cancelled Object loListener
		*!*								ELSE
		*!*									WAIT WINDOW "Report form 'reports\PurchaseOrder26nc' not found" NOWAIT
		*!*								ENDIF
		*!*							ENDIF
		*!*						ENDIF
		*!*						ThisFormSet.Visible = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*				
		*!*				*cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, nConnHandle
		*!*				*DO SendPDFEmail WITH "David.Kirchner@SpaceAlloysUSA.com", "David@SpaceAlloysUSA.com", "\SendPDF\D\Visual FoxPro.pdf","","",ThisFormSet.nConnHandle 
		*!*				 cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName)
		
		*!*				
		*!*				DO CASE
		*!*				CASE "Mail queued" $ cAns
		*!*					WAIT WINDOW "Mail queued." NOWAIT
		*!*					TrackMess("PO "+ALLTRIM(STR(nHpaPo))+" Purchase Order was Emailed to ("+cEmail+") on ("+DTOC(DATE())+")"  )
		*!*				CASE NOT EMPTY(cAns)
		*!*					MESSAGEBOX( cANS,0,"SQL Returned Message!")
		*!*				OTHERWISE
		*!*					WAIT WINDOW "Email Complete" NOWAIT
		*!*					TrackMess("Purchase Order "+ALLTRIM(STR(nHpaPo))+" was Emailed to ("+cEmail+") on ("+DTOC(DATE())+")"  )
		*!*				ENDCASE
		*!*				
		*!*			ELSE
		*!*				WAIT WINDOW "Report form 'reports\PurchaseOrder26.FRX' not found" TIMEOUT 4
		*!*			ENDIF
		
		*!*		ENDIF
		
		*!*		ThisFormSet.VISIBLE = .T.
		*!*	ELSE
		*!*		MESSAGEBOX("No ERP PO Number!!!")
		*!*	ENDIF
		
		*!*	*keep PurchaseOrder open!
		
		*!*	IF USED("ShipAddr")
		*!*		USE IN ShipAddr
		*!*	ENDIF
		*!*	IF USED('Vendor')
		*!*		USE IN Vendor
		*!*	ENDIF
		
		
		
	ENDPROC

	PROCEDURE frmVendor.cmdPrint.When
		RETURN !ThisFormSet.EditMode
	ENDPROC

	PROCEDURE frmVendor.cmdQuit.Click
		ThisFormSet.Release
	ENDPROC

	PROCEDURE frmVendor.cmdsaveToSourcePH.Valid
		PRIVATE nMess, nVendCode, cvCompany, cSourceCompany, nSourcePhID
		nMess = 0
		nVendCode = PrepareSQLnum(Vendor.VendCode,'VendCode',-3)
		cvCompany = PrepareSQLtxt(Vendor.Company,'Company',30)
		cSourceCompany = ''
		nSourcePhID = ThisFormSet.nSourcePhID
		
		PRIVATE cSQL, nSQLEXEC
		
		IF nSourcePhID > 0
		
			cSQL = "SELECT Company FROM dbo.SourcePH "
			cSQL = cSQL + " WHERE ID="+STR(nSourcePhID)
		
			IF USED("tmpSourcePH_Comp")
				SELECT tmpSourcePH_Comp
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSourcePH_Comp')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSourcePH_Comp')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSourcePH_Comp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSourcePH_Comp")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSourcePH_Comp')
			ELSE
				IF USED("tmpSourcePH_Comp")
					IF RECCOUNT('tmpSourcePH_Comp') > 0
						cSourceCompany = PrepareSQLtxt(tmpSourcePH_Comp.Company,'Company',30)
					ENDIF
					USE IN tmpSourcePH_Comp
				ENDIF
			ENDIF
		ENDIF
		
		nMess = MESSAGEBOX("Are you sure you want to Connect"+CHR(13)+"         this Vendor:"+cvCompany+CHR(13)+"with this Source:"+cSourceCompany,32+4,"Store connection")
		IF nMess = 6
			cSQL = "UPDATE dbo.SourcePH "
			cSQL = cSQL + " SET VendCode = "+STR(nVendCode)
			cSQL = cSQL + " WHERE ID="+STR(nSourcePhID)
		
			IF USED("tmpSourcePH_Comp")
				SELECT tmpSourcePH_Comp
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSourcePH_Comp')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSourcePH_Comp')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSourcePH_Comp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSourcePH_Comp")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSourcePH_Comp')
			ELSE
				MESSAGEBOX("Stored Connection."+CHR(13)+"Refresh your Vendor screen to see the update.",48,"Done")
				This.Visible = .F.
			ENDIF
			IF USED("tmpSourcePH_Comp")
				USE IN tmpSourcePH_Comp
			ENDIF
		
			
		ENDIF
	ENDPROC

	PROCEDURE frmVendor.cmdsaveToSourcePH.When
		RETURN !ThisFormSet.EditMode
	ENDPROC

	PROCEDURE frmVendor.pf.pgAdd.cmbContactID.InteractiveChange
		PRIVATE nContactID
		nContactID = PrepareSQLnum(This.Value,'ContactID',-3)
		This.parent.nQASurveyContactID.Value = nContactID 
		ThisFormSet.GetVendorContacts(nContactID )
	ENDPROC

	PROCEDURE frmVendor.pf.pgAdd.cmbContactID.LostFocus
		This.Visible = .F.
	ENDPROC

	PROCEDURE frmVendor.pf.pgAdd.cmdAdd.Click
		IF This.Caption = "\<Add"
		
			ThisFormSet.ResetAddvars()
			
			ThisFormSet.New = .T.
			ThisFormSet.EditScreen(1)
			This.Caption = "\<Save"
			
			PRIVATE nVendCode 
			nVendCode = GetNextVendorCode( ThisFormSet.nConnHandle )
			This.parent.nVendCode.Value = nVendCode
			
			WAIT WINDOW "New Vendor Ready to edit and save!" NOWAIT
		
			This.parent.cCompany.SetFocus()
		
		
		ELSE
			*\<Save
			IF ThisFormSet.SaveAdd("SAVE")
				ThisFormSet.New = .F.
				ThisFormSet.EditScreen(0)
				This.Caption = "\<Add"
				
				This.parent.parent.pgView.grdVendor.RecordSource = 'Vendor'
				This.parent.parent.ActivePage = 2
				This.parent.parent.pgView.grdVendor.SetFocus
		
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmVendor.pf.pgAdd.cmdClear.Click
		ThisFormSet.ResetAddVars()	
		ThisFormSet.Editing = .F.
		ThisFormSet.EditScreen(0)
		ThisFormSet.New = .F.
		
		
		This.Parent.cmdAdd.Caption = "\<Add"
		
		ThisForm.cmdPrint.Enabled = .T.
		ThisForm.cmdEdit.Enabled = .T.
		ThisForm.cmdDelete.Enabled = .T.
		ThisFormSet.frmContact.Enabled = .T.
		
		This.Parent.Refresh
		
		*This.Parent.txtHpapo.SetFocus()
	ENDPROC

	PROCEDURE frmVendor.pf.pgAdd.cmdInd_Type.Click
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(This.parent.nVendCode.Value,'VendCode',-3,0)
		
		IF nVendCode < 1
			MESSAGEBOX("Need a Vendor Code First",16,"")
			RETURN
		ENDIF
		
		DO FORM Forms\IND_Type WITH nVendCode,'VENDOR'
		
		PRIVATE nIND_Type
		nIND_Type = getIND_Type( 'VENDOR', nVendCode, ThisFormSet.nConnHandle)
		
		This.parent.nInd_Type.Value = nIND_Type 
		This.parent.nInd_Type.Refresh
	ENDPROC

	PROCEDURE frmVendor.pf.pgAdd.cmdMove.Click
		IF This.Caption = "Move"
		
		*	ThisFormSet.New = .T.
			ThisFormSet.EditScreen(0)
			This.Caption = "Save"
			
			ThisFormSet.VendCode = PrepareSQLnum(This.Parent.nVendCode.Value,'VendCode',-3)
			
			This.parent.nVendCode.Enabled = .T.	
			This.parent.cCompany.Enabled = .F.
			This.Parent.cAddr1.Enabled = .F.
			This.Parent.cAddr2.Enabled = .F.
			This.Parent.cAddrPOB.Enabled = .F.
			This.Parent.cCity.Enabled = .F.
			This.Parent.cST.Enabled = .F.
			This.Parent.cCountry.Enabled = .F.
			This.Parent.cZip.Enabled = .F.
			This.Parent.cWebsite.Enabled = .F.
			This.Parent.opgQAApproved.Enabled = .F.
			This.Parent.nQASurveyContactID.Enabled = .F.
			This.Parent.dQASurveyDate.Enabled = .F.
			This.Parent.cVend_Notes.Enabled = .F.
			This.Parent.cVend_Print.Enabled = .F.
			This.Parent.cPeachID.Enabled = .F.
			This.Parent.Inactive.Enabled = .F.
			This.Parent.Metal.Enabled = .F.
			This.Parent.chkDLABMS.Enabled = .F.
			This.Parent.dLastEdit.Enabled = .F.
			
			This.parent.opgQAApproved.Enabled = .F.
			This.parent.cmdAdd.Enabled = .F.
			This.Parent.cmdClear.Enabled = .F.
			
			ThisForm.cmdPrint.Enabled = .F.
			ThisForm.cmdEdit.Enabled = .F.
			ThisForm.cmdDelete.Enabled = .F.
			This.Enabled = .T.
			
			MESSAGEBOX("Do not wory about this old address here."+CHR(13)+"All records with old VendCode will be update to use the new Vendcode."+CHR(13)+"The Address of the new Vencode will then be THE Address.",64,"Removing old VendCode.")
			
		ELSE
			*\<Save
			PRIVATE nNewVendCode
			nNewVendCode = PrepareSQLnum(This.Parent.nVendCode.Value,'VendCode',-3)
			
			This.parent.nVendCode.Enabled = .F.	
			This.parent.cCompany.Enabled = .T.
			This.Parent.cAddr1.Enabled = .T.
			This.Parent.cAddr2.Enabled = .T.
			This.Parent.cAddrPOB.Enabled = .T.
			This.Parent.cCity.Enabled = .T.
			This.Parent.cST.Enabled = .T.
			This.Parent.cCountry.Enabled = .T.
			This.Parent.cZip.Enabled = .T.
			This.Parent.cWebsite.Enabled = .T.
			This.Parent.opgQAApproved.Enabled = .T.
			This.Parent.nQASurveyContactID.Enabled = .T.
			This.Parent.dQASurveyDate.Enabled = .T.
			This.Parent.cVend_Notes.Enabled = .T.
			This.Parent.cVend_Print.Enabled = .T.
			This.Parent.cPeachID.Enabled = .T.
			This.Parent.Inactive.Enabled = .T.
			This.Parent.Metal.Enabled = .T.
			This.Parent.chkDLA_BMS.Enabled = .T.
			This.Parent.dLastEdit.Enabled = .T.
			
			ThisFormSet.ResetAddvars()
		
			ThisFormSet.EditScreen(0)
			This.Caption = "Move"
				
			This.parent.opgQAApproved.Enabled = .T.
			This.parent.cmdAdd.Enabled = .T.
			This.Parent.cmdClear.Enabled = .T.
		
			ThisForm.cmdPrint.Enabled = .T.
			ThisForm.cmdEdit.Enabled = .T.
			ThisForm.cmdDelete.Enabled = .T.
			This.Enabled = .F.
		
			IF ThisFormSet.VendCode > 0
				IF nNewVendCode > 0
					IF ThisFormSet.VendCode <> nNewVendCode
						*
						PRIVATE cCompany 
						cCompany = ''
						IF USED('tmpVendor')
							USE IN tmpVendor
						ENDIF
						SELECT 0
						PRIVATE cSQL, nSQLEXEC
		
						cSQL = "SELECT Company FROM dbo.Vendor WITH(NOLOCK) "
						cSQL = cSQL + " WHERE VendCode="+ALLTRIM(STR(nNewVendCode))
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpVendor')
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpVendor' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpVendor' )
						ENDIF
		
						IF USED('tmpVendor')
							IF VARTYPE(tmpVendor.Company) = "C"
								cCompany = tmpVendor.Company
							ENDIF
							USE IN tmpVendor
						ENDIF
						
						IF MESSAGEBOX("Are you sure you want to remove this Vendor "+CHR(13)+" and update old records that referenced this vendor "+CHR(13)+"to the new vendor '"+ALLTRIM(cCompany)+"'",4+48,"Move Vendor code.") = 6
							*Make the Move.
							cSQL = "BEGIN TRANSACTION; "
							cSQL = cSQL + " UPDATE dbo.VendorContact "
							cSQL = cSQL + " SET VendCode = "+ALLTRIM(STR(nNewVendCode))
							cSQL = cSQL + " WHERE VendCode="+ALLTRIM(STR(ThisFormSet.VendCode))
							cSQL = cSQL + "; "
							cSQL = cSQL + " UPDATE dbo.PurchaseOrder "
							cSQL = cSQL + " SET VendCode = "+ALLTRIM(STR(nNewVendCode))
							cSQL = cSQL + " WHERE VendCode="+ALLTRIM(STR(ThisFormSet.VendCode))
							cSQL = cSQL + "; "
							cSQL = cSQL + " DELETE FROM dbo.Vendor "
							cSQL = cSQL + " WHERE VendCode="+ALLTRIM(STR(ThisFormSet.VendCode))
							cSQL = cSQL + "; "
							cSQL = cSQL + " COMMIT TRANSACTION "
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ENDIF
							
							
		
							ThisFormSet.VendCode = nNewVendCode
							ThisFormSet.GetVendor(nNewVendCode)
							ThisFormSet.RefreshViewTab()
		
				
						ENDIF
						
					ENDIF	
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmVendor.pf.pgAdd.lblQASurveyContactID.Click
		IF ThisFormSet.EditMode
			This.parent.cmbContactID.RowSource = 'gaContactIDs'
		*	This.parent.cmbContactID.Value = gaContactIDs(1)
			
			This.parent.cmbContactID.Refresh
			This.parent.cmbContactID.Visible =.T.
			This.parent.cmbContactID.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE frmVendor.pf.pgView.grdVendor.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisFormSet.VendCode = Vendor.VendCode
		ThisFormSet.RefreshViewTab()
	ENDPROC

	PROCEDURE frmVendor.pf.pgView.ogOrder.Click
		SELECT Vendor
		DO CASE 
		CASE This.Value = 1
			SET ORDER TO VendCode
		CASE This.Value = 2
			SET ORDER TO Company
		CASE This.Value = 3
			SET ORDER TO PeachID
		OTHERWISE
			SET ORDER TO VendCode
		ENDCASE
		
		This.parent.grdVendor.Refresh
	ENDPROC


	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC
ENDDEFINE
