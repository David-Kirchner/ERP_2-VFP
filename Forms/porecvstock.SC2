	PROCEDURE cmdRequestStandard.Click
		PRIVATE pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, lQuiet, lNoHeadder
		
		pcEmailTo	= "David.Kirchner@SpaceAlloysUSA.com"
		pcEmailFrom	= "DoNotReply@SpaceAlloysUSA.com"
		pcEmailSubject= "New price table entry needed."
		
		lQuiet		= .F.
		lNoHeadder	= .T.
		
		PRIVATE m.lcAlloy,m.lcForm,m.lcCC,m.lcCL,m.lcCond,m.lnSize
		m.lcAlloy		= PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		m.lcForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		m.lcCC			= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.T.)
		m.lcCL			= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1,.T.)
		m.lcCond		= PrepareSQLtxt(ThisForm.Cond1.Value,'Condition',30)
		m.lnSize		= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,3)
		
		pcEmailText	= "New price table entry needed for"+CHR(13)
		pcEmailText	= pcEmailText + "Alloy:"+m.lcAlloy+CHR(13)
		pcEmailText	= pcEmailText + "Form:"+m.lcForm+CHR(13)
		pcEmailText	= pcEmailText + "CC:"+m.lcCC+CHR(13)
		pcEmailText	= pcEmailText + "CL:"+m.lcCL+CHR(13)
		pcEmailText	= pcEmailText + "Cond:"+m.lcCond+CHR(13)
		pcEmailText	= pcEmailText + "Size:"+ALLTRIM(STR(m.lnSize,9,3))+CHR(13)
		pcEmailText	= pcEmailText + SYS(0)
		
		Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, ThisForm.nConnHandle, lQuiet, lNoHeadder)
		
		MESSAGEBOX("Request to add this Alloy,form,cc,cl,size to Price table has been sent",0,"Email Request")
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE lOK, lSave
		lOK = .F.
		lSave = ThisForm.CheckSave()
		
		IF lSave
			lOK = ThisForm.SaveAdd()
			IF lOK 
				THISFORM.RELEASE
			ELSE
				MESSAGEBOX("The save FAILED."+CHR(13)+"Abort or retry the save.",0,"Not Saved")
			ENDIF
		ELSE
			WAIT WINDOW "Go back and Edit" NoWait
		ENDIF
	ENDPROC

	PROCEDURE cmdSaveClone.Click
		PRIVATE lOK, lSave
		lSave = ThisForm.CheckSave()
		
		IF lSave
			IF ThisForm.cmdQuit.Caption != "Done"
				lOK = ThisForm.SaveAdd()
			ELSE 
				lOK = .T.
			ENDIF
		ELSE
			lOK = .F.
		ENDIF
		
		IF lOK 
			ThisForm.cmdQuit.Caption = "Done"
			ThisForm.cmdSave.Enabled = .F.
			This.Caption = "Add another Detail"
			
			PRIVATE cWhatDo, m.lnID, nProcessID, pLst, nReceivingID
			cWhatDo= "ADD"
			m.lnID = ThisForm.ID1.Value
			nProcessID = 0
			pLst = "StockLst"
			nReceivingID = ThisForm.txtReceivingID.Value
			
			DO FORM Forms\StockLst_Detail WITH cWhatDo, m.lnID, nProcessID, pLst, nReceivingID
		ELSE
			MESSAGEBOX("The save FAILED."+CHR(13)+"Abort or retry the save.",0,"Not Saved")
		ENDIF
		
	ENDPROC

	PROCEDURE DIM11.GotFocus
		This.InputMask = "999999999999999.9999"
	ENDPROC

	PROCEDURE DIM11.LostFocus
		This.InputMask = "999,999,999,999,999.9999"
	ENDPROC

	PROCEDURE DIM11.Valid
		PRIVATE m.num
		m.Num = PrepareSQLNum(This.Value,'Dim1',18,4)
		IF TYPE("m.num") = "C"
			m.num = VAL(m.num)
		ENDIF
		IF m.num > 0
			PRIVATE nSize_H1, nSize_L1 
			nSize_H1 = PrepareSQLNum(ThisForm.Size_H1.Value,'Size_H1',9,4)
			nSize_L1 = PrepareSQLNum(ThisForm.Size_L1.Value,'Size_L1',9,4)
			IF nSize_H1 > 0
				IF nSize_H1  < This.Value
					*MESSAGEBOX( "The High Tolerance is usually above the DIM 1.",0,"Caution")
					WAIT WINDOW "The High Tolerance is usually above the DIM 1" NOWAIT
				ENDIF
			ENDIF
			IF nSize_L1 > 0
				IF nSize_L1 > PrepareSQLnum(This.Value,'DIM1',10,4)
					*MESSAGEBOX( "The Low Tolerance is usually below the DIM 1.",0,"Caution")
					WAIT WINDOW "The High Tolerance is usually below the DIM 1" NOWAIT
				ENDIF
			ENDIF
		ELSE
			IF m.num < 0
				MESSAGEBOX( "The DIM 1 is not be be negative.",0,"Error")
			ENDIF
		ENDIF
		ThisForm.POrecvStock_Calc()  &&Calcs Weight and QTY
	ENDPROC

