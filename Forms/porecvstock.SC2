		*!*	ENDIF
		
		
		***********************************************
		IF lInsertStock
			*Insert
			*p_StockLst_Master_Ins p_BrockerLst_Master_Ins
			
			PRIVATE nOldID_Master, nOldID_Detail
			nOldID_Master = PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
			nOldID_Detail = PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
			
			IF ThisForm.lblDeleted.Visible
				IF nOldID_Master > 0
					*Check for Permission to bring back DELETED record!.
					IF HavePermission('ReReceiveSTK')
						*INSERT INTO dbo.AppSetup (UN,PRP,ANS) VALUES ('David Kirchner','YES','ReReceiveSTK')
						TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+" for DELETED rec is now reADDed. "+", Deleted ID="+ALLTRIM(STR(nOldID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item)+"!")
						THISFORM.txtWhatDo.Value = "ReADD"
					ELSE
						*bad news
						MESSAGEBOX("You are not allowed to Receive in Stock that has been received and now DELETED."+CHR(13)+;
							"Create a new Heat/Master ID and Save or have David Receive this in.",16,"Not allowed!")
							
		*				= SQLROLLBACK(ThisForm.nConnHandle)
		*				= SQLSETPROP(THISFORM.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
						RETURN .F.
						
					ENDIF
				ENDIF
			ENDIF
			
			*********************
			= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
			*********************
		
			IF ThisForm.lblRMA.Visible
			ENDIF
			
			cSQLi = "EXEC dbo.p_Lst_Master_ins "
			cSQLi = cSQLi+ " @TBL ='"+ThisForm.cTBL+"'"
			cSQLi = cSQLi+ ",@Alloy ='"+m.lcAlloy+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Form ='"+m.lcForm+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@cc ='"+ALLTRIM(IIF(ISNULL(m.lcCC),'1',m.lcCC))+"'"   &&NOT NULL	
			cSQLi = cSQLi+ ",@Cond ='"+m.lcCond+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Size ="+STR(m.lnSize,9,3)+""   &&NOT NULL
			cSQLi = cSQLi+ ",@PAID ="+STR(m.lnPAID,9,2)+""
			cSQLi = cSQLi+ ",@MWeight ="+"0"+""   && INIT 0, Detail Trigger will fill!
			cSQLi = cSQLi+ ",@specs ='"+m.lcSpecs+"'"
			cSQLi = cSQLi+ ",@Heat ='"+m.lcHeat+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Lot ='"+m.lcLot+"'"
			cSQLi = cSQLi+ ",@PO_Item ='"+m.lcPO_Item+"'"
			cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(m.ldPODueDate),'',DTOC(m.ldPODueDate))+"'"
			cSQLi = cSQLi+ ",@History ='"+m.lcHistory+"'"
			cSQLi = cSQLi+ ",@Mill ='"+m.lcMill+"'"
			cSQLi = cSQLi+ ",@StkDate ='"+IIF(EMPTY(m.ldStkDate),'',DTOC(m.ldStkDate))+"'"
			cSQLi = cSQLi+ ",@Num ="+STR(m.lnNum,8,0)+""
			cSQLi = cSQLi+ ",@POStatus ='"+m.lcPOStatus+"'"
			cSQLi = cSQLi+ ",@BrandName ='"+m.lcBrandName+"'"
			cSQLi = cSQLi+ ",@From_ID ="+STR(nOldID_Master)+""
			cSQLi = cSQLi+ ",@Melt ='"+m.lcMelt+"'"
			cSQLi = cSQLi+ ",@WO_Detail ="+STR(m.lnWO_Detail)+""
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Master')
				lRollBack = .T.
			ELSE
		*					=SQLCOMMIT(ThisForm.nConnHandle)
				m.lnID = 0	
				IF USED("tmpID_Master")
					IF RECCOUNT("tmpID_Master") > 0
						m.lnID = tmpID_Master.EXP
						ThisForm.ID1.Value = m.lnID
						ThisForm.ID1.Refresh
						USE IN tmpID_Master 
					ELSE
						TrackError("Trouble"+CHR(13)+cSQLi,"No ID",PROGRAM(),LINENO(1))
					ENDIF
					
					IF m.lnID > 0
		
						********************************
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Master SET "
						CASE ThisForm.cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Master SET "
						CASE ThisForm.cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Master SET "
						ENDCASE
						cSQL = cSQL+ " CL='"+m.lcCL+"'"   &&NOT NULL
						cSQL = cSQL+ " WHERE ID="+STR(m.lnID)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
						*	lOK = .F.
						*	lRollBack = .T.
						*ELSE
						*	TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item))
						ENDIF
						********************************
						
						IF nReceivingID > 0 AND m.lnID > 0 AND nRMA_Detail = 0
							TrackMess("PO ReceivingID ="+ALLTRIM(STR(nReceivingID))+" for DELETED rec is now reADDed. "+", Deleted ID="+ALLTRIM(STR(nOldID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item)+"!"+CHR(13)+" New ID:"+ALLTRIM(STR(m.lnID))+" of Table:"+ThisForm.cTBL )
							
							cSQLu = "UPDATE dbo.Receiving SET ID_Master = "+STR(m.lnID)
							IF m.lnID_Detail > 0
								cSQLu = cSQLu + ", ID_Detail = "+STR(m.lnID_Detail)
							ENDIF
							cSQLu = cSQLu + ", StockTable = '"+ThisForm.cTBL+"'"
							cSQLu = cSQLu + " WHERE ID = "+STR(nReceivingID)
		
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLu )	
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!, long trigger
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
								ENDDO
							ENDIF
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO 
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQLu, ThisForm.nConnHandle)
							ELSE
								TrackMess("PO Receive:"+ALLTRIM(m.lcPO_Item)+", Added to StockTable='"+ThisForm.cTBL+"'"+" ID_Master="+ALLTRIM(STR(m.lnID))+" Receiving ID="+ALLTRIM(STR(nReceivingID)) )
							ENDIF
						ENDIF
					ENDIF
				ELSE
					TrackError("Trouble"+CHR(13)+cSQLi,"no ID ",PROGRAM(),LINENO(1))
				ENDIF		
			ENDIF
		ELSE
		
			*********************
			= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
			*********************
		
			IF UPPER(ALLTRIM(ThisForm.txtWhatDo.Value)) != "RETURN"
				*Remove "ADD" so Detail is not Added!
				IF UPPER(ALLTRIM(ThisForm.txtWhatDo.Value)) = "ADD"
					ThisForm.txtWhatDo.Value = "NoADD"
				ENDIF
			ENDIF
		ENDIF
		
		
		**********************************************
		*IF UPPER(ALLTRIM(THISFORM.txtWhatDo.Value)) = "RETURN"
		*ENDIF
		
		
		PRIVATE lDoNotUpdateStockLst, nNewID_Master
		lDoNotUpdateStockLst = .F.
		nNewID_Master = 0
		**********************************************
		IF UPPER(ALLTRIM(THISFORM.txtWhatDo.Value)) = "EDIT"
		
			****check for a Broker that adds stock
			IF ThisForm.txtTableName1.Value = "BrokerLst"
				IF MESSAGEBOX("Double checking!"+CHR(13)+CHR(13)+"Was there any stock left over to add to StockLst?",4+32+256,"BrokerLst receive is complete.")=6
					
					*Change Broker status to StockLst - leaving a good Stock History
					
					nNewID_Master = ThisForm.RecvStockMoveBroker2Stock()
					
					IF nNewID_Master > 0
						*Success, make sure the Add is to StockLst
						
						ThisForm.txtTableName1.Value = "StockLst"
						ThisForm.cTBL = "S"
						ThisForm.ID1.Value = nNewID_Master 
						*ThisForm.ID_DETAIL1.Value = 0  'set in RecvStockMoveBroker2Stock
						m.lnID_Detail	=  PrepareSQLnum(Thisform.ID_Detail1.Value,'ID_Detail',-3)
						m.lnID = nNewID_Master
		
					ELSE
						lOK = .F.
						lRollBack = .T.
					ENDIF
				ENDIF
			ENDIF
				
			IF m.lnID < 1
				PRIVATE cSQL3
				*dbo.StockLst_Detail dbo.BrokerLst_Detail
				cSQL3 = "SELECT [ID] FROM "
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL3 = cSQL3 + " dbo.StockLst_Detail "
				CASE ThisForm.cTBL = "B"
					cSQL3 = cSQL3 + " dbo.BrokerLst_Detail "
				CASE ThisForm.cTBL = "W"
					cSQL3 = cSQL3 + " dbo.WIPLst_Detail "
				ENDCASE
				cSQL3 = cSQL3 + " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
				
				IF USED("tmpC_Master3")
					SELECT tmpC_Master3
				ELSE
					SELECT 0
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, 'tmpC_Master3')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, 'tmpC_Master3')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, "tmpC_Master3")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, "tmpC_Master3")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL3,ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Master3')
				ELSE
					m.lnID = tmpC_Master3.ID
					ThisForm.id1.Value = m.lnID
				ENDIF
			ENDIF
			
			*****************************
			*Make Sure Master has not been Changed- Do not overwrite changed stock. !?!?
			
			IF USED("tmpStockLst_MasterH")
				SELECT tmpStockLst_MasterH
			ELSE
				SELECT 0
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS CNTD FROM ( "
			cSQL = cSQL + " SELECT DISTINCT ProcessValue "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL +" FROM dbo.Ar_Stocklst_Detail_History "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL +" FROM dbo.Ar_BrokerLst_Detail_History "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL +" FROM dbo.Ar_WIPlst_Detail_History "
			ENDCASE
			cSQL = cSQL+ " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
			cSQL = cSQL + " AND [WHAT]='BEFOREEDIT'"
			cSQL = cSQL + " AND ProcessValue <> 0 "
			cSQL = cSQL + " ) t "
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_MasterH")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_MasterH")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpStockLst_MasterH')
		
				ThisForm.txtWhatDo.Value = "NoADD"
				lDoNotUpdateStockLst = .T.
				TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"Found Process in History!")
			ELSE
				IF USED('tmpStockLst_MasterH')
					IF tmpStockLst_MasterH.Cntd < 2
			
				
						********************************
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Master SET "
						CASE ThisForm.cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Master SET "
						CASE ThisForm.cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Master SET "
						ENDCASE
						cSQL = cSQL+ " Alloy='"+m.lcAlloy+"'"   &&NOT NULL
						cSQL = cSQL+ ",Form='"+m.lcForm+"'"   &&NOT NULL
						cSQL = cSQL+ ",CC='"+m.lcCC+"'"   &&NOT NULL
						cSQL = cSQL+ ",CL='"+m.lcCL+"'"   &&NOT NULL
						cSQL = cSQL+ ",Cond='"+m.lcCond+"'"   &&NOT NULL
						cSQL = cSQL+ ",Size="+STR(m.lnSize,9,3)+""   &&NOT NULL
						
					*	cSQL = cSQL+ ",PAID="+STR(m.lnPAID,9,2)+""	&&Do not edit here!
					
					*	cSQL = cSQL+ ",MWeight="+STR(m.lnMWeight,9,2)+""	&&Calculted
					
						cSQL = cSQL+ ",specs='"+m.lcSpecs+"'"
						cSQL = cSQL+ ",Heat='"+m.lcHeat+"'"   &&NOT NULL
						cSQL = cSQL+ ",Lot='"+m.lcLot+"'"
						cSQL = cSQL+ ",PO_Item='"+m.lcPO_Item+"'"
						IF NOT EMPTY(m.ldPODueDate)
							cSQL = cSQL+ ",PODueDate='"+DTOC(m.ldPODueDate)+"'"
						ENDIF
						cSQL = cSQL+ ",History='"+m.lcHistory+"'"
						cSQL = cSQL+ ",Mill='"+m.lcMill+"'"
						cSQL = cSQL+ ",StkDate='"+IIF(EMPTY(m.ldStkDate),'',DTOC(m.ldStkDate))+"'"
						cSQL = cSQL+ ",Num="+STR(m.lnNum)+""
						cSQL = cSQL+ ",POStatus='"+m.lcPOStatus+"'"
						cSQL = cSQL+ ",BrandName='"+m.lcBrandName+"'"
						cSQL = cSQL+ ",From_ID="+STR(IIF(ISNULL(m.lnFrom_ID),0,m.lnFrom_ID))+""	
						cSQL = cSQL+ ",Melt='"+m.lcMelt+"'"
						cSQL = cSQL+ " WHERE ID="+STR(m.lnID)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
							lOK = .F.
							lRollBack = .T.
						ELSE
							TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item))
						ENDIF
					ELSE
						*Found a process in the History!
						MESSAGEBOX(ALLTRIM(ThisForm.txtTableName1.Value)+" will not be changed with this edit."+CHR(13)+"Use StockLst Edit to make changes if needed!"+CHR(13)+"Found a process in the History!"+CHR(13)+"Cannot automatically update when item has a history!",48,"Found History.")
						lDoNotUpdateStockLst = .T.
						TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"Found Process in History!")
					ENDIF
				ELSE
					lDoNotUpdateStockLst = .T.
					TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"Found Process in History!")
				ENDIF
			ENDIF
			*****	
			
			IF nReceivingID > 0 AND m.lnID > 0
				cSQLu = "UPDATE dbo.Receiving SET ID_Master = "+STR(m.lnID)
				IF m.lnID_Detail > 0
					cSQLu = cSQLu + ", ID_Detail = "+STR(m.lnID_Detail)
				ENDIF
				cSQLu = cSQLu + ", StockTable = '"+ThisForm.cTBL+"'"
				cSQLu = cSQLu + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLu )	
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC)
				ENDIF
			ENDIF
		
		ENDIF
		
		***************************
		IF USED("tmpC_Master")
			USE IN tmpC_Master
		ENDIF
		IF USED("tmpC_Master2")
			USE IN tmpC_Master2
		ENDIF
		IF USED("tmpC_Master3")
			USE IN tmpC_Master3
		ENDIF
		******************************
		
		IF m.lnID = 0
			m.lnID = PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		ENDIF
		
		PRIVATE m.ID_Detail_process
		m.ID_Detail_process = 0
		IF m.lnID > 0 AND m.lnID_Detail > 0
			m.ID_Detail_process = ThisForm.GetID_Detail_Process(m.lnID,m.lnID_Detail)
		ENDIF
		
		*IF nRMA_Detail > 0
			*Check for StockLst ID, Master must exist
			*m.lnID
		*ENDIF
		
		***************************************************************
		PRIVATE lFound_ID_RID, lFound_ID_Detail
		lFound_ID_RID = .F.
		lFound_ID_Detail = .F.
		
		IF UPPER(ALLTRIM(THISFORM.txtWhatDo.Value)) = "EDIT" AND m.lnID_Detail > 0
			
			*IF m.lnID_Detail < 1
			IF nReceivingID > 0
				
				*Get the lnID_Detail From ID and ReceivingID
				cSQL = "SELECT [ID_Detail],ReceivingID FROM "
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Detail "
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Detail "
				CASE ThisForm.cTBL = "W"
					cSQL = cSQL + " dbo.WIPLst_Detail "
				ENDCASE
				cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
				cSQL = cSQL + " AND ReceivingID = "+ALLTRIM(STR(nReceivingID))
				
				IF USED("tmpC_Detail")
					SELECT tmpC_Detail
				ELSE
					SELECT 0
				ENDIF
			
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
				ELSE
					IF RECCOUNT('tmpC_Detail')>0
						lFound_ID_RID =.T.
					ENDIF
		*!*				m.lnID_Detail = tmpC_Detail.ID_Detail
		*!*				IF m.lnID_Detail > 0
		*!*					ThisForm.id_Detail1.Value = m.lnID_Detail
		*!*				ELSE
		*!*					ThisForm.id_Detail1.Value = 0
		*!*					RecordError(1, "Trouble!"+CHR(13)+cSQL, 'frmShop_stockLst_Edit:PORecvStockSaveAdd 455', 455, "ID_Detail was set to 0")
		*!*				ENDIF
				ENDIF
			ENDIF
			
			********************************
			IF NOT lDoNotUpdateStockLst 
				*Check History for Receives
			ENDIF
			********************************
			IF lDoNotUpdateStockLst 
				*Do not Update StockLst
			ELSE
				*Update StockLst		
				IF NOT lFound_ID_RID
					
					IF ThisForm.cTBL = "S"
						*stockLst many have many Detail, Auto select if only one!
						cSQL = "SELECT [ID_Detail],ReceivingID FROM "
						cSQL = cSQL + " dbo.StockLst_Detail "
						cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
						ELSE
							IF RECCOUNT('tmpC_Detail')>0
								lFound_ID_Detail = .T.
							ENDIF
							IF RECCOUNT('tmpC_Detail')=1
								lFound_ID_RID =.T.
							ENDIF
						ENDIF
					ENDIF
					IF ThisForm.cTBL = "B"
						*Broker only has only one ID_Detail
						cSQL = "SELECT [ID_Detail],ReceivingID FROM "
						cSQL = cSQL + " dbo.BrokerLst_Detail "
						cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
						ELSE
							IF RECCOUNT('tmpC_Detail')>0
								lFound_ID_Detail = .T.
							ENDIF
							IF RECCOUNT('tmpC_Detail')=1
								lFound_ID_RID =.T.
							ENDIF
						ENDIF
					ENDIF
					IF ThisForm.cTBL = "W"
						*Broker only has only one ID_Detail
						cSQL = "SELECT [ID_Detail],ReceivingID FROM "
						cSQL = cSQL + " dbo.WIPLst_Detail "
						cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
						ELSE
							IF RECCOUNT('tmpC_Detail')>0
								lFound_ID_Detail = .T.
							ENDIF
							IF RECCOUNT('tmpC_Detail')=1
								lFound_ID_RID =.T.
							ENDIF
						ENDIF
					ENDIF					
				ENDIF
				
				IF lFound_ID_Detail
					*Got Multiple Details.
					SELECT tmpC_Detail
					SCAN
						IF PrepareSQLnum(tmpC_Detail.ReceivingID,'ReceivingID',-3) = nReceivingID 
							lFound_ID_RID = .T.
							EXIT
						ENDIF
					ENDSCAN
				ENDIF
				
				IF lFound_ID_RID 	
					m.lnID_Detail = PrepareSQLnum(tmpC_Detail.ID_Detail,'ID_Detail',-3)
					
					IF m.lnID_Detail > 0
						ThisForm.ID_Detail1.Value = m.lnID_Detail
					ELSE
						ThisForm.ID_Detail1.Value = 0
						TrackError("No ID_Detail."+CHR(13)+cSQL+CHR(13)+": THISFORM.txtWhatDo.Value = 'EDIT'"+CHR(13)+"ID:"+STR(m.lnID)+",  nNewID_Master:"+STR(nNewID_Master)+",  nReceivingID:"+STR(nReceivingID),"ID_Detail was set to 0",PROGRAM(),LINENO(1))
						IF MESSAGEBOX("Cannot Save as an Edit!"+CHR(13)+"Did not find Detail ID to Edit/Update"+CHR(13)+CHR(13)+"Do you want to Add as 'NEW'?",4+32,"Add to "+ALLTRIM(ThisForm.txtTableName1.Value)) = 6 
							THISFORM.txtWhatDo.Value = "ADD" 
							TrackError("No ID_Detail for Edit."+CHR(13)+"User changed THISFORM.txtWhatDo.Value = 'ADD'"+CHR(13)+"ID:"+STR(m.lnID)+",  nNewID_Master:"+STR(nNewID_Master),"WhatDo was changed to 'ADD'",PROGRAM(),LINENO(1))
						ENDIF
					ENDIF
				ELSE
					ThisForm.ID_Detail1.Value = 0
					TrackError("No ID_Detail."+CHR(13)+cSQL+CHR(13)+": THISFORM.txtWhatDo.Value = 'EDIT'"+CHR(13)+"ID:"+STR(m.lnID)+",  nNewID_Master:"+STR(nNewID_Master)+",  nReceivingID:"+STR(nReceivingID),"ID_Detail was set to 0",PROGRAM(),LINENO(1))
					IF MESSAGEBOX("Cannot Save as an Edit!"+CHR(13)+"Did not find Detail ID to Edit/Update"+CHR(13)+CHR(13)+"Do you want to Add as 'NEW'?",4+32,"Add to "+ALLTRIM(ThisForm.txtTableName1.Value)) = 6 
						THISFORM.txtWhatDo.Value = "ADD" 
						TrackError("No ID_Detail for Edit."+CHR(13)+"User changed THISFORM.txtWhatDo.Value = 'ADD'"+CHR(13)+"ID:"+STR(m.lnID)+",  nNewID_Master:"+STR(nNewID_Master),"WhatDo was changed to 'ADD'",PROGRAM(),LINENO(1))
					ENDIF
				ENDIF
			ENDIF	
			
			********************************
			IF lDoNotUpdateStockLst 
				*Do not Update StockLst
			ELSE
				*Update StockLst
				IF m.lnID_Detail > 0
		
					DO CASE
					CASE ThisForm.cTBL = "S"
						cSQL = "UPDATE dbo.StockLst_Detail SET "
					CASE ThisForm.cTBL = "B"
						cSQL = "UPDATE dbo.BrokerLst_Detail SET "
					CASE ThisForm.cTBL = "W"
						cSQL = "UPDATE dbo.WIPLst_Detail SET "
					ENDCASE
					cSQL = cSQL+ "ID="+STR(lnID)+","
					cSQL = cSQL+ "PC="+STR(m.lnPC)+","
					cSQL = cSQL+ "Size_H="+STR(m.lnSize_H,9,4)+","
					cSQL = cSQL+ "Dim1="+STR(m.lnDim1,18,4)+","
					cSQL = cSQL+ "Size_L="+STR(m.lnSize_L,9,4)+","
					cSQL = cSQL+ "Dim2="+STR(m.lnDim2,18,4)+","
					cSQL = cSQL+ "Dim3="+STR(m.lnDim3,18,4)+","
					cSQL = cSQL+ "Weight="+STR(m.lnWeight,9,2)+","
					cSQL = cSQL+ "Descript='"+ALLTRIM(m.lcDescript)+"',"
					cSQL = cSQL+ "Length='"+ALLTRIM(m.lcLength)+"',"
		
					cSQL = cSQL+ "Unit='"+ALLTRIM(cUnitByForm)+"',"
					cSQL = cSQL+ "FloorStatus='"+ALLTRIM(m.lcFloorStatus)+"',"
					cSQL = cSQL+ "class='"+ALLTRIM(m.lcClass)+"',"
					cSQL = cSQL+ "[Location]='"+ALLTRIM(m.lcLocation)+"',"
					cSQL = cSQL+ "RandLen="+IIF(llRandLen,'1','0')+","
					cSQL = cSQL+ "Prime="+IIF(llPrime,'1','0')+","
					IF nReceivingID > 0
						cSQL = cSQL+ "ReceivingID="+STR(nReceivingID)
					ENDIF
					IF llMarkInvDate
						cSQL = cSQL+ ","+"InvCheck=GetDate()"
					ENDIF
					cSQL = cSQL+",S_QTY = " + STR(m.lnS_QTY,18,4) + ""
					cSQL = cSQL+",S_P 	= " + STR(m.lnS_P,18,4) + ""
					cSQL = cSQL+",S_Total = " + STR(m.lnS_Total,18,4) + ""
					cSQL = cSQL+",S_PU = " + STR(m.lnS_PU) + ""
					cSQL = cSQL+ " WHERE ID_Detail="+STR(m.lnID_Detail)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
						
						lOK = .F.
						lRollBack = .T.
					ELSE
				*		=SQLCOMMIT(ThisForm.nConnHandle)
						TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Update Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+" Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
					ENDIF
				ELSE
					TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+", ID_Detail=0")
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		IF THISFORM.txtWhatDo.Value = "ADD" AND m.lnID > 0 AND nRMA_Detail = 0
			*now get Detail
		
			*Check for a PO that has Added to StockLst
			*Change lnID_Detail if found !
			
			cSQL = "SELECT [ID_Detail] FROM "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail "
			ENDCASE
		
			cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
			IF lOverRideAdd 
				cSQL = cSQL + " AND ISNULL(ReceivingID,0) = 0"
				*Do not use the Length
			ELSE
				cSQL = cSQL + " AND ISNULL(ReceivingID,0) = 0"
				cSQL = cSQL + " AND Length = 'Listing created from new PO'"
			ENDIF	
			
			IF USED("tmpC_Detail")
				SELECT tmpC_Detail
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
			ELSE
				m.lnID_Detail = PrepareSQLnum(tmpC_Detail.ID_Detail,'ID_Detail',-3)
				IF m.lnID_Detail > 0
					ThisForm.Id_Detail1.Value = m.lnID_Detail
				ENDIF
			ENDIF
		ENDIF
		
		IF THISFORM.txtWhatDo.Value = "ADD" 
			*** OR THISFORM.txtWhatDo.Value = "RETURN"
			
			IF m.lnID_Detail > 0
				*dbo.StockLst_Detail dbo.BrokerLst_Detail
			*	IF ThisForm.txtTableName1.Value = "StockLst"
			*		cSQL = "UPDATE dbo.StockLst_Detail SET "
			*	ELSE
			*		cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			*	ENDIF
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = "UPDATE dbo.StockLst_Detail SET "
				CASE ThisForm.cTBL = "B"
					cSQL = "UPDATE dbo.BrokerLst_Detail SET "
				CASE ThisForm.cTBL = "W"
					cSQL = "UPDATE dbo.WIPLst_Detail SET "
				ENDCASE
				
				cSQL = cSQL+ "ID="+STR(lnID)+","
				cSQL = cSQL+ "PC="+STR(m.lnPC)+","
				cSQL = cSQL+ "Size_H="+STR(m.lnSize_H,9,4)+","
				cSQL = cSQL+ "Dim1="+STR(m.lnDim1,18,4)+","
				cSQL = cSQL+ "Size_L="+STR(m.lnSize_L,9,4)+","
				cSQL = cSQL+ "Dim2="+STR(m.lnDim2,18,4)+","
				cSQL = cSQL+ "Dim3="+STR(m.lnDim3,18,4)+","
				cSQL = cSQL+ "Weight="+STR(m.lnWeight,9,2)+","
				cSQL = cSQL+ "Descript='"+ALLTRIM(m.lcDescript)+"',"
				cSQL = cSQL+ "Length='"+ALLTRIM(m.lcLength)+"',"
		
				cSQL = cSQL+ "Unit='"+ALLTRIM(cUnitByForm)+"',"
				cSQL = cSQL+ "FloorStatus='"+ALLTRIM(m.lcFloorStatus)+"',"
				cSQL = cSQL+ "class='"+ALLTRIM(m.lcClass)+"',"
				cSQL = cSQL+ "[Location]='"+ALLTRIM(m.lcLocation)+"',"
				cSQL = cSQL+ "RandLen="+IIF(llRandLen,'1','0')+","
				cSQL = cSQL+ "Prime="+IIF(llPrime,'1','0')+","
				IF nReceivingID > 0
					cSQL = cSQL+ "ReceivingID="+STR(nReceivingID)+","
				ENDIF
				IF llMarkInvDate
					cSQL = cSQL+ "InvCheck=GetDate() ,"
				ENDIF
				cSQL = cSQL+" S_QTY = " + STR(m.lnS_QTY,18,4) + ","
				cSQL = cSQL+" S_P 	= " + STR(m.lnS_P,18,4) + ","
				cSQL = cSQL+" S_Total = " + STR(m.lnS_Total,18,4) + ","
				cSQL = cSQL+" S_PU = " + STR(m.lnS_PU) + ""
				cSQL = cSQL+ " WHERE ID_Detail="+STR(m.lnID_Detail)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					
					lOK = .F.
					lRollBack = .T.
				ELSE
			*		=SQLCOMMIT(ThisForm.nConnHandle)
		
					IF nRMA_Detail > 0
						TrackMess("PO Receive, Update Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+"_Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for RMA_Detail:"+ALLTRIM(STR(nRMA_Detail)))
					ELSE
						TrackMess("PO Receive, Update Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+"_Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
					ENDIF
				ENDIF
			ELSE
				*Must Insert ID_Detail - see next code
			ENDIF
		ENDIF
		
		***************************************************************
		*!*	IF ( THISFORM.txtWhatDo.Value = "ADD" OR THISFORM.txtWhatDo.Value = "ReADD" ) AND m.lnID_Detail = 0
		*!*		
		*!*		IF THISFORM.txtWhatDo.Value = "ReADD" 
		*!*		ENDIF
		*!*	ENDIF
		
		***************************************************************
		IF ThisForm.txtWhatDo.Value = "ADD" OR m.lnID_Detail = 0
			*Add Detail
			
			cTBL = TBL_TableName(ALLTRIM(ThisForm.txtTableName1.Value))
			
			cSQLi = "EXEC dbo.p_Lst_Detail_ins "
			cSQLi = cSQLi+ " @TBL = "+cTBL
			cSQLi = cSQLi+ ",@size_h	= "+STR(m.lnSize_H,9,4)	&&decimal(9, 4),
			cSQLi = cSQLi+ ",@size_l = "+STR(m.lnSize_L,9,4)	&&decimal(9, 4),
			cSQLi = cSQLi+ ",@pc = "+STR(m.lnPC)				&&INT,
			cSQLi = cSQLi+ ",@dim1 = "+STR(m.lnDim1,18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@dim2 = "+STR(m.lnDim2,18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@dim3 = "+STR(m.lnDim3,18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@length ='"+m.lcLength+"'"		&&varchar(160),
			cSQLi = cSQLi+ ",@weight = "+STR(m.lnWeight,9,2)		&&decimal(9, 2),
		
			cSQLi = cSQLi+ ",@descript ='"+m.lcDescript+"'"	&&varchar(20),
			cSQLi = cSQLi+ ",@location ='"+m.lcLocation+"'"	&&varchar(10),
			cSQLi = cSQLi+ ",@floorstatus ='"+m.lcFloorStatus+"'"	&&char(1),
			cSQLi = cSQLi+ ",@class	 ='"+m.lcClass+"'"		&&char(1),
			cSQLi = cSQLi+ ",@RandLen = "+IIF(m.llRandLen,'1','0')+""	&&BIT
			cSQLi = cSQLi+ ",@ID ="+STR(m.lnID)		&&int
			cSQLi = cSQLi+ ",@ID_Detail_Process ="+STR(m.ID_Detail_Process)		&&int
			cSQLi = cSQLi+ ",@ReceivingID ="+STR(m.nReceivingID)		&&int
			cSQLi = cSQLi+ ",@S_QTY="+STR(m.lnS_QTY,18,4)
			cSQLi = cSQLi+ ",@S_P="+STR(m.lnS_P,18,4)
			cSQLi = cSQLi+ ",@S_TOTAL="+STR(m.lnS_Total,18,4)
			cSQLi = cSQLi+ ",@S_PU="+STR(m.lnS_PU)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_ins')
				lOK = .F.
				lRollBack = .T.
			ELSE
				m.lnID_Detail = 0
		
				IF USED("StockLst_Detail_ins")
					IF RECCOUNT("StockLst_Detail_ins") > 0
						m.lnID_Detail = PrepareSQLnum(StockLst_Detail_ins.EXP,'ID_Detail',-3)
					ENDIF
					USE IN StockLst_Detail_ins
				ENDIF
				
				IF m.lnID_Detail > 0
					ThisForm.ID_Detail = m.lnID_Detail
					ThisForm.ID_Detail1.Value =  m.lnID_Detail
				ELSE
					ThisForm.ID_Detail = 0
					ThisForm.ID_Detail1.Value =  0
					TrackError("Trouble"+CHR(13)+cSQLi,"ID_Detail was set to 0",PROGRAM(),LINENO(1))
				ENDIF
				
				TrackMess("PO Receive, Add Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+" Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
			ENDIF
		ENDIF
		
		***************************************************************
		*Check for Incoming Process
		PRIVATE cSQLn, cSQLd, nID_Detail,lFoundInProc
		nID_Detail = m.lnID_Detail
		lFoundInProc = .F.
		
		IF nRMA_Detail = 0
			cSQLn = "SELECT COUNT(*) AS counted FROM "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQLn = cSQLn + " dbo.StockLst_Process "
			CASE ThisForm.cTBL = "B"
				cSQLn = cSQLn + " dbo.BrokerLst_Process "
			CASE ThisForm.cTBL = "W"
				cSQLn = cSQLn + " dbo.WIPLst_Process "
			ENDCASE
		
			cSQLn = cSQLn + " WHERE ID_Detail = "+ ALLTRIM(STR(nID_Detail))
			*+" AND Process_ID = 'INCOMING'"
			cSQLn = cSQLn + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
		
			IF USED("StockLst_Detail_Count")
				SELECT StockLst_Detail_Count
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Detail_Count")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Detail_Count")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLn,ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
			ELSE
				IF USED('StockLst_Detail_Count')
					IF StockLst_Detail_Count.Counted = 0
						*No Incoming Process
					ELSE
						lFoundInProc = .T.
					ENDIF
					USE IN StockLst_Detail_Count
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		IF m.lnID_Detail > 0 AND nRMA_Detail = 0
			*Update the INCOMING Process
			IF lFoundInProc
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = "UPDATE dbo.StockLst_Process "
				CASE ThisForm.cTBL = "B"
					cSQL = "UPDATE dbo.BrokerLst_Process "
				CASE ThisForm.cTBL = "W"
					cSQL = "UPDATE dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL+ " SET "	
				cSQL = cSQL+ " QTY="+STR(m.lnS_QTY,18,4)
		
				cSQL = cSQL+ ",PU="+STR(m.lnS_PU,3,0)
				cSQL = cSQL+ " WHERE ID_Detail="+STR(m.lnID_Detail)
				*cSQL = cSQL+ " AND Process_ID = 'INCOMING'"
				cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' OR Process_ID = 'NOT2HPA' )"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					
					lOK = .F.
					lRollBack = .T.
				ELSE
			*		TrackMess("PO Receive, Update Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+" Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
				ENDIF
			ELSE
				*This Receive Stock screen does not need an 'INCOMING' Process!!
				*
					
		
			ENDIF
		ENDIF
		
		***************************************************************
		nID_Detail = m.lnID_Detail
		
		***************************************************************
		*Get data before Deleting INCOMING Process
		PRIVATE m.cSalesPerson,  m.dDueDate
		PRIVATE m.cAllowSub, m.nWeight, m.nQTY, m.cSOitem, m.nPU
		PRIVATE m.cProcess_ID, m.cProcessor, m.cComment
		
		m.cSalesPerson	= ''
		
		m.dDueDate		= DATE()
		m.cAllowSub		= ' '
		m.nWeight		= 0
		m.nQTY			= 0
		m.cSOitem		= ''
		m.nPU			= 0
		m.cProcess_ID	= "RECEIVED"
		m.cProcessor 	= PrepareSQLtxt(RIGHT( SYS(0), LEN(SYS(0)) - AT('#',SYS(0)) - 1 ),'Processor',20)
		
		IF ThisForm.txtWhatDo.Value = "RETURN"
			m.cComment = "RMA Detail "+ALLTRIM(STR(nRMA_Detail))
		ELSE
			m.cComment = "Received new Heat"
		ENDIF
		
		IF nRMA_Detail = 0
			cSQLn = "SELECT * FROM "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQLn = cSQLn + " dbo.StockLst_Process "
			CASE ThisForm.cTBL = "B"
				cSQLn = cSQLn + " dbo.BrokerLst_Process "
			CASE ThisForm.cTBL = "W"
				cSQLn = cSQLn + " dbo.WIPLst_Process "
			ENDCASE
			cSQLn = cSQLn + " WHERE ID_Detail = "+ ALLTRIM(STR(nID_Detail))
			*ignore AND Process_ID = 'SELECTED'"
			cSQLn = cSQLn + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
		
			IF USED("StockLst_Proc_Data")
				SELECT StockLst_Proc_Data
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Proc_Data')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Proc_Data')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Proc_Data")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Proc_Data")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLn,ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
			ELSE
				IF USED('StockLst_Proc_Data')
					IF RECCOUNT("StockLst_Proc_Data") > 0
						m.cSalesPerson	= PrepareSQLtxt(StockLst_Proc_Data.SalesPerson,'SalesPerson',20)
						m.dDueDate		= PrepareSQLdate(StockLst_Proc_Data.DueDate,'DueDate')
						m.cAllowSub		= PrepareSQLtxt(StockLst_Proc_Data.AllowSub,'AllowSub',1)
						m.nWeight		= PrepareSQLnum(StockLst_Proc_Data.Pounds,'Pounds',9,1)
						m.nQTY			= PrepareSQLnum(StockLst_Proc_Data.QTY,'QTY',-5)			
						m.cSOitem		= PrepareSQLtxt(StockLst_Proc_Data.SOitem,'SOitem',10)
						m.nPU			= PrepareSQLnum(StockLst_Proc_Data.PU,'PU',1)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		*Check for SELECTED Process
		PRIVATE cSQLn, cSQLd, nID_Detail, lFoundSelProc 
		nID_Detail = m.lnID_Detail
		lFoundSelProc = .F.
		
		IF nRMA_Detail = 0
			cSQLn = "SELECT COUNT(*) AS counted FROM "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQLn = cSQLn + " dbo.StockLst_Process "
			CASE ThisForm.cTBL = "B"
				cSQLn = cSQLn + " dbo.BrokerLst_Process "
			CASE ThisForm.cTBL = "W"
				cSQLn = cSQLn + " dbo.WIPLst_Process "
			ENDCASE
		
			cSQLn = cSQLn + " WHERE ID_Detail = "+ ALLTRIM(STR(nID_Detail))
			*+" AND Process_ID = 'SELECTED'"
			cSQLn = cSQLn + " AND ( Process_ID = 'SELECTED' OR Process_ID = 'PARTSELECT' OR Process_ID = 'NOT2HPA' )"
		
			IF USED("StockLst_Detail_Count")
				SELECT StockLst_Detail_Count
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Proc_Data")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Proc_Data")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLn,ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
			ELSE
				IF USED('StockLst_Detail_Count')
					IF StockLst_Detail_Count.Counted = 0
						*No SELECT Process
					ELSE
						lFoundSelProc = .T.
					ENDIF
					USE IN StockLst_Detail_Count
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		IF lFoundInProc AND NOT lFoundSelProc 
			*No SELECT was found.
			*create a SELECT before deleting the INCOMING.
			
			cSQL = "INSERT INTO "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL = cSQL + "([SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment]"
			cSQL = cSQL + ",[Process_ID],[Processor],[AllowSub]"
			*cSQL = cSQL + ",[PWeight],[PPc]"
			cSQL = cSQL + ",[PU],[QTY],Ordered_QTY,[Pounds]"
			cSQL = cSQL + ",[ID_Detail],[ReceivingID],[WO],[WO_Detail]"
			cSQL = cSQL + ",[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3] "
		*	cSQL = cSQL + ",Prc_Q_QTY, Prc_Q_PU 
			cSQL = cSQL + ")"
			cSQL = cSQL + " SELECT TOP 1 "
			cSQL = cSQL + " [SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment]"
			cSQL = cSQL + ",'SELECTED',[Processor],[AllowSub]"
		*	cSQL = cSQL + ",[PWeight],[PPc]"
			cSQL = cSQL + ",[PU],[QTY],Ordered_QTY,[Pounds]"
			cSQL = cSQL + ",[ID_Detail],[ReceivingID],[WO],[WO_Detail]"
			cSQL = cSQL + ",[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3] "
		*	cSQL = cSQL + ",Prc_Q_QTY, Prc_Q_PU "
			cSQL = cSQL + " FROM "
			
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
			cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Detail_Count")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Detail_Count")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLn,ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
			ENDIF
		ENDIF
		
		***************************************************************
		*Remove Incoming Process from StockLst
		
		IF lFoundInProc 
			
			*Remove INCOMING Process
			*dbo.StockLst_Process dbo.BrokerLst_Process
			cSQLd = "DELETE FROM "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQLd = cSQLd + " dbo.StockLst_Process "
			CASE ThisForm.cTBL = "B"
				cSQLd = cSQLd + " dbo.BrokerLst_Process "
			CASE ThisForm.cTBL = "W"
				cSQLd = cSQLd + " dbo.WIPLst_Process "
			ENDCASE
			cSQLd = cSQLd + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
			cSQLd = cSQLd + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
			*cSQLd = cSQLd + " AND SOitem = 'STOCK' "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				*Could not Delete Process
				SQLEXECError(cSQLd,ThisForm.nConnHandle,nSQLEXEC,'')
			ENDIF
		ENDIF
		
		
		***************************************************************
		*Add nReceivingID to History	
				
		IF nRMA_Detail = 0 AND nReceivingID > 0
			*Why UPDATE nReceivingID?
			cSQLd = "UPDATE "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQLd = cSQLd + " dbo.Ar_StockLst_Process_History "
			CASE ThisForm.cTBL = "B"
				cSQLd = cSQLd + " dbo.Ar_BrokerLst_Process_History "
			CASE ThisForm.cTBL = "W"
				cSQLd = cSQLd + " dbo.Ar_WIPLst_Process_History "
			ENDCASE
			
			cSQLd = cSQLd+" SET [ReceivingID]="+STR(nReceivingID)
			cSQLd = cSQLd+" WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
			IF ThisForm.cTBL = "S"
				cSQLd = cSQLd+" AND [What] = 'DELETE' "
			ENDIF
			cSQLd = cSQLd + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLd,ThisForm.nConnHandle,nSQLEXEC,'')
			ENDIF
		
		ENDIF
		
		IF NOT lFoundInProc 
			*No 'INCOMING' Process counted.
				
			*ADD Receive data to Process in History
			IF USED('tmpID_Detail_Process')
				USE IN tmpID_Detail_Process
			ENDIF
		
			IF nReceivingID > 0
				*With Receiving - ActualW and Pieces
				IF USED('tmpWeightPC')
					USE IN tmpWeightPC
				ENDIF
				SELECT 0
				*dbo.StockLst_Detail dbo.BrokerLst_Detail
				cSQL = "SELECT ActualW, Pieces FROM dbo.Receiving "
				cSQL = cSQL + " WHERE ID = "+ALLTRIM(STR(nReceivingID))
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWeightPC')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWeightPC')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWeightPC")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWeightPC")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWeightPC')
				ENDIF
				
				IF USED('tmpWeightPC')
					IF RECCOUNT('tmpWeightPC')>0
						m.nWeight = PrepareSQLnum(tmpWeightPC.ActualW,'ActualW',9,1)
						m.nPc 	= PrepareSQLnum(tmpWeightPC.Pieces,'Pieces',-3)
					ENDIF
					USE IN tmpWeightPC
				ENDIF	
				
			ELSE
				*With Lst_Detail Weight, PC
				IF USED('tmpWeightPC')
					USE IN tmpWeightPC
				ENDIF
				SELECT 0
				*dbo.StockLst_Detail dbo.BrokerLst_Detail
				cSQL = "SELECT Weight, PC FROM "
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Detail "
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Detail "
				CASE ThisForm.cTBL = "W"
					cSQL = cSQL + " dbo.WIPLst_Detail "
				ENDCASE
				
				cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWeightPC')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWeightPC')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWeightPC")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWeightPC")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWeightPC')
				ENDIF
				
				IF USED('tmpWeightPC')
					IF RECCOUNT('tmpWeightPC')>0
						m.nWeight = PrepareSQLnum(tmpWeightPC.Weight,'Weight',9,1)
						m.nPc 	= PrepareSQLnum(tmpWeightPC.PC,'PC',-3)
					ENDIF
					USE IN tmpWeightPC
				ENDIF	
			ENDIF		
			*******************
			
			*dbo.Ar_StockLst_Process_History dbo.Ar_BrokerLst_Process_History		
			cSQLi = "INSERT INTO "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQLi = cSQLi + " dbo.Ar_StockLst_Process_History "
			CASE ThisForm.cTBL = "B"
				cSQLi = cSQLi + " dbo.Ar_BrokerLst_Process_History "
			CASE ThisForm.cTBL = "W"
				cSQLi = cSQLi + " dbo.Ar_WIPLst_Process_History "
			ENDCASE
			cSQLi = cSQLi + "(What,SOitem,PO_Item,salesperson,startdate"
			cSQLi = cSQLi + ",duedate,comment,process_id,processor,AllowSub"
			* ",pWeight,pPc    -NO
			*WO,
			cSQLi = cSQLi + ",WO_detail"
			cSQLi = cSQLi + ",PU,QTY,Pounds"	&&,Ordered_QTY
			cSQLi = cSQLi + ",ID_Detail"
			*cSQLi = cSQLi + ",Validated"
			cSQLi = cSQLi + ",ReceivingID"
			cSQLi = cSQLi + ") VALUES ("
			cSQLi = cSQLi + "'RECEIVED'"
			cSQLi = cSQLi + ",'"+m.cSOitem+"'"
			cSQLi = cSQLi + ",'"+m.lcPO_Item+"'"
			cSQLi = cSQLi + ",'"+m.cSalesPerson+"'"
			cSQLi = cSQLi + ",'"+TTOC(DATETIME())+"'"
			cSQLi = cSQLi + ",'"+IIF(EMPTY(m.dDueDate),'',DTOC(m.dDueDate))+"'"
			cSQLi = cSQLi + ",'"+m.cComment+"'"
			cSQLi = cSQLi + ",'"+m.cProcess_ID+"'"
			cSQLi = cSQLi + ",'"+m.cProcessor+"'"
			cSQLi = cSQLi + ",'N'"
			
			*cSQLi = cSQLi + ","+STR(m.nWeight,9,1)+","+STR(m.nPc)
			cSQLi = cSQLi + ","+STR(m.lnWO_Detail)
			cSQLi = cSQLi + ","+STR(m.lnS_PU)
			cSQLi = cSQLi + ","+STR(m.lnS_QTY,18,4)
			*,Ordered_QTY
			cSQLi = cSQLi + ","+STR(nWeight,9,1)
			cSQLi = cSQLi + ","+STR(nID_Detail)+""
			*cSQLi = cSQLi + ",'F' "
			cSQLi = cSQLi + ","+STR(nReceivingID)+""
			cSQLi = cSQLi + ")"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC,'')
				lRollBack = .T.
			ELSE
				*
			ENDIF
		ENDIF
		
		
		**********************************
		*  Redundant
		*!*	IF lOK 
		*!*		IF Proper_PO_item(lcPO_Item) <> Proper_PO_item('')
		*!*		  	PRIVATE cSQLu
		*!*			cSQLu = "UPDATE dbo.PurchaseOrder SET "
		*!*			cSQLu = cSQLu + " Receipt = '"+m.lcReceipt+"'"
		*!*			cSQLu = cSQLu + ",Received = '"+IIF(EMPTY(m.ldStkDate),'',DTOC(m.ldStkDate))+"'"
		*!*			cSQLu = cSQLu + ",ReceivedBy = '"+m.lcReceivedBy+"'"
		*!*			cSQLu = cSQLu + ",Heat = '"+m.lcHeat+"'"
		*!*			cSQLu = cSQLu + ",Delivered="+IIF(m.llDelivered,'1','0')
		*!*			cSQLu = cSQLu + ",Cert = "+IIF(m.llCert,'1','0')
		*!*			cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+m.lcPO_Item+"')"
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		*!*			
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWeightPC")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWeightPC")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO 
		*!*		ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
		*!*				lRollBack = .T.
		*!*			ELSE
		*!*				TrackMess( "Updateded POitem:"+ALLTRIM(m.lcPO_Item)+" ReceivedBy = '"+m.lcReceivedBy+"' from Shop_StockLst_Edit screen.")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		***************************************************************
		IF ThisForm.txtWhatDo.Value = "ADD" AND m.lnID_Detail > 0 AND m.lnID > 0 AND m.nReceivingID > 0
			*Write ID to the dbo.Receiving TABLE
			cSQLu = "UPDATE dbo.Receiving SET "
			cSQLu = cSQLu + " ID_Master = "+STR(m.lnID)
			cSQLu = cSQLu + ",ID_Detail = "+STR(m.lnID_Detail)
			cSQLu = cSQLu + ",StockTable = '"+ThisForm.cTBL+"'"
			cSQLu = cSQLu + " WHERE ID = "+STR(m.nReceivingID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
				lRollBack = .T.
			ELSE
				TrackMess( "Updateded POitem:"+ALLTRIM(m.lcPO_Item)+" ReceivedBy = '"+m.lcReceivedBy+"' from Shop_StockLst_Edit screen.")
			ENDIF
		ENDIF
		
		**********************************
		*Partial Receive 'PARTRECV'
		
		
		**********************************
		IF lRollBack 
			=SQLROLLBACK(ThisForm.nConnHandle)
			lOK  = .F.
			MESSAGEBOX('Nothing has been saved!',0+16,"Rollback")
		ELSE
			=SQLCOMMIT(ThisForm.nConnHandle)
		ENDIF
		
		= SQLSETPROP(THISFORM.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
		**********************************
		RETURN lOK
	ENDPROC

	PROCEDURE showpobypoitem
		*ThisForm.ShowPObyPOitem()
		*was ThisForm.GetPurchaseOrderbyPOitem()
		
		IF Proper_PO_Item(ThisForm.POitem) = Proper_PO_Item('')
			RETURN
		ENDIF
		
		*********** Get from PurchaseOrder
		*ThisForm.ReceivingID
		PRIVATE lCheckPO
		lCheckPO = .T.
		
		
		PRIVATE np_LB, nP_PC, nP_Ft, nLotP, nOtherP, nPieces
		np_LB = 0
		nP_PC = 0
		nP_Ft = 0
		nLotP = 0
		nOtherP= 0
		nPieces = 0
		
		IF USED('tmpPO1')
			USE IN tmpPO1
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3,OrderDate,Cond_Spec,StandSize "
		cSQL = cSQL + ",StockLst_QTY, StockLst_P, StockLst_PU, Pounds "
		cSQL = cSQL + ",Order_Qty, Order_P, Order_PU "
		*cSQL = cSQL + ",p_LB, P_PC, P_Ft, LotP, OtherP"
		cSQL = cSQL + ",Receipt,Received,ReceivedBy,Heat,Delivered,Cert,RandLen"
		cSQL = cSQL + ",Due_Min, Due_Max "
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisForm.POitem+"')"
		*cSQL = cSQL + " AND ReceivingID = "+STR(ThisForm.ReceivingID)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO1')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO1' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO1")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO1")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO1' )
		ENDIF
		
		IF USED('tmpPO1')
			ThisForm.edtReceipt.Value = PrepareSQLtxt(tmpPO1.Receipt,'Receipt',-1)
			ThisForm.STKDATE1.Value = PrepareSQLdate(tmpPO1.Received,'Received')
			ThisForm.ReceivedBy1.Value = PrepareSQLtxt(tmpPO1.ReceivedBy,'ReceivedBy',10)
			IF EMPTY(ThisForm.Heat1.Value)
				ThisForm.Heat1.Value = PrepareSQLtxt(tmpPO1.Heat,'Heat',50)
			ENDIF
		
			ThisForm.chkComplete.Value = PrepareSQLchk(tmpPO1.Delivered,'Delivered')
			ThisForm.chkCert.Value = PrepareSQLchk(tmpPO1.Cert,'Cert')
		
			IF lCheckPO
				ThisForm.chkRandLen.Value = PrepareSQLchk(tmpPO1.RandLen,'RandLen')
			ENDIF
			IF lCheckPO
				ThisForm.Cond1.Value = RIGHT( PrepareSQLtxt(tmpPO1.Cond_Spec,'Cond_Spec',-1) ,20)
			ENDIF
			***
			ThisForm.PODueDate1.Value = PrepareSQLdate(tmpPO1.Due_Min,'Due_Min')
			IF EMPTY(ThisForm.PODueDate1.Value)
				ThisForm.PODueDate1.Value = PrepareSQLdate(tmpPO1.Due_Max,'Due_Max')
			ENDIF
			IF EMPTY(ThisForm.PODueDate1.Value)
				ThisForm.PODueDate1.Value = DATE()
			ENDIF
			***
		
		*	*Get Extras from PO
			PRIVATE nStockLst_QTY, nStockLst_P, nStockLst_PU, cForm, nPU &&StockLst_PU from Form!
			PRIVATE nOrder_Qty, nOrder_P, nOrder_PU, nPounds 
			nStockLst_QTY = PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
			nStockLst_P	= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
			nStockLst_PU = PrepareSQLnum(tmpPO1.StockLst_PU,'PU',-1)
			
			cForm		= PrepareSQLtxt(tmpPO1.Form,'Form',2)
			nPU			= GetPUfromForm( cForm, ThisForm.nConnHandle)
			nOrder_Qty	= PrepareSQLnum(tmpPO1.Order_QTY,'Order_QTY',-5)
			nOrder_P	= PrepareSQLnum(tmpPO1.Order_P,'Order_P',-5)
			nOrder_PU	= PrepareSQLnum(tmpPO1.Order_PU,'PU',-1)
			nPounds 	= PrepareSQLnum(tmpPO1.Pounds,'Pounds',9,1)
		
			IF NOT lCheckPO
				*IF TYPE("tmpPO1.Order_Qty")="N" OR VARTYPE(tmpPO1.Order_Qty)="Y"  &&Order_Qty
					IF nOrder_Qty > 0 AND nPU = 1
						ThisForm.txtLBS.Value = PrepareSQLnum(tmpPO1.Order_Qty,'Order_Qty',-5)
					ENDIF
				*ENDIF
			ENDIF
			
			IF NOT lCheckPO
				*IF TYPE("tmpPO1.StockLst_P")="N" OR VARTYPE(tmpPO1.StockLst_P)="Y" &&StockLst_P
					IF nStockLst_P > 0
						ThisForm.txtR_P.Value = nStockLst_P
					ENDIF
				*ENDIF
			ENDIF
			IF NOT lCheckPO
				*IF TYPE("tmpPO1.StockLst_Qty")="N" OR VARTYPE(tmpPO1.StockLst_Qty)="Y" &&StockLst_QTY
					IF nStockLst_QTY > 0
						ThisForm.txtS_QTY.Value = nStockLst_QTY
					ENDIF
				*ENDIF
			ENDIF
				
			IF lCheckPO
				IF TYPE("tmpPO1.thck")="N" OR VARTYPE(tmpPO1.Thck)="Y"  &&thck
					IF tmpPO1.thck > 0
						ThisForm.DIM11.Value = PrepareSQLnum(tmpPO1.thck,'Thck',10,4)
					ENDIF
				ENDIF
				
				IF TYPE("tmpPO1.sz2")="N" OR VARTYPE(tmpPO1.Sz2)="Y"  &&sz2
					IF tmpPO1.sz2 > 0
						ThisForm.DIM21.Value = PrepareSQLnum(tmpPO1.Sz2,'Sz2',10,3)
					ENDIF
				ENDIF
				IF TYPE("tmpPO1.sz3")="N" OR VARTYPE(tmpPO1.Sz3)="Y"  &&sz3
					IF tmpPO1.sz3 > 0
						ThisForm.DIM31.Value = PrepareSQLnum(tmpPO1.Sz3,'Sz3',10,3)
					ENDIF
				ENDIF
				
				ThisForm.chkRandLen.Value = PrepareSQLchk(tmpPO1.RandLen,'RandLen')
				
		
				IF TYPE("tmpPO1.StandSize")="N" OR VARTYPE(tmpPO1.StandSize)="Y"  &&StandSize
					IF tmpPO1.StandSize > 0
						ThisForm.Size1.Value = PrepareSQLnum(tmpPO1.StandSize,'StandSize',10,4)
					ENDIF
				ENDIF
			ENDIF	
			
			**********************************************
			IF lCheckPO
				*Basic Initialize of Unit
				nWeight = PrepareSQLnum(ThisForm.txtLBS.Value,'Weight',7,1)
				
				*,StockLst_P,StockLst_QTY
		
				ThisForm.txtR_P.Value 	= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
				ThisForm.lblAcct_PU.Caption = PrepareSQLtxt(tmpPO1.StockLst_PU,'S_PU',1)
				
				ThisForm.txtLBS.Value 	= PrepareSQLnum(tmpPO1.Pounds,'Pounds',9,1)
				ThisForm.txtS_QTY.Value = PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
				ThisForm.txtS_QTY.Value = PrepareSQLnum(tmpPO1.nStockLst_PU,'PU',-1)
				
				IF nWeight = 0
					IF GetPUfromForm(cForm, ThisForm.nConnHandle) = 1
						ThisForm.txtLBS.Value	= PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
					ELSE
						*Object is like Fitting, Fastener or sold per foot like Pipe or Tubing.
					ENDIF
				ENDIF
			
				
			ENDIF
			
			ThisForm.POrecvStock_Calc()  &&Calcs Weight and QTY
					*REPLACES ThisForm.txtLBS.Value and ThisForm.txtS_QTY.Value
			
			USE IN tmpPO1
		ELSE
			MESSAGEBOX("PO data was not found!"+CHR(13)+"Please check data before saving"+CHR(13)+"Usually more data has been automatically filled in.",0,"Missing Data.")
		ENDIF
			
		
	ENDPROC

	PROCEDURE showwodbywo_detail
		*ThisForm.ShowWODbyWO_Detail()
		
		IF ThisForm.nWO_Detail = 0
			RETURN
		ENDIF
		
		*********** Get from WorkOrder_Detail
		*ThisForm.ReceivingID
		PRIVATE lCheckPO
		lCheckPO = .T.
		
		
		PRIVATE np_LB, nP_PC, nP_Ft, nLotP, nOtherP, nPieces
		np_LB = 0
		nP_PC = 0
		nP_Ft = 0
		nLotP = 0
		nOtherP= 0
		nPieces = 0
		
		IF USED('tmpPO1')
			USE IN tmpPO1
		ENDIF
		SELECT 0
		
		*cSQL = "SELECT Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3 "
		cSQL = "SELECT fAlloy AS Alloy,fForm AS Form,fCC AS CC,fCL AS CL,fPieces AS Pieces,fThck AS Thck,fSz2 AS SZ2,fSz3 AS Fsz, fStartDate AS OrderDate "
		cSQL = cSQL + " ,FSpec AS Cond_Spec, fThck AS StandSize "
		cSQL = cSQL + " ,fWeight AS StockLst_QTY, 0 AS StockLst_P, 1 AS StockLst_PU, fWeight AS Pounds "
		cSQL = cSQL + " ,fWeight AS Order_Qty, 0 AS Order_P, 1 AS Order_PU "
		cSQL = cSQL + " ,fCmplt AS Receipt, fFinishDate AS Received, '' AS ReceivedBy,'' AS Heat "
		cSQL = cSQL + " ,fCmplt AS Delivered, 1 AS Cert,1 AS RandLen "
		cSQL = cSQL + " ,fDueDate AS Due_Min, fDueDate AS Due_Max "
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisForm.POitem+"')"
		*cSQL = cSQL + " AND ReceivingID = "+STR(ThisForm.ReceivingID)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO1')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO1' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO1")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO1")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO1' )
		ENDIF
		
		IF USED('tmpPO1')
			ThisForm.edtReceipt.Value = PrepareSQLtxt(tmpPO1.Receipt,'Receipt',-1)
			ThisForm.STKDATE1.Value = PrepareSQLdate(tmpPO1.Received,'Received')
			ThisForm.ReceivedBy1.Value = PrepareSQLtxt(tmpPO1.ReceivedBy,'ReceivedBy',10)
			IF EMPTY(ThisForm.Heat1.Value)
				ThisForm.Heat1.Value = PrepareSQLtxt(tmpPO1.Heat,'Heat',50)
			ENDIF
		
			ThisForm.chkComplete.Value = PrepareSQLchk(tmpPO1.Delivered,'Delivered')
			ThisForm.chkCert.Value = PrepareSQLchk(tmpPO1.Cert,'Cert')
		
			IF lCheckPO
				ThisForm.chkRandLen.Value = PrepareSQLchk(tmpPO1.RandLen,'RandLen')
			ENDIF
			IF lCheckPO
				ThisForm.Cond1.Value = RIGHT( PrepareSQLtxt(tmpPO1.Cond_Spec,'Cond_Spec',-1) ,20)
			ENDIF
			***
			ThisForm.PODueDate1.Value = PrepareSQLdate(tmpPO1.Due_Min,'Due_Min')
			IF EMPTY(ThisForm.PODueDate1.Value)
				ThisForm.PODueDate1.Value = PrepareSQLdate(tmpPO1.Due_Max,'Due_Max')
			ENDIF
			IF EMPTY(ThisForm.PODueDate1.Value)
				ThisForm.PODueDate1.Value = DATE()
			ENDIF
			***
		
		*	*Get Extras from PO
			PRIVATE nStockLst_QTY, nStockLst_P, nStockLst_PU, cForm, nPU &&StockLst_PU from Form!
			PRIVATE nOrder_Qty, nOrder_P, nOrder_PU, nPounds 
			nStockLst_QTY = PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
			nStockLst_P	= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
			nStockLst_PU = PrepareSQLnum(tmpPO1.StockLst_PU,'PU',-1)
			
			cForm		= PrepareSQLtxt(tmpPO1.Form,'Form',2)
			nPU			= GetPUfromForm( cForm, ThisForm.nConnHandle)
			nOrder_Qty	= PrepareSQLnum(tmpPO1.Order_QTY,'Order_QTY',-5)
			nOrder_P	= PrepareSQLnum(tmpPO1.Order_P,'Order_P',-5)
			nOrder_PU	= PrepareSQLnum(tmpPO1.Order_PU,'PU',-1)
			nPounds 	= PrepareSQLnum(tmpPO1.Pounds,'Pounds',9,1)
		
			IF NOT lCheckPO
				*IF TYPE("tmpPO1.Order_Qty")="N" OR VARTYPE(tmpPO1.Order_Qty)="Y"  &&Order_Qty
					IF nOrder_Qty > 0 AND nPU = 1
						ThisForm.txtLBS.Value = PrepareSQLnum(tmpPO1.Order_Qty,'Order_Qty',-5)
					ENDIF
				*ENDIF
			ENDIF
			
			IF NOT lCheckPO
				*IF TYPE("tmpPO1.StockLst_P")="N" OR VARTYPE(tmpPO1.StockLst_P)="Y" &&StockLst_P
					IF nStockLst_P > 0
						ThisForm.txtR_P.Value = nStockLst_P
					ENDIF
				*ENDIF
			ENDIF
			IF NOT lCheckPO
				*IF TYPE("tmpPO1.StockLst_Qty")="N" OR VARTYPE(tmpPO1.StockLst_Qty)="Y" &&StockLst_QTY
					IF nStockLst_QTY > 0
						ThisForm.txtS_QTY.Value = nStockLst_QTY
					ENDIF
				*ENDIF
			ENDIF
				
			IF lCheckPO
				IF TYPE("tmpPO1.thck")="N" OR VARTYPE(tmpPO1.Thck)="Y"  &&thck
					IF tmpPO1.thck > 0
						ThisForm.DIM11.Value = PrepareSQLnum(tmpPO1.thck,'Thck',10,4)
					ENDIF
				ENDIF
				
				IF TYPE("tmpPO1.sz2")="N" OR VARTYPE(tmpPO1.Sz2)="Y"  &&sz2
					IF tmpPO1.sz2 > 0
						ThisForm.DIM21.Value = PrepareSQLnum(tmpPO1.Sz2,'Sz2',10,3)
					ENDIF
				ENDIF
				IF TYPE("tmpPO1.sz3")="N" OR VARTYPE(tmpPO1.Sz3)="Y"  &&sz3
					IF tmpPO1.sz3 > 0
						ThisForm.DIM31.Value = PrepareSQLnum(tmpPO1.Sz3,'Sz3',10,3)
					ENDIF
				ENDIF
				
				ThisForm.chkRandLen.Value = PrepareSQLchk(tmpPO1.RandLen,'RandLen')
				
		
				IF TYPE("tmpPO1.StandSize")="N" OR VARTYPE(tmpPO1.StandSize)="Y"  &&StandSize
					IF tmpPO1.StandSize > 0
						ThisForm.Size1.Value = PrepareSQLnum(tmpPO1.StandSize,'StandSize',10,4)
					ENDIF
				ENDIF
			ENDIF	
			
			**********************************************
			IF lCheckPO
				*Basic Initialize of Unit
				nWeight = PrepareSQLnum(ThisForm.txtLBS.Value,'Weight',7,1)
				
				*,StockLst_P,StockLst_QTY
		
				ThisForm.txtR_P.Value 	= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
				ThisForm.lblAcct_PU.Caption = PrepareSQLtxt(tmpPO1.StockLst_PU,'S_PU',1)
				
				ThisForm.txtLBS.Value 	= PrepareSQLnum(tmpPO1.Pounds,'Pounds',9,1)
				ThisForm.txtS_QTY.Value = PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
				ThisForm.txtS_QTY.Value = PrepareSQLnum(tmpPO1.nStockLst_PU,'PU',-1)
				
				IF nWeight = 0
					IF GetPUfromForm(cForm, ThisForm.nConnHandle) = 1
						ThisForm.txtLBS.Value	= PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
					ELSE
						*Object is like Fitting, Fastener or sold per foot like Pipe or Tubing.
					ENDIF
				ENDIF
			
				
			ENDIF
			
			ThisForm.POrecvStock_Calc()  &&Calcs Weight and QTY
					*REPLACES ThisForm.txtLBS.Value and ThisForm.txtS_QTY.Value
			
			USE IN tmpPO1
		ELSE
			MESSAGEBOX("WO Detail data was not found!"+CHR(13)+"Please check data before saving"+CHR(13)+"Usually more data has been automatically filled in.",0,"Missing Data.")
		ENDIF
			
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConnection 
			= SQLDISCONNECT( ThisForm.nConnHandle )
		ENDIF
		
		
		IF USED("tmpHistory")
			USE IN tmpHistory
		ENDIF
		
		IF USED("tmpReceivedBy")
			USE IN tmpReceivedBy
		ENDIF
		
		IF USED("tmpMills")
			USE IN tmpMills
		ENDIF
		
	ENDPROC

	PROCEDURE ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle)
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE BrandName1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, cAlloy, cBrandName
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		cAlloy = ThisForm.ALLOY1.Value
		cBrandName = ""
		
		IF USED('tmpBrandName')
			SELECT tmpBrandName
		ELSE
			SELECT 0
		ENDIF
		
		IF !EMPTY(lcSearchStr)
			cSQL = "SELECT DISTINCT [BrandName] FROM dbo.StockLst_Master WHERE Alloy = '"+cAlloy+"'"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpBrandName')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpBrandName')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpBrandName")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpBrandName")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpBrandName')
			ENDIF
		
		
			IF USED("tmpBrandName")
				SELECT tmpBrandName
				IF NOT ISNULL(tmpBrandName.BrandName)
					cBrandName = tmpBrandName.BrandName
					LOCATE FOR UPPER(BrandName) = UPPER(lcSearchStr)
					IF FOUND('tmpBrandName')
						cBrandName = tmpBrandName.BrandName
					ENDIF
				ENDIF
				USE IN tmpBrandName
			ENDIF
		
			IF NOT EMPTY(cBrandName)
			
				IF UPPER(lcSearchStr) = SUBSTR(cBrandName,1,lnInsertionPt)
					THIS.VALUE=cBrandName
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
		
		
	ENDPROC

	PROCEDURE BrandName1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE cmbCC.Destroy
		RELEASE aConditionCode
	ENDPROC

	PROCEDURE cmbCC.GotFocus
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		This.clear
		
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = "1"
		
	ENDPROC

	PROCEDURE cmbCC.InteractiveChange
		PRIVATE cCC, cCL_default
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		cCL_default	= Default_CL_CC(cCC,ThisForm.nConnHandle)
		
		This.Parent.cmbCL.Value = cCL_default
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = cCL_default
	ENDPROC

	PROCEDURE cmbCC.LostFocus
		ThisForm.InitcmbCL()
	ENDPROC

	PROCEDURE cmbCL.Destroy
		RELEASE aConditionLevel
	ENDPROC

	PROCEDURE cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		*this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = " "
		
		IF USED('ConditionLevel')
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CL
		
		
	ENDPROC

	PROCEDURE cmbForm.Destroy
		RELEASE aFormCode
	ENDPROC

	PROCEDURE cmbForm.Init
		*Done in frmPORecvStock.INIT
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		This.clear
		cSQL = "SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT FormNumber,FormDescription FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			This.addListitem(aFormCode(I, 1),I,1)
			This.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
		
		This.Value = '10'
		ThisForm.FormCaptions()
		
	ENDPROC

	PROCEDURE cmbForm.InteractiveChange
		ThisForm.FormCaptions()
	ENDPROC

	PROCEDURE cmbLocation1.Destroy
		RELEASE aStandLocation
	ENDPROC

	PROCEDURE cmbLocation1.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('StandLocation')
			SELECT StandLocation
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [Location], SUBSTRING(Description,1,20) AS DESCR FROM dbo.StockLst_Location "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StandLocation')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StandLocation')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'StandLocation')
		ENDIF
		
		DIMENSION aStandLocation(1,2)
		
		IF USED('StandLocation')
			SELECT Location, IIF(ISNULL(DESCR)," ",DESCR) FROM StandLocation INTO ARRAY aStandLocation
			
			USE IN StandLocation
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aStandLocation)
		This.BoundColumn = 1
		This.ColumnWidths = "80,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aStandLocation,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aStandLocation(I, 1),I,1)
			this.addListitem(aStandLocation(I, 2),I,2)
		ENDFOR
	ENDPROC

