		=insmode(.T.)
	ENDPROC

	PROCEDURE SIZE1.GotFocus
		This.InputMask = "9999999.999"
	ENDPROC

	PROCEDURE SIZE1.LostFocus
		This.InputMask = "9,999,999.999"
	ENDPROC

	PROCEDURE SIZE1.Valid
		PRIVATE nSize
		nSize = This.Value
		
		IF nSize = 0
			MESSAGEBOX( "You must enter a valid size",0+16,"No Size!")
			RETURN -1
		ENDIF
		
		PRIVATE cForm, cAlloy, cCC, cCL
		cForm = PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cAlloy = PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		
		*getStandardSize_Common_CC_CL getStandardSize_Alloy_form getPriceTableStandardSize 
		nStandardSize = getStandardSize_Common_CC_CL(nSize,cAlloy,cForm,cCC,cCL,ThisForm.nConnHandle)
		
		IF nStandardSize > 0
			nSize = nStandardSize 
		ELSE
			*generic
			nStandardSize = getStandardSize(nSize, ThisForm.nConnHandle)	
		ENDIF
		
		IF nStandardSize > 0
			IF nStandardSize != nSize
				IF cForm = '10' OR cForm = '40'
		*			MESSAGEBOX("Not a 'Standard Size'! "+ALLTRIM(STR(nSize,9,4))+CHR(13)+"You may need to adjust your Size Entered!"+CHR(13)+"A 'Standard' Size would be its PriceTable size!"+CHR(13)+[Example: A plate that mic's .995" would still be priced as 1" plate.],0+16,"Size Entered is not a Standard")
		*			RecordTest("Not a Standard Size.", PROGRAM(), LINENO(1),"Not a Standard Size! Size tried was "+ALLTRIM(STR(nSize,9,4))+"  Alloy "+ALLTRIM(cAlloy)+"  Form "+cForm  )
		
			*TrackError("Not a Standard Size","Not a Standard Size!"+": Size tried was "+ALLTRIM(STR(nSize,9,4))+" Alloy "+ALLTRIM(cAlloy)+" Form "+cForm,PROGRAM(),LINENO(1))
			*MESSAGEBOX("A 'Standard' Size would be its PriceTable size!"+CHR(13)+[Example: A plate that mic's .995" would still be priced as 1" plate.],0+48,"What is STANDARD.")
		
					FOR nPrevSize = nSize TO 0 STEP -.001
						nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
						IF nPrevStandardSize < nStandardSize 
							This.Value = nPrevStandardSize
							EXIT
						ENDIF
					NEXT nPrevSize 
				ENDIF				
		*		RETURN -1
			ENDIF
		ENDIF
		
		IF nStandardSize = 0
			*nStandardSize = getStandardSize_Alloy_form(nSize, cAlloy, cForm, ThisForm.nConnHandle)  &&Check Price Table!
			*nStandardSize = getPriceTableStandardSize( nSize, cAlloy, cForm, cCC, ThisForm.nConnHandle)
			nStandardSize = getStandardSize_Common_CC_CL( nSize, cAlloy, cForm, cCC, cCL, ThisForm.nConnHandle)
		ENDIF
		
		IF nStandardSize = 0
			MESSAGEBOX("Could not get a Standard Size!"+CHR(13)+"You may need to adjust your Size Entered!",0,"Error getting a Standard")
		*	TrackMess("Could not get a Standard Size!"+":StockLst_Master.Size1.Valid Size tried was "+ALLTRIM(STR(nSize,9,4)))
		
			PRIVATE nID
			nID = PrepareSQLnum(ThisForm.id1.Value,'ID',-3)
		
			TrackError("Could not get a Standard Size!"+":Size tried was "+ALLTRIM(STR(nSize,9,4))+" for ID:"+ALLTRIM(STR(nID))+" Form:"+cForm,"Could not get a Standard Size!",PROGRAM(),LINENO(1))
		ENDIF
	ENDPROC

	PROCEDURE SIZE_H1.GotFocus
		This.InputMask = "999999.9999"
	ENDPROC

	PROCEDURE SIZE_H1.LostFocus
		This.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE SIZE_H1.Valid
		PRIVATE nTol, nDim1
		nTol = PrepareSQLnum(This.Value,'Size_H1',9,4)
		nDim1 = PrepareSQLnum(ThisForm.DIM11.Value,'Dim1',18,4)
		
		
		IF nTol > 0
			IF nDim1 > 0
				IF nDim1 > nTol
					*MESSAGEBOX( "The High Tolerance is usually higher than the DIM 1",0,"Caution")
					WAIT WINDOW "The High Tolerance is usually higher than the DIM 1" NOWAIT
				ENDIF
				IF  nTol - nDim1 > 1
					MESSAGEBOX( "The High Tolerance is usually closer to the DIM 1"+CHR(13)+"Dim1 = "+ALLTRIM(STR(nDim1))+CHR(13)+"Tol = "+ALLTRIM(STR(nTol)),0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF nTol < 0
				MESSAGEBOX( "The High Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE SIZE_L1.GotFocus
		This.InputMask = "999999.9999"
	ENDPROC

	PROCEDURE SIZE_L1.LostFocus
		This.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE SIZE_L1.Valid
		PRIVATE nTol, nDim1
		nTol = PrepareSQLnum(This.Value,'Size_L1',9,4)
		nDim1 = PrepareSQLnum(ThisForm.DIM11.Value,'Dim1',18,4)
		
		IF nTol > 0
			IF nDim1 > 0
				IF nDim1 < nTol
					*MESSAGEBOX( "The Low Tolerance is usually below the DIM 1",0,"Caution")
					WAIT WINDOW "The Low Tolerance is usually below the DIM 1" NOWAIT
				ENDIF
			ENDIF
		ELSE
			IF nTol  < 0
				MESSAGEBOX( "The Low Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

