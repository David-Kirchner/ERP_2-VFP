	PROCEDURE cmbMelt.Destroy
		RELEASE aMelt_Type
	ENDPROC

	PROCEDURE cmbMelt.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpMelt_Type')
			SELECT tmpMelt_Type
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		
		cSQL="SELECT RTRIM([Type]) AS [Type] FROM dbo.Melt_Type ORDER BY ID"
		 
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMelt_Type")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMelt_Type")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpMelt_Type')
		ENDIF
		
		DIMENSION aMelt_Type(1)
		
		IF USED('tmpMelt_Type')
			SELECT Type FROM tmpMelt_Type INTO ARRAY aMelt_Type
			
			USE IN tmpMelt_Type 
		ENDIF
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aMelt_Type,1)
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 1
		This.NumberOfElements=nArrayCount 
		This.BoundColumn = 1
		This.ColumnWidths = "50"
		
		
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aMelt_Type(I),I)
		*	this.addListitem(aMelt_Type(I, 2),I,2)
		ENDFOR
		
		This.Value = aMelt_Type(1)
		
		
	ENDPROC

