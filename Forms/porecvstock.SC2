	PROCEDURE ReceivedBy1.Init
		**Initialize ReceivedBy
		cSQL = "SELECT DISTINCT INIT AS ReceivedBy FROM dbo.Receiving "
		IF USED("tmpReceivedBy")
			SELECT tmpReceivedBy
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivedBy')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivedBy')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivedBy")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivedBy")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpReceivedBy')
		ELSE
			SELECT tmpReceivedBy
			INDEX ON ReceivedBy TAG ReceivedBy 
		ENDIF
	ENDPROC

	PROCEDURE ReceivedBy1.InteractiveChange
		lnInsertionPt = IIF(this.SelStart=0,10,this.SelStart)
		lcSearchStr = substr(this.value,1,lnInsertionPt)
		IF !empty(lcSearchStr)
				=seek(upper(lcSearchStr),"tmpReceivedBy","ReceivedBy")
				IF found("tmpReceivedBy")
					this.VALUE=tmpReceivedBy.ReceivedBy
					=insmode(.f.)
				ELSE
					this.value=lcSearchStr
					=insmode(.t.)
				ENDIF
		ELSE &&ThisValue is empty
			this.value=space(0)
		ENDIF
		this.selstart = lnInsertionPt
		
	ENDPROC

