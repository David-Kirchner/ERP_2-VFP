	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT() 
		*-- &&Done in INIT
	ENDPROC

	PROCEDURE porecvstock_calc
		*ThisForm.POrecvStock_Calc()
		
		PRIVATE lcAlloy, lcForm, lnPiece
		PRIVATE lnDim1,lnDim2,lnDim3 
		
		lcAlloy		= PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		lcForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		lnPiece		= PrepareSQLnum(ThisForm.PC1.Value,'Pieces',-3)
		lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',10,4)
		lnDim2		= PrepareSQLnum(ThisForm.Dim21.Value,'Dim2',9,3)
		lnDim3		= PrepareSQLnum(ThisForm.Dim31.Value,'Dim3',9,3)
		
		IF NOT ( lcAlloy = "" OR lcForm = "" OR lnDim1 = 0 )
			RETURN
		ENDIF
		IF lnDim2 = 0 
			IF usesForm_Dim2(lcForm, ThisForm.nConnHandle)
				RETURN
			ENDIF
		ENDIF
		
		nCalc_QTY	 = Calc_QTY( lcAlloy, lcForm, lnPiece, lnDim1,lnDim2,lnDim3,'', ThisForm.nConnHandle)
		nCalc_Weight = Calc_Weight( lcAlloy, lcForm, lnPiece, lnDim1,lnDim2,lnDim3, ThisForm.nConnHandle)
		
		IF lcForm = '80'
			nCalc_Weight = CalcWeightDisk(lnPiece, lcAlloy, lcForm, lnDim1,lnDim2,lnDim3, ThisForm.nConnHandle)
		ENDIF
		
		PRIVATE nLBS, nS_QTY
		nLBS = PrepareSQLnum(ThisForm.txtLBS.Value,'LBS',9,1)
		nS_QTY = PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		
		IF nLBS = 0 
			ThisForm.txtLBS.Value	= nCalc_Weight 
		ELSE
			*Ask to overwrite
		ENDIF
		
		IF nS_QTY = 0
			ThisForm.txtS_QTY.Value	= nCalc_QTY
		ELSE
			*Ask to overwrite
		ENDIF
	ENDPROC

	PROCEDURE recvstockchangelst
		*ThisForm.RecvStockChangeLst()
		
		PRIVATE cWhatDo, nReceivingID, cTblNew, cStockTableInit
		
		*cTbl = ThisForm.txtTableName1.Value
		cWhatDo = ThisForm.txtWhatDo.Value
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF VARTYPE( ThisForm.cTBL ) != "C"
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDIF
		DO CASE
		CASE ThisForm.cTBL="S" 
			*cTBL ="STOCKLST"
			cTblNew = "BrokerLst"
			cStockTableInit = "B"
		CASE ThisForm.cTBL="B"
			*cTBL ="BROKERLST"
			cTblNew = "StockLst"
			cStockTableInit = "S"
		CASE ThisForm.cTBL = "W"
			cTblNew = "StockLst"
			cStockTableInit = "S"
		OTHERWISE
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDCASE
		
		IF VARTYPE( cWhatDo ) != "C"
			MESSAGEBOX("'What' must be ADD")
			RETURN
		ENDIF
		IF UPPER(cWhatDo) != "ADD"
			MESSAGEBOX("'What' must be ADD")
			RETURN
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.PO_ITEM1.Value,'POitem',12)
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
			MESSAGEBOX("need a POitem")
			RETURN
		ENDIF
		
		
		IF MESSAGEBOX("Are you sure you want to change to Table "+cTblNew+" ?",4+32,"Receive was to be "+ThisForm.cTBL ) != 6
			RETURN
		ENDIF
		
		PRIVATE lSave, nID_Master
		lSave = .T.
		
		*IF UPPER(cTBL)="STOCKLST" 
		IF ThisForm.cTBL = "S"
			MESSAGEBOX("Sorry, Cannot change StockLst to BrokerLst."+CHR(13)+"Receive to Stock and consume all to customer!",16,"Not Programmed.")
			lSave = .F.
		ENDIF
		
		PRIVATE nCntPOitem ,nCntDueIn 
		
		IF lSave
			*Change PO ***************
			nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle )
			nCntDueIn = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "DELIVERED" )
		
			IF nCntPOitem > 99
				MESSAGEBOX("POitem is incorrect:"+cPOitem,16,"Error, found too many!")
				RETURN
			ENDIF
			IF nCntPOitem > 0
				*Found POitem
				IF nCntDueIn = 0
					*Not Delivered
					*UPDATE PurchaseOrder SET STOCK = 'Some Stock   ' WHERE POitem = cPOitem
				ELSE
					*Delivered
					*UPDATE PurchaseOrder SET STOCK = "Some Stock   " WHERE POitem = cPOitem
				ENDIF
			ELSE
				*Did not find POitem
			ENDIF
		ENDIF
		
		PRIVATE nID,nID_Detail,nID_Detail_Process
		nID = 0
		nID_Detail = 0
		
		nID_Detail_Process = 0
		
		IF lSave
			*Get Master,Detail and Process
			IF USED('tmpID_ID_Detail')
				USE IN tmpID_ID_Detail
			ENDIF
			SELECT 0
			
			*nID,nID_Detail,nID_Detail_Process
			cSQL = "Select ID, ID_Detail FROM dbo.BrokerLst_Detail WHERE ReceivingID = "+STR( nReceivingID )
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_ID_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_ID_Detail' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_ID_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_ID_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_ID_Detail')
				*TrackError("Could not get ID, ID_Detail with "+cSQL,"SQL Error:"+STR(nSQLEXEC),PROGRAM(),LINENO(1))
				RecordError(nSQLEXEC,'Could not get ID, ID_Detail',PROGRAM(),LINENO(1), cSQL )
			ELSE 
				IF USED('tmpID_ID_Detail')
					IF VARTYPE(tmpID_ID_Detail.ID) = "N"
						nID = tmpID_ID_Detail.ID
					ENDIF
					IF VARTYPE(tmpID_ID_Detail.ID_Detail) = "N"
						nID_Detail = tmpID_ID_Detail.ID_Detail
					ENDIF
					
					USE IN tmpID_ID_Detail
				ENDIF
			ENDIF
			
			*GET Process # by BrokerLst_Process_Detail WHERE ID_Detail
			IF nID_Detail > 0
				IF USED('tmpID_DetailPrc')
					USE IN tmpID_DetailPrc
				ENDIF
				SELECT 0
				cSQL = "SELECT ID_Detail_Process FROM dbo.BrokerLst_Process_Detail WHERE ID_Detail = "+STR(nID_Detail)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_DetailPrc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_DetailPrc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_DetailPrc')
					*TrackError("Could not get ID, ID_Detail with "+cSQL ,"Could not get ID, ID_Detail",PROGRAM(),LINENO(1))
					RecordError(nSQLEXEC,'Could not get ID, ID_Detail ',PROGRAM(),LINENO(1), cSQLu )
				ELSE 
					IF USED('tmpID_DetailPrc')
						IF VARTYPE(tmpID_DetailPrc.ID_Detail_Process) = "N"
							nID_Detail_Process = tmpID_DetailPrc.ID_Detail_Process
						ENDIF
					 	USE IN tmpID_DetailPrc
					ENDIF
				ENDIF
			ENDIF
			
			*GET Process # by BrokerLst_Process WHERE ID_Detail
			IF nID_Detail > 0
				IF USED('tmpID_DetailPrc')
					USE IN tmpID_DetailPrc
				ENDIF
				SELECT 0
				cSQL = "SELECT ID_Detail_Process FROM dbo.BrokerLst_Process WHERE ID_Detail = "+STR(nID_Detail)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_DetailPrc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_DetailPrc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_DetailPrc')
					*TrackError("Could not get ID, ID_Detail with "+cSQL,"Could not get ID, ID_Detail",PROGRAM(),LINENO(1))
					RecordError(nSQLEXEC,'Could not get ID, ID_Detail',PROGRAM(),LINENO(1), cSQL )
				ELSE 
					IF USED('tmpID_DetailPrc')
						IF VARTYPE(tmpID_DetailPrc.ID_Detail_Process) = "N"
							nID_Detail_Process = tmpID_DetailPrc.ID_Detail_Process
						ENDIF
					 	USE IN tmpID_DetailPrc
					ENDIF
				ENDIF
			ENDIF
			
			*Move SQL Lst-Master,Detail,Process ***************
			
			IF nID = 0 AND  nID_Detail > 0
				*Get nID
				nID = PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
			ENDIF
			
			IF nID > 0 AND nID_Detail > 0
				nID_Master = Move_BrokerLst_StockLst( nID,nID_Detail,ThisForm.nConnHandle )
				*EXEC dbo.p_Move_BrokerLst_StockLst
				
				IF nID_Master > 0
					nID_Detail = Get_top_ID_Detail_from_ID(nID_Master, 'S',ThisForm.nConnHandle )
					ThisForm.ID_Detail1.Value = nID_Detail 
				ENDIF
			ELSE
				TrackError("Did not have IDs to Move_BrokerLst_StockLst: ID="+STR(nID)+" nID_Detail="+STR(nID_Detail)+" POitem="+cPoitem,"Could not run Move_BrokerLst_StockLst",PROGRAM(),LINENO(1) )
			ENDIF
			
		ENDIF
		
		IF lSave
			*Save to Receiving ***************
			IF nID_Master > 0
				cSQLu = "UPDATE dbo.Receiving SET"
				cSQLu = cSQLu +" ID_Master = "+STR(nID_Master)+""
				cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)
				cSQLu = cSQLu +",StockTable = '"+ThisForm.cTBL+"'"
				cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'')
					*lSaved = .F.
					*RETURN
					*TrackError("Could not update dbo.Receiving. "+cSQLu ,"Could not update dbo.Receiving.",PROGRAM(),LINENO(1))
					RecordError(nSQLEXEC,'Could not update dbo.Receiving',PROGRAM(),LINENO(1), cSQLu )
				ELSE 
					*lSaved = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		IF lSave
			DO CASE
			CASE ThisForm.cTBL="S"
				ThisForm.txtTableName1.Value = 	"BrokerLst"
				ThisForm.cTBL = "B"
			CASE ThisForm.cTBL="B"
				ThisForm.txtTableName1.Value = 	"StockLst"
				ThisForm.cTBL = "S"
			ENDCASE
		ENDIF
		
		
	ENDPROC

	PROCEDURE recvstockmovebroker2stock
		
		*ThisForm.RecvStockMoveBroker2Stock
		PRIVATE cWhatDo, nReceivingID, cTblNew, cPOitem, nID_Detail, cStockTableInit
		*cTbl = ThisForm.txtTableName1.Value
		cWhatDo = ThisForm.txtWhatDo.Value
		nReceivingID = ThisForm.txtReceivingID.Value
		cPOitem = PrepareSQLtxt(ThisForm.PO_ITEM1.Value,'POitem',12)
		nID_Detail = ThisForm.ID_DETAIL1.Value
		
		IF nID_Detail = 0
			IF ThisForm.ID_detail > 0
			
				PRIVATE cMess	
				cMess = "Trouble" +CHR(13)
				*cMess = cMess + "Table:"+ThisForm.cTBL +CHR(13)
				cMess = cMess + "WhatDo:"+cWhatDo +", move left over Broker to Stock."+CHR(13)
				
				cMess = cMess + "POitem:"+cPOitem +CHR(13)
				
				cMess = cMess + STR(nReceivingID)+"ReceivingID"+CHR(13)
				cMess = cMess + STR(ThisForm.ID_DETAIL1.Value)+"ThisForm.ID_DETAIL1.Value"+CHR(13)
				cMess = cMess + STR(ThisForm.ID_detail)+"ThisForm.ID_detail"+CHR(13)
		
				cMess = cMess + STR(ThisForm.ID1.Value)+"ThisForm.ID1.Value of BrokerLst"+CHR(13)
				cMess = cMess + "ID_Detail was replaced by ThisForm.ID_Detail "+CHR(13)
				
				nID_Detail = ThisForm.ID_detail
				TrackError(cMess,"ID_Detail was replaced by ThisForm.ID_Detail instead of Parameter",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		IF VARTYPE( ThisForm.cTBL ) != "C"
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDIF
		DO CASE
		CASE ThisForm.cTBL="S" 
			cTblNew = "BrokerLst"
			cStockTableInit = "S"
		CASE ThisForm.cTBL="B"
			cTblNew = "StockLst"
			cStockTableInit = "B"
		OTHERWISE
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDCASE
		
		IF VARTYPE( cWhatDo ) != "C"
			MESSAGEBOX("'What' must be EDIT")
			RETURN
		ENDIF
		IF UPPER(cWhatDo) != "EDIT"
			MESSAGEBOX("'What' must be EDIT")
			RETURN
		ENDIF
		
		IF VARTYPE(nReceivingID) = "C"
			nReceivingID = VAL(nReceivingID)
		ENDIF
		
		IF VARTYPE(nReceivingID) != "N"
			nReceivingID = 0
		ENDIF
		
		*IF UPPER(cWhatDo) != "EDIT"
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
			MESSAGEBOX("need a POitem")
			RETURN
		ENDIF
		
		*IF MESSAGEBOX("Are you sure you want to change to "+cTblNew+" ?",4+32,"Receive was to be "+ThisForm.cTBL ) != 6
		*	RETURN
		*ENDIF
		
		PRIVATE lSave, nID_Master
		lSave = .T.
		nID_Master = 0
		
		*IF ThisForm.cTBL="S" 
		*	MESSAGEBOX("Sorry, Cannot change StockLst to BrokerLst."+CHR(13)+"Receive to Stock and consume all to customer!",16,"Not Programmed.")
		*	lSave = .F.
		*ENDIF
		
		IF lSave
			IF Proper_PO_Item(ThisForm.POitem) <> Proper_PO_Item('')
				*Change PO ***************
				nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle )
				nCntDueIn  = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, 'Delivered')
				
				IF nCntPOitem  > 99
					MESSAGEBOX("POitem is incorrect:"+cPOitem,16,"Error, found too many!")
					RETURN
				ENDIF
				IF nCntPOitem > 0
					*Found POitem
					IF nCntDueIn = 0
						*Not Delivered
						*UPDATE PurchaseOrder SET STOCK = "Some Stock   " WHERE POitem = cPOitem
						PRIVATE cSQLu
						cSQLu = "UPDATE dbo.PurchaseOrder SET "
						cSQLu = cSQLu + " [Stock]='Some Stock   '"
						cSQLu = cSQLu + " WHERE PurchaseOrder.POItem = dbo.f_ProperPOitem('"+cPOItem+"')"
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "tmpPO_QTY")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "tmpPO_QTY")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
						
					ELSE
						*Delivered
						*UPDATE PurchaseOrder SET STOCK = "Some Stock   " WHERE POitem = cPOitem
						PRIVATE cSQLu
						cSQLu = "UPDATE dbo.PurchaseOrder SET "
						cSQLu = cSQLu + " [Stock]='Some Stock   '"
						cSQLu = cSQLu + " WHERE PurchaseOrder.POItem = dbo.f_ProperPOitem('"+cPOItem+"')"
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
					ENDIF
				ENDIF
			ELSE
				*Did not find POitem
			ENDIF
		ENDIF
		
		*check WO_Detail
		
		
		
		PRIVATE nID,nID_Detail_Process
		nID = 0
		nID_Detail_Process = 0
		
		IF VARTYPE(nID_Detail) != "N"
			nID_Detail = 0
		ENDIF
		
		IF lSave
			*Get Master,Detail and Process
			IF USED('tmpID_ID_Detail')
				USE IN tmpID_ID_Detail
			ENDIF
			SELECT 0
			
			IF nID_Detail = 0
				*Get nID,nID_Detail,nID_Detail_Process
		
				cSQL = "Select [ID], [ID_Detail] FROM dbo.StockLst_Detail WHERE ReceivingID = "+STR( nReceivingID )
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_ID_Detail' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_ID_Detail' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_ID_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_ID_Detail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_ID_Detail')
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not get ID, ID_Detail from 'tmpID_ID_Detail'" +CHR(13)+cSQL )
				ELSE 
					IF USED('tmpID_ID_Detail')
						IF VARTYPE(tmpID_ID_Detail.ID) = "N"
							nID = tmpID_ID_Detail.ID
						ENDIF
						IF VARTYPE(tmpID_ID_Detail.ID_Detail) = "N"
							nID_Detail = tmpID_ID_Detail.ID_Detail
						ENDIF
						
						USE IN tmpID_ID_Detail
					ENDIF
				ENDIF
			ENDIF
			
			*GET Process # by BrokerLst_Process WHERE ID_Detail
			IF nID_Detail > 0
				IF USED('tmpID_DetailPrc')
					USE IN tmpID_DetailPrc
				ENDIF
				SELECT 0
				cSQL = "SELECT ID_Detail_Process FROM dbo.StockLst_Process WHERE ID_Detail = "+STR(nID_Detail)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_DetailPrc')
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not get ID, ID_Detail from 'tmpID_DetailPrc'"+CHR(13)+cSQL )
				ELSE 
					IF USED('tmpID_DetailPrc')
						IF VARTYPE(tmpID_DetailPrc.ID_Detail_Process) = "N"
							nID_Detail_Process = tmpID_DetailPrc.ID_Detail_Process
						ENDIF
					 	USE IN tmpID_DetailPrc
					ENDIF
				ENDIF
			ENDIF
			
			*Move SQL Lst-Master,Detail,Process ***************
			
			IF nID = 0 AND  nID_Detail > 0
				*Get nID
				nID = ThisForm.ID1.Value
			ENDIF
			
			IF nID > 0 AND nID_Detail > 0
		
				nID_Master = Move_BrokerLst_StockLst( nID, nID_Detail, ThisForm.nConnHandle )
				*EXEC dbo.p_Move_BrokerLst_StockLst
				
				IF nID_Master > 0
					*Now StockLst!
					cStockTableInit = "S"
					nID_Detail = Get_top_ID_Detail_from_ID(nID_Master, 'S', ThisForm.nConnHandle )
					ThisForm.ID_Detail1.Value = PrepareSQLnum(nID_Detail,'ID_Detail',-3)
					
				ELSE
					RETURN -1
				ENDIF
			ELSE
				TrackError("Did not find IDs, ID="+STR(nID)+", nID_Detail="+STR(nID_Detail)+" cPOItem='"+cPOItem+"' "+CHR(13)+cSQL,"Could not run Move_BrokerLst_StockLst",PROGRAM(),LINENO(1))
			ENDIF
			
				
		ENDIF
		
		IF lSave
			*Save to Receiving ***************
			IF nID_Master > 0
				cSQLu = "UPDATE dbo.Receiving SET"
				cSQLu = cSQLu +" ID_Master = "+STR(nID_Master)+""
				cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)+""
				cSQLu = cSQLu +",StockTable = '"+cStockTableInit+"'"
				cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'')
					*lSaved = .F.
					*RETURN
					*TrackError(cSQLu,"Could not update dbo.Receiving.",PROGRAM(),LINENO(1))
					RecordError(nSQLEXEC,'Could not update dbo.Receiving',PROGRAM(),LINENO(1), cSQLu )
				ELSE 
					*lSaved = .T.
				ENDIF
			ELSE
				MESSAGEBOX("Move_BrokerLst_StockLst did not return a master 'ID'",0+48,"No Receiving record was changed by the RecvStockMoveBroker2Stock() function.")
				TrackError("Move_BrokerLst_StockLst(ID="+STR(nID)+",nID_Detail="+STR(nID_Detail)+" "+CHR(13)+cSQLu ,"Did not return a new StockLst Master ID.",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		IF lSave
			IF cStockTableInit = 'S'
				ThisForm.txtTableName1.Value = 	"StockLst"
				ThisForm.cTBL = "S"
			ENDIF
		ENDIF
		
		
		*******************
		IF lSave
			RETURN nID_Master
		ELSE
			RETURN -1
		ENDIF
		
		
	ENDPROC

	PROCEDURE saveadd
		*ThisForm.SaveAdd
		
		PRIVATE lDelivered, lCert 
		PRIVATE cSQL, nSQLEXEC, lOK, cSQLi, lRollBack
		lOK = .T.
		lRollBack = .F.
		
		PRIVATE m.lcAlloy,m.lcForm,m.lcCC,m.lcCL,m.lcCond,m.lnSize,m.lnPAID,m.lnMWeight
		PRIVATE m.lcSpecs,m.lcHeat,m.lcLot,m.lcPO_Item
		PRIVATE m.ldPODueDate,m.lnWO_Detail,m.lcHistory,m.lcMill,m.ldStkDate 
		PRIVATE m.lnNum,m.lnFrom_ID,m.lnID_Detail,m.lnPC
		PRIVATE m.lnSize_H,m.lnDim1,m.lnSize_L,m.lnDim2,m.lnDim3 
		PRIVATE m.lnWeight, m.lnS_QTY, m.lnOrdered_QTY, m.lnS_P, m.lcDescript,m.lcLength  
		PRIVATE m.lcFloorStatus, m.lcClass
		PRIVATE m.lcBrandName, m.lcLocation, m.lcMelt
		PRIVATE m.lcReceipt, m.lcReceivedBy 
		PRIVATE m.llDelivered, m.llCert, m.lnDelivered,m.lnCert		
		PRIVATE m.lnRandLen, m.llRandLen, m.lnPrime, m.llPrime, m.nReceivingID
		PRIVATE llMarkInvDate
		PRIVATE m.lnS_Total, m.lnS_PU
		
		m.lcAlloy		= PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		m.lcForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		m.lcCC			= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.T.)
		m.lcCL			= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1,.T.)
		m.lcCond		= PrepareSQLtxt(ThisForm.Cond1.Value,'Condition',30)
		m.lnSize		= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,3)
		m.lnPAID		= PrepareSQLnum(ThisForm.Paid1.Value,'Paid',9,2)
		m.lnMWeight		= PrepareSQLnum(ThisForm.txtLBS.Value,'Weight',9,2)
		m.lcSpecs		= PrepareSQLtxt(ThisForm.specs1.Value,'Specs',160)
		m.lcHeat		= PrepareSQLtxt(ThisForm.Heat1.Value,'Heat',50)
		m.lcLot			= PrepareSQLtxt(ThisForm.Lot1.Value,'Lot',10)
		m.lcPO_Item		= Proper_PO_Item(ThisForm.PO_Item1.Value)
		m.ldPODueDate	= PrepareSQLdate(ThisForm.PODueDate1.Value,'PODueDate')
		m.lnWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		m.lcHistory		= PrepareSQLtxt(ThisForm.History1.Value,'History',20,.F.,.T.)
		m.lcMill		= PrepareSQLtxt(ThisForm.Mill1.Value,'Mill',10)
		m.ldStkDate		= PrepareSQLdate(ThisForm.StkDate1.Value,'StkDate')
		m.lnNum			= PrepareSQLnum(ThisForm.Num1.Value,'Num',8,0)
		m.lcBrandName	= PrepareSQLtxt(ThisForm.BrandName1.Value,'BrandName',20)
		m.lnFrom_ID		= PrepareSQLnum(ThisForm.From_ID1.Value,'From_ID',-3)
		m.lnID_Detail	= PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		
		m.lnPC			= PrepareSQLnum(ThisForm.PC1.Value,'Pieces',-3)
		m.lnSize_H		= PrepareSQLnum(ThisForm.Size_H1.Value,'Tol HIGH',9,4)
		m.lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',18,4)
		m.lnSize_L		= PrepareSQLnum(ThisForm.Size_L1.Value,'Tol LOW',9,4)
		*m.lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',10,4)
		m.lnDim2		= PrepareSQLnum(ThisForm.Dim21.Value,'Dim2',9,3)
		m.lnDim3		= PrepareSQLnum(ThisForm.Dim31.Value,'Dim3',9,3)
		m.lnWeight		= PrepareSQLnum(ThisForm.txtLBS.Value,'Weight',9,2)
		m.lnS_QTY		= PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		m.lnS_P			= PrepareSQLnum(ThisForm.txtR_P.Value,'S_P',-5)
		m.lnAcct_PU		= PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
		m.lcDescript	= PrepareSQLtxt(ThisForm.Descript1.Value,'Description',20,.F.,.T.)
		
		m.lcLength		= PrepareSQLtxt(ThisForm.Length1.Value,'Length',160)
		m.lcFloorStatus	= PrepareSQLtxt(ThisForm.FloorStatus1.Value,'FloorStatus',1)
		m.lcClass		= PrepareSQLtxt(ThisForm.Class1.Value,'Class',1)
		m.lcLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		m.lcMelt		= PrepareSQLtxt(ThisForm.cmbMelt.Value,'Melt',7)
		m.lcReceipt		= PrepareSQLtxt(ThisForm.edtReceipt.Value,'Receipt',-1)
		m.lcReceivedBy	= PrepareSQLtxt(ThisForm.ReceivedBy1.Value,'ReceivedBy',10)
		
		m.llDelivered	= PrepareSQLlogic(ThisForm.chkComplete.Value,'Complete')
		m.lnDelivered	= PrepareSQLbit(ThisForm.chkComplete.Value,'Complete')
		
		m.llCert		= PrepareSQLlogic(ThisForm.chkCert.Value,'Cert')
		m.lnCert		= PrepareSQLbit(ThisForm.chkCert.Value,'Cert')
		lnRandLen		= PrepareSQLbit(ThisForm.chkRandLen.Value,'RandLen')
		llRandLen		= PrepareSQLlogic(ThisForm.chkRandLen.Value,'RandLen')
		lnPrime			= PrepareSQLbit(ThisForm.chkPrime.Value,'Prime')
		llPrime			= PrepareSQLlogic(ThisForm.chkPrime.Value,'Prime')
		
		PRIVATE m.lnID			&& Int
		m.lnID			= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID < 1
			nReceivingID = ThisForm.ReceivingID
		ENDIF
		
		llMarkInvDate = PrepareSQLchk( ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.T.)
		
		PRIVATE nRMA_Detail
		nRMA_Detail = PrepareSQLnum(ThisForm.nRMA_Detail,'RMA_Detail',-3)
		
		*IF nRMA_Detail > 0
		*	ThisForm.txtWhatDo.Value = "ADD"
		*	ThisForm.txtWhatDo.Value = "RETURN"
		*ENDIF
		
		IF EMPTY( m.lcForm )
			ThisForm.cmbForm.Value = "10"
			m.lcForm = '10'
		ENDIF
		
		PRIVATE cPUnit, nAcct_PU, cUnitByForm, cPriceUnitByForm
		cPUnit  = GetPUfromForm(lcForm, ThisForm.nConnHandle)
		nAcct_PU	= PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
		cUnitByForm	= GetUNITfromFORM(m.lcForm, ThisForm.nConnHandle)
		cPriceUnitByForm = GetPRICEUNITfromFORM(m.lcForm, ThisForm.nConnHandle)
		
		m.lnS_Total	= m.lnS_P * m.lnS_QTY
		m.lnS_PU	= GetPUfromForm(lcForm, ThisForm.nConnHandle)
		
		
		***********************************
		*ThisForm.TableName
		DO CASE
		CASE UPPER(ThisForm.txtTableName1.Value) = "STOCKLST"
			ThisForm.cTBL = "S"
		CASE UPPER(ThisForm.txtTableName1.Value) = "BROKERLST"
			ThisForm.cTBL = "B" 
		CASE UPPER(ThisForm.txtTableName1.Value) = "WIPLST"
			ThisForm.cTBL = "W"
		OTHERWISE
			TrackError("No table name.","No Table", PROGRAM(), LINENO(1) )
		ENDCASE
		
		
		PRIVATE m.llcPOStatus
		m.lcPOStatus = "P" &&Partial
		IF m.lldelivered
			*Complete
			m.lcPOStatus = "W" &&Waiting for Bill - ACCOUNTANTS
		ENDIF
		
		**************************************************
		IF m.lnID = 0 
			*** Insert or Update?
			
			*Check ReceivingID
			PRIVATE cSQL 
			*dbo.StockLst_Detail dbo.BrokerLst_Detail
			cSQL = "SELECT COUNT(*) AS [CNTD] FROM "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID=M.ID "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID=M.ID "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID=M.ID "
			ENDCASE
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
			cSQL = cSQL + " AND M.HEAT = '"+ALLTRIM(IIF(ISNULL(m.lcHeat)," ",m.lcHeat))+"'"
			  
			IF USED("tmpC_Master")
				SELECT tmpC_Master
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpC_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpC_Master')
			ELSE
				IF tmpC_Master.CNTD = 0
					*Not Found
					ThisForm.txtWhatDo.Value = "ADD"
				ELSE
					*Found
					IF UPPER(ALLTRIM(ThisForm.txtWhatDo.Value)) = "EDIT"
						*Already Edit
					ELSE
						*Might Wish to Edit instead of ADD?
						
			*			IF MESSAGEBOX("Are you sure you want to ADD this?"+CHR(13)+"This POitem "+ALLTRIM(m.lcPO_Item)+" and Heat# "+m.lcHeat+" already exist!"+CHR(13)+"Answer Yes if this PO has mutiple receives and you need mutiple stock entries."+CHR(13)+"Answer No to Update/Overwrite the current record.",4+32,"Found Similiar") = 6
							*Already set to Add
							*ThisForm.txtWhatDo.Value = "ADD"				
			*			ELSE
						IF nRMA_Detail > 0
							ThisForm.txtWhatDo.Value = "RETURN"
						ELSE
							ThisForm.txtWhatDo.Value = "EDIT"
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF EMPTY(ThisForm.txtWhatDo.Value)
				ThisForm.txtWhatDo.Value = "EDIT"
			ENDIF
		ENDIF
		
		*********************
		*		cSQL = "SELECT COUNT(*) FROM dbo."+ALLTRIM(ThisForm.txtTableName1.Value)
		*		cSQL = cSQL + "_Master WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+ThisFormSet.RecvStockPOitem+"')"
		
		IF THISFORM.txtWhatDo.Value = "EDIT"
			IF m.lnID = 0
				IF MESSAGEBOX("This Save is set to EDIT."+CHR(13)+"There is no ID to Edit!"+CHR(13)+"Do you want to set to Add?"+CHR(13)+"Edit will fail to save any data.",4+32,"Create new since cannot Edit?")=7 THEN
					ThisForm.txtWhatDo.Value = "ADD"
					TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+" EDIT was Changed to ADD. "+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"!")
				ELSE
					*edit  
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.txtWhatDo.Value = "RETURN"
			ThisForm.txtWhatDo.Value = "ADD" 
			*nRMA_Detail > 0
			
		*	IF m.lnID = 0
		*		IF MESSAGEBOX("This Save is set to Return."+CHR(13)+"There is no ID to Edit!"+CHR(13)+"Do you want to set to Add?"+CHR(13)+"Edit will fail to save any data.",4+32,"Create new since cannot Edit?")=7 THEN
		*			ThisForm.txtWhatDo.Value = "ADD"
		*			TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+" EDIT was Changed to ADD. "+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"!")
		*		ELSE
		*			*edit  
		*		ENDIF
		*	ENDIF
		ENDIF
		
		
		
		PRIVATE lInsertStock, lOverRideAdd
		lInsertStock = .F.
		lOverRideAdd = .F.
		
		IF UPPER(ALLTRIM(ThisForm.txtWhatDo.Value)) = "ADD" 
			*Double check, PO may be edited, but Stock has been deleted - PO not found in StockLst.
			*If found in Received and Deleted in History- Do not Add back to StockLst!
			
			IF USED("tmpStockLst_MasterH")
				SELECT tmpStockLst_MasterH
			ELSE
				SELECT 0
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS CNTD FROM "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL + " dbo.Ar_Stocklst_Detail_History "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL + "  dbo.Ar_BrokerLst_Detail_History "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL + "  dbo.Ar_WIPlst_Detail_History "
			ENDCASE
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
			*cSQL = cSQL + " AND [WHAT]='DELETE'"
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_MasterH")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_MasterH")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpStockLst_MasterH')
				*MESSAGEBOX("Could not Check Master History."+CHR(13)+"Cannot Save to "+ALLTRIM(ThisForm.txtTableName1.Value),0+16,"SQL Error")
				ThisForm.txtWhatDo.Value = "NoADD"
			ELSE
				IF USED('tmpStockLst_MasterH')
					
					IF tmpStockLst_MasterH.Cntd = 0
						lInsertStock = .T.
					ELSE
						IF nRMA_Detail = 0
							IF MESSAGEBOX("This save wants to ADD to the "+IIF(ThisForm.cTBL="S","StockLst","BrokerLst")+"."+CHR(13)+"History shows this 'Receiving ID' has already created a stock Listing!"+CHR(13)+CHR(13)+"Are you sure you want to ADD this stock?",4+32+256,"You can force a StockLst ADD") = 6
								lInsertStock = .T.
								lOverRideAdd = .T.
								TrackMess("User Overide to Receive 2 Stock:"+ALLTRIM(m.lcPO_Item)+", Added to StockTable='"+ThisForm.cTBL+"'"+" Receiving ID="+ALLTRIM(STR(nReceivingID))+" when archive history exists." )
							ELSE
								lInsertStock = .F.
								THISFORM.txtWhatDo.Value = "NoADD"
								*** There is a time when History does not thave the ReceivingID ***
							ENDIF
						ELSE
							lInsertStock = .T.
							*Not sure what to do
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***********************************************
		
		*!*	IF UPPER(ALLTRIM(ThisForm.txtWhatDo.Value)) = "RETURN"
		*!*		*Check for ID in current Stock
		*!*		IF USED("tmpStockLst_MasterH")
		*!*			SELECT tmpStockLst_MasterH
		*!*		ELSE
