	PROCEDURE LBLSPECS1.Click
		PRIVATE cSQL, nSQLEXEC, lOK, m.POitem
		lOK = .T.
		m.POitem = ''
		
		IF Proper_PO_item(ThisForm.POitem) = Proper_PO_item('')
			m.POitem = Proper_PO_item(ThisForm.PO_ITEM1.Value)
			IF Proper_PO_item(m.POitem) <> Proper_PO_item('')
				ThisForm.POitem = m.POitem
			ENDIF
		ENDIF
		
		IF Proper_PO_item(ThisForm.POitem) <> Proper_PO_item('')
			*dbo.StockLst_Master dbo.BrokerLst_Master
			cSQL = "SELECT specs FROM dbo."+ALLTRIM(ThisForm.txtTableName1.Value)+"_Master "
			cSQL = cSQL + " WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+m.POitem+"')"
			*Like '%"+ALLTRIM(THISFORM.POitem)+"'"
			*"+ThisForm.TableName+"
			IF USED("tmpLst_Master")
				SELECT tmpLst_Master
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpLst_Master')
				lOK = .F.
			ELSE
				IF USED("tmpLst_Master")
					IF NOT EMPTY(tmpLst_Master.specs)
						IF MESSAGEBOX("PO "+ALLTRIM(ThisForm.POItem)+" was written to the Spec:"+CHR(13)+tmpLst_Master.specs+CHR(13)+"Do you want to overwrite current Spec ?",4+48,"Spec on PO") = 6
							ThisForm.SPECS1.Value = tmpLst_Master.specs
						ELSE
							lOK = .F.
						ENDIF					
					ELSE
						lOK = .F.
					ENDIF
				ELSE
					lOK = .F.
				ENDIF
			ENDIF
		ENDIF
		
		******
		IF NOT lOK AND Proper_PO_item(ThisForm.POitem) <> Proper_PO_item('')
		
			cSQL = "SELECT [specs] FROM dbo.Receiving"
			cSQL = cSQL + " WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+m.POitem+"')"
		
			IF USED("tmpLst_Master")
				SELECT tmpLst_Master
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpLst_Master')
				lOK = .F.
			ELSE
				IF USED("tmpLst_Master")
					IF NOT EMPTY(tmpLst_Master.specs)
						IF MESSAGEBOX("Receiving for PO: '"+ALLTRIM(ThisForm.POItem)+"' was written to the Spec:"+CHR(13)+tmpLst_Master.specs+CHR(13)+"Do you want to overwrite current Spec ?",0+48,"Spec on Receiving") = 6
							ThisForm.SPECS1.Value = tmpLst_Master.specs
						ELSE
							lOK = .F.
						ENDIF		
					ELSE
						lOK = .F.
					ENDIF
				ELSE
					lOK = .F.
				ENDIF
			ENDIF
		ENDIF
		
		******
		IF ThisForm.nWO_Detail > 0
		
			*dbo.StockLst_Master dbo.BrokerLst_Master
			cSQL = "SELECT ISNULL(fSpec,'') AS Spec FROM dbo.WorkOrder_Detail "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
			
			IF USED("tmpLst_Master")
				SELECT tmpLst_Master
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpLst_Master')
				lOK = .F.
			ELSE
				IF USED("tmpLst_Master")
					IF RECCOUNT("tmpLst_Master") > 0
						IF NOT EMPTY(tmpLst_Master.specs)
							IF MESSAGEBOX("Work Order Detail "+ALLTRIM(STR(ThisForm.nWO_Detail))+" was written to the Spec:"+CHR(13)+tmpLst_Master.specs+CHR(13)+"Do you want to overwrite current Spec? (Y)",4+48,"Spec on WO") = 6
								ThisForm.SPECS1.Value = tmpLst_Master.specs
							ELSE
								lOK = .F.
							ENDIF					
						ELSE
							lOK = .F.
						ENDIF
					ELSE
						lOK = .F.
					ENDIF
				ELSE
					lOK = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*******
		IF USED("tmpLst_Master")
			USE IN tmpLst_Master
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE lblStkDate.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.STKDATE1.Value)
			dDate1 = ThisForm.STKDATE1.Value 
		ELSE
			dDate1 = DATE()+10
		ENDIF
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.STKDATE1.Value = dDate2
		
	ENDPROC

	PROCEDURE lblWeight.Click
		*CalcWeight function dbo.f_GetWeight
		*PROC CalcWeight 
		PRIVATE nWeight, nPieces, cAlloy, cForm, nThickness, nSize2, nSize3
		nPieces	= PrepareSQLnum(ThisForm.PC1.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.AlloY1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		nThickness = PrepareSQLnum(ThisForm.Dim11.Value,'DIM1',10,4)
		nSize2	= PrepareSQLnum(ThisForm.Dim21.Value,'DIM2',9,3)
		nSize3	= PrepareSQLnum(ThisForm.Dim31.Value,'DIM3',9,3)
		
		nWeight = CalcWeight(nPieces, cAlloy, cForm, nThickness, nSize2, nSize3, ThisForm.nConnHandle)
		IF cForm = '80'
			nCalcWeight = CalcWeightDisk(nPieces, cAlloy, cForm, nThickness, nSize2, nSize3, ThisForm.nConnHandle)
		ENDIF
		
		IF nWeight > 0
			PRIVATE nOldWeight
			nOldWeight = PrepareSQLnum(ThisForm.txtLBS.Value,'Weight',9,1)
			
			IF nOldWeight <= 0
				ThisForm.txtLBS.Value = nWeight
			ELSE
				IF MESSAGEBOX("Do you want to replace the old Weight "+ALLTRIM(STR(nOldWeight,7,1))+CHR(13)+"with Calculated weight "+ALLTRIM(STR(nWeight,7,1))+" ?",4+32,"Replace?") = 6
					ThisForm.txtLBS.Value = nWeight
				ENDIf
			ENDIF
		ENDIF
		
		ThisForm.txtLBS.Refresh
	ENDPROC

	PROCEDURE MILL1.Init
		**Initialize Mill
		cSQL = "SELECT DISTINCT MILL FROM dbo.StockLst_Master "
		IF USED("tmpMills")
			SELECT tmpMills
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMills')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMills')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMills")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMills")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpMills')
		ELSE
			SELECT tmpMills
			INDEX ON Mill TAG mill
		ENDIF
		
	ENDPROC

	PROCEDURE MILL1.InteractiveChange
		lnInsertionPt = IIF(this.SelStart=0,10,this.SelStart)
		lcSearchStr = substr(this.value,1,lnInsertionPt)
		IF !empty(lcSearchStr)
				=seek(upper(lcSearchStr),"tmpMills","MILL")
				IF found("tmpMills")
					this.VALUE=tmpMills.MILL
					=insmode(.f.)
				ELSE
					this.value=lcSearchStr
					=insmode(.t.)
				ENDIF
		ELSE &&ThisValue is empty
			this.value=space(0)
		ENDIF
		this.selstart = lnInsertionPt
		
	ENDPROC

	PROCEDURE MILL1.LostFocus
		=insmode(.T.)
	ENDPROC

