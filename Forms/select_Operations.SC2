	PROCEDURE Init
		PARAMETERS pnOper_ID 
		*DO FORM Forms\Select_Operations WITH nOper_ID TO nReturnOper_ID
		
		PRIVATE nOper_ID
		nOper_ID = 0
		
		IF VARTYPE(pnOper_ID) = 'N'
			nOper_ID = pnOper_ID
		ENDIF
		
		IF nOper_ID > 0
		
			SELECT tmpOper_ID
			LOCATE FOR Oper_ID = nOper_ID
		
		ENDIF
		
		ThisForm.grdWO.RecordSource = 'tmpOper_ID'
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLstringCONNECT()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpOper_ID")
			USE IN tmpOper_ID
		ENDIF
		SELECT 0
		
		cSQL = " SELECT rtrO.*, OTj.Sched_Type "
		cSQL=cSQL+" FROM dbo.rtr_Operation rtrO WITH(NOLOCK) "
		*cSQL=cSQL+"--INNER JOIN dbo.OTracking_Job OTj ON rtrO.Oper_ID = OTj.Oper_ID" &&Use DISTINCT 
		cSQL=cSQL+" INNER JOIN (SELECT DISTINCT Oper_ID,Sched_Type FROM dbo.OTracking_Job WITH(NOLOCK) ) OTj ON rtrO.Oper_ID = OTj.Oper_ID "
		cSQL=cSQL+" ORDER BY Oper_ID "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOper_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOper_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOper_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOper_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpOper_ID' )
		ENDIF
		
		SELECT tmpOper_ID
		GO TOP
		IF RECCOUNT() > 8
			SKIP 8
		ENDIF
	ENDPROC

	PROCEDURE process_click
		*ThisForm.Process_Click()
		PRIVATE lChk1, lChk2, lChk3, lChk4, lChk5, lChk6, lChk7
		lChk1	= ThisForm.Check1.Value
		lChk2	= ThisForm.Check2.Value
		lChk3	= ThisForm.Check3.Value
		lChk4	= ThisForm.Check4.Value
		lChk5	= ThisForm.Check5.Value
		lChk6	= ThisForm.Check6.Value
		lChk7	= ThisForm.Check7.Value
		
		IF (lChk1 = lChk2) AND (lChk2 = lChk3) AND (lChk3 = lChk4) AND (lChk4 = lChk5) AND (lChk5 = lChk6) AND (lChk6 = lChk7)
			*Do for All
			IF lChk1 
				*All are Checked
			
			ELSE
				*none are Checked
				SELECT tmpOper_ID
				SET FILTER TO
			ENDIF
		ELSE
			** go down list to find check or uncheck
			cFilterStr = ''
			IF lChk1 = 1
				cFilterStr = 'JobClassID=1'
			ENDIF
			IF lChk2 = 1
				cFilterStr = 'JobClassID=2'
			ENDIF
			IF lChk1 = 1
				cFilterStr = 'JobClassID=3'
			ENDIF
				
				
				
			SET FILTER TO &(cFilterStr)
			ThisForm.grdWO.Refresh
			
		ENDIF
	ENDPROC

	PROCEDURE refreshscreen
		ThisForm.txtOperation.Refresh
		ThisForm.txtOper_ID.Refresh
		ThisForm.txtJobClass.Refresh
		ThisForm.txtJobType.Refresh
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaH, nDeltaW
		nDeltaH = ThisForm.Height - 328
		nDeltaW = ThisForm.Width - 398
		
		*ThisForm.grdWO.Height	= 226 + nDeltaH 
		ThisForm.grdWO.Width	= 393 + nDeltaW
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpOper_ID')
			USE IN tmpOper_ID
		ENDIF
		
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN THISFORM.nReturn
	ENDPROC

