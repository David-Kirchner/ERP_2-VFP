	PROCEDURE cmdAdd.Click
		*Insert
		PRIVATE cJobDescription,nMaintenanceID,cJobClass,cJobType,nMachine,cOperation
		cJobDescription = 'Hand straighten'
		nMaintenanceID = 134 &&Last+1
		cJobClass	= 'Machining  '
		cJobType	= 'Hand straighten'
		nMachine	= 0
		cOperation	= cJobType
		
		*INSERT INTO HPAlloy.Router.dbo.rtr_Operation (Operation,jobClass,jobType) VALUES ('Hand straighten','Machining  ','Hand straighten')
		*INSERT INTO dbo.NR_OrderTrackingJob (jobDescription,MaintenanceID,jobClass,jobType,Machine) VALUES ('Hand straighten',134,'Machining  ','Hand straighten',0)
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.nReturn = 0
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdFind.Click
		PRIVATE nWO
		nWO = PrepareSQLnum(this.Parent.txtOrder.Value,'WO',-3)
		
		IF nWO > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR WO = nWO 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No WO")
				GO BOTTOM
			ENDIF
			ThisForm.grdWO.Refresh
			ThisForm.RefreshScreen()
		ELSE
			WAIT WINDOW "Enter Operation to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		
		PRIVATE nOper_ID
		nOper_ID = PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',-3)
		
		ThisForm.nReturn = nOper_ID
		
		ThisForm.Release
		
		
	ENDPROC

	PROCEDURE grdWO.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshScreen
	ENDPROC

	PROCEDURE txtOrder.Valid
		PRIVATE nWO
		nWO = PrepareSQLnum(this.Parent.txtOrder.Value,'WO',-3)
		
		IF nWO > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR WO = nWO 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
			ENDIF
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

