	PROCEDURE checkdatafile
		*ThisForm.CheckDataFile()
		
		DO CASE
		CASE ThisForm.DataFile = 1
			*SELECT NamesADC
		CASE ThisForm.DataFile = 2
			*SELECT PurchaseADC
		CASE ThisForm.DataFile = 3
			*ForeignMail
			*SELECT COUNT(*) FROM Mail!ForeignMail INTO ARRAY aCountRec
		CASE ThisForm.DataFile = 4
			*NACE2003
			IF USED('NACE2003')
				SELECT NACE2003
			ELSE
				MESSAGEBOX("No Data",0+16,"Go back to tab 'Data File'")
				RETURN .F.
			ENDIF
		ENDCASE
		
		RETURN .T.
	ENDPROC

	PROCEDURE countrecords
		*ThisForm.CountRecoreds()
		PRIVATE nRecCount 
		nRecCount = 0
		
		PRIVATE nBADC,nEADC
		nBADC = PrepareSQLnum(ThisForm.Pageframe1.pgOrder.txtBADC.Value,'BADC',3,0)
		nEADC = PrepareSQLnum(ThisForm.Pageframe1.pgOrder.txtEADC.Value,'EADC',3,0)
		
		
		IF nEADC = 0
			ThisForm.Pageframe1.pgOrder.txtRecords.Value = 0
			MESSAGEBOX("Ending ADC cannot be 0",0+48,"Change ADC")
			RETURN
		ENDIF
		
		IF nBADC > nEADC 
			ThisForm.Pageframe1.pgOrder.txtRecords.Value = 0
			MESSAGEBOX("Ending ADC cannot be greater than Beginning",0+48,"Change ADC")
			RETURN
		ENDIF
		
		ThisForm.MousePointer=11
		
		DO CASE
		CASE ThisForm.DataFile = 1
		
			ThisForm.LoadData("NamesADC")
		
			IF USED('NamesADC')
				SELECT NamesADC
				nRecCount = RECCOUNT('NamesADC')	
			ENDIF
		
		CASE ThisForm.DataFile = 2
			*SELECT PurchaseADC
		CASE ThisForm.DataFile = 3
			*ForeignMail
			*SELECT COUNT(*) FROM Mail!ForeignMail INTO ARRAY aCountRec
		CASE ThisForm.DataFile = 4
			*NACE2003
			IF USED('NACE2003')
				SELECT NACE2003
				nRecCount = RECCOUNT('NACE2003')	
			ENDIF
		ENDcase
		
		ThisForm.Pageframe1.pgOrder.txtRecords.Value = nRecCount 
		
		ThisForm.MousePointer=0
	ENDPROC

	PROCEDURE Destroy
		RELEASE PbADC,PeADC
	ENDPROC

	PROCEDURE Init
		thisform.LabelForm = ""
		thisform.DataFile = 0
		
		PUBLIC PbADC,PeADC
		PbADC = "  0"
		PeADC = "999"
		
		ThisForm.Pageframe1.pgOrder.txtBADC.Value = PbADC
		ThisForm.Pageframe1.pgOrder.txtEADC.Value = PeADC
		
		
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF	
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		ThisForm.Open_MailHistory()
		
		
		
	ENDPROC

	PROCEDURE loaddata
		PARAMETERS pTable
		*ThisForm.LoadData("NamesADC")
		
		IF VARTYPE(pTable) != "C"
			RETURN
		ENDIF
		
		PRIVATE nBADC, nEADC
		nBADC = PrepareSQLnum(ThisForm.Pageframe1.pgOrder.txtBADC.Value,'BADC',3,0)
		nEADC = PrepareSQLnum(ThisForm.Pageframe1.pgOrder.txtEADC.Value,'EADC',3,0)
		
		DO CASE
		CASE UPPER(pTable) = "NAMESADC"
			IF USED('NamesADC')
				USE IN NamesADC
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			IF nBADC = 0 AND nEADC = 999
				*Skip the WHERE
				cSQL = "SELECT *, Mail.dbo.ZipADC(Zip) AS ADC FROM [MAIL].[dbo].[Names] ORDER BY ADC"
			ELSE
				*Add ADC limits
				cSQL = "SELECT *, Mail.dbo.ZipADC(Zip) AS ADC FROM [MAIL].[dbo].[Names]"
				cSQL = cSQL + " WHERE Mail.dbo.ZipADC(Zip) >= "+STR( nBADC )
				cSQL = cSQL + " AND Mail.dbo.ZipADC(Zip) <= "+STR(nEADC)
				cSQL = cSQL + " ORDER BY ADC"
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'NamesADC')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'NamesADC' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'NamesADC' )
			ENDIF
		
			IF USED('NamesADC')	
			
			ENDIF
			
		ENDCASE
	ENDPROC

	PROCEDURE open_mailhistory
		thisform.Pageframe1.pgHistory.grdHist.RecordSource = ''
		IF USED('MailHistory')
			USE IN MailHistory
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM [MAIL].[dbo].[MailHistory] "
		cSQL = cSQL + " ORDER BY [pdate] DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'MailHistory')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'MailHistory' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
		ENDIF
		
		IF USED('MailHistory')
		
			INDEX ON pdate DESCENDING TAG pdate
			SET ORDER TO TAG pdate
			GO TOP
		
			thisform.Pageframe1.pgHistory.grdHist.RecordSource = "MailHistory"
		ELSE
			
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('Names')
			USE IN Names
		ENDIF
		IF USED('purchase')
			USE IN purchase
		ENDIF
		IF USED('MailHistory')
			USE IN MailHistory 
		ENDIF
		IF USED('NACE2003')
			USE IN NACE2003
		ENDIF
		
		*USES Private Data Sesion
		CLOSE DATABASES ALL
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE Pageframe1.pgDataFile.cmdGdatabase.cmdForeign.Valid
		ThisForm.DataFile = This.Parent.Value
		This.Parent.Parent.txtDataFile.Value = "Foreign"
		This.Parent.Parent.txtDataFile.Refresh
		This.Parent.Parent.Parent.pgLBLformat.lblDataFile.Caption = "Foreign"
		
	ENDPROC

	PROCEDURE Pageframe1.pgDataFile.cmdGdatabase.cmdNace2003.Valid
		
		IF USED('NACE2003')
			USE IN NACE2003
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM [MAIL].[dbo].[NACE2003_Select] "
		cSQL = cSQL + " ORDER BY PostalCode "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'NACE2003')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'NACE2003' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'NACE2003' )
		ENDIF
		
		IF USED('NACE2003')
		
			ThisForm.DataFile = This.Parent.Value
			This.Parent.Parent.txtDataFile.Value = "NACE2003"
			This.Parent.Parent.txtDataFile.Refresh
			This.Parent.Parent.Parent.pgLBLformat.lblDataFile.Caption = "NACE2003"
			This.parent.parent.parent.pgOrder.SetFocus
			This.parent.parent.parent.pgOrder.click
			
		ELSE
			This.Parent.Parent.txtDataFile.Value = "Not Found!"
			This.Parent.Parent.txtDataFile.Refresh
			This.Parent.Parent.Parent.pgLBLformat.lblDataFile.Caption = ""
		ENDIF
		
		
		
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgDataFile.cmdGdatabase.cmdNames.Valid
		
		
		
		ThisForm.DataFile = This.Parent.Value
		This.Parent.Parent.txtDataFile.Value = "Names"
		This.Parent.Parent.txtDataFile.Refresh
		This.Parent.Parent.Parent.pgLBLformat.lblDataFile.Caption = "Names"
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgDataFile.cmdGdatabase.cmdPurchasing.Valid
		ThisForm.DataFile = This.Parent.Value
		This.Parent.Parent.txtDataFile.Value = "Purchasing"
		This.Parent.Parent.txtDataFile.Refresh
		This.Parent.Parent.Parent.pgLBLformat.lblDataFile.Caption = "Purchasing"
		
	ENDPROC

	PROCEDURE Pageframe1.pgDataFile.cmdNext.Click
		This.parent.parent.pgOrder.SetFocus
		
	ENDPROC

	PROCEDURE Pageframe1.pgFilter.Click
			DO CASE
			CASE ThisForm.DataFile = 1
				IF !USED('NAMESADC')
					USE NAMESADC IN 0
				ENDIF
				SELECT NAMESADC
			CASE ThisForm.DataFile = 2
				IF !USED('purchaseADC')
					USE purchaseADC IN 0
				ENDIF
				SELECT purchaseADC
			CASE ThisForm.DataFile = 3
				IF !USED('ForeignMail')
					USE ForeignMail IN 0
				ENDIF
				SELECT ForeignMail
			CASE ThisForm.DataFile = 4
				IF !USED('NACE2003')
					USE NACE2003 IN 0
				ENDIF
				SELECT NACE2003
			OTHERWISE
				MESSAGEBOX('Please choose a Data File First.',0,"No data file.")
			ENDCASE
		
	ENDPROC

	PROCEDURE Pageframe1.pgFilter.cmdNext.Click
		This.parent.parent.pgPrint.SetFocus
	ENDPROC

	PROCEDURE Pageframe1.pgLBLformat.cmdEditLabel.Click
		
		IF ThisForm.CheckDataFile()
		
			IF !EMPTY(ThisForm.LabelForm)
				IF FILE(ThisForm.LabelForm)
					MODIFY LABEL (ThisForm.LabelForm) SAVE
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgLBLformat.cmdForm.Click
		IF ThisForm.CheckDataFile()
		
			PRIVATE tempDef
			tempdef = set("default")
		*!*		IF FILE(SYS(5)+SYS(2003) +"\ERPSetup.mem")
		*!*			RESTORE FROM (SYS(5)+SYS(2003) +"\ERPSetup.mem") ADDITIVE
		*!*		ENDIF
		*!*		IF FILE(SYS(5)+SYS(2003) +"\MEM\ERPSetup.mem")
		*!*			RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\ERPSetup.mem") ADDITIVE
		*!*		ENDIF
		
		
		
			ThisForm.LabelForm = GETfile("LBX","Reports","Select report ",1 )
			IF ThisForm.LabelForm <> ""
				*This.Caption = "Choose Form"
				ThisForm.LabelForm = ""
			ELSE
				*This.Caption = ThisForm.LabelForm
			ENDIF
		
			SET DEFAULT TO (tempDef)
			ThisForm.Refresh
			This.Parent.Refresh
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgLBLformat.cmdNewLabel.Click
		IF ThisForm.CheckDataFile()
			PRIVATE tempDef
			tempDef = set("default")
		*!*		IF FILE(SYS(5)+SYS(2003) +"\ERPSetup.mem")
		*!*			RESTORE FROM (SYS(5)+SYS(2003) +"\ERPSetup.mem") ADDITIVE
		*!*			
		*!*		ENDIF
		
		
		
			MODIFY LABEL ? SAVE
		
			SET DEFAULT TO (tempDef)
			thisform.Refresh
			this.Parent.Refresh
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgLBLformat.cmdNewLabel.When
		IF ThisForm.DataFile = 0
			WAIT WINDOW "Choose a Data File First"
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgLBLformat.cmdNext.Click
		PRIVATE ctxtLabel
		ctxtLabel = This.parent.txtLabel.Value
		
		IF NOT EMPTY(cTxtLabel)
			This.parent.parent.pgFilter.SetFocus
		ELSE
			MESSAGEBOX("Please Choose a label format now.",0+48,"No label format")
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgOrder.Click
		ThisForm.CountRecords()
		
		IF ThisForm.DataFile = 3
			This.txtBADC.Enabled = .F.
			This.txtEADC.Enabled = .F.
		ELSE
			This.txtBADC.Enabled = .T.
			This.txtEADC.Enabled = .T.
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgOrder.cmdCountRecords.Click
		
		ThisForm.countrecords()
	ENDPROC

	PROCEDURE Pageframe1.pgOrder.cmdNext.Click
		This.parent.parent.pgLBLformat.SetFocus
		
	ENDPROC

	PROCEDURE Pageframe1.pgOrder.txtBADC.Valid
		IF ( VAL(ThisForm.Badc) >= VAL(ThisForm.Eadc) ) AND VAL(ThisForm.Eadc) > 0 
			WAIT WINDOW "Check your numbers"
		ELSE
			PbADC = This.Value
			ThisForm.CountRecords()
		ENDIF
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgOrder.txtEADC.Valid
		IF ThisForm.Badc >= ThisForm.Eadc	
			WAIT WINDOW "Check your numbers"
		ELSE
			PeADC = This.Value
			ThisForm.CountRecords()
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgPrint.cmdPPreview.Click
		IF ThisForm.CheckDataFile()
		
			IF FILE(ThisForm.LabelForm)
		
				
			****************************************
			* Views NamesADC and PurchaseADC use the PUBLIC bADC and eADC to filter
			* Select SQL can not use Filters!
			*	
			*	DO CASE
			*	CASE NOT EMPTY(ThisForm.BADC) AND NOT EMPTY(ThisForm.EADC)
			*		SET FILTER TO ADC > ThisForm.BADC AND ADC <  ThisForm.EADC
			*	CASE NOT EMPTY(ThisForm.BADC)
			*		SET FILTER TO ADC > ThisForm.BADC
			*	CASE NOT EMPTY(ThisForm.EADC)
			*		SET FILTER TO ADC <  ThisForm.EADC
			*	OTHERWISE
			*		*NO FILTER
			*		SET FILTER TO
			*	ENDCASE
				
				Label FORM (ThisForm.LabelForm) NEXT 30 PREVIEW
			ELSE
				MESSAGEBOX('Please choose a label format.',0,"No print label format.")
			ENDIF
		ELSE
			MESSAGEBOX('Please choose a Data File.',0,"No data file.")
		ENDIF
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgPrint.cmdPPreview.When
		RETURN ThisForm.LabelForm <> "Choose Form"
			
	ENDPROC

	PROCEDURE Pageframe1.pgPrint.cmdPrint.Click
		PRIVATE nRecfltrd, dbname
		nRecfltrd = 0
		dbname = ''
		
		IF ThisForm.CheckDataFile()
			dbname = ALIAS()
			IF FILE(ThisForm.LabelForm)
				COUNT TO nRecfltrd
				GO TOP
				
				IF nRecfltrd > 0
					Label FORM (ThisForm.LabelForm) TO PRINTER PROMPT NOCONSOLE
					
					
					GO TOP
							
					IF NOT EMPTY(SYS(2001, "FILTER"))
						SET FILTER TO
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "INSERT INTO [MAIL].[dbo].[MailHistory] (pdate,dbname,sadc,eadc,lblformat) VALUES ("
					cSQL = cSQL + " '"+DTOC(DATE())+"'"
					cSQL = cSQL + ",'"+dbname+"'"
					cSQL = cSQL + ",'"+ThisForm.Badc+"'"
					cSQL = cSQL + ",'"+ThisForm.Eadc+"'"
					cSQL = cSQL + ",'"+ThisForm.LabelForm+"'"
					cSQL = cSQL + ") "
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					ENDIF
				ELSE
					MESSAGEBOX('Records have been filtered out.'+CHR(13)+"Widen the ADC filter range!",0,"No records to print.")
				ENDIF
			ELSE
				MESSAGEBOX('Please choose a label format.',0,"No print label format.")
			ENDIF
		ELSE
			MESSAGEBOX('Please choose a Data File.',0,"No data file.")
		ENDIF
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgPrint.cmdPrint.When
		IF ThisForm.LabelForm = "Choose Form"
			WAIT WINDOW "Choose a Label Format" NOWAIT
			RETURN .F.
		ENDIF
		IF ThisForm.DataFile = 0
			WAIT WINDOW "Choose a Data File" NOWAIT
			RETURN .F.
		ENDIF
	ENDPROC

ENDDEFINE
