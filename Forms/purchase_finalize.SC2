		ThisFormSet.frmPOs.Visible = .F.
		ThisFormSet.frmRecentInv.Visible = .F.
		ThisFormSet.frmReceive.Visible = .F.
		
		ThisFormSet.frmSO.Visible = .T.
		
		ThisForm.txtID.Value = 1
		
		IF USED('tmpVIDunion')
			SELECT tmpVIDunion 
			DELETE IN tmpVIDunion 
			USE IN tmpVIDunion
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.cmdInvoiceSave.Click
		IF NOT ThisFormSet.CheckInvoiceSave()
			RETURN .F.
		ENDIF
		
		PRIVATE cPOItem,nItemTotal,nAcct_Qty,nAcct_P,Acct_PU,nPOrder_P,nPOrder_QTY
		PRIVATE nPO_OtherP, nPO_OtherP, nS_OtherP, cOtherFld
		PRIVATE cVendor_Invoice,nSubTotal,nFreight,nTotalAmount
		
		PRIVATE cSQL, nSQLEXEC, lFailTrans 
		lFailTrans = .F.
		PRIVATE nStockLstID
		PRIVATE nHPAPO
		
		ThisForm.Visible = .F.
		ThisFormSet.frmHPAPO.Visible = .F.
		ThisFormSet.frmPOs.Visible = .F.
		
		
		IF USED('tmpVendor_Invoice_ins')
			USE IN tmpVendor_Invoice_ins
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, cSQL1_Vendor_Invoice_ins 
		*= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && Manual transactions
		
		cVendor_Invoice	= PrepareSQLtxt(ThisForm.txtVendor_Invoice.Value,'Vendor_Invoice',50)
		nSubTotal		= PrepareSQLnum(ThisForm.txtSubTotal.Value,'SubTotal',10,4)
		nFreight		= PrepareSQLnum(ThisForm.txtFreight.Value,'Freight',10,4)
		nTotalAmount	= PrepareSQLnum(ThisForm.txtTotal.Value,'TotalAmount',10,4)
		cOtherFld		= PrepareSQLtxt(ThisForm.lblOtherFld.Caption,'OtherFld',10)
		nHPAPO			= PrepareSQLnum(ThisFormset.nHPAPO,'HPAPO',-3)
		
		PRIVATE lFirstRun
		lFirstRun = .T.
		
		************************************
		PRIVATE cSQL2_Update_PurchaseOrder, cSQL3_Insert_Vendor_Invoice_Detail 
		
		cSQL = "EXEC dbo.p_Vendor_Invoice_ins"
		cSQL = cSQL + " @Vendor_Invoice='"+cVendor_Invoice+"'"
		cSQL = cSQL + ",@HPAPO="+STR(nHPAPO)+""
		cSQL = cSQL + ",@SubTotal="+STR(nSubTotal,10,4)+""
		cSQL = cSQL + ",@Freight="+STR(nFreight,10,4)+""
		cSQL = cSQL + ",@TotalAmount="+STR(nTotalAmount,10,4)
		
		cSQL1_Vendor_Invoice_ins = cSQL
		
		
		************************************
		IF NOT lFailTrans
			SELECT tmpVIDunion
			GO TOP
			SCAN
		
				IF DELETED('tmpVIDunion')
					LOOP
				ENDIF
				
				cPOItem		= PrepareSQLtxt(tmpVIDunion.POItem,'POitem',12)
				nItemTotal	= PrepareSQLnum(tmpVIDunion.ItemTotal,'ItemTotal',-5)
				nAcct_P		= PrepareSQLnum(tmpVIDunion.Acct_P  ,'Acct_P',-5)
				nAcct_Qty	= PrepareSQLnum(tmpVIDunion.Acct_Qty,'Acct_QTY',-5)
				nAcct_PU	= PrepareSQLnum(tmpVIDunion.Acct_PU ,'PU',1,0)
				nAcct_OtherP= PrepareSQLnum(tmpVIDunion.Acct_OtherP,'OtherP',10,2)
				nPOrder_P	= PrepareSQLnum(tmpVIDunion.Order_P  ,'Order_P',-5)
				nPOrder_QTY	= PrepareSQLnum(tmpVIDunion.Order_QTY,'Order_QTY',-5)
				nPOrder_PU	= PrepareSQLnum(tmpVIDunion.Order_PU ,'Order_PU',-1)
				nPO_OtherP	= PrepareSQLnum(tmpVIDunion.Order_OtherP,'OtherP',10,2)
		
				IF LEN(cOtherFld) = 0
					cOtherFld	= PrepareSQLtxt(tmpVIDunion.OtherFld,'OtherFld',10)
				ENDIF
				
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " ReconcileTotal = "+STR(nItemTotal,10,4)
				cSQL = cSQL + ", Reconciled=1 "
				*IF nAcct_P > 0	&&Done in dbo.Vendor_Invoice_Detail 
				*	cSQL = cSQL + ", Rec_P = "+STR(nAcct_P,18,4)
				*ENDIF
				*IF nAcct_Qty > 0
				*	cSQL = cSQL + ", Rec_QTY = "+STR(nAcct_Qty,18,4)
				*ENDIF
				
		*!*			--do not over write data!!
		*!*			*IF EMPTY, UPDATE these P.Order_QTY, P.Order_P 
		*!*			IF nPOrder_P > 0
		*!*				cSQL = cSQL + ", Order_P = "+STR(nPOrder_P,18,4)
		*!*			ELSE
		*!*				cSQL = cSQL + ", Order_P = "+STR(nAcct_P,18,4)
		*!*			ENDIF
		*!*			IF nPOrder_QTY > 0
		*!*				cSQL = cSQL + ", Order_QTY = "+STR(nPOrder_QTY,18,4)
		*!*			ELSE
		*!*				cSQL = cSQL + ", Order_QTY = "+STR(nAcct_Qty,18,4)
		*!*			ENDIF
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				cSQL2_Update_PurchaseOrder = cSQL
				
				******************************************
				
				cSQL = "INSERT INTO dbo.Vendor_Invoice_Detail (Vendor_Invoice_ID, Recv_Qty, Recv_P, Recv_PU, Recv_OtherP"
				cSQL = cSQL + ", Order_QTY, Order_P, Order_PU, Order_OtherP, ItemTotal"
				cSQL = cSQL + ", POitem, Reconciled, OtherFld ) VALUES ("
				cSQL = cSQL + " nVendor_Invoice_ID " &&This keyword is substituted in FORM\Purchase_Finalize_Lst 
				cSQL = cSQL + ","+STR(nAcct_Qty,10,4)	&&ERP Accounting Standard
				cSQL = cSQL + ","+STR(nAcct_P,10,4)
				cSQL = cSQL + ","+STR(nAcct_PU,2)
				cSQL = cSQL + ","+STR(nAcct_OtherP,10,2)
				
				cSQL = cSQL + ","+STR(nPOrder_QTY,10,4) &&Order_QTY
				cSQL = cSQL + ","+STR(nPOrder_P,10,4) 
				cSQL = cSQL + ","+STR(nPOrder_PU,2) 
				cSQL = cSQL + ","+STR(nPO_OtherP,10,2)
				cSQL = cSQL + ","+STR(nItemTotal,10,4)
				
				cSQL = cSQL + ",'"+cPOitem+"'"
				cSQL = cSQL + ",1"
				cSQL = cSQL + ",'"+cOtherFld+"'"
				cSQL = cSQL + ")"
				
				cSQL3_Insert_Vendor_Invoice_Detail = cSQL
				
		
				******************************************
				PRIVATE lReturn
				
				IF NOT lFirstRun 
					*Only need to run Store Procedure, Vendor_Invoice Insert once!
					cSQL1_Vendor_Invoice_ins = STRTRAN(cSQL1_Vendor_Invoice_ins,"EXEC dbo.p_Vendor_Invoice_ins ","SELECT ID AS [EXP] FROM dbo.Vendor_Invoice WHERE ")
					cSQL1_Vendor_Invoice_ins = STRTRAN(cSQL1_Vendor_Invoice_ins,"@","")
					cSQL1_Vendor_Invoice_ins = STRTRAN(cSQL1_Vendor_Invoice_ins, "," , " AND ")
				ENDIF
				
				*loop thru all StockLst items created for this PO item
				DO FORM Forms\Purchase_Finalize_Lst WITH cPOitem, nPOrder_Qty, nPOrder_P, nItemTotal ;
					,cSQL1_Vendor_Invoice_ins, cSQL2_Update_PurchaseOrder, cSQL3_Insert_Vendor_Invoice_Detail  TO lReturn
				
		
				*******************************************
				
				IF VARTYPE(lReturn) != "L"
					lReturn = .F.
				ENDIF
				IF NOT lReturn
					lFailTrans =.T.
					EXIT
				ENDIF
				
				IF lReturn
					*lReturn = ThisFormSet.FinalizePO_Sales(cPOitem, nAcct_Qty, nAcct_P, nItemTotal)
					lReturn = ThisFormSet.FinalizePO_Sales(cPOitem)
				ENDIF
				
				
				*******************************************
				lFirstRun = .F.
				
				
				
			ENDSCAN
		ENDIF
		
		IF lFailTrans
			WAIT WINDOW "Rolling back changes now..." TIMEOUT 1
			*PurchaseOrder Reconciled
			ThisForm.Visible = .T.
			RETURN .F.
		ELSE
			*ThisForm.Visible = .F.
			ThisFormSet.Load_SO('REFRESH')
			ThisFormSet.frmHPAPO.Visible = .F.
			ThisFormSet.frmPOs.Visible = .F.
		
			ThisFormSet.frmSO.Visible = .T.
			RETURN .T.
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.cmdPOitemCheck.Click
		PRIVATE cHPAPOItem,cHPAPOItem2
		cHPAPOItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',13)
		cHPAPOItem2 = Proper_PO_item(cHPAPOItem)
		
		IF cHPAPOItem != cHPAPOItem2
			IF cHPAPOItem2 = Proper_PO_item('0-0')
				WAIT WINDOW "No PO Item " TIMEOUT 1
				RETURN
			ELSE
				IF MESSAGEBOX("Bad PO item"+CHR(13)+"Would you like to use POitem:"+cHPAPOItem2+"?",32,"Invalid")= 6
					ThisForm.txtPOitem.Value = Proper_PO_item(cHPAPOItem2)
					cHPAPOItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',13)
				ENDIF
			ENDIF
		ENDIF
		
		
		
		IF USED('tmpPO_QTY')
			USE IN tmpPO_QTY
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL= "SELECT StockLst_QTY, StockLst_P "
		cSQL= cSQL+" ,dbo.f_GetFormPU(Form) AS StockLst_PU "
		cSQL= cSQL+" ,Order_QTY, Order_P, Order_PU "
		cSQL= cSQL+" FROM dbo.PurchaseOrder "
		cSQL= cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cHPAPOItem +"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_QTY' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL, 'tmpPO_QTY' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_QTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_QTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_QTY')
		ENDIF
		
		PRIVATE nStockLst_QTY, nStockLst_P, nStockLst_PU
		nStockLst_QTY	= 0
		nStockLst_P		= 0
		nStockLst_PU	= 0
		PRIVATE nOrder_QTY, nSOrder_P, nOrder_PU
		nOrder_QTY	= 0
		nSOrder_P	= 0
		nOrder_PU	= 0
		
		IF USED('tmpPO_QTY')
			IF RECCOUNT('tmpPO_QTY')>0
				WAIT WINDOW "PO Item is good." TIMEOUT 1
			
		*!*			nStockLst_QTY	= PrepareSQLnum(tmpPO_QTY.StockLst_QTY,'StockLst_QTY',-5)
		*!*			nStockLst_P		= PrepareSQLnum(tmpPO_QTY.StockLst_P,'StockLst_P',-5)
		*!*			nStockLst_PU	= PrepareSQLnum(tmpPO_QTY.StockLst_PU,'StockLst_PU',-1)
		*!*			ThisForm.txtPO_QTY.Value = nStockLst_QTY
		*!*			ThisForm.txtPO_P.Value = ROUND(nStockLst_P, 4)
		*!*			ThisForm.txtPOitemTotal.Value = ROUND(nStockLst_QTY * nStockLst_P, 4) 
				
				
				nOrder_QTY	= PrepareSQLnum(tmpPO_QTY.Order_QTY,'Order_QTY',-5)
				nOrder_P	= PrepareSQLnum(tmpPO_QTY.Order_P,'Order_P',-5)
				nOrder_PU	= PrepareSQLnum(tmpPO_QTY.Order_PU,'Order_PU',-1)
		
				ThisForm.txtPO_QTY.Value = nOrder_QTY
				ThisForm.txtPO_P.Value = ROUND(nOrder_P, 4)
				ThisForm.txtPOitemTotal.Value = ROUND(nOrder_QTY * nOrder_P, 4) 
				
				UPDATE tmpVIDunion SET ;
					ItemTotal	= ROUND(nOrder_QTY * nOrder_P, 4) ,;
					Order_Qty	= nOrder_QTY,;
					Order_P		= nOrder_P,;
					Recnd = 0;
					WHERE POitem = cHPAPOItem 
		
				SELECT tmpVIDunion 
				LOCATE FOR POitem = cHPAPOItem 
				
				ThisFormSet.CalcTotal()
		
		
			ENDIF
			
			USE IN tmpPO_QTY
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.cmdSavePartial.Click
		RETURN .f.
		
		
		PRIVATE cPOItem,nItemTotal,nAcct_Qty,nOrder_P
		PRIVATE cVendor_Invoice,nSubTotal,nFreight,nTotalAmount
		PRIVATE nVendor_Invoice_ID
		nVendor_Invoice_ID = 0
		
		PRIVATE cSQL, nSQLEXEC, lFailTrans 
		lFailTrans = .F.
		PRIVATE nStockLstID
		PRIVATE nHPAPO
		
		ThisForm.Visible = .F.
		ThisFormSet.frmHPAPO.Visible = .F.
		ThisFormSet.frmPOs.Visible = .F.
		
		IF USED('tmpVendor_Invoice_ins')
			USE IN tmpVendor_Invoice_ins
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		*= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && Manual transactions
		
		cVendor_Invoice	=	 PrepareSQLtxt(ThisForm.txtVendor_Invoice.Value,'Vendor_Invoice',50)
		nSubTotal		=	 PrepareSQLnum(ThisForm.txtSubTotal.Value,'SubTotal',10,4)
		nFreight		=	 PrepareSQLnum(ThisForm.txtFreight.Value,'Freight',10,4)
		nTotalAmount	=	 PrepareSQLnum(ThisForm.txtTotal.Value,'TotalAmount',10,4)
		
		nHPAPO			= 	 PrepareSQLnum(ThisFormset.nHPAPO,'HPAPO',-3)
		
		cSQL = "EXEC dbo.p_Vendor_Invoice_ins "
		cSQL = cSQL + " @Vendor_Invoice='"+cVendor_Invoice+"'"
		cSQL = cSQL + ",@HPAPO="+STR(nHPAPO)+""
		cSQL = cSQL + ",@SubTotal="+STR(nSubTotal,10,4)+""
		cSQL = cSQL + ",@Freight="+STR(nFreight,10,4)+""
		cSQL = cSQL + ",@TotalAmount="+STR(nTotalAmount,10,4)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpVendor_Invoice_ins' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpVendor_Invoice_ins' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor_Invoice_ins")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVendor_Invoice_ins")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpVendor_Invoice_ins' )
			lFailTrans = .T.
		ENDIF	
		
		IF USED('tmpVendor_Invoice_ins')
			IF VARTYPE(tmpVendor_Invoice_ins.EXP) = 'N'
				nVendor_Invoice_ID = tmpVendor_Invoice_ins.EXP
			ENDIF
			USE IN tmpVendor_Invoice_ins
		ELSE
			lFailTrans = .T.
		ENDIF
		
		
		************************************
		IF NOT lFailTrans
		
			nSQLEXEC = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && Manual transactions
			
			SELECT tmpVIDunion
			GO TOP
			SCAN
		
				IF DELETED('tmpVIDunion')
					LOOP
				ENDIF
				
				cPOItem		= PrepareSQLtxt(tmpVIDunion.POItem,'POitem',12)
				nItemTotal	= PrepareSQLnum(tmpVIDunion.ItemTotal,'ItemTotal',-5)
				nAcct_Qty	= PrepareSQLnum(tmpVIDunion.Acct_Qty,'Acct_QTY',-5)
				nAcct_P		= PrepareSQLnum(tmpVIDunion.Acct_P,'Acct_P',-5)
				nAcct_PU	= PrepareSQLnum(tmpVIDunion.Acct_PU,'Acct_PU',-1)
				nAcct_OtherP= PrepareSQLnum(tmpVIDunion.Acct_OtherP,'OtherP',-5)
				
				nOrder_QTY	= PrepareSQLnum(tmpVIDunion.Order_QTY,'Order_QTY',-5)
				nOrder_P	= PrepareSQLnum(tmpVIDunion.Order_P,'Order_P',-5)
				nOrder_PU	= PrepareSQLnum(tmpVIDunion.Order_PU,'Order_PU',-1)
				
				nPO_OtherP	= PrepareSQLnum(tmpVIDunion.Acct_OtherP,'Acct_OtherP',10,2)
				cOtherFld	= PrepareSQLtxt(tmpVIDunion.OtherFld,'OtherFld',10)
				
				cSQL = "UPDATE dbo.PurchaseOrder SET ReconcileTotal =  "+STR(nItemTotal,10,4)
				cSQL = cSQL + ", Reconciled=0 "
				
		*		cSQL = cSQL + ", Rec_QTY = "+STR(0,18,4)
		*		cSQL = cSQL + ", Rec_P = "+STR(0,18,4)
				
				*cSQL = cSQL + ", StockLst_P = "+STR(nOrder_P,18,4)
				*cSQL = cSQL + ", StockLst_QTY = "+STR(nOrder_Qty,18,4)
		*!*			*IF EMPTY, UPDATE these P.Order_QTY, P.Order_P -------- Done when Reconciled = 1
		*!*			IF nOrder_P = 0
		*!*				cSQL = cSQL + ", Order_P = "+STR(nOrder_P,18,4)
		*!*			ENDIF
		*!*			IF nOrder_QTY = 0
		*!*				cSQL = cSQL + ", Order_QTY = "+STR(nOrder_Qty,18,4)
		*!*			ENDIF
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle )
					lFailTrans = .T.
				ENDIF	
				
				cSQL = "INSERT INTO dbo.Vendor_Invoice_Detail (Vendor_Invoice_ID, Acct_Qty, Acct_P, Acct_PU "
				cSQL = cSQL + ", Acct_OtherP "
				cSQL = cSQL + ", Order_QTY, Order_P, Order_PU, Order_OtherP "
				cSQL = cSQL + ", OtherFld, ItemTotal ,POitem, Reconciled) VALUES ("
				
				cSQL = cSQL + " "+STR(nVendor_Invoice_ID)
				cSQL = cSQL + ","+STR(nAcct_Qty,10,4)
				cSQL = cSQL + ","+STR(nAcct_P,10,4)
				cSQL = cSQL + ","+STR(nAcct_PU,2)
				cSQL = cSQL + ","+STR(nAcct_OtherP,10,4)
				
				cSQL = cSQL + ","+STR(nOrder_QTY,10,4)
				cSQL = cSQL + ","+STR(nOrder_P,10,4)
				cSQL = cSQL + ","+STR(nOrder_PU,2)
				cSQL = cSQL + ","+STR(nPO_OtherP,10,2)
				
				cSQL = cSQL + ",'"+cOtherFld+"'"
				cSQL = cSQL + ","+STR(nItemTotal,10,4)
				cSQL = cSQL + ",'"+cPOitem+"'"
				cSQL = cSQL + ",0)"
				
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle )
					lFailTrans = .T.
				ENDIF	
				
				*loop thru all StockLst items created for this PO item
				*DO FORM Forms\Purchase_Finalize_Lst WITH cPOitem, nAcct_Qty, nOrder_P, nItemTotal ;
				*	,cSQL1_Vendor_Invoice_ins, cSQL2_Update_PurchaseOrder, cSQL3_Insert_Vendor_Invoice_Detail  TO lReturn
		
			ENDSCAN
			
			IF lFailTrans
				= SQLROLLBACK(ThisFormSet.nConnHandle)
				WAIT WINDOW "Rolling back changes now..." TIMEOUT 1
				
				*Undo EXEC dbo.p_Vendor_Invoice_ins 
				cSQL = "DELETE FROM dbo.Vendor_Invoice WHERE ID="+STR(nVendor_Invoice_ID) 
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle )
				ENDIF
				
			ELSE
			
				= SQLCOMMIT(ThisFormSet.nConnHandle)
				WAIT WINDOW "Saving all changes now." TIMEOUT 1
				
			ENDIF
			= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
			
		ENDIF
		
			
		*ThisForm.Visible = .F.
		ThisFormSet.Load_SO('REFRESH')
		ThisFormSet.frmHPAPO.Visible = .F.
		ThisFormSet.frmPOs.Visible = .F.
		ThisFormSet.frmSO.Visible = .T.
	ENDPROC

	PROCEDURE frmVendor_Invoice.cmdSOitemBlank.Click
		IF This.Caption = "New"
			ThisForm.txtID.Value = 0
			ThisForm.txtPOitem.Enabled	= .T.
			*ThisForm.txtPOitem.Value	= ''
			*ThisForm.txtPO_QTY.Value	= 0
			*ThisForm.txtPO_P.Value	= 0
			ThisForm.txtPOItemTotal.Value	= 0
			ThisForm.txtS_Total.Value 		= 0
			This.Enabled = .F.
		*!*	ELSE
		*!*		*Save
		*!*		PRIVATE cPOitem,nAcct_Qty,nOrder_P,nPOitemTotal
		
		*!*		cPOitem = Proper_PO_Item(ThisForm.txtPOitem.Value)
		*!*		nAcct_Qty = PrePareSQLnum(ThisForm.txtPO_QTY.Value,'Order_Qty',10,2)
		*!*		nOrder_P = PrePareSQLnum(ThisForm.txtPO_P.Value,'Order_P',10,4)
		*!*		nPOitemTotal = ROUND(PrePareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4),4)
		
		*!*		IF nPOitemTotal = 0
		*!*			nPOitemTotal = nAcct_Qty * nOrder_P 
		*!*		ENDIF
		
		*!*		IF nAcct_Qty = 0 OR nOrder_P = 0 OR nPOitemTotal = 0
		*!*			MESSAGEBOX( "Please Complete [Units] and [Per Unit] and [Total]",0,"Cannot update without all numbers.")
		*!*			RETURN .F.
		*!*		ENDIF
		
		*!*		PRIVATE nPennyPerUnitError
		*!*		nPennyPerUnitError = nAcct_Qty * .01
		
		*!*		IF nPOitemTotal < ROUND(nAcct_Qty * nOrder_P,4)+nPennyPerUnitError  AND nPOitemTotal > ROUND(nAcct_Qty * nOrder_P,4)-nPennyPerUnitError 
		*!*			*Within tollerence
		*!*		ELSE
		*!*			MESSAGEBOX( "Total does not compute!",0,"Cannot save.")
		*!*			RETURN .F.
		*!*		ENDIF
		
		*!*		*****************
		*!*		*check cPOitem for errors
		*!*		PRIVATE nCountPOitem
		*!*		nCountPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
		*!*		IF nCountPOitem < 1
		*!*			MESSAGEBOX( "PO item:"+ALLTRIM(cPOitem)+" Does not exits!",0,"Cannot Update/Save.")
		*!*			RETURN .F.
		*!*		ENDIF
		
		*!*		IF ThisForm.txtPOitem.Enabled
		*!*			*This record cannot be Orig or Partial
		*!*			INSERT INTO tmpVIDunion (POitem,ItemTotal,Acct_Qty,Order_QTY,Recnd) VALUES (cPOitem,nPOitemTotal,nAcct_Qty,nOrder_P,0)
		*!*			ThisForm.txtPOitem.Enabled = .F.
		*!*			ThisFormSet.CalcTotal()
		*!*		ELSE
		*!*			IF tmpVIDunion.Total = -1
		*!*				MESSAGEBOX("You cannot edit this 'Partial' Invoice record.",48,"No Save")
		*!*				RETURN .F.
		*!*			ELSE
		*!*				UPDATE tmpVIDunion SET ;
		*!*					ItemTotal = nPOitemTotal,;
		*!*					Acct_Qty= nAcct_Qty,;
		*!*					Order_QTY = nOrder_QTY
		*!*					Recnd = 0;
		*!*					WHERE POitem = cPOitem 
		*!*					
		*!*				ThisFormSet.CalcTotal()
		*!*			ENDIF
		*!*		ENDIF
		
		
		
		
		*!*		*ThisForm.txtPOitem.Enabled	= .F.
		*!*		This.Caption = "New"
			
			ThisForm.txtPOitem.SetFocus
			
		ENDIF
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.cmdSOitemRemove.Click
		PRIVATE cPOitem,nID
		cPOitem = Proper_PO_Item(ThisForm.txtPOitem.Value)
		nID		= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		SELECT tmpVIDunion
		PRIVATE nCurrRec
		nCurrRec = RECNO('tmpVIDunion')
		
		IF tmpVIDunion.Recnd = 1
			IF MESSAGEBOX("Are you sure you want to remove this PO item from this Invoice? (Y)",4+48,"Remove PO item:"+ALLTRIM(cPOitem)+"?") = 6
				SELECT tmpVIDunion
				DELETE FOR POitem = cPOitem AND ID=nID
				
				
				IF nCurrRec > RECCOUNT('tmpVIDunion')
					GO BOTTOM
				ELSE
					GOTO nCurrRec
				ENDIF
				
				*ThisFormset.frmVendor_Invoice.grd_VI_Detail.RecordSource = 'tmpVIDunion'
				ThisFormset.frmVendor_Invoice.grd_VI_Detail.Refresh
		
				ThisFormSet.CalcTotal()
				ThisFormSet.RefreshVendorInvoice()
				
				*ThisFormSet.frmHPAPO.BackColor = RGB(255,128,128) &&Soft Red
				ThisFormSet.frmHPAPO.lblRemoved.Visible = .T.
			ENDIF
		ELSE
			IF tmpVIDunion.Recnd >= 0
				IF MESSAGEBOX( "Are you  sure you want to delete this?"+CHR(13)+"If this",4+32,"Delete") = 6
					SELECT tmpVIDunion
					DELETE FOR POitem = cPOitem AND ID=nID
		
				ENDIF
				
				IF nCurrRec > RECCOUNT('tmpVIDunion')
					GO BOTTOM
				ELSE
					GOTO nCurrRec
				ENDIF
		
				*ThisFormset.frmVendor_Invoice.grd_VI_Detail.RecordSource = 'tmpVIDunion'
				ThisFormset.frmVendor_Invoice.grd_VI_Detail.Refresh
		
				ThisFormSet.CalcTotal()
				ThisFormSet.RefreshVendorInvoice()
				ThisForm.cmdSOitemBlank.Enabled = .T.
			ELSE
				MESSAGEBOX("You cannot Delete this 'Partial' Invoice.",48,"No Delete")
			ENDIF
		ENDIF
		
		
		ThisForm.txtPOitem.Enabled = .F.
	ENDPROC

	PROCEDURE frmVendor_Invoice.cmdSOitemUpdate.Click
		
		PRIVATE nID,cPOitem
		nID 		= PrepareSQLnum(ThisForm.txtID.Value,'ID',-1)
		cPOitem 	= Proper_PO_Item(ThisForm.txtPOitem.Value)
		
		PRIVATE nOrder_QTY, nOrder_P, nOrder_PU
		nOrder_QTY	= PrepareSQLnum(ThisForm.txtPO_QTY.Value,'Order_Qty',-5)
		nOrder_P 	= PrepareSQLnum(ThisForm.txtPO_P.Value,'Order_P',-5)
		nOrder_PU 	= PrepareSQLnum(ThisForm.txtPU.Value,'Order_PU',-1)
		
		PRIVATE nPO_OtherP, nOtherP, cOtherFld
		nPO_OtherP	= PrepareSQLnum(ThisForm.txtOrder_OtherP.Value,'OtherP',10,2)
		nOtherP		= PrepareSQLnum(ThisForm.txtOtherP.Value,'OtherP',10,2)
		cOtherFld	= PrepareSQLtxt(ThisForm.lblOtherFld.Caption,'OtherFld',10)
		
		PRIVATE nPOitemTotal, nInvTotal
		nPOitemTotal = ROUND(PrePareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',-5),4)
		nInvTotal	= PrePareSQLnum(ThisForm.txtTotal.Value,'Total',-5)
		
		IF nPOitemTotal = 0
			nPOitemTotal = (nOrder_QTY * nOrder_P)+ nPO_OtherP
		ENDIF
		
		IF nOrder_QTY = 0 OR nOrder_P = 0 OR nPOitemTotal = 0
			MESSAGEBOX( "Please Complete [Units] and [Per Unit] and [Total]",0,"Cannot update without all numbers.")
			RETURN .F.
		ENDIF
		
		IF nPOitemTotal <> (nOrder_QTY * nOrder_P) + nPO_OtherP
			IF nOrder_QTY * nOrder_P > 0
				WAIT WINDOW "Replacing POitem Total as "+ALLTRIM(STR((nOrder_QTY * nOrder_P)+ nPO_OtherP,18,2)) NOWAIT
				nPOitemTotal = ( nOrder_QTY * nOrder_P )+ nPO_OtherP
				ThisForm.txtPOItemTotal.Value = PrepareSQLnum(nPOitemTotal, 'POitemTotal', 18,4)
			ENDIF
		ENDIF
		
		
		
		**********************************
		*Calculate Recv with new Totals
		PRIVATE nAcct_QTY, nAcct_P, nAcct_PU, nAcct_Total, nForm_PU
		nAcct_QTY = PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_Qty',-5)
		nAcct_P	= PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		nAcct_PU	= PrepareSQLnum(ThisForm.txtS_PU.Value,'S_PU',-1)
		*nRecv_PU = GetPUfrom_POitem(cPOitem,ThisFormSet.nConnHandle)
		
		nAcct_OtherP = PrepareSQLnum(ThisForm.txtS_OtherP.Value,'OtherP',10,2)
		
		nAcct_Total = ( nAcct_QTY * nAcct_P )+ nAcct_OtherP
		
		IF nAcct_Total * 1.01 < nPOitemTotal 
			MESSAGEBOX( "Total Vendor Vs ERP Acct Standard does not equal!",0,"Cannot save.")
			RETURN .F.
		ENDIF
		
		IF nAcct_Total * .99 > nPOitemTotal
			MESSAGEBOX( "Total Vendor Vs ERP Acct Standard does not equal!",0,"Cannot save.")
			RETURN .F.
		ENDIF
		
		**************************	
		PRIVATE nPennyPerUnitError
		nPennyPerUnitError = nOrder_QTY * .01
		
		IF nPOitemTotal < ROUND((nOrder_Qty * nOrder_P) +nPO_OtherP ,4)+nPennyPerUnitError  AND nPOitemTotal > ROUND((nOrder_Qty * nOrder_P) +nPO_OtherP,4)-nPennyPerUnitError 
			*Within tollerence
		ELSE
			MESSAGEBOX( "Total does not compute!"+CHR(13)+"Could be Rounding Error",0,"Cannot save.")
			RETURN .F.
		ENDIF
		
		
		*nInvTotal
		IF nInvTotal < ROUND((nOrder_Qty * nOrder_P) +nPO_OtherP,4)+nPennyPerUnitError  AND nInvTotal> ROUND((nOrder_Qty * nOrder_P) +nPO_OtherP,4)-nPennyPerUnitError 
			*totals Within tollerence
		ELSE
		
		ENDIF
		
		*****************
		*check cPOitem for errors
		PRIVATE nCountPOitem
		nCountPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
		IF nCountPOitem < 1
			MESSAGEBOX( "PO item:"+ALLTRIM(cPOitem)+" Does not exits!",0,"Cannot Update/Save.")
			RETURN .F.
		ENDIF
		
		IF ThisForm.txtPOitem.Enabled
			SELECT tmpVIDunion 
			nID = RECCOUNT('tmpVIDunion') + 1
			*This record cannot be Orig or Partial
			INSERT INTO tmpVIDunion (POitem,ItemTotal ;
				,Order_QTY, Order_P, Order_PU, PO_OtherP, OtherFld ;
			,Acct_Qty, Acct_P, Acct_PU, Acct_OtherP, Recnd, ID ) VALUES ;
			(cPOitem, nPOitemTotal ;
				,nOrder_QTY, nOrder_P, nOrder_PU ,nPO_OtherP, cOtherFld;
			,nAcct_QTY, nAcct_P, nAcct_PU, nAcct_OtherP, 0, nID )
			
			ThisForm.txtID.Value = nID
			
			ThisForm.txtPOitem.Enabled = .F.
		
			SELECT tmpVIDunion 
			LOCATE FOR POitem = cPOitem
			ThisForm.grd_VI_Detail.Refresh
		
			ThisFormSet.CalcTotal()
			
			ThisForm.cmdSOitemBlank.Enabled = .T.
			ThisForm.txtPOitem.Enabled = .F.
			
		ELSE
			SELECT tmpVIDunion
			
			IF tmpVIDunion.Recnd = -1 AND (tmpVIDunion.ItemTotal + tmpVIDunion.Acct_Qty + tmpVIDunion.Order_QTY ) > 0
				MESSAGEBOX("You cannot edit this 'Partial' Invoice record."+CHR(13)+"Only NULL ItemTotal would be updateable!",48,"No Save")
				RETURN .F.
		
				*Update if NULL
		*		ThisForm.grd_VI_Detail.RecordSource = ''
				
				UPDATE tmpVIDunion SET ItemTotal = nPOitemTotal ;
					, Order_QTY = nOrder_QTY, Order_P = nOrder_P, Order_PU = nOrder_PU;
					, Order_OtherP = nPO_OtherP, OtherFld = cOtherFld;
					, Acct_Qty = nAcct_QTY, Acct_P = nAcct_P, Acct_PU = nAcct_PU, Acct_OtherP = nPO_OtherP ;
					, Recnd = 0 ;
					 WHERE POitem = cPOitem AND ID = nID
					
				SELECT tmpVIDunion 
				LOCATE FOR POitem = cPOitem
				ThisForm.grd_VI_Detail.Refresh
				
				ThisFormSet.CalcTotal()
				ThisForm.cmdSOitemBlank.Enabled = .T.
						
			ENDIF
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.grd_VI_Detail.AfterRowColChange
		LPARAMETERS nColIndex
		*grd_VI_Detail.AfterRowColChange()
		
		ThisFormSet.RefreshVendorInvoice()
		
		ThisForm.txtPOitem.Enabled = .F.
		
		ThisFormSet.ShowHPAPO()
		
		
		DO CASE
		CASE tmpVIDunion.Recnd = 1
			ThisForm.shpPOitemBox.BackColor = RGB(128,255,255) &&Light Blue
			*(255,128,128) &&Soft Red
		CASE tmpVIDunion.Recnd = -1
			ThisForm.shpPOitemBox.BackColor = RGB( 0,128,128 ) &&Green
		CASE tmpVIDunion.Recnd = 0
			ThisForm.shpPOitemBox.BackColor = RGB(128,128,128)  &&Med Grey
		ENDCASE
		
		IF DELETED('tmpVIDunion')
		*	ThisFormSet.frmHPAPO.BackColor = RGB(255,128,128) &&Soft Red
			ThisFormSet.frmVendor_Invoice.txtPO_QTY.Enabled = .F.
			ThisFormSet.frmVendor_Invoice.txtPO_P.Enabled = .F.
			ThisFormSet.frmVendor_Invoice.txtPO_OtherP.Enabled = .F.
			ThisFormSet.frmVendor_Invoice.txtPOitemTotal.Enabled = .F.
			ThisFormSet.frmVendor_Invoice.txtAddTotal.Enabled = .F.
			
			ThisFormSet.frmHPAPO.lblRemoved.Visible = .T.
		ELSE
		*	ThisFormSet.frmHPAPO.BackColor = RGB(240,240,240)  &&Stnd Grey
			ThisFormSet.frmVendor_Invoice.txtPO_QTY.Enabled = .T.
			ThisFormSet.frmVendor_Invoice.txtPO_P.Enabled = .T.
			ThisFormSet.frmVendor_Invoice.txtPO_OtherP.Enabled = .T.
			ThisFormSet.frmVendor_Invoice.txtPOitemTotal.Enabled = .T.
			ThisFormSet.frmVendor_Invoice.txtAddTotal.Enabled = .T.
		
			ThisFormSet.frmHPAPO.lblRemoved.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.grd_VI_Detail.Column2.Text1.Valid
		ThisFormSet.CalcTotal()
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.grd_VI_Detail.Deleted
		LPARAMETERS nRecNo
		
		IF DELETED('tmpVIDunion')
			ThisFormSet.frmHPAPO.lblRemoved.Visible = .T.
		ELSE
			ThisFormSet.frmHPAPO.lblRemoved.Visible = .F.	
		ENDIF
		
		ThisFormset.frmVendor_Invoice.grd_VI_Detail.Refresh
		ThisFormSet.CalcTotal()
				
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.Init
		
		ThisForm.txtVendor_Invoice.Value	= PrepareSQLtxt('','Vendor_Invoice',50)
		ThisForm.txtSubTotal.Value	= PrepareSQLnum(0,'SubTotal',10,4)
		ThisForm.txtFreight.Value	= PrepareSQLnum(0,'Freight',10,4)
		ThisForm.txtTotal.Value		= PrepareSQLnum(0,'TotalAmount',10,4)
		ThisForm.lblOtherFld.Caption = PrepareSQLtxt('','OtherFld',10)
		
		ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value	= PrepareSQLnum(0,'Order_Qty',10,2)
		ThisFormSet.frmVendor_Invoice.txtPO_P.Value		= PrepareSQLnum(0,'Order_P',10,4)
		ThisFormSet.frmVendor_Invoice.txtPO_OtherP.Value	= PrepareSQLnum(0,'OtherP',10,2)
		ThisFormSet.frmVendor_Invoice.txtPOItemTotal.Value	= PrepareSQLnum(0,'ItemTotal',10,4)
		
		ThisFormSet.frmVendor_Invoice.txtS_QTY.Value	= PrepareSQLnum(0,'S_QTY',-5)
		ThisFormSet.frmVendor_Invoice.txtS_P.Value		= PrepareSQLnum(0,'S_P',-5)
		ThisFormSet.frmVendor_Invoice.txtS_OtherP.Value	= PrepareSQLnum(0,'OtherP',10,2)
		ThisFormSet.frmVendor_Invoice.txtS_Total.Value	= PrepareSQLnum(0,'S_Total',-5)
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.Label1.Click
		*!*	PRIVATE nOrder_P, nPOitemTotal, nOrder_Qty 
		
		*!*	nOrder_P = PrePareSQLnum(ThisForm.txtPO_P.Value,'Order_P',10,4)
		*!*	nPOitemTotal = PrePareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		*!*	IF nOrder_P > 0 AND nPOitemTotal > 0
		*!*		nOrder_Qty = nPOitemTotal / nOrder_P
		*!*		ThisForm.txtPO_QTY.Value = nOrder_Qty 
		*!*	ENDIF
		
		*!*	PRIVATE nS_P, nS_Qty 
		*!*	nS_P = PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		
		*!*	IF nS_P > 0 AND nPOitemTotal > 0
		*!*		nS_QTY = PrepareSQLnum( nPOitemTotal / nS_P ,'S_QTY',-5 )
		*!*		ThisForm.txtS_QTY.Value = nS_QTY
		*!*	ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblDifference.Click
		ThisFormSet.CalcTotal()
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblPerUnit.Click
		PRIVATE nPO_Qty,nOtherP,nOrder_P,nPOitemTotal
		
		nPO_Qty = PrePareSQLnum(ThisForm.txtPO_QTY.Value,'Order_Qty',10,2)
		nOtherP = PrepareSQLnum(ThisForm.txtOtherP.Value,'OtherP',-5)
		
		nPOitemTotal = PrePareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		IF nPO_Qty > 0 AND nPOitemTotal > 0
			nOrder_P = (nPOitemTotal-nOtherP ) / nPO_Qty 
			ThisForm.txtPO_P.Value = nOrder_P
		ENDIF
		
		PRIVATE nS_P, nS_Qty 
		nS_QTY = PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		
		IF nS_QTY > 0 AND nPOitemTotal > 0
			nS_P = PrepareSQLnum(( nPOitemTotal-nOtherP) / nS_QTY ,'S_P',-5 )
			ThisForm.txtS_P.Value = nS_P
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblPOitem.Click
		PRIVATE cHPAPOItem,cHPAPOItem2
		cHPAPOItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',13)
		cHPAPOItem2 = Proper_PO_item(cHPAPOItem)
		
		IF cHPAPOItem != cHPAPOItem2
			IF cHPAPOItem2 = Proper_PO_item('0-0')
				WAIT WINDOW "No PO Item " TIMEOUT 1
				RETURN
			ELSE
				IF MESSAGEBOX("Bad PO item"+CHR(13)+"Would you like to use POitem:"+cHPAPOItem2+"?",32,"Invalid")= 6
					ThisForm.txtPOitem.Value = Proper_PO_item(cHPAPOItem2)
					cHPAPOItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',13)
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_POitem(cHPAPOItem ,.T.) &&lReturnURL --not URL is an HTML code.
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblPOitemTotal.Click
		PRIVATE nOrder_Qty, nOrder_P, nPO_OtherP, nPOitemTotal, nPO_Tot
		nOrder_Qty	= PrepareSQLnum(ThisForm.txtPO_QTY.Value,'Order_Qty',10,2)
		nOrder_P	= PrepareSQLnum(ThisForm.txtPO_P.Value,'Order_P',10,4)
		nPO_OtherP	= PrepareSQLnum(ThisForm.txtPO_OtherP.Value,'Other_P',10,2)
		nPOitemTotal = PrePareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		*PRIVATE nOrder_Tot, nS_Tot
		*nOrder_Tot	= ( nOrder_Qty * nOrder_P )+ nPO_OtherP
		*nS_Tot		= ( nS_Qty * nS_P )+ nS_OtherP
		
		IF nOrder_Qty > 0 AND nOrder_P > 0
			nPO_Tot = ROUND((nOrder_Qty * nOrder_P)+ nPO_OtherP ,4)
			ThisForm.txtPOItemTotal.Value = nPO_Tot
			*nPOitemTotal 
		ENDIF
		
		************************
		PRIVATE nS_Qty, nS_P, nOtherP, nHPA_Total, nS_Total
		nS_Qty	= PrepareSQLnum(ThisForm.txtS_QTY.Value,'Order_Qty',10,2)
		nS_P	= PrepareSQLnum(ThisForm.txtS_P.Value,'Order_P',10,4)
		nOtherP	= PrepareSQLnum(ThisForm.txtS_OtherP.Value,'Other_P',10,2)
		nHPA_Total = PrepareSQLnum(ThisForm.txtS_Total.Value,'HPAtot',10,4)
		
		IF nS_Qty > 0 AND nS_P > 0
			nS_Total = ROUND((nS_Qty * nS_P)+ nOtherP ,4)
			ThisForm.txtS_Total.Value = nS_Total
			*nHPA_Total 
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblPOPerUnit.Click
		PRIVATE cPOItem
		cPOItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',13)
		*cPOitem = Proper_PO_Item(ThisForm.txtPOitem.Value)
		
		
		IF USED('tmpPOitemPU')
			USE IN tmpPOitemPU
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT StockLst_P,StockLst_QTY "
		cSQL = cSQL + ",dbo.f_GetFormPU(Form) AS StockLst_PU "
		cSQL = cSQL + ",Order_P, Order_QTY, Order_PU "
		*cSQL = cSQL + ",dbo.f_GetFormUnit(Form) AS FormUnit "
		cSQL = cSQL + ",dbo.f_GetFormUnitPrice(form) AS FormUnit "
		cSQL = cSQL + ",Services, ConvServ, Equipment,[Pieces],Pounds "
		cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE POitem = '"+cPOitem+"'"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemPU')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemPU')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemPU")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemPU")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpPOitemPU' )
		ENDIF
		
		PRIVATE nStockLst_P, nStockLst_QTY, nStockLst_PU, nOrder_P, nOrder_QTY, nOrder_PU
		nStockLst_P = 0
		nStockLst_QTY = 0
		nStockLst_PU = 0
		nOrder_P	= 0
		nOrder_QTY	= 0
		nOrder_PU	= 0
		
		PRIVATE lServices, lConvServ, lEquipment, nPieces, nPounds
		lServices = .F.
		lConvServ = .F.
		lEquipment = .F.
		nPieces = 0
		nPounds = 0
		
		IF USED('tmpPOitemPU')
			IF RECCOUNT('tmpPOitemPU') > 0
				nStockLst_P = PrepareSQLnum(tmpPOitemPU.StockLst_P,'StockLst_P',-5)
				nStockLst_QTY = PrepareSQLnum(tmpPOitemPU.StockLst_QTY,'StockLst_QTY',-5)
				nStockLst_PU= PrepareSQLnum(tmpPOitemPU.StockLst_PU,'StockLst_PU',-1)
				
				nOrder_P 	= PrepareSQLnum(tmpPOitemPU.Order_P,'Order_P',-5)
				nOrder_QTY 	= PrepareSQLnum(tmpPOitemPU.Order_QTY,'Order_QTY',-5)
				nOrder_PU 	= PrepareSQLnum(tmpPOitemPU.Order_PU,'Order_PU',-1)
				
				lServices 	= PrepareSQLlogic(tmpPOitemPU.Services,'Services')
				lConvServ	= PrepareSQLlogic(tmpPOitemPU.ConvServ,'ConvServ')
				lEquipment	= PrepareSQLlogic(tmpPOitemPU.Equipment,'Equipment')
				
				nPieces		= PrepareSQLnum(tmpPOitemPU.Pieces,'Pieces',-5)
				nPounds		= PrepareSQLnum(tmpPOitemPU.Pounds,'Pounds',-5)
			ENDIF
			USE IN tmpPOitemPU
		ENDIF
		
		*****************************
		*Use the Order by Units, not StockLst Accounting Units
		
		IF nOrder_P = 0
			WAIT WINDOW "No Order Price Found!" NOWAIT
			RETURN
		ENDIF
		IF nOrder_P > 0
			ThisForm.txtPO_P.Value = nOrder_P 
			*ThisForm.txtPO_QTY.Value = nOrder_QTY 
			PRIVATE cText
			
			cText = "Information:"+CHR(13)
			cText = cText+ Remove0(nOrder_QTY,10,2)+" "+ALLTRIM(STR(nOrder_PU))+" @ "
			cText = cText+"$"+Remove0(nOrder_P,10,2)+" "+CHR(13)
			IF lServices 
				cText = cText + "this Services allows LOT price"+CHR(13)
			ENDIF
			IF lConvServ
				cText = cText + "this Conversion Service allows LOT price"+CHR(13)
			ENDIF
			IF lEquipment
				cText = cText + "this Equipment purchase allows LOT price"+CHR(13)
			ENDIF
			
			IF nOrder_PU = 1
				*$\LB
				IF nOrder_QTY < 2
					IF nPounds > 2
						IF NOT ( lServices OR lConvServ OR lEquipment )
							cText = cText + CHR(13) + "Please Check Weight."
							cText = cText + CHR(13) + "PO shows "+Remove0(nPounds,7,1)+" Pounds"
							cText = cText + CHR(13) + "Units Need to be in Pounds!"
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF nOrder_PU = 2
				*$\Ft
				IF nOrder_QTY < 2
					IF NOT ( lServices OR lConvServ OR lEquipment )
						cText = cText + CHR(13) + "Please Check Length."
						cText = cText + CHR(13) + "Units Need to be in Feet!"
					ENDIF
				ENDIF
			ENDIF
			IF nOrder_PU = 3
				*$\PC
				IF nOrder_QTY < 2
					IF nPieces > 2
						IF NOT ( lServices OR lConvServ OR lEquipment )
							cText = cText + CHR(13) + "Please Check Pieces."
							cText = cText + CHR(13) + "PO shows "+Remove0(nPieces,7,1)+" Pieces"
							cText = cText + CHR(13) + "Units Need to be by PC!"
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF nOrder_PU = 4
				*$\PC
				IF nOrder_QTY > 1
		*			IF NOT ( lServices OR lConvServ OR lEquipment )
						cText = cText + CHR(13) + "Please Check Units."
						cText = cText + CHR(13) + "Units Need to be by LOT!"
						cText = cText + CHR(13) + "    1 LOT! " 
		*			ENDIF
				ENDIF
			ENDIF
			
			
		*	WAIT WINDOW cText NOWAIT
			MESSAGEBOX( cText, 64, "PO Item Price")
		ENDIF
		
		IF nStockLst_P > 0
			ThisForm.txtS_P.Value = nStockLst_P 
		ENDIF
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblPOunits.Click
		PRIVATE cPOItem
		cPOItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',13)
		*cPOitem = Proper_PO_Item(ThisForm.txtPOitem.Value)
		
		
		IF USED('tmpPOitemPU')
			USE IN tmpPOitemPU
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT StockLst_P,StockLst_QTY"
		cSQL = cSQL + ",dbo.f_GetFormPU(Form) AS StockLst_PU "
		cSQL = cSQL + ",Order_P, Order_QTY, Order_PU "
		*cSQL = cSQL + ",dbo.f_GetFormUnit(Form) AS FormUnit "
		cSQL = cSQL + ",dbo.f_GetFormUnitPrice(form) AS FormUnit "
		cSQL = cSQL + ",Services, ConvServ, Equipment,[Pieces],Pounds "
		cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE POitem = '"+cPOitem+"'"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemPU')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemPU')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemPU")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemPU")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpPOitemPU' )
		ENDIF
		
		PRIVATE nStockLst_P, nStockLst_QTY, nStockLst_P, nOrder_P, nOrder_QTY, nOrder_PU
		nStockLst_P = 0
		nStockLst_QTY = 0
		nStockLst_PU = 0
		nOrder_P	= 0
		nOrder_QTY	= 0
		nOrder_PU	= 0
		
		PRIVATE lServices, lConvServ, lEquipment, nPieces, nPounds
		lServices = .F.
		lConvServ = .F.
		lEquipment = .F.
		nPieces = 0
		nPounds = 0
		
		IF USED('tmpPOitemPU')
			IF RECCOUNT('tmpPOitemPU') > 0
				nStockLst_P = PrepareSQLnum(tmpPOitemPU.StockLst_P,'StockLst_P',-5)
				nStockLst_QTY = PrepareSQLnum(tmpPOitemPU.StockLst_QTY,'StockLst_QTY',-5)
				nStockLst_PU= PrepareSQLnum(tmpPOitemPU.StockLst_PU,'StockLst_PU',-1)
				
				nOrder_P 	= PrepareSQLnum(tmpPOitemPU.Order_P,'Order_P',-5)
				nOrder_QTY 	= PrepareSQLnum(tmpPOitemPU.Order_QTY,'Order_QTY',-5)
				nOrder_PU 	= PrepareSQLnum(tmpPOitemPU.Order_PU,'Order_PU',-1)
				
				lServices 	= PrepareSQLlogic(tmpPOitemPU.Services,'Services')
				lConvServ	= PrepareSQLlogic(tmpPOitemPU.ConvServ,'ConvServ')
				lEquipment	= PrepareSQLlogic(tmpPOitemPU.Equipment,'Equipment')
				
				nPieces		= PrepareSQLnum(tmpPOitemPU.Pieces,'Pieces',-5)
				nPounds		= PrepareSQLnum(tmpPOitemPU.Pounds,'Pounds',-5)
			ENDIF
			USE IN tmpPOitemPU
		ENDIF
		
		*****************************
		*Use the Order by Units, not StockLst Accounting Units
		
		
		IF nOrder_QTY = 0
			WAIT WINDOW "No Order QTY Found!" NOWAIT
			RETURN
		*!*		IF nOrder_QTY > 0
		*!*			nStockLst_QTY = nOrder_QTY 
		*!*		ENDIF
		ENDIF
		
		*!*	IF nStockLst_PU = nOrder_PU
		*!*		IF nStockLst_QTY*10 < nOrder_QTY 
		*!*			PRIVATE nMess
		*!*			nMess = MESSAGEBOX("StockLst_QTY is usually a large number."+CHR(13)+"StockLst QTY is "+ALLTRIM(STR(nStockLst_QTY))+CHR(13)+" Order_QTY is "+ALLTRIM(STR(nOrder_QTY))+CHR(13)+"Anwser Yes to keep the StockLst_QTY, No to keep the Order_QTY.",4+32,"Keep StockLst_Qty?")
		*!*			IF nMess = 7
		*!*				nStockLst_QTY = nOrder_QTY
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		IF nOrder_QTY > 0
			ThisForm.txtPO_QTY.Value = nOrder_QTY 
			
			PRIVATE cText
			cText = "Information:"+CHR(13)
			cText = cText+ Remove0(nOrder_QTY,10,2)+" "+ALLTRIM(STR(nOrder_PU))+" @ "
			cText = cText+"$"+Remove0(nStockLst_P,10,2)+" "+CHR(13)
				
			IF lServices 
				cText = cText + "this Services allows LOT price"+CHR(13)
			ENDIF
			IF lConvServ
				cText = cText + "this Conversion Service allows LOT price"+CHR(13)
			ENDIF
			IF lEquipment
				cText = cText + "this Equipment purchase allows LOT price"+CHR(13)
			ENDIF
			
			IF nOrder_PU = 1
				*$\LB
				IF nOrder_QTY < 2
					IF nPounds > 2
						IF NOT ( lServices OR lConvServ OR lEquipment )
							cText = cText + CHR(13) + "Please Check Weight."
							cText = cText + CHR(13) + "PO shows "+Remove0(nPounds,7,1)+" Pounds"
							cText = cText + CHR(13) + "Units Need to be in Pounds!"
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF nOrder_PU = 2
				*$\Ft
				IF nOrder_QTY < 2
					IF NOT ( lServices OR lConvServ OR lEquipment )
						cText = cText + CHR(13) + "Please Check Length."
						cText = cText + CHR(13) + "Units Need to be in Feet!"
					ENDIF
				ENDIF
			ENDIF
			IF nOrder_PU = 3
				*$\PC
				IF nOrder_QTY < 2
					IF nPieces > 2
						IF NOT ( lServices OR lConvServ OR lEquipment )
							cText = cText + CHR(13) + "Please Check Pieces."
							cText = cText + CHR(13) + "PO shows "+Remove0(nPieces,7,1)+" Pieces"
							cText = cText + CHR(13) + "Units Need to be by PC!"
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF nOrder_PU = 4
				*$\PC
				IF nOrder_QTY > 1
		*			IF NOT ( lServices OR lConvServ OR lEquipment )
						cText = cText + CHR(13) + "Please Check Units."
						cText = cText + CHR(13) + "Units Need to be by LOT!"
						cText = cText + CHR(13) + "    1 LOT! " 
		*			ENDIF
				ENDIF
			ENDIF
		
		*	WAIT WINDOW cText NOWAIT
			MESSAGEBOX( cText, 64, "PO Item Price")
		ENDIF
		
		IF nStockLst_QTY > 0
			ThisForm.txtS_QTY.Value = nStockLst_QTY
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblReceive.Click
		*Retreives from Receiving
		ThisFormSet.ShowReceiveTot()
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblSum_QTY.Click
		*!*	PRIVATE nOrder_P, nPOitemTotal, nOrder_Qty 
		
		*!*	nOrder_P = PrePareSQLnum(ThisForm.txtPO_P.Value,'Order_P',10,4)
		*!*	nPOitemTotal = PrePareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		*!*	IF nOrder_P > 0 AND nPOitemTotal > 0
		*!*		nOrder_Qty = nPOitemTotal / nOrder_P
		*!*		ThisForm.txtPO_QTY.Value = nOrder_Qty 
		*!*	ENDIF
		
		*!*	PRIVATE nS_P, nS_Qty 
		*!*	nS_P = PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		
		*!*	IF nS_P > 0 AND nPOitemTotal > 0
		*!*		nS_QTY = PrepareSQLnum( nPOitemTotal / nS_P ,'S_QTY',-5 )
		*!*		ThisForm.txtS_QTY.Value = nS_QTY
		*!*	ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblUnits.Click
		PRIVATE nOrder_P, nPOitemTotal, nOrder_Qty 
		
		nOrder_P = PrePareSQLnum(ThisForm.txtPO_P.Value,'Order_P',10,4)
		nPOitemTotal = PrePareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		IF nOrder_P > 0 AND nPOitemTotal > 0
			nOrder_Qty = nPOitemTotal / nOrder_P
			ThisForm.txtPO_QTY.Value = nOrder_Qty 
		ENDIF
		
		PRIVATE nS_P, nS_Qty 
		nS_P = PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		
		IF nS_P > 0 AND nPOitemTotal > 0
			nS_QTY = PrepareSQLnum( nPOitemTotal / nS_P ,'S_QTY',-5 )
			ThisForm.txtS_QTY.Value = nS_QTY
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblVendorFreight.Click
		PRIVATE nSubTotal,nFreight,nInvoiceTotal
		
		nSubTotal	= PrepareSQLnum(ThisForm.txtSubTotal.Value,'SubTotal',10,2)
		*nFreight	= PrepareSQLnum(ThisForm.txtFreight.Value,'Freight',10,2)
		nInvoiceTotal	= PrepareSQLnum(ThisForm.txtTotal.Value,'Total',10,2)
		
		IF nSubTotal > 0 AND nInvoiceTotal > 0
			nFreight = nInvoiceTotal - nSubTotal
			ThisForm.txtFreight.Value = nFreight 
			ThisFormSet.CalcTotal()
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblVendorSubTotal.Click
		PRIVATE nSubTotal,nFreight,nInvoiceTotal
		
		*nSubTotal	= PrepareSQLnum(ThisForm.txtSubTotal.Value,'SubTotal',10,2)
		nFreight	= PrepareSQLnum(ThisForm.txtFreight.Value,'Freight',10,2)
		nInvoiceTotal	= PrepareSQLnum(ThisForm.txtTotal.Value,'Total',10,2)
		
		IF nFreight > 0 AND nInvoiceTotal > 0
			nSubTotal = nInvoiceTotal - nFreight
			ThisForm.txtSubTotal.Value = nSubTotal
			ThisFormSet.CalcTotal()
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.lblVendorTotal.Click
		PRIVATE nSubTotal,nFreight,nInvoiceTotal
		
		nSubTotal	= PrepareSQLnum(ThisForm.txtSubTotal.Value,'SubTotal',10,2)
		nFreight	= PrepareSQLnum(ThisForm.txtFreight.Value,'Freight',10,2)
		*nInvoiceTotal	= PrepareSQLnum(ThisForm.txtTotal.Value,'Total',10,2)
		
		IF nSubTotal > 0 AND nFreight > 0
			nInvoiceTotal = nSubTotal + nFreight
			ThisForm.txtTotal.Value = nInvoiceTotal
			ThisFormSet.CalcTotal()
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtAddTotal.LostFocus
		PRIVATE nAdd
		nAdd = PrepareSQLnum( This.Value, 'AddToTotal',18,4)
		
		IF nAdd <> 0
			PRIVATE nPOitemTotal	
			nPOitemTotal = PrepareSQLnum(ThisForm.txtPOitemTotal.Value,'POitemTotal',18,4)
			
			PRIVATE nPO_QTY, nPO_P
			nPO_Qty		= PrepareSQLnum(ThisForm.txtPO_QTY.Value,'Order_QTY',10,2)
			nPO_P	= PrepareSQLnum(ThisForm.txtPO_P.Value,'Order_P',18,4)
			
			IF nPOitemTotal = 0
				*Check to see if Unit*PerUnit is there
				IF nPO_Qty * nPO_P > 0
					nPOitemTotal = nPO_Qty * nPO_P
					ThisForm.txtPOitemTotal.Value = nPOitemTotal 
				ENDIF
			ENDIF
			
			
			ThisForm.txtPOitemTotal.Value = nPOitemTotal + nAdd
			ThisForm.txtPOitemTotal.Refresh
			
			IF nPO_Qty > 0
				nPO_P = 	 ( nPOitemTotal + nAdd ) / nPO_Qty
				ThisForm.txtPO_P.Value = nPO_P
				ThisForm.txtPO_P.Refresh
			ENDIF
			
			This.Value = 0
			
			ThisFormSet.CalcTotal()
			
			*ThisForm.cmdSOitemUpdate.SetFocus
			ThisForm.cmdSOitemUpdate.Click
			
		*	ThisForm.Setfocus()
			
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtFreight.Valid
		ThisFormSet.CalcTotal()
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtPOitem.Valid
		ThisFormSet.CheckPOitem()
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtPOitemTotal.DblClick
		This.Value = PrepareSQLnum(ThisForm.txtSubTotal.Value,'Total',-5)
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtPO_QTY.DblClick
		PRIVATE nOrder_P, nPOitemTotal, nOrder_QTY 
		
		nOrder_P = PrepareSQLnum(ThisForm.txtPO_P.Value,'Order_P',10,4)
		nPOitemTotal = PrepareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		IF nOrder_P > 0 AND nPOitemTotal > 0
			nOrder_QTY = nPOitemTotal / nOrder_P
			This.Value = nOrder_QTY
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtSubTotal.Valid
		ThisFormSet.CalcTotal()
		
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtS_P.DblClick
		PRIVATE nS_P, nOtherP, nPOitemTotal, nS_Qty 
		
		nS_QTY = PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		nOtherP = PrepareSQLnum(ThisForm.txtOtherP.Value,'OtherP',-5)
		nPOitemTotal = PrepareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		IF nS_QTY > 0 AND nPOitemTotal > 0
			nS_P = PrepareSQLnum( (nPOitemTotal-nOtherP ) / nS_QTY ,'S_P',-5 )
			This.Value = nS_P
			
			ThisForm.txtS_Total.Value = nPOitemTotal 
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtS_QTY.DblClick
		PRIVATE nS_P, nPOitemTotal, nS_Qty 
		
		nS_P = PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		nPOitemTotal = PrepareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		IF nS_P > 0 AND nPOitemTotal > 0
			nS_QTY = PrepareSQLnum( nPOitemTotal / nS_P ,'S_QTY',-5 )
			This.Value = nS_QTY
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtS_QTYtot.DblClick
		PRIVATE nS_P, nPOitemTotal, nS_Qty 
		
		nS_P = PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		nPOitemTotal = PrepareSQLnum(ThisForm.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		IF nS_P > 0 AND nPOitemTotal > 0
			nS_QTY = PrepareSQLnum( nPOitemTotal / nS_P ,'S_QTY',-5 )
			This.Value = nS_QTY
		ENDIF
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtS_Total.DblClick
		This.Value = PrepareSQLnum(ThisForm.txtSubTotal.Value,'Total',-5)
	ENDPROC

	PROCEDURE frmVendor_Invoice.txtVendor_Invoice.Valid
		IF NOT EMPTY(This.Value)
			ThisFormSet.CalcTotal()
		ENDIF
	ENDPROC

ENDDEFINE
