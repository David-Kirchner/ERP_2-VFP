	PROCEDURE toinvoice_totals
		*ThisFormSet.ToInvoice_Totals()
		
		*SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Weight,M.Form,'S' AS LST,D.CostValue,D.RandLen,D.InvoiceValue, 0.0000 AS Units, 0.0000 AS IDDetailUnits, 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal"
		
		PRIVATE cUnits
		PRIVATE nDetailTotal
		PRIVATE cSQL, nSQLEXEC
		
		PRIVATE nID_Detail, cSQL_Insert, cSQL_PODiff, cSQL_Sold
		PRIVATE nInsertWeight, nInsertPC
		PRIVATE nPODiffWeight, nPODiffPC
		PRIVATE nSoldWeight, nSoldPC
		PRIVATE nStartWeight,nStartPC
		
		SELECT tmpToInvoice
		SCAN
			nInsertWeight	= 0
			nInsertPC		= 0
			nPODiffWeight	= 0
			nPODiffPC		= 0
			nSoldWeight		= 0
			nSoldPC			= 0
			nStartWeight	= 0
			nStartPC		= 0
			
			nID_Detail 		= tmpToInvoice.ID_Detail
			
			IF tmpToInvoice.Lst = "S"
				*StockLst_Process_GS_History needs to adjusted to be like StockLst_Process
				cSQL_Insert = "SELECT pWeight, pPc, S_QTY, S_P, S_PU FROM dbo.StockLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT] = 'INSERT' AND [Comment] = 'StockLst_Detail Insert'"
				cSQL_PODiff = "SELECT pWeight, pPc, S_QTY, S_P, S_PU FROM dbo.StockLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NULL"
				cSQL_Sold   = "SELECT SOitem, pWeight, pPc, S_QTY, S_P, S_PU FROM dbo.StockLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NOT NULL"
			ELSE
				cSQL_Insert = "SELECT pWeight, pPc, S_QTY, S_P, S_PU FROM dbo.BrokerLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT] = 'INSERT' AND [Comment] = 'BrokerLst_Detail Insert'"
				cSQL_PODiff = "SELECT pWeight, pPc, S_QTY, S_P, S_PU FROM dbo.BrokerLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NULL"
				cSQL_Sold   = "SELECT SOitem, pWeight, pPc, S_QTY, S_P, S_PU FROM dbo.BrokerLst_Process_GS_History WHERE ID_Detail = "+STR(nID_Detail)+" AND [WHAT]='UPDATE' AND SOitem IS NOT NULL"
			ENDIF	  
			
			IF USED('tmpInsert')
				USE IN tmpInsert
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_Insert, 'tmpInsert' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_Insert, 'tmpInsert' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Insert, "tmpInsert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Insert, "tmpInsert")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Insert, ThisFormSet.nConnHandle, 'tmpInsert' )
			ENDIF	
		
			IF USED('tmpInsert')
				IF VARTYPE(tmpInsert.pWeight) = "N"
					nInsertWeight = tmpInsert.pWeight
				ENDIF
				IF VARTYPE(tmpInsert.pPc) = "N"
					nInsertPc = tmpInsert.pPc
				ENDIF
				USE IN tmpInsert
			ENDIF
			**
			IF USED('tmpPODiff')
				USE IN tmpPODiff
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_PODiff, 'tmpPODiff' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_PODiff, 'tmpPODiff' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_PODiff, "tmpPODiff")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_PODiff, "tmpPODiff")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_PODiff, ThisFormSet.nConnHandle, 'tmpPODiff' )
			ENDIF	
		
			IF USED('tmpPODiff')
				IF VARTYPE(tmpPODiff.pWeight) = "N"
					nPODiffWeight = tmpPODiff.pWeight
				ENDIF
				IF VARTYPE(tmpPODiff.pPc) = "N"
					nPODiffPC = tmpPODiff.pPc
				ENDIF
				USE IN tmpPODiff
			ENDIF
			**
			IF USED('tmpSold')
				USE IN tmpSold
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_Sold, 'tmpSold' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_Sold, 'tmpSold' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Sold, "tmpSold")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Sold, "tmpSold")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Sold, ThisFormSet.nConnHandle, 'tmpSold' )
			ENDIF	
			
			************************************
			IF USED('tmpSold')
				PRIVATE cTalk 
				cTalk = SET('TALK')
				SET TALK OFF
				SELECT tmpSold
				IF VARTYPE(tmpSold.pWeight) = "N"
					*SELECT SUM(pWeight) AS nSoldWeight FROM tmpSold
					SUM pWeight TO nSoldWeight
				ENDIF
				IF VARTYPE(tmpSold.pPc) = "N"
		*			nSoldPC = tmpSold.pPc
					*SELECT SUM(pPc) AS nSoldPc FROM tmpSold
					SUM pPc TO nSoldPc 
				ENDIF		
				USE IN tmpSold
				IF cTalk = "ON"
					SET TALK ON
				ENDIF
			ENDIF
			**
			nStartWeight 	= nInsertWeight - nPODiffWeight
			nStartPC 		= nInsertPC - nPODiffPC
		
			ThisFormset.Finalize_Lst.txtIDDetailUnits.Value 	= nStartWeight
			
			nDetailTotal 						= nStartWeight * nStartPc
			SELECT tmpToInvoice
			REPLACE tmpToInvoice.Units WITH nStartWeight
			REPLACE tmpToInvoice.IDDetailUnits WITH nStartWeight
			
			*S_QTY,S_P,S_PU
		
		*D.InvoiceValue,IDDetailUnits,IDDetailPerUnit,IDDetailTotal 
		
		ENDSCAN
	ENDPROC

	PROCEDURE unload_finalize_lst
		*ThisFormSet.Unload_Finalize_Lst()
		
		IF USED('tmpToInvoice')
			USE IN tmpToInvoice
		ENDIF
		IF USED('tmpStockLstID')
			USE IN tmpStockLstID
		ENDIF
		IF USED('tmpPO_VI')
			USE IN tmpPO_VI
		ENDIF
		
		ThisFormset.Finalize_Lst.Visible = .F.
	ENDPROC

	PROCEDURE vid_dbc		&& Dynamic Background Color
		PRIVATE nColor
		*VID_DBC()
		*grdVI_Detail.clm.DynamicBackColor = ThisForm.VID_DBC()
		
		nColor = RGB( 255, 255, 255 ) &&WHITE
		ThisFormset.frmVendor_Invoice.grd_VI_Detail.Column2.BackColor = RGB( 255, 255, 255 ) &&WHITE
		DO CASE 
		CASE DELETED('tmpVIDunion')
			nColor = RGB( 255, 0, 0 ) &&RED
			ThisFormset.frmVendor_Invoice.grd_VI_Detail.Column2.BackColor = RGB( 255, 0, 0 ) &&RED
		CASE tmpVIDunion.Recnd = 0
			nColor = RGB( 128,128,128 ) &&Grey
		CASE tmpVIDunion.Recnd = -1
			nColor = RGB( 0,128,128 ) &&Green
		CASE tmpVIDunion.Recnd = 1
			nColor = RGB(255,128,128) &&Soft Red
		ENDCASE
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE frmHPAPO.cmdViewPOitem.Click
		PRIVATE cPOitem
		cPOitem = This.Caption 
		*"View PO:"
		cPOitem = SUBSTR(cPOitem, 9,13)
		cPOitem = Proper_PO_item(cPOitem)
		
		PRIVATE cText
		cText = get_Report_Server()+"%2fHPA+Purchasing+Reports%2fPurchaseOrders+POitem&rs:Command=Render&cHPAPOItem="
		cText = cText + cPOitem
		cText = cText + ""
		
		
		PRIVATE loHyperlink 
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cText)
		RELEASE loHyperlink 
	ENDPROC

	PROCEDURE frmHPAPO.spnPOitem.InteractiveChange
		PRIVATE nItemPO, nCntPOitem, cPOitem, nHPApo
		nItemPO = PrepareSQLnum(This.Value,'ItemPO',-1)
		nCntPOitem = PrepareSQLnum(ThisFormSet.frmHPAPO.txtPOcnt.Value,'POcnt',-3)
		nHPApo	= PrepareSQLnum(ThisFormSet.frmHPAPO.lblHPApo.Caption,'HPApo',-3)
		
		IF nItemPO > nCntPOitem 
			This.Value = nCntPOitem 
			WAIT WINDOW 'Bad Number' TIMEOUT 1
			RETURN .F.
		ENDIF
		IF nItemPO <=0
			This.Value = 1
			WAIT WINDOW 'Bad Number' TIMEOUT 1
			RETURN .F.
		ENDIF
		
		
		IF nItemPO >= 10
			cPOitem = STR(nHPApo)+"-" + STR(nItemPO)
		ELSE
			cPOitem = STR(nHPApo)+"-0" + STR(nItemPO)
		ENDIF
		cPOitem = Proper_PO_Item(cPOitem)
		
		ThisFormSet.ShowHPAPO(cPOitem)
	ENDPROC

