	PROCEDURE frmReceive.txtReceived.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE('dDate') = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmSO.cmdGetPO.Click
		
		PRIVATE nHPAPO
		nHPAPO = PrepareSQLnum(ThisForm.txtHPAPO.Value,'HPAPO',-3)
		
		*IF ThisFormSet.ShowPOReconcile(nHPAPO)
		IF ThisFormSet.Load_VID_union(nHPAPO)
			
			ThisForm.txtHPAPO.Value = ''
			ThisForm.txtHPAPO.Refresh
		
			ThisFormset.nHpaPo = nHPAPO
				
			*ThisFormSet.frmSO.Visible = .F.
			ThisForm.Visible = .F.
			
			IF ThisFormSet.Load_HPAPO()
				*CALLS:ThisFormSet.Show_PO_Item(tmpHPAPo.POitem)
			ENDIF
			
			IF ThisFormSet.Load_Receiving()
				*wait for a Receiving ID to show
			ENDIF
			
			IF ThisFormSet.Load_RecevingID()
				*ThisFormSet.frmReceive.Visible = .T.
				*ThisFormSet.frmReceive.grdRID.RecordSource = 'tmpReceivingID'
				*CALLS: ThisFormset.Show_Receiving_RID(nRID)
			ENDIF
			
			ThisFormSet.frmVendor_Invoice.Visible = .T.
			*ThisFormSet.Calc_Finilize_Total()
			ThisFormSet.CalcTotal()
		
		ELSE
			ThisFormset.nHPAPO = 0
			
			PRIVATE nCntPO 
			nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle ,"CANCELLED")
			IF nCntPO > 0
				MESSAGEBOX("PO is Cancelled."+CHR(13)+"Check with SalesRep",0,"Cannot Reconcile")
			ELSE
				nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle ,"RECONCILED")
				IF nCntPO > 0
					MESSAGEBOX("PO is Reconciled.",0,"Cannot Reconcile")
				ELSE
					MESSAGEBOX("PO not found",0,"Try again")
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

