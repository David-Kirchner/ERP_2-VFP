	PROCEDURE calctotal
		*ThisFormSet.CalcTotal()
		
		
		IF EMPTY(ThisFormset.frmVendor_Invoice.txtVendor_Invoice.Value)
		*	RETURN
		ENDIF
			
		PRIVATE nSubTotal, nFreight
		nSubTotal	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtSubTotal.Value,'SubTotal',10,4)
		nFreight	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtFreight.Value,'Freight',10,4)
		
		ThisFormSet.frmVendor_Invoice.txtTotal.Value = nSubTotal+nFreight
		
		SELECT tmpVIDunion
		PRIVATE nCurrRec
		nCurrRec = RECNO('tmpVIDunion')
		
		PRIVATE nItemTotal, nAcct_TOTAL ,nPartialPrice, nPartialQty, nOrder_TOTAL
		*ItemTotal,Acct_Qty,Order_P
		CALCULATE SUM(ItemTotal+PO_OtherP) 				TO nItemTotal		FOR Recnd = 0 AND NOT DELETED()
		CALCULATE SUM((Acct_Qty*Acct_P)  +Acct_OtherP) 	TO nAcct_TOTAL		FOR Recnd = 0 AND NOT DELETED()
		CALCULATE SUM((Order_QTY*Order_P)+PO_OtherP) 	TO nOrder_TOTAL		FOR Recnd = 0 AND NOT DELETED()
		
		CALCULATE SUM(ItemTotal) TO nPartialPrice FOR Recnd > 0 AND NOT DELETED()
		*CALCULATE SUM(Acct_Qty) TO nPartialQty FOR Total > 0 AND NOT DELETED()
		
		 
		IF nCurrRec > RECCOUNT('tmpVIDunion')
			GO BOTTOM
		ELSE
			GOTO nCurrRec
		ENDIF
		
		PRIVATE nDiff
		nDiff = (nSubTotal+nFreight) - nItemTotal + nPartialPrice
		
		*RIVATE nUnitVariance
		*UnitVariance = nNewUnits * .01 &&One penny per unit Variance
		*IF nNewTotal > nPOItemTotal - nUnitVariance AND nNewTotal < nPOItemTotal + nUnitVariance	
			
		PRIVATE nVariance
		nVariance = nAcct_TOTAL * .01
		
		IF ABS(nDiff) < nVariance 
			*Within tollerance!
			nDiff = 0
		ENDIF
		
		DO CASE
		CASE nDiff < 0
			ThisFormset.frmVendor_Invoice.cmdInvoiceSave.Enabled = .F.
			ThisFormset.frmVendor_Invoice.cmdSavePartial.Enabled = .F.
			ThisFormset.frmVendor_Invoice.txtDiff.DisabledForeColor = RGB(255,0,0)
			ThisFormset.frmVendor_Invoice.txtDiff.Value = nDiff
		CASE nDiff = 0
			ThisFormset.frmVendor_Invoice.cmdInvoiceSave.Enabled = .T.
			ThisFormset.frmVendor_Invoice.cmdSavePartial.Enabled = .T.
		*	ThisFormset.frmVendor_Invoice.txtDiff.DisabledForeColor = RGB(128,128,128)
			ThisFormset.frmVendor_Invoice.txtDiff.Value = nDiff
		CASE nDiff > 0
			ThisFormset.frmVendor_Invoice.cmdInvoiceSave.Enabled = .F.
			ThisFormset.frmVendor_Invoice.cmdSavePartial.Enabled = .F.
			ThisFormset.frmVendor_Invoice.txtDiff.DisabledForeColor = RGB(0,0,0)
			ThisFormset.frmVendor_Invoice.txtDiff.Value = nDiff
		ENDCASE	
		
		
		IF EMPTY(ThisFormset.frmVendor_Invoice.txtVendor_Invoice.Value)
			IF ThisFormset.frmVendor_Invoice.cmdInvoiceSave.Enabled
				WAIT WINDOW "No Vendor Invoice entered." NOWAIT
			ENDIF
			ThisFormset.frmVendor_Invoice.cmdInvoiceSave.Enabled = .F.
			ThisFormset.frmVendor_Invoice.cmdSavePartial.Enabled = .F.
		ENDIF
	ENDPROC

	PROCEDURE calc_finilize_total
		*ThisFormSet.Calc_Finilize_Total
		
		SELECT tmpToInvoice
		PRIVATE nCurrRec
		nCurrRec = RECNO('tmpToInvoice')
		
		PRIVATE nNewUnits, nNewPerUnit, nNewDetailItemTotal, nNewTotal
		nNewTotal = 0
		
		SCAN
			IF tmpToInvoice.InvoiceValue > 0
				*Do not Add to this Invoice!, I has been already invoiced
				LOOP
			ENDIF
			
			nNewUnits			= tmpToInvoice.Units
			nNewPerUnit			= tmpToInvoice.CostValue
			nNewDetailItemTotal = ROUND(nNewUnits * nNewPerUnit,4)
			nNewTotal			= ROUND(nNewTotal + nNewDetailItemTotal,4)
		ENDSCAN
		
		IF nCurrRec > RECCOUNT('tmpToInvoice')
			GO BOTTOM
		ELSE
			GOTO RECORD nCurrRec 
		ENDIF
		
		PRIVATE nPOItemTotal
		nPOItemTotal = ROUND(ThisFormSet.frmVendor_Invoice.txtPOItemTotal.Value,4)
		
		IF nNewTotal = nPOItemTotal
			ThisFormset.Finalize_Lst.txtTotalDiff.Value = 0
			
			WAIT WINDOW "Totals Match!" TIMEOUT 1
			
			ThisFormset.Finalize_Lst.cmdToInvoiceDone.Enabled = .T.
			
			IF RECCOUNT('tmpToInvoice') = 1
				ThisFormset.Finalize_Lst.cmdToInvoiceDone.Click
			ENDIF
		ELSE
			PRIVATE nUnitVariance
			nUnitVariance = nNewUnits * .01 &&One penny per unit Variance
			
			IF nNewTotal > nPOItemTotal - nUnitVariance AND nNewTotal < nPOItemTotal + nUnitVariance
				ThisFormset.Finalize_Lst.txtTotalDiff.Value = nNewTotal - nPOItemTotal
				
				WAIT WINDOW "Totals are within variance!" TIMEOUT 1
				
				ThisFormset.Finalize_Lst.cmdToInvoiceDone.Enabled = .T.
				
				IF RECCOUNT('tmpToInvoice') = 1
					ThisFormset.Finalize_Lst.cmdToInvoiceDone.Click
				ENDIF
			ELSE
				ThisFormset.Finalize_Lst.txtTotalDiff.Value = ( nPOItemTotal - nNewTotal )
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE checkinvoicesave
		*ThisFormSet.CheckInvoiceSave()
		
		PRIVATE cPOItem
		cPOItem = PrepareSQLtxt(ThisFormSet.frmVendor_Invoice.txtPOitem.Value,'POitem',13)
		*cPOitem = Proper_PO_Item(ThisForm.txtPOitem.Value)
		
		PRIVATE nUnitsUSED, nPerUnitUSED
		nUnitsUSED		= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value,'Order_QTY',-5)
		nPerUnitUSED	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_P.Value,'Order_P',-5)
		
		IF nUnitsUSED < 1
			MESSAGEBOX("Units are less than 1!"+CHR(13)+"Please edit Units!",48,"Cannot save!")
			RETURN .F.
		ENDIF
		IF nPerUnitUSED < 0
			MESSAGEBOX("Per Unit are less than 0!"+CHR(13)+"Please edit Per Unit!",48,"Cannot save!")
			RETURN .F.
		ENDIF
		
		**********************
		PRIVATE nOrder_Qty, nOrder_P, nPOitemTotal, nPO_OtherP
		*PO Vendor
		nOrder_Qty	= PrePareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value,'Order_Qty',10,2)
		nOrder_P	= PrePareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_P.Value,'Order_P',10,4)
		nPO_OtherP	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_OtherP.Value,'OtherP',10,2)
		nPOitemTotal = PrePareSQLnum(ThisFormSet.frmVendor_Invoice.txtPOItemTotal.Value,'ItemTotal',10,4)
		
		*ERP Acct Stnd
		PRIVATE nS_Qty, nS_P, nS_Total, nS_OtherP
		nS_QTY	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtS_QTY.Value,'S_QTY',-5)
		nS_P	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtS_P.Value,'S_P',-5)
		nS_OtherP	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtS_OtherP.Value,'OtherP',10,2)
		nS_Total = PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtS_Total.Value,'S_Total',-5)
		
		PRIVATE nOrder_Tot, nS_Tot
		nOrder_Tot	= ( nOrder_Qty * nOrder_P )+ nPO_OtherP
		nS_Tot		= ( nS_Qty * nS_P )+ nS_OtherP
		
		
		IF nS_Total = 0 AND nS_Tot > 0
			ThisFormSet.frmVendor_Invoice.txtS_Total.Value = nS_Tot
			nS_Total = nS_Tot
		ENDIF
		
		IF nPOitemTotal = 0 AND nOrder_Tot > 0
			ThisFormSet.frmVendor_Invoice.txtPOitemTotal.Value = nOrder_Tot
			nPOitemTotal = nOrder_Tot
		ENDIF
		IF nPOitemTotal = 0
			MESSAGEBOX("There is no 'PO Vendor Total'"+CHR(13)+"Please check the numbers again.",48,"No price on Invoice")
		ENDIF
		
		IF nOrder_Tot * .99 > nPOitemTotal OR nOrder_Tot * 1.01 < nPOitemTotal
			*more than 1% OFF
			MESSAGEBOX( "Total of Vendor [Units] times [Per Unit] do not equal the Total!",0,"Cannot save.")
			RETURN .F.
		ENDIF
		
		IF nS_Tot * .99 > nPOitemTotal OR nS_Tot * 1.01 < nPOitemTotal
			*more than 1% OFF
			MESSAGEBOX( "Total of ERP Acct Standard [Units] times [Per Unit] do not equal the Total!",0,"Cannot save.")
			RETURN .F.
		ENDIF
		
		RETURN .T.
		
		*!*	**********************
		*!*	IF USED('tmpPOitemPU')
		*!*		USE IN tmpPOitemPU
		*!*	ENDIF
		
		*!*	PRIVATE cSQL, nSQLEXEC 
		
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT StockLst_P, StockLst_QTY "
		*!*	cSQL = cSQL + ",dbo.f_GetFormPU(Form) AS StockLst_PU "
		*!*	*cSQL = cSQL + ",dbo.f_GetFormUnit(Form) AS FormUnit "
		*!*	cSQL = cSQL + ",dbo.f_GetFormUnitPrice(form) AS FormUnit "
		*!*	cSQL = cSQL + ",Services, ConvServ, Equipment,[Pieces],Pounds,Form "
		
		*!*	cSQL = cSQL + ",dbo.FormDescription(Form,0) AS FormDesc "
		*!*	cSQL = cSQL + ", dbo.f_Get_PU_Price_String(dbo.f_GetFormPU(Form),StockLst_QTY,StockLst_P) AS FormUnitPrice"
		*!*	cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE POitem = '"+cPOitem+"'"
		
		*!*	nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemPU')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemPU')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemPU")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemPU")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpPOitemPU' )
		*!*	ENDIF
		
		*!*	PRIVATE nStockLst_P, nStockLst_QTY, nStockLst_PU, lServices, lConvServ, lEquipment
		*!*	nStockLst_P = 0
		*!*	nStockLst_QTY = 0
		*!*	nStockLst_PU = 0
		
		*!*	lServices = .F.
		*!*	lConvServ = .F.
		*!*	lEquipment = .F.
		*!*	PRIVATE nPieces,nPounds, cFormDesc,cFormUnitPrice
		*!*	nPieces = 0
		*!*	nPounds = 0
		*!*	cFormDesc = ''
		*!*	cFormUnitPrice = ''
		
		*!*	IF USED('tmpPOitemPU')
		*!*		IF RECCOUNT('tmpPOitemPU') > 0
		*!*			nStockLst_P = PrepareSQLnum(tmpPOitemPU.StockLst_P,'StockLst_P',-5)
		*!*			nStockLst_QTY = PrepareSQLnum(tmpPOitemPU.StockLst_QTY,'StockLst_QTY',-5)
		*!*			nStockLst_PU = PrepareSQLnum(tmpPOitemPU.StockLst_PU,'StockLst_PU',-1)
		*!*			lServices 	= PrepareSQLlogic(tmpPOitemPU.Services,'Services')
		*!*			lConvServ	= PrepareSQLlogic(tmpPOitemPU.ConvServ,'ConvServ')
		*!*			lEquipment	= PrepareSQLlogic(tmpPOitemPU.Equipment,'Equipment')
		*!*			nPieces		= PrepareSQLnum(tmpPOitemPU.Pieces,'Pieces',-5)
		*!*			nPounds		= PrepareSQLnum(tmpPOitemPU.Pounds,'Pounds',-5)
		*!*			cFormDesc 	= PrepareSQLtxt(tmpPOitemPU.FormDesc,'FormDesc',11)
		*!*			cFormUnitPrice = PrepareSQLtxt(tmpPOitemPU.FormUnitPrice,'FormUnitPrice',25)
		*!*		ENDIF
		*!*		USE IN tmpPOitemPU
		*!*	ENDIF
		
		*!*	PRIVATE lReturn
		*!*	lReturn = .T.
		
		*!*	PRIVATE cText
		*!*	*cText = "Information:"+CHR(13)
		*!*	cText = ''
		*!*	IF lServices 
		*!*		cText = cText + "this Services allows LOT price"+CHR(13)
		*!*	ENDIF
		*!*	IF lConvServ
		*!*		cText = cText + "this Conversion Service allows LOT price"+CHR(13)
		*!*	ENDIF
		*!*	IF lEquipment
		*!*		cText = cText + "this Equipment purchase allows LOT price"+CHR(13)
		*!*	ENDIF
		
		*!*	IF nStockLst_QTY = 0
		*!*		IF NOT lServices AND NOT lConvServ AND NOT lEquipment
		*!*			WAIT WINDOW "StockLst_Qty = 0, Not Found!" NOWAIT
		*!*			lReturn = .F.	
		*!*		ELSE
		*!*			*Update the StockLst_QTY
		*!*			nStockLst_QTY = 1
		*!*		ENDIF
		
		*!*	ENDIF
		
		*!*	*ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value = nStockLst_QTY 
		
		
		*!*	IF nStockLst_PU = 1
		*!*		*$\LB  nUnitsUSED, nPerUnitUSED
		*!*		IF nUnitsUSED < 2
		*!*			IF nPounds > 2
		*!*				IF NOT ( lServices OR lConvServ OR lEquipment )
		*!*					cText = cText + CHR(13) + "Please Check Weight."
		*!*					cText = cText + CHR(13) + "PO shows "+Remove0(nPounds,7,1)+" Pounds"
		*!*					cText = cText + CHR(13) + "You entered "+Remove0(nUnitsUSED,7,1)+" Pounds!"
		*!*					cText = cText + CHR(13)
		*!*					cText = cText + CHR(13) + "Units Need to be in Pounds!"
		*!*					lReturn = .F.
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF nStockLst_PU = 2
		*!*		*$\Ft
		*!*		IF nUnitsUSED < 1
		*!*			IF nStockLst_QTY > 1
		*!*				IF NOT ( lServices OR lConvServ OR lEquipment )
		*!*					cText = cText + CHR(13) + "Please Check Length."
		*!*					cText = cText + CHR(13) + "PO shows QTY "+Remove0(nStockLst_QTY,7,1)+" "
		*!*					cText = cText + CHR(13) + "You entered "+Remove0(nUnitsUSED,7,1)+" !"
		*!*					cText = cText + CHR(13)
		*!*					cText = cText + CHR(13) + "Units Need to be in Feet!"
		*!*					lReturn = .F.
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF nStockLst_PU = 3
		*!*		*$\PC
		*!*		IF nUnitsUSED < 2
		*!*			IF nPieces > 2
		*!*				IF NOT ( lServices OR lConvServ OR lEquipment )
		*!*					cText = cText + CHR(13) + "Please Check Pieces."
		*!*					cText = cText + CHR(13) + "PO shows "+Remove0(nPieces,7,1)+" Pieces"
		*!*					cText = cText + CHR(13) + "You entered "+Remove0(nUnitsUSED,7,1)+" Pieces!"
		*!*					cText = cText + CHR(13)
		*!*					cText = cText + CHR(13) + "Units Need to be by PC!"
		*!*					lReturn = .F.
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF nStockLst_PU = 4
		*!*		*$\PC
		*!*		IF nUnitsUSED > 1
		*!*	*			IF NOT ( lServices OR lConvServ OR lEquipment )
		*!*				cText = cText + CHR(13) + "Please Check Units."
		*!*				cText = cText + CHR(13) + "Units Need to be by LOT!"
		*!*				cText = cText + CHR(13) + "PO shows "+Remove0(nPieces,7,1)+" "
		*!*				cText = cText + CHR(13) + "You entered "+Remove0(nUnitsUSED,7,1)+" !"
		*!*				cText = cText + CHR(13)
		*!*				cText = cText + CHR(13) + "    1 LOT! " 
		*!*				lReturn = .F.
		*!*	*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*	WAIT WINDOW cText NOWAIT
		*!*	IF NOT EMPTY(cText)
		*!*		IF NOT EMPTY(cFormUnitPrice)
		*!*			cText = "Information:"+CHR(13)+"PO is written as '"+cFormUnitPrice +"' "+CHR(13)+cText
		*!*			MESSAGEBOX( cText, 64, "PO Item Price")
		*!*		ENDIF
		*!*	ENDIF
		
		
		
		*!*	RETURN lReturn 
	ENDPROC

	PROCEDURE checkpoitem
		*ThisFormSet.CheckPOitem()
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item(ThisFormset.frmVendor_Invoice.txtPOitem.Value)
		
		IF EMPTY(cPOitem)
			RETURN .F.
		ENDIF
		IF Proper_PO_Item("") = cPOitem 
			RETURN .F.
		ENDIF
		IF ThisFormSet.frmVendor_Invoice.txtPOitem.Value <> cPOitem 
		
			IF Proper_PO_Item(ThisFormSet.frmVendor_Invoice.txtPOitem.Value) = cPOitem 
				*Update the POitem to Proper format
				ThisFormSet.frmVendor_Invoice.txtPOitem.Value = cPOitem 
			ELSE
				MESSAGEBOX("Check You POitem."+CHR(13)+cPOitem ,64,"PO-item is Odd")
			ENDIF
		ENDIF
		
		IF EMPTY(cPOitem)
			RETURN
		ENDIF
		
		
		IF USED('tmpPO_QTY')
			USE IN tmpPO_QTY
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL= "SELECT StockLst_QTY, StockLst_P, StockLst_PU "  &&ERP Acct Standard
		cSQL= cSQL+",Pounds"
		cSQL= cSQL+",Order_QTY, Order_P" &&Vendor
		cSQL= cSQL+",Cancelled"
		cSQL= cSQL+",Reconciled"
		cSQL= cSQL+",OtherP,OtherFld"
		cSQL= cSQL+" FROM dbo.PurchaseOrder "
		cSQL= cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_QTY' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL, 'tmpPO_QTY' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_QTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_QTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_QTY')
		ENDIF
		
		PRIVATE nStockLst_QTY, nStockLst_P, nPounds, nOtherP, cOtherFld
		nStockLst_QTY	= 0
		nStockLst_P	= 0
		nPounds	= 0
		
		IF USED('tmpPO_QTY')
			IF RECCOUNT('tmpPO_QTY')>0
				nStockLst_QTY	= PrepareSQLnum(tmpPO_QTY.StockLst_QTY,'StockLst_QTY',-5)
				nStockLst_P		= PrepareSQLnum(tmpPO_QTY.StockLst_P,'StockLst_P',-5)
				nOtherP			= PrepareSQLnum(tmpPO_QTY.OtherP,'OtherP',10,2)
				cOtherFld		= PrepareSQLnum(tmpPO_QTY.OtherFld,'OtherFld',10)
				
				PRIVATE nCurrQty, nCurr_P
				nCurrQty = PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value,'Order_QTY',-5)
				nCurr_P	 = PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_P.Value,'Order_P',-5)
				
				IF nCurrQty = 0
					ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value = nStockLst_QTY
				ELSE
					IF nStockLst_QTY > 0
						*Warn User?
						ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value = nStockLst_QTY
					ENDIF
				ENDIF
				
				IF nCurr_P = 0
					ThisFormSet.frmVendor_Invoice.txtPO_P.Value = ROUND(nStockLst_P, 4)
				ELSE
					IF nStockLst_P > 0
						*Warn User?
						ThisFormSet.frmVendor_Invoice.txtPO_P.Value = ROUND(nStockLst_P, 4)
					ENDIF
				ENDIF
				
				ThisFormSet.frmVendor_Invoice.txtOtherP.Value = PrepareSQLnum(nOtherP,'OtherP',10,2)
				ThisFormSet.frmVendor_Invoice.lblOtherFld.Caption = PrepareSQLtxt(cOtherFld,'OtherFld',10)
				
				ThisFormSet.frmVendor_Invoice.txtPOitemTotal.Value = ROUND((nStockLst_QTY * nStockLst_P)+ nOtherP, 4) 
				
				ThisFormSet.ShowHPAPO()
				
				**********************
				IF PrepareSQLLogic(tmpPO_QTY.Cancelled,'Cancelled')
					MESSAGEBOX("PO item:"+cPoitem+" was found!"+CHR(13)+"-item has been CANCELLED!",48,"Use with Caution")
					TrackMess("PO item:"+cPoitem+" was found as CANCELLED! Trying to use in Purchase_Finalize" )
				ENDIF
				IF PrepareSQLLogic(tmpPO_QTY.Reconciled,'Reconciled')
					MESSAGEBOX("PO item:"+cPoitem+" was found!"+CHR(13)+"-item has been RECONCILED!",48,"Use with Caution")
					TrackMess("PO item:"+cPoitem+" was found as RECONCILED! Trying to use in Purchase_Finalize" )
				ENDIF
				
				**********************
			ELSE
				MESSAGEBOX("PO item:"+cPoitem+" was not Found!",48,"Please check your PO Item")
			ENDIF
			
			USE IN tmpPO_QTY
		ENDIF
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE finalizepo_sales
		PARAMETERS cPOitem
		*, nRecv_Qty, nRecv_P, nItemTotal
		*ThisFormSet.FinalizePO_Sales()
		
		PRIVATE lReturn
		lReturn = .T.
		
		******************
		*Paid		Sales_Invoice		-Done in Purchase_Finalize_Lst 
		*Paid		BrokerLst_Master
		*Paid		Stocklst_Master
		*Paid		Sales_StockLst
		*
		*StkPaid		Sales
		*
		*StkPaid_P		Sales_Detail	-Done in Purchase_Finalize_Lst 
		*StkPaid_Total	Sales_Detail	-Done in Purchase_Finalize_Lst 
		*
		*StkPaid_P		Sales_Stock		-Done in Purchase_Finalize_Lst 
		*StkPaid_Total	Sales_Stock		-Done in Purchase_Finalize_Lst 
		
		*** Places where Paid is used!
		
		******************
		*Summerize PricePaid in PO
		PRIVATE nRecv_QTY, nRecv_P, nItemTotal
		nRecv_QTY = 0
		nRecv_P = 0
		nItemTotal = 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpPOitemTot')
			USE IN tmpPOitemTot
		ENDIF
		
		cSQL = "SELECT SUM(Recv_Qty) as Recv_Qty, SUM(ItemTotal) as ItemTotal"
		cSQL = cSQL + " FROM dbo.Vendor_Invoice_Detail WHERE POitem = '"+cPOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemTot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitemTot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemTot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitemTot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpPOitemTot' )
		ENDIF
		
		IF USED('tmpPOitemTot')
			IF RECCOUNT('tmpPOitemTot') > 0
				nRecv_QTY	= PrepareSQLnum(tmpPOitemTot.Recv_Qty,'Recv_Qty',-5)
				nItemTotal	= PrepareSQLnum(tmpPOitemTot.ItemTotal,'ItemTotal',-5)
				
				IF nRecv_QTY > 0
					nRecv_P	= nItemTotal / nRecv_Qty
				ELSE
					nRecv_P = 0
				ENDIF
				
				
			ENDIF
			USE IN tmpPOitemTot
		ENDIF
		
		
		RETURN .T.
		
		******************
		**Get Stock ID, ID_Detail  for POitem
		
		
		IF USED('tmpStock_ID')
			USE IN tmpStock_ID
		ENDIF
		
		cSQL = "SELECT 'S' AS STK, SD.ID "
		cSQL = cSQL + " FROM dbo.StockLst_Master M "
		cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SD WITH(NOLOCK) ON SS.StockLst_ID = M.ID "
		cSQL = cSQL + " WHERE SS.TBL = 'S' "
		cSQL = cSQL + " AND  M.PO_item = '"+cPOitem+"'"
		cSQL = cSQL + " UNION ALL "
		cSQL = cSQL + " SELECT 'B' AS STK, SS.ID "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
		cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH(NOLOCK) ON SS.StockLst_ID = M.ID "
		cSQL = cSQL + " WHERE SS.TBL = 'B' "
		cSQL = cSQL + " AND M.PO_item = '"+cPOitem+"'"
		cSQL = cSQL + " UNION ALL "
		cSQL = cSQL + " SELECT 'SH' AS STK, SS.ID "
		cSQL = cSQL + " FROM dbo.Sales_Stock SS WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SS.TBL = 'S' "
		cSQL = cSQL + " AND SS.StockLst_ID = "
		cSQL = cSQL + " ( SELECT TOP 1 ID FROM dbo.Ar_Stocklst_Master_History M WHERE M.PO_item = '"+cPOitem+"' AND What = 'DELETE' ) "
		cSQL = cSQL + " UNION ALL "
		cSQL = cSQL + " SELECT 'BH' AS STK, SS.ID "
		cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) SS "
		cSQL = cSQL + " WHERE SS.TBL = 'B' "
		cSQL = cSQL + " AND SS.StockLst_ID =  "
		cSQL = cSQL + " ( SELECT TOP 1 ID FROM dbo.Ar_BrokerLst_Master_history M WHERE M.PO_item = '"+cPOitem+"' AND What = 'DELETE' ) "
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpStock_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpStock_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStock_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStock_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpStock_ID' )
		ENDIF
		
		IF USED('tmpStock_ID')
			IF RECCOUNT('tmpStock_ID') > 0
			
				cTBL = ShowSQLtxt(tmpStock_ID.STK,'TBL',1)
				nID	= PrepareSQLnum(tmpStock_ID.ID,'ID',-3)
				
			ENDIF
			USE IN tmpStock_ID
		ENDIF
		
		*!*	******************
		*!*	**SOitem that used this Stock!
		
		*!*	cSQL = "UPDATE dbo.Sales "
		*!*	cSQL = cSQL + " SET = "+STR(nRecv_P,9,2)
		*!*	cSQL = cSQL + " WHERE SOitem = "
		
		*!*	nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, '' )
		*!*		lReturn= .F.  
		*!*		TrackError(PrepareSQLtxt(cSQL,'SQL',8000),"Purchase_Finalize.FinalizePO_Sales",Program(),LINENO(1))
		*!*	ENDIF	
		
		
		RETURN lReturn
	ENDPROC

	PROCEDURE Init
		ThisFormSet.nDecimals = SET('DECIMALS')
		SET DECIMALS TO 4
		
		ThisFormset.frmSO.txtHPAPO.SetFocus()
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisFormSet.Load_SO()
		
		
		SELECT SO
		
	ENDPROC

	PROCEDURE load_finalize_lst
		*!*	PARAMETERS cPOitem, nRecv_Qty, nOrder_P
		*!*	*Load_Finalize_Lst()
		
		*!*	ThisFormSet.Finalize_Lst.Caption = ThisFormSet.Finalize_Lst.Caption +" POitem:"+ALLTRIM(cPOitem)
		
		*!*	ThisFormset.Finalize_Lst.txtPOitem.Value		= cPOitem
		*!*	ThisFormset.Finalize_Lst.txtRecv_Qty.Value 		= nRecv_Qty
		*!*	ThisFormset.Finalize_Lst.txtOrder_QTY.Value			= nOrder_P
		*!*	ThisFormset.Finalize_Lst.txtPOItemTotal.Value	= nOrder_P*nRecv_Qty
		
		
		*!*	PRIVATE cSQL, nSQLEXEC
		
		*!*	IF USED('tmpReceiveID')
		*!*		USE IN tmpReceiveID
		*!*	ENDIF
		
		*!*	SELECT 0
		*!*	cSQL = "SELECT DISTINCT ID_Master,StockTable FROM dbo.Receiving WHERE POitem = '"+cPOitem+"'"
		
		*!*	nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpReceiveID' )
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpReceiveID' )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpReceiveID")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpReceiveID")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpReceiveID' )
		*!*		lFailTrans = .T.
		*!*	ENDIF	
		
		*!*	PRIVATE cSQLLst 
		*!*	cSQLLst = ''
		
		*!*	IF USED('tmpReceiveID')
		*!*		IF VARTYPE(tmpReceiveID.ID_Master) = "N"
		*!*			SELECT tmpReceiveID
		*!*			SCAN
		*!*				IF tmpReceiveID.ID_Master > 0
		*!*					IF tmpReceiveID.StockTable = "S"
		*!*						IF CountID_StockLst( tmpReceiveID.ID_Master, "StockLst_Master", ThisFormSet.nConnHandle ) > 0
		*!*							ThisFormset.Finalize_Lst.lblStock.Caption = 'S'
		*!*							
		*!*							*Loop thru tmpReceiveID and add Stock
		*!*							IF NOT EMPTY(cSQLLst)
		*!*								cSQLLst = cSQLLst+" UNION ALL "
		*!*							ENDIF
		*!*							cSQLLst = cSQLLst+" SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Weight,M.Form,'S' AS LST"
		*!*							cSQLLst = cSQLLst+",D.CostValue,D.RandLen,D.InvoiceValue"
		*!*							cSQLLst = cSQLLst+",D.S_QTY,D.S_P,D.S_PU"
		*!*							cSQLLst = cSQLLst+",0.0000 AS Units, 0.0000 AS IDDetailUnits, 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal"
		*!*							cSQLLst = cSQLLst+",0 AS ID_Detail_Process"
		*!*							cSQLLst = cSQLLst+" FROM dbo.StockLst_Detail D"
		*!*							cSQLLst = cSQLLst+" ,dbo.StockLst_Master M"
		*!*							cSQLLst = cSQLLst+" WHERE M.ID = "+STR(tmpReceiveID.ID_Master)
		*!*							cSQLLst = cSQLLst+" AND M.ID = D.ID"
		*!*						ENDIF
		*!*						IF CountID_StockLst( tmpReceiveID.ID_Master, "StockLst_Master_History", ThisFormSet.nConnHandle ) > 0
		*!*							ThisFormset.Finalize_Lst.lblStock.Caption = 'SH'
		*!*							
		*!*							IF NOT EMPTY(cSQLLst)
		*!*								cSQLLst = cSQLLst+" UNION ALL "
		*!*							ENDIF
		*!*							cSQLLst = cSQLLst+" SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Weight,M.Form,'S' AS LST"
		*!*							cSQLLst = cSQLLst+",D.CostValue,D.RandLen,D.InvoiceValue"
		*!*							cSQLLst = cSQLLst+",D.S_QTY,D.S_P,D.S_PU"
		*!*							cSQLLst = cSQLLst+",0.0000 AS Units, 0.0000 AS IDDetailUnits, 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal"
		*!*							cSQLLst = cSQLLst+",ID_Detail_Process"
		*!*							cSQLLst = cSQLLst+" FROM dbo.Ar_Stocklst_Detail_History D"
		*!*							cSQLLst = cSQLLst+" ,dbo.Ar_Stocklst_Master_History M"
		*!*							cSQLLst = cSQLLst+" WHERE M.ID = "+STR(tmpReceiveID.ID_Master)
		*!*							cSQLLst = cSQLLst+" AND M.ID = D.ID "
		*!*							cSQLLst = cSQLLst+" AND M.[What] = 'Delete'"
		*!*							cSQLLst = cSQLLst+" AND ID_Detail_Process > 0"
		*!*						ENDIF
		*!*					ENDIF
		
		*!*					IF tmpReceiveID.StockTable = "B"
		*!*						IF CountID_StockLst( tmpReceiveID.ID_Master, "BrokerLst_Master", ThisFormSet.nConnHandle ) > 0
		*!*							ThisFormset.Finalize_Lst.lblStock.Caption = 'B'
		*!*						
		*!*							IF NOT EMPTY(cSQLLst)
		*!*								cSQLLst = cSQLLst+" UNION ALL "
		*!*							ENDIF
		*!*							cSQLLst = cSQLLst+" SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Weight,M.Form,'B' AS LST"
		*!*							cSQLLst = cSQLLst+",D.CostValue,D.RandLen,D.InvoiceValue"
		*!*							cSQLLst = cSQLLst+",D.S_QTY,D.S_P,D.S_PU"
		*!*							cSQLLst = cSQLLst+",0.0000 AS Units, 0.0000 AS IDDetailUnits, 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal"
		*!*							cSQLLst = cSQLLst+",0 AS ID_Detail_Process"
		*!*							cSQLLst = cSQLLst+" FROM dbo.BrokerLst_Detail D"
		*!*							cSQLLst = cSQLLst+" ,dbo.BrokerLst_Master M"
		*!*							cSQLLst = cSQLLst+" WHERE M.ID = "+STR(tmpReceiveID.ID_Master)
		*!*							cSQLLst = cSQLLst+" AND M.ID = D.ID"
		*!*						ENDIF
		*!*						IF CountID_StockLst( tmpReceiveID.ID_Master, "BrokerLst_Master_History", ThisFormSet.nConnHandle ) > 0
		*!*							ThisFormset.Finalize_Lst.lblStock.Caption = 'BH'
		*!*							
		*!*							IF NOT EMPTY(cSQLLst)
		*!*								cSQLLst = cSQLLst+" UNION ALL "
		*!*							ENDIF
		*!*							cSQLLst = cSQLLst+" SELECT D.ID_Detail,D.Pc,D.Dim1,D.Dim2,D.Dim3,D.Weight,M.Form,'B' AS LST"
		*!*							cSQLLst = cSQLLst+",D.CostValue,D.RandLen,D.InvoiceValue"
		*!*							cSQLLst = cSQLLst+",D.S_QTY,D.S_P,D.S_PU"
		*!*							cSQLLst = cSQLLst+",0.0000 AS Units, 0.0000 AS IDDetailUnits, 0.0000 AS IDDetailPerUnit, 0.0000 AS IDDetailTotal"
		*!*							cSQLLst = cSQLLst+",ID_Detail_Process"
		*!*							cSQLLst = cSQLLst+" FROM dbo.Ar_BrokerLst_Detail_History D"
		*!*							cSQLLst = cSQLLst+" ,dbo.Ar_BrokerLst_Master_history M"
		*!*							cSQLLst = cSQLLst+" WHERE M.ID = "+STR(tmpReceiveID.ID_Master)
		*!*							cSQLLst = cSQLLst+" AND M.ID = D.ID "
		*!*							cSQLLst = cSQLLst+" AND M.[What] = 'Delete'"
		*!*							cSQLLst = cSQLLst+" AND ID_Detail_Process > 0"
		*!*						ENDIF
		*!*						
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDSCAN					
		*!*		ENDIF
		*!*		USE IN tmpReceiveID
		*!*	ENDIF
		
		
		*!*	IF NOT EMPTY(cSQLLst)
		*!*		IF USED('tmpToInvoice')
		*!*			USE IN tmpToInvoice
		*!*		ENDIF
		
		*!*		SELECT 0
		
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLLst, 'tmpToInvoice' )
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLLst, 'tmpToInvoice' )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLLst, "tmpToInvoice")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLLst, "tmpToInvoice")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQLLst, ThisFormSet.nConnHandle, 'tmpToInvoice' )
		*!*	*		lFailTrans = .T.
		*!*		ENDIF	
		
		*!*		IF USED('tmpToInvoice')
		*!*			
		*!*			ThisFormSet.ToInvoice_Totals()
		*!*			
		*!*			IF RECCOUNT('tmpToInvoice') > 0
		*!*				ThisFormSet.Finalize_Lst.grdToInvoice.recordSource = 'tmpToInvoice'
		*!*			ELSE			
		*!*				*Nothing todo
		*!*				ThisForm.cmdToInvoiceDone.Click
		*!*			ENDIF
		*!*		ENDIF
		
		*!*	ENDIF
		
		*!*	ThisFormset.Finalize_Lst.Visible = .T.
		*!*	ThisFormset.Finalize_Lst.ReadMethod
		
		
	ENDPROC

	PROCEDURE load_hpapo
		*ThisFormSet.Load_HPAPO()
		
		IF ThisFormset.nHpaPo < 1
			TrackError(" PO:"+ALLTRIM(STR(ThisFormset.nHpaPo)),"Purchase_Finalize.ShowHPApo()",Program(),LINENO(1))
			MESSAGEBOX(" PO:"+ALLTRIM(STR(ThisFormset.nHpaPo))+CHR(13)+"Purchase_Finalize.ShowHPApo()",0+64,"Show David")
			RETURN .F.
		ENDIF
		
		ThisFormset.frmHPAPO.Visible = .T.
		
		*IF USED('tmpPOitem')
		IF USED('tmpHPAPo')
			USE IN tmpHPAPo
		ENDIF
		
		WAIT WINDOW "Load PO: "+STR(ThisFormset.nHpaPo) NOWAIT
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT P.* "
		cSQL = cSQL+" FROM dbo.PurchaseOrder P WITH(NOLOCK) "
		*cSQL = cSQL+" WHERE POitem = '"+cPOitem+"'"
		cSQL = cSQL+" WHERE P.HPAPO = "+STR(ThisFormset.nHpaPo)
		*cSQL = cSQL+" AND ISNULL(P.Cancelled,0) = 0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpHPAPo')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpHPAPo')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHPAPo")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHPAPo")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpHPAPo' )
		ENDIF
		
		ThisFormSet.frmHPAPO.Caption = "ERP PO"
		
		ThisFormSet.frmHPAPO.txtPOcnt.Value = RECCOUNT('tmpHPAPo')
		
		GO TOP
		ThisFormSet.Show_PO_Item(tmpHPAPo.POitem)
	ENDPROC

	PROCEDURE load_receiving
		*PARAMETERS cPOitem
		*ThisFormSet.Load_Receiving()
			
		IF USED("tmpRecvPO")
			USE IN tmpRecvPO
		ENDIF
		
		cSQL = "SELECT R.* "
		cSQL = cSQL + ", ISNULL(P.Cancelled,0) AS POiten_Canc "
		cSQL = cSQL + ", 0 AS Marked "
		
		cSQL = cSQL + " FROM dbo.Receiving R WITH(NOLOCK) "
		*cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder P WITH(NOLOCK) ON R.POitem = P.POitem "
		cSQL = cSQL + " WHERE P.HPAPO = "+STR(ThisFormset.nHpaPo)
		
		SELECT 0  
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecvPO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecvPO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvPO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRecvPO')
			RETURN .F.
		ENDIF
		
		IF USED("tmpRecvPO")
			IF RECCOUNT("tmpRecvPO")>0
				
				PRIVATE nPU, nTotal
				SELECT tmpRecvPO
				SCAN
					*Convert Old School data
					IF ISNULL(tmpRecvPO.PO_PU) 
						nPU = GetPUfrom_POitem(tmpRecvPO.POitem,ThisFormSet.nConnHandle)
						REPLACE tmpRecvPO.PO_PU WITH nPU
					ENDIF
					IF tmpRecvPO.PO_PU = 0
						nPU = GetPUfrom_POitem(tmpRecvPO.POitem,ThisFormSet.nConnHandle)
						REPLACE tmpRecvPO.PO_PU WITH nPU
					ENDIF
					
					IF ISNULL(tmpRecvPO.PO_Total) 
						nTotal = getPOCost_POitem(tmpRecvPO.POitem,ThisFormSet.nConnHandle, '')
						REPLACE tmpRecvPO.PO_Total WITH nTotal 
					ENDIF
					IF tmpRecvPO.PO_Total = 0
						nTotal = getPOCost_POitem(tmpRecvPO.POitem,ThisFormSet.nConnHandle, '')
						REPLACE tmpRecvPO.PO_Total WITH nTotal 
					ENDIF
					
					
					IF ISNULL(tmpRecvPO.R_AP_P) 
						REPLACE tmpRecvPO.R_AP_P WITH 0 
					ENDIF
					
					IF ISNULL(tmpRecvPO.R_AP_Total) 
						REPLACE tmpRecvPO.R_AP_Total WITH 0 
					ENDIF
					
				ENDSCAN
				GO TOP
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE load_recevingid
		*ThisFormSet.Load_RecevingID()
		
		IF USED("tmpReceivingID")
			ThisFormSet.frmReceive.grdRID.RecordSource = ''
			
			USE IN tmpReceivingID
		ENDIF
		
		cSQL = "SELECT P.POitem, ISNULL(R.Heat,'') AS Heat, ISNULL(R.ID,-1) AS ID "
		cSQL = cSQL + " FROM dbo.PurchaseOrder P WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Receiving R WITH(NOLOCK) ON P.POitem = R.POitem "
		cSQL = cSQL + " WHERE P.HPAPO = "+STR(ThisFormset.nHpaPo)
		cSQL = cSQL + " ORDER BY P.POitem, R.Heat "
		SELECT 0  
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpReceivingID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpReceivingID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpReceivingID')
			RETURN .F.
		ENDIF
		
		
		IF USED('tmpReceivingID')
			IF RECCOUNT('tmpReceivingID') > 0
				nRID = PrepareSQLnum(tmpReceivingID.ID,'RID',-3)
				
				IF nRID > 0	
					ThisFormSet.frmReceive.Visible = .T.
					
					ThisFormSet.frmReceive.grdRID.RecordSource = 'tmpReceivingID'
					
					ThisFormset.Show_Receiving_RID(nRID)
					
				ENDIF
				
			ENDIF	
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE load_so
		PARAMETERS pWhat
		*ThisFormSet.Load_SO()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			ThisFormset.frmSO.grdSO.RecordSource = ''	
			
			IF USED('SO')
				USE IN SO
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('SO')
			SELECT 0
			
			cSQL = "SELECT DISTINCT P.HPAPO "
			cSQL = cSQL + ",(SELECT COUNT(*) AS CNT FROM dbo.Receiving R WITH(NOLOCK) WHERE R.POitem = P.POitem ) AS Rcvd "
			cSQL = cSQL + ",P.Company "
			cSQL = cSQL + " FROM dbo.PurchaseOrder P "
			cSQL = cSQL + " WHERE ISNULL(P.Reconciled,0) = 0 " 
			cSQL = cSQL + "  AND ISNULL(P.Cancelled,0) = 0 "
			cSQL = cSQL + "  AND P.HPApo > 0 "
			cSQL = cSQL + " ORDER BY P.HPAPO DESC "
		
		*!*		cSQL = "SELECT DISTINCT HPAPO,Company FROM dbo.PurchaseOrder "
		*!*		cSQL = cSQL + " WHERE ISNULL(Reconciled,0) = 0 "
		*!*		cSQL = cSQL + " AND ISNULL(Cancelled,0) = 0 "
		*!*		cSQL = cSQL + " AND HPAPO > 0"
		*!*		cSQL = cSQL + " ORDER BY HPAPO DESC "
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'SO' )
			ENDIF
		
		ENDIF
		
		IF USED('SO')
			SELECT SO
			
			IF UPPER(pWhat) ="REFRESH"
				GO TOP
				ThisFormSet.frmSO.grdSO.RecordSource = 'SO'
				
			ENDIF
			
			
			
		ELSE
			MESSAGEBOX('Failed to load SO',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE load_vid_union
		PARAMETERS nHPAPO
		*ThisFormSet.Load_VID_union(nHPAPO)
		*- was ShowPOitemReconcile
		
		IF VARTYPE(nHPAPO) != "N"
			RETURN .F.
		ENDIF
		
		PRIVATE cCompany 
		cCompany = ''
		
		IF USED('tmpVIDunion')
			USE IN tmpVIDunion
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
			
		cSQL = "SELECT P.POItem"
		cSQL = cSQL + " ,ISNULL(dbo.f_GetPOItem_Total(P.POItem),0) AS ItemTotal "
		
		cSQL = cSQL + " ,ISNULL(P.Order_QTY,0) AS Order_QTY "  &&Vendor
		cSQL = cSQL + " ,ISNULL(P.Order_P,0) AS Order_P"
		cSQL = cSQL + " ,ISNULL(P.Order_PU,0) AS Order_PU"
		cSQL = cSQL + " ,ISNULL(P.OtherP,0) AS PO_OtherP "
		*cSQL = cSQL + " ,ISNULL(P.OtherP,0) AS OtherP "
		cSQL = cSQL + " ,ISNULL(P.OtherFld,'') AS OtherFld "
		
		cSQL = cSQL + " ,ISNULL(P.StockLst_Qty,0) AS Acct_Qty "  &&ERP Acct Standard
		cSQL = cSQL + " ,ISNULL(P.StockLst_P,0) AS Acct_P "
		cSQL = cSQL + " ,ISNULL(P.StockLst_PU,dbo.f_GetFormPU(P.Form)) AS Acct_PU "
		cSQL = cSQL + " ,ISNULL(P.OtherP,0) AS Acct_OtherP"
		cSQL = cSQL + " ,Case when P.Reconciled IS NULL then 0 when P.Reconciled = 1 THEN 1 ELSE 0 end AS Recnd "
		*cSQL = cSQL + " ,ISNULL(P.Reconciled,0) AS Recnd "
		cSQL = cSQL + " ,0 AS ID"
		*cSQL = cSQL + " ,0 AS Vendor_Invoice_ID"
		cSQL = cSQL + " FROM dbo.PurchaseOrder P WITH(NOLOCK)  "
		cSQL = cSQL + " WHERE P.HPAPO = "+STR(nHPAPO)+" AND ISNULL(P.Reconciled,0) = 0 AND ISNULL(P.Cancelled,0) = 0"
		
		cSQL = cSQL + " UNION "
		
		cSQL = cSQL + " SELECT VID.POitem "
		cSQL = cSQL + " ,VID.ItemTotal "
		
		cSQL = cSQL + " ,ISNULL(VID.Order_QTY,0) AS Order_QTY "	&&Vendor
		cSQL = cSQL + " ,ISNULL(VID.Order_P,0) AS Order_P "
		cSQL = cSQL + " ,ISNULL(VID.Order_PU,0) AS Order_PU "
		cSQL = cSQL + " ,ISNULL(VID.Order_OtherP,0) AS PO_OtherP"
		cSQL = cSQL + " ,ISNULL(VID.OtherFld,'') AS OtherFld "
		
		cSQL = cSQL + " ,ISNULL(VID.Recv_QTY,0) AS Acct_Qty "  &&ERP Acct Standard
		cSQL = cSQL + " ,ISNULL(VID.Recv_P,0) AS Acct_P "
		cSQL = cSQL + " ,ISNULL(VID.Recv_PU,0) AS Acct_PU "
		cSQL = cSQL + " ,ISNULL(VID.Recv_OtherP,0) AS Acct_OtherP"
		
		*cSQL = cSQL + " ,-1 AS Recnd "
		cSQL = cSQL + " ,ISNULL(VID.Reconciled,0) AS Recnd "
		cSQL = cSQL + " ,0 AS ID "
		*cSQL = cSQL + " ,Vendor_Invoice_ID "
		cSQL = cSQL + " FROM dbo.Vendor_Invoice VI WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Vendor_Invoice_Detail VID WITH(NOLOCK) ON VID.Vendor_Invoice_ID = VI.ID "
		cSQL = cSQL + " WHERE VI.HPAPO ="+STR(nHPAPO)+" AND ISNULL(Reconciled,0) = 0"
		  
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpVIDunion')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpVIDunion')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVIDunion")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpVIDunion")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpVIDunion' )
		ENDIF
		
		IF USED("tmpVIDunion")
			IF EOF("tmpVIDunion")
		*		USE IN tmpVIDunion
				RETURN .F.
			ELSE
				SELECT tmpVIDunion
				SCAN
					UPDATE tmpVIDunion SET ID = RECNO()
					
					IF ISNULL(Acct_Qty)
					ENDIF
					
				ENDSCAN
				
				GO TOP
				ThisFormset.frmVendor_Invoice.txtID.Value = 1
				
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE mark_has_changed
		*ThisFormSet.Mark_has_Changed()
		
		IF NOT USED("tmpRecvPO")
			*Messagebox()
			RETURN .F.
		ENDIF
		
		PRIVATE lMarked
		
		SELECT tmpRecvPO
		SCAN
			lMarked = PrepareSQLbit(tmpRecvPO.Marked,'Marked')
		
		ENDSCAN
	ENDPROC

	PROCEDURE refreshvendorinvoice
		*ThisFormSet.RefreshVendorInvoice()
		
		IF USED('tmpVIDunion')
			ThisFormset.frmVendor_Invoice.txtID.Value		= PrepareSQLnum(tmpVIDunion.ID,'ID',-3)
			ThisFormset.frmVendor_Invoice.txtPOitem.Value	= PrepareSQLtxt(tmpVIDunion.POItem,'POitem',12)
										*Vendor
			ThisFormset.frmVendor_Invoice.txtPO_QTY.Value	= PrepareSQLnum(tmpVIDunion.Order_Qty,'Order_QTY',-5)
			ThisFormset.frmVendor_Invoice.txtPO_P.Value		= PrepareSQLnum(tmpVIDunion.Order_P,'Order_P',-5)
			ThisFormset.frmVendor_Invoice.txtPU.Value		= Get_cPUfrom_nPU( PrepareSQLnum(tmpVIDunion.Order_PU,'Order_PU',-3) )
			
			ThisFormSet.frmVendor_Invoice.txtPO_OtherP.Value= PrepareSQLnum(tmpVIDunion.PO_OtherP,'PO_OtherP',10,4)
										*ERP Acct Standard
			ThisFormset.frmVendor_Invoice.txtS_QTY.Value	= PrepareSQLnum(tmpVIDunion.Acct_Qty,'Recv_QTY',-5)
			ThisFormset.frmVendor_Invoice.txtS_P.Value		= PrepareSQLnum(tmpVIDunion.Acct_P,'Recv_P',-5)
			ThisFormset.frmVendor_Invoice.txtS_PU.Value		= IIF( ISNULL(tmpVIDunion.Acct_PU), tmpVIDunion.Form_PU, tmpVIDunion.Acct_PU ) 
			
			ThisFormSet.frmVendor_Invoice.lblOtherFld.Caption = PrepareSQLtxt(tmpVIDunion.OtherFld,'OtherFld',10)
			ThisFormSet.frmVendor_Invoice.txtS_OtherP.Value = PrepareSQLnum(tmpVIDunion.Acct_Qty,'Acct_Qty',10,4)
		
			
			ThisFormset.frmVendor_Invoice.txtPOItemTotal.Value= PrepareSQLnum(tmpVIDunion.ItemTotal,'ItemTotal',5)
			
			PRIVATE nS_Qty, nS_P, nS_OtherP, nS_Total
			nS_QTY	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtS_QTY.Value,'S_QTY',-5)
			nS_P	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtS_P.Value,'S_P',-5)
			nS_OtherP	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtS_OtherP.Value,'OtherP',10,2)
		
			nS_Total = ( nS_Qty * nS_P )+ nS_OtherP
			ThisFormSet.frmVendor_Invoice.txtS_Total.Value = PrepareSQLnum(nS_Total,'S_Total',-5)
			
			
			PRIVATE nOrder_Qty, nOrder_P, nPOitemTotal, nPO_OtherP
			*PO Vendor
			nOrder_Qty	= PrePareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_QTY.Value,'Order_Qty',10,2)
			nOrder_P	= PrePareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_P.Value,'Order_P',10,4)
			nPO_OtherP	= PrepareSQLnum(ThisFormSet.frmVendor_Invoice.txtPO_OtherP.Value,'Order_OtherP',10,2)
			nPOitemTotal = PrePareSQLnum(ThisFormSet.frmVendor_Invoice.txtPOItemTotal.Value,'ItemTotal',10,4)
			
			
			PRIVATE nOrder_Tot
			nOrder_Tot	= ( nOrder_Qty * nOrder_P )+ nPO_OtherP
		
			IF nPOitemTotal = 0 AND nOrder_Tot > 0
				ThisFormSet.frmVendor_Invoice.txtPOitemTotal.Value = nOrder_Tot
				nPOitemTotal = nOrder_Tot
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE Release
		SET DECIMALS TO (ThisFormSet.nDecimals)
		
	ENDPROC

	PROCEDURE showhpapo
		*PARAMETERS cPOitem
		*ThisFormSet.ShowHPAPO()
		
		*!*	*!*	ThisFormset.frmHPAPO.Visible = .T.
		*!*	*!*	*ThisFormset.frmHPAPO.txtVendor_Invoice.SetFocus
		*!*	*!*	*ThisFormset.frmHPAPO.AlwaysOnTop = .F.
		
		*!*	*!*	*IF ISNULL(cPOitem)
		*!*	*!*	*	TrackError("No POitem, NULL PO:"+ALLTRIM(STR(ThisFormset.nHpaPo)),"Purchase_Finalize.ShowHPApo()",Program(),LINENO(1))
		*!*	*!*	*	MESSAGEBOX("No POitem, NULL PO:"+ALLTRIM(STR(ThisFormset.nHpaPo))+CHR(13)+"Purchase_Finalize.ShowHPApo()",0+64,"Show David")
		*!*	*!*	*	RETURN .F.
		*!*	*!*	*ENDIF
		
		*!*	*!*	IF ThisFormset.nHpaPo < 1
		*!*	*!*		TrackError(" PO:"+ALLTRIM(STR(ThisFormset.nHpaPo)),"Purchase_Finalize.ShowHPApo()",Program(),LINENO(1))
		*!*	*!*		MESSAGEBOX(" PO:"+ALLTRIM(STR(ThisFormset.nHpaPo))+CHR(13)+"Purchase_Finalize.ShowHPApo()",0+64,"Show David")
		*!*	*!*		RETURN .F.
		*!*	*!*	ENDIF
		
		
		*!*	*!*	*IF USED('tmpPOitem')
		*!*	*!*	IF USED('tmpHPAPo')
		*!*	*!*		USE IN tmpHPAPo
		*!*	*!*	ENDIF
		
		*!*	*!*	WAIT WINDOW "POitem: "+cPOitem NOWAIT
		
		*!*	*!*	PRIVATE cSQL, nSQLEXEC 
		*!*	*!*	cSQL = "SELECT * "
		*!*	*!*	cSQL = cSQL + " FROM dbo.PurchaseOrder "
		*!*	*!*	*cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		*!*	*!*	cSQL = cSQL + "  WHERE HPAPO = "+STR(ThisFormset.nHpaPo)
		
		*!*	*!*	SELECT 0
		*!*	*!*	nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpHPAPo')
		*!*	*!*	DO WHILE nSQLEXEC = 0
		*!*	*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*	*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpHPAPo')
		*!*	*!*	ENDDO
		*!*	*!*	IF nSQLEXEC < 0 &&Try again!
		*!*	*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHPAPo")
		*!*	*!*		DO WHILE nSQLEXEC = 0
		*!*	*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*	*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpHPAPo")
		*!*	*!*			
		*!*	*!*			IF nSQLEXEC < 0
		*!*	*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*	*!*					nSQLEXEC = 0
		*!*	*!*				ENDIF
		*!*	*!*			ENDIF
		*!*	*!*		ENDDO
		*!*	*!*	ENDIF
		*!*	*!*	IF nSQLEXEC < 0
		*!*	*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpHPAPo' )
		*!*	*!*	ENDIF
		
		*!*	*!*	ThisFormSet.frmHPAPO.Caption = "ERP PO"
		
		*!*	IF USED('tmpHPAPo')
		*!*		SELECT tmpHPAPo
		*!*		
		*!*		ThisFormSet.frmHPAPO.Caption = "ERP PO: " + ShowSQLtxt(Company,'Company',30)
		*!*		
		*!*		ThisFormSet.frmHPAPO.cmdViewPOitem.Caption = ShowSQLtxt("View PO: "+ALLTRIM(cPOitem) ,'vPOitem',21)
		*!*		
		*!*		cAlloy = " Alloy:"+PrepareSQLtxt(Alloy,'Alloy',10)+" CC:"+PrepareSQLtxt(CC,'cc',1)
		*!*		cAlloy = cAlloy+" CL:"+PrepareSQLtxt(CL,'CL',1)
		*!*		
		*!*		ThisFormSet.frmHPAPO.txtAlloy.Value = PrepareSQLtxt(cAlloy ,'cAlloy ',100)
		*!*		
		*!*		cItemDescription = ItemDescription(Form, thck, SZ2, SZ3, StockLst_QTY, Randlen)
		*!*		ThisFormSet.frmHPAPO.txtDescription.Value = ShowSQLtxt(cItemDescription,'ItemDescription',200)
		
		*!*		cItemDescriptionMetric = ItemDescriptionMetric(Form,thck,SZ2,SZ3,Order_QTY,RandLen, Metric, Sz1orig, Sz2orig, Sz3orig)
		*!*		IF cItemDescription != cItemDescriptionMetric 
		*!*			ThisFormSet.frmHPAPO.txtDescriptionMetric.Visible = .T.
		*!*			ThisFormSet.frmHPAPO.txtDescriptionMetric.Value = PrepareSQLtxt(cItemDescriptionMetric,'ItemDescriptionMetric ',200)
		*!*		ELSE
		*!*			ThisFormSet.frmHPAPO.txtDescriptionMetric.Visible = .F.
		*!*			ThisFormSet.frmHPAPO.txtDescriptionMetric.Value = ''
		*!*		ENDIF
		
		*!*		PRIVATE cReceiveDesc
		*!*	*	PRIVATE cPOitem
		*!*	*	cPOitem = Proper_PO_Item(ThisFormset.frmVendor_Invoice.txtPOitem.Value)
		*!*		
		*!*		IF cPOitem != Proper_PO_Item('')
		*!*		
		*!*			IF ThisFormSet.frmVendor_Invoice.txtPOitem.Value <> cPOitem
		*!*			
		*!*				SELECT tmpVIDunion
		*!*				PRIVATE nCurRec 
		*!*				nCurRec = RECNO('tmpVIDunion')
		*!*				
		*!*				LOCATE FOR POitem = cPOitem 
		*!*				IF NOT FOUND('tmpVIDunion')
		*!*					*WAIT WINDOW "This is not the POitem on the Invoice!" NOWAIT
		*!*					MESSAGEBOX("This POitem is not found for this Invoice.",0+48,"")
		*!*				ENDIF
		*!*				
		*!*				IF nCurRec > 0
		*!*					IF RECCOUNT('tmpVIDunion') = 0
		*!*						MESSAGEBOX("'tmpVIDunion' is empty"+CHR(13)+"dbo.PurchaseOrder was probably mis-marked as Reconciled or Cancelled",0+16,"Error")
		*!*						TrackError("'tmpVIDunion' is empty"+CHR(13)+"dbo.PurchaseOrder was probably mis-marked as Reconciled or Cancelled","PurchaseOrder was probably mis-marked as Reconciled or Cancelled", PROGRAM(), LINENO(1))
		*!*						RETURN .F.
		*!*					ENDIF
		*!*					IF RECCOUNT() <= nCurRec 
		*!*						GOTO nCurRec 
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			SELECT tmpHPAPo
		*!*			
		*!*			cReceiveDesc = ReceiveDesc_POitem( cPOitem, ThisFormSet.nConnHandle )
		*!*			ThisFormSet.frmHPAPO.txtDescriptionReceive.Value = ShowSQLtxt(cReceiveDesc,'ReceiveDesc',200)
		*!*		ENDIF
		
		
		*!*		ThisFormSet.frmHPAPO.txtOrder_P.Value 	= PrepareSQLnum(Order_P ,'Order_P',10,4)
		*!*		ThisFormSet.frmHPAPO.txtOrder_Qty.Value = PrepareSQLnum(Order_QTY ,'Order_QTY',10,4)
		*!*		ThisFormSet.frmHPAPO.txtOrderTotal.Value = PrepareSQLnum(Order_P*Order_QTY ,'Order_QTY',10,4)
		*!*		
		*!*		ThisFormSet.frmHPAPO.txtS_P.Value 	= PrepareSQLnum(StockLst_P,'S_P',10,4)
		*!*		ThisFormSet.frmHPAPO.txtS_Qty.Value = PrepareSQLnum(StockLst_QTY,'S_QTY',10,4)
		*!*		ThisFormSet.frmHPAPO.txtS_Total.Value = PrepareSQLnum(StockLst_Total,'S_Total',10,4)
		
		*!*		ThisFormSet.frmHPAPO.txtOtherP.Value = PrepareSQLnum(OtherP,'OtherP',10,4)
		*!*		ThisFormSet.frmHPAPO.txtOtherFld.Value = ShowSQLtxt(OtherFld,'OtherFld',10)
		*!*			
		*!*		ThisFormSet.frmHPAPO.txtOrderDate.Value = PrepareSQLdate(OrderDate,'OrderDate')
		*!*		ThisFormSet.frmHPAPO.txtDue_Min.Value = PrepareSQLdate(Due_Min,'Due_Min')
		*!*		ThisFormSet.frmHPAPO.txtDue_Max.Value = PrepareSQLdate(Due_Max,'Due_Max')
		
		*!*		ThisFormSet.frmHPAPO.lblDelivered.Visible = PrepareSQLchk(Delivered,'Delivered')
		*!*		ThisFormSet.frmHPAPO.txtReceived.Visible  = PrepareSQLchk(Delivered,'Delivered')
		*!*		ThisFormSet.frmHPAPO.txtReceived.Value = PrepareSQLdate(Received,'Received')
		
		*!*		ThisFormSet.frmHPAPO.edtCond_Spec.Value = ShowSQLtxt(cond_spec,'cond_spec',-1)
		*!*		ThisFormSet.frmHPAPO.edtMisc_Purch.Value = ShowSQLtxt(Misc_Purch,'Misc_Purch',-1)
		*!*		
		*!*		ThisFormSet.frmHPAPO.txtHeat.Value 		= ShowSQLtxt(LEFT(Heat,35),'Heat',35)
		*!*		ThisFormSet.frmHPAPO.txtReceivedBy.Value = ShowSQLtxt(ReceivedBy,'ReceivedBy',10)
		*!*		ThisFormSet.frmHPAPO.lblCancelled.Visible = PrepareSQLchk(cancelled,'cancelled')
		*!*		
		*!*		ThisFormSet.frmHPAPO.lblHPApo.Caption = ALLTRIM(STR(PrepareSQLnum(tmpHPAPo.HPApo,'HPApo',-3)))
		*!*		
		*!*		PRIVATE nCntPOitem, nCurrItem 
		*!*		nCntPOitem = Count_POItemsinPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
		*!*		nCurrItem = IIF(PrepareSQLnum(tmpHPAPo.ItemPO,'ItemPO',-1)=0,1,PrepareSQLnum(tmpHPAPo.ItemPO,'ItemPO',-1))
		*!*		ThisFormSet.frmHPAPO.txtPOcnt.Value = PrepareSQLnum(nCntPOitem,'POcnt',-1)
		
		*!*		ThisFormSet.frmHPAPO.lblCurrItem.Caption = "item "+ALLTRIM(STR( PrepareSQLnum(nCurrItem,'ItemPO',-1) ))+" of "+ALLTRIM(STR(nCntPOitem))
		*!*		ThisformSet.frmHPAPO.spnPOitem.SpinnerHighValue = nCntPOitem
		*!*		ThisformSet.frmHPAPO.spnPOitem.Value = nCurrItem 
		*!*		
		*!*	ENDIF
		
		*!*	IF USED("tmpRecPO")
		*!*		SELECT tmpRecPO
		*!*		LOCATE FOR POItem = cPOitem
		*!*		
		*!*		ThisFormSet.frmPOs.Refresh
		*!*		
		*!*		ThisFormSet.Show_Receiving_POitem(cPOitem)
		*!*		
		*!*	ENDIF
	ENDPROC

	PROCEDURE showprevotherp
		*ShowPrevOtherP()
		
		PRIVATE cPOItem
		cPOItem = PrepareSQLtxt(ThisFormset.frmVendor_Invoice.txtPOitem.Value,'POitem',13)
		
		IF USED('tmpRecvUnits')
			USE IN tmpRecvUnits
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		*cSQL = "SELECT SUM(ActualW) AS Actual_Tot" &&, SUM(BillW) AS Bill_Tot
		cSQL = "SELECT SUM(Order_OtherP) AS Order_OtherPtot "
		cSQL = cSQL + ", SUM(Recv_OtherP) AS Recv_OtherPtot "
		cSQL = cSQL + " FROM dbo.Vendor_Invoice_Detail "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPOitem+"')"
		*cSQL = cSQL + " AND ISNULL(Cancelled,0) = 0 "
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRecvUnits')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRecvUnits')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvUnits")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvUnits")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpRecvUnits' )
		ENDIF
		
		PRIVATE nAcct_OtherPtot, nPO_OtherPtot
		nAcct_OtherPtot = 0
		nPO_OtherPtot = 0
		
		IF USED('tmpRecvUnits')
			IF RECCOUNT('tmpRecvUnits') > 0
				nAcct_OtherPtot = PrepareSQLnum(tmpRecvUnits.Order_OtherPtot,'Order_OtherP',-5)
				nPO_OtherPtot 	= PrepareSQLnum(tmpRecvUnits.Recv_OtherPtot,'Acct_OtherP',-5)
			ENDIF
			USE IN tmpRecvUnits
		ENDIF
		
		
		ThisFormset.frmVendor_Invoice.txtS_AP_OtherP.Value  = nAcct_OtherPtot 
		ThisFormset.frmVendor_Invoice.txtPO_AP_OtherP.Value = nPO_OtherPtot 
		
	ENDPROC

	PROCEDURE showreceivetot
		
		*Retreives from Receiving
		*ThisFormSet.ShowReceiveTot()
		
		PRIVATE cPOItem
		cPOItem = PrepareSQLtxt(ThisFormset.frmVendor_Invoice.txtPOitem.Value,'POitem',13)
		
		IF USED('tmpRecvUnits')
			USE IN tmpRecvUnits
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		*cSQL = "SELECT SUM(ActualW) AS Actual_Tot" &&, SUM(BillW) AS Bill_Tot
		cSQL = "SELECT SUM(R_QTY) AS S_QTYtot, SUM(PO_QTY) AS PO_QTYtot "
		cSQL = cSQL + " FROM dbo.Receiving "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(Cancelled,0) = 0 "
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRecvUnits')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRecvUnits')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvUnits")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecvUnits")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpRecvUnits' )
		ENDIF
		
		PRIVATE nS_QTYtot, nPO_QTYtot
		nS_QTYtot = 0
		nPO_QTYtot = 0
		
		IF USED('tmpRecvUnits')
			IF RECCOUNT('tmpRecvUnits') > 0
				nS_QTYtot = PrepareSQLnum(tmpRecvUnits.S_QTYtot,'S_QTY',-5)
				nPO_QTYtot = PrepareSQLnum(tmpRecvUnits.PO_QTYtot,'PO_QTY',-5)
			ENDIF
			USE IN tmpRecvUnits
		ENDIF
		
		
		ThisFormset.frmVendor_Invoice.txtS_QTYtot.Value  = nS_QTYtot
		ThisFormset.frmVendor_Invoice.txtPO_QTYtot.Value = nPO_QTYtot
		
	ENDPROC

	PROCEDURE showrecentinv
		*ThisFormSet.ShowRecentInv()
		
		ThisFormSet.frmRecentInv.Visible = .F.
		ThisFormSet.frmRecentInv.grdPO_VI.RecordSource = ''
		
		IF USED('tmpPO_VI')
			USE IN tmpPO_VI
		ENDIF
		
		SELECT 0
			
		cSQL = "SELECT DISTINCT Vendor_Invoice "
		cSQL = cSQL + " FROM dbo.Vendor_Invoice WHERE HPAPO IN ("
		cSQL = cSQL + " 	SELECT TOP 10 "
		cSQL = cSQL + " 	PurchaseOrder.HPAPO "
		cSQL = cSQL + " 	FROM dbo.PurchaseOrder "
		cSQL = cSQL + " 		JOIN dbo.PurchaseOrder AS P2 ON PurchaseOrder.VendCode = P2.VendCode "
		cSQL = cSQL + " 	WHERE P2.HPAPO = "+STR(ThisFormset.nHPAPO)
		cSQL = cSQL + " 	AND PurchaseOrder.OrderDate > GetDate()-450"
		cSQL = cSQL + " 	ORDER BY HPAPO DESC"
		cSQL = cSQL + " )"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO_VI')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO_VI')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_VI")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_VI")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpPO_VI' )
		ENDIF
		
		IF USED('tmpPO_VI')
			IF RECCOUNT('tmpPO_VI') > 0
				ThisFormSet.frmRecentInv.Visible = .T.
				ThisFormSet.frmRecentInv.grdPO_VI.RecordSource = 'tmpPO_VI'
				ThisFormSet.frmRecentInv.grdPO_VI.Refresh	
			ENDIF
			
			*USE IN tmpPO_VI
		ENDIF
		
		
	ENDPROC

	PROCEDURE show_po_item
		PARAMETERS cPOitem
		*ThisFormSet.Show_PO_Item()
		
		IF USED('tmpHPAPo')
			SELECT tmpHPAPo
			LOCATE FOR POItem = cPOitem
				
			ThisFormSet.frmHPAPO.Caption = "ERP PO: " + ShowSQLtxt(Company,'Company',30)
			
			ThisFormSet.frmHPAPO.cmdViewPOitem.Caption = ShowSQLtxt("View PO: "+ALLTRIM(cPOitem) ,'vPOitem',21)
			
			cAlloy = " Alloy:"+PrepareSQLtxt(Alloy,'Alloy',10)+" CC:"+PrepareSQLtxt(CC,'cc',1)
			cAlloy = cAlloy+" CL:"+PrepareSQLtxt(CL,'CL',1)
			
			ThisFormSet.frmHPAPO.txtAlloy.Value = PrepareSQLtxt(cAlloy ,'cAlloy ',100)
			
			cItemDescription = ItemDescription(Form, thck, SZ2, SZ3, StockLst_QTY, Randlen)
			ThisFormSet.frmHPAPO.txtDescription.Value = ShowSQLtxt(cItemDescription,'ItemDescription',200)
		
			cItemDescriptionMetric = ItemDescriptionMetric(Form,thck,SZ2,SZ3,Order_QTY,RandLen, Metric, Sz1orig, Sz2orig, Sz3orig)
			IF cItemDescription != cItemDescriptionMetric 
				ThisFormSet.frmHPAPO.txtDescriptionMetric.Visible = .T.
				ThisFormSet.frmHPAPO.txtDescriptionMetric.Value = PrepareSQLtxt(cItemDescriptionMetric,'ItemDescriptionMetric ',200)
			ELSE
				ThisFormSet.frmHPAPO.txtDescriptionMetric.Visible = .F.
				ThisFormSet.frmHPAPO.txtDescriptionMetric.Value = ''
			ENDIF
		
			PRIVATE cReceiveDesc
		*	PRIVATE cPOitem
		*	cPOitem = Proper_PO_Item(ThisFormset.frmVendor_Invoice.txtPOitem.Value)
			
			IF cPOitem != Proper_PO_Item('')
			
				IF ThisFormSet.frmVendor_Invoice.txtPOitem.Value <> cPOitem
				
					SELECT tmpVIDunion
					PRIVATE nCurRec 
					nCurRec = RECNO('tmpVIDunion')
					
					LOCATE FOR POitem = cPOitem 
					IF NOT FOUND('tmpVIDunion')
						*WAIT WINDOW "This is not the POitem on the Invoice!" NOWAIT
						MESSAGEBOX("This POitem is not found for this Invoice.",0+48,"")
					ENDIF
					
					IF nCurRec > 0
						IF RECCOUNT('tmpVIDunion') = 0
							MESSAGEBOX("'tmpVIDunion' is empty"+CHR(13)+"dbo.PurchaseOrder was probably mis-marked as Reconciled or Cancelled",0+16,"Error")
							TrackError("'tmpVIDunion' is empty"+CHR(13)+"dbo.PurchaseOrder was probably mis-marked as Reconciled or Cancelled","PurchaseOrder was probably mis-marked as Reconciled or Cancelled", PROGRAM(), LINENO(1))
							RETURN .F.
						ENDIF
						IF RECCOUNT() <= nCurRec 
							GOTO nCurRec 
						ENDIF
					ENDIF
				ENDIF
				
				SELECT tmpHPAPo
				
				cReceiveDesc = ReceiveDesc_POitem( cPOitem, ThisFormSet.nConnHandle )
				ThisFormSet.frmHPAPO.txtDescriptionReceive.Value = ShowSQLtxt(cReceiveDesc,'ReceiveDesc',200)
			ENDIF
		
		
			ThisFormSet.frmHPAPO.txtOrder_P.Value 	= PrepareSQLnum(Order_P ,'Order_P',10,4)
			ThisFormSet.frmHPAPO.txtOrder_Qty.Value = PrepareSQLnum(Order_QTY ,'Order_QTY',10,4)
			ThisFormSet.frmHPAPO.txtOrderTotal.Value = PrepareSQLnum(Order_P*Order_QTY ,'Order_QTY',10,4)
			
			ThisFormSet.frmHPAPO.txtS_P.Value 	= PrepareSQLnum(StockLst_P,'S_P',10,4)
			ThisFormSet.frmHPAPO.txtS_Qty.Value = PrepareSQLnum(StockLst_QTY,'S_QTY',10,4)
			ThisFormSet.frmHPAPO.txtS_Total.Value = PrepareSQLnum(StockLst_Total,'S_Total',10,4)
		
			ThisFormSet.frmHPAPO.txtOtherP.Value = PrepareSQLnum(OtherP,'OtherP',10,4)
			ThisFormSet.frmHPAPO.txtOtherFld.Value = ShowSQLtxt(OtherFld,'OtherFld',10)
				
			ThisFormSet.frmHPAPO.txtOrderDate.Value = PrepareSQLdate(OrderDate,'OrderDate')
			ThisFormSet.frmHPAPO.txtDue_Min.Value = PrepareSQLdate(Due_Min,'Due_Min')
			ThisFormSet.frmHPAPO.txtDue_Max.Value = PrepareSQLdate(Due_Max,'Due_Max')
		
			ThisFormSet.frmHPAPO.lblDelivered.Visible = PrepareSQLchk(Delivered,'Delivered')
			ThisFormSet.frmHPAPO.txtReceived.Visible  = PrepareSQLchk(Delivered,'Delivered')
			ThisFormSet.frmHPAPO.txtReceived.Value = PrepareSQLdate(Received,'Received')
		
			ThisFormSet.frmHPAPO.edtCond_Spec.Value = ShowSQLtxt(cond_spec,'cond_spec',-1)
			ThisFormSet.frmHPAPO.edtMisc_Purch.Value = ShowSQLtxt(Misc_Purch,'Misc_Purch',-1)
			
			ThisFormSet.frmHPAPO.txtHeat.Value 		= ShowSQLtxt(LEFT(Heat,35),'Heat',35)
			ThisFormSet.frmHPAPO.txtReceivedBy.Value = ShowSQLtxt(ReceivedBy,'ReceivedBy',10)
			ThisFormSet.frmHPAPO.lblCancelled.Visible = PrepareSQLchk(cancelled,'cancelled')
			
			ThisFormSet.frmHPAPO.lblHPApo.Caption = ALLTRIM(STR(PrepareSQLnum(tmpHPAPo.HPApo,'HPApo',-3)))
			
			PRIVATE nCntPOitem, nCurrItem 
			nCntPOitem = PrepareSQLnum(ThisFormSet.frmHPAPO.txtPOcnt.Value,'POcnt',-3) 
			IF nCntPOitem = 0
				nCntPOitem = Count_POItemsinPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
				ThisFormSet.frmHPAPO.txtPOcnt.Value = nCntPOitem 
			ENDIF
			
			nCurrItem = IIF(PrepareSQLnum(tmpHPAPo.ItemPO,'ItemPO',-1)=0,1,PrepareSQLnum(tmpHPAPo.ItemPO,'ItemPO',-1))
			ThisFormSet.frmHPAPO.txtPOcnt.Value = PrepareSQLnum(nCntPOitem,'POcnt',-1)
		
			ThisFormSet.frmHPAPO.lblCurrItem.Caption = "item "+ALLTRIM(STR( PrepareSQLnum(nCurrItem,'ItemPO',-1) ))+" of "+ALLTRIM(STR(nCntPOitem))
			
			IF nCntPOitem = 1
				ThisformSet.frmHPAPO.spnPOitem.Enabled = .F.
				ThisformSet.frmHPAPO.spnPOitem.SpinnerHighValue = nCntPOitem
				ThisformSet.frmHPAPO.spnPOitem.Value = nCurrItem 	
			ELSE
				ThisformSet.frmHPAPO.spnPOitem.Enabled = .T.
				ThisformSet.frmHPAPO.spnPOitem.SpinnerHighValue = nCntPOitem
				ThisformSet.frmHPAPO.spnPOitem.Value = nCurrItem 
			ENDIF
			
		ENDIF
		
		IF USED("tmpRecPO")
			SELECT tmpRecPO
			LOCATE FOR POItem = cPOitem
			
			ThisFormSet.frmPOs.Refresh
			
			ThisFormSet.Show_Receiving_POitem(cPOitem)
			
		ENDIF
	ENDPROC

	PROCEDURE show_receiving_rid
