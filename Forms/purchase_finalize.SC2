	PROCEDURE frmSO.txtHPAPO.LostFocus
		PRIVATE nHPApo
		nHPApo = PrepareSQLnum(This.Value,'HPAPO',-3)
		
		IF nHPApo > 0
			IF USED('SO')
				SELECT SO
				LOCATE FOR HPAPO = nHPApo
				IF FOUND('SO')
					ThisForm.grdSO.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmSO.txtHPAPO.Valid
		*IF NOT EMPTY(This.Value)
		*	ThisForm.cmdGetPO.Click
		*ENDIF
		
		PRIVATE nHPApo
		nHPApo = PrepareSQLnum(This.Value,'HPAPO',-3)
		
		IF nHPApo > 0
			IF USED('SO')
				SELECT SO
				LOCATE FOR HPAPO = nHPApo
				IF FOUND('SO')
					ThisForm.grdSO.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

