	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmp_SD_PS.cancelled,,RGB( 255, 0, 0 ),IIF(tmp_SD_PS.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		
		*!*	DO CASE
		*!*	CASE tmp_SD_PS.cancelled
		*!*		nColor = RGB( 255, 0, 0 ) &&RED	
		*!*	CASE tmp_SD_PS.delivered
		*!*		nColor = RGB( 128, 128, 128 )  &&Grey
		*!*	OTHERWISE 
				nColor = RGB( 255, 255, 255 ) &&WHITE
		*!*	ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pcSOitem, pnSales_Detail_ID
		*DO FORM Forms\ChooseSD_PackingSli WITH ' 104225-01',pnSales_Detail_ID
		*Send pnSales_Detail_ID or if Negative ThisForm.nRMA_Detail_ID = - pnSales_Detail_ID
			
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF USED("tmpSales_Detail_PackingSlip")
			USE IN tmpSales_Detail_PackingSlip
		ENDIF
		IF USED("tmp_SD_PS")
			USE IN tmp_SD_PS
		ENDIF
		
		IF VARTYPE("pcSOitem") != "C"
			RETURN
		ENDIF
		
		IF Proper_SO_Item(pcSOitem) = Proper_SO_Item('')
			RETURN
		ENDIF
		
		IF VARTYPE(pnSales_Detail_ID) != "N"
			RETURN
		ENDIF
		
		IF pnSales_Detail_ID < 0
			*RMA_Detail.RMA_Detail_ID
			ThisForm.nSales_Detail_ID = 0
			ThisForm.nRMA_Detail_ID = - pnSales_Detail_ID
			ThisForm.cmdMark.Visible = .T.
			ThisForm.txtRMA_Detail_ID.Visible = .T.
			ThisForm.Grd.Height = ThisForm.Grd.Height - 32	&&make smaller
		ELSE
			ThisForm.nSales_Detail_ID = pnSales_Detail_ID
			ThisForm.nRMA_Detail_ID = 0
		ENDIF
		
		*************************
		
		ThisForm.Caption = ThisForm.Caption+" for SO item '"+pcSOitem+"'"
		
		IF USED('tmp_SD_PS')
			USE IN tmp_SD_PS
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT PackingSli,SOitem,Descript,QTY,Pieces,Pounds,[When] "
		cSQL = cSQL + ",0 AS Sales_Detail_ID, 0 AS RMA_Detail_ID, Heat "
		cSQL = cSQL + " FROM dbo.Sales_Detail_PackingSlip "
		cSQL = cSQL + " WHERE SOitem = '"+(pcSOitem)+"'"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT PackingSli,SOitem,Descript,Removed_QTY AS QTY,Removed_PC AS Pieces,Removed_LBS AS Pounds,[WhenAdd] AS [When] "
		cSQL = cSQL + ",ID AS Sales_Detail_ID, RMA_Detail_ID, Heat "
		cSQL = cSQL + " FROM dbo.Sales_Detail "
		cSQL = cSQL + " WHERE SOitem = '"+(pcSOitem)+"'"
		IF ThisForm.nRMA_Detail_ID > 0
			cSQL = cSQL + " OR Sales_Detail.RMA_Detail_ID ="+STR( ThisForm.nRMA_Detail_ID )
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_SD_PS')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmp_SD_PS' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_SD_PS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_SD_PS")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmp_SD_PS' )
		ENDIF
		
		IF NOT USED('tmp_SD_PS')
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmp_SD_PS') = 0
			RETURN .F.
		ENDIF
			
		ThisForm.grd.RecordSource = "tmp_SD_PS"
		ThisForm.grd.ColumnCount = 5
		
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		
		ThisForm.grd.Column1.Controlsource = "tmp_SD_PS.PackingSli"
		ThisForm.grd.Column2.Controlsource = "tmp_SD_PS.SOitem"
		*ThisForm.grd.Column3.Controlsource = "tmp_SD_PS.Descript"
		*ThisForm.grd.Column4.Controlsource = "tmp_SD_PS.QTY"
		*ThisForm.grd.Column5.Controlsource = "tmp_SD_PS.Pieces"
		ThisForm.grd.Column3.Controlsource = "tmp_SD_PS.Pounds"
		ThisForm.grd.Column4.Controlsource = "tmp_SD_PS.Heat"
		ThisForm.grd.Column5.Controlsource = "tmp_SD_PS.RMA_Detail_ID"
		
		ThisForm.grd.Column1.Header1.Caption= "PackingSli"
		ThisForm.grd.Column2.Header1.Caption= "SoItem"
		*ThisForm.grd.Column3.Header1.Caption= "Descript"
		*ThisForm.grd.Column4.Header1.Caption= "QTY"
		*ThisForm.grd.Column5.Header1.Caption= "Pieces"
		ThisForm.grd.Column3.Header1.Caption= "Pounds"
		ThisForm.grd.Column4.Header1.Caption= "Heat"
		ThisForm.grd.Column5.Header1.Caption= "RMA_Detail_ID"
		
		********************************
		ThisForm.txtHeat.Value			= PrepareSQLtxt(tmp_SD_PS.Heat,'Heat',50)
		ThisForm.txtPackingSli.Value	= PrepareSQLnum(tmp_SD_PS.PackingSli,'PackingSli',-3)
		ThisForm.txtRMA_Detail_ID.Value	= PrepareSQLnum(tmp_SD_PS.RMA_Detail_ID,'RMA_Detail',-3)
		*SOitem
		ThisForm.txtDescription.Value	= PrepareSQLtxt(tmp_SD_PS.Descript,'Descript',100)
		
		Thisform.txtPieces.Value	= PrepareSQLnum(tmp_SD_PS.Pieces,'Pieces',-3)
		ThisForm.txtQTY.Value		= PrepareSQLnum(tmp_SD_PS.QTY,'QTY',-5)
		Thisform.txtPounds.Value 	= PrepareSQLnum(tmp_SD_PS.Pounds,'Pounds',-3)
		ThisForm.txtWhen.Value 		= PrepareSQLdate(tmp_SD_PS.When,'When')
		
		********************************
		
				
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nHigh, nWidth
		
		nHigh = ThisForm.Height - 281
		nWidth = ThisForm.Width - 592
		
		ThisForm.grd.Width = 580 + nWidth
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmp_SD_PS')
			USE IN tmp_SD_PS
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
		*RETURN
	ENDPROC

	PROCEDURE cmdCancel.Click
		*!*	PRIVATE cHoldNumber
		*!*	cHoldNumber = ""
		*!*	ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdMark.Click
		*ThisForm.HoldNumber = cHoldNumber 
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE nRMA_Detail_ID, nSales_Detail_ID,nPackingSli 
		*nPackingSli = PrepareSQLnum(tmp_SD_PS.PackingSli,'PackingSli',-3)
		nRMA_Detail_ID = ThisForm.nRMA_Detail_ID
		nSales_Detail_ID = PrepareSQLnum(tmp_SD_PS.Sales_Detail_ID,'Sales_Detail_ID',-3)
		
		*Save to Return the PackingSli
		nPackingSli = PrepareSQLNum(tmp_SD_PS.PackingSli,'PavkingSli',-3)
		ThisForm.HoldNumber = nPackingSli 
		
		IF nRMA_Detail_ID > 0
		
			IF ThisForm.txtRMA_Detail_ID.Value > 0
				IF MESSAGEBOX("Do you wish to UNMark this?"+CHR(13)+"for RMA Detail="+ALLTRIM(STR(nRMA_Detail_ID)),4,"UnMark") = 6
					*UPDATE Sales_Detail
					cSQL = "UPDATE dbo.Sales_Detail "
					cSQL = cSQL +" SET RMA_Detail_ID = 0 "
					cSQL = cSQL +" WHERE ID = "+STR(nSales_Detail_ID)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
						lOK = .F.
					ENDIF
		
					IF lOK
						UPDATE tmp_SD_PS SET RMA_Detail_ID = 0
						ThisForm.grd.Refresh
						ThisForm.txtRMA_Detail_ID.Value = 0
						MESSAGEBOX("Removed RMA Detail "+ALLTRIM(STR(nRMA_Detail_ID))+" from dbo.Sales_Detail",0,"Done") 
					ENDIF
				ENDIF
			ELSE
				*UPDATE Sales_Detail
				cSQL = "UPDATE dbo.Sales_Detail "
				cSQL = cSQL +" SET RMA_Detail_ID = "+STR(nRMA_Detail_ID)
				cSQL = cSQL +" WHERE ID = "+STR(nSales_Detail_ID)
				*cSQL = cSQL +" AND SOitem = '"+cSOitem+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					lOK = .F.
				ENDIF
		
				IF lOK
					UPDATE tmp_SD_PS SET RMA_Detail_ID = nRMA_Detail_ID
					ThisForm.grd.Refresh
					ThisForm.txtRMA_Detail_ID.Value = nRMA_Detail_ID
					MESSAGEBOX("Saved RMA Detail "+ALLTRIM(STR(nRMA_Detail_ID))+" to dbo.Sales_Detail ",0,"Saved") 
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.cmdSelect.Visible = .T.
		
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		*ThisForm.HoldNumber = cHoldNumber 
		PRIVATE lOK
		lOK = .F.
		
		
		PRIVATE nPackingSli, nSales_Detail_ID
		nPackingSli = PrepareSQLNum(tmp_SD_PS.PackingSli,'PavkingSli',-3)
		*nSales_Detail_ID = ThisForm.nSales_Detail_ID
		
		
		IF ThisForm.HoldNumber > 0
			lOK = .T.
		ELSE
			IF ThisForm.nRMA_Detail_ID > 0 
				*Return the PackingSli
				ThisForm.HoldNumber = nPackingSli 
				lOK = .T.
			ENDIF	
		ENDIF
		
		IF lOK
			ThisForm.Release
		ELSE
			MESSAGEBOX("Nothing has been stored to Return"+CHR(13)+"",0,"error")
		ENDIF
	ENDPROC

ENDDEFINE
