	PROCEDURE Show_Recv_Order.lblSz2.Click
		
		*!*	cSOitem = Proper_SO_item(ThisFormSet.cSOitem)
		*!*	cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
		*!*	cSalesPerson = ''
		*!*	dtStartDate = DATETIME()
		*!*	dDueDate = DATE()+2 
		*!*	cComment = ''
		*!*	cProcess_ID	= "INCOMING"
		*!*	nReceivingID		= ThisFormSet.nReceivingID
		*!*	cProcessor = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
		*!*	cAllowSub	= 'N'
		*!*	cForm = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		*!*	nPU =  GetPUfromForm(cForm, ThisFormSet.nConnhandle)  
		*!*	nQTY_P = 0
		*!*	nQTY = 0
		*!*	nPounds = 0
		*!*	nID_Detail = 0
		*!*	nID_Detail_Process = 0
		*!*	nWO			= 0
		*!*	nWO_Detail	= ThisFormSet.nWO_Detail
	ENDPROC

	PROCEDURE Show_Recv_Order.ogPOitem.InteractiveChange
		
		*Check to see if changed.
		PRIVATE lComplete, nCnt, nMess
		lComplete = (This.Value = 1)
		nCnt = 0
		
		IF ThisForm.cmdJustEdit.Visible
			*Save here, the Just Editing has no save mechanism.
			
			IF ThisFormSet.nWO_Detail > 0
				*Check by WO_Detail, ThisFormSet.nWO_Detail
		
				nCnt = Count_WODinWO_Detail( ThisFormSet.nWO_Detail, ThisFormSet.nConnhandle, "COMPLETE" )
				IF lComplete 
					IF nCnt > 0
						*good
					ELSE
						*Needs to be marked as delivered.
						nMess = MESSAGEBOX("Are you sure you want mark this WO Detail as Complete!",4+32,"Completed Item")
						IF nMess = 6
							RETURN ThisForm.MarkWOD_Complete(.T.)
						ELSE
							RETURN .F.
						ENDIF
					ENDIF
				ELSE
					IF nCnt > 0
						*Need to remove the Complete!
						nMess = MESSAGEBOX("Are you sure you want mark this WO Detail as NOT Complete!",4+32,"NOT Completed Item")
						IF nMess = 6
							RETURN ThisForm.MarkWOD_Complete(.F.)
						ELSE
							RETURN .F.
						ENDIF
					ELSE
						*Good
					ENDIF
				ENDIF
				
			ELSE
				*Check by POitem, ThisFormSet.cPOitem = cPOitem
				nCnt = Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle, "DELIVERED" )
				IF lComplete 
					IF nCnt > 0
						*good
					ELSE
						*Needs to be marked as delivered.
						nMess = MESSAGEBOX("Are you sure you want mark this POitem as Complete!",4+32,"Completed Item")
						IF nMess = 6
							lOK =  ThisForm.MarkSOitemComplete(.T.)
							RETURN lOK
							*RETURN ThisForm.MarkSOitemDelivered(.T.)
						ELSE
							RETURN .F.
						ENDIF
					ENDIF
				ELSE
					IF nCnt > 0
						*Need to remove the Complete!
						nMess = MESSAGEBOX("Are you sure you want mark this POitem as NOT Complete!",4+32,"NOT Completed Item")
						IF nMess = 6
							RETURN ThisForm.MarkSOitemComplete(.F.)
						ELSE
							RETURN .F.
						ENDIF
					ELSE
						*Good
					ENDIF
				ENDIF
		
				
			ENDIF
		ELSE
			*Save on other Good cmd buttons
		ENDIF
	ENDPROC

ENDDEFINE
