	PROCEDURE Receive_Edit.cmdAdd.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		lReady2Save = ThisFormSet.CheckSave()
		
		IF lReady2Save
			IF nReceivingID = 0
				IF ThisFormSet.SaveAdd("ADD")
					ThisForm.Release
				ELSE
					RETURN .F.
				ENDIF
			ELSE
				IF ThisFormSet.SaveAdd("EDIT")
					ThisForm.Release
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
		
		
	ENDPROC

