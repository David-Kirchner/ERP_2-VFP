	PROCEDURE Receive_Edit.cmdClone.Valid
		*Clone this heat/Lot
		
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		IF nReceivingID = 0
			MESSAGEBOX("Save Receive first"+CHR(13)+"You do not have enough info to clone",0,"Cannot Clone")
			TrackError("Cannont Clone because Receive=0","Cannont Clone Receive", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE nID_Master, nID_Detail, cTBL
		nID_Master	= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		IF nID_Master > 0 AND nID_Detail > 0 AND LEN(cTBL) > 1	
			MESSAGEBOX("Clone is only for receives to same master record"+CHR(13)+"The master will have the save Heat / Lot"+CHR(13)+"the clone receive will be another stock detail record."+CHR(13)+CHR(13)+"You do not have enough info to clone"+CHR(13)+"Need Stock ID and what Table",0,"Cannot Clone")
			TrackError("Cannont Clone Receive "+STR(nReceivingID),"Cannont Clone Receive", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE cHeat, cLot
		cHeat	= UPPER(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.f.))
		cLot 	= UPPER(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		
		
		PRIVATE nMess
		nMess = MESSAGEBOX("Clone is only for receives to same master record"+CHR(13)+"The master will have the same Heat / Lot"+CHR(13)+cHeat+" "+cLot+CHR(13)+"the cloned receive will be saved as another stock detail record."+CHR(13)+CHR(13)+"Make the clone record?",4+32,"Ready to Clone?")
		
		IF nMess <> 6
			RETURN .F.
		ENDIF
		
		************************************
		
		ThisForm.txtReceivingID.Value = 0
		ThisForm.txtID_Detail.Value = 0
		ThisForm.txtID_Detail_Process.Value = 0
		
		This.Visible = .F.
		ThisFormSet.lClone = .T.
		ThisFormSet.cWhat = "ADD"
		ThisForm.lblWhat.Caption = 'ADD'
		
		ThisForm.txtAlloy.Enabled = .F.
		ThisForm.lblHeat.Visible = .F.
		ThisForm.txtHeat.Enabled = .F.
		ThisForm.txtLot.Enabled = .F.
		
		ThisForm.cmdEditHeat.Visible = .F.
			
		MESSAGEBOX("The Receiving ID has been set to 0"+CHR(13)+CHR(13)+"This record is ready to edit and Save"+CHR(13)+CHR(13)+"Cannot edit the Heat, Lot or Alloy!",0+64,"Cloned")
		
		*!*		
		*!*	PRIVATE lReady2Save
		*!*	lReady2Save = .T.
		*!*	lReady2Save = ThisFormSet.CheckSave()
		
		*!*	IF lReady2Save
		*!*		IF nReceivingID = 0
		*!*			IF ThisFormSet.SaveAdd("ADDCLONE")
		*!*			
		*!*				*IF NOT ThisForm.txtHeat.Value = '*'
		*!*				*	ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
		*!*				*ENDIF
		*!*				ThisForm.txtReceivingID.Value = 0
		*!*				*ThisForm.txtID_Master.Value = 0
		*!*				ThisForm.txtID_Detail.Value = 0
		*!*				ThisForm.txtID_Detail_Process.Value = 0
		
		*!*				MESSAGEBOX("Receive Saved."+CHR(13)+"This NEW ClONE screen is now ready"+CHR(13)+"to Edit and Save.",0,"Saved")
		*!*				
		*!*			ELSE
		*!*				RETURN .F.
		*!*			ENDIF
		*!*			
		*!*		ELSE
		*!*			IF ThisFormSet.SaveAdd("EDIT")
		*!*				*IF NOT ThisForm.txtHeat.Value = '*'
		*!*				*	ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
		*!*				*ENDIF
		*!*				ThisForm.txtReceivingID.Value = 0
		*!*				MESSAGEBOX("Edited Saved."+CHR(13)+"This is screen is now ready.",0,"Saved")
		*!*			ELSE
		*!*				RETURN .F.
		*!*			ENDIF		
		*!*		ENDIF
		*!*	ELSE
		*!*		IF MESSAGEBOX("Could not Save"+CHR(13)+"Do you want still need to clone (Y)"+CHR(13)+"a new receive?",4+32,"Clone NEW") = 6
		*!*			*IF NOT ThisForm.txtHeat.Value = '*'
		*!*			*	ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
		*!*			*ENDIF
		*!*			*ThisForm.txtLot.Value = ''
		*!*			ThisForm.txtReceivingID.Value = 0
		*!*			*ThisForm.txtID_Master.Value = 0
		*!*			ThisForm.txtID_Detail.Value = 0
		*!*			ThisForm.txtID_Detail_Process.Value = 0
		*!*			
		*!*			MESSAGEBOX("New receive Saved."+CHR(13)+"This is cloned screen is now ready edit and Save.",0,"Saved")
		*!*		ELSE
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.cmdEditHeat.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat, cLot, cAlloy
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy 	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cHeat 	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot 	= PrepareSQLtxt(Thisform.txtLot.Value,'Lot',10)
		
		PRIVATE nMess, cSQLu, cSQL, nSQLEXEC 
		IF nReceivingID > 0
			nMess = MESSAGEBOX("Are you sure you want to edit the Heat/Lot ?"+CHR(13)+"for this receive"+CHR(13)+"Save Heat "+cHeat+cLot,4+32,"Save Heat")
			IF nMess = 6
				**
				cSQLu = "UPDATE dbo.Receiving SET"
				cSQLu = cSQLu +" Heat='"+cHeat+"'"
				cSQLu = cSQLu +",Lot='"+cLot+"'"		
				cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
					lSaved = .F.
					TrackError("Update Receiving Heat by ReceivingID. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
					*RETURN
				ELSE 
				*** Update Stock!
					PRIVATE nID_Master, nID_Detail, nID_Detail_PRC, cTBL, cForm
					nID_Master = PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
					nID_Detail = PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
					nID_Detail_PRC = PrepareSQLnum(Thisform.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
					cTBL 		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
					
					cSQL = ''
					IF cTBL = "S"
						IF nID_Master > 0
							cSQL = "UPDATE dbo.StockLst_Master "
							cSQL = cSQL + " SET Heat='"+cHeat+"'"
							cSQL = cSQL + ",Lot='"+cLot+"'"	
							cSQL = cSQL + " WHERE ID="+STR(nID_Master)
						ENDIF
					ENDIF
					IF cTBL = "B"
						IF nID_Master > 0
							cSQL = "UPDATE dbo.BrokerLst_Master "
							cSQL = cSQL + " SET Heat='"+cHeat+"'"
							cSQL = cSQL + ",Lot='"+cLot+"'"	
							cSQL = cSQL + " WHERE ID="+STR(nID_Master)
						ENDIF
					ENDIF
					IF cTBL = "W"
						IF nID_Master > 0
							cSQL = "UPDATE dbo.WIPLst_Master "
							cSQL = cSQL + " SET Heat='"+cHeat+"'"
							cSQL = cSQL + ",Lot='"+cLot+"'"	
							cSQL = cSQL + " WHERE ID="+STR(nID_Master)
						ENDIF
					ENDIF
					
					
					IF LEN(cSQL) > 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
							TrackError("Update Heat in Receiving. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
							*RETURN
						ENDIF
					ENDIF
					
					MESSAGEBOX("Save Heat routine done",0,"Finished")
					
					*****	
					ThisForm.Release
					
					*****
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("This is to change a Saved Receive",0,"No Receiving ID")
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.lblActualLbs.Click
		PRIVATE nActualW, nAcct_PU, nPO_PU, nWO_Detail
		nActualW = PrepareSQLnum(ThisForm.txtActualW.Value,'Actual',9,1)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nActualW > 0
			nAcct_PU = PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
			
			IF nAcct_PU = 0 AND nWO_Detail > 0
				nAcct_PU = 1
				ThisForm.lblAcct_PU.Caption = '1'
				ThisForm.lblAcct_PUstr.Caption	 = Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
				ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle )
		
		
				ThisForm.lblPO_PU.Caption = '1'
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle )
		
			ENDIF
		
			IF nAcct_PU = 1
				ThisForm.txtAcct_Qty.Value = nActualW 
				IF nWO_Detail > 0
		
					ThisForm.txtPO_QTY.Value = nActualW 
				ENDIF
			ENDIF
			
			nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
			IF nPO_PU = 1
				ThisForm.txtPO_QTY.Value = nActualW 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.lblChooseReceivingID.Click
		PRIVATE cPOitem, nHpaPo, nItemPo, nReceiveID, nWO
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo = 0
			nItemPo = 1
		ENDIF
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO 	= PrepareSQLnum(This.Parent.txtWO.Value,'WO',-3)
		
		nReceiveID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE nMess
		IF ( cPOitem != Proper_PO_Item(cPOitem) AND nWO=0 )
			MESSAGEBOX("Did not find a POitem or WO to use to look up for an Receive",16,"Fail")
			RETURN .F.
		ENDIF
		
		IF nReceiveID > 0
			nMess = MESSAGEBOX("ReceivingID="+ALLTRIM(STR(nReceiveID))+CHR(13)+"Do you wish to reset Receiving ID to 0? (Y)"+CHR(13)+"Reseting to 0 will allow you to receive another Heat/Lot!"+CHR(13)+CHR(13)+"Answer (N) to open a window to choose a Receiving ID to Edit.",4+32,"Create new Receiving Record?")
			IF nMess = 6
				This.Parent.txtReceivingID.Value =0
				*This.Parent.txtID_Detail.Value	= 0
				*This..cmdEdit.Visible = .F.
				
				RETURN .T.
			ENDIF
		ENDIF
		
		IF nHPAPO > 0
			DO FORM Forms\ChooseReceivingID WITH cPOitem, "POitem" TO nReceiveID
			IF nReceiveID > 0
		
				nMess = MESSAGEBOX("Here is a chance to Edit the Receive."+CHR(13)+"ReceivingID="+ALLTRIM(STR(nReceiveID))+CHR(13)+"Do you want to Edit this data?",4+32+256,"Edit this Receive Data") 
				IF nMess = 6
					PRIVATE nID_MasterO, nID_DetailO, nID_Detail_ProO, cTBLO
					nID_MasterO	= PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
					nID_DetailO = PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
					nID_Detail_ProO = PrepareSQLnum(Thisform.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
					cTBLO	= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
					
					This.Parent.txtReceivingID.Value = nReceiveID
					ThisFormSet.getBy_ReceivingID()
					
					IF PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3) = 0 AND nID_MasterO > 0
						*Replace the Stock IDs
						Thisform.txtID_Master.Value = nID_MasterO
						Thisform.txtID_Detail.Value = nID_DetailO 
						Thisform.txtID_Detail_Process.Value = nID_Detail_ProO 
						ThisForm.txtTBL.Value = cTBLO
						PRIVATE cMess
						cMess = "Running Receive_Edit and User 'Choose Receiving ID' with now RID="+STR(nReceiveID)+CHR(13)
						cMess = cMess + "That Receive did not have StockTable"+CHR(13)
						cMess = cMess + "So the previous ID's where used update the receive record."+CHR(13)
						cMess = cMess + "ID= "+STR(nID_MasterO)+", ID Detail="+STR(nID_DetailO)+", Proc="+STR(nID_Detail_ProO)+", TBL="+cTBLO
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
						
					ENDIF
				ENDIF
			ELSE
				WAIT WINDOW "No Change to Receiving ID" NOWAIT
			ENDIF	
		ELSE
			MESSAGEBOX("Please enter the ERP PO / POitem to start!",0+48,"No PO number!")
		ENDIF
		
		IF PrepareSQLnum(This.Parent.txtReceivingID.Value,'ReceivingID',-3) > 0
			This.Parent.cmdClone.Visible = .T.
		ELSE
			This.Parent.cmdClone.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.lblDate.Click
		*ThisForm.txtDate.Value = DATE()
		
		PRIVATE dDate1,dDate2
		
		dDate1 = PrepareSQLdate(ThisForm.txtDate.Value,'DueDate',.F.,.T.)
		
		DO FORM "forms\popupdate.scx" WITH dDate1, 'Due Date', ThisForm.txtDate.Top, ThisForm.txtDate.Left TO dDate2
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		dDate2 = PrepareSQLdate(dDate2,'DueDate',.F.,.T.)
		
		ThisForm.txtDate.Value = dDate2
		ThisForm.txtDate.Refresh
	ENDPROC

	PROCEDURE Receive_Edit.lblDescript.Click
		*Retrieve Spec from PO
		
		PRIVATE cPOitem, nHpaPo, nItemPo, nWO_Detail
		nHpaPo		= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail 	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
		
			IF USED('tmpPOp')
				USE IN tmpPOp
			ENDIF
		
			cSQL = "SELECT dbo.f_DescriptionMetricReport(Pieces,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen,0,'','','') AS Descript "
			cSQL = cSQl + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQl + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOp')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOp' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOp' )
			ENDIF
		
			IF USED('tmpPOp')
				IF RECCOUNT('tmpPOp') > 0
					*get PO Item data
					ThisForm.edtDescription.Value = PrepareSQLtxt(tmpPOp.Descript,'Description',-3)
				ENDIF
				USE IN tmpPOp
			ENDIF
		ELSE
			IF nWO_Detail > 0
				IF USED('tmpWODp')
					USE IN tmpWODp
				ENDIF
		
				*cSQL = "SELECT dbo.f_DescriptionMetricReport(Pieces,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen,0,'','','') AS Descript "
				cSQL = "SELECT dbo.f_DescriptionMetricReport(fPieces,fForm,fThck,fSz2,fSz3,fWeight,1,0,'','','') AS Descript "
				cSQL = cSQl + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
				cSQL = cSQl + " WHERE WO_Detail = "+STR(nWO_Detail)
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpWODp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpWODp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpWODp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpWODp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpWODp' )
				ENDIF
		
				IF USED('tmpWODp')
					IF RECCOUNT('tmpWODp') > 0
						*get PO Item data
						ThisForm.edtDescription.Value = PrepareSQLtxt(tmpWODp.Descript,'Description',-3)
					ENDIF
					USE IN tmpWODp
				ENDIF	
			ELSE
				WAIT WINDOW 'Not Found' NOWAIT	
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.lblHeat.Click
		*Look for the Heat by Receiving ID
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat, cLot, cAlloy
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot  = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		IF UPPER(cHeat)  = "DUE IN"
			MESSAGEBOX("This Receive will not save till a Heat is entered.",48,"No Heat")
			cHeat = ""	&&Do not check for Due In
		ENDIF
		
		PRIVATE nReceivingID, nEditReceivingID
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		nEditReceivingID = 0
		
		PRIVATE nMess
		nMess = 6
		
		IF nReceivingID > 0
			nMess = MESSAGEBOX("You already have a Receiving ID"+CHR(13)+"Do you want to use the Heat/Lot"+CHR(13)+"To get another Record to receive?",0+4+32,"Fix a Receive record?")
		ENDIF
		IF nMess = 6
			IF NOT EMPTY(cHeat) 
			*	IF nWO_Detail > 0
			*
			*	ENDIF
			*	IF ( nItemPo < 1 OR nHpaPo < 1 ) AND nWO_Detail = 0
					*Only run here if bad POitem
			*		IF MESSAGEBOX("Do you want to look for a PO that used this heat number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
						*nReceivingID	= Receiving.ID
						
						*IF nWO_Detail > 0
						*ENDIF
						IF nHpaPo > 0 AND nItemPo = 0
							IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
								ThisForm.ChoosePOitemLoad(nHpaPo)
							ENDIF
						ELSE
							IF nHpaPo > 0 AND EMPTY(cHeat) 
								IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
									ThisFormSet.cPOitem = cPOitem
									ThisFormSet.GetPOitemDetail(cPOitem)
								ENDIF
							*ELSE
								*IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
								*	ThisFormSet.cPOitem = cPOitem
								*	ThisForm.GetFromReceiving(cPOitem,nWO_Detail,cHeat,cLot)
								*ENDIF
							ENDIF
						ENDIF
						
						IF USED('Receiving')
							SELECT Receiving
							LOCATE FOR ID = nReceivingID
						ENDIF
							
					*ENDIF
			*	ENDIF
				
			*	IF ( nItemPo < 1 OR nHpaPo < 1 ) OR nWO_Detail > 0
					IF NOT EMPTY(cAlloy)
						********************************	
						*Warn if that Heat/Lot is NOT Unique
						
						
						IF USED("tmpOtherHeat")
							USE IN tmpOtherHeat
						ENDIF
		
		
						cSQL = "SELECT ID, POitem, SOitem, ISNULL(WO_Detail,0) AS WO_Detail, WhenAdd, Description "
						cSQL = cSQL + " FROM dbo.Receiving "
						cSQL = cSQL + " WHERE Heat = '"+cHeat+"'"
						IF LEN(cLot) > 0
							cSQL = cSQL + " AND Lot = '"+cLot+"'"
						ENDIF
						cSQL = cSQL + " AND Alloy = '"+cAlloy+"'"
						cSQL = cSQL + " AND ID<>"+STR(nReceivingID)
						cSQL = cSQL + " AND ISNULL(Cancelled,0)=0 "  
						cSQL = cSQL + " AND dbo.f_Is_POitem_NOT_Stock(POitem) = 0 "
						SELECT 0
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOtherHeat')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOtherHeat')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOtherHeat")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOtherHeat")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpOtherHeat')
						ENDIF
		
						IF USED("tmpOtherHeat")
							IF RECCOUNT("tmpOtherHeat") > 0
		
								*Show screen of matching Heats!
								IF nWO_Detail > 0
									DO FORM Forms\ChooseReceivingDetails WITH nWO_Detail, cHeat, '' TO nEditReceivingID
									IF nEditReceivingID > 0
										ThisForm.txtReceivingID.Value = nEditReceivingID
										ThisForm.txtReceivingID.Refresh
										ThisFormSet.getBy_ReceivingID()
									ENDIF
								ELSE
									DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, '' TO nEditReceivingID
									IF nEditReceivingID > 0
										ThisForm.txtReceivingID.Value = nEditReceivingID
										ThisForm.txtReceivingID.Refresh
										ThisFormSet.getBy_ReceivingID()
									ENDIF
								ENDIF
								
								
			*!*						PRIVATE cPOitem, cSOitem, dWhenAdd,cDescription, nReceivingID, cMess
			*!*						cPOitem	= PrepareSQLtxt(tmpOtherHeat.POitem,'POitem',12)
			*!*						cSOitem	= PrepareSQLtxt(tmpOtherHeat.SOitem,'SOitem',10)
			*!*						dWhenAdd	= PrepareSQLdate(tmpOtherHeat.WhenAdd,'WhenAdd')
			*!*						cDescription = PrepareSQLtxt(tmpOtherHeat.Description,'Description',80)
			*!*						nReceivingID  = PrepareSQLnum(tmpOtherHeat.ID,'ReceivingID',-3)
			*!*						
			*!*						cMess = "This Heat '"+ALLTRIM(cHeat)+"' was found"+CHR(13)
			*!*						cMess = cMess +"on Receiving ID:"+ALLTRIM(STR(nReceivingID))+CHR(13)
			*!*						cMess = cMess +"and Alloy '"+ALLTRIM(cAlloy)+"'"+CHR(13)
			*!*						
			*!*						IF Proper_PO_Item(cPoItem) != Proper_PO_Item('')
			*!*							cMess = cMess +"and POitem '"+cPoItem+"'"+CHR(13)
			*!*						ENDIF
			*!*						
			*!*						IF Proper_SO_Item(cSoItem) != Proper_SO_Item('')
			*!*							cMess = cMess +"and SOitem '"+cSoItem+"'"+CHR(13)
			*!*						ENDIF
			*!*						
			*!*						cMess = cMess +cDescription +CHR(13)
			*!*						IF VARTYPE(dWhenAdd)='D'
			*!*							cMess = cMess +"and When Added is "+DTOC(dWhenAdd)+"."+CHR(13)+CHR(13)
			*!*						ENDIF
			*!*						IF VARTYPE(dWhenAdd)='T'
			*!*							cMess = cMess +"and When Added is "+TTOC(dWhenAdd)+"."+CHR(13)+CHR(13)
			*!*						ENDIF
			*!*						
			*!*						cMess = cMess +"Do not duplicate (Add the heat again)."
			*!*						cMess = cMess +CHR(13)+CHR(13)+"Edit Receiving data program to fix the Heat as Received."
			*!*						cMess = cMess +CHR(13)+CHR(13)+"Do you want to EDIT this receiving record?."
			*!*						
			*!*						PRIVATE nMess
			*!*						nMess = 7
			*!*						nMess = MESSAGEBOX(cMess,4+32+256,"Use the old Receive?")
			*!*						IF nMess = 6
			*!*							ThisForm.txtReceivingID.Value = nReceivingID 
			*!*							ThisForm.txtReceivingID.Refresh
			*!*							ThisFormSet.getBy_ReceivingID()
			*!*						ENDIF
			*!*						
							ENDIF
							USE IN tmpOtherHeat
						ENDIF
					ENDIF			
			*	ENDIF		
			ENDIF
		ENDIF
		
	ENDPROC

