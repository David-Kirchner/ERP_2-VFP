	PROCEDURE rma_receive
		*PARAMETERS pcSOitem
		*ThisFormSet.RMA_Receive()
		*Receive_Edit
		
		*Old, disable this
		
		
		
		PRIVATE nRMA
		nRMA = ThisFormSet.nRMA
		
		PRIVATE cPOitem, cSOitem
		cPOitem = PrepareSQLtxt(ThisFormSet.cPOitem,'POitem',12)
		cSOitem = ThisFormSet.cSOitem
		
		
		IF EMPTY(cSOitem)
			MESSAGEBOX("Cannot process RMA return without the SOitem!"+CHR(13)+"RMA:"+ALLTRIM(STR(nRMA))+".",0+32,"No SO-item")
			RETURN .F.
		ENDIF
		
		PRIVATE nDec, nItemSo, nSalesNum 
		nSalesNum = Proper_SO_Item_SO(cSoItem)
		nItemSo = Proper_SO_Item_Item(cSOitem)
		
		ThisFormset.Receive_Edit.txtSOnum.Value = nSalesNum 
		ThisFormset.Receive_Edit.txtSOnum.Refresh
		ThisFormset.Receive_Edit.txtSOitem.Value = nItemSo 
		ThisFormset.Receive_Edit.txtSOitem.Refresh	
		
		
		*Get ID_Detail
		IF USED('tmpStockLst_Process_History')
			USE IN tmpStockLst_Process_History
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT ID_Detail FROM dbo.Ar_StockLst_Process_History "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE    ')"
		cSQL = cSQL + " ORDER BY [WHAT] DESC "
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT ID_Detail FROM dbo.Ar_BrokerLst_Process_History "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE    ')"
		cSQL = cSQL + " ORDER BY [WHAT] DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLst_Process_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLst_Process_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLst_Process_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLst_Process_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpStockLst_Process_History')
			MESSAGEBOX("Cannot process RMA return.",0+32,"No ID_Detail")
			RETURN .F.
		ENDIF
		
		PRIVATE nID_Detail 
		nID_Detail = 0
		IF USED('tmpStockLst_Process_History')
			IF VARTYPE(tmpStockLst_Process_History.ID_Detail) = "N"
				nID_Detail = tmpStockLst_Process_History.ID_Detail
			ENDIF
			USE IN tmpStockLst_Process_History
		ENDIF
		
		PRIVATE cTBL
		IF nID_Detail > 0
			cTBL = "S"
		ELSE
			*Check BrokerLst
			cSQL = "SELECT ID_Detail FROM dbo.Ar_BrokerLst_Process_History "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND [WHAT] = 'DELETE    '"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLst_Process_History')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLst_Process_History')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLst_Process_History")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLst_Process_History")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpStockLst_Process_History')
				MESSAGEBOX("Cannot process RMA return.",0+32,"No ID_Detail")
				RETURN .F.
			ENDIF
			IF USED('tmpStockLst_Process_History')
				IF VARTYPE(tmpStockLst_Process_History.ID_Detail) = "N"
					nID_Detail = tmpStockLst_Process_History.ID_Detail
					cTBL = "B"
				ENDIF
				USE IN tmpStockLst_Process_History
			ELSE
				MESSAGEBOX("Could not retrieve ID_Detail.",0+32,"No StockLst info")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE nStockLst_ID
		nStockLst_ID = Get_ID_with_ID_Detail(nID_Detail,cTBL,ThisFormSet.nConnhandle)
		
		
		**************** StockLst_Master 
		IF nStockLst_ID = 0
			MESSAGEBOX("Could not retrieve ID.",0+32,"No StockLst info")
			*RETURN .F.
		ENDIF
		
		IF cTBL = "S"
			cSQL = "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.StockLst_Master WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.Ar_Stocklst_Master_History WHERE ID = "+STR(nStockLst_ID)
		ELSE
			cSQL = "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.BrokerLst_Master WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.Ar_BrokerLst_Master_history WHERE ID = "+STR(nStockLst_ID)
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLstID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLstID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLstID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLstID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpStockLstID')
			MESSAGEBOX("Could not retrieve ID Info.",0+32,"No StockLst info")
		ENDIF
		
		
		IF USED('tmpStockLstID')
			IF VARTYPE(tmpStockLstID.Alloy)="C" &&Alloy
				IF !EMPTY(tmpStockLstID.Alloy)
					ThisFormset.Receive_Edit.txtAlloy.Value = tmpStockLstID.Alloy
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Heat)="C" &&Heat
				IF !EMPTY(tmpStockLstID.Heat)
					ThisFormset.Receive_Edit.txtHeat.Value = tmpStockLstID.Heat
				ENDIF
			ENDIF
			
			IF VARTYPE(tmpStockLstID.Lot)="C" &&Lot
				IF !EMPTY(tmpStockLstID.Lot)
					ThisFormset.Receive_Edit.txtLot.Value = tmpStockLstID.Lot
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Specs)="C"  &&Specs
				IF !EMPTY(tmpStockLstID.Specs)
					ThisFormset.Receive_Edit.edtSpecs.Value = tmpStockLstID.Specs
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Mill)="C"  &&Mill 
				IF !EMPTY(tmpStockLstID.Mill)
					ThisFormset.Receive_Edit.txtVendor.Value = tmpStockLstID.Mill 
				ENDIF
			ENDIF
		
			USE IN tmpStockLstID
		ENDIF
		
		*************** StockLst_Detail 
		
		IF USED('tmpStockLstDetail')
			USE IN tmpStockLstDetail
		ENDIF
		
		IF cTBL = "S"
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.Ar_Stocklst_Detail_History WHERE ID_Detail ="+STR(nID_Detail)
		ELSE
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.BrokerLst_Detail WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.Ar_BrokerLst_Detail_History WHERE ID_Detail ="+STR(nID_Detail)
		ENDIF
		*SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WHERE ID_Detail = 5657
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLstDetail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStockLstDetail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLstDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStockLstDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpStockLstDetail')
			MESSAGEBOX("Could not retrieve ID Detail Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpStockLstDetail')
			GO TOP
			IF VARTYPE(tmpStockLstDetail.PC)="N"  &&Pieces
				IF tmpStockLstDetail.PC > 0
					ThisFormset.Receive_Edit.txtPieces.Value = tmpStockLstDetail.PC
				ENDIF
			ENDIF
			IF VARTYPE(tmpStockLstDetail.Description)="C"  &&Description
				IF !EMPTY(tmpStockLstDetail.Description)
					ThisFormset.Receive_Edit.edtDescription.Value = tmpStockLstDetail.Description
				ENDIF
			ENDIF
			
			USE IN tmpStockLstDetail
			
			ThisFormset.Receive_Edit.Edit1.Value = ThisFormset.Receive_Edit.Edit1.Value+CHR(13)+"Retrieved: receive again after RMA."
			ThisFormset.Receive_Edit.Refresh	
			ThisFormset.Receive_Edit.txtReceivingID.Value = 0
		ENDIF
		
		********** Sales
		
		ThisFormset.Receive_Edit.txtActualW.Value		= 0
		ThisFormset.Receive_Edit.txtBillW.Value 		= 0
		
		ThisFormset.Receive_Edit.txtAcct_Qty.Value	= Get_From_AllQuote_SOitem (cSoItem, "S_QTY", ThisFormSet.nConnhandle )
		ThisFormset.Receive_Edit.txtAcct_P.Value	= 0
		
		PRIVATE nAcct_PU
		*nAcct_PU = PrepareSQLnum( Get_From_AllQuote_SOitem (ThisFormSet.cSOitem, "Quoted_PU", ThisFormSet.nConnhandle ),'Recv_PU',-1)	&&Cust 
		nAcct_PU = GetPUfromForm(  Get_From_AllQuote_SOitem (cSOitem, "Form", ThisFormSet.nConnhandle ) )
		ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nAcct_PU, 'PO_PU',2)
		ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nAcct_PU , ThisFormSet.nConnhandle)
		*
		PRIVATE nCust_PU
		nCust_PU = PrepareSQLnum( Get_From_Sales_SOitem (ThisFormSet.cSOitem, "Quoted_PU", ThisFormSet.nConnhandle ),'Recv_PU',-1)	&&Cust 
		ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nAcct_PU, 'PO_PU',2)
		ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		
		ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum( Get_From_Sales_SOitem (cSoItem, "Quoted_QTY", ThisFormSet.nConnhandle ),'Quoted_QTY',-5)
		ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum( Get_From_Sales_SOitem (cSoItem, "Quoted_P", ThisFormSet.nConnhandle ),'Quoted_P',-5)
		
		
		cSQL = "SELECT matlwt FROM dbo.Sales WHERE SOitem = '"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpSalesWt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpSalesWt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSalesWt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSalesWt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpSalesWt')
			MESSAGEBOX("Could not retrieve Sales Weight.",0+32,"No info")
		ENDIF
		
		IF USED('tmpSalesWt')
			GO TOP
			IF VARTYPE(tmpSalesWt.matlwt)="N"  &&Pieces
				IF tmpSalesWt.matlwt > 0
					ThisFormset.Receive_Edit.txtActualW.Value = tmpSalesWt.matlwt 
					ThisFormset.Receive_Edit.txtBillW.Value = tmpSalesWt.matlwt 
				ENDIF
			ENDIF
			
			USE IN tmpSalesWt
		ENDIF
		
		*************** AllQuotes
		IF USED('tmpAllQuotes')
			USE IN tmpAllQuotes
		ENDIF
		
		cSQL = "SELECT Alloy,Pieces,Form,dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Weight,RandLen) AS Description,Weight FROM dbo.AllQuotes WHERE SOitem ='"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpAllQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpAllQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpAllQuotes')
			MESSAGEBOX("Could not retrieve AllQuotes Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpAllQuotes')
			GO TOP
			IF VARTYPE(tmpAllQuotes.Alloy)="C" &&Alloy
				IF !EMPTY(tmpAllQuotes.Alloy)
					ThisFormset.Receive_Edit.txtAlloy.Value = tmpAllQuotes.Alloy
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Pieces)="N"  &&Pieces
				IF tmpAllQuotes.Pieces > 0
					ThisFormset.Receive_Edit.txtPieces.Value = tmpAllQuotes.Pieces
				ENDIF
			ENDIF
			
			ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpAllQuotes.Form,'Form',2)	
			
			IF VARTYPE(tmpAllQuotes.Description)="C"  &&Description
				IF !EMPTY(tmpAllQuotes.Description)
					ThisFormset.Receive_Edit.edtDescription.Value = tmpAllQuotes.Description
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Weight)="N"  &&Weight 
				IF tmpAllQuotes.Weight > 0
					ThisFormset.Receive_Edit.txtActualW.Value = tmpAllQuotes.Weight 
					ThisFormset.Receive_Edit.txtBillW.Value = tmpAllQuotes.Weight 
				ENDIF
			ENDIF
			USE IN tmpAllQuotes
		ENDIF
			
		SELECT Receiving
		
		ThisFormset.Receive_Edit.chkCert.Value		= 1
		ThisFormset.Receive_Edit.edtComments.Value	= ''
		ThisFormset.Receive_Edit.txtInit.Value 		= ''
		ThisFormset.Receive_Edit.txtDate.Value 		= DTOC(DATE())
		ThisFormset.Receive_Edit.chkPass.Value		= 1
		ThisFormset.Receive_Edit.chkGoodPapers.Value		= 1
		
		ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(0,'Services')
		ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
		ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		*ThisFormSet.SaveAdd(pSaveType)	ADD	  ADDCLONE	EDIT
		*Receive_Edit
		
		IF TYPE("pSaveType") != "C"
			MESSAGEBOX("No pSaveType for SaveAdd(pSaveType)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No pSaveType for SaveAdd(pSaveType)" )
			RETURN
		ENDIF
		
		PRIVATE lSQLgood, lNeedSave, lSaved, lAlready_Saved, lRMA
		lSQLgood = .T.
		lNeedSave = .T.
		lSaved = .F.
		lAlready_Saved = .F.
		lRMA = .F.
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		nHpaPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSONum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		
		* NOTE cPOitem is not used on customers material like a SO is a Toll Service Order
		PRIVATE nCountPOitem
		nCountPOitem = 0
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
			nCountPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, '' ) 
		ENDIF
		
		PRIVATE nCountSOitem
		nCountSOitem = 0
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item("")
			nCountSOitem = Count_SOIteminSales( cSOItem, ThisFormSet.nConnhandle, 'CONVERSIONSERVICE' )
			IF nCountSOitem = 0
				nCountSOitem = Count_SOIteminSales( cSOItem, ThisFormSet.nConnhandle, 'PRODUCTION' )
			ENDIF
		ENDIF
		
		PRIVATE nWO_Detail, nWO
		nWO_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		nWO			= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO.Value,'WO',-3)
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE nRMA_No, nRMA_Detail
		nRMA_No		= PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_No.Value,'RMA',-3)
		nRMA_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
		
		IF nRMA_No > 0
			IF RMA_Exists(nRMA_No, ThisFormSet.nConnhandle)
				lRMA = .T.
				IF PrepareSQLtxt(ThisFormset.Receive_Edit.txtTBL.Value,'TBL',1) <> "S"
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"RMA > 0 and RMA Exists, so StockLst_TBL is set to 'S' ." )
				ENDIF
				ThisFormset.Receive_Edit.txtTBL.Value = "S"
				ThisFormSet.cTBL 	= "S"
				ThisFormset.Receive_Edit.txtTBL.Value = "S"
				ThisFormSet.StockLst_TBL = "S"
			ENDIF
		ENDIF
		
		IF nCountPOitem = 0 AND nCountSOitem = 0 AND nWO_Detail = 0 AND nWO = 0 AND nWO = 0 AND nRMA_No = 0
			IF Proper_SO_Item(cSOitem) <> Proper_SO_Item("")
			
				MESSAGEBOX("Sales Order item "+cSOitem+" is not a Conversion Service!"+CHR(13)+"This program is to Receive material."+CHR(13)+"The program does not know how to process."+CHR(13)+"Have the Sales Rep fix -Issue a Return"+CHR(13)+"or have a WO Detail made to receive this material."+CHR(13)+"This SOitem alone cannot just be Received.",16,"Cannot Save")
				TrackError("Checked for POitem, SOitem, WO_Detail, WO"+CHR(13)+"For Receiving ID "+STR(nReceivingID)+CHR(13)+"Sales Order item "+cSOitem+" is not a Conversion Service","Did not Find an Order", PROGRAM(), LINENO(1))
				RETURN .F.
			ELSE
				MESSAGEBOX("Checked for POitem, SOitem, WO_Detail, WO"+CHR(1)+"and did not find an Order number that to work with",48,"Weird")
				TrackError("Checked for POitem, SOitem, WO_Detail, WO"+CHR(13)+"For Receiving ID "+STR(nReceivingID),"Did not Find an Order", PROGRAM(), LINENO(1))
			ENDIF
		ENDIF
		
		IF nReceivingID = 0
			nReceivingID = ThisFormSet.SaveAsNewReceiving()
		ENDIF
		
		
		PRIVATE nID_Master, nID_Detail, nID_Detail_PRC, cTBL, cForm
		nID_Master = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
		nID_Detail = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
		nID_Detail_PRC = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		cTBL 		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtTBL.Value,'TBL',1)
		cForm		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtForm.Value,'Form',2)
		
		
		PRIVATE dReceived, cAlloy, cHeat, cLot, lCert, nPieces, cDescription
		PRIVATE cSpecs, cComments, cInit, dDate, lPass, lGoodPapers, lHold, nActualW, nBillW, cVendor
		PRIVATE nRejectPC, cRejectReason
		dReceived	= PrepareSQLdate(ThisFormSet.Receive_Edit.txtReceived.Value,'Received')
		cAlloy		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= UPPER(PrepareSQLtxt(ThisFormSet.Receive_Edit.txtHeat.Value,'Heat',50,.f.))
		cLot 		= UPPER(PrepareSQLtxt(ThisFormSet.Receive_Edit.txtLot.Value,'Lot',10))
		lCert		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkCert.Value,'Cert')
		nPieces		= PrepareSQLnum(ThisFormSet.Receive_Edit.txtPieces.Value,'Pieces',-3)
		cDescription= PrepareSQLtxt(ThisFormSet.Receive_Edit.edtDescription.Value,'Description',-1,.F.)
		cSpecs		= PrepareSQLtxt(ThisFormSet.Receive_Edit.edtSpecs.Value,'Specs',-1)
		cComments	= PrepareSQLtxt(ThisFormSet.Receive_Edit.edtComments.Value,'Comments',-1,.F.)
		cInit		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtInit.Value,'Init',10 )
		dDate		= PrepareSQLdate(ThisFormSet.Receive_Edit.txtDate.Value,'Date')
		lPass		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkGoodPapers.Value,'GoodPapers')
		lHold		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkHold.Value,'Hold')
		nActualW	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtActualW.Value,'Actual',9,1)
		nBillW		= PrepareSQLnum(ThisFormSet.Receive_Edit.txtBillW.Value,'BillW',9,1)
		
		PRIVATE nAcct_QTY, nAcct_P, nAcct_PU
		nAcct_QTY	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct
		nAcct_P		= PrepareSQLnum(ThisFormSet.Receive_Edit.txtAcct_P.Value,'S_P',-5)	
		nAcct_PU	= PrepareSQLnum(ThisFormSet.Receive_Edit.lblAcct_PU.Caption,'PU',-1)
		PRIVATE nPO_QTY, nPO_P, nPO_PU
		nPO_QTY = PrepareSQLnum(ThisFormSet.Receive_Edit.txtPO_QTY.Value,'PO_QTY',-5)	&&Vendor
		nPO_P	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtPO_P.Value,'PO_P',-5)	&&Vendor
		nPO_PU	= PrepareSQLnum(ThisFormSet.Receive_Edit.lblPO_PU.Caption,'PU',-1)
		
		***************
		cVendor		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtVendor.Value,'Vendor',30,.F.,.T. )
		nRejectPC	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRejectPC.Value,'RejectPC',-3)
		cRejectReason= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtRejectReason.Value,'RejectReason',255,.f. )
		
		IF nRejectPC < 1
			nRejectPC = 0
		ENDIF
		
		**********************
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkServicesPO.VALUE,'ServicesPO',.F.)
		lConvServ		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkConvServ.VALUE,'ConvServ',.f.)
		lEquipment		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkEquipment.VALUE,'Equipment',.F.)
		
		
		*cComments
		PRIVATE lLabServices, nCountPOitem 
		lLabServices = .F.
		nCountPOitem = 0
		
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
			*Is this a Lab Test?
			*lLabService = Get_From_POitem (cPOitem, "Field", ThisFormSet.nConnhandle )
			
			nCountPOitem = PO_POitem_Cnt( cPOitem, ThisFormSet.nConnhandle, 'SERVICES' ) &&NOTRECEIVE includes (Services AND ConvServ AND Equipment)
			
			IF nCountPOitem > 0 OR lServicesPO
				lLabServices = .T.
				
				IF NOT "Received data from paid Services" $ cComments
					IF LEN(cComments)>0
						cComments = cComments+ CHR(13)
					ENDIF
					cComments = cComments+ "Received data from paid Services "
				ENDIF
			ENDIF
		ENDIF
		IF nWO_Detail > 0
			cComments = "From Work Order Detail "+STR(nWO_Detail)
		ENDIF
		
		************************
		
		IF NOT lPass
			IF nReceivingID > 0
				IF lHold
					MESSAGEBOX("Since this material did not PASS Specs,"+CHR(13)+"this will be considered on ReceiveOnHold."+CHR(13)+CHR(13)+"The PO Sales Rep will be notified"+CHR(13)+"daily so this order can be fixed.",48,"On Receive Hold")
					Send_Chatter("ReceivingID_Hold",nReceivingID,"BLANK","The receiving material for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on Receive OnHold.",ThisFormSet.nConnhandle)
					*Send_Chatter("QA",0,"BLANK","The receiving material did not PASS Specs for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on QA Hold.",ThisFormSet.nConnhandle)
				ENDIF
			ENDIF
		ENDIF
		
		************************
		** End Testing
		************************
		PRIVATE nReceivingIDOld 
		nReceivingIDOld = 0
		
		**********************
		IF USED('tmpCountPOitem')
			USE IN tmpCountPOitem
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, cSQLu
		PRIVATE lSaveByOldMethod
		lSaveByOldMethod = .T.
		cSQL=''
		***
		
		PRIVATE lFoundStockUpdateReceiving, lRan_Show_Recv_Order
		lFoundStockUpdateReceiving = .F.
		lRan_Show_Recv_Order = .F.
		
		PRIVATE nCntPOitemMetal
		nCntPOitemMetal = 0
		IF Proper_PO_item(cPOItem) = Proper_PO_item('')
			nCntPOitemMetal = -1
		ELSE
			nCntPOitemMetal = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "NOT SERVICES CONVSERV EQUIPMENT" )  && count of metal stock
			IF nCntPOitemMetal > 0
				*Count for Service and Not Received
				nCntPOitemMetal = PO_POitem_Cnt( cPOitem, ThisFormSet.nConnhandle, 'NOTRECEIVE' )	&&Count of Not Services
			ENDIF
		ENDIF
		
		IF lLabServices 
			nCntPOitemMetal = 0
		ENDIF
		
		********************
		IF EMPTY(cTBL) && ThisFormSet.cTBL
		*cTBL = getTBL_POitem(cPOitem, ThisFormSet.nConnhandle ) 
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cTBL = getTBL_POitem(cPOitem, ThisFormSet.nConnhandle ) 
			ELSE
				IF nWO_Detail > 0
					cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle )
				ELSE
					cTBL = ThisFormSet.cTBL
				ENDIF
			ENDIF
		ENDIF
		
		********************
		PRIVATE nPOcomplete
		nPOcomplete = 0
		
		*****************************
		**Show Receive by POitem or WO_Detail
		IF nHPApo > 0 AND NOT (lServicesPO or lConvServ or lEquipment)
			IF nCntPOitemMetal > 0 OR nWO_Detail > 0 
				IF nReceivingID > 0 AND NOT lRMA
					PRIVATE nReceivingIDnow
					IF nReceivingIDOld = 0
						*New Add, Invert nReceivingID to Show as an Add
						nReceivingIDnow = -nReceivingID  
					ELSE
						nReceivingIDnow = nReceivingID  
					ENDIF
					*DO FORM Forms\ShowReceived_Ordered WITH "What", cPOitem, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingIDnow,cTBL,nID_Detail,clot TO nPOcomplete
					DO FORM Forms\Show_Recv_Order WITH "POitem",cPOitem, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingIDnow,cTBL,nID_Detail,cLot,nID_Master  TO nPOcomplete
					lRan_Show_Recv_Order = .T.
					
					nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)  &&What changes this to Text
								
					IF VARTYPE(nPOcomplete) = 'N'
					
						*IF nID_Detail = 0
							IF nPOcomplete > FLOOR(nPOcomplete)
								*PrepareSQLnum((2+"."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
								*nID_Detail = nPOcomplete-FLOOR(nPOcomplete)
								*Remove Decimal point
								cID_Detail = ALLTRIM(STR(nID_Detail))
								cID_Detail = RIGHT(cID_Detail,LEN(cID_Detail)-2)
								nID_Detail = PrepareSQLnum(cID_Detail,'ID_Detail',-3)
								IF nID_Detail > 0
									nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
								ENDIF
								
							ENDIF
						*ENDIF
						
						nPOcomplete = PrepareSQLnum(nPOcomplete,'nPOcomplete',-1)
						*nPOcomplete = 0 no Choice, 1 Not Complete, 2 Complete, 3 Edit
						DO CASE
						CASE nPOcomplete = 0
							* Abort this receive
							ThisFormSet.AbortThisReceive(nReceivingID)
							RETURN .F.
						CASE FLOOR(nPOcomplete) = 1
							*Partial ShowReceived_Ordered
						CASE FLOOR(nPOcomplete) = 2
							*Complete in ShowReceived_Ordered 
						CASE FLOOR(nPOcomplete) = 3
							*Good, Just Editing the Receiving Record.
						ENDCASE
					ELSE
						TrackError("DO FORM Forms\Show_Recv_Order returned nPOcomplete that was not 0,1,2"+CHR(13)+"nReceivingID > 0 AND NOT lRMA" ,"bad return",PROGRAM(),LINENO(1))
						*RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+"nReceivingID > 0 AND NOT lRMA")
						RETURN .F.
					ENDIF
					
					*****************************
					IF nID_Detail = 0
						*See if ShowReceived_Ordered created stock
						
						cSQL = "SELECT StockTable AS TBL, ID_Master, ID_Detail FROM dbo.Receiving WITH(NOLOCK) WHERE ID ="+STR(nReceivingIDnow)
						
						IF USED("tmpReceiveID")
							USE IN tmpReceiveID
						ENDIF
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceiveID')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceiveID')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceiveID")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceiveID")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceiveID')
							*TrackMess("Error with Add Receiving ID:"+ALLTRIM(STR(nReceivingID)) )
							TrackError("Check for Existing Record. "+CHR(13)+cSQL ,"bad select",PROGRAM(),LINENO(1))
						ELSE
							IF RECCOUNT('tmpReceiveID') > 0
								cTBL 					= PrepareSQLtxt(tmpReceiveID.TBL,'TBL',1)
								ThisFormSet.Receive_Edit.txtTBL.Value 	= PrepareSQLtxt(tmpReceiveID.TBL,'TBL',1)
								nID_Master					= PrepareSQLnum(tmpReceiveID.ID_Master,'ID_Master',-3)
								ThisFormSet.Receive_Edit.txtID_Master.Value = nID_Master 
								nID_Detail					= PrepareSQLnum(tmpReceiveID.ID_Detail,'ID_Detail',-3)
								ThisFormSet.Receive_Edit.txtID_Detail.Value = nID_Detail
								
								USE IN tmpReceiveID
							ENDIF
						ENDIF
					ENDIF
					
				ENDIF
				IF nReceivingID > 0 AND lRMA
					nPOcomplete = 2
				ENDIF
			ELSE
				*SERVICES CONVSERV EQUIPMENT
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "SERVICES" ) > 0
					*lPass
					IF nWO > 0
						lOK = Update_WO_POitem_Test( nWO, cPOItem, ThisFormSet.nConnhandle, lPass)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		**Show Receive by WO_Detail
		
		IF FLOOR(nPOcomplete) = 0
			IF nWO_Detail > 0  AND NOT (lServicesPO or lConvServ or lEquipment)
				
			*	IF nCntPOitemMetal > 0
					IF nReceivingID > 0
						PRIVATE nReceivingIDnow
						IF nReceivingIDOld = 0
							*New Add, Invert nReceivingID to Show as an Add
							nReceivingIDnow = -nReceivingID  
						ELSE
							nReceivingIDnow = nReceivingID  
						ENDIF
						
						PRIVATE cWOD
						cWOD = "WOD"+STR(nWO_Detail)
						
						DO FORM Forms\Show_Recv_Order WITH "WOD",nWO_Detail, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingIDnow,cTBL,nID_Detail,cLot,nID_Master TO nPOcomplete
						lRan_Show_Recv_Order = .T.
						
						nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)  &&What changes this to Text
						
						IF VARTYPE(nPOcomplete) = 'N'
							*IF nID_Detail = 0
								IF nPOcomplete > FLOOR(nPOcomplete)
									*PrepareSQLnum((2+"."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
									*nID_Detail = nPOcomplete-FLOOR(nPOcomplete)
									*Remove Decimal point
									cID_Detail = ALLTRIM(STR(nID_Detail))
									cID_Detail = RIGHT(cID_Detail,LEN(cID_Detail)-2)
									nID_Detail = PrepareSQLnum(cID_Detail,'ID_Detail',-3)
									IF nID_Detail > 0
										nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
									ENDIF
								ENDIF
							*ENDIF
						ENDIF
						
						IF VARTYPE(nPOcomplete) = 'N'
							nPOcomplete = PrepareSQLnum(nPOcomplete,'nPOcomplete',-1)
							*nPOcomplete = 0 no Choice, 1 Not Complete, 2 Complete
							*PrepareSQLnum((2+"."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
							DO CASE
							CASE FLOOR(nPOcomplete) = 0
								* Abort this receive
								ThisFormSet.AbortThisReceive(nReceivingID)
								
								RETURN .F.
							CASE FLOOR(nPOcomplete) = 1
								*OR Good, Receive matches PO,  ** NOT Complete **
								nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)
								nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)  
								ThisFormSet.Receive_Edit.txtID_Master.Value = nID_Master 
								ThisFormSet.Receive_Edit.txtID_Detail.Value = nID_Detail 
								IF nID_Detail = 0
									ThisFormSet.Receive_Edit.txtID_Detail_Process.Value = 0
								ELSE
									ThisFormSet.Receive_Edit.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisFormSet.nConnhandle)  
								ENDIF
							
							CASE FLOOR(nPOcomplete) = 2
								*Good, Receive matches PO and COMPLETES the PO Item!
								nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)
								nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)  
								ThisFormSet.Receive_Edit.txtID_Master.Value = nID_Master 
								ThisFormSet.Receive_Edit.txtID_Detail.Value = nID_Detail 
								IF nID_Detail = 0
									ThisFormSet.Receive_Edit.txtID_Detail_Process.Value = 0
								ELSE
									ThisFormSet.Receive_Edit.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisFormSet.nConnhandle)  
								ENDIF
								
							CASE FLOOR(nPOcomplete) = 3
								*Good, Just Editing the Receiving Record.
								nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)
								nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)  
								ThisFormSet.Receive_Edit.txtID_Master.Value = nID_Master 
								ThisFormSet.Receive_Edit.txtID_Detail.Value = nID_Detail 
								IF nID_Detail = 0
									ThisFormSet.Receive_Edit.txtID_Detail_Process.Value = 0
								ELSE
									ThisFormSet.Receive_Edit.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisFormSet.nConnhandle)  
								ENDIF
								
							ENDCASE
						ELSE
							TrackError("DO FORM Forms\Show_Recv_Order returned nPOcomplete that was not 0,1,2"+CHR(13)+cWOD ,"bad return",PROGRAM(),LINENO(1))
							*RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+cWOD )
							RETURN .F.
						ENDIF
					ENDIF
			*	ELSE
			*!*			*This Receive is for a Service
			*!*			IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "SERVICES" ) > 0
			*!*				*lPass
			*!*				IF nWO_Detail > 0	&&getWOD_POitem(nWO_Detail, cPOItem, ThisFormSet.nConnhandle,'TestPO')
			*!*					lOK = Update_WOD_POitem_Test( nWO_Detail, cPOItem, ThisFormSet.nConnhandle, lPass)
			*!*				ENDIF
			*!*			ENDIF
				*ENDIF
			ENDIF
		ENDIF
		
		
		
		
		*nPOcomplete 0,1,2,3
		*nPOcomplete USE Floor() becuase a ID_Detail is sent in Decimal
		
		**************************************************************
		**********************************************************************************
		*Test Table - Get rid of 'N'
		IF pSaveType = "ADD" OR pSaveType = "ADDCLONE"
			IF nCntPOitemMetal > 0	&&nCntPOitemMetal  is -1 when WO_Detail  --Checked in next code block
				IF nID_Detail_PRC = 0
					IF FLOOR(nPOcomplete) = 1
						IF nWO_Detail > 0
							cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
						ELSE
							cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
						ENDIF
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle) 
						IF nID_Detail_PRC > 0
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ELSE
							IF nWO_Detail > 0
								nID_Detail = get_ID_Detail_from_WOD(nWO_Detail, ThisForm.nConnHandle)
								IF nID_Detail > 0
									nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
									ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
									ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
								ENDIF
							ENDIF	
						ENDIF
					ENDIF
					IF FLOOR(nPOcomplete) = 2 
						*TBL could be anything except 'N'
						IF cTBL='N'
							IF nWO_Detail > 0
								cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
							ELSE
								cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
							ENDIF
						ENDIF
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle) 
						
						IF nID_Detail_PRC > 0
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			*****
			IF nWO_Detail > 0
				IF nID_Detail_PRC = 0
					IF FLOOR(nPOcomplete) = 1
						*An Add would be for Stock, -- get data After Show Receive VS Ordered
						cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle)
						IF nID_Detail_PRC > 0 
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
					IF FLOOR(nPOcomplete) = 2 
						*TBL could be anything except 'N'
						IF cTBL='N'
							cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
						ENDIF
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle) 
						IF nID_Detail_PRC > 0
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle)
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
				
			*****
			IF lRMA
				IF nID_Detail_PRC = 0
					IF FLOOR(nPOcomplete) = 1
						*An Add would be for Stock, -- get data After Show Receive VS Ordered
						cTBL ="S"
		*!*					IF nWO_Detail > 0
		*!*						cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
		*!*					ELSE
		*!*						cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
		*!*					ENDIF
		
						IF nID_Detail_PRC > 0
							nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle) 
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
					IF FLOOR(nPOcomplete) = 2 
						*TBL could be anything except 'N'
						IF cTBL='N' OR EMPTY(cTBL)
							cTBL ="S"
						ENDIF
						IF nID_Detail_PRC > 0
							nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle) 
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
				ENDIF
						
				IF nID_Detail = 0 AND nID_Master > 0
					nID_Detail = get_ID_Detail_from_RMA_Detail(cTBL, nRMA_Detail, ThisFormSet.nConnhandle) 
					ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
					ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
				ENDIF
			ENDIF
		ENDIF
		
		IF pSaveType = "EDIT"
			IF nID_Detail = 0
				IF nPOcomplete > FLOOR(nPOcomplete)
					*PrepareSQLnum((2+"."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
					*nID_Detail = nPOcomplete-FLOOR(nPOcomplete)
					*Remove Decimal point
					cID_Detail = ALLTRIM(STR(nID_Detail))
					cID_Detail = RIGHT(cID_Detail,LEN(cID_Detail)-2)
					nID_Detail = PrepareSQLnum(cID_Detail,'ID_Detail',-3)
					IF nID_Detail > 0
						nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
					ENDIF
				ENDIF
			ENDIF
			
			IF (nCntPOitemMetal > 0 OR nWO_Detail > 0 OR nRMA_No > 0 ) AND ( (nID_Detail+nRMA_No) = 0 OR nID_Master = 0 ) AND nReceivingID > 0
				*Metal Receive with no Stock ID,  a RMA has NO nID_Detail at first!
				
				PRIVATE cMess
				cMess = "This Receiving record was to be an 'Edit'"+CHR(13)
				cMess = cMess + "but no Stock ID was found."+CHR(13)+CHR(13)
				cMess = cMess + "Do you want to try to Add Stock now ?"+CHR(13)+CHR(13)
				cMess = cMess + "You might have to click 'Save' again."
				
				PRIVATE nMess
				nMess = MESSAGEBOX(cMess,4+32,"Add to Stock")
			
				IF nMess = 6
					IF nID_Detail_PRC = 0
						*try to find ID, ID_Detail
						IF FLOOR(nPOcomplete) = 1
							*An Add would be for Stock, -- get data After Show Receive VS Ordered
							*cTBL ="S"
							IF nWO_Detail > 0
								cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
							ELSE
								cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
							ENDIF
		
							nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle) 
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
						IF FLOOR(nPOcomplete) = 2 
							*TBL could be anything except 'N'
							IF nWO_Detail > 0
								cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
							ELSE
								cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
							ENDIF
		
							IF cTBL='N'
								cTBL ="S"
							ENDIF
							
							nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisFormSet.nConnhandle) 
							IF nID_Detail_PRC > 0
								nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisFormSet.nConnhandle) 
							ELSE
								nID_Detail = get_ID_Detail_from_WOD(nWO_Detail, ThisFormSet.nConnhandle)
							ENDIF
							IF nID_Detail > 0
								nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnhandle) 
							ENDIF
							ThisFormSet.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							ThisFormSet.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
					**
					IF nID_Detail = 0
						DO CASE
						CASE nWO_Detail > 0
							MESSAGEBOX("WO_Detail "+ALLTRIM(STR(nWO_Detail))+" did not create a Stock Listing!"+CHR(13)+"Tell Elliot to have WO_Detail"+CHR(13)+"Create an Incoming process"+CHR(13)+CHR(13)+"You may get another chance at end of code.",0+48,"WO Detail, NO Incoming Process")
						CASE nRMA_No > 0
							MESSAGEBOX("RMA "+ALLTRIM(STR(nRMA_No))+" could not create the Stock Listing here."+CHR(13)+"There will be another place to Add back Stock",0+48,"RMA, NO Incoming Process")
						OTHERWISE
							MESSAGEBOX("Did not create a Stock Listing!"+CHR(13)+"Tell PO rep edit Purchase Order and save it to"+CHR(13)+"Create an Incoming process"+CHR(13)+CHR(13)+"You may get another chance at end of code.",0+48,"NO Incoming Process")
						ENDCASE
		
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		************************
		cSQLu = ''
		IF nReceivingID > 0 &&SaveAdd()
			**Check for Existing Record
			nReceivingIDOld = nReceivingID
			
			cSQL = "SELECT Count(*) AS Cntd FROM dbo.Receiving WITH(NOLOCK) WHERE ID ="+STR(nReceivingID)
			IF USED("tmpCountRid")
				USE IN tmpCountRid
			ENDIF
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountRid')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountRid')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountRid")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountRid")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCountRid')
				*TrackMess("Error with Add Receiving ID:"+ALLTRIM(STR(nReceivingID)) )
				TrackError("Check for Existing Record. "+CHR(13)+cSQL ,"bad select",PROGRAM(),LINENO(1))
			ELSE
				IF tmpCountRid.Cntd > 0
					*Update Receiving by ReceivingID
					*Also edit changes her in PurchaseOrder chkComplete
					
					lAlready_Saved = .T.
					
					cSQLu = "UPDATE dbo.Receiving SET"
					cSQLu = cSQLu +" Received='"+IIF(EMPTY(dReceived),'',DTOC(dReceived)) +"'"
					cSQLu = cSQLu +",POitem=dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQLu = cSQLu +",SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
					cSQLu = cSQLu +",WO="+STR(nWO)
					cSQLu = cSQLu +",WO_Detail="+STR(nWO_Detail)
					cSQLu = cSQLu +",Alloy='"+cAlloy+"'"
					cSQLu = cSQLu +",Heat='"+cHeat+"'"
					cSQLu = cSQLu +",Lot='"+cLot+"'"
					cSQLu = cSQLu +",Cert="+IIF(lCert,'1','0')+""	&&BIT
					cSQLu = cSQLu +",Pieces="+STR(nPieces)
					cSQLu = cSQLu +",Description='"+cDescription+"'"
					cSQLu = cSQLu +",Specs='"+cSpecs+"'"
					cSQLu = cSQLu +",Comments='"+cComments+"'"
					cSQLu = cSQLu +",Init='"+cInit+"'"
					cSQLu = cSQLu +",[Date]='"+IIF(EMPTY(dDate),'',DTOC(dDate)) +"'"
					cSQLu = cSQLu +",Pass="+IIF(lPass,'1','0')
					cSQLu = cSQLu +",GoodPapers="+IIF(lGoodPapers,'1','0')
					cSQLu = cSQLu +",ActualW="+STR(nActualW,9,1)
					cSQLu = cSQLu +",BillW="+STR(nBillW,9,1)
					
					cSQLu = cSQLu +",R_Qty="+STR(nAcct_QTY,18,4)
					cSQLu = cSQLu +",R_P ="+STR(nAcct_P,18,4)
					cSQLu = cSQLu +",R_PU="+STR(nAcct_PU)
					
						*use PO Fields for WO_Detail Data		
					cSQLu = cSQLu +",PO_Qty="+STR(nPO_QTY,18,4)
					cSQLu = cSQLu +",PO_P="+STR(nPO_P,18,4)
					cSQLu = cSQLu +",PO_PU="+STR(nPO_PU)
					
					cSQLu = cSQLu +",Vendor='"+cVendor+"'"
		*--			cSQLu = cSQLu +",Cancelled=0"
					cSQLu = cSQLu +",ID_Master="+STR(nID_Master)
					cSQLu = cSQLu +",ID_Detail="+STR(nID_Detail)
					cSQLu = cSQLu +",StockTable='"+cTBL+"'"
					
					cSQLu = cSQLu +",RejectPC="+STR(nRejectPC)
					cSQLu = cSQLu +",RejectReason='"+cRejectReason+"'"
					cSQLu = cSQLu +",RMA_No="+STR(nRMA_No)
					cSQLu = cSQLu +",RMA_Detail="+STR(nRMA_Detail)
					cSQLu = cSQLu +",hold="+IIF(lHold,"1","0")
					cSQLu = cSQLu +",Form='"+cForm+"'"
					
					cSQLu = cSQLu +",Services="+IIF(lServicesPO,"1","0")
					cSQLu = cSQLu +",ConvServ="+IIF(lConvServ,"1","0")
					cSQLu = cSQLu +",Equipment="+IIF(lEquipment,"1","0")
						
					cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
						lSaved = .F.
						TrackError("Update Receiving by ReceivingID. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
						*RETURN
					ELSE 
						lSaved = .T.
						lSaveByOldMethod = .F.
						TrackMess("Updated Receiving ID:"+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(cPOitem)+", SO:"+ALLTRIM(cSOitem) )
						IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
							*Alert SO Status
							IF lRMA
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "RecvUpdate", "Update the Receiving ID:"+ALLTRIM(STR(nReceivingID))+" for RMA_Detail "+ALLTRIM(STR(nRMA_Detail)) , ThisFormSet.nConnhandle)
							ELSE
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "RecvUpdate", "Update the Receiving ID:"+ALLTRIM(STR(nReceivingID))+" for POitem '"+cPOitem+"'" , ThisFormSet.nConnhandle)
							ENDIF
						ELSE
							IF lRMA
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisFormSet.nConnhandle)
							ENDIF
						ENDIF
					ENDIF
					
				ELSE
					*ReceivingID was not found in dbo.Receiving !!
					
					nReceivingIDOld = nReceivingID 
					*Insert INTO dbo.Receiving
					cSQLi = "EXEC dbo.p_Receiving_ins3 "
					cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
					cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
					cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
					cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
					cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
					cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
					cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
					cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
					cSQLi = cSQLi +",@Description ='"+cDescription+"'"
					cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
					cSQLi = cSQLi +",@Comments ='"+cComments+"'"
					cSQLi = cSQLi +",@Init ='"+cInit+"'"
					cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
					cSQLi = cSQLi +",@Pass ="+IIF(lPass,'1','0')
					cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
					cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
					cSQLi = cSQLi +",@BillW ="+STR(nBillW)
					cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
					cSQLi = cSQLi +",@RejectPC="+STR(nRejectPC)
					cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
					cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
					
					IF USED("tmpIDReceiving")
						USE IN tmpIDReceiving
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpIDReceiving')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpIDReceiving')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpIDReceiving")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpIDReceiving")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLi,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpIDReceiving')
						TrackError("Insert INTO dbo.Receiving. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
					ELSE &&IF nSQLEXEC < 1
						lSaved = .T.
						
						IF USED("tmpIDReceiving")
							nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'RID',-3)
							
							IF nReceivingID > 0		&&Should do this later when ID_Master and ID_Detail are known
								*UPDATE the rest of that dbo.Receiving record
								
								cSQLu = "UPDATE dbo.Receiving SET "
								cSQLu = cSQLu +" StockTable='"+cTBL+"'"
								cSQLu = cSQLu +",ID_Master="+STR(nID_Master)
								cSQLu = cSQLu +",ID_Detail="+STR(nID_Detail)
								cSQLu = cSQLu +",RMA_Detail="+STR(nRMA_Detail)
								
								cSQLu = cSQLu +",Lot='"+cLot+"'"
								
								cSQLu = cSQLu +",R_Qty="+STR(nAcct_QTY,18,4)
								cSQLu = cSQLu +",R_P ="+STR(nAcct_P,18,4)
								cSQLu = cSQLu +",R_PU="+STR(nAcct_PU)
								
								*use PO Fields for WO_Detail Data
								cSQLu = cSQLu +",PO_Qty="+STR(nPO_QTY,18,4)
								cSQLu = cSQLu +",PO_P="+STR(nPO_P,18,4)
								cSQLu = cSQLu +",PO_PU="+STR(nPO_PU)
					
								cSQLu = cSQLu +",hold="+IIF(lHold,"1","0")
								cSQLu = cSQLu +",Form='"+cForm+"'"
								
								cSQLu = cSQLu +",Services="+IIF(lServicesPO,"1","0")
								cSQLu = cSQLu +",ConvServ="+IIF(lConvServ,"1","0")
								cSQLu = cSQLu +",Equipment="+IIF(lEquipment,"1","0")
						
								cSQLu = cSQLu + " WHERE ID="+STR(nReceivingID)
								
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, '')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, '')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
									TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
								ENDIF
								
								
								cMess = "Added Receiving ID:"+ALLTRIM(STR(nReceivingID))
								cMess = cMess + " WAS Receiving ID:"+ALLTRIM(STR(nReceivingIDOld))
								cMess = cMess + ", PO:"+ALLTRIM(cPOitem)
								cMess = cMess + ", SO:"+ALLTRIM(cSOitem)
								cMess = cMess + ", WO_Detail:"+ALLTRIM(STR(nWO_Detail))
								cMess = cMess + ", WO:"+ALLTRIM(STR(nWO))
								IF lRMA 
									cMess = cMess + ", RMA:"+ALLTRIM(STR(nRMA_No))
									cMess = cMess + ", RMA_Detail:"+ALLTRIM(STR(nRMA_Detail))
								ENDIF
								
								cMess = ShowSQLtxt(cMess,'Mess',-1)
								*TrackMess(cMess)
								TrackError(cMess,"nReceivingID is not 0, but is a new Receive!",PROGRAM(),LINENO(1))
								RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"nReceivingID is not 0, but was not found in Receiving table!"+CHR(13)+cMess+" "+CHR(13)+cSQL  )
								
								lSaveByOldMethod = .F.
								
								IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
									*Alert SO Status
									IF lRMA
										Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" for RMA_Detail "+ALLTRIM(STR(nRMA_Detail)) , ThisFormSet.nConnhandle)
									ELSE
										Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+CHR(13)+", WAS Receiving ID:"+ALLTRIM(STR(nReceivingIDOld)), ThisFormSet.nConnhandle)
									ENDIF
								ELSE
									IF lRMA
										Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisFormSet.nConnhandle)
									ENDIF
								ENDIF
								
								USE IN tmpIDReceiving 
								ThisFormSet.Receive_Edit.txtReceivingID.Value = nReceivingID 
								ThisFormSet.Receive_Edit.txtReceivingID.Refresh
							ENDIF						
						ENDIF
						
						PRIVATE cMess
						cMess = "Added Receiving ID:"+ALLTRIM(STR(nReceivingID)) 
						cMess = cMess + ", POitem '"+cPOitem+"'"
						cMess = cMess + ", SOitem '"+cSOitem+"'"
						cMess = cMess + ", WO_Detail:"+ALLTRIM(STR(nWO_Detail))
						cMess = cMess + ", WO:"+ALLTRIM(STR(nWO))
						TrackMess(cMess)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpCountRid")
			USE IN tmpCountRid
		ENDIF
		
		*****************************
		*Is nReceivingID still 0
		PRIVATE nMess, lSaveRMAtoStock 
		nMess = 6
		lSaveRMAtoStock = .T.
		
		IF nReceivingID = 0 
			*NO nReceivingID Found! -must be NewAdd Save
			nReceivingIDOld = 0
			
			IF lRMA
				nMess = MESSAGEBOX("Is this material worth stocking?",4+32,"Found RMA number!")
				IF nMess = 6
					lSaveRMAtoStock = .T.
				ELSE
					lSaveRMAtoStock = .F.
				ENDIF
			ENDIF
			
			
			*Insert as new and get ReceivingID
			*Insert INTO dbo.Receiving
			cSQLi = "EXEC dbo.p_Receiving_ins3 "
			cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
			cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
			cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
			cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
			cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
			cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
			cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
			cSQLi = cSQLi +",@Description ='"+cDescription+"'"
			cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
			cSQLi = cSQLi +",@Comments ='"+cComments+"'"
			cSQLi = cSQLi +",@Init ='"+cInit+"'"
			cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
			cSQLi = cSQLi +",@Pass ="+IIF(lPass,'1','0')
			cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
			cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
			cSQLi = cSQLi +",@BillW ="+STR(nBillW)
			cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
			cSQLi = cSQLi +",@RejectPC="+STR(nRejectPC)
			cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
			cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
			
			IF USED("tmpIDReceiving")
				USE IN tmpIDReceiving
			ENDIF
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpIDReceiving')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpIDReceiving')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpIDReceiving")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpIDReceiving")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpIDReceiving')
				TrackError("Insert as new and get ReceivingID. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
			ELSE &&IF nSQLEXEC < 1
				lSaved = .T.
				
				IF USED("tmpIDReceiving")
					nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'ReceivingID',-3)
		*				TrackMess("Added Receiving ID:"+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(cPOitem)+", SO:"+ALLTRIM(cSOitem))
					
					lSaveByOldMethod = .F.
					USE IN tmpIDReceiving 
					
					ThisFormSet.Receive_Edit.txtReceivingID.Value = nReceivingID 
					ThisFormSet.Receive_Edit.txtReceivingID.Refresh
					
					IF VARTYPE(nReceivingID) != "N"		
						TrackError("nReceivingID is not a NUMBER"+CHR(13)+cSQLi,"SaveAdd(INSERT) failed.",PROGRAM(),LINENO(1))
					ELSE
						*MESSAGEBOX("Added Receive.",64,"Success")
						MESSAGEBOX("Added Receive to Database."+CHR(13)+"This data is now in the Receiving table."+CHR(13)+CHR(13)+"Heat "+cHeat,64,"Successful Insert Receive")
						*TrackMess(LEFT("Added Receiving ID:"+STR(nReceivingID)+CHR(13)+" Did not find a Receiving ID."+CHR(13)+cSQLi ,254))	
						
						IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
							*Alert SO Status
							IF lRMA
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisFormSet.nConnhandle)
							ELSE
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID)), ThisFormSet.nConnhandle)
							ENDIF
						ELSE
							IF lRMA
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisFormSet.nConnhandle)
							ENDIF
						ENDIF
						
					ENDIF
					
					IF nReceivingID > 0
						*UPDATE the rest of that dbo.Receiving record
						
						cSQL = "UPDATE dbo.Receiving SET "
						cSQL = cSQL + " StockTable='"+cTBL+"'"
						cSQL = cSQL + ",ID_Master="+STR(nID_Master)
						cSQL = cSQL + ",ID_Detail="+STR(nID_Detail)
						cSQL = cSQL + ",RMA_Detail="+STR(nRMA_Detail)
						
						cSQLu = cSQLu +",Lot='"+cLot+"'"
						
						cSQL = cSQL + ",R_Qty="+STR(nAcct_QTY,18,4)
						cSQL = cSQL + ",R_P ="+STR(nAcct_P,18,4)
						cSQL = cSQL + ",R_PU="+STR(nAcct_PU)
						
						*use PO Fields for WO_Detail Data				
						cSQL = cSQL +",PO_Qty="+STR(nPO_QTY,18,4)
						cSQL = cSQL +",PO_P="+STR(nPO_P,18,4)
						cSQL = cSQL +",PO_PU="+STR(nPO_PU)
					
						cSQL = cSQL +",hold="+IIF(lHold,"1","0")
						cSQL = cSQL +",Form='"+cForm+"'"
						
						cSQL = cSQL +",Services="+IIF(lServicesPO,"1","0")
						cSQL = cSQL +",ConvServ="+IIF(lConvServ,"1","0")
						cSQL = cSQL +",Equipment="+IIF(lEquipment,"1","0")
		
						cSQL = cSQL + " WHERE ID="+STR(nReceivingID)
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
							TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
						ENDIF
					ENDIF	
				ENDIF			
			ENDIF
			
			IF nReceivingID = 0
				IF nRMA_No = 0
					*Could be a new Add and nReceivingID has not been set
					TrackError("nReceivingID is 0, Should have been set by EXEC dbo.p_Receiving_ins3 ."+CHR(13)+cSQL,"bad variable",PROGRAM(),LINENO(1))
					*TrackMess("nReceivingID is 0, Should have been set by EXEC dbo.p_Receiving_ins3 ."+CHR(13)+"bad variable"+CHR(13)+"Shop_StockLst_Edit:ReceivingSaveAdd")
				ENDIF
			ENDIF
		ENDIF
		
		*******************************************************
		*******************************************************
		*!*	IF NOT (lServicesPO or lConvServ or lEquipment)
		*!*		** Save Receiving ID to Stock Detail
		
		*!*		IF lSaved AND nReceivingID > 0 AND nID_Master > 0 AND nID_Detail > 0
		*!*			IF NOT (cTBL="S" OR cTBL="B" OR cTBL="W")
		*!*				cTBL = get_TBLwithID_ID_Detail(nID_Master,nID_Detail,ThisFormSet.nConnhandle)
		*!*			ENDIF
		*!*			
		*!*			DO CASE
		*!*			CASE cTBL = "S"
		*!*				cSQL = "UPDATE dbo.StockLst_Detail "
		*!*			CASE cTBL = "B"
		*!*				cSQL = "UPDATE dbo.BrokerLst_Detail "
		*!*			CASE cTBL = "W"
		*!*				cSQL = "UPDATE dbo.WIPLst_Detail "
		*!*			OTHERWISE
		*!*				cSQL = "Lost cTBL "	
		*!*			ENDCASE				
		*!*				
		*!*			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
		*!*			cSQL = cSQL + " WHERE ID="+STR(nID_Master)
		*!*			cSQL = cSQL + " AND ID_Detail="+STR(nID_Detail)
		
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
		*!*				TrackError("Save Receiving ID to Stock Detail. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		*!*	*******************************************************
				
		IF nReceivingID = 0
			IF NOT lRMA
				TrackError("bad variable","nReceivingID is 0, Could not run ReceivingSaveID_Master(nReceivingID)",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		********************************************************
		
		PRIVATE cMess
		IF NOT lRan_Show_Recv_Order
			DO CASE 
			CASE nWO_Detail > 0
				*FLOOR(nPOcomplete) = 2
			CASE nCntPOitemMetal = 0
				*Service, Eqp or Conv
				*FLOOR(nPOcomplete) 0,1,2,3
				*FLOOR(nPOcomplete) = 2
			CASE lRMA 
				*FLOOR(nPOcomplete) = 2
			OTHERWISE
				
				cMess = "SaveAdd(): Did not run Show_Recv_Order."+CHR(13)
				cMess = cMess +"INIT pWhat="+ThisFormSet.cWhat+", pcHeat="+ThisFormSet.cHeat+CHR(13)
				cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
				cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
				cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
				cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
				cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
				cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
				cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
				cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
				cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
				cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
				cMess = cMess +", pSaveType = '"+pSaveType+"'"
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
			ENDCASE
		ENDIF
		
		********************
		PRIVATE lOK
		lOK = .F.
		
		**********************
		PRIVATE lRun_Recv_Stock
		lRun_Recv_Stock = .F.
		
		
		********************************************
		*By POitem
		* 
		IF lRMA
			IF lSaved 
				*ThisFormSet.MarkAsRMAreceived()	&&Done later
				lOK = .T.
			ENDIF
		ELSE
			IF lSaved 
				lOK = .T.
				
				******************
				IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
					IF nCntPOitemMetal > 0
					
						PRIVATE nCntPOitem
						*nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle,"METAL")
						nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle,"METAL")
						
						IF nCntPOitem > 0 &&AND NOT (lServicesPO or lConvServ or lEquipment)
							IF ThisFormSet.UpdatePOitemRecDt(dReceived,cPOitem,FLOOR(nPOcomplete) ) &&Safe Received Date update.
							ENDIF
						
							lSaved = ThisFormSet.SaveAdd._PurchaseOrder(nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,FLOOR(nPOcomplete) )
							IF lSaved
								IF nID_Master = 0
									nID_Master	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Master.Value,'ID',-3)
								ENDIF
								IF nID_Detail= 0
									nID_Detail	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
								ENDIF
								*Receive_Stock calls forms\Recv_Stock()
								lRun_Recv_Stock = .F.
								*ThisFormSet.lRan_Recv_Stock  = .T.
							ENDIF
						ELSE
							IF (lServicesPO or lConvServ or lEquipment)
								WAIT WINDOW nPOcomplete
								IF ThisFormSet.UpdatePOitemRecDt(dReceived,cPOitem,FLOOR(nPOcomplete) ) &&Safe Received Date update.
								
								ENDIF			
							ELSE
								cMess = "SaveAdd(): Did not find POitem Count_POIteminPurchaseOrder()."+CHR(13)
								cMess = cMess +"INIT pWhat="+ThisFormSet.cWhat+", pcHeat="+cHeat+CHR(13)
								cMess = cMess +"Did not run ThisFormSet.UpdatePOitemRecDt()"+CHR(13)
								cMess = cMess +"Did not run SaveAdd._PurchaseOrder()"+CHR(13)
								cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
								cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
								cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
								cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
								cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
								cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
								cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
								cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
								cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
								cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
								RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
							ENDIF
						ENDIF
					ELSE
						*Not a Metal Receive.
					ENDIF
					
					IF pSaveType == "ADD"
						* not "ADDCLONE"
						*ThisFormSet.ResetAddVars()
					ELSE
						IF pSaveType = "ADDCLONE"
							ThisFormSet.lClone = .T.
							ThisFormSet.Receive_Edit.txtReceivingID.Value = 0
							*ThisFormSet.Receive_Edit.txtHeat.Value = '*'+ThisFormSet.Receive_Edit.txtHeat.Value
						ENDIF
					ENDIF
				ENDIF
				
				******************************
				IF nWO_Detail > 0
					PRIVATE nCntWO_Detail
					*nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle,"METAL")
					nCntWO_Detail = Count_WODinWO_Detail( nWO_Detail, ThisFormSet.nConnhandle,"NOTCANCELLED")
					
					IF nCntWO_Detail > 0
						*IF ThisFormSet.Receive_Edit.UpdatePOitemRecDt(dReceived,cPOitem,FLOOR(nPOcomplete) ) &&Safe Received Date update.
						IF ThisFormSet.UpdateWO_DetailRecDt(dReceived,nWO_Detail,FLOOR(nPOcomplete) ) &&Save Received Date update.
						ENDIF
					
						*lSaved = ThisFormSet.SaveAdd._PurchaseOrder(nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,FLOOR(nPOcomplete) )
						lSaved = ThisFormSet.SaveAdd._WO_Detail(nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,FLOOR(nPOcomplete) )
						IF lSaved
							IF nID_Master = 0
								nID_Master	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Master.Value,'ID',-3)
							ENDIF
							IF nID_Detail= 0
								nID_Detail	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
							ENDIF
							*Receive_Stock calls forms\Recv_Stock()
							lRun_Recv_Stock = .T.
							*ThisFormSet.lRan_Recv_Stock  = .T.
						ENDIF
					ELSE
						cMess = "SaveAdd(): Did not find WO_Order Count_WODinWO_Detail()."+CHR(13)
						cMess = cMess +"INIT pWhat="+ThisFormSet.cWhat+", pcHeat="+cHeat+CHR(13)
						cMess = cMess +"Did not run ThisFormSet.UpdateWO_DetailRecDt()"+CHR(13)
						cMess = cMess +"Did not run WO_Detail()"+CHR(13)
						cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
						cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
						cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
						cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
						cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
						cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
						cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
						cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
						cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
						cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
					ENDIF
					
					IF pSaveType = "ADDCLONE"
						ThisFormSet.lClone = .T.
						ThisFormSet.Receive_Edit.txtReceivingID.Value = 0
						*ThisFormSet.Receive_Edit.txtHeat.Value = '*'+ThisFormSet.Receive_Edit.txtHeat.Value
					ENDIF		
				ENDIF
				*Called in SaveAdd_PurchaseOrder
				*lSaved = ThisFormSet.Receive_Edit.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, 0, cSOitem, nWO_Detail ) 
				*Receive_Stock calls forms\Recv_Stock()
				lRun_Recv_Stock = .F.
				*ThisFormSet.lRan_Recv_Stock  = .T.
		
			ENDIF
			
			****************************
			IF lSaved 			
				IF lHold
					*****************************************
					IF nWO_Detail > 0
						
					ENDIF
					*****************************************
					IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
						cSQL = "UPDATE dbo.PurchaseOrder "
						cSQL = cSQL+" SET Hold = 1 "
						cSQL = cSQL+" WHERE [POitem] = dbo.f_ProperPOitem('"+cPOitem+"')"
					  	
					  	nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
							TrackError("Insert dbo.Sales_Hold_Status. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
						ENDIF
						
						*now hold status
						****************
					
						cSQL = "INSERT INTO dbo.Sales_Hold_Status "
						cSQL = cSQL+"([SOitem],[SalesNum],[POitem],[Hold_Type],[Hold_Value] "
			      		cSQL = cSQL+",[What],[Comment]) VALUES ("
			      		cSQL = cSQL+"'"+cSOitem+"'"
			      		cSQL = cSQL+","+STR(nSalesNum)
			      		cSQL = cSQL+",'"+cPOitem+"'"
			      		cSQL = cSQL+",'PO'"
			      		cSQL = cSQL+",1 "
			      		*--[What],[Comment] are in next code
			      		
			      		IF NOT lPass
			      			cSQL = cSQL+",'PO On Receiving Hold'"
			      			cSQL = cSQL+",'Receiving QA Spec issues. RID: "+ALLTRIM(STR(nReceivingID))+"'"
			      		ELSE
			      			cSQL = cSQL+",'PO On Receiving Hold'"
				      		cSQL = cSQL+",'Receiving found issues RID: "+ALLTRIM(STR(nReceivingID))+"'"
			      		ENDIF
			      		cSQL = cSQL+")"
			      		
			  			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
							TrackError("Insert dbo.Sales_Hold_Status. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
						ENDIF
						
					ELSE
					
						IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
						
							cSQL = "UPDATE dbo.Sales "
							cSQL = cSQL+" SET Hold = 1 "
							cSQL = cSQL+" WHERE [SOitem] = dbo.f_ProperSOitem('"+cSOitem+"')"
						  	
						  	nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
								TrackError("Insert dbo.Sales_Hold_Status. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
							ENDIF
							
							*now hold status
							****************	
							cSQL = "INSERT INTO dbo.Sales_Hold_Status "
							cSQL = cSQL+"([SOitem],[SalesNum],[POitem]"
							cSQL = cSQL+",[Hold_Type],[Hold_Value] "
				      		cSQL = cSQL+",[What],[Comment]) VALUES ("
				      		cSQL = cSQL+"'"+cSOitem+"'"
				      		cSQL = cSQL+","+STR(nSalesNum)
				      		cSQL = cSQL+",'"+cPOitem+"'"
				      		
				      		cSQL = cSQL+",'RCV'"		&&--EQP, INV, AR, QA, PO, CSTR
				      		cSQL = cSQL+",1 "
				      		*--[What],[Comment] are in next code
				      		IF NOT lPass
				      			cSQL = cSQL+",'SO On RCV Hold'"
				      			cSQL = cSQL+",'Receiving issues for SO. RID: "+ALLTRIM(STR(nReceivingID))+"'"
				      		ELSE
				      			cSQL = cSQL+",'SO On Hold'"
					      		cSQL = cSQL+",'Receiving found issues for SO. RID: "+ALLTRIM(STR(nReceivingID))+"'"
				      		ENDIF
				      		cSQL = cSQL+")"
				      		
				  			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
								TrackError("Insert dbo.Sales_Hold_Status. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
			IF lSaved 			
				IF pSaveType == "ADD"
					* not "ADDCLONE"
					ThisFormSet.ResetAddVars()
				ENDIF
				IF pSaveType = "ADDCLONE"
					ThisFormSet.lClone = .T.
					ThisFormSet.Receive_Edit.txtReceivingID.Value = 0
					*IF NOT LEFT(ThisFormSet.Receive_Edit.txtHeat.Value,1) = '*'
					*	ThisFormSet.Receive_Edit.txtHeat.Value = '*'+ThisFormSet.Receive_Edit.txtHeat.Value
					*ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		********************************************
		*Remove_Incoming_Process
		PRIVATE lRemove_Incoming_Process
		lRemove_Incoming_Process = .F.
		
		IF NOT lRMA
			IF lSaved
				IF FLOOR(nPOcomplete) = 2 AND LEN(cTBL) > 0 
				
					IF ( ThisFormSet.cWhat = "S_Process" OR ThisFormSet.cWhat = "B_Process" OR ThisFormSet.cWhat = "W_Process" );
						OR (ThisFormSet.cWhat = "ADD" AND nID_Detail_PRC > 0);
						OR (ThisFormSet.cWhat = "ADD" AND nWO_Detail > 0) 	
					
						*By ID_Detail* Do not rely on POitem 
						*remove INCOMING Process that Receive Edit started
						
						*make sure there is a SELECT process before the Incoming process is removed.
						*when there is a know SO or WO.
		
						IF Proper_PO_Item(cPOitem) != Proper_PO_Item('') AND  nCntPOitemMetal > 0 
							Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'SOitem', cPOitem, nReceivingID, ThisFormSet.nConnhandle)
						ENDIF
						
						IF nSalesNum > 0 
							Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'SOitem', cSOitem, nReceivingID, ThisFormSet.nConnhandle)
						ENDIF
						IF nWO_Detail > 0 
							Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'WO_Detail', nWO_Detail, nReceivingID, ThisFormSet.nConnhandle)
						ENDIF
						IF nWO > 0
							Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'WO', nWO, nReceivingID, ThisFormSet.nConnhandle)
						ENDIF
					ENDIF
					
					
					IF cTBL = "S" OR cTBL = "B" OR cTBL = "W" 
						IF nID_Detail > 0
							IF Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, nReceivingID, ThisForm.nConnHandle)
								lRemove_Incoming_Process = .T.
							ENDIF
						ELSE
							lRemove_Incoming_Process = .T.
						ENDIF
					ENDIF
					
					IF !lRemove_Incoming_Process AND ( nCntPOitemMetal > 0 OR nWO_Detail > 0 )
						 
					
						cMess = "SaveAdd(): Remove_Incoming_Process_by_ID_Detail failed."+CHR(13)
						cMess = cMess +"INIT pWhat="+ThisFormSet.cWhat+", pcHeat="+cHeat+CHR(13)
						cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
						cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
						cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
						cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
						cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
						cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
						cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
						cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
						cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
						cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)	
						
						
					ENDIF
				ELSE
					*Could be WO_Detail
					
				ENDIF
				
				*****
		
		*!*			IF !lRemove_Incoming_Process AND ( nCntPOitemMetal > 0 OR nWO_Detail > 0 )
		*!*				*Remove_Incoming_Process_RID, send FLOOR(nPOcomplete) to decide to delete Process
		*!*				IF Remove_Incoming_Process_RID(cPOItem,nPieces,nActualW,nAcct_QTY,nAcct_PU, ThisFormSet.nConnhandle, FLOOR(nPOcomplete), nReceivingID, cTBL )
		*!*					lRemove_Incoming_Process = .T.
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			*****
		*!*			IF !lRemove_Incoming_Process AND ( nCntPOitemMetal > 0 OR nWO_Detail > 0 )
		
		*!*				*Remove_Incoming_Process_by_POitem 
		*!*				IF FLOOR(nPOcomplete) = 2 
		*!*					IF Remove_Incoming_Process_by_POitem(cPOitem, ThisFormSet.nConnhandle)
		*!*						lRemove_Incoming_Process = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
				*****
				IF FLOOR(nPOcomplete) = 2 	
					*Send Report 
					cMess = "SaveAdd(): "+IIF(lRemove_Incoming_Process,"Successfully removed Incoming Process.","Failed to remove Incoming Process." )+CHR(13)
					cMess = cMess +"INIT pWhat="+ThisFormSet.cWhat+", pcHeat="+cHeat+CHR(13)
					cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
					cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
					cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
					cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
					cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
					cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
					cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
					cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
					cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
					cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
		
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)	
				ENDIF
			ENDIF
		ENDIF
		
		
		********************************************
		IF lRMA
			*RMA
		*	IF NOT lOK
			IF nReceivingID > 0
				*RMA does not have a Process!
				
				IF ThisFormSet.MarkAsRMAreceived(nReceivingID)
					*Add RMA to StockLst
					lSaved = ThisFormSet.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, nRMA_Detail, cSOitem, nWO_Detail ) 
					*Receive_Stock call Forms\Recv_Stock
					lRun_Recv_Stock = .F.
					*ThisFormSet.lRan_Recv_Stock  = .T.
		
					IF lSaved 
						IF pSaveType == "ADD"
							ThisFormSet.ResetAddVars()
						ELSE
							IF pSaveType = "ADDCLONE"
								ThisFormSet.lClone = .T.
								ThisFormSet.Receive_Edit.txtReceivingID.Value = 0
								*IF NOT LEFT(ThisFormSet.Receive_Edit.txtHeat.Value,1) = '*'					
								*	ThisFormSet.Receive_Edit.txtHeat.Value = '*'+ThisFormSet.Receive_Edit.txtHeat.Value
								*ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		*	ENDIF
		ENDIF	
		
		
		*************************************
		PRIVATE lFoundHistory
		lFoundHistory = .F.
		
		
		IF lOK AND lSaved
			*FLOOR(nPOcomplete) 0,1 Good, incomplete, 2 Good Complete, 3 Edit
			IF nID_Detail = 0 AND nID_Master = 0 AND ( nCntPOitemMetal > 0 or nWO_Detail > 0 )
		
				*********************************
				*Check History to see if a StockLst MASTER Add is needed
				
				
				*IGNORE, If there is history
				IF USED('cntMDP_History')
					USE IN cntMDP_History
				ENDIF
		
				cSQL = "SELECT DISTINCT 'S' AS TBL, P.ID_Detail, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History P "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M ON D.ID = M.ID "
				cSQL = cSQL + " WHERE ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'PARTRECV' )"
				cSQL = cSQL + " AND P.WHAT = 'DELETE' "
				IF Proper_PO_Item(cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				ENDIF
				IF nWO_Detail > 0
					cSQL = cSQL + " AND P.WO_Detail = "+ALLTRIM(STR(nWO_Detail))
				ENDIF
		
				IF LEN(cHeat) > 0
					cSQL = cSQL + " AND M.Heat = '"+cHeat+"'"
				ENDIF
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
				ENDIF
		
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntMDP_History')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntMDP_History')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntMDP_History")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntMDP_History")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'cntMDP_History')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('cntMDP_History')	
					IF RECCOUNT('cntMDP_History') > 0
						*A P.Process_ID = 'INCOMING' with this POitem has already been deleted
						lFoundHistory = .T.
					ENDIF
					USE IN cntMDP_History
				ENDIF
			ENDIF
			
			**************************************
			
			IF nID_Detail = 0 AND nID_Master > 0 AND nRMA_No > 0
				*********************************
				*Check History to see if a StockLst Add is needed
				
				
				*IGNORE, If there is history
				IF USED('cntMDP_History')
					USE IN cntMDP_History
				ENDIF
		
				cSQL = "SELECT DISTINCT 'S' AS TBL, P.ID_Detail, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History P "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M ON D.ID = M.ID "
				cSQL = cSQL + " WHERE ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'RECEIVED' OR P.Process_ID = 'PARTRECV')"
				cSQL = cSQL + " AND P.WHAT = 'DELETE' "
				cSQL = cSQL + " AND M.ID = "+STR(nID_Master )
				
				IF LEN(cHeat) > 0
					cSQL = cSQL + " AND M.Heat = '"+cHeat+"'"
				ENDIF
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
				ENDIF
		
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntMDP_History')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntMDP_History')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntMDP_History")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntMDP_History")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'cntMDP_History')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('cntMDP_History')	
					IF RECCOUNT('cntMDP_History') > 0
						*A P.Process_ID = 'INCOMING' with this POitem has already been deleted
						lFoundHistory = .T.
					ENDIF
					USE IN cntMDP_History
				ENDIF
			ENDIF
		ENDIF
		
		***************************************
		IF NOT lRun_Recv_Stock
			IF lFoundHistory
		
				cMess = "Found record in History Archive for "+CHR(13)
				IF Proper_PO_Item(cPOitem) <> Proper_PO_item('')
					cMess = cMess + " and POitem = '"+cPOitem+"'"
				ENDIF
				IF nWO_Detail > 0
					cMess = cMess + " and WO_Detail = "+ALLTRIM(STR(nWO_Detail))
				ENDIF
				IF nRMA_No > 0
					cMess = cMess + " and RMA_No = "+ALLTRIM(STR(nRMA_No))+" for ID "+ALLTRIM(STR(nID_Master))
				ENDIF
				IF LEN(ThisFormSet.cHeat) > 0
					cMess = cMess + CHR(13) +" and Heat = '"+ThisFormSet.cHeat
				ENDIF
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
				ENDIF
		
				nMess = MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Do you want to ADD this to stock? (Y)"+CHR(13)+"Make sure this is DIFFERENT stock (Heat/Lot)"+CHR(13)+"Answer No if this is same stock",4+48,"Add to Stock")
				IF nMess = 6
					lRun_Recv_Stock = .T.
				ENDIF
			ELSE
				*not found in History
				IF lOK AND lSaved
					IF nID_Detail = 0 AND nID_Master > 0 AND nRMA_No > 0
						*-- get Detail by RMA_No
						IF nCntPOitemMetal > 0 OR nWO_Detail > 0
							IF pSaveType = "EDIT"	
								*nCntPOitemMetal did not look for Heat
		
								IF USED('cntMDP_History')
									USE IN cntMDP_History
								ENDIF
		
								cSQL = "SELECT DISTINCT 'S' AS TBL, P.ID_Detail, P.ID_Detail_Process "
								cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History P "
								cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D ON P.ID_Detail = D.ID_Detail "
								cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M ON D.ID = M.ID "
								cSQL = cSQL + " WHERE ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'RECEIVED' OR P.Process_ID = 'PARTRECV')"
								cSQL = cSQL + " AND M.ID = "+STR(nID_Master )
								
								IF LEN(cHeat) > 0
									cSQL = cSQL + " AND M.Heat = '"+cHeat+"'"
								ENDIF
								IF LEN(cLot) > 0
									cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
								ENDIF
		
		
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntMDP_History')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntMDP_History')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntMDP_History")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntMDP_History")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'cntMDP_History')
									RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
								ENDIF
		
								IF USED('cntMDP_History')	
									IF RECCOUNT('cntMDP_History') > 0
										*A P.Process_ID = 'INCOMING' with this POitem has already been deleted
										lFoundHistory = .T.
									ENDIF
									USE IN cntMDP_History
								ENDIF
							ENDIF	
								
		
							IF NOT lFoundHistory 
								cMess = "The Heat# "+ALLTRIM(cHeat)
								IF LEN(cLot) > 0
									cMess = cMess +" /Lot "+cLot
								ENDIF
								cMess = cMess +" was not found in History."+CHR(13)
								cMess = cMess + "This Receive was to EDIT the Receive."+CHR(13)
								cMess = cMess + "Do you want to try to ADD to StockLst now? (Y)"
							
								nMess = MESSAGEBOX(cMess,4+32,"Add to Stock?")		
								
								IF nMess = 6
									lRun_Recv_Stock = .T.
								ENDIF
		
							ELSE
								lRun_Recv_Stock = .F.
								nMess = 6
							ENDIF
						ENDIF
					ENDIF
					
					**************************************
					
					IF nID_Detail > 0 AND nID_Master > 0 AND nRMA_No = 0
						DO CASE
						CASE nCntPOitemMetal > 0 
							lRun_Recv_Stock = .T.
						CASE nWO_Detail > 0
							lRun_Recv_Stock = .T.
						OTHERWISE 
							lRun_Recv_Stock = .F.
						ENDCASE
					ENDIF
				ELSE
					*NOT lOK AND lSaved
					nMess = 0
					*lRun_Recv_Stock = .T.
					lRun_Recv_Stock = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*************************
		This.Visible = .F.
		
		*PRIVATE lRan_Recv_Stock  
		*ThisFormSet.lRan_Recv_Stock  = .F.
		
		IF lRun_Recv_Stock AND NOT ThisFormSet.lRan_Recv_Stock
			DO FORM Forms\Recv_Stock WITH cPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
			lRun_Recv_Stock = .F.
			ThisFormSet.lRan_Recv_Stock = .T.
		ENDIF
		****
		IF NOT ThisFormSet.lRan_Recv_Stock  
			IF nID_Detail = 0 AND nID_Master > 0 AND nRMA_No > 0
				nMess = MESSAGEBOX("Do you want to Show/Edit the Stock?"+CHR(13)+"This was for an just an Edit to a RMA"+CHR(13)+"This will be ignoring the "+CHR(13)+"'Already Found in History' warnings!",4+32+256,"Show Stock")
				IF nMess = 6		
					DO FORM Forms\Recv_Stock WITH cPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
					ThisFormSet.lRan_Recv_Stock = .T.
					lRun_Recv_Stock = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*******
		IF ThisFormSet.lRan_Recv_Stock AND nReceivingID>0
			nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)
			nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)
		ENDIF
		
		********************************
		PRIVATE cTBL2,cTBL3
		IF lOK AND lSaved AND ( nCntPOitemMetal > 0 or nWO_Detail > 0 ) AND NOT ThisFormSet.lRan_Recv_Stock  
			*only run with a Metal PO or WO_Detail
			
			*FLOOR(nPOcomplete) 0,1 Good, incomplete, 2 Good Complete, 3 Edit
			IF nID_Detail > 0 AND nID_Master > 0 AND FLOOR(nPOcomplete) > 0 AND LEN(cTBL) > 0
				cTBL2 = get_TBLwithID_ID_Detail(nID_Master,nID_Detail, ThisFormSet.nConnhandle)
				nMess = 6
				
				IF LEN(ALLTRIM(cTBL2)) = 2	&&Found History, Returned cTBL as 'SH
					MESSAGEBOX("This Received Stock is now Archived"+CHR(13)+"Only found in the records History Files now."+CHR(13)+"No current Found!",0+32,"No current Stock to show")
					nMess = 0
				ELSE
					cTBL3 = get_TBLwithID_ID_Detail(nID_Master,nID_Detail, ThisFormSet.nConnhandle,'NOCHECKHISTORY')
					IF LEN(ALLTRIM(cTBL3)) > 0
						nMess = MESSAGEBOX("Do you want to Show/Edit the Stock?"+CHR(13)+"This was for an just an Edit"+CHR(13)+"This will be ignoring the "+CHR(13)+"'Already Found in History' warnings!",4+32+256,"Show Stock")
					ELSE
						nMess =0
					ENDIF
				ENDIF
				IF nMess = 6
					DO FORM Forms\Recv_Stock WITH cPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
					ThisFormSet.lRan_Recv_Stock = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		****************************************
		
		IF NOT lOK OR NOT lSaved
			This.Visible = .T.
		ENDIF
		
		****************************************
		*********************************
		*Alert proper department of this receive
		
		IF lOK AND lSaved
			PRIVATE lImportant
			lImportant = .T.
			
			IF pSaveType = "EDIT"
				*check for an important edit or reason to notify users.
				lImportant = .F.
				
			ENDIF
			
			**************
		
			IF lImportant
				******
				IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
					IF lRMA 
						ThisFormSet.Alert_Receive_Email('SOitem_RMA',cSOitem,nReceivingID) &&,nRMA_No, nRMA_Detail
					ELSE
						*Send to the SOitem SalesP
						ThisFormSet.Alert_Receive_Email('SOitem',cSOitem,nReceivingID )
					ENDIF
				ENDIF
				******
				IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
					IF nCntPOitemMetal = 0 
						IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "SERVICES" ) > 0
							*Testing Services
							ThisFormSet.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
						ENDIF
						IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "CONVSERV" ) > 0
							*Conversion Service
							ThisFormSet.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
						ENDIF
						IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "EQUIPMENT" ) > 0
							*Equipement
							ThisFormSet.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
						ENDIF
					ELSE		
						ThisFormSet.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
					ENDIF
				ENDIF
				******
				IF nWO_Detail > 0
					ThisFormSet.Alert_Receive_Email('WO_Detail',nWO_Detail,nReceivingID )
				ELSE
					IF nWO > 0
						ThisFormSet.Alert_Receive_Email('WO',nWO,nReceivingID )
					ENDIF
				ENDIF
				******
			ENDIF	 
		ENDIF
		
		*********************************
		
		RETURN lSaved 
		
		
		
	ENDPROC

	PROCEDURE saveadd_purchaseorder
		PARAMETERS nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA,   lAlready_Saved,nActualW,nS_QTY,nS_PU,lFoundStockUpdateReceiving,nPOcomplete 
		*          nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,lFoundStockUpdateReceiving,nPOcomplete )
		*ThisFormSet.SaveAdd_PurchaseOrder
		* Receive_Edit 
		
		IF VARTYPE(nReceivingID) != "N"		
			*TrackError("bad parameter","nReceivingID is not a NUMBER",PROGRAM(),LINENO(1))
			nReceivingID = 0
		ELSE
			IF nReceivingID = 0
				*TrackError("Bad Parameter","nReceivingID is 0",PROGRAM(),LINENO(1))
				TrackMess("nReceivingID is 0"+CHR(13)+"Bad Parameter"+CHR(13)+"Receiving:SaveAdd_PurchaseOrder")
			ENDIF
		ENDIF
		
		IF ( VARTYPE(dReceived) = "D" OR VARTYPE(dReceived) = "T" )
			*good
		ELSE
			dReceived = DATE()
		ENDIF
			
		IF VARTYPE(lFoundStockUpdateReceiving) != "L"
			lFoundStockUpdateReceiving = .F.
		ENDIF
		
		PRIVATE nItemPO,nHPAPO,nSalesNum,nItemSo
		nItemPO	= VAL(RIGHT(cPOitem,2))
		nHPAPO	= VAL(LEFT(cPOitem,AT('-',cPOitem)-1 ))
		nSalesNum	= VAL(LEFT(cSOitem,AT('-',cSOitem)-1 ))
		nItemSo	= VAL(RIGHT(cSOitem,2))
		
		*Mark PO
		PRIVATE lRollBack
		lRollBack = .F.
		
		PRIVATE nCntPOitem,nCntSOitem 
		nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle)
		nCntSOitem = 0
		
		*****************
		PRIVATE cHeatCombined,cLot
		cHeatCombined = cHeat
		cLot = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtLot.Value,'Lot',10)
		
		IF nCntPOitem > 0	
			*Add new heat to heat list
			IF USED('tmpPOHeat')
				USE IN tmpPOHeat
			ENDIF
		
			SELECT 0
			cSQL = "SELECT Heat FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOItem+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOHeat')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOHeat' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOHeat")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOHeat")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOHeat' )
			ENDIF
		
			IF USED('tmpPOHeat')
				IF VARTYPE(tmpPOHeat.Heat) = "C"
					IF NOT EMPTY(tmpPOHeat.Heat)
						IF NOT UPPER(cHeat) $ UPPER(tmpPOHeat.Heat)
							IF EMPTY(cHeat)
								cHeatCombined = PrepareSQLtxt(tmpPOHeat.Heat,'Heat',50,.F.,.T.)
							ELSE
								cHeatCombined = ALLTRIM(cHeat)+","+ALLTRIM(PrepareSQLtxt(tmpPOHeat.Heat,'Heat',50,.F.,.T.))
							ENDIF
						ENDIF
					ENDIF
				ELSE
					*Null Heat found!
				ENDIF
				USE IN tmpPOHeat
			ENDIF
		ENDIF
		
		********************
		IF nCntPOitem = 0	
			
		*	nCntSOitem = Count_SOIteminSales(cSOItem, ThisFormSet.nConnhandle)		
		*	IF nCntSOitem = 0
				*Did not find that PO in PurchaseOrder!
		
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" #Rollback")
				MESSAGEBOX("Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" #Rollback"+CHR(13)+"Please check that you typed the right PO or SO!",0,"PO or SO item not found!")
				*Do not add to PurchaseOrder
				*POitem is check early in receiving
				lRollBack = .T.
		*	ENDIF
		ENDIF
		
		PRIVATE lHold
		lHold	= PrepareSQLchk(ThisFormSet.Receive_Edit.chkHold.Value,'Hold')
		PRIVATE lPOSaveLst 
		lPOSaveLst = .F.
		
		********************
		IF NOT lRollBack AND nCntPOitem > 0	
		
			PRIVATE cSQLu
			cSQLu = "UPDATE dbo.PurchaseOrder SET "
			cSQLu = cSQLu + " Receipt ='"+cComments+"'"
			*cSQLu = cSQLu + ",Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"		
			cSQLu = cSQLu + ",ReceivedBy ='"+cInit+"'"
			cSQLu = cSQLu + ",Heat ='"+PrepareSQLtxt(cHeatCombined,'Heat',50,.F.,.T.)+"'"
			IF nPOcomplete = 2
				cSQLu = cSQLu + ",Delivered=1"
				cSQLu = cSQLu + ",CMPLT=1"
			ENDIF
			cSQLu = cSQLu + ",Cert="+IIF(lCert,'1','0')
			IF lHold
				cSQLu = cSQLu + ",Hold=1 "
			ENDIF
			cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisFormSet.nConnhandle, nSQLEXEC )
				lRollBack = .T.
			ELSE
				lPOSaveLst = .T.
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" updated POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrders to Delivered.")
			ENDIF
		ENDIF	
		
		
		********************
		IF lRollBack
			RETURN .F.
		ENDIF
		
		********************		
		IF nCntPOitem > 0	
		*	
			PRIVATE nWO, nWO_Detail 
			nWO 		= PrepareSQLnum(ThisFormSet.Receive_Edit.txtWO.Value,'WO',-3)
			nWO_Detail  = PrepareSQLnum(ThisFormSet.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
			
		*	IF lAlready_Saved
				IF lFoundStockUpdateReceiving 
					ThisFormSet.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, 0, cSOitem, nWO_Detail ) 
				ELSE
					ThisFormSet.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, 0, cSOitem, nWO_Detail ) 
				ENDIF
		*	ELSE
		*		ThisFormSet.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, 0, cSOitem, nWO_Detail ) 
		*	ENDIF
		ENDIF
		
		
		
		*************************
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtTBL.Value,'TBL',1)
		
		*!*	*******************
		*!*	IF NOT lRollBack AND lPOSaveLst 
		*!*		IF nPOcomplete = 1 OR nPOcomplete = 2
		*!*			*Clear INCOMING Stock Process'
		*!*			*nReceivingID is essential
		*!*			
		*!*			IF NOT Remove_Incoming_Process_RID(cPOitem,nPieces,nActualW,nS_QTY,nS_PU,ThisFormSet.nConnhandle,nPOcomplete,nReceivingID,cTBL)
		*!*				
		*!*				PRIVATE cMess
		*!*				cMess = "Remove_Incoming_Process_RID("
		*!*				IF NOT Proper_PO_item(cPOitem) = Proper_PO_item('')
		*!*					cMess = cMess + " POitem='"+cPOitem+"'"
		*!*				ENDIF
		*!*				IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
		*!*					cMess = cMess + ", SOitem='"+cSOitem+"'"
		*!*				ENDIF
		*!*				cMess = cMess + ", nPieces="+ALLTRIM(STR(nPieces))
		*!*				cMess = cMess + ", nActualW="+ALLTRIM(STR(nActualW))
		*!*				cMess = cMess + ", WO_Detail="+ALLTRIM(STR(nWO_Detail))
		*!*				
		*!*				TrackError(cMess,"Bad variable or Fail",PROGRAM(),LINENO(1))
		*!*				TrackMess("Remove_Incoming_Process_RID"+CHR(13)+"Bad variable or Fail"+CHR(13)+"Receiving:SaveAdd(Remove_Incoming_Process_RID)")
		*!*			ENDIF
		*!*	 		*lPOSaveLst = Remove_Incoming_Process_by_POitem(cPOitem, ThisFormSet.nConnhandle)
		*!*			
		*!*			IF ThisFormSet.cWhat = "S_Process" OR ThisFormSet.cWhat = "B_Process" OR ThisFormSet.cWhat = "W_Process"
		*!*				* Do not rely on POitem
		*!*				*remove INCOMING Process that Receive Edit started
		*!*				PRIVATE nID_Detail_Process
		*!*				nID_Detail_Process = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		*!*				DO CASE
		*!*				CASE ThisFormSet.cWhat = "S_Process"
		*!*					cSQL = "DELETE FROM dbo.StockLst_Process "
		*!*				CASE ThisFormSet.cWhat = "B_Process"
		*!*					cSQL = "DELETE FROM dbo.BrokerLst_Process "
		*!*				CASE ThisFormSet.cWhat = "W_Process"
		*!*					cSQL = "DELETE FROM dbo.WIPLst_Process "
		*!*				ENDCASE
		*!*				cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
		
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*						
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF 
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC )
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		
		***************
		RETURN .T.
	ENDPROC

	PROCEDURE saveadd_wo_detail
		PARAMETERS nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,nWODcomplete 
		*ThisFormSet.SaveAdd_WO_Detail(nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,nWODcomplete )
		
		nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		IF nReceivingID = 0
			*TrackError("Bad Parameter","nReceivingID is 0",PROGRAM(),LINENO(1))
			TrackMess("nReceivingID is 0"+CHR(13)+"Bad Parameter"+CHR(13)+"Receiving:SaveAdd_WO_Detail")
		ENDIF
		
		
		DO CASE 
		CASE VARTYPE(dReceived) = "D" 
		CASE VARTYPE(dReceived) = "T" 
		OTHERWISE
			dReceived = DATE()
		ENDCASE
			
		IF VARTYPE(lFoundStockUpdateReceiving) != "L"
			lFoundStockUpdateReceiving = .F.
		ENDIF
		
		PRIVATE nSalesNum,nItemSo
		nSalesNum	= VAL(LEFT(cSOitem,AT('-',cSOitem)-1 ))
		nItemSo		= VAL(RIGHT(cSOitem,2))
		
		*Mark PO
		PRIVATE lRollBack
		lRollBack = .F.
		
		PRIVATE nCntWO_Detail,nCntSOitem 
		nCntWO_Detail = Count_WODinWO_Detail( nWO_Detail, ThisFormSet.nConnhandle,"NOTCANCELLED")
		nCntSOitem = 0
		
		********************
		IF nCntWO_Detail = 0	
			TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for WO_Detail:"+STR(nWO_Detail)+" #NotFound#Rollback")
			MESSAGEBOX("Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for WO_Detail:"+STR(nWO_Detail)+" #NotFound#Rollback"+CHR(13)+"Please check that you typed the right WO_Detail!",0,"WO_Detail not found!")
			lRollBack = .T.
		ENDIF
		
		PRIVATE lHold
		lHold	= PrepareSQLchk(ThisFormSet.Receive_Edit.chkHold.Value,'Hold')
		PRIVATE lWOD_SaveLst 
		lWOD_SaveLst = .F.
		PRIVATE nID_Master, nID_Detail, cHeat, cLot
		nID_Master = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
		nID_Detail= PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
		cHeat = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtHeat.Value,'Heat',50)
		cLot = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtLot.Value,'Lot',10)
		cTBL = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtTBL.Value,'TBL',1)
		
		********************
		IF NOT lRollBack AND nCntWO_Detail > 0	
		
			PRIVATE cSQLu
			cSQLu = "UPDATE dbo.WorkOrder_Detail SET "
		*	cSQLu = cSQLu + " Receipt ='"+cComments+"'"
			*cSQLu = cSQLu + ",Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"		
			cSQLu = cSQLu + " fHeat='"+cHeat+"',fLot='"+clot+"'"
			cSQLu = cSQLu + ",fReceivingID="+STR(nReceivingID)
		
		*	cSQLu = cSQLu + ",ReceivedBy ='"+cInit+"'"
			*cSQLu = cSQLu + ",Heat ='"+PrepareSQLtxt(cHeatCombined,'Heat',50,.F.,.T.)+"'"
			IF nWODcomplete = 2
		*		cSQLu = cSQLu + ",Delivered=1"
				cSQLu = cSQLu + ",fCMPLT=1"
			ENDIF
			cSQLu = cSQLu + ",stkListed=1"
		*	cSQLu = cSQLu + ",Cert="+IIF(lCert,'1','0')
		*	IF lHold
		*		cSQLu = cSQLu + ",Hold=1 "
		*	ENDIF
			cSQLu = cSQLu + " WHERE WO_Detail ="+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisFormSet.nConnhandle, nSQLEXEC )
				lRollBack = .T.
			ELSE
				lPOSaveLst = .T.
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" updated WO_Detail:"+ALLTRIM(STR(nWO_Detail))+" as Complete.")
			ENDIF
		ENDIF	
		
		
		
		
		********************
		*!*	IF NOT lRollBack AND lWOD_SaveLst 
		*!*		IF nWODcomplete = 1 OR nWODcomplete = 2
		*!*			*Clear INCOMING Stock Process'
		*!*			*nReceivingID is essential
		*!*			
		*!*			IF NOT Remove_Incoming_Process_by_WO_Detail_RID(cPOitem,nPieces,nActualW,nS_QTY,nS_PU,ThisFormSet.nConnhandle,nWODcomplete,nReceivingID,cTBL)
		*!*				
		*!*				PRIVATE cMess
		*!*				cMess = "Remove_Incoming_Process_RID("
		*!*				cMess = cMess + " WO_Detail="+STR(nWO_Detail)
		*!*				
		*!*				IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
		*!*					cMess = cMess + ", SOitem='"+cSOitem+"'"
		*!*				ENDIF
		*!*				cMess = cMess + ", nPieces="+ALLTRIM(STR(nPieces))
		*!*				cMess = cMess + ", nActualW="+ALLTRIM(STR(nActualW))
		*!*	*			cMess = cMess + ", WO_Detail="+ALLTRIM(STR(nWO_Detail))
		*!*				
		*!*				TrackError(cMess,"Bad variable or Fail",PROGRAM(),LINENO(1))
		*!*				TrackMess("Remove_Incoming_Process_RID"+CHR(13)+"Bad variable or Fail"+CHR(13)+"Receiving:SaveAdd_WO_Detail(Remove_Incoming_Process_RID)")
		*!*			ENDIF
		*!*	 		*lPOSaveLst = Remove_Incoming_Process_by_POitem(cPOitem, ThisFormSet.nConnhandle)
		*!*			
		*!*			IF ThisFormSet.cWhat = "S_Process" OR ThisFormSet.cWhat = "B_Process" OR ThisFormSet.cWhat = "W_Process"
		*!*				* Do not rely on POitem
		*!*				*remove INCOMING Process that Receive Edit started
		*!*				PRIVATE nID_Detail_Process
		*!*				nID_Detail_Process = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		*!*				DO CASE
		*!*				CASE ThisFormSet.cWhat = "S_Process"
		*!*					cSQL = "DELETE FROM dbo.StockLst_Process "
		*!*				CASE ThisFormSet.cWhat = "B_Process"
		*!*					cSQL = "DELETE FROM dbo.BrokerLst_Process "
		*!*				CASE ThisFormSet.cWhat = "W_Process"
		*!*					cSQL = "DELETE FROM dbo.WIPLst_Process "
		*!*				ENDCASE
		*!*				cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		*!*				cSQL = cSQL + " AND Process_ID = 'INCOMING' "
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
		
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*						
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF 
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC )
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE saveasnewreceiving
		*ThisFormSet.SaveAsNewReceiving()
		
		PRIVATE dReceived, cAlloy, cHeat, cLot, lCert, nPieces, cDescription
		PRIVATE cSpecs, cComments, cInit, dDate, lPass, lGoodPapers, lHold, nActualW, nBillW, cVendor, nRMA_No, nRMA_Detail
		PRIVATE nRejectPC, cRejectReason
		dReceived	= PrepareSQLdate(ThisFormset.Receive_Edit.txtReceived.Value,'Received')
		cAlloy		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= UPPER(PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50,.f.))
		cLot		= UPPER(PrepareSQLtxt(ThisFormset.Receive_Edit.txtLot.Value,'Lot',10,.f.))
		
		lCert		= PrepareSQLlogic(ThisFormset.Receive_Edit.chkCert.Value,'Cert')
		nPieces		= PrepareSQLnum(ThisFormset.Receive_Edit.txtPieces.Value,'Pieces',-3)
		cDescription= PrepareSQLtxt(ThisFormset.Receive_Edit.edtDescription.Value,'Description',-1,.F.)
		cSpecs		= PrepareSQLtxt(ThisFormSet.Receive_Edit.edtSpecs.Value,'Specs',-1)
		cComments	= PrepareSQLtxt(ThisFormSet.Receive_Edit.edtComments.Value,'Comments',-1,.F.)
		cInit		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtInit.Value,'Init',10 )
		dDate		= PrepareSQLdate(ThisFormSet.Receive_Edit.txtDate.Value,'Date')
		lPass		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkGoodPapers.Value,'GoodPapers')
		lHold		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkHold.Value,'Hold')
		nActualW	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtActualW.Value,'Actual',9,1)
		nBillW		= PrepareSQLnum(ThisFormSet.Receive_Edit.txtBillW.Value,'BillW',9,1)
		
		PRIVATE nAcct_QTY, nAcct_P, nAcct_PU
		nAcct_QTY	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct
		nAcct_P		= PrepareSQLnum(ThisFormSet.Receive_Edit.txtAcct_P.Value,'S_P',-5)	
		nAcct_PU	= PrepareSQLnum(ThisFormSet.Receive_Edit.lblAcct_PU.Caption,'PU',-1)
		PRIVATE nPO_QTY, nPO_P, nPO_PU
		nPO_QTY = PrepareSQLnum(ThisFormSet.Receive_Edit.txtPO_QTY.Value,'PO_QTY',-5)	&&Vendor
		nPO_P	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtPO_P.Value,'PO_P',-5)	&&Vendor
		nPO_PU	= PrepareSQLnum(ThisFormSet.Receive_Edit.lblPO_PU.Caption,'PU',-1)
		
		***************
		cVendor		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtVendor.Value,'Vendor',30,.F.,.T. )
		nRMA_No		= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRMA_No.Value,'RMA_No',-3)
		nRMA_Detail	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRMA_detail.Value,'RMA_Detail',-3)
		nRejectPC	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRejectPC.Value,'RejectPC',-3)
		cRejectReason= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtRejectReason.Value,'RejectReason',255,.f. )
		
		IF nRejectPC < 1
			nRejectPC = 0
		ENDIF
		
		PRIVATE nWO_Detail, nWO
		nWO_Detail	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		nWO			= PrepareSQLnum(ThisFormSet.Receive_Edit.txtWO.Value,'WO',-3)
		
		PRIVATE nRMA, nRMA_Detail
		nRMA 	= PrepareSQLnum(ThisFormSet.nRMA,'RMA',-3)
		nRMA_Detail = PrepareSQLnum(ThisFormSet.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
		
		PRIVATE nID_Master, nID_Detail, nID_Detail_PRC, cTBL, cForm
		*!*	nID_Master = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
		*!*	nID_Detail = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
		*!*	nID_Detail_PRC = PrepareSQLnum(ThisFormSet.Receive_Edit.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		*!*	cTBL 		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtTBL.Value,'TBL',1)
		cForm		= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtForm.Value,'Form',2)
		
		
		**********************
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkServicesPO.VALUE,'ServicesPO',.F.)
		lConvServ		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkConvServ.VALUE,'ConvServ',.f.)
		lEquipment		= PrepareSQLlogic(ThisFormSet.Receive_Edit.chkEquipment.VALUE,'Equipment',.F.)
		
		*cComments
		PRIVATE lLabServices, nCountPOitem 
		lLabServices = .F.
		nCountPOitem = 0
		
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
			*Is this a Lab Test?
			*lLabService = Get_From_POitem (cPOitem, "Field", ThisFormSet.nConnhandle )
			nCountPOitem = PO_POitem_Cnt( cPOitem, ThisFormSet.nConnhandle, 'SERVICES' ) &&NOTRECEIVE includes (Services AND ConvServ AND Equipment)
			IF nCountPOitem > 0 OR lServicesPO
				lLabServices = .T.
				
				IF NOT "Received data from paid Services" $ cComments
					IF LEN(cComments)>0
						cComments = cComments+ CHR(13)
					ENDIF
					cComments = cComments+ "Received data from paid Services "
				ENDIF
			ENDIF
		ENDIF
		IF nWO_Detail > 0
			cComments = "From Work Order Detail "+STR(nWO_Detail)
		ENDIF
		
		************************
		
		IF NOT lPass
			IF lHold
				MESSAGEBOX("Since this material did not PASS Specs,"+CHR(13)+"this will be considered on ReceiveOnHold."+CHR(13)+CHR(13)+"The PO Sales Rep will be notified"+CHR(13)+"daily so this order can be fixed.",48,"On Receive Hold")
				Send_Chatter("ReceivingID_Hold",nReceivingID,"BLANK","The receiving material for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on Receive OnHold.",ThisFormSet.nConnhandle)
				*Send_Chatter("QA",0,"BLANK","The receiving material did not PASS Specs for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on QA Hold.",ThisFormSet.nConnhandle)
			ENDIF
		
		ENDIF
		
		*************************
		*************************
		PRIVATE cSQLi 
		*nReceivingIDOld = nReceivingID 
		*Insert INTO dbo.Receiving
		cSQLi = "EXEC dbo.p_Receiving_ins3 "
		cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
		cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
		cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
		cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
		cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
		cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
		cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
		cSQLi = cSQLi +",@Description ='"+cDescription+"'"
		cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
		cSQLi = cSQLi +",@Comments ='"+cComments+"'"
		cSQLi = cSQLi +",@Init ='"+cInit+"'"
		cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
		cSQLi = cSQLi +",@Pass ="+IIF(lPass,'1','0')
		cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
		cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
		cSQLi = cSQLi +",@BillW ="+STR(nBillW)
		cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
		cSQLi = cSQLi +",@RejectPC="+STR(nRejectPC)
		cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
		cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
		
		IF USED("tmpIDReceiving")
			USE IN tmpIDReceiving
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpIDReceiving')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpIDReceiving')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpIDReceiving")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpIDReceiving")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpIDReceiving')
			TrackError("Insert INTO dbo.Receiving. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
		ELSE &&IF nSQLEXEC < 1
			lSaved = .T.
			
			IF USED("tmpIDReceiving")
				nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'RID',-3)
				
				IF nReceivingID > 0		&&Should do this later when ID_Master and ID_Detail are known
					*UPDATE the rest of that dbo.Receiving record
					
					cSQLu = "UPDATE dbo.Receiving SET "
					*cSQLu = cSQLu +" StockTable='"+cTBL+"'"
					*cSQLu = cSQLu +",ID_Master="+STR(nID_Master)
					*cSQLu = cSQLu +",ID_Detail="+STR(nID_Detail)
					cSQLu = cSQLu +" RMA_Detail="+STR(nRMA_Detail)
					
					cSQLu = cSQLu +",Lot='"+cLot+"'"
					
					cSQLu = cSQLu +",R_Qty="+STR(nAcct_QTY,18,4)
					cSQLu = cSQLu +",R_P= "+STR(nAcct_P,18,4)
					cSQLu = cSQLu +",R_PU="+STR(nAcct_PU)
					
					*use PO Fields for WO_Detail Data
					cSQLu = cSQLu +",PO_Qty="+STR(nPO_QTY,18,4)
					cSQLu = cSQLu +",PO_P="+STR(nPO_P,18,4)
					cSQLu = cSQLu +",PO_PU="+STR(nPO_PU)
		
					cSQLu = cSQLu +",hold="+IIF(lHold,"1","0")
					cSQLu = cSQLu +",Form='"+cForm+"'"
					
					cSQLu = cSQLu +",Services="+IIF(lServicesPO,"1","0")
					cSQLu = cSQLu +",ConvServ="+IIF(lConvServ,"1","0")
					cSQLu = cSQLu +",Equipment="+IIF(lEquipment,"1","0")
					cSQLu = cSQLu + " WHERE ID="+STR(nReceivingID)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, '')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
						TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
					ENDIF
					
					
		*!*				cMess = "Added Receiving ID:"+ALLTRIM(STR(nReceivingID))
		*!*				*cMess = cMess + " WAS Receiving ID:"+ALLTRIM(STR(nReceivingIDOld))
		*!*				cMess = cMess + "  PO:"+ALLTRIM(cPOitem)
		*!*				cMess = cMess + ", SO:"+ALLTRIM(cSOitem)
		*!*				cMess = cMess + ", WO_Detail:"+ALLTRIM(STR(nWO_Detail))
		*!*				cMess = cMess + ", WO:"+ALLTRIM(STR(nWO))
		*!*				cMess = ShowSQLtxt(cMess,'Mess',-1)
		*!*				
		*!*				TrackMess(cMess)
		*!*				*TrackError(cMess,"nReceivingID is not 0, but is a new Receive!",PROGRAM(),LINENO(1))
		*!*				*RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"nReceivingID is not 0, but was not found in Receiving table!"+CHR(13)+cMess+" "+CHR(13)+cSQLu  )
					
					lSaveByOldMethod = .F.
					
		*!*				IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
		*!*					*Alert SO Status
		*!*					Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID)), ThisFormSet.nConnhandle)
		*!*				ENDIF
					
					USE IN tmpIDReceiving 
					ThisFormSet.Receive_Edit.txtReceivingID.Value = nReceivingID 
					ThisFormSet.Receive_Edit.txtReceivingID.Refresh
				ENDIF						
			ENDIF
			
		ENDIF
		
		IF NOT lSaved 
			nReceivingID = 0
		ENDIF
		
		
		
		RETURN nReceivingID 
		
	ENDPROC

