					nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
					**
				
					*FormUnitPrice('10') FormUnitCaption('10')
					PRIVATE cPriceUnit
					cPriceUnit = FormUnitPrice(cForm)
					
					PRIVATE nStockLst_Qty
					nStockLst_Qty	= PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
					PRIVATE nBillW
					nBillW			= PrepareSQLnum(ThisFormset.Receive_Edit.txtBillW.Value,'BillW',-5)
					IF nStockLst_Qty > 0
						IF nBillW > 0
							IF ROUND(nBillW,-1) != ROUND(nStockLst_Qty,-1)
								IF ThisFormSet.cWhat = "ADD"
									*no need to ask on ADD.
									nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
									ThisFormset.Receive_Edit.txtBillW.Value = nStockLst_Qty
								ELSE
									IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(nBillW))+"'"+CHR(13)+" with '"+Alltrim(STR(nStockLst_Qty))+"' ?"+CHR(13)+CHR(13)+"ThisFormSet.GetPOitemDetail()",4+32,"Purchase Order Table has Bill Weight listed differently.") = 6
										ThisFormset.Receive_Edit.txtBillW.Value = nStockLst_Qty
									ELSE 
										nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
									ENDIF
								ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.txtBillW.Value = nStockLst_Qty
						ENDIF
					ENDIF
					*
					PRIVATE nPounds 
					nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
					IF nPounds > 0
						IF cPriceUnit = "LB"
							IF nBillW > 0
								IF ROUND(nBillW,-1) != ROUND(nPounds,-1)
									IF ThisFormSet.cWhat = "ADD"
										*no need to ask on ADD.
										nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
										ThisFormset.Receive_Edit.txtBillW.Value = nStockLst_Qty
									ELSE
										IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(nBillW))+"'"+CHR(13)+" with '"+Alltrim(STR(nPounds))+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetPOitemDetail()",4+32,"Purchase Order Table has Bill Weight listed differently.") = 6
											ThisFormset.Receive_Edit.txtBillW.Value = nPounds
										ENDIF
									ENDIF
								ENDIF
							ELSE
								ThisFormset.Receive_Edit.txtBillW.Value = nPounds
							ENDIF
						ENDIF
					ENDIF
					*
					*	
					ThisFormset.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpPOp.StockLst_QTY,'S_QTY',-5)
					ThisFormset.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpPOp.StockLst_P,'S_P',-5)
					
					PRIVATE nAcct_PU 
					nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_POitem(tmpPOp.POitem, "Form", ThisFormSet.nConnhandle ), ThisFormSet.nConnhandle ),'PU',-1 )
					ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
					ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
			*
					ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpPOp.Order_QTY,'PO_QTY',-5)
					ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpPOp.Order_P,'Order_P',-5)
					IF EMPTY(ThisFormset.Receive_Edit.txtPO_P.Value)
						ThisFormset.Receive_Edit.txtPO_P.Value = Get_From_POitem(cPOitem, "Order_P", ThisFormSet.nConnhandle )
					ENDIF
					
					PRIVATE nCust_PU 
					nCust_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
					ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
					ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
					*
					PRIVATE nOrder_PU
					nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
					IF nOrder_PU = 0
						*Fix Old data
						nOrder_PU = GetPUfromForm( cForm, ThisFormSet.nConnhandle )
					ENDIF
					ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
					ThisFormset.Receive_Edit.lblPO_PUstr.Caption 	= Get_PUstr_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
					
					cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
					IF !EMPTY(cMisc_purch)
						IF !EMPTY(ThisFormset.Receive_Edit.edtSpecs.Value)
							IF NOT ALLTRIM(UPPER(ThisFormset.Receive_Edit.edtSpecs.Value)) == ALLTRIM(UPPER(cMisc_purch))
								*IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Spec '"+ALLTRIM(ThisFormset.Receive_Edit.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cMisc_purch)+"?",4+32,"Purchase Order Table has Spec listed differently.") = 6
								*	ThisFormset.Receive_Edit.edtSpecs.Value = cMisc_purch
								*ELSE
									*IF EMPTY(ThisFormset.Receive_Edit.edtComments.Value)
									*	IF MESSAGEBOX("Do you want to save this line "+CHR(13)+Alltrim(cMisc_purch)+CHR(13)+" to the Comment field? ",4+32,"Save info") = 6
									*		ThisFormset.Receive_Edit.edtComments.Value = cMisc_purch
									*	ENDIF
									*ENDIF
								*ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.edtSpecs.Value = cMisc_purch
						ENDIF
					ENDIF
					*
					
					cDescription = PrepareSQLtxt(tmpPOp.Descript,'Description',-3)
					
					IF !EMPTY(cDescription)
						IF LEN(ThisFormset.Receive_Edit.edtDescription.Value)>0
							IF NOT ALLTRIM(UPPER(ThisFormset.Receive_Edit.edtDescription.Value)) == ALLTRIM(UPPER(cDescription))
								IF NOT ThisFormset.Receive_Edit.AskedReplaceDescrPO
									ThisFormset.Receive_Edit.AskedReplaceDescrPO = .T.
									cDescription = RIGHT(cDescription,LEN(cDescription) - AT('Pcs',cDescription) - 3 )
									IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisFormset.Receive_Edit.edtDescription.Value)+"'"+CHR(13)+" with '"+Alltrim(cDescription)+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetPOitemDetail()",4+32,"Purchase Order Table has Description listed differently.") = 6
										ThisFormset.Receive_Edit.edtDescription.Value = cDescription
									ENDIF
								ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.edtDescription.Value = cDescription
						ENDIF
					ENDIF
					*
					*Table
					
					*IF PrepareSQLtxt(tmpPOp.Stock,'Stock',13) = 'No Stock'
						IF LEN(cTBL) > 0 
							ThisFormset.Receive_Edit.txtTBL.Value = cTBL
							*MESSAGEBOX("POitem is NOT for stocking:'No Stock'."+CHR(13)+"listing as Stock in TBL="+cTBL+" on a Receive.",64,"Found problem.")
						ELSE			
							ThisFormset.Receive_Edit.txtTBL.Value = 'N'
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Receiving POitem 'No Stock' and listing as TBL="+cTBL+" on a Receive." )
						ENDIF
					*ENDIF
					
					IF PrepareSQLchk(tmpPOp.Services,'Services') OR PrepareSQLchk(tmpPOp.Convserv,'ConServ') OR PrepareSQLchk(tmpPOp.Equipment,'Equipment')
						ThisFormset.Receive_Edit.txtTBL.Value = 'N'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisFormSet.cWhat != "ADD"
			***********************************
			*** FROM RecStockGetByPOitem
			*** GetFromReceiving
			*************************************************
		
			IF USED("cntReceiving2")
				USE IN cntReceiving2
			ENDIF
		
			cSQL = "SELECT ID, Heat, Lot "
			cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			SELECT 0  
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntReceiving2')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntReceiving2')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntReceiving2")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntReceiving2")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'cntReceiving2')
				RETURN
			ENDIF
			IF USED('cntReceiving2')
				IF RECCOUNT('cntReceiving2') > 0
		
					*CHOOSE Receiving Details if different heat
					PRIVATE nReceivingID, lDiffHeat
					nReceivingID = 0
					lDiffHeat = .F.
					
					IF VARTYPE(cntReceiving2.Heat)="C"
						cHeat = ALLTRIM(ShowSQLtxt(cntReceiving2.Heat,'HEAT',50))
					ENDIF
					cHeatCurr = ALLTRIM(ShowSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50))
					
					IF LEN(cHeatCurr) > 1 AND LEN(cHeat) > 1
						IF NOT cHeatCurr $ cHeat
							lDiffHeat = .T.
						ENDIF
					ENDIF
					
					IF lDiffHeat
						IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
							IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
								cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
							ENDIF
						ENDIF
						IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
							DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, "" TO nReceivingID
							nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
							IF TYPE("nReceivingID")="N"
								IF nReceivingID > 0
									*ThisFormset.Receive_Edit.ReceivingID = nReceivingID
									
									ThisFormset.Receive_Edit.txtReceivingID.Value = nReceivingID
									ThisFormset.Receive_Edit.txtReceivingID.refresh
									
									lOK = ThisFormSet.Get_Exact_ReceivingID(nReceivingID)
									
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF	
			ENDIF	
		ENDIF
		
		IF USED('cntReceiving2')
			USE IN cntReceiving2
		ENDIF	
		
		
		
		**validate data
		
		IF Proper_SO_item(ThisFormSet.cSOitem) <> Proper_SO_item('')
			IF Count_SOIteminSales( ThisFormSet.cSOitem, ThisFormSet.nConnhandle )=0
				MESSAGEBOX("The SO item '"+ThisFormSet.cSOitem+"'"+CHR(13)+" entered with PO item '"+ThisFormSet.cPOitem+"'"+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisFormSet.cSOitem+"' entered with PO item '"+ThisFormSet.cPOitem+"', does not Exists!")
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getpo_incoming
		PARAMETERS cPOitem
		*ThisFormSet.GetPO_Incoming(cPOitem)
		*
		
		**check POitem as  INCOMING or 'Due in'
		PRIVATE nItemPO, nHpaPo, nID_Detail, nID_Detail_Process, nID_D_P
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nHpaPo	= Proper_PO_Item_PO(cPOitem)
		nID_Detail = 0
		nID_Detail_Process = 0
		nID_D_P = 0 
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisFormSet.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nHpaPo = 0
			MESSAGEBOX("No PO to show!",0,"No PO")
			RETURN .F.
		ENDIF
		
		*Check Vendor QAType
		IF is_Vendor_LabService(nHpaPo, ThisFormSet.nConnhandle) 
			* AND nWO_Detail = 0
			nMess = MESSAGEBOX("PO "+ALLTRIM(STR(nHPApo))+" is for a Test Report."+CHR(13)+"This is not the Vendor!"+CHR(13)+"Are you receiving to the right PO?"+CHR(13)+CHR(13)+"Do you still want to continue?",4+256+16,"Wrong PO") 
			IF nMess <> 6
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE lFoundIncoming	&&Found a INCOMING OR 'Due In'
		lFoundIncoming = .F.
		
		**********************
		PRIVATE cSQL
		cSQL = " SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
		*Stock Master
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT"
		cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'S' AS TBL, M.Heat, M.Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.Heat = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*Stock History
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
		cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' 
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + ", 'A' AS TBL, M.Heat, M.Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' "
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*Stock Process
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'S' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
		*LEFT OUTER ?
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
		
		cSQL = cSQL + " UNION "
		*Broker Master
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT"
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'B' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*Broker Process
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'B' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
		cSQL = cSQL + " UNION "
		*WIP Master
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT"
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'W' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*WIP Process
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'W' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
		cSQL = cSQL + " ) t ORDER BY [Process_ID] DESC, Heat, Lot "
			
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_ProcessCNT')
		WAIT WINDOW 'TIMEOUT1' TIMEOUT 1
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 2
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPO_ProcessCNT' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_ProcessCNT")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 2
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_ProcessCNT")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			TrackError(cSQL,"Get POitem Detail, Bad Query", PROGRAM(), LINENO(1))
		
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_ProcessCNT' )	
		ENDIF
		
		PRIVATE cTBL
		cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
		
		IF USED('tmpPO_ProcessCNT')
			IF RECCOUNT('tmpPO_ProcessCNT') > 0
				
				PRIVATE cMess
				cMess = "Found records"+CHR(13)+"you do not need to take action"+CHR(13)+"This could get messy:"+CHR(13)+CHR(13)
				
				SELECT tmpPO_ProcessCNT
				
				LOCATE FOR TBL = 'A'
				IF FOUND('tmpPO_ProcessCNT')
					lDelHistPOstk = .T.
					
					PRIVATE cHistHeat 
					cHistHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
					cMess = cMess + "Found '"+ALLTRIM(cHistHeat)+"' in Archive. "+CHR(13)
					cMess = cMess + "        The Archive data will not be used. "+CHR(13)
					DELETE FROM tmpPO_ProcessCNT WHERE Heat = cHistHeat 
				ENDIF
				GO TOP
				
				PRIVATE cHeatNew,cLotNew, nID_DetailNew
				
				SCAN
					IF DELETED('tmpPO_ProcessCNT')
						LOOP
					ENDIF
					IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "A"
						LOOP
					ENDIF
					IF tmpPO_ProcessCNT.CNT = 0
						LOOP
					ENDIF
					
					cTBLOld = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF cTBL = "S" OR cTBL = "B" OR cTBL = "W" 
						nID_Detail = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
						lFoundIncoming = .T.
						
						cProcess_ID = PrepareSQLtxt(tmpPO_ProcessCNT.Process_ID,'Process_ID',10)
						IF LEN(cProcess_ID) = 0
							cMess = cMess + "   without an Incoming Process_ID ."+CHR(13)
							nID_D_P = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
							IF nID_D_P > 0
								cMess = cMess + " nID_Detail_Process = "+ALLTRIM(STR(nID_D_P))+CHR(13)+CHR(13)
								IF nID_Detail_Process = 0
									nID_Detail_Process = nID_D_P
								ENDIF
							ENDIF
						ELSE
							cTBL = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
							
							cMess = cMess + "   with a Process_ID of '"+cProcess_ID+"'."+CHR(13)
							cMess = cMess + " nID_Detail = "+ALLTRIM(STR(nID_Detail))+CHR(13)
							IF cProcess_ID = "INCOMING"
								*Use this nID_Detail_Process !
								nID_Detail_Process = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
								cMess = cMess + "INCOMING nID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)
							ENDIF
						ENDIF
					ENDIF
				
				ENDSCAN
				
				IF nID_Detail_Process = 0
					cMess = cMess + CHR(13)+"Did not find an Incoming Process to receive to!"+CHR(13)
				ELSE
					cMess = cMess + CHR(13)+"Using Incoming Process "+ALLTRIM(STR(nID_Detail_Process))+" to receive to!"+CHR(13)
					IF nID_D_P > 0
						cMess = cMess + CHR(13)+"Where did Process "+ALLTRIM(STR(nID_D_P))+" come from!?!"+CHR(13)
					ENDIF
				ENDIF
				IF nID_Detail_Process > 0
					cMess = cMess + CHR(13)+"Incomming Process "+ALLTRIM(STR(nID_Detail_Process))+" will be choosen to be used."
				ENDIF
		
				
				IF RECCOUNT('tmpPO_ProcessCNT') = 1 
					MESSAGEBOX(cMess,48,"Found for POitem '"+cPOitem+"'")
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),cMess)
				ENDIF
				lChoosePOstk = .T.
			ENDIF
			USE IN tmpPO_ProcessCNT
		ENDIF
		
		************
		*****************************************
		*************************************************************
		*Bring in basics from POitem
		PRIVATE cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, cLot, lRandLen, cDispAlloy, nStandSize, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nWeight
		
		
		IF USED('tmpPOp')
			USE IN tmpPOp
		ENDIF
		
		cSQL = "SELECT * "
		cSQL = cSQl + ",dbo.f_Descript(Alloy,CC,Form,Thck,Sz2,Sz3,Order_QTY,RandLen ) AS Descript"
		cSQL = cSQl + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL = cSQl + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOp')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOp' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOp' )
		ENDIF
		
		IF USED('tmpPOp')
			IF RECCOUNT('tmpPOp') > 0
				*get PO Item data
				
				cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
				ThisFormSet.Receive_Edit.txtVendor.Value = ALLTRIM(ShowSQLtxt(cCompany,'Company',30))
				cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
				ThisFormSet.Receive_Edit.txtAlloy.Value = cAlloy
				cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
				ThisFormSet.Receive_Edit.txtForm.Value = cForm
				nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
				ThisFormSet.Receive_Edit.txtPieces.Value = nPieces
				
				nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
				nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
				nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
				cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
				ThisFormSet.Receive_Edit.edtSpecs.Value = cCond_Spec
				lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
				nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
				PRIVATE cPriceUnit
				cPriceUnit = FormUnitPrice(cForm)
				
				PRIVATE nStockLst_Qty
				nStockLst_Qty	= PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
				PRIVATE nBillW
				nBillW			= PrepareSQLnum(ThisFormSet.Receive_Edit.txtBillW.Value,'BillW',-5)
				PRIVATE nPounds 
				nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
				nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
				ThisFormSet.Receive_Edit.txtBillW.Value = nStockLst_Qty
				ThisFormSet.Receive_Edit.txtBillW.Value = nPounds
				ThisFormSet.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpPOp.StockLst_QTY,'S_QTY',-5)
				ThisFormSet.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpPOp.StockLst_P,'S_P',-5)
				
				PRIVATE nAcct_PU 
				nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_POitem(tmpPOp.POitem, "Form", ThisFormSet.nConnhandle ), ThisFormSet.nConnhandle ),'PU',-1 )
				ThisFormSet.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
				ThisFormSet.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
				ThisFormSet.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
		*
				ThisFormSet.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpPOp.Order_QTY,'PO_QTY',-5)
				ThisFormSet.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpPOp.Order_P,'Order_P',-5)
				IF EMPTY(ThisFormSet.Receive_Edit.txtPO_P.Value)
					ThisFormSet.Receive_Edit.txtPO_P.Value = Get_From_POitem(cPOitem, "Order_P", ThisFormSet.nConnhandle )
				ENDIF
					
				PRIVATE nCust_PU 
				nCust_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
				ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
				ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
				ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
				*
				PRIVATE nOrder_PU
				nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
				IF nOrder_PU = 0
					*Fix Old data
					nOrder_PU = GetPUfromForm( cForm, ThisFormSet.nConnhandle )
				ENDIF
				ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
				ThisFormSet.Receive_Edit.lblPO_PUstr.Caption 	= Get_PUstr_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
				ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
				
				cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
				ThisFormSet.Receive_Edit.edtSpecs.Value = cMisc_purch
				cDescription = PrepareSQLtxt(tmpPOp.Descript,'Description',-3)
				ThisFormSet.Receive_Edit.edtDescription.Value = cDescription
		*		IF PrepareSQLchk(tmpPOp.Services,'Services') OR PrepareSQLchk(tmpPOp.Convserv,'ConServ') OR PrepareSQLchk(tmpPOp.Equipment,'Equipment')
		*			ThisFormSet.Receive_Edit.txtTBL.Value = 'N'
		*		ENDIF
			ENDIF
			USE IN tmpPOp
		ENDIF		
		******
		****************************
		************************************
		IF ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0
			IF lFoundIncoming 
				*select correct data to fill!!!
				
				cSQL = cSQL + " SELECT * "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				CASE cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				CASE cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				ENDCASE
				cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						*get PO Item data
						
						cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
						ThisFormSet.Receive_Edit.txtVendor.Value = ALLTRIM(ShowSQLtxt(cCompany,'Company',30))
						cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
						ThisFormSet.Receive_Edit.txtAlloy.Value = cAlloy
						cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
						ThisFormSet.Receive_Edit.txtForm.Value = cForm
						nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
						ThisFormSet.Receive_Edit.txtPieces.Value = nPieces
						
						nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
						nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
						nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
						cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
						ThisFormSet.Receive_Edit.edtSpecs.Value = cCond_Spec
						lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
						nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
						PRIVATE cPriceUnit
						cPriceUnit = FormUnitPrice(cForm)
						
						PRIVATE nStockLst_Qty
						nStockLst_Qty	= PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
						PRIVATE nBillW
						nBillW			= PrepareSQLnum(ThisFormSet.Receive_Edit.txtBillW.Value,'BillW',-5)
						PRIVATE nPounds 
						nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
						nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
						ThisFormSet.Receive_Edit.txtBillW.Value = nStockLst_Qty
						ThisFormSet.Receive_Edit.txtBillW.Value = nPounds
						ThisFormSet.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpPOp.StockLst_QTY,'S_QTY',-5)
						ThisFormSet.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpPOp.StockLst_P,'S_P',-5)
						
						PRIVATE nAcct_PU 
						nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_POitem(tmpPOp.POitem, "Form", ThisFormSet.nConnhandle ), ThisFormSet.nConnhandle ),'PU',-1 )
						ThisFormSet.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
						ThisFormSet.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
						ThisFormSet.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
				*
						ThisFormSet.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpPOp.Order_QTY,'PO_QTY',-5)
						ThisFormSet.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpPOp.Order_P,'Order_P',-5)
						IF EMPTY(ThisFormSet.Receive_Edit.txtPO_P.Value)
							ThisFormSet.Receive_Edit.txtPO_P.Value = Get_From_POitem(cPOitem, "Order_P", ThisFormSet.nConnhandle )
						ENDIF
							
						PRIVATE nCust_PU 
						nCust_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
						ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
						ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
						ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
						*
						PRIVATE nOrder_PU
						nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
						IF nOrder_PU = 0
							*Fix Old data
							nOrder_PU = GetPUfromForm( cForm, ThisFormSet.nConnhandle )
						ENDIF
						ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
						ThisFormSet.Receive_Edit.lblPO_PUstr.Caption 	= Get_PUstr_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
						ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
						
						cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
						ThisFormSet.Receive_Edit.edtSpecs.Value = cMisc_purch
						cDescription = PrepareSQLtxt(tmpPOp.Descript,'Description',-3)
						ThisFormSet.Receive_Edit.edtDescription.Value = cDescription
				*		IF PrepareSQLchk(tmpPOp.Services,'Services') OR PrepareSQLchk(tmpPOp.Convserv,'ConServ') OR PrepareSQLchk(tmpPOp.Equipment,'Equipment')
				*			ThisFormSet.Receive_Edit.txtTBL.Value = 'N'
				*		ENDIF
					ENDIF
					USE IN tmpPOp
				ENDIF	
			
			ENDIF
		ENDIF
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
	ENDPROC

	PROCEDURE getsoitemdetail
		*ThisFormSet.GetSoItemDetail()
		*Receive_Edit
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')
			IF Proper_SO_item(ThisFormSet.cSOitem) <> Proper_SO_item('')
				cSOitem = ThisFormSet.cSOitem 
			ENDIF
		ELSE
			IF Proper_SO_item(ThisFormSet.cSOitem) = Proper_SO_item('')
				ThisFormSet.cSOitem = cSOitem
			ENDIF
		ENDIF
		
		
		PRIVATE cSQL, nSQLExec
		IF USED("tmpSOitem")
			USE IN tmpSOitem
		ENDIF
		
		PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, cLot, lRandLen, cDispAlloy , nOrder_Qty, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nPounds
		
		cSQL = "SELECT "
		cSQL = cSQL + "AQ.SOitem, AQ.Company, AQ.Alloy, AQ.Form, AQ.Pieces, AQ.Weight "
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS DescriptM "
		cSQL = cSQL + ",SS.Alloy AS SSAlloy, SS.Form AS SSForm, SS.Pieces AS SSPieces, SS.Weight AS SSWeight"
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Pieces, SS.Form, SS.Thck, SS.SZ2, SS.SZ3, SS.Weight, SS.RandLen, SS.Metric, '', '', '') AS SSDescriptM "
		cSQL = cSQL + ",AQ.S_QTY, AQ.S_P "
		cSQL = cSQL + ",AQ.Q_P, AQ.Q_QTY, AQ.Q_PU "
		cSQL = cSQL + " FROM dbo.AllQuotes AQ WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StartingStock SS WITH(NOLOCK) ON SS.AllQuotes_ID = AQ.ID "
		cSQL = cSQL + " WHERE AQ.SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpSOitem' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpSOitem' )
		ENDIF
		
		IF USED('tmpSOitem')
			IF RECCOUNT('tmpSOitem') > 0	
				IF TYPE("tmpSOitem.SOitem") = "C"
					cSOitem = tmpSOitem.SOitem
				ELSE
					cSOitem = ''
				ENDIF
				PRIVATE cSOitemText 
				cSOitemText = "Found in SOitem "+cSOitem+":"
				
				nSalesNum	= Proper_SO_item_SO(cSOitem)
				nItemSo		= Proper_SO_Item_Item(cSOitem)
		*		ThisFormset.Receive_Edit.txtSOitem.Value = nItemSO
				
				*Only ask only if a Service or ConvService PO
				*IF PO_POitem_Cnt( cPOitem, ThisFormSet.nConnhandle, 'SERVICECONVSERV' ) >
				
		*!*			cCompany = ALLTRIM(ShowSQLtxt(tmpSOitem.Company,'Company',30))
		*!*			IF !EMPTY(cCompany)
		*!*				IF !EMPTY(ThisFormset.Receive_Edit.txtVendor.Value)
		*!*					IF ALLTRIM(UPPER(ThisFormset.Receive_Edit.txtVendor.Value)) != ALLTRIM(UPPER(cCompany))
		*!*						*IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisFormset.Receive_Edit.txtVendor.Value)+"'"+CHR(13)+"with '"+Alltrim(cCompany)+"?"+CHR(13)+"ThisFormSet.GetSoItemDetail()",4+32,"Purchase Order Table has Vendor listed differently.") = 6
		*!*							ThisFormset.Receive_Edit.txtVendor.Value = cCompany
		*!*						*ENDIF
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisFormset.Receive_Edit.txtVendor.Value = cCompany
		*!*				ENDIF
		*!*			ENDIF
				
				PRIVATE lHasSS
				lHasSS = .F.
				IF NOT EMPTY(tmpSOitem.SSDescriptM)
					lHasSS = .T.
				ENDIF
				
				IF lHasSS 
					cAlloy = PrepareSQLtxt(tmpSOitem.SSAlloy,'Alloy',12)
				ELSE
					cAlloy = PrepareSQLtxt(tmpSOitem.Alloy,'Alloy',12)
				ENDIF
		
				IF !EMPTY(cAlloy)
					IF !EMPTY(ThisFormset.Receive_Edit.txtAlloy.Value)
						IF ThisFormset.Receive_Edit.txtAlloy.Value != cAlloy
							IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisFormset.Receive_Edit.txtAlloy.Value)+"'"+CHR(13)+"with '"+Alltrim(cAlloy)+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetSoItemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisFormset.Receive_Edit.txtAlloy.Value = cAlloy
							ENDIF
						ENDIF
					ELSE
						ThisFormset.Receive_Edit.txtAlloy.Value = cAlloy
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nPieces = PrepareSQLnum(tmpSOitem.SSPieces,'SSPieces',-3)
				ELSE
					nPieces = PrepareSQLnum(tmpSOitem.Pieces,'Pieces',-3)
				ENDIF
				
				IF nPieces > 0
					IF !EMPTY(ThisFormset.Receive_Edit.txtPieces.Value)
						IF ThisFormset.Receive_Edit.txtPieces.Value != nPieces 
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisFormset.Receive_Edit.txtPieces.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nPieces))+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetSoItemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisFormset.Receive_Edit.txtPieces.Value = nPieces
							ENDIF
						ENDIF
					ELSE
						ThisFormset.Receive_Edit.txtPieces.Value = nPieces
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nOrder_Qty = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nOrder_Qty = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
				PRIVATE nS_PU
				nS_PU = PrepareSQLnum(tmpSOitem.Q_PU,'PU',-1)
				
				IF nS_PU = 1 &&PU1 is Pounds.
					IF nOrder_Qty > 0
						IF ThisFormset.Receive_Edit.txtBillW.Value > 0
							IF ThisFormset.Receive_Edit.txtBillW.Value != nOrder_Qty
								IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.Receive_Edit.txtBillW.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nOrder_Qty))+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetSoItemDetail()",4+32,"Purchase Order Table has Weight listed differently.") = 6
									ThisFormset.Receive_Edit.txtBillW.Value = nOrder_Qty
								ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.txtBillW.Value = nOrder_Qty
						ENDIF
					ENDIF
				ENDIF
				***
				IF lHasSS
					nPounds = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nPounds = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
				IF nS_PU = 1 &&PU1 is Pounds.
					IF nPounds > 0
						IF ThisFormset.Receive_Edit.txtBillW.Value > 0
							IF ThisFormset.Receive_Edit.txtBillW.Value != nPounds 
								IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.Receive_Edit.txtBillW.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nPounds ))+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetSoItemDetail()",4+32,"Purchase Order Table has Weight listed differently.") = 6
									ThisFormset.Receive_Edit.txtBillW.Value = nPounds 
								ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.txtBillW.Value = nPounds 
						ENDIF
					ENDIF
				ENDIF
				***
				
				PRIVATE nCust_PU
				nCust_PU = PrepareSQLnum(tmpSOitem.Q_PU,'Recv_PU',-1)	&&Cust
				*This is the PU Sold to,  NOT the StockLst Standard.  Use Acct Standard by form.
				
				PRIVATE nStockLst_PU 
				nStockLst_PU = GetPUfromForm( tmpSOitem.Form, ThisFormSet.nConnhandle )  &&Acct Stnd
				ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nStockLst_PU,'Acct_PU',2)
				ThisFormset.Receive_Edit.lblAcct_PUstr.Caption	= Get_PUstr_from_nPU(nStockLst_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nStockLst_PU,ThisFormSet.nConnhandle)
		*	
				ThisFormset.Receive_Edit.txtPO_QTY.Value	= PrepareSQLnum(tmpSOitem.Q_QTY,'Q_QTY',-5)
				ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpSOitem.Q_P,'Q_P',-5)
				
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
			
				ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpSOitem.Form,'Form',2)	
		
				***
				IF lHasSS
					cDescription = PrepareSQLtxt(tmpSOitem.SSDescriptM,'SSDescriptM',-1)
				ELSE
					cDescription = PrepareSQLtxt(tmpSOitem.DescriptM,'DescriptM',-1)
				ENDIF
				IF AT('PCS',UPPER(cDescription)) > 0
					cDescription = RIGHT(cDescription,LEN(cDescription) - AT('PCS',UPPER(cDescription)) - 3 )
				ENDIF
				IF AT('PC',UPPER(cDescription)) > 0
					cDescription = RIGHT(cDescription,LEN(cDescription) - AT('PC',UPPER(cDescription)) - 2 )
				ENDIF
				
				IF !EMPTY(cDescription)
					IF !EMPTY(ThisFormset.Receive_Edit.edtDescription.Value)
						IF ALLTRIM(UPPER(ThisFormset.Receive_Edit.edtDescription.Value)) != ALLTRIM(UPPER(cDescription))
							IF NOT ThisFormSet.lAskedReplaceDescrSO
		
								ThisFormSet.lAskedReplaceDescrSO = .T.
								*cDescription = RIGHT(cDescription,LEN(cDescription) - AT('Pcs',cDescription) - 3 )
								IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisFormset.Receive_Edit.edtDescription.Value)+"'"+CHR(13)+"with '"+Alltrim(cDescription)+"?"+CHR(13)+CHR(13)+"Yes, the computer sees a differance"+CHR(13)+"ThisFormSet.GetSoItemDetail()",4+32,"Purchase Order Table has Description listed differently.") = 6
									ThisFormset.Receive_Edit.edtDescription.Value = cDescription
								ENDIF
							ENDIF
						ENDIF
					ELSE
						ThisFormset.Receive_Edit.edtDescription.Value = cDescription
					ENDIF
				ENDIF
				***
		
				PRIVATE cHeat, cLot, cMess
				cHeat	= PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50)
				cLot	= PrepareSQLtxt(ThisFormset.Receive_Edit.txtLot.Value,'Lot',10)
				
				IF USED("tmpSDitem")
					USE IN tmpSDitem
				ENDIF
				
				cSQL = "SELECT Heat,Lot "
				cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
				IF LEN(cHeat)> 0 AND cHeat <> "DUE IN"
					cSQL = cSQL + " AND Heat = '"+cHeat+"'"
				ENDIF
				*IF LEN(cLot)> 0
				*	cSQL = cSQL + " AND Lot = '"+cLot+"'"
				*ENDIF
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpSDitem')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpSDitem' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSDitem")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSDitem")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpSDitem' )
				ENDIF
		
				IF USED('tmpSDitem')
					IF RECCOUNT('tmpSDitem') > 0 
						IF RECCOUNT('tmpSDitem') > 1 
							cMess = ''
							SCAN
								IF EMPTY(cMess)
									cMess = ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))
								ELSE
									cMess = cMess + ", "+ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))
								ENDIF
							ENDSCAN
							MESSAGEBOX("More than 1 Heat/Lot was found"+CHR(13)+"for this SOitem."+CHR(13)+cMess,0+64,"Mulitple Heats")
							SCAN
								IF MESSAGEBOX("Do you want to use Heat:"+ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))+CHR(13)+"/Lot '"+PrepareSQLtxt(tmpSDitem.Lot,'Lot',10),4+32,"Choose Heat") = 6
									ThisFormset.Receive_Edit.txtHeat.Value	= PrepareSQLtxt(tmpSDitem.Heat,'Heat',50)
									ThisFormset.Receive_Edit.txtLot.Value	= PrepareSQLtxt(tmpSDitem.Lot,'Lot',10)
									EXIT
								ENDIF
							ENDSCAN
						ELSE
							ThisFormset.Receive_Edit.txtHeat.Value	= PrepareSQLtxt(tmpSDitem.Heat,'Heat',50)
							ThisFormset.Receive_Edit.txtLot.Value	= PrepareSQLtxt(tmpSDitem.Lot,'Lot',10)
						ENDIF
					ENDIF
					
					USE IN tmpSDitem
					
					*Get Detail of this Heat.
					cHeat = PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50)
					cLot  = PrepareSQLtxt(ThisFormset.Receive_Edit.txtLot.Value,'Lot',10)
					
					IF USED("tmpSDSOiHeat")
						USE IN tmpSDSOiHeat
					ENDIF
					
					cSQL = "SELECT StockLst_ID,StockLst_ID_Detail,TBL,ID,Lot,Form "  &&Quoted_PU
					*cSQL = cSQL + " ,StockLst_QTY,StockLst_P,StockLst_Total,StockLst_PU "
					*cSQL = cSQL + " ,StockLst_PC,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, StockLst_LBS"
					
					cSQL = cSQL + " ,Orig_PC,Orig_Dim1,Orig_Dim2,Orig_Dim3, Orig_LBS"
					cSQL = cSQL + " ,Orig_QTY,Orig_P,Orig_Total,Orig_PU "
					
					cSQL = cSQL + " ,Removed_QTY"&&	ERP Acct Standard
					cSQL = cSQL + " ,Form"		&&	ERP Acct Standard
					cSQL = cSQL + " ,Invoice_QTY"	&&	Customer
					cSQL = cSQL + " ,Invoice_P"	&&Customer
					cSQL = cSQL + " ,PS_QTY"		&&Customer
					cSQL = cSQL + " ,Left_QTY"	&&	ERP Acct Standard
		
					cSQL = cSQL + " ,Removed_PC "
					cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
					cSQL = cSQL + " AND Heat = '"+cHeat+"'"
					*IF LEN(cLot)> 0
					*	cSQL = cSQL + " AND Lot = '"+cLot+"'"
					*ENDIF
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpSDSOiHeat')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpSDSOiHeat' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSDSOiHeat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSDSOiHeat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpSDSOiHeat' )
					ENDIF
		
					IF USED('tmpSDSOiHeat')
						IF RECCOUNT('tmpSDSOiHeat') > 0 
							ThisFormset.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(tmpSDSOiHeat.StockLst_ID,'Master_ID',-3)
							ThisFormset.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(tmpSDSOiHeat.StockLst_ID_Detail,'ID_Detail',-3)
							ThisFormset.Receive_Edit.txtTBL.Value 		= PrepareSQLtxt(tmpSDSOiHeat.TBL,'TBL',1)
							ThisFormset.Receive_Edit.txtForm.Value		= PrepareSQLtxt(tmpSDSOiHeat.Form,'Form',2)
							ThisFormset.Receive_Edit.txtLot.Value		= PrepareSQLtxt(tmpSDSOiHeat.Lot,'Lot',10)
							
							ThisFormset.Receive_Edit.Sales_Stock_ID 	= PrepareSQLnum(tmpSDSOiHeat.ID,'ID',-3)
							ThisFormset.Receive_Edit.txtActualW.Value	= PrepareSQLnum(tmpSDSOiHeat.Orig_LBS,'LBS',9,1)
							ThisFormset.Receive_Edit.txtBillW.Value		= PrepareSQLnum(tmpSDSOiHeat.Orig_LBS,'LBS',9,1)				
							ThisFormset.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpSDSOiHeat.Orig_QTY,'S_QTY',-5)
							ThisFormset.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpSDSOiHeat.Orig_P,'S_P',-5)
							
							PRIVATE nAcct_PU 
							nAcct_PU = PrepareSQLnum(tmpSDSOiHeat.Orig_PU,'S_PU',-1)
							ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
							ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
							ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)									
							
							ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpSDSOiHeat.Orig_P,'Q_P',-5)
							ThisFormset.Receive_Edit.txtPO_QTY.Value 	= Calc_Vend_QTYleft_PO(ThisFormSet.cPOitem, ThisFormSet.nConnhandle)
							
							PRIVATE nCust_PU
							nCust_PU = PrepareSQLnum(tmpSOitem.Q_PU,'Recv_PU',-1)	&&Cust
							ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
							ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nCust_PU, ThisFormSet.nConnhandle)
							ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nCust_PU, ThisFormSet.nConnhandle)
							
		*	
							ThisFormset.Receive_Edit.txtPieces.Value 	= Calc_Vend_PiecesLeft_PO(ThisFormSet.cPOitem, ThisFormSet.nConnhandle)
		
							ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpSDSOiHeat.Form,'Form',2)	
		
							*ThisFormset.Receive_Edit.txtPieces.Value 	= PrepareSQLnum(tmpSDSOiHeat.Orig_PC,'Orig_PC',-3)
							
							* StockLst_Dim1
							IF RECCOUNT('tmpSDSOiHeat') > 1
								MESSAGEBOX("Caution, more than one Heat/Lot record was found!",0+64,"Multiple records found")
							ENDIF	 
						ENDIF
						USE IN tmpSDSOiHeat
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		**validate data
		IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
			IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle )=0
				MESSAGEBOX("The PO item '"+ThisFormSet.cPOitem+"'"+CHR(13)+" entered with SO item '"+ThisFormSet.cSOitem+"'"+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The PO item '"+ThisFormSet.cPOitem+"' entered with SO item '"+ThisFormSet.cSOitem+"', does not Exists!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getwo_detail
	ENDPROC

	PROCEDURE get_exact_receivingid
		PARAMETERS nReceivingID
		*ThisFormSet.Get_exact_ReceivingID(nReceivingID)
		IF USED("tmpReceivingPOi")
			USE IN tmpReceivingPOi
		ENDIF
		
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
		
		SELECT 0  
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOi")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceivingPOi')
			RETURN .F.
		ENDIF
		IF USED('tmpReceivingPOi')
			ThisFormSet.Receive_Edit.txtHeat.Value		= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Heat,'Heat',50,.F.,.T.))
			ThisFormSet.Receive_Edit.txtLot.Value		= PrepareSQLtxt(tmpReceivingPOi.Lot,'Lot',10)
			ThisFormSet.Receive_Edit.chkCert.Value		= PrepareSQLchk(tmpReceivingPOi.Cert,'Cert')
			ThisFormSet.Receive_Edit.txtPieces.Value	= PrepareSQLnum(tmpReceivingPOi.Pieces,'Pieces',-3)
			ThisFormSet.Receive_Edit.edtDescription.Value = ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Description,'Descript',-1,.F.,.T.))
			ThisFormSet.Receive_Edit.edtSpecs.Value		= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Specs,'Specs',160))
			ThisFormSet.Receive_Edit.edtComments.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Comments,'Receipt',-1))
			ThisFormSet.Receive_Edit.txtInit.Value		= ShowSQLtxt(tmpReceivingPOi.Init,'INIT',10)
			ThisFormSet.Receive_Edit.txtDate.Value		= ShowSQLdate(tmpReceivingPOi.Date,'Date')
			ThisFormSet.Receive_Edit.chkPass.Value		= PrepareSQLchk(tmpReceivingPOi.Pass,'Pass')
			ThisFormSet.Receive_Edit.chkGoodPapers.Value	= PrepareSQLchk(tmpReceivingPOi.GoodPapers,'GoodPapers')
			
			ThisFormSet.Receive_Edit.txtActualW.Value	= PrepareSQLnum(tmpReceivingPOi.ActualW,'Weight',9,1)
			ThisFormSet.Receive_Edit.txtBillW.Value		= PrepareSQLnum(tmpReceivingPOi.BillW,'Weight',9,1)
			
			ThisFormSet.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpReceivingPOi.R_QTY,'S_QTY',-5)
			ThisFormSet.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpReceivingPOi.R_P,'S_P',-5)
			
			PRIVATE nAcct_PU 
			nAcct_PU = PrepareSQLnum(tmpReceivingPOi.R_PU,'S_PU',-1)
			ThisFormSet.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisFormSet.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormSet.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		*						
			PRIVATE nVend_PU 
			nVend_PU = PrepareSQLnum(tmpReceivingPOi.PO_PU,'PO_PU',-1)
			IF nVend_PU > 0
				ThisFormSet.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOi.PO_QTY,'PO_QTY',-5)
				ThisFormSet.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOi.PO_P,'PO_P',-5)
				
				ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
				ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
				ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
			ELSE
				*Old Receive - Get by POitem
				IF Proper_PO_Item(ThisFormSet.cPOitem) <> Proper_PO_Item("")
					nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
					ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
					ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
					ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
					
					PRIVATE nVend_QTY, nVend_P
					nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisFormSet.nConnhandle)
					nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
					ThisFormSet.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
					ThisFormSet.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
		
				ELSE
					ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',2)
					ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( 1, ThisFormSet.nConnhandle)
					ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisFormSet.nConnhandle)
				ENDIF								
			ENDIF
			
			ThisFormSet.Receive_Edit.txtVendor.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Vendor,'Vendor',30))
			ThisFormSet.Receive_Edit.txtRMA_No.Value	= PrepareSQLnum(tmpReceivingPOi.RMA_No,'RMA_No',-3)
			ThisFormSet.Receive_Edit.txtRMA_Detail.Value= PrepareSQLnum(tmpReceivingPOi.RMA_Detail,'RMA_Detail',-3)
			
			ThisFormSet.Receive_Edit.txtRejectPC.Value	= PrepareSQLnum(tmpReceivingPOi.RejectPC,'RejectPC',-3)
			ThisFormSet.Receive_Edit.txtRejectReason.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.RejectReason,'RejectReason',255))
			
			ThisFormSet.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(tmpReceivingPOi.Services,'Services')
			ThisFormSet.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(tmpReceivingPOi.ConvServ,'ConvServ') 
			ThisFormSet.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(tmpReceivingPOi.Equipment,'Equipment')
		
			*ThisFormSet.Receive_Edit.txtAlloy.SetFocus()
			
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE get_rma_detail
		*ThisFormSet.Get_RMA_Detail
		*Called from: lblRMA_No.Click 
		PRIVATE nRMA_Detail, nRMA, cHeat, cLot
		nRMA_Detail= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtHeat.Value,'Heat',50)
		cLot	= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtLot.Value,'Lot',10)
		
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtSOitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		IF nRMA = 0
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				*No SOitem to compare with
				RETURN .T.
			ELSE
				
			ENDIF
		ENDIF
				
		PRIVATE cSQL, nSQLExec
		IF USED("tmpRMA")
			USE IN tmpRMA
		ENDIF
		
		PRIVATE cMess
		
		cSQL = "SELECT RD.SO_item "
		cSQL = cSQL + ",RMA.RMA_No, RD.RMA_Detail_ID"
		cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_NO "
		
		cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRMA')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRMA' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRMA' )
		ENDIF
		
		
		IF USED('tmpRMA')
			IF RECCOUNT('tmpRMA') > 0
		*		IF Proper_SO_item(tmpRMA.SO_item) <> Proper_SO_item('')
					IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
						SELECT tmpRMA
						LOCATE FOR SO_item = cSOitem
						IF FOUND('tmpRMA')
							ThisFormSet.Receive_Edit.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail',-3)
							*ThisFormSet.Refresh_RMA_Detail()
						ELSE
						*IF Proper_SO_item(tmpRMA.SO_item) <> SO_item
							MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA.SO_item),16,"Does not Match")
							GO TOP			
						ENDIF
					ELSE
						IF RECCOUNT('tmpRMA') = 1
							ThisFormSet.Receive_Edit.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail',-3)
						ENDIF
					ENDIF
		*		ENDIF
			ENDIF
			
			SELECT tmpRMA
			
		
			USE IN tmpRMA		
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pcWhat, pValue, pcHeat
		*DO FORM Forms\Receive_Edit WITH 'EDIT',nRID,''
		*DO FORM Forms\Receive_Edit WITH 'ADD','','' --create RID
		*DO FORM Forms\Receive_Edit WITH 'B_Process', pnID_Detail_process ,cHeat
		*DO FORM Forms\Receive_Edit WITH 'WO_Detail', nWO_Detail ,"ADD"  --Pass create to not just edit, force ADD
		*pcWhat = "ADD "EDIT "RMA RMA_Detail "POitem "SOitem" tk_Detail "Brk_Detail "S_Process "B_Process" W_Process "WO_Detail "WO"
		* "VIEW"
		*DO FORM Forms\Receive_Edit WITH 'POitem','  509256-01'
		IF VARTYPE(pcWhat)!="C"
			pcWhat=''
		ENDIF
		
		IF NOT ( VARTYPE(pValue)="C" OR VARTYPE(pValue)="N" )
			pValue=''
		ENDIF
		
		
		ThisFormset.Receive_Edit.lblWhat.Caption = ''
		ThisFormSet.cWhat = pcWhat
		
		IF VARTYPE(pcHeat)!="C"
			pcHeat=''
		ENDIF
		ThisFormSet.cHeat = PrepareSQLtxt(pcHeat,'HEAT',50)
		IF ALLTRIM(UPPER(ThisFormSet.cHeat)) = "DUE IN"
			ThisFormSet.cHeat	= ""
		ENDIF
		
		ThisFormset.Receive_Edit.txtReceivingID.Value = 0
		ThisFormset.Receive_Edit.txtTBL.Value = ''
		
		DO CASE 
		CASE pcWhat = "ADD"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormSet.ResetAddVars()
			ThisFormSet.cHeat = PrepareSQLtxt(pcHeat,'HEAT',50)	&&put Heat back in after ResetAddVars()
			
			
		CASE pcWhat = "EDIT"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'EDIT'
			*ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLtxt(pValue,'ReceivingID',-3)
			ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLnum(pValue,'ReceivingID',-3)
			ThisFormSet.getBy_ReceivingID()
			*CALLS:ThisFormset.Receive_EditcmdClone.Visible = .T.
			
		CASE pcWhat = "VIEW"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'VIEW'
			*ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLtxt(pValue,'ReceivingID',-3)
			ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLnum(pValue,'ReceivingID',-3)
			ThisFormSet.getBy_ReceivingID()
			
			ThisFormset.Receive_EditcmdAdd.Visible = .F.
			ThisFormset.Receive_EditcmdClear.Visible = .F.
			*ThisFormset.Receive_EditcmdClone.Visible = .F.
			ThisFormset.Receive_EditcmdAbort.Visible = .T.
		
		CASE pcWhat = "RMA_Detail"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormSet.nRMA = get_RMA_from_RMA_Detail(PrepareSQLnum(pValue,'RMA_Detail',-3),ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.txtRMA_No.Value = ThisFormSet.nRMA
			ThisFormset.Receive_Edit.txtRMA_Detail.Value	= PrepareSQLnum(pValue,'RMA_Detail',-3)
		
			IF ThisFormSet.CheckRMA()
				ThisFormSet.Get_RMA_Detail()
				*CALLS:ThisFormSet.Refresh_RMA_Detail()
			ENDIF
			
		CASE pcWhat = "RMA"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormSet.nRMA = PrepareSQLnum(pValue,'RMA_No',-3)
			ThisFormset.Receive_Edit.txtRMA_No.Value = PrepareSQLnum(pValue,'RMA_No',-3)
			*	ThisFormSet.RMA_Receive() &&Old
			IF ThisFormSet.CheckRMA()
				ThisFormSet.Get_RMA_Detail()
				*CALLS:ThisFormSet.Refresh_RMA_Detail()
			ENDIF
			
		CASE pcWhat = "POitem"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormSet.cPOitem = PrepareSQLtxt(pValue,'POitem',12)
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			IF Proper_PO_item(pValue) != Proper_PO_item('') AND Proper_PO_item(pValue) = pValue	&&poitem is not empty and a valid poitem
				ThisFormset.Receive_Edit.txtHPAPONum.Value = Proper_PO_Item_PO(pValue)
				ThisFormset.Receive_Edit.txtHPAPOItem.Value = Proper_PO_Item_Item(pValue)
				ThisFormSet.GetPOitemDetail(pValue)
		
			ENDIF
		
		CASE pcWhat = "SOitem"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormSet.cSOitem = PrepareSQLtxt(pValue,'SOitem',10)
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetSoItemDetail()
		
		CASE pcWhat = "Stk_Detail"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormset.Receive_Edit.txtID_Detail.Value = PrepareSQLnum(pValue,'ID_Detail',-3)
			ThisFormset.Receive_Edit.txtTBL.Value = "S"
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetBy_STK_Detail()
			
		CASE pcWhat = "Brk_Detail"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormset.Receive_Edit.txtID_Detail.Value = PrepareSQLnum(pValue,'ID_Detail',-3)
			ThisFormset.Receive_Edit.txtTBL.Value = "B"
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetBy_STK_Detail()
		
		CASE pcWhat = "S_Process"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormset.Receive_Edit.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*	ThisFormset.Receive_Edit.txtID_Detail.Value = 
		*	ThisFormset.Receive_Edit.txtID_Master.Value = 
			ThisFormset.Receive_Edit.txtTBL.Value = "S"
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetBy_STK_Detail_Process()
			ThisSetForm.Look4_RecvID()
			
		CASE pcWhat = "B_Process"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormset.Receive_Edit.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*	ThisFormset.Receive_Edit.txtID_Detail.Value = 
		*	ThisFormset.Receive_Edit.txtID_Master.Value = 
			ThisFormset.Receive_Edit.txtTBL.Value = "B"
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetBy_STK_Detail_Process()
			ThisSetForm.Look4_RecvID()
			
		CASE pcWhat = "W_Process"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormset.Receive_Edit.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*	ThisFormset.Receive_Edit.txtID_Detail.Value = 
		*	ThisFormset.Receive_Edit.txtID_Master.Value = 
			ThisFormset.Receive_Edit.txtTBL.Value = "W"
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetBy_STK_Detail_Process()
			ThisSetForm.Look4_RecvID()
			
		CASE pcWhat = "WO_Detail"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormset.Receive_Edit.txtWO_Detail.Value = PrepareSQLnum(pValue,'WO_Detail',-3)
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetBy_nWO_Detail(PrepareSQLnum(pValue,'WO_Detail',-3))
			
		CASE pcWhat = "WO"
			ThisFormset.Receive_Edit.lblWhat.Caption = 'ADD'
			ThisFormset.Receive_Edit.txtWO.Value = PrepareSQLnum(pValue,'WO',-3)
			IF UPPER(pcHeat) = "ADD"
				ThisFormSet.cHeat = ""
				ThisFormSet.cWhat = "ADD"
			ENDIF
			ThisFormSet.GetBy_nWO()
				
		OTHERWISE
			MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Receive_Edit WITH 'pcWhat', pValue, 'pcHeat'",16,"Bad Parameters")
			TrackError("Did not get a proper pcWhat. '"+pcWhat+"'"+CHR(13)+"\Receive_Edit WITH 'pcWhat', pValue, 'pcHeat'","Parameter error!",PROGRAM(), LINENO(1))
		ENDCASE
		
		PRIVATE nWO, nWO_Detail, nReceivingID
		nWO			= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO.Value,'WO',-3)
		nWO_Detail 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		nHpaPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		********************************
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisFormset.Receive_Edit.txtTBL.Value,'TBL',1)
		
		
		********************************
		IF LEN(cTBL)=0 OR cTBL = "N"
			*Find TBL if PO is for Metal
			DO CASE
			CASE pcWhat = "WO" AND nWO > 0
				cTBL = getTBL_WO(nWO, ThisFormSet.nConnhandle) 
			CASE pcWhat = "WO_Detail" AND nWO_Detail > 0
				cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
		
			CASE nReceivingID > 0
				*nReceivingID was broken untill 2/5/22
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
					cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
				ELSE
					cTBL = getTBL_ReceivingID(nReceivingID, ThisFormSet.nConnhandle) 
				ENDIF
				
			CASE nWO > 0
				cTBL = getTBL_WO(nWO, ThisFormSet.nConnhandle) 	
			CASE nWO_Detail > 0
				cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle) 
			CASE nHpaPo > 0
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
					cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
				ENDIF
			OTHERWISE
				*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive"+CHR(13)+"INIT pWhat="+pcWhat+", pValue="+PrepareSQLtxt(pValue,'Order',20)+", pcHeat="+pcHeat )
			ENDCASE
			
			ThisFormSet.cTBL = cTBL
			ThisFormset.Receive_Edit.txtTBL.Value = cTBL
		ENDIF
		
		IF LEN(cTBL)=0 OR cTBL = "N"
			*Check POitem: the POitem is possible a bad data, POitem does not belong with this Receive
			IF nHpaPo > 0
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
					cTBL = getTBL_Poitem(cPOitem, ThisFormSet.nConnhandle) 
					ThisFormSet.cTBL = cTBL
					ThisFormset.Receive_Edit.txtTBL.Value = cTBL
				ENDIF
			ENDIF
		ENDIF
		
		********************************
		IF LEN(cTBL)=0 OR cTBL = "N"
			IF PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,"ID_Detail",-3) > 0 OR PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Master.Value,"ID",-3) > 0
			 	IF VARTYPE(pValue) = 'N'
					TrackError("Did not find TBL. '"+pcWhat+"'"+CHR(13)+"\Receive_Edit WITH pcWhat='"+pcWhat+"', pValue="+STR(pValue)+", pcHeat='"+pcHeat+"'","Parameter error!",PROGRAM(), LINENO(1))
				ELSE
					TrackError("Did not find TBL. '"+pcWhat+"'"+CHR(13)+"\Receive_Edit WITH pcWhat='"+pcWhat+"', pValue='"+pValue+"', pcHeat='"+pcHeat+"'","Parameter error!",PROGRAM(), LINENO(1))
				ENDIF
			ENDIF
		ENDIF
		
		*****************
		IF NOT ( LEN(cTBL)=0 OR cTBL = "N" )
			PRIVATE nID_Detail
			nID_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
			IF nID_Detail > 0
				*get_Description_ID_Detail(nID_Detail,cTBL,ThisFormSet.nConnhandle,lAddAlloy,lAddAll)
				ThisFormset.Receive_Edit.txtDescript.Value = get_Description_ID_Detail(nID_Detail,cTBL,ThisFormSet.nConnhandle,.T.,.F.)
				
			ENDIF
		ENDIF
		
		****************
		IF ThisFormSet.cWhat = "ADD"
			ThisFormset.Receive_Edit.txtReceived.Value = DTOC( DATE() )
		ENDIF
		
		IF nReceivingID > 0
			ThisFormset.Receive_EditcmdEditHeat.Visible = .T.
			
			IF ThisFormSet.cWhat = "EDIT"
				IF PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)=0
					ThisFormset.Receive_Edit.txtID_Detail.Value = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.txtID_Master.Value = Get_ID_Master_by_ReceivingID(nReceivingID,cTBL,ThisFormSet.nConnhandle)
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE init_showrecv_order
		PARAMETERS pWhat,pOrder, cAlloy,cHeat, nPC_Recv, nRcv_HPA_QTY, nActualW, cDescription, nReceivingID, cTBL, nID_Detail,cLot,nID_Master
		*DO FORM Forms\ShowReceived_Ordered WITH "POitem",cPOitem, cAlloy,cHeat,nPC_Recv,nRcv_HPA_QTY,nActualW,cDescription,nReceivingID,TBL,ID_Detail,Lot,nID_Master TO lRollBack
		*cPOitem can be WO_Detail!!
		*Receive_Edit
		
		IF VARTYPE(pWhat) != "C"
			RETURN
		ENDIF
		
		*IF VARTYPE(pOrder) != "C"
		*	*cPOitem = Proper_PO_item('')
		*	pOrder = ''
		*ENDIF
		
		PRIVATE nWO_Detail
		nWO_Detail = 0
		
		DO CASE
		CASE pwhat = "WOD"
			nWO_Detail = PrepareSQLnum(pOrder,'WO_Detail',-3)
			cPOitem = Proper_PO_Item('')
			pOrder = STR(pOrder)
		CASE pWhat = "POitem"
			IF Proper_PO_Item(pOrder) <> Proper_PO_Item('')
				nWO_Detail = 0
				cPOitem = Proper_PO_Item(pOrder)
			ELSE
				TrackError("Show_Recv_Order bad parameter pWhat='POitem'.","Show_Recv_Order bad parameter", PROGRAM(), LINENO(1))
				ThisFormSet.nReturn = 0
				RETURN
				*ThisFormSet.Show_Recv_Order.Release
			ENDIF
		OTHERWISE
			TrackError("Show_Recv_Order bad parameter pWhat. INIT not programed for paramater.","Show_Recv_Order bad parameter", PROGRAM(), LINENO(1))
			ThisFormSet.nReturn = 0
			RETURN
			*ThisFormSet.Show_Recv_Order.Release
		ENDCASE
		
		
		IF VARTYPE(nReceivingID)!= "N"
			nReceivingID = 0
		ENDIF
		ThisFormSet.nReceivingID  = ABS(nReceivingID)   &&Inverted means New ID, was just ADDed
		
		IF nWO_Detail > 0
			ThisFormSet.SetToWOD()
			ThisFormSet.Show_Recv_Order.lblSummary.Caption = "Summary for WO Detail: "+ALLTRIM(STR(nWO_Detail))
			ThisFormSet.nWO_Detail = nWO_Detail
			ThisFormSet.cPOitem = ''
			ThisFormSet.cSOitem = Proper_SO_item('')
			ThisFormSet.Show_Recv_Order.lblPOitem.Caption = "WO Detail"
		ELSE
			*POitem
			ThisFormSet.Show_Recv_Order.lblSummary.Caption = "Summary for PO-item: "+ALLTRIM(cPOitem)
			ThisFormSet.cPOitem = cPOitem
			ThisFormSet.nWO_Detail = 0
			ThisFormSet.cSOitem = get_SOitem_from_POitem(cPOitem,ThisFormSet.nConnhandle)
			ThisFormSet.Show_Recv_Order.lblPOitem.Caption = "PO item"
		ENDIF
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('') OR nWO_Detail > 0
			*Good
		ELSE
			RecordTest('Record Test Data','Show_Recv_Order.INIT()',LINENO(1),"cPOitem "+cPOitem+", nWO_Detail "+STR(nWO_Detail) )
		ENDIF
		
		ThisFormSet.cTBL = PrepareSQLtxt(cTBL,'TBL',1)
		ThisFormSet.nID_Detail = PrepareSQLnum(nID_Detail,'ID_Detail',-3)
		ThisFormSet.nID_Master = PrepareSQLnum(nID_Master,'ID',-3)
		
		************************************
		PRIVATE lServices, lConvServ, lEquipment
		lServices = .F.
		lConvServ = .F.
		lEquipment = .F.
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "Select 0 "
		
		IF USED('tmpPO')	
			USE IN tmpPO
		ENDIF
		
		DO CASE
		CASE nWO_Detail > 0
			cSQL = "SELECT 'HPA' AS Company,fAlloy AS Alloy,fForm AS Form,fCC AS CC,fCL AS CL"
			cSQL = cSQL+",fThck AS Thck, fSz2 AS sz2, fSz3 AS sz3,fPieces AS Pieces"
			cSQL = cSQL+",fWeight AS StockLst_QTY,fWeight AS Pounds, 0 AS StockLst_P"
			cSQL = cSQL+", 0 AS Services, 0 AS ConvServ, 0 AS Equipment, 0 AS Delivered, 0 AS Reconciled "
			cSQL = cSQL+" FROM dbo.WorkOrder_Detail WITH(NOLOCK) WHERE WO_Detail = "+STR(nWO_Detail)
		*!*	CASE ThisFormSet.nID_Detail > 0
		*!*		DO CASE
		*!*		CASE ThisFormSet.cTBL = 'S'
		*!*		CASE ThisFormSet.cTBL = 'S'
		*!*		CASE ThisFormSet.cTBL = 'S'
		*!*		ENDCASE
		CASE Proper_PO_item(cPOitem) <> Proper_PO_item('')
			cSQL = "SELECT Company,Alloy,Form,CC,CL,Thck,sz2,sz3,Pieces"
			cSQL = cSQL+",StockLst_QTY, Pounds, StockLst_P"
			cSQL = cSQL+",Services,ConvServ,Equipment,Delivered,Reconciled "
			cSQL = cSQL+" FROM dbo.PurchaseOrder WITH(NOLOCK) WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDCASE
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpPO')	
			IF RECCOUNT('tmpPO') > 0
				ThisFormSet.Show_Recv_Order.txtCompany.Value	= tmpPO.Company
				ThisFormSet.Show_Recv_Order.txtAlloyPO.Value	= tmpPO.Alloy
				ThisFormSet.Show_Recv_Order.txtForm.Value		= tmpPO.Form
				ThisFormSet.Show_Recv_Order.txtThck.Value		= tmpPO.Thck
				ThisFormSet.Show_Recv_Order.txtSz2.Value		= tmpPO.sz2
				ThisFormSet.Show_Recv_Order.txtSz3.Value		= tmpPO.sz3
				ThisFormSet.Show_Recv_Order.txtPiecesPO.Value	= tmpPO.Pieces
				ThisFormSet.Show_Recv_Order.txtS_QTY.Value		= PrepareSQLnum(tmpPO.StockLst_QTY,'QTY',-5)
				ThisFormSet.Show_Recv_Order.txtS_P.Value		 = PrepareSQLnum(tmpPO.StockLst_P,'S_P',-5)
				ThisFormSet.Show_Recv_Order.txtOrder_LBS.Value = tmpPO.Pounds
				ThisFormSet.Show_Recv_OrderchkServicesPO.Value = tmpPO.Services
				ThisFormSet.Show_Recv_OrderchkConvServ.Value	= tmpPO.ConvServ
				ThisFormSet.Show_Recv_OrderchkEquipment.Value	= tmpPO.Equipment
				ThisFormSet.Show_Recv_OrderchkComplete.Value	= tmpPO.Delivered
				ThisFormSet.Show_Recv_OrderchkReconciled.Value = tmpPO.Reconciled	
				
				lServices	= PrepareSQLlogic(tmpPO.Services,'Services',.F.)
				lConvServ	= PrepareSQLlogic(tmpPO.ConvServ,'ConvServ',.F.)
				lEquipment	= PrepareSQLlogic(tmpPO.Equipment,'Equipment',.F.)
			ENDIF
			USE IN tmpPO
		ENDIF
		
		
		*!*	ThisFormSet.Show_Recv_Order.txt_SO_QTY.Value = 0
		*!*	ThisFormSet.Show_Recv_Order.txt_Cmplt_QTY.Value = 0
		*!*	ThisFormSet.cTBL = 'N'
		
		*!*	IF USED('tmpPO_Orig')	
		*!*		IF RECCOUNT('tmpPO_Orig') > 0
		*!*			*POitem in StockLst_Process
		*!*			ThisFormSet.cTBL	= PrepareSQLtxt(tmpPO_Orig.TBL,'TBL',1)
		*!*			
		*!*			ThisFormSet.Show_Recv_Order.txt_SO_QTY.Value     = PrepareSQLnum(tmpPO_Orig.QTY,'QTY',-3)		
		*!*			*ThisFormSet.Show_Recv_Order.txt_SO_QTY.Value     = PrepareSQLnum(tmpPO_Orig.QTY,'QTY',-3)
		*!*			ThisFormSet.Show_Recv_Order.txt_Cmplt_QTY.Value = PrepareSQLnum(tmpPO_Orig.Prc_Q_QTY,'Prc_Q_QTY',-3)
		*!*			ThisFormSet.Show_Recv_Order.txt_Cmplt_QTY.Value	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txt_SO_QTY.Value - ThisFormSet.Show_Recv_Order.txt_Cmplt_QTY.Value,'Diff',-3)
		*!*			
		*!*			ThisFormSet.Show_Recv_Order.lbl_Orig_QTY.Visible = .T.
		*!*			ThisFormSet.Show_Recv_Order.txt_SO_QTY.Visible = .T.
		*!*			ThisFormSet.Show_Recv_Order.lbl_Orig_Prc_Q_QTY.Visible = .T.
		*!*			ThisFormSet.Show_Recv_Order.txt_Cmplt_QTY.Visible = .T.
		*!*			ThisFormSet.Show_Recv_Order.lbl_Orig_Need.Visible = .T.
		*!*			ThisFormSet.Show_Recv_Order.txt_Cmplt_QTY.Visible = .T.
		*!*			
		*!*		ENDIF
		*!*		IF RECCOUNT('tmpPO_Orig') > 1
		*!*			*TrackError("Why is there more than 1, Counted "+ALLTRIM(STR(RECCOUNT('tmpPO_Orig')))+" ."+CHR(13)+cSQL,"Too many _Orig Records.",PROGRAM(),LINENO(1) )
		*!*			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Long Message")
		*!*		ENDIF
		*!*		USE IN tmpPO_Orig
		*!*	ELSE
		*!*		RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1), 'No records for POitem in StockLst_Process'+CHR(13)+cSQL )
		*!*	ENDIF
		
		***********************
		*PRIVATE cTBL
		*cTBL = "N"
		*ThisFormSet.cTBL = "N"
		
		IF ( lServices OR lEquipment )
			IF ThisFormSet.cTBL == ''
				ThisFormSet.cTBL = 'N'
			ENDIF
		ELSE
			IF ThisFormSet.cTBL == '' OR ThisFormSet.cTBL = "N"
				IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
					***
					*cTBL = getTBL_POitem(cPOitem, ThisFormSet.nConnhandle) 
					***
					ThisFormSet.cTBL = getTBL_POitem(cPOitem, ThisFormSet.nConnhandle) 
					*IF LEN(cTBL) > 0
					*	RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1), "cTBL set to '"+cTBL+"' for receiving POitem '"+cPOitem+"'" )
					*ELSE
					*	RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1), "cTBL was not found for receiving POitem '"+cPOitem+"'" )
					*ENDIF
				ELSE
					IF nWO_Detail > 0
						ThisFormSet.cTBL = getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle)
					ENDIF
				ENDIF 
			ENDIF
		ENDIF
		
		
		
		************************
		
		IF NOT ( lServices OR lEquipment )
			IF ThisFormSet.cTBL=='' OR ThisFormSet.cTBL = "N" 
				*MESSAGEBOX("Did not find TBL ",0+16,"This will cause errors!")
				*TrackError("Did not find TBL, POitem = '"+cPOitem+"', WO_Detail = "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"Even tried getTBL_POitem('"+cPOitem+"') --Setting to 'S'"+CHR(13)+cSQL, "Did not find TBL",PROGRAM(),LINENO(1))
				
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not find TBL, POitem = '"+cPOitem+"', WO_Detail = "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"Even tried getTBL_POitem('"+cPOitem+"') --Setting to 'S'"+CHR(13)+cSQL )
		
				IF nWO_Detail > 0
					*put in stock!
					ThisFormSet.cTBL = 'S'
				ELSE
					ThisFormSet.cTBL = 'S'
				ENDIF
			ENDIF
		ENDIF
		
		
		************************
		*get the RECEIVE data
		*
		*cAlloy,cHeat,nPC_Recv,nRcv_HPA_QTY,cDescription
		
		ThisFormSet.Show_Recv_Order.txtAlloy.Value		= ShowSQLtxt(cAlloy,'Alloy',12)
		ThisFormSet.Show_Recv_Order.txtHeat.Value		= ShowSQLtxt(cHeat,'Heat',50)
		ThisFormSet.cHeat 				= ShowSQLtxt(cHeat,'Heat',50)
		ThisFormSet.Show_Recv_Order.txtLot.Value		= ShowSQLtxt(cLot,'Lot',10)
		ThisFormSet.Show_Recv_Order.txtPC_Recv.Value	= PrepareSQLnum(nPC_Recv,'Pieces',-3)
		ThisFormSet.Show_Recv_Order.txtActualW.Value	= PrepareSQLnum(nActualW,'Pounds',9,1)
		ThisFormSet.Show_Recv_Order.txtRcv_QTY.Value	= PrepareSQLnum(nRcv_HPA_QTY,'Receive_QTY',9,1)
		
		ThisFormSet.Show_Recv_OrderedtDescription.Value = ShowSQLtxt(cDescription,'Description',-1)
		
		
		************************
		* Collect All Receives
		*
		IF USED('tmpReceive')
			USE IN tmpReceive
		ENDIF
		
		************************
		cSQL = "SELECT Alloy,Heat,Pieces, ActualW, R_QTY, R_PU"
		cSQL = cSQL+",PO_QTY,PO_PU"
		cSQL = cSQL+" ,LEFT(Description,100) AS [Description],Cancelled,ID "
		cSQL = cSQL+" FROM dbo.Receiving WITH(NOLOCK) "
		IF nWO_Detail > 0
			cSQL = cSQL+" WHERE ( WO_Detail = "+STR(nWO_Detail)
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cSQL = cSQL+" OR POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			ENDIF
			cSQL = cSQL+" ) "
		ELSE
			*IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDIF
		
		IF ThisFormSet.nReceivingID  > 0
			cSQL = cSQL+" OR ID = "+STR(ThisFormSet.nReceivingID )
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceive')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceive')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceive")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceive")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceive')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		PRIVATE m.nPast_QTY, m.nPast_LBS, m.nPast_PC
		m.nPast_QTY = 0
		m.nPast_LBS = 0
		m.nPast_PC = 0
		
		IF USED('tmpReceive')	
			IF RECCOUNT('tmpReceive') > 0
			
				SET TALK OFF
				SUM ActualW TO m.nPast_LBS FOR ID <> ABS(nReceivingID)
				SUM R_QTY	TO m.nPast_QTY FOR ID <> ABS(nReceivingID)
				SUM Pieces	TO m.nPast_PC  FOR ID <> ABS(nReceivingID)
				
				ThisFormSet.Show_Recv_Order.txtPast_LBS.Value = ROUND(m.nPast_LBS,1)
				ThisFormSet.Show_Recv_Order.txtPast_QTY.Value = PrepareSQLnum(m.nPast_QTY,'QTY',-5)
				ThisFormSet.Show_Recv_Order.txtPast_PC.Value = ROUND(m.nPast_PC,0)
				GO TOP
				
				ThisFormSet.Show_Recv_OrderedtAllDescription.Value = tmpReceive.Description
				ThisFormSet.Show_Recv_OrdergrdReceive.RecordSource = 'tmpReceive'
				
				IF nReceivingID > 0
					ThisFormSet.Show_Recv_OrdergrdReceive.SetAll("dynamicbackcolor","IIF(ID="+STR(nReceivingID)+",RGB(128,255,128),IIF(tmpReceive.cancelled, RGB(255,255,255), RGB(0,205,128)))", "Column")
				ELSE
					ThisFormSet.Show_Recv_OrdergrdReceive.SetAll("dynamicbackcolor","IIF(tmpReceive.cancelled, RGB(255,255,255), RGB(0,205,128))", "Column")
				ENDIF
				
				ThisFormSet.Show_Recv_OrdergrdReceive.Visible = .T.
			ENDIF
			*USE IN tmpReceive
		ENDIF
		
		IF nReceivingID < 0
			*Change Screen to an EDIT -not Add!
		*!*		ThisFormSet.Show_Recv_OrderShape1.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.lblThisReceive.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.lblAlloy.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.txtAlloy.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.lblHeat.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.txtHeat.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.lblPieces.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.txtPC_Recv.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.lblActualLbs.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.txtActualW.Visible = .F.
		*!*		ThisFormSet.Show_Recv_Order.lblDescript.Visible = .F.
		*!*		ThisFormSet.Show_Recv_OrderedtDescription.Visible = .F.
			
			ThisFormSet.Show_Recv_OrdercmdJustEdit.Visible = .T.
			
			*Might need to change these
			*ThisFormSet.Show_Recv_OrdercmdCancel.Visible = .F.
			*ThisFormSet.Show_Recv_OrdercmdGood.Visible = .F.
			*ThisFormSet.Show_Recv_OrdercmdGoodCmplt.Visible = .F.
			
			SELECT tmpReceive
			LOCATE FOR ID = nReceivingID 
		ELSE
		
			IF NOT EMPTY(cHeat)
				SELECT tmpReceive
				LOCATE FOR Heat = cHeat
			ENDIF
		ENDIF
		
		
		***********************
		* Calc Diff
		*
		PRIVATE nS_QTY, nOrder_LBS, nRcv_HPA_QTY, nQTY_Need, lOrderItemDone
		nS_QTY 	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtS_QTY.Value,'S_QTY',9,1)
		nOrder_LBS	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtOrder_LBS.Value,'Pounds',9,1)
		nRcv_HPA_QTY = PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtRcv_QTY.Value,'R_QTY',9,1)
		nReceive_LBS = PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtActualW.Value,'Pounds',9,1) 
		PRIVATE nPieces, nPC_Recv, nPC_Need
		nPieces		= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPiecesPO.Value,'PC',-3)
		nPC_Recv	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Recv.Value,'PC',-3)
		nPC_Need	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Need.Value,'PC',-3)
		nPC_Need	= ROUND( nPieces - nPC_Recv - nPast_PC, 0)
		
		nQTY_Need 	= IIF(nS_QTY - m.nPast_QTY - nRcv_HPA_QTY > 0,nS_QTY - m.nPast_QTY - nRcv_HPA_QTY,0)
		nLBS_Need	= ROUND( IIF(nOrder_LBS - m.nPast_LBS - nReceive_LBS > 0,nOrder_LBS - m.nPast_LBS - nReceive_LBS,0) ,1)
		
		
		ThisFormSet.Show_Recv_Order.txtQTY_Need.Value = ABS(nQTY_Need)
		ThisFormSet.Show_Recv_Order.txtLBS_Need.Value = ABS(nLBS_Need)
		ThisFormSet.Show_Recv_Order.txtPC_Need.Value = ABS(nPC_Need)
		
		PRIVATE cMess
		*Show Red if need more than 20% 
		DO CASE
		CASE (m.nPast_QTY + nRcv_HPA_QTY) >= nS_QTY
			lOrderItemDone = .T.
		CASE ( (m.nPast_QTY + nRcv_HPA_QTY + 5 ) > (nS_QTY+5) * 1.2 ) OR ( (m.nPast_QTY + nRcv_HPA_QTY +5 ) * 1.2 < (nS_QTY+5) )
			cMess = "Receive DID NOT complete expected QTY  --or within 20%"+CHR(13)
			cMess = cMess+"Recv QTY: "+ALLTRIM(STR((m.nPast_QTY + nRcv_HPA_QTY + 5 )))+" > "+ALLTRIM(STR((nS_QTY+5) * 1.2 ))+" expected *1.2"+CHR(13)
			cMess = cMess+"Recv QTY*1.2: "+ALLTRIM(STR((m.nPast_QTY + nRcv_HPA_QTY + 5 )*1.2))+" > "+ALLTRIM(STR((nS_QTY+5) ))+" expected "+CHR(13)
			MESSAGEBOX(cMess,32,"QTY Math")
			
		*	MESSAGEBOX( "(m.nPast_QTY + nRcv_HPA_QTY + 5 )"+" > (nS_QTY+5) * 1.2 ) ",32,"QTY Math")
		*	MESSAGEBOX( "( (m.nPast_QTY + nRcv_HPA_QTY +5 ) * 1.2 "+ALLTRIM(STR(nS_QTY+5 * 1.2))+" < (nS_QTY+5) "+ALLTRIM(STR(nS_QTY+5)),32,"Pounds Math")
				ThisFormSet.Show_Recv_Order.lblOrder_QTY.BackColor = RGB(255,0,0)
				ThisFormSet.Show_Recv_Order.lblQTY_Diff.BackColor = RGB(255,0,0)
				lOrderItemDone = .F.
		CASE ( (m.nPast_LBS + nReceive_LBS + 5 ) > (nOrder_LBS+5) * 1.2 ) OR ( (m.nPast_LBS + nReceive_LBS +5 ) * 1.2 < (nOrder_LBS+5) )
			cMess = "Receive DID NOT complete expected LBS  --or within 20%"+CHR(13)
			cMess = cMess+"Recv LBS: "+ALLTRIM(STR((m.nPast_LBS + nReceive_LBS + 5 )))+" > "+ALLTRIM(STR((nS_QTY+5) * 1.2 ))+" expected *1.2"+CHR(13)
			cMess = cMess+"Recv LBS*1.2: "+ALLTRIM(STR((m.nPast_LBS + nReceive_LBS + 5 )*1.2))+" > "+ALLTRIM(STR(((m.nPast_LBS + nReceive_LBS +5 ) * 1.2)))+" expected "+CHR(13)
			MESSAGEBOX(cMess,32,"LBS Math")
		
		*	MESSAGEBOX( "(m.nPast_LBS + nReceive_LBS + 5) "+ALLTRIM(STR(m.nPast_LBS + nReceive_LBS + 5))+" > ((nOrder_LBS+5) * 1.2 "+ALLTRIM(STR(((nOrder_LBS+5) * 1.2))),32,"QTY Math")
		*	MESSAGEBOX( "(m.nPast_LBS + nReceive_LBS + 5 ) * 1.2 "+ALLTRIM(STR((m.nPast_LBS + nReceive_LBS +5 ) * 1.2))+" < (nOrder_LBS+5) "+ALLTRIM(STR((nOrder_LBS+5))),32,"Pounds Math")
		
				ThisFormSet.Show_Recv_Order.lblOrder_QTY.BackColor = RGB(255,0,0)
				ThisFormSet.Show_Recv_Order.lblQTY_Diff.BackColor = RGB(255,0,0)
				lOrderItemDone = .F.
		OTHERWISE
				lOrderItemDone = .T.
		ENDCASE
		
		*Show Red if need more than 20% 
		
			*240,240,240
			ThisFormSet.Show_Recv_Order.lblPounds.BackColor = RGB(255,0,0)
		
		
		***************************
		*Check for Complete	(WOD and POitem)
		
		PRIVATE nCNT
		IF nWO_Detail > 0
			*Read WorkOrder_Detail
			
			IF Count_WODinWO_Detail( nWO_Detail, ThisFormSet.nConnhandle, "CANCELLED" ) > 0
				cMess = "This WO_Detail '"+ALLTRIM(STR(nWO_Detail))+"' is listed as 'Cancelled' in dbo.WorkOrder_Detail."
				MESSAGEBOX(cMess,32,"Why Receive a Cancelled WO_Detail?")
				cMess = cMess+CHR(13)+"ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID ))
				TrackError(cMess,"Should not have a receive!", PROGRAM(), LINENO(1))
			ENDIF
			
			IF Count_WODinWO_Detail( nWO_Detail, ThisFormSet.nConnhandle, "COMPLETE" ) > 0
				ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
				
				IF ThisFormSet.nReceivingID  = 0
					*New Receive, not an Edit!
					cMess = "This WO_Detail '"+ALLTRIM(STR(nWO_Detail))+"' is listed as 'Complete' in dbo.WorkOrder_Detail."
					MESSAGEBOX(cMess,32,"Why Receive a Complete WO_Detail?")
					cMess = cMess+CHR(13)+"ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID ))
					TrackError(cMess,"Should not have a NEW receive!", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
			ENDIF
		ELSE
			*Read PurchaseOrder
			
			IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "CANCELLED" ) > 0
				cMess = "This POitem '"+cPOitem+"' is listed as 'Cancelled' in dbo.PurchaseOrder."
				MESSAGEBOX(cMess,32,"Why Receive a Cancelled Poitem?")
				cMess = cMess+CHR(13)+"ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID ))
				TrackError(cMess,"Should not have a receive!", PROGRAM(), LINENO(1))
			ENDIF
			
		*	IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "DELIVERED" ) > 0
		*		*Reconciled - TOO general, each receive will be reconciled
		*	ENDIF
			IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "COMPLETE" ) > 0
				ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
				
				IF ThisFormSet.nReceivingID  = 0
					*New Receive, not an Edit!
					cMess = "This POitem '"+cPOitem+"' is listed as 'Complete' in dbo.PurchaseOrder."
					MESSAGEBOX(cMess,32,"Why Receive a Complete Poitem?")
					cMess = cMess+CHR(13)+"Edit ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID ))
					TrackError(cMess,"Should not have a NEW receive!", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
			ENDIF
		ENDIF
		
		IF lOrderItemDone
			*Look for "INCOMING" process
			IF nWO_Detail > 0
				*Look for "INCOMING" process on WO_Detail
				nCNT = StockLst_Process_Count_WOD( nWO_Detail, 'S', ThisFormSet.nConnhandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" is Complete in dbo.WorkOrder_Detail, but has a StockLst 'INCOMING'.")
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_WOD( nWO_Detail, 'B', ThisFormSet.nConnhandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" is Complete in dbo.WorkOrder_Detail, but has a BrokerLst 'INCOMING'.")
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_WOD( nWO_Detail, 'W', ThisFormSet.nConnhandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" is Complete in dbo.WorkOrder_Detail, but has a WIPLst 'INCOMING'.")
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
				ENDIF
			ELSE
				*Look for "INCOMING" process on POitem
				nCNT = StockLst_Process_Count_POitem( cPOitem, 'S', ThisFormSet.nConnhandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' is Complete in PurchaseOrder, but has a StockLst 'INCOMING'.")
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_POitem( cPOitem, 'B', ThisFormSet.nConnhandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' is Complete in PurchaseOrder, but has a BrokerLst 'INCOMING'.")
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_POitem( cPOitem, 'W', ThisFormSet.nConnhandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' is Complete in PurchaseOrder, but has a WIPLst 'INCOMING'.")
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
				ENDIF
			ENDIF
		ENDIF
		
		*Compare with Receiving totals
		IF nWO_Detail > 0
			*Compare with Receiving totals
			IF lOrderItemDone
				IF ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
					*Good
				ELSE
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" dbo.WorkOrder_Detail Calculations predict done, but marked as NOT Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID )))
				ENDIF
			ELSE
				IF ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" dbo.WorkOrder_Detail Calculations predict NOT done, but marked as Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID )))
				ELSE
					*Good
				ENDIF
			ENDIF
			
		ELSE
			*Compare with Receiving totals
			IF lOrderItemDone
				IF ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
					*Good
				ELSE
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' dbo.Receive Calculations predict done, but marked as NOT Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID )))
				ENDIF
			ELSE
				IF ThisFormSet.Show_Recv_OrderogPOitem.Value = 1
					ThisFormSet.Show_Recv_OrderogPOitem.Value = 2
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' dbo.Receive Calculations predict NOT done, but marked as Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisFormSet.nReceivingID )))
				ELSE
					*Good
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE insert_incomproc
		*ThisFormSet.Insert_IncomProc()
		*Show_Recv_Order
		
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisFormSet.nReceivingID ,'ReceivingID',-3)
		
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		
		PRIVATE nQTY, nPounds, cPrc_Form, nPrc_PCs 
		nQTY = PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtQTY_Need.Value,'QTY',-5)
		
		nPounds = PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPast_LBS.Value,'Pounds',-3)
		cPrc_Form = PrepareSQLtxt(ThisFormSet.Show_Recv_Order.txtForm.Value,'Form',2)
		nPrc_PCs = PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Need.Value,'PC',-3)
		
		
		cSQL = " INSERT INTO "
		DO CASE
		CASE ThisFormSet.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisFormSet.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisFormSet.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		ENDCASE
		*cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
		
		cSQL = cSQL + " WHERE ReceivingID = "+STR(nReceivingID)
		cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
		*!*		RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		*!*	ELSE
			TrackError("Why would you want this to run? "+CHR(13)+"ThisFormSet.Insert_IncomProc()"+CHR(13)+cSQL ,"Why would you want this to run?", PROGRAM(), LINENO(1))
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisFormSet.nConnhandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnhandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE look4_recvid
		*ThisFormSet.Look4_RecvID()
		*Receive_Edit
		
		PRIVATE nRID
		nRID = PrepareSQLnum(ThisFormSet.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nRID > 0
			*ThisRoutine was to look 4 an ReceivingID that already exists, import if Found
			RETURN 
		ENDIF
		
		PRIVATE cHeat, cLot
		cHeat = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtHeat.Value,'Heat',50)
		cLot  = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtLot.Value,'Lot',10)
		
		PRIVATE nWO_Detail
		nWO_Detail	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtSOItem.Value,'SOitem',2,0)
		IF nSalesNum > 0 AND nItemSo > 0
			cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
		ELSE
			cSOitem		= Proper_SO_item('')
		ENDIF
		
		PRIVATE cPOitem, nHpaPo, nItemPo  
		nHpaPo  = PrepareSQLnum(ThisFormSet.Receive_Edit.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisFormSet.Receive_Edit.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nHpaPo > 0 AND nItemPo > 0
			cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		ELSE
			cPOitem		=  Proper_PO_item('')
		ENDIF
		
		PRIVATE lHave_POi, lHave_SOi, lHave WOD
		lHave_POi = IIF(cPOitem <> Proper_PO_item(''), .T. ,.F.)
		lHave_SOi = IIF(cSOitem <> Proper_SO_item(''), .T. ,.F.)
		lHave_WOD = IIF(nWO_Detail > 0, .T. ,.F.)
		
		PRIVATE cMess, nMess
		cMess = "Found a Previously saved Receiving Record"+CHR(13)
		nMess = 0
		
		PRIVATE cSQL, cSQL2, nSQLEXEC 
		* pcWhat = "S_Process"  pcWhat = "B_Process"   pcWhat = "W_Process"
		IF USED("cntReceiving2")
			USE IN cntReceiving2
		ENDIF
		
		cSQL = "SELECT ID, Heat, Lot, POitem, SOitem, WO_Detail "
		cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		
		DO CASE
		CASE lHave_POi AND lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL2 = cSQL2 + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL2 = cSQL2 + " AND WO_Detail = "+STR(nWO_Detail)
		CASE lHave_POi AND NOT lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			
		CASE lHave_POi AND NOT lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL2 = cSQL2 + " AND WO_Detail = "+STR(nWO_Detail)
			
		CASE lHave_POi AND lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL2 = cSQL2 + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
		CASE NOT lHave_POi AND lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL2 = cSQL2 + " AND WO_Detail = "+STR(nWO_Detail)
			
		CASE NOT lHave_POi AND lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		CASE NOT lHave_POi AND NOT lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE WO_Detail = "+STR(nWO_Detail)
				
		CASE NOT lHave_POi AND NOT lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE 0<>0 "
		ENDCASE
		
		
		cSQL = cSQL + cSQL2 + " AND ISNULL(Cancelled,0) = 0 "+CHR(13)+" ORDER BY ID_Detail DESC"
		
		
		SELECT 0  
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntReceiving2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'cntReceiving2')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntReceiving2")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "cntReceiving2")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'cntReceiving2')
			RETURN
		ENDIF
		IF USED('cntReceiving2')
			IF RECCOUNT('cntReceiving2') > 0
				
				*CHOOSE ReceivingID Details if same heat, Lot
				PRIVATE nReceivingID, nRecCount, nCurrRec, lDiffHeat, lDiffLot, nRID 
				nRecCount = RECCOUNT('cntReceiving2')
				lDiffHeat = .T.
				lDiffLot = .T.
				
				SCAN
					nReceivingID = 0
					nMess = 0
					nRID = PrepareSQLnum(cntReceiving2.ID,'RID',-3)
					
					nCurrRec = RECNO('cntReceiving2')
					
					IF VARTYPE(cntReceiving2.Heat)="C"
						cHeat = ALLTRIM(ShowSQLtxt(cntReceiving2.Heat,'Hest',50))
					ENDIF
					cHeatCurr = ALLTRIM(ShowSQLtxt(cHeat,'Heat',50))
					
					
					cMess = cMess + cSQL2 +CHR(13)+CHR(13)+"Do you want to see this Receiving Record?"
					IF LEN(cHeat) > 0
						cMess = cMess + CHR(13)+"with Heat of "+cHeat+CHR(13)+"your heat is "+cHeatCurr+CHR(13)
					ENDIF
					
					cMess = cMess + "Receiving ID = "+ALLTRIM(STR(nRID))+" "+ CHR(13)
					
					IF nRecCount > 1
						cMess = cMess + CHR(13)+"Record "+ALLTRIM(STR(nCurrRec))+" of "+ALLTRIM(STR(nRecCount))
					ENDIF
					
					nMess = MESSAGEBOX(cMess,0,"See This Receiving Record?")
					IF nMess = 6
						IF lHave_POi
							IF cPOitem = PrepareSQLtxt(cntReceiving2.POitem,'POitem',12) 
								DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, "" TO nReceivingID
								*Returns ReceivingID , 0 if Create new, OR -ID_Detail
								nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
							ENDIF
						ENDIF
		*				IF nReceivingID < 1
		*					IF lHave_SOi
		*						IF cSOitem = PrepareSQLtxt(cntReceiving2.SOitem,'SOitem',10) 
		*							DO FORM Forms\ChooseReceivingDetails WITH cSOitem, cHeat, "" TO nReceivingID
		*							nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		*						ENDIF
		*					ENDIF
		*				ENDIF
						IF nReceivingID < 1
							IF lHave_WOD
								IF nWO_Detail = PrepareSQLnum(cntReceiving2.WO_Detail,'WO_Detail',-3) 
									DO FORM Forms\ChooseReceivingDetails WITH nWO_Detail, cHeat, "" TO nReceivingID
									nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					
					IF nReceivingID > 0
						EXIT
					ENDIF
					
				ENDSCAN
				
		*!*			IF LEN(cHeatCurr) > 1 AND LEN(cHeat) > 1
		*!*				IF NOT cHeatCurr $ cHeat
		*!*					lDiffHeat = .T.
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			IF lDiffHeat
		*!*				IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		*!*					IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
		*!*						cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
		*!*					ENDIF
		*!*				ENDIF
		*!*				IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		*!*					DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, "" TO nReceivingID
		*!*					nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		*!*					IF TYPE("nReceivingID")="N"
		*!*						IF nReceivingID > 0
		*!*							*ThisFormSet.Receive_Edit.ReceivingID = nReceivingID
		*!*							
		*!*							ThisFormSet.Receive_Edit.txtReceivingID.Value = nReceivingID
		*!*							ThisFormSet.Receive_Edit.txtReceivingID.refresh
		*!*							
		*!*							IF USED("tmpReceivingPOi")
		*!*								USE IN tmpReceivingPOi
		*!*							ENDIF
		
		*!*							cSQL = "SELECT * "
		*!*							cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		*!*							cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		*!*							
		*!*							
		*!*							SELECT 0  
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOi')
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOi')
		*!*							ENDDO
		*!*							IF nSQLEXEC < 0 &&Try again!
		*!*								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOi")
		*!*								DO WHILE nSQLEXEC = 0
		*!*									WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOi")
		*!*									
		*!*									IF nSQLEXEC < 0
		*!*										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*											nSQLEXEC = 0
		*!*										ENDIF
		*!*									ENDIF
		*!*								ENDDO
		*!*							ENDIF 
		*!*							IF nSQLEXEC < 0
		*!*								SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceivingPOi')
		*!*								RETURN
		*!*							ENDIF
		*!*							IF USED('tmpReceivingPOi')
		*!*								ThisFormSet.Receive_Edit.txtHeat.Value		= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Heat,'Heat',50,.F.,.T.))
		*!*								ThisFormSet.Receive_Edit.txtLot.Value		= PrepareSQLtxt(tmpReceivingPOi.Lot,'Lot',10)
		*!*								ThisFormSet.Receive_Edit.chkCert.Value		= PrepareSQLchk(tmpReceivingPOi.Cert,'Cert')
		*!*								ThisFormSet.Receive_Edit.txtPieces.Value	= PrepareSQLnum(tmpReceivingPOi.Pieces,'Pieces',-3)
		*!*								ThisFormSet.Receive_Edit.edtDescription.Value = ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Description,'Descript',-1,.F.,.T.))
		*!*								ThisFormSet.Receive_Edit.edtSpecs.Value		= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Specs,'Specs',160))
		*!*								ThisFormSet.Receive_Edit.edtComments.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Comments,'Receipt',-1))
		*!*								ThisFormSet.Receive_Edit.txtInit.Value		= ShowSQLtxt(tmpReceivingPOi.Init,'INIT',10)
		*!*								ThisFormSet.Receive_Edit.txtDate.Value		= ShowSQLdate(tmpReceivingPOi.Date,'Date')
		*!*								ThisFormSet.Receive_Edit.chkPass.Value		= PrepareSQLchk(tmpReceivingPOi.Pass,'Pass')
		*!*								ThisFormSet.Receive_Edit.chkGoodPapers.Value	= PrepareSQLchk(tmpReceivingPOi.GoodPapers,'GoodPapers')
		*!*								
		*!*								ThisFormSet.Receive_Edit.txtActualW.Value	= PrepareSQLnum(tmpReceivingPOi.ActualW,'Weight',9,1)
		*!*								ThisFormSet.Receive_Edit.txtBillW.Value		= PrepareSQLnum(tmpReceivingPOi.BillW,'Weight',9,1)
		*!*								
		*!*								ThisFormSet.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpReceivingPOi.R_QTY,'S_QTY',-5)
		*!*								PRIVATE nAcct_PU 
		*!*								nAcct_PU = PrepareSQLnum(tmpReceivingPOi.R_PU,'S_PU',-1)
		*!*								ThisFormSet.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
		*!*								ThisFormSet.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		*!*								ThisFormSet.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		*!*	*						
		*!*								PRIVATE nVend_PU 
		*!*								nVend_PU = PrepareSQLnum(tmpReceivingPOi.PO_PU,'PO_PU',-1)
		*!*								IF nVend_PU > 0
		*!*									ThisFormSet.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOi.PO_QTY,'PO_QTY',-5)
		*!*									ThisFormSet.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOi.PO_P,'PO_P',-5)
		*!*									
		*!*									ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
		*!*									ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
		*!*									ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
		*!*								ELSE
		*!*									*Old Receive - Get by POitem
		*!*									IF Proper_PO_Item(ThisFormSet.cPOitem) <> Proper_PO_Item("")
		*!*										nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
		*!*										ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
		*!*										ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
		*!*										ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
		*!*										
		*!*										PRIVATE nVend_QTY, nVend_P
		*!*										nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisFormSet.nConnhandle)
		*!*										nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
		*!*										ThisFormSet.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
		*!*										ThisFormSet.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
		
		*!*									ELSE
		*!*										ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',2)
		*!*										ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( 1, ThisFormSet.nConnhandle)
		*!*										ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisFormSet.nConnhandle)
		*!*									ENDIF								
		*!*								ENDIF
		*!*								
		*!*								ThisFormSet.Receive_Edit.txtVendor.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Vendor,'Vendor',30))
		*!*								ThisFormSet.Receive_Edit.txtRMA_No.Value	= PrepareSQLnum(tmpReceivingPOi.RMA_No,'RMA_No',-3)
		*!*								ThisFormSet.Receive_Edit.txtRMA_Detail.Value= PrepareSQLnum(tmpReceivingPOi.RMA_Detail,'RMA_Detail',-3)
		*!*								
		*!*								ThisFormSet.Receive_Edit.txtRejectPC.Value	= PrepareSQLnum(tmpReceivingPOi.RejectPC,'RejectPC',-3)
		*!*								ThisFormSet.Receive_Edit.txtRejectReason.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.RejectReason,'RejectReason',255))
		*!*								
		*!*								*ThisFormSet.Receive_Edit.txtAlloy.SetFocus()
		*!*								
		*!*								*USE IN tmpReceivingPOi
		*!*								
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
			ENDIF	
		ENDIF
		IF USED('cntReceiving2')
			USE IN cntReceiving2
		ENDIF	
			
	ENDPROC

	PROCEDURE lst_detail_clone
	ENDPROC

	PROCEDURE lst_detail_ins
		PARAMETERS nNewID
		*ThisFormSet.Lst_Detail_INS
		*Show_Recv_Order
		
		PRIVATE nPCS, nDim1, nPounds, nReceivingID, nQTY, nS_PU
		nPCS	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Recv.Value,'PC',-3)
		nDim1	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtThck.Value,'DIM1',10,4)
		nPounds	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtActualW.Value,'ActualW',9,1)
		nReceivingID = PrepareSQLnum(ThisFormSet.nReceivingID ,'ReceivingID',9,1)
		nQTY	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtThck.Value,'DIM1',10,4)
		nS_PU	= nPU_Acct_Form(PrepareSQLtxt(ThisFormSet.Show_Recv_Order.txtForm.Value,'Form',2),ThisFormSet.nConnhandle)
		
		
		PRIVATE nNewID_Detail 
		nNewID_Detail = 0
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Detail_INS "
		cSQL = cSQL + " @TBL='"+ThisFormSet.cTBL+"'"
		*	@size_h		decimal(9, 4),
		*	@size_l		decimal(9, 4),
		cSQL = cSQL + ",@pc	= "+STR(nPCS)
		cSQL = cSQL + ",@dim1 = "+STR(		18, 4)
		*	@dim2		decimal(18, 4),
		*	@dim3		decimal(18, 4),
		*	@length		varchar(160),
		cSQL = cSQL + ",@weight = "+STR(	9,1)
		
		*	@descript	varchar(20),
		*	@location	varchar(10),
		*	@floorstatus	char(1),
		*	@class		char(1),
		*	@RandLen	BIT,
		cSQL = cSQL + ",@ID="+STR(nNewID)
		*	@ID_Detail_Process int,
		cSQL = cSQL + ",@ReceivingID= "+STR(nReceivingID)
		cSQL = cSQL + ",@S_QTY="+STR(nQTY,18,4)
		*	@S_P		decimal(18, 4),
		*	@S_TOTAL
		cSQL = cSQL + ",@S_PU = "+STR(nS_PU)
			
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"p_Lst_Detail_Clone Failed",PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		*************************************
		*"EXEC dbo.p_Lst_Detail_INS " can create 3 Tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID_Detail2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
		*		MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail2))+" in TBL='"+ThisFormSet.cTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID_Detail1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID_Detail2 = 0
		*			MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail1))+" in TBL='"+ThisFormSet.cTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID_Detail = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
			ELSE
				IF nNewID_Detail2 =0 AND nNewID_Detail1 = 0
		*			MESSAGEBOX("Could not Create new Detail Stock record",16,"Error")
				ENDIF
				*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID"+CHR(13)+cSQL) 
				TrackError("Could not Create new Detail Stock record "+CHR(13)+"TBL "+ThisFormSet.cTBL+CHR(13)+"New ID= "+STR(nNewID)+CHR(13)+"New QTY "+STR(nQTY_Need),"Could not Create new Detail Stock record ", PROGRAM(), LINENO(1))
			ENDIF
			USE IN tmpNewID
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID","Detail Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID_Detail + nNewID_Detail1 + nNewID_Detail2 = 0
			MESSAGEBOX("Could not Inser/Create new DETAIL Stock record",16,"Error")
			TrackError("Could not Inser/Create new DETAIL Stock record "+CHR(13)+"TBL "+ThisFormSet.cTBL+CHR(13)+"ID= "+STR(nNew_ID)+CHR(13)+"New QTY "+STR(nQTY),"Could not Create new DETAIL Stock record ", PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID_Detail"+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID_Detail2 > 0
			RETURN nNewID_Detail2
		ENDIF
		IF nNewID_Detail1 > 0
			RETURN nNewID_Detail1
		ENDIF
		
		RETURN nNewID_Detail 
		
	ENDPROC

	PROCEDURE lst_master_clone
		PARAMETERS pcTBL,nOld_ID,nQTY_Rcv,cHeat,cLot
		*ThisFormSet.Lst_Master_Clone()
		* Show_Recv_Order 
		
		*p_Lst_Master_Clone RETURNS 3 Tables ?!?
		PRIVATE nNewID, nNewID1, nNewID2
		nNewID = 0
		nNewID1 = 0
		nNewID2 = 0
		
		nQTY_Rcv	= PrepareSQLnum(nQTY_Rcv,'QTY',-5)
		cHeat		= PrepareSQLtxt(cHeat,'Heat',50)
		cLot		= PrepareSQLtxt(cLot,'Lot',10)
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Master_Clone "
		cSQL = cSQL + "	@ID="+STR(nOld_ID)
		cSQL = cSQL + ",@TBL='"+pcTBL+"'"
		cSQL = cSQL + ",@mS_QTY="+STR(nQTY_Rcv)
		cSQL = cSQL + ",@Heat='"+cHeat+"'"
		cSQL = cSQL + ",@Lot='"+cLot+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			TrackError("SQL Transaction will be Rolled Back"+CHR(13)+CHR(13)+cSQL,"Could not save!",PROGRAM(),LINENO(1))
			RETURN 0
		ENDIF
		
		*************************************
		*XEC dbo.p_Lst_Master_Clone2 can create 3 tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
				*MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID2))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID2  = 0
				*	MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID1))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
				IF nNewID2 = 0 AND nNewID1 = 0
				*	MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID + nNewID1 + nNewID2 = 0
			MESSAGEBOX("Could not Create new MASTER Stock record",16,"Error")
			TrackError("Could not Create new MASTER Stock record "+CHR(13)+"TBL "+pcTBL+CHR(13)+"ID= "+STR(nOld_ID)+CHR(13)+"Recv QTY "+STR(nQTY_Rcv),"Could not Create new MASTER Stock record ", PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID"+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID2 > 0
			RETURN nNewID2
		ENDIF
		IF nNewID1 > 0
			RETURN nNewID1
		ENDIF
		*ELSE
		RETURN nNewID 
		
	ENDPROC

	PROCEDURE markasrmareceived
		PARAMETERS pnReceivingID
		*ThisFormSet.MarkAsRMAreceived(nReceivingID)
		*Receive_Edit
		
		PRIVATE cSQL, nSQLEXEC, nRMA_Detail, nReceivingID
		nRMA_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
		nReceivingID = PrepareSQLnum(pnReceivingID,'ReceivingID',-3)
		
		IF nRMA_Detail > 0
			*Update RMA_Detail with Date
			
			PRIVATE dReceived
			dReceived = PrepareSQLdate(ThisFormset.Receive_Edit.txtReceived.Value,'Received')
			IF NOT EMPTY(dReceived)
				cSQL= "UPDATE dbo.RMA_Detail SET "
				cSQL= cSQL+" Returned ='"+DTOC(dReceived)+"'"
				cSQL= cSQL+",ReceivingID = "+STR(nReceivingID)
				cSQL= cSQL+" WHERE RMA_Detail_ID = "+STR(nRMA_Detail)
				cSQL= cSQL+" AND ISNULL(ReceivingID,0)=0 "
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update. "+CHR(13)+cSQL )
				ENDIF
			ENDIF	
			
			PRIVATE nID_Master, nID_Detail, nID_Detail_Process
			nID_Master	= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
			nID_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
			nID_Detail_Process = PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
			
			cForm = PrepareSQLtxt(ThisFormset.Receive_Edit.txtForm.Value,'Form',2)
			
			cSQL  = ''
			IF nID_Master >0 AND nID_Detail > 0 && AND nID_Detail_Process >0
				*Update Sales_Stock with the Stock Master and Detail IDs
				IF ThisFormSet.RMA_SS_ID > 0	
					cSQL = "UPDATE dbo.Sales_Stock SET "
					cSQL= cSQL+" StkBack = 1"
					cSQL= cSQL+", StockLst_ID = "+STR(nID_Master)
					cSQL= cSQL+", StockLst_ID_Detail = "+STR(nID_Detail)
					cSQL= cSQL+", RMA_Detail_ID="+STR(nRMA_Detail)
					cSQL= cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
					cSQL= cSQL+" WHERE ID = "+STR(ThisFormSet.RMA_SS_ID)
				ELSE
					*Try to Update by an existing RMA entry
					cSQL = "UPDATE dbo.Sales_Stock SET "
					cSQL = cSQL+" StkBack = 1"
					cSQL = cSQL+", StockLst_ID = "+STR(nID_Master)
					cSQL = cSQL+", StockLst_ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
					cSQL = cSQL+" WHERE RMA_Detail_ID="+STR(nRMA_Detail)
				ENDIF
			ELSE
				*Update without Stock IDs
				IF ThisFormSet.RMA_SS_ID > 0	
					cSQL = "UPDATE dbo.Sales_Stock SET "
					cSQL= cSQL+" StkBack = 1"
					cSQL= cSQL+",RMA_Detail_ID="+STR(nRMA_Detail)
					cSQL= cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
					cSQL= cSQL+" WHERE ID = "+STR(ThisFormSet.RMA_SS_ID)
					
				ELSE
					*Try to Update by an existing RMA entry
					cSQL = "UPDATE dbo.Sales_Stock SET "
					cSQL = cSQL+" StkBack = 1"
					cSQL = cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
					cSQL = cSQL+",StockLst_ID = "+STR(nID_Master)
					cSQL = cSQL+",StockLst_ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL+" WHERE RMA_Detail_ID="+STR(nRMA_Detail)
				ENDIF
			ENDIF
			
			IF LEN(cSQL) > 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update. "+CHR(13)+cSQL )
				ENDIF
			ELSE
				MESSAGEBOX("Did not get full details"+CHR(13)+STR(nID_Master)+" ID_Master"+CHR(13)+STR(nID_Detail)+" ID_Detail"+CHR(13)+STR(nID_Detail_Process)+" ID_Detail_Process",64,"RMA _Detail not Saved")
			ENDIF
			
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE marksoitemcomplete
		PARAMETERS lComplete
		*ThisFormSet.MarkSOitemComplete(.T.)
		*Show_Recv_Order
		
		*nCnt = Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle, "DELIVERED" )
		PRIVATE cPOItem
		cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
		IF cPOitem = Proper_PO_item("")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, cMess
		
		IF lComplete
			cSQL = "UPDATE dbo.PurchaseOrder "
			cSQL = cSQL+" SET Delivered = 1 "
			cSQL = cSQL+" ,[Cmplt] = 1"
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOItem+"')"
			cMess = "POitem '"+cPOItem+"' was set to COMPLETE on Show Received VS Ordered screen."
		ELSE
			cSQL = "UPDATE dbo.PurchaseOrder SET [Cmplt] = 0 "
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOItem+"')"
			cMess = "POitem '"+cPOItem+"' was set to NOT COMPLETE on Show Received VS Ordered screen."
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			RETURN .F.
		ENDIF
		
		***************************************
		TrackMess(cMess)
		
		***************************************
		cSQL = "INSERT INTO dbo.PO_Item_Notes "
		cSQL = cSQL+ " ([POitem],[Notes]) VALUES ("
		cSQL = cSQL+ "'"+cPOItem+"','"+PrepareSQLtxt(cMess,'mess',-1)+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			*RETURN .F.
		ENDIF
		
		RETURN .T.
		
		
	ENDPROC

