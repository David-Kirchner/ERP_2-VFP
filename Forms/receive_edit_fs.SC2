						ThisFormset.Receive_Edit.txtActualW.Value	= PrepareSQLnum(tmpPO_Process.Weight,'Weight',9,1)
						ThisFormset.Receive_Edit.txtBillW.Value		= PrepareSQLnum(tmpPO_Process.Weight,'Weight',9,1)
						
						ThisFormset.Receive_Edit.txtAcct_Qty.Value		= PrepareSQLnum(tmpPO_Process.S_QTY,'S_QTY',-5)
						ThisFormset.Receive_Edit.txtAcct_P.Value		= PrepareSQLnum(tmpPO_Process.S_P,'S_P',-5)
						
						PRIVATE nAcct_PU 
						nAcct_PU = PrepareSQLnum(tmpPO_Process.S_PU,'S_PU',-1)			
						ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
						ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
						ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		*	
						ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpPO_Process.Order_QTY,'PO_QTY',-5)
						ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpPO_Process.Order_P,'Order_P',-5)
		*						
						PRIVATE nCust_PU 
						nCust_PU = PrepareSQLnum(tmpPO_Process.Order_PU,'Order_PU',-1)
						ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
						ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)	&&Customer PU
						ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
						
						
						*ThisFormset.Receive_Edit.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisFormSet.nConnhandle ) 
						*ThisFormset.Receive_Edit.txtVendor.Value = PrepareSQLtxt(tmpReceivingPOitem.Vendor,'Vendor',30,.F.,.T.)
						ThisFormset.Receive_Edit.txtVendor.Value	= ''   &&Company is filled in with the next PurchaseOrder Select
						
						*ThisFormset.Receive_Edit.txtRejectPC.Value		= tmpPO_Process.RejectPC
						ThisFormset.Receive_Edit.txtRejectPC.Value		= 0
						
						*ThisFormset.Receive_Edit.txtRejectReason.Value	= tmpPO_Process.RejectReason
						ThisFormset.Receive_Edit.txtRejectReason.Value	= ''
						
						*ThisFormset.Receive_Edit.txtRMA_No.Value		= tmpPO_Process.RMA_No
						ThisFormset.Receive_Edit.txtRMA_No.Value		= 0
						ThisFormset.Receive_Edit.txtRMA_Detail.Value	= 0
		
						ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(0,'Services')
						ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
						ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
						
						*ThisFormset.Receive_Edit.StockLst_TBL		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
						
						EXIT  &&SCAN
