	PROCEDURE abortthisreceive		&& Called from SaveAdd after first inserted
		PARAMETERS nReceivingID
		*ThisFormSet.AbortThisReceive(nReceivingID)
		
		PRIVATE nMess, cMess
		cMess = "You are out of the"+CHR(13)+" Show Received_VS Ordered screen"+CHR(13)+CHR(13)
		cMess = cMess + "Do you now want to DELETE This Receiving ID ("+ALLTRIM(STR(nReceivingID))+") ?"
		nMess = MESSAGEBOX(cMess,4,"Do you want to DELETE?")
		
		IF nMess = 6
			cSQL = "DELETE dbo.Receiving WHERE ID="+STR(nReceivingID)
							
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
				TrackError(" Abort this receive. "+CHR(13)+cSQL ,"bad delete",PROGRAM(),LINENO(1))
			ELSE
				MESSAGEBOX("This screen still shows the Receive data."+CHR(13)+"This Receive number has been DELETED from the dbo.Receive table.",0+48,"Reveresed the Save")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE alert_acct
		*Alert_Acct
		PRIVATE lOK
		lOK = .T.
		
		
		RETURN lOK
	ENDPROC

	PROCEDURE alert_receive_email
		PARAMETERS cWhat,xOrderNumber,nReceivingID
		*ThisFormSert.Alert_Receive_Email()  
		*uses Alert_Receive() to see if needed.
		*ThisFormset.Receive_Edit
		
		PRIVATE cMess, lReturnURL, pcEmailTo, pcEmailSubject
		lReturnURL = .T.
		pcEmailSubject = ''
		*HTML_SOitem HTML_SO 	HTML_POitem HTML_PO 	HTML_WO HTML_WO_Detail 
		*HTML_ProjID HTML_GFM_Log HTML_PackingSlipNo
		*--HTML_RA
		*--HTML_RA_Detail
		*--HTML_Receiving
		
		PRIVATE nOrderNumber, cOrderNumber
		DO CASE
		CASE VARTYPE(xOrderNumber) = "C"
			cOrderNumber = xOrderNumber
			nOrderNumber = VAL(xOrderNumber)
		CASE VARTYPE(xOrderNumber) = "N"
			cOrderNumber = ALLTRIM(STR(xOrderNumber))
			nOrderNumber = xOrderNumber
		CASE VARTYPE(xOrderNumber) = "Y"
			cOrderNumber = ALLTRIM(STR(xOrderNumber))
			nOrderNumber = xOrderNumber
		OTHERWISE
			cOrderNumber = ''
			nOrderNumber = 0
			TrackError("Bad xOrderNumber VarType","xOrderNumber VarType was not programmed. '"+VARTYPE(xOrderNumber)+"' cWhat='"+cWhat+"'",PROGRAM(),LINENO(1))
		ENDCASE
		
		PRIVATE lPass,lGoodPapers,lHold
		lPass		= PrepareSQLlogic(ThisFormset.Receive_EditchkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLlogic(ThisFormset.Receive_EditchkGoodPapers.Value,'GoodPapers')
		lHold		= PrepareSQLlogic(ThisFormset.Receive_EditchkHold.Value,'Hold')
		
		*pcEmailTo = "David.Kirchner@SpaceAlloysUSA.com"
		*pcEmailTo = "David.Kirchner@Windfall.HPA.local"
		pcEmailTo = ""
		
		PRIVATE cSalesP, cUserName, cEmail
		cSalesP	= ''
		cUserName = ''
		cEmail	= ''
		PRIVATE lSendThisEmail 
		lSendThisEmail = .F.
		
		PRIVATE lOK
		lOK = .F.
		
		DO CASE
		CASE cWhat = "POitem"
			PRIVATE lMETAL, lServices, lConvServ, lEquipment 
			lMETAL = Count_POIteminPurchaseOrder( cOrderNumber, ThisFormSet.nConnhandle, "METAL" ) > 0
			lServices = Count_POIteminPurchaseOrder( cOrderNumber, ThisFormSet.nConnhandle, "SERVICES" ) > 0
			lConvServ = Count_POIteminPurchaseOrder( cOrderNumber, ThisFormSet.nConnhandle, "CONVSERV" ) > 0
			lEquipment = Count_POIteminPurchaseOrder( cOrderNumber, ThisFormSet.nConnhandle, "EQUIPMENT" ) > 0
			
			cMess = "Hey, good news, Purchase Order Item '"+cOrderNumber+"' has just been received in"
			IF lMETAL 
				cMess = cMess + " Metal for Stock."
			ENDIF
			IF lServices 
				cMess = cMess + ", QA Lab Service."
			ENDIF
			IF lConvServ 
				cMess = cMess + ", a Conversion Service."
			ENDIF
			IF lEquipment 
				cMess = cMess + ", Equipment Purchase."
			ENDIF
			********************
			IF NOT lMETAL or lServices or lConvServ or lEquipment 
				cMess = cMess + " Not Stock."
			ENDIF
			********************
			IF lPass
				cMess = cMess + " Marked as Passed Specs."
			ELSE
				cMess = cMess + " Did NOT Pass Specs."
				cMess = cMess + " HPA App Marked as QA OnHold."
				*lHold = .T.
			ENDIF
			IF lGoodPapers
				cMess = cMess + " Marked as with Good Papers."
			ENDIF
			IF lHold
				cMess = cMess + " Marked as Generic OnHold."
			ENDIF
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			cMess = cMess + CHR(10)+CHR(13)+ get_Description("POitem",cOrderNumber,ThisFormSet.nConnhandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the Purchase Order Record, click here. "
			cMess = cMess + CHR(13) + HTML_POitem(cOrderNumber,lReturnURL)
			
			IF lHold
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(10)+CHR(13) + "To see or change the OnHold, click here. "
				cMess = cMess + CHR(10)+CHR(13) + "https://internal.highperformancealloys.com/onHoldPurchaseOrders"
			ENDIF
			***
			*Check for a SOitem
			PRIVATE cSOitem
			cSOItem = get_SOitem_from_POitem(cOrderNumber, ThisFormSet.nConnhandle)
			IF NOT Proper_SO_Item(cSOItem) = Proper_SO_Item("")
				* Sales Order Item '"+cOrderNumber+"'
				cMess = cMess + CHR(13) + "Found a SOitem that is tied to this PO item. "
				cMess = cMess + CHR(10)+CHR(13) + get_Description("SOitem",cSOItem,ThisFormSet.nConnhandle)
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(10)+CHR(13) + "To see the Sales Order, click here. "
				cMess = cMess + CHR(13) + HTML_SOitem(cSOItem,lReturnURL)
			ENDIF
			
			
			***
			cSalesP = getSalesP_POitem(cOrderNumber,ThisFormSet.nConnhandle)
			cUserName = ALLTRIM( AppSetup_Get_UserName(cSalesP) )
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("POitem",cOrderNumber,ThisFormSet.nConnhandle)
		
		CASE cWhat == "SOitem"
			*SalesPfromSO 
			cMess = "Hey, good news, the material for the Sales Order Item '"+cOrderNumber+"' has just been received in."
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			* Sales Order Item '"+cOrderNumber+"'
			cMess = cMess + CHR(10)+CHR(13) + get_Description("SOitem",cOrderNumber,ThisFormSet.nConnhandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the Sales Order Record, click here. "
			cMess = cMess + CHR(13) + HTML_SOitem(cOrderNumber,lReturnURL)
			
			* Customer Info by Sales Order Item '"+cOrderNumber+"'
			PRIVATE cSO_CustID
			cSO_CustID = CustID_SalesNum(VAL(cOrderNumber),ThisFormSet.nConnhandle)
			IF LEN(cSO_CustID) > 0
				cMess = cMess + CHR(10)+CHR(13) + "To see the Customer Info, click here. "
				*HTML_CompanyInfo 
				cMess = cMess + CHR(13) + HTML_CustomerInfo_ID(cSO_CustID,lReturnURL)
			ENDIF
		
			***
			*cSalesP = getSalesP_SO(nOrderNumber,ThisFormSet.nConnhandle)
			cSalesP = getFromQuotesSO(nOrderNumber,'SALESP',ThisFormSet.nConnhandle)
			cUserName = ALLTRIM( AppSetup_Get_UserName(cSalesP) )
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
		
			lSendThisEmail = Alert_Receive_Check("SOitem",cOrderNumber,ThisFormSet.nConnhandle)
			
		CASE cWhat = "SOitem_RMA"
		
			cMess = "Hey, the returned material from the Sales Order Item '"+cOrderNumber+"' has just been received in."
			**********
			MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			cMess = cMess + CHR(10)+CHR(13) + get_Description("SOitem",cOrderNumber,ThisFormSet.nConnhandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the Sales Order Record, click here. "
			cMess = cMess + CHR(13) + HTML_SOitem(cOrderNumber,lReturnURL)
				
			PRIVATE nRMA_No, nRMA_Detail
			nRMA_No		= PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_No.Value,'RMA_No',-3)
			nRMA_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_detail.Value,'RMA_Detail',-3)
		
			IF nRMA_No > 0
				cMess = cMess + CHR(13) + "On RMA "+ALLTRIM(STR(nRMA_no))+"."
				cMess = cMess + CHR(10)+CHR(13) + "To see the RMA Record, click here."
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(13) + HTML_RMA_No(nRMA_no,lReturnURL)
			ENDIF
			IF nRMA_Detail > 0
				cMess = cMess + CHR(13) + "On RMA_Detail "+ALLTRIM(STR(nRMA_Detail))+"."
				cMess = cMess + CHR(10)+CHR(13) + "To see the RMA Record, click here."
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(13) + HTML_RMA_Detail(nRMA_Detail,lReturnURL)
			ENDIF
			
			
			***
			cSalesP = getFromQuotesSO(nOrderNumber,'SALESP',ThisFormSet.nConnhandle)
			cUserName = ALLTRIM( AppSetup_Get_UserName(cSalesP) )
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("SOitem_RMA",ALLTRIM(STR(nRMA_Detail)),ThisFormSet.nConnhandle)
			
		CASE cWhat == "WO"
			cMess = "Hey, good news, the material for the WorkOrder '"+cOrderNumber+"' has just been received in."
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			cMess = cMess + CHR(10)+CHR(13) + get_Description("WO",nOrderNumber,ThisFormSet.nConnhandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the WorkOrder Record, click here."
			cMess = cMess + CHR(13) + HTML_WO(nOrderNumber,lReturnURL)
				
			***
			*cUserName = ALLTRIM( getSalesRep_WO(nOrderNumber,ThisFormSet.nConnhandle) )
			cUserName = "Charlie Kirchner"
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("WO",cOrderNumber,ThisFormSet.nConnhandle)
			
		CASE cWhat = "WO_Detail"
			cMess = "Hey, good news, the material for the WorkOrder Detail '"+cOrderNumber+"' has just been received in."
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			cMess = cMess + CHR(10)+CHR(13) + get_Description("WO_Detail",nOrderNumber,ThisFormSet.nConnhandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the WorkOrder Detail, click here."
			cMess = cMess + CHR(13) + HTML_WO(nReceivingID,lReturnURL)
			
			***
			*cUserName = ALLTRIM( getSalesRep_WOD(nOrderNumber,ThisFormSet.nConnhandle) )
			cUserName = "Charlie Kirchner"
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("WO_Detail",cOrderNumber,ThisFormSet.nConnhandle)
			
		ENDCASE
		
		IF nReceivingID>0
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13)+"To see the Receiving Record, click here."
			cMess = cMess + CHR(13) + HTML_ReceivingID(nReceivingID,lReturnURL)
		ENDIF
		cMess = cMess + CHR(10)+CHR(13) + "Receive_Edit.Alert_Receive_Email: " + pcEmailTo 
		cMess = cMess + CHR(13) + "Worker: " + SYS(0)
		* 10/9/2024 - Brandon - Is this a bug? should this set the version "type"?
		cMess = cMess + CHR(13) + Get_HPAVersion(.F.,"STABLE")
		*cMess = cMess + CHR(13) + Get_HPAVersion(.F.)
		
		PRIVATE cSQLServer 
		IF VARTYPE(gGlobalServer)="C"
			cSQLServer = gGlobalServer 
		ELSE
			RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),'gGlobalServer was not set!')
		 	cSQLServer = "Raptor"
		ENDIF
		
		PRIVATE pcEmailFrom,  lQuiet, lNoHeadder
		pcEmailFrom	= ""+cSQLServer+"@SpaceAlloysUSA.com"  &&--do not use SpaceAlloysUSA.com, server does not need a Google Account
		lQuiet 		= .F.
		lNoHeadder	= .F.
		
		lSendThisEmail = PrepareSQLlogic(lSendThisEmail,'SendThisEmail',.F.)
		IF lSendThisEmail AND LEN(cMess) > 1
			lOK = Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, cMess, ThisFormSet.nConnhandle, lQuiet, lNoHeadder)
		ELSE
			IF lSendThisEmail AND LEN(cMess) > 1
				lOK = Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, cMess, ThisFormSet.nConnhandle, lQuiet, lNoHeadder)
			ENDIF
		ENDIF
		
		IF lOK
			*lSentEmailMarked = Alert_Receive_Mark("WO_Detail",cOrderNumber,ThisFormSet.nConnhandle)
			Alert_Receive_Mark( cWhat, xOrderNumber, nReceivingID )
			IF LEN(cMess) > 1
				TrackMess(cMess)
			ENDIF
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE checkrma
		*ThisFormSet.CheckRMA() 
		*ThisFormset.Receive_Edit
		
		PRIVATE nRMA_Detail, nRMA, cHeat, cLot
		nRMA_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50)
		cLot	= PrepareSQLtxt(ThisFormset.Receive_Edit.txtLot.Value,'Lot',10)
		
		PRIVATE lOK 
		lOK = .T.
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		IF nRMA = 0
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				*No SOitem to compare with
				RETURN .T.
			ELSE
				
			ENDIF
		ENDIF
				
		PRIVATE cSQL, nSQLExec
		IF USED("tmpRMA")
			USE IN tmpRMA
		ENDIF
		
		PRIVATE cMess
		
		cSQL = "SELECT RD.SO_item "
		cSQL = cSQL + ",RMA.RMA_No, RD.RMA_Detail_ID"
		cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_NO "
		cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRMA')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRMA' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRMA' )
		ENDIF
		
		
		PRIVATE cMess,nMess,nOldRMA_Detail
		nOldRMA_Detail = 0
		
		IF USED('tmpRMA')
			IF RECCOUNT('tmpRMA') > 0
				*IF Proper_SO_item(tmpRMA.SO_item) <> Proper_SO_item('')
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					*have a SOitem to check Also
					SELECT tmpRMA
					LOCATE FOR SO_item = SO_item
					IF FOUND('tmpRMA')
						nOldRMA_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
						ThisFormset.Receive_Edit.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail',-3)
						IF nOldRMA_Detail = 0
							nMess = MESSAGEBOX("Do you want to try to import data?"+CHR(13)+"This will overwrite current data.",4+32,"Over Write?")
							IF nMess = 6
								ThisFormSet.Refresh_RMA_Detail()
							ENDIF
						ENDIF
					ELSE
					
						MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA.SO_item),16,"Does not Match")
						GO TOP			
					ENDIF
				ELSE
					IF RECCOUNT('tmpRMA') = 1
						ThisFormset.Receive_Edit.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail',-3)
						ThisFormSet.Refresh_RMA_Detail()
					ENDIF		
				ENDIF
			ELSE
				lOK = .F.
				MESSAGEBOX("This RMA is not Found!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem =",16,"Does not Exists")	
			ENDIF
			
			SELECT tmpRMA
		
		ELSE
			MESSAGEBOX("This RMA is not Found!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem =",16,"Does not Exists")	
			lOK = .F.
		ENDIF
		RETURN lOK
	ENDPROC

	PROCEDURE checksave
		*ThisFormSet.CheckSave()
		*ThisFormset.Receive_Edit
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		
		
		IF EMPTY(ThisFormset.Receive_EditedtDescription.Value)
			lReady2Save = .F.
			MESSAGEBOX( "No Valid Description", 0+32,"Cannot Save")
		ENDIF
		
		PRIVATE dReceived, dDate
		dReceived	= PrepareSQLdate(ThisFormset.Receive_Edit.txtReceived.Value,'Received')
		dDate		= PrepareSQLdate(ThisFormset.Receive_Edit.txtDate.Value,'Date')
		
		IF dReceived + 1000 < DATE() OR dReceived - 1000 > DATE()
			*Not within 1000 Days, Reset.
			dReceived = CTOD("  /  /  ")
		ENDIF
		
		
		IF dReceived = CTOD("  /  /  ")
			IF MESSAGEBOX( "Do you want to set today as Received date?", 4+32,"Date") = 6
				ThisFormset.Receive_Edit.txtReceived.Value = DATE()
				dReceived	= PrepareSQLdate(ThisFormset.Receive_Edit.txtReceived.Value,'Received')
			ELSE
				lReady2Save = .F.
				RETURN lReady2Save 
			ENDIF
		ENDIF
		
		
		*************
		PRIVATE nReceivingID
		*nReceivingID = Receive_Edit.txtReceivingID.Value
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		ThisFormSet.nReceivingID  = nReceivingID
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		PRIVATE cSOitem, nSalesNum, nItemSo, nWO, nWO_Detail
		PRIVATE nRMA,cAlloy,cHeat,cLot,cDescription
		
		nHpaPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		* NOTE cPOitem is not used on customers material like a SO is a Toll Service Order
		
		**********************
		ThisFormSet.cPOitem = cPOitem
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			lReady2Save = ThisFormSet.CheckSave_POitem()
		ENDIF
		
		**********************
		nWO_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail  > 0
			lReady2Save = ThisFormSet.CheckSave_WOD()
		ENDIF
		
		IF nHpaPo > 0 AND nWO_Detail = 0 AND lReady2Save 
			*Ignore if have WO_Detail
			IF is_Vendor_LabService(nHpaPo, ThisFormSet.nConnhandle)
			*	IF MESSAGEBOX("This PO "+ALLTRIM(STR(nHPApo))+" is for a Material Test Report."+CHR(13)+CHR(13)+"This is not the Vendor!"+CHR(13)+"Are you receiving to the right PO?"+CHR(13)+CHR(13)+"Do you still want to continue?",4+256+16,"Wrong PO") <> 6
			*		lReady2Save = .F.
			*	ENDIF
			ENDIF
		ENDIF
		
		**********************
		PRIVATE nAcct_P, nAcct_PU, nMax_P, nAcct_QTY
		nAcct_P = PrepareSQLnum(ThisFormset.Receive_Edit.txtAcct_P.Value,'S_P',-5)
		nAcct_PU= PrepareSQLnum(ThisFormset.Receive_Edit.lblAcct_PU.Caption,'PU',-1)
		nMax_P = 0
		*Check PU Limit
		nMax_P = get_Max_P_fromPU (nAcct_PU, ThisFormSet.nConnhandle)
		nAcct_QTY = PrepareSQLnum(ThisFormset.Receive_Edit.txtAcct_Qty.Value,'Acct_QTY',-5)
		
		PRIVATE cMess
		cMess=''
		
		IF nAcct_P >= nMax_P 
			cMess = "This Receive has a Acct Stand Price of "+STR(nAcct_P)+CHR(13)+"The set MAX limit is "+STR(nMax_P)
			
			MESSAGEBOX(cMess+CHR(13)+"This will send message to David",4+256+16,"Bad Pricing") 
			*lReady2Save = .F.
			cMess = cMess +CHR(13)+"ReceivingID = "+STR(nReceivingID)
			
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cMess = cMess +CHR(13)+"POitem = "+cPOitem
			ENDIF
			IF nWO_Detail  > 0
				cMess = cMess +CHR(13)+"WO_Detail = "+STR(nWO_Detail)
			ENDIF
			cMess = cMess+CHR(13)+"Acct_PU = "+STR(nAcct_PU)
			cMess = cMess+CHR(13)+"Acct_QTY = "+STR(nAcct_QTY)
			
			TrackError(cMess+CHR(13)+"User has no way to fix here!","S_P is over Max_P", PROGRAM(), LINENO(1))
			
			
		ENDIF
		
		**********************
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO		= PrepareSQLlogic(ThisFormset.Receive_Edit.chkServicesPO.VALUE,'ServicesPO',.F.)
		lConvServ		= PrepareSQLlogic(ThisFormset.Receive_Edit.chkConvServ.VALUE,'ConvServ',.f.)
		lEquipment		= PrepareSQLlogic(ThisFormset.Receive_Edit.chkEquipment.VALUE,'Equipment',.F.)
		
		**********************
		RETURN lReady2Save
	ENDPROC

	PROCEDURE checksave_poitem
		*ThisFormSet.CheckSave_POitem()
		
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		
		PRIVATE  nReceivingID
		*nReceivingID = Receive_Edit.txtReceivingID.Value
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		ThisFormSet.nReceivingID  = nReceivingID
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		PRIVATE cSOitem, nSalesNum, nItemSo, nWO, nWO_Detail
		PRIVATE nRMA,cAlloy,cHeat,cDescription
		
		nHpaPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		
		
		nSalesNum	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSONum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		ThisFormSet.cSOitem = cSOitem
		
		nWO			= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',30,.f.)
		cDescription= PrepareSQLtxt(ThisFormset.Receive_Edit.edtDescription.Value,'Description',-1,.F.)
		
		nRMA = PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_No.Value,'RMA',-3)
		
		*************************
		*Check Heat
		IF UPPER(cHeat) = "DUE IN"
			cHeat = ""	&&Do not check for Due In
		ENDIF
		IF LEN(cHeat)=0
			IF MESSAGEBOX("No Heat was Entered."+CHR(13)+CHR(13)+"If this is OK answer (Y)."+CHR(13)+CHR(13)+"If you want to go back"+CHR(13)+"and enter the Heat, answer(N)",16+4,"Continue...") != 6
				lReady2Save = .F.
			ENDIF
		ENDIF
		
		*************************
		*Check TBL
		
		PRIVATE nID_Master, nID_Detail, cTBL, cForm
		nID_Master	= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
		cTBL 		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtTBL.Value,'TBL',1)
		cForm 		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtForm.Value,'Form',2)
		
		PRIVATE cTBL_POi, cTBL_POi_P
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			cTBL_POi	= getTBL_POitem(cPOitem, ThisFormSet.nConnhandle ) 
			cTBL_POi_P	= getTBL_Process_POitem(cPOitem, ThisFormSet.nConnhandle ) 
		ELSE
			cTBL_POi	= ''
			cTBL_POi_P	= ''
		ENDIF
		
		PRIVATE cTBL_WO, cTBL_WOD
		IF nWO > 0
			cTBL_WO		= getTBL_WO(nWO, ThisFormSet.nConnhandle )
		ELSE
			cTBL_WO		= ''
		ENDIF
		IF nWO_Detail > 0
			*cTBL_WOD	= getTBL_WOD_WO(nWO, ThisFormSet.nConnhandle )
			cTBL_WOD	= getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle )
		ELSE
			cTBL_WOD	= ''
		ENDIF
		
		IF nID_Master + nID_Detail > 0
			IF ThisFormSet.cTBL != cTBL 
				IF LEN(ALLTRIM(cTBL)) = 0
					IF LEN(ALLTRIM(ThisFormSet.cTBL)) > 0
						cTBL = ThisFormSet.cTBL
					ENDIF
				ENDIF
			ENDIF
			
			IF LEN(ALLTRIM(cTBL)) = 0
				*Should have TBL
				DO CASE
				CASE ThisFormSet.cWhat = "S_Process" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "B_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "W_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "Stk_Detail" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "Brk_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "WO_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "WO"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				OTHERWISE
					*Carefull, POitem has been incorrectly passed before.
					IF Proper_PO_item(cPOitem) != Proper_PO_item('')
						
						IF USED('get_TBL_POitem')
							USE IN get_TBL_POitem
						ENDIF
						
						SELECT 0
						cSQL =       " SELECT 'S' AS TBL, ID FROM dbo.StockLst_Master WITH(NOLOCK) "
						cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
						cSQL = cSQL +" UNION "
						cSQL = cSQL +" SELECT 'B' AS TBL, ID FROM dbo.BrokerLst_Master WITH(NOLOCK) "
						cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
						cSQL = cSQL +" UNION "
						cSQL = cSQL +" SELECT 'W' AS TBL, ID FROM dbo.WIPLst_Master WITH(NOLOCK) "
						cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'get_TBL_POitem' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'get_TBL_POitem' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "get_TBL_POitem")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "get_TBL_POitem")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL ,ThisFormSet.nConnhandle, nSQLEXEC, 'get_TBL_POitem')
						ENDIF
						
						IF USED('get_TBL_POitem')
							IF RECCOUNT('get_TBL_POitem') = 1
								IF nID_Master = PrepareSQLnum(get_TBL_POitem.ID,'ID',-3)
									*good
									cTBL = get_TBL_POitem.TBL
								ELSE
									*bad
								ENDIF
							ENDIF
							IF RECCOUNT('get_TBL_POitem') > 1
								LOCATE FOR ID = nID_Master 
								IF FOUND()
									*good
									cTBL = get_TBL_POitem.TBL
								ELSE
									*bad
								ENDIF
							ENDIF
							
							IF NOT EMPTY(cTBL)
								ThisFormset.Receive_Edit.txtTBL.Value = cTBL
							ENDIF
							
							USE IN get_TBL_POitem
						ELSE
							*do not have TBL ###
						ENDIF
					
					ENDIF
				ENDCASE
			ENDIF
		ENDIF
		
		*!*	*************************
		*!*	*No ReceivingID	
		*!*	IF TYPE("nReceivingID") != "N"
		*!*		PRIVATE cMess
		*!*		
		*!*		cMess = "nReceivingID is 0"+CHR(13)
		*!*		cMess = cMess + "SOitem "+ALLTRIM(ShowSQLtxt(cSOitem,'SOitem',12))+CHR(13)
		*!*		cMess = cMess + "POitem "+ALLTRIM(ShowSQLtxt(cPOitem,'POitem',12))+CHR(13)
		*!*		cMess = cMess + "RMA "+ALLTRIM(STR(nRMA))+CHR(13)
		*!*		cMess = cMess + "Alloy "+ALLTRIM(ShowSQLtxt(cAlloy,'Alloy',12))+CHR(13)
		*!*		cMess = cMess + "Heat "+ALLTRIM(ShowSQLtxt(cHeat,'Heat',30))+CHR(13)
		*!*		cMess = cMess + "Desc "+ALLTRIM(LEFT(ShowSQLtxt(cDescription,'Desc',20),20))
		*!*		IF nID_Master > 0
		*!*			cMess = cMess +CHR(13)+ "ID_Master "+ALLTRIM(STR(nID_Master))
		*!*		ENDIF
		*!*		IF nID_Detail > 0
		*!*			cMess = cMess +CHR(13)+ "ID_Detail "+ALLTRIM(STR(nID_Detail))
		*!*		ENDIF
		*!*		
		*!*		TrackMess("bad parameter"+CHR(13)+ShowSQLtxt(cMess,'cMess',-1)+CHR(13)+"Shop_StockLst_Edit:frmReceiving:cmdAdd-CheckSave")
		*!*		nReceivingID = 0
		*!*		ThisFormset.Receive_Edit.txtReceivingID.Value = 0
		*!*		*lReady2Save = .F.
		*!*	ENDIF
		
		*!*	*************
		*!*	IF EMPTY(nReceivingID)
		*!*		nReceivingID = 0
		*!*	ENDIF
		
		*****
		IF nRMA > 0 	
			IF NOT RMA_Exists(nRMA,ThisFormSet.nConnhandle)
				MESSAGEBOX("Not an Active RMA!",48,"Bad RMA Number")
				lReady2Save = .F.
			ELSE
				ThisFormset.Receive_Edit.StockLst_TBL = "S"
			ENDIF
			
			***
			IF nReceivingID > 0 
				nMess = 0
				nMess = MESSAGEBOX("RMA and Receiving ID are good."+CHR(13)+"Last chance to create a NEW receive."+CHR(13)+CHR(13)+"If you are editing an old record:"+CHR(13)+"Answer (Y) to update the ReceivingID"+CHR(13)+"Answer (N) to set create new ReceivingID.",4+32,"Save Edited Record?")	
				IF nMess = 7
					nReceivingID = 0
					ThisFormset.Receive_Edit.txtReceivingID.Value = nReceivingID 
				ENDIF
			ENDIF
			
			***
			IF Proper_SO_item(cSOitem) = Proper_SO_item('')
				MESSAGEBOX("Need Sales Order for an RMA!"+CHR(13)+"Add the Sales Order for the RMA!",48,"Bad SO Item Number")
				lReady2Save = .F.
			ENDIF
			***
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				MESSAGEBOX("RMA cannot have a PO on RMA!"+CHR(13)+"RMA needs the SO."+CHR(13)+"Remove the PO or remove the RMA.",48,"Bad RMA Number")
				lReady2Save = .F.
			ENDIF
			IF lReady2Save 
				PRIVATE nHpaPo
				nHpaPo	= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPONum.Value,'HPAPO',-3,0)
				IF nHpaPo > 0
					MESSAGEBOX("This receive is marked as for a RMA."+CHR(13)+"PO number is being dropped!",0+48,"RMA do not record their PO info.")
					ThisFormset.Receive_Edit.txtHpaPONum.Value = 0
					ThisFormset.Receive_Edit.txtHPAPOItem.Value = 0
					ThisFormSet.cPOitem = Proper_PO_item('')
				ENDIF
			ENDIF
			***
		
		ENDIF
		*****
		
		IF lReady2Save 
			IF nSalesNum > 0
				IF nItemSo <= 0
					*Problem
					MESSAGEBOX("Sales Order is "+ALLTRIM(STR(nSalesNum))+"."+CHR(13)+"Cannot save with item of "+ALLTRIM(STR(nItemSo))+"!",48,"Bad Item Number")
					lReady2Save = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*************
		PRIVATE lFoundSOitem
		lFoundSOitem = .F.
		
		*************
		*Check to see if this receive does not need a po.
		*The SalesOrder is quotes.services, Conversion Service Only- customers material.
		PRIVATE lFoundConvServ 
		lFoundConvServ = .F.
		IF lReady2Save
			IF cSOitem 	!= Proper_SO_Item("")
				*have SOitem
				
				IF USED('tmpCountSO_ServiceOnly')
					USE IN tmpCountSO_ServiceOnly
				ENDIF
				
				SELECT 0
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL +" AND ISNULL(Services,0) = 1"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSO_ServiceOnly' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSO_ServiceOnly' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSO_ServiceOnly")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSO_ServiceOnly")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCountSO_ServiceOnly')
				ENDIF
				
				IF USED('tmpCountSO_ServiceOnly')
					IF RECCOUNT('tmpCountSO_ServiceOnly')>0
						lFoundSOitem = .T.
						IF tmpCountSO_ServiceOnly.Cntd>0
							lFoundConvServ = .T.
						ENDIF
					ENDIF
					USE IN tmpCountSO_ServiceOnly
				ENDIF
				
			ENDIF
		ENDIF
		
		*************
		PRIVATE lFoundWO_Detail
		lFoundWO_Detail = .F.
		
		*Check to see if this receive uses a WO_Detail
		IF nWO_Detail>0
			*have WO_Detail
			
			IF USED('tmpCountWO_Detail')
				USE IN tmpCountWO_Detail
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountWO_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL,'tmpCountWO_Detail' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountWO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCountWO_Detail')
			ENDIF
			
			IF USED('tmpCountWO_Detail')
				IF RECCOUNT('tmpCountWO_Detail')>0
					lFoundSOitem = .T.
					IF tmpCountWO_Detail.Cntd>0
						lFoundWO_Detail = .T.
					ENDIF
				ENDIF
				USE IN tmpCountWO_Detail
			ENDIF
			
		ENDIF
		
		
		*************
		*Check from RMA
		*ThisFormSet.nRMA = 0  &&Reset, Should only have been set as INIT Parameter
		
		PRIVATE nRMA_No, nRMAcnt
		nRMA_No		= PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_No.Value,'RMA_No',-3)
		nRMAcnt	= 0
		
		IF NOT EMPTY(nRMA_No)
			*Verify RMA
			IF USED('tmpRMAcnt')
				USE IN tmpRMAcnt
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.RMA WITH(NOLOCK) "
			cSQL = cSQL + " WHERE RMA_No = "+STR(nRMA_No)
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRMAcnt' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle,  cSQL, 'tmpRMAcnt' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMAcnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMAcnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRMAcnt')
			ENDIF
			
			IF USED('tmpRMAcnt')
				IF VARTYPE(tmpRMAcnt.CNTD) = "N"
					nRMAcnt = IIF(tmpRMAcnt.CNTD>0,1,0)
					IF nRMAcnt = 0
						MESSAGEBOX("Did not Find RMA:"+STR(nRMA_No)+CHR(13)+"Cannot receive against a bad RMA number."+CHR(13)+"Correct the RMA!",0+48,"Not accepted as RMA")
						TrackError("Did not Find RMA:"+STR(nRMA_No),"Did not Find RMA:"+STR(nRMA_No),PROGRAM(),LINENO(1) )
					ENDIF
				ENDIF
				USE IN tmpRMAcnt
			ENDIF
		ENDIF
		
		IF nRMAcnt > 0
			ThisFormSet.nRMA = nRMA_No
		ENDIF
		
		***************
		* Check POitem
		* NOTE cPOitem is not used on customers material like a SO is a Toll Service Order
		PRIVATE nCountPOitem
		nCountPOitem = 0
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
			nCountPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, '' ) 
		ENDIF
		
		IF nCountPOitem = 0
			*Check SOitem
			IF Count_SOIteminSales( cSOItem, ThisFormSet.nConnhandle, 'CONVERSIONSERVICE' ) > 0
				*Good
			ELSE
				*Bad
				PRIVATE cPOitem_OLD, nMess
				cPOitem_OLD = cPOitem
				nMess = 0
					
				*TrackError("Did not find POItem ["+cPOItem+"]","Did not Find POitem", PROGRAM(), LINENO(1))
				
				IF Count_POIteminPurchaseOrder( Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-01"), ThisFormSet.nConnhandle, '' ) > 0
					cPOItem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-01")
					
					nMess = MESSAGEBOX("PO item:"+cPOitem_OLD+" was NOT found but"+CHR(13)+"PO item:"+cPOitem+" was found!"+CHR(13)+CHR(13)+"Do you want to use the POitem:"+cPOitem+"? (Y)"+CHR(13)+CHR(13)+"Otherwise answer No to go back "+CHR(13)+"and fill the correct POitem in. (N)",4+32,"Unsure about the POitem")
					IF nMess = 7
						ThisFormSet.cPOitem = cPOitem
						ThisFormset.Receive_Edit.txtHpaPOItem.Value = 1
						
						TrackError("PO item:"+cPOitem_OLD+" was NOT found but"+CHR(13)+"PO item:"+cPOitem+" was found!"+CHR(10)+"User choose to use POitem:"+cPOitem,"Did not Find POitem", PROGRAM(), LINENO(1))
						WAIT WINDOW "Now edit the POitem"
						RETURN
					ELSE
						lReady2Save = .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		***************
		
		*************
		PRIVATE cVendor
		cVendor	= PrepareSQLtxt(ThisFormset.Receive_Edit.txtVendor.Value,'Vendor',30,.F.,.T. )
		IF LEN(cVendor) = 0
			*Problem
			MESSAGEBOX("ERP PO "+ALLTRIM(STR(nHpaPo))+" needs a Vendor."+CHR(13)+"Cannot save with out Vendor"+CHR(13)+"(The Company you bought from)",48,"Vendor is Empty!")
			lReady2Save = .F.
		ENDIF
		
		*************
		*Check RMA stuff
		IF lReady2Save
			IF nRMAcnt > 0
				*Get the SO data to check Alloy,etc
				IF nSalesNum=0 OR nItemSo=0
					MESSAGEBOX("Cannot save as an RMA with no SO "+ALLTRIM(STR(nSalesNum))+CHR(13)+" or Item "+ALLTRIM(STR(nItemPo))+"!",48,"Bad SO Item Number")
					lReady2Save = .F.
				ENDIF
				
				IF lReady2Save 
					IF USED('tmpQuote_Sales')
						USE IN tmpQuote_Sales
					ENDIF
					
					cSQL = "SELECT "
					*cSQL = cSQL + " S.StockLst_Qty,S.StockLst_PC,S.StockLst_LBS,"
					cSQL = cSQL + " S.Alloy,S.Form,S.Heat,S.CC,S.StockEdit,S.Reconciled  "
					cSQL = cSQL + " ,S.Removed_QTY"&&	ERP Acct Standard
					cSQL = cSQL + " ,S.Invoice_QTY"	&&	Customer
					cSQL = cSQL + " ,S.Invoice_P"	&&Customer
					cSQL = cSQL + " ,S.PS_QTY"		&&Customer
					cSQL = cSQL + " ,S.Left_QTY"	&&	ERP Acct Standard
		
					cSQL = cSQL + " ,AllQuotes.Company "
					cSQL = cSQL + " ,AllQuotes.Form "
					cSQL = cSQL + " FROM dbo.Sales_Stock S WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.AllQuotes WITH(NOLOCK) ON AllQuotes.SOitem = S.SOitem "
					cSQL = cSQL + " WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
				
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpQuote_Sales' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle,  cSQL, 'tmpQuote_Sales' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpQuote_Sales")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpQuote_Sales")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpQuote_Sales')
					ENDIF
					
					IF USED('tmpQuote_Sales')
						IF RECCOUNT('tmpQuote_Sales') >  0
							*Check Alloy, Pc, Weight
							IF ALLTRIM(cAlloy) != ALLTRIM(tmpQuote_Sales.Alloy)
								MESSAGEBOX("Receive Alloy "+ALLTRIM(cAlloy)+" does not match SO Alloy "+ALLTRIM(tmpQuote_Sales.Alloy)+"!",48,"Bad SO Item Number")
								lReady2Save = .F.
							ENDIF
						ELSE
							MESSAGEBOX("Cannot save as an RMA with bad SO Item "+ALLTRIM(cSOitem)+"!",48,"Bad SO Item Number")
							lReady2Save = .F.
						ENDIF
						USE IN tmpQuote_Sales
					ENDIF
		
				ENDIF
			ENDIF
		ENDIF
		
		*************
		*Check POitem2
		IF lReady2Save 
			IF nRMAcnt = 0   
				*Do not need to check for PO on RMA
				IF NOT lFoundSOitem  &&Do not to check on PO because it hase a good SOitem
					IF NOT lFoundWO_Detail  &&Do not to check on PO because it hase a good WO_Detail
						IF NOT lFoundConvServ &&Do not check for PO if lFoundConvServ 
							PRIVATE nCntPOitem 
							nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle )
							IF nCntPOitem < 1
		
								MESSAGEBOX("Did not find POitem: "+ALLTRIM(cPOitem)+CHR(13)+"You cannot save this receive with that POitem!"+CHR(13)+CHR(13)+"Only a Sales Order as a conversion service is allowed."+CHR(13)+"Have Salesman mark as a service.",16,"No Save")
								lReady2Save = .F.
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****
		*Does ThisFormSet.cSOitem belong to ThisFormSet.cPOitem
		IF Proper_PO_Item(ThisFormSet.cPOitem) <> Proper_PO_Item('')
			IF Proper_SO_Item(ThisFormSet.cSOitem) <> Proper_SO_Item('')
				PRIVATE cMess
				
				*Find SOitem in PurchaseOrder
				PRIVATE nCntSOitem 
				nCntSOitem = Count_SOitem_PurchaseOrder(ThisFormSet.cSOitem, ThisFormSet.nConnhandle) 
				IF nCntSOitem = 0
					cMess = "While Receiving for POitem='"+Proper_PO_Item(cPOitem)+"'"
					IF ThisFormSet.nReceivingID  > 0
						cMess = cMess +CHR(13)+" ReceivingID="+ALLTRIM(STR(ThisFormSet.nReceivingID ))
					ENDIF	
					cMess = cMess +CHR(13)+" SOitem='"+Proper_SO_Item(ThisFormSet.cSOitem)+"' did not belong to this POitem."
					cMess = cMess +CHR(13)+"Count_SOitem_PurchaseOrder()"
					TrackMess(cMess)
				ENDIF
				*Find POitem is Sales
				*cSOItem = get_SOitem_from_POitem(cPOItem, ThisFormSet.nConnhandle)
				PRIVATE cGetPOitem
				cGetPOitem = Proper_PO_Item(GetPOitem_PurchaseOrder_SOitem( ThisFormSet.cSOitem, ThisFormSet.nConnhandle ))
				IF Proper_PO_Item(cGetPOitem) <> Proper_PO_Item('')
					IF Proper_PO_Item(cGetPOitem) <> Proper_PO_Item(ThisFormSet.cPOitem)
						cMess = "While Receiving for POitem='"+Proper_PO_Item(cPOitem)+"'"
						IF ThisFormSet.nReceivingID  > 0
							cMess = cMess +CHR(13)+" ReceivingID="+ALLTRIM(STR(ThisFormSet.nReceivingID ))
						ENDIF	
						cMess = cMess +CHR(13)+" SOitem='"+Proper_SO_Item(ThisFormSet.cSOitem)+"' did not belong to this POitem."
						cMess = cMess +CHR(13)+" Found POitem='"+Proper_PO_Item(cGetPOitem)+"' on that SOitem."
						cMess = cMess +CHR(13)+"GetPOitem_PurchaseOrder_SOitem()"
						TrackMess(cMess)
					ENDIF
				ENDIF		
				
			ENDIF
		ENDIF
		
		
		ThisFormSet.cSOitem = cSOitem
		
		*****
		*Check Recv_QTY
		PRIVATE nAcct_QTY,nAcct_P,nPS_QTY,nPS_P
		nAcct_QTY	= PrepareSQLnum(ThisFormset.Receive_Edit.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct QTY
		nAcct_P		= PrepareSQLnum(ThisFormset.Receive_Edit.txtAcct_P.Value,'S_P',-5)	&&Acct P
		
		nPS_QTY = PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_QTY.Value,'Quoted_QTY',-5)	&&Customer QTY
		nPS_P 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_P.Value,'Quoted_P',-5)	&&Customer
		*	
		
		IF nAcct_QTY = 0
			MESSAGEBOX("ERP Acct Standard QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Calculate the QTY that ERP Acct Standard would like to see"+CHR(13)+"Most of the time this is Pounds, but could by Foot or Pieces",16,"No Save")
			lReady2Save = .F.
		ENDIF
		*****
		IF nPS_QTY = 0
			MESSAGEBOX("Vendor QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Enter the QTY found on packingslip from Vendor"+CHR(13)+"This entered Quantity will be verified against their Invoice.",16,"No Save")
			lReady2Save = .F.
		ENDIF
		****
		*****
		*Is Receive nAcct_QTY > Expected
		*Is Receive nPS_QTY > Expected
		*****
		
		RETURN lReady2Save
	ENDPROC

	PROCEDURE checksave_wod
		*ThisFormSet.CheckSave_WOD()
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		
		PRIVATE  nReceivingID
		*nReceivingID = Receive_Edit.txtReceivingID.Value
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		ThisFormSet.nReceivingID  = nReceivingID
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		PRIVATE cSOitem, nSalesNum, nItemSo, nWO, nWO_Detail
		PRIVATE nRMA,cAlloy,cHeat,cLot,cDescription
		
		nHpaPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		nSalesNum	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSONum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		ThisFormSet.cSOitem = cSOitem
		
		nWO			= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50,.f.)
		cLot		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtLot.Value,'Lot',10,.f.)
		
		cDescription= PrepareSQLtxt(ThisFormset.Receive_Edit.edtDescription.Value,'Description',-1,.F.)
		
		nRMA = PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_No.Value,'RMA',-3)
		
		*************************
		*Check Heat
		IF UPPER(cHeat) = "DUE IN"
			cHeat = ""	&&Do not check for Due In
		ENDIF
		IF LEN(cHeat)=0
			IF MESSAGEBOX("No Heat was Entered."+CHR(13)+CHR(13)+"If this is OK answer (Y)."+CHR(13)+CHR(13)+"If you want to go back"+CHR(13)+"and enter the Heat, answer(N)",16+4,"Continue...") != 6
				lReady2Save = .F.
			ENDIF
		ENDIF
		
		*************************
		*Check TBL
		
		PRIVATE nID_Master, nID_Detail, cTBL, cForm
		nID_Master	= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
		cTBL 		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtTBL.Value,'TBL',1)
		cForm 		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtForm.Value,'Form',2)
		
		PRIVATE cTBL_POi, cTBL_POi_P
		*cTBL_POi	= getTBL_POitem(cPOitem, ThisFormSet.nConnhandle ) 
		*cTBL_POi_P	= getTBL_Process_POitem(cPOitem, ThisFormSet.nConnhandle ) 
		cTBL_POi	= 'S'
		cTBL_POi_P	= 'S'
		
		
		PRIVATE cTBL_WO, cTBL_WOD
		IF nWO > 0
			cTBL_WO		= getTBL_WO(nWO, ThisFormSet.nConnhandle )
		ELSE
			cTBL_WO		= ''
		ENDIF
		IF nWO_Detail > 0
			*cTBL_WOD	= getTBL_WOD_WO(nWO, ThisFormSet.nConnhandle )
			cTBL_WOD	= getTBL_WO_Detail(nWO_Detail, ThisFormSet.nConnhandle )
		ELSE
			cTBL_WOD	= ''
		ENDIF
		
		IF nID_Master + nID_Detail > 0
			IF ThisFormSet.cTBL != cTBL 
				IF LEN(ALLTRIM(cTBL)) = 0
					IF LEN(ALLTRIM(ThisFormSet.cTBL)) > 0
						cTBL = ThisFormSet.cTBL
					ENDIF
				ENDIF
			ENDIF
			
			IF LEN(ALLTRIM(cTBL)) = 0
				*Should have TBL
				DO CASE
				CASE ThisFormSet.cWhat = "S_Process" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "B_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "W_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "Stk_Detail" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "Brk_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "WO_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				CASE ThisFormSet.cWhat = "WO"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisFormSet.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisFormSet.cHeat )
				OTHERWISE
					*Carefull, POitem has been incorrectly passed before.
		*!*				IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*!*					
		*!*					IF USED('get_TBL_WO')
		*!*						USE IN get_TBL_WO
		*!*					ENDIF
		*!*					
		*!*					SELECT 0
		*!*					cSQL =       " SELECT 'S' AS TBL, ID FROM dbo.StockLst_Master WITH(NOLOCK) "
		*!*					cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*					cSQL = cSQL +" UNION "
		*!*					cSQL = cSQL +" SELECT 'B' AS TBL, ID FROM dbo.BrokerLst_Master WITH(NOLOCK) "
		*!*					cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*					cSQL = cSQL +" UNION "
		*!*					cSQL = cSQL +" SELECT 'W' AS TBL, ID FROM dbo.WIPLst_Master WITH(NOLOCK) "
		*!*					cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'get_TBL_WO' )
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'get_TBL_WO' )
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0 &&Try again!
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "get_TBL_WO")
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "get_TBL_WO")
		*!*							
		*!*							IF nSQLEXEC < 0
		*!*								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*									nSQLEXEC = 0
		*!*								ENDIF
		*!*							ENDIF
		*!*						ENDDO
		*!*					ENDIF 
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL ,ThisFormSet.nConnhandle, nSQLEXEC, 'get_TBL_WO')
		*!*					ENDIF
		*!*					
		*!*					IF USED('get_TBL_POitem')
		*!*						IF RECCOUNT('get_TBL_POitem') = 1
		*!*							IF nID_Master = PrepareSQLnum(get_TBL_WO.ID,'ID',-3)
		*!*								*good
		*!*								cTBL = get_TBL_POitem.TBL
		*!*							ELSE
		*!*								*bad
		*!*							ENDIF
		*!*						ENDIF
		*!*						IF RECCOUNT('get_TBL_POitem') > 1
		*!*							LOCATE FOR ID = nID_Master 
		*!*							IF FOUND()
		*!*								*good
		*!*								cTBL = get_TBL_POitem.TBL
		*!*							ELSE
		*!*								*bad
		*!*							ENDIF
		*!*						ENDIF
		*!*						
		*!*						IF NOT EMPTY(cTBL)
		*!*							ThisFormset.Receive_Edit.txtTBL.Value = cTBL
		*!*						ENDIF
		*!*						
		*!*						USE IN get_TBL_POitem
		*!*					ELSE
		*!*						*do not have TBL ###
		*!*					ENDIF
		*!*				
		*!*				ENDIF
				ENDCASE
			ENDIF
		ENDIF
		
		*!*	*****
		*!*	IF nRMA > 0 	
		*!*		IF NOT RMA_Exists(nRMA,ThisFormSet.nConnhandle)
		*!*			MESSAGEBOX("Not an Active RMA!",48,"Bad RMA Number")
		*!*			lReady2Save = .F.
		*!*		ELSE
		*!*			ThisFormset.Receive_Edit.StockLst_TBL = "S"
		*!*		ENDIF
		*!*		
		*!*		***
		*!*		IF nReceivingID > 0 
		*!*			nMess = 0
		*!*			nMess = MESSAGEBOX("RMA and Receiving ID are good."+CHR(13)+"Last chance to create a NEW receive."+CHR(13)+CHR(13)+"If you are editing an old record:"+CHR(13)+"Answer (Y) to update the ReceivingID"+CHR(13)+"Answer (N) to set create new ReceivingID.",4+32,"Save Edited Record?")	
		*!*			IF nMess = 7
		*!*				nReceivingID = 0
		*!*				ThisFormset.Receive_Edit.txtReceivingID.Value = nReceivingID 
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		***
		*	IF Proper_SO_item(cSOitem) = Proper_SO_item('')
		*		MESSAGEBOX("Need Sales Order for an RMA!"+CHR(13)+"Add the Sales Order for the RMA!",48,"Bad SO Item Number")
		*		lReady2Save = .F.
		*	ENDIF
		*	***
		*	IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*		MESSAGEBOX("RMA cannot have a PO on RMA!"+CHR(13)+"RMA needs the SO."+CHR(13)+"Remove the PO or remove the RMA.",48,"Bad RMA Number")
		*		lReady2Save = .F.
		*	ENDIF
		*	IF lReady2Save 
		*		PRIVATE nHpaPo
		*		nHpaPo	= PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPONum.Value,'HPAPO',-3,0)
		*		IF nHpaPo > 0
		*			MESSAGEBOX("This receive is marked as for a RMA."+CHR(13)+"PO number is being dropped!",0+48,"RMA do not record their PO info.")
		*			ThisFormset.Receive_Edit.txtHpaPONum.Value = 0
		*			ThisFormset.Receive_Edit.txtHPAPOItem.Value = 0
		*			ThisFormSet.cPOitem = Proper_PO_item('')
		*		ENDIF
		*	ENDIF
		*	***
		
		*ENDIF
		*****
		
		*!*	IF lReady2Save 
		*!*		IF nSalesNum > 0
		*!*			IF nItemSo <= 0
		*!*				*Problem
		*!*				MESSAGEBOX("Sales Order is "+ALLTRIM(STR(nSalesNum))+"."+CHR(13)+"Cannot save with item of "+ALLTRIM(STR(nItemSo))+"!",48,"Bad Item Number")
		*!*				lReady2Save = .F.
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*************
		*!*	PRIVATE lFoundSOitem
		*!*	lFoundSOitem = .F.
		
		*!*	*************
		*!*	*Check to see if this receive does not need a po.
		*!*	*The SalesOrder is quotes.services, Conversion Service Only- customers material.
		*!*	PRIVATE lFoundConvServ 
		*!*	lFoundConvServ = .F.
		*!*	IF lReady2Save
		*!*		IF cSOitem 	!= Proper_SO_Item("")
		*!*			*have SOitem
		*!*			
		*!*			IF USED('tmpCountSO_ServiceOnly')
		*!*				USE IN tmpCountSO_ServiceOnly
		*!*			ENDIF
		*!*			
		*!*			SELECT 0
		*!*			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.AllQuotes WITH(NOLOCK) "
		*!*			cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*			cSQL = cSQL +" AND ISNULL(Services,0) = 1"
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSO_ServiceOnly' )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSO_ServiceOnly' )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSO_ServiceOnly")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSO_ServiceOnly")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL ,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCountSO_ServiceOnly')
		*!*			ENDIF
		*!*			
		*!*			IF USED('tmpCountSO_ServiceOnly')
		*!*				IF RECCOUNT('tmpCountSO_ServiceOnly')>0
		*!*					lFoundSOitem = .T.
		*!*					IF tmpCountSO_ServiceOnly.Cntd>0
		*!*						lFoundConvServ = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*				USE IN tmpCountSO_ServiceOnly
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		*************
		PRIVATE lFoundWO_Detail
		lFoundWO_Detail = .F.
		
		*Check to see if this receive uses a WO_Detail
		IF nWO_Detail > 0
			*have WO_Detail
			
			IF USED('tmpCountWO_Detail')
				USE IN tmpCountWO_Detail
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountWO_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL,'tmpCountWO_Detail' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountWO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCountWO_Detail')
			ENDIF
			
			IF USED('tmpCountWO_Detail')
				IF RECCOUNT('tmpCountWO_Detail')>0
					lFoundSOitem = .T.
					IF tmpCountWO_Detail.Cntd>0
						lFoundWO_Detail = .T.
					ENDIF
				ENDIF
				USE IN tmpCountWO_Detail
			ENDIF
			
		ENDIF
		
		
		
		
		
		*************
		*Check POitem2
		IF lReady2Save 
		
				*Do not need to check for PO on RMA
				
					IF NOT lFoundWO_Detail  &&Do not to check on PO because it hase a good WO_Detail
						MESSAGEBOX("Did not find WO_Detail: "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"You cannot save this receive with that WO_Detail!",16,"No Save")
						lReady2Save = .F.
					ENDIF
				
		
		ENDIF
		
		
		
		*****
		*Check Recv_QTY
		PRIVATE nAcct_QTY,nAcct_P,nPS_QTY,nPS_P
		nAcct_QTY	= PrepareSQLnum(ThisFormset.Receive_Edit.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct QTY
		nAcct_P = 0
		nPS_QTY = PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_QTY.Value,'Quoted_QTY',-5)	&&Customer QTY
		nPS_P 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_P.Value,'Quoted_P',-5)	&&Customer
		*	
		
		IF nAcct_QTY = 0
			MESSAGEBOX("ERP Acct Standard QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Calculate the QTY that ERP Acct Standard would like to see"+CHR(13)+"Most of the time this is Pounds, but could by Foot or Pieces",16,"No Save")
			lReady2Save = .F.
		ENDIF
		*****
		
		IF nAcct_QTY > 0
			IF nPS_QTY = 0
				nPS_QTY = nAcct_QTY
				ThisFormset.Receive_Edit.txtPO_QTY.Value = nPS_QTY
			ENDIF
		ENDIF
		
		IF nPS_QTY = 0
			MESSAGEBOX("Vendor QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Enter the QTY, usually pounds "+CHR(13)+"This entered Quantity will be verified when reconciled.",16,"No Save")
			lReady2Save = .F.
		ENDIF
		
		*****
		
		
		RETURN lReady2Save
	ENDPROC

	PROCEDURE choosepoitemload
		PARAMETER pnHpaPo
		*ThisFormSet.ChoosePOitemLoad(nHPApo)
		
		PRIVATE nHpaPo
		IF TYPE("pnHpaPo") = "N"
			nHpaPo = pnHpaPo
		ELSE
			nHpaPo = 0
		ENDIF
		
		IF nHpaPo = 0
			WAIT WINDOW "No ERP PO to load" NOWAIT
			RETURN .F.
		ENDIF
		
		PRIVATE nItemPo
		nItemPo = PrepareSQLnum(ThisFormset.Receive_Edit.txtHpaPOItem.Value,'ItemPO',2,0)
		
		IF nHpaPo > 0
			IF ThisFormset.Receive_Edit.ChecknHpaPO = nHpaPo 
				IF ThisFormset.Receive_Edit.ChecknItemPO = nItemPo
				
					RETURN .F.
				ELSE
					ThisFormSet.ChecknItemPO = nItemPo
				ENDIF
			ELSE
				ThisFormSet.ChecknHpaPO = nHpaPo 
				ThisFormSet.ChecknItemPO = 0
			ENDIF
		ENDIF
		
		*ThisFormSet.ChecknItemPO 
		
		
		*Show list of Item to Choose
		PRIVATE cPoItem
		DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
		
		cPOitem	= Proper_PO_Item( cPoItem )
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item( '' )
			RETURN .F.
		ENDIF
		nItemPo = Proper_PO_Item_Item(cPOitem)
		
		*****************
		*Check for PO
		IF USED("tmpPOitems")
			USE IN tmpPOitems
		ENDIF
		
		
		cSQL = "SELECT COUNT(*) AS CNTD "
		cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
		*cSQL = cSQL + " WHERE HpaPo = "+STR(nHpaPo)
		cSQL = cSQL + " WHERE POitem='"+cPOitem+"'"
		
		IF USED("tmpPOitems")
			SELECT tmpPOitems 
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOitems')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOitems')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOitems')
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF USED("tmpPOitems")
			IF RECCOUNT("tmpPOitems") > 0
				IF tmpPOitems.CNTD > 0
					ThisFormset.Receive_Edit.txtHpaPOItem.Value = nItemPo
					ThisFormSet.ChecknItemPO = nItemPO
					ThisFormSet.cPOitem = cPOitem
					ThisFormset.Receive_Edit.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisFormSet.nConnhandle )
		
					PRIVATE nWO_Detail
					nWO_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
					PRIVATE nCntPO, nMess
					
					IF ThisFormSet.cWhat = 'ADD'
		
						nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnhandle ,"NOTSTOCK")
						nMess = 6				
						IF nCntPO > 0 AND nWO_Detail = 0
							nMess = MESSAGEBOX("This PO "+ALLTRIM(STR(nHpaPo))+" is not for receiving metal!"+CHR(13)+"This could be a testing PO number."+CHR(13)+"This could be a Conversion Service"+CHR(13)+CHR(13)+"If you are trying to receive in "+CHR(13)+"stock for Inventory "+CHR(13)+"or a Sales Order"+CHR(13)+"You have the wrong PO number."+CHR(13)+CHR(13)+"Do you still want to use this PO?",4+32,"Service PO")
						ENDIF
						IF nMess = 6
							*Get POitem Detail
							ThisFormSet.GetPO_Incoming(cPOitem)
							*ThisFormSet.GetPOitemDetail(cPOitem)
						ENDIF
					ELSE
						IF ThisFormSet.cWhat = 'EDIT'
						
							nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnhandle ,"NOTSTOCK")
							nMess = 6				
							IF nCntPO > 0 AND nWO_Detail = 0
								nMess = MESSAGEBOX("This PO "+ALLTRIM(STR(nHpaPo))+" is not for receiving metal!"+CHR(13)+"This could be a testing PO number."+CHR(13)+"This could be a Conversion Service"+CHR(13)+CHR(13)+"If you are trying to receive in "+CHR(13)+"stock for Inventory "+CHR(13)+"or a Sales Order"+CHR(13)+"You have the wrong PO number."+CHR(13)+CHR(13)+"Do you still want to use this PO?",4+32,"Service PO")
							ENDIF
							IF nMess = 6
								*Get POitem Detail
								*ThisFormSet.GetPO_Incoming(cPOitem)
								ThisFormSet.GetPOitemDetail(cPOitem)
							ENDIF
		
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			USE IN tmpPOitems
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE choosesoitemload
		PARAMETER pnSalesNum
		*ThisForm.ChooseSOitemLoad(nSalesNum)
		
		PRIVATE nSalesNum
		IF TYPE("pnSalesNum") = "N"
			nSalesNum = pnSalesNum
		ELSE
			nSalesNum = 0
		ENDIF
		
		
		
		
		*Show list of Item to Choose
		PRIVATE cSoItem
		DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSoItem
		
		IF TYPE("cSoItem") = "C"
			IF NOT EMPTY(cSoItem)
						
				IF Count_SOIteminSales(cSoItem, ThisFormSet.nConnhandle ) > 0
					ThisFormSet.GetSoItemDetail( )
				ELSE
					MESSAGEBOX("No data for that SO",0,"No SO items")
					RETURN	.F.
				ENDIF
			ELSE
				MESSAGEBOX("Nothing to return for that SO",0,"No SO items")
				RETURN	.F.
			ENDIF		
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE clean_stock
		PARAMETERS pWhat
		*ThisFormSet.Clean_Stock()
		
		PRIVATE cWhat  &&"CMPLT","EDIT","NOT_CMPLT"
		cWhat = PrepareSQLtxt(pWhat,'WHAT',10)  
		**ThisFormSet.Clean_Stock("CMPLT")
		
		*This could be an Edit/show Old data.
		*Check for ReceivingID in Stock to see if new partial stock needs to be run
		*EXIT if needed.  cmdCancel
		
		PRIVATE nID_Master, nID_Detail
		nID_Detail = PrepareSQLnum(ThisFormSet.nID_Detail,'ID_Detail',-3)
		nID_Master = 0
		IF nID_Detail > 0
			nID_Master = Get_ID_Master_with_ID_Detail(nID_Detail, ThisFormSet.cTBL, ThisFormSet.nConnhandle) 
		ENDIF
		
		IF nID_Master = 0
			IF ThisFormSet.nReceivingID  > 0
				nID_Master = Get_ID_Master_by_ReceivingID(ThisFormSet.nReceivingID ,ThisFormSet.cTBL,ThisFormSet.nConnhandle)
				IF nID_Master > 0
					*This Show Received vs Ordered was just a Receive Edit, not an ADD!
					*did not come in with RID but 
					ThisFormSet.nReturn = 1
					*ThisFormSet.SetToWOD.Release
					RETURN .T.
				ELSE
					*A new Receive_Edit does not have the Stock Detail with the ReceivingID and ID_Master would be 0
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		IF NOT (ThisFormSet.cTBL = "S" OR ThisFormSet.cTBL = "B" OR ThisFormSet.cTBL = "W")
			RETURN .T.
			*Do not contiunue down this path
		ENDIF
		
		*****************************
		*Check that there is no history
		*Do not change if history has been made 
		
		PRIVATE lFound_STK_History
		lFound_STK_History = .F.
		
		
		PRIVATE nSQLEXEC, cSQL
		IF nID_Detail > 0
			lFound_STK_History  = Has_ID_Detail_History(nID_Detail, ThisFormSet.cTBL, ThisFormSet.nConnhandle)
		ENDIF
			
		*****************************
		PRIVATE nPO_OrigQTY, nO_QTY, nID_Detail_Process, nID_Detail_Process
		nPO_OrigQTY = 0
		nO_QTY	= 0
		nID_Detail_Process = 0
		nID_Detail_INCOMING = 0
		PRIVATE lIncoming,lNOT2HPA, lPARTRECV
		lIncoming = .T.
		lNOT2HPA = .F.
		lPARTRECV = .F.
		PRIVATE nPrc_PCs_need 
		PRIVATE lFoundOldPrc
		lFoundOldPrc = .F.
		
		*Look for INCOMING PO item or WO_Detail
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = " SELECT QTY, Ordered_QTY, Ordered_P, ReceivingID, Process_ID, 'Original' AS Process, ID_Detail, ID_Detail_Process "
		cSQL = cSQL + " ,[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3],[Prc_Q_QTY],[Prc_Q_PU] "
		DO CASE
		CASE ThisFormSet.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE ThisFormSet.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE ThisFormSet.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_Item('')
			cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
			IF ThisFormSet.nWO_Detail > 0
				cSQL = cSQL + " AND WO_Detail = "+STR(ThisFormSet.nWO_Detail)
			ENDIF
		ELSE
			IF ThisFormSet.nWO_Detail > 0
				cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisFormSet.nWO_Detail)
			ELSE
				cSQL = cSQL = " WHERE 0>0 "
			ENDIF
		ENDIF
		cSQL = cSQL+" AND ( Process_ID='INCOMING' OR Process_ID = 'NOT2HPA' )"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStkProc')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStkProc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStkProc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpStkProc')
			IF RECCOUNT('tmpStkProc') > 0
				***************************
				SCAN	&& NOT sure if multiple exists ???
					
					DO CASE
					CASE tmpStkProc.Process_ID = 'INCOMING' 
						lIncoming = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
						nID_Detail_INCOMING = PrepareSQLnum(tmpStkProc.ID_Detail,'ID_Detail',-3)
						lFound_STK_History  = Has_ID_Detail_History(nID_Detail_INCOMING, ThisFormSet.cTBL, ThisFormSet.nConnhandle)
						lFoundOldPrc = .T.
					CASE tmpStkProc.Process_ID = 'NOT2HPA' 
						lNOT2HPA = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
						nID_Detail_INCOMING = PrepareSQLnum(tmpStkProc.ID_Detail,'ID_Detail',-3)
						lFound_STK_History  = Has_ID_Detail_History(nID_Detail_INCOMING, ThisFormSet.cTBL, ThisFormSet.nConnhandle)
						lFoundOldPrc = .T.
					CASE tmpStkProc.Process_ID = 'PARTRECV' 
						lPARTRECV = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process = 'Original'
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					ENDCASE
				ENDSCAN
		
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		PRIVATE lCommit, lOK, cBadMess
		lCommit = .T.
		lOK = .T.
		cBadMess = ''
		
		*************************
		DO CASE
		CASE cWhat = "CMPLT"
			IF lFoundOldPrc 
				*Need to mark INCOMING as RECEIVED
				*nID_Detail_Process
				*nID_Detail_INCOMING
				
				IF lOK
				*update the Detail Process
					**********************
					IF nID_Detail_Process > 0	
						*UPDATE ID_DetailProcess as Received
						
						PRIVATE nRcv_QTY
						nRcv_QTY = PrepareSQLnum(ThisFormSet.SetToWOD.txtRcv_QTY.Value,'QTY',-5)
						
						
						cSQL = " UPDATE "
						DO CASE
						CASE ThisFormSet.cTBL = "S"
							cSQL = cSQL + " dbo.StockLst_Process "
						CASE ThisFormSet.cTBL = "B"
							cSQL = cSQL + " dbo.BrokerLst_Process "
						CASE ThisFormSet.cTBL = "W"
							cSQL = cSQL + " dbo.WIPLst_Process "
						OTHERWISE
							RETURN .F.
						ENDCASE
						cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
						cSQL = cSQL + " ,QTY = "+STR(nRcv_QTY)
						cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
						ENDIF		
					ENDIF
				ENDIF
				
				***************************************************************************
				IF lOK AND NOT lFound_STK_History
				*update the Detail
					**********************
					IF nID_Detail_INCOMING > 0	
						*UPDATE ID_Detail with the current data!  
						
						PRIVATE nPC_Recv, nActualW, nRcv_QTY, nS_P, nS_Total
						nPC_Recv	= PrepareSQLnum(ThisFormSet.SetToWOD.txtPC_Recv.Value,'Pieces',-3)
						nActualW	= PrepareSQLnum(ThisFormSet.SetToWOD.txtActualW.Value,'ActualW',9,1)	
						nRcv_QTY	= PrepareSQLnum(ThisFormSet.SetToWOD.txtRcv_QTY.Value,'QTY',-5)
						nS_P		= PrepareSQLnum(ThisFormSet.SetToWOD.txtS_P.Value,'S_P',-5)
						nS_Total	= nRcv_QTY * nS_P
		
						DO CASE
						CASE ThisFormSet.cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Detail SET "
						CASE ThisFormSet.cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Detail SET "
						CASE ThisFormSet.cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Detail SET "
						ENDCASE
									
						cSQL = cSQL+ " PC="+STR(nPC_Recv)+""
						cSQL = cSQL+ ",Weight="+STR(nActualW,18,4)+""
						cSQL = cSQL+ ",ReceivingID="+STR(ThisFormSet.nReceivingID )
						cSQL = cSQL+ ",InvCheck=GetDate()" &&+"'"+DTOC(DATE())+"'"
						cSQL = cSQL+ ",S_QTY = " + STR(nRcv_QTY,18,4) + ""
						cSQL = cSQL+ ",S_P = "+STR(nS_P,18,4)
						cSQL = cSQL+ ",S_Total = "+STR(nS_Total,18,4)
						cSQL = cSQL+ ",Prime = 1"
						
						cSQL  = cSQL+ " WHERE ID_Detail="+STR(nID_Detail_INCOMING)
					
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, ThisFormSet.nConnhandle,nSQLEXEC)
							lCommit = .F.
							lOK = .F.
							cBadMess = cBadMess + "Could not Update the new Detail record "+CHR(13)
						ENDIF
					
					ENDIF
				ENDIF
				
				***************************************************************************
				IF lOK AND NOT lFound_STK_History
					**Update the Master
					PRIVATE nID_INCOMING
					nID_INCOMING = get_ID_Master_with_ID_Detail(nID_Detail_INCOMING, ThisFormSet.cTBL, ThisFormSet.nConnhandle)
					
					IF nID_INCOMING = 0
						nID_INCOMING = Get_ID_Master_by_ReceivingID(ThisFormSet.nReceivingID , ThisFormSet.cTBL, ThisFormSet.nConnhandle)
					ENDIF
					
					IF nID_INCOMING > 0
						
						PRIVATE cHeat, cLot, cPOitem, nFrom_ID, nWO_Detail
						cHeat	= PrepareSQLtxt(ThisFormSet.SetToWOD.txtHeat.Value,'Heat',50)
						cLot	= PrepareSQLtxt(ThisFormSet.SetToWOD.txtLot.Value,'Lot',10)
						cPOitem = PrepareSQLtxt(ThisFormSet.cPOitem,'POitem',12)
						nFrom_ID = 0 
						nWO_Detail	= PrepareSQLnum(ThisFormSet.nWO_Detail,'WO_Detail',-3)
						
						DO CASE
						CASE ThisFormSet.cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Master SET "
						CASE ThisFormSet.cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Master SET "
						CASE ThisFormSet.cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Master SET "
						ENDCASE
						
						cSQL = cSQL +" Heat = '"+cHeat+"'"
						cSQL = cSQL +",Lot = '"+cLot+"'"
						cSQL = cSQL +",StkDate='"+TTOC(DATETIME())+"'"
						cSQL = cSQL +",POStatus = 'W'"
						IF cPOitem <> Proper_PO_item('')
							cSQL = cSQL+",PO_item = '"+cPOitem+"'"
						ENDIF
						IF nWO_Detail > 0
							cSQL = cSQL + ",WO_Detail = "+STR(nWO_Detail)
						ENDIF
						cSQL = cSQL + ",From_ID="+STR(nFrom_ID)
						cSQL = cSQL +" WHERE ID ="+STR(nID_INCOMING)
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, ThisFormSet.nConnhandle,nSQLEXEC)
							lCommit = .F.
							lOK = .F.
							cBadMess = cBadMess + "Could not Update Master "+CHR(13)
						ENDIF
					ENDIF
				ENDIF
				
				***************************************************************************
				IF lOK AND nID_INCOMING > 0 AND nID_Detail_INCOMING > 0 AND ThisFormSet.nReceivingID  > 0
				
					*Update Receiving
					cSQL = "UPDATE dbo.Receiving "
					cSQL = cSQL +" SET StockTable = '"+ThisFormSet.cTBL +"'"
					cSQL = cSQL +",ID_Master = "+STR(nID_INCOMING)
					cSQL = cSQL +",ID_Detail = "+STR(nID_Detail_INCOMING)
					cSQL = cSQL +" WHERE ID ="+STR(ThisFormSet.nReceivingID )
					cSQL = cSQL +" AND ISNULL(ID_Master,0) = 0"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
				ENDIF	
				 
			ENDIF
			
		CASE cWhat = "EDIT"
		
		CASE cWhat = "NOT_CMPLT"
		
		OTHERWISE
			*Did not get good Parameter!
			TrackError("cWhat needs to be 'CMPLT', 'EDIT' OR 'NOT_CMPLT'","PARAMETERS pWhat", PROGRAM(), LINENO(1))
		ENDCASE
		
		RETURN .T.
	ENDPROC

	PROCEDURE copy_selectedprc
		PARAMETERS nOld_ID_Detail, nNewID_Detail
		*ThisFormSet.Copy_SelectedPrc
		
		PRIVATE cSQL, lOK
		lOK = .T.
		
		*PRIVATE nID_Detail_Prc
		**Check for Incoming Process to copy, may have to insert.
		*nID_Detail_Prc = Get_ID_Detail_Prc_by_ID_Detail(nOld_ID_Detail,ThisFormSet.cTBL,'INCOMING',ThisFormSet.nConnhandle)
		
		IF nOld_ID_Detail*nNewID_Detail > 0
			cSQL = "INSERT INTO "
			DO CASE
			CASE ThisFormSet.cTBL= "S"
				cSQL=cSQL+" dbo.StockLst_Process ("
			CASE ThisFormSet.cTBL= "B"
				cSQL=cSQL+" dbo.BrokerLst_Process ("
			CASE ThisFormSet.cTBL = "W"
				cSQL=cSQL+" dbo.WIPLst_Precess ("
			ENDCASE
			cSQL=cSQL+"[SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID]"
			cSQL=cSQL+",[Processor],[AllowSub],[PU],[QTY],[Ordered_QTY],[Ordered_P],[Pounds]"
			cSQL=cSQL+",[ID_Detail]"
		*	cSQL=cSQL+"--,[ID_Detail_Process]"
		 	cSQL=cSQL+",[ReceivingID],[WO],[WO_Detail]"
			cSQL=cSQL+",[InqNumP],[Prc_Form],[Prc_PCs],[Prc_Dim1]"
			cSQL=cSQL+",[Prc_Dim2],[Prc_Dim3],[Prc_Q_QTY],[Prc_Q_PU]"
		 	cSQL=cSQL+" ) "
			cSQL=cSQL+" SELECT [SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID]"
			cSQL=cSQL+",[Processor],[AllowSub],[PU]"
			cSQL=cSQL+",[QTY]"	&&QTY needed
			cSQL=cSQL+",[Ordered_QTY],[Ordered_P]"
			cSQL=cSQL+",[Pounds]" &&Pounds Needed
			cSQL=cSQL+","+STR(nNewID_Detail)
		*	cSQL=cSQL+"--,[ID_Detail_Process]"
			cSQL=cSQL+" ,[ReceivingID],[WO],[WO_Detail]"
			cSQL=cSQL+" ,[InqNumP],[Prc_Form],[Prc_PCs],[Prc_Dim1]"
			cSQL=cSQL+" ,[Prc_Dim2],[Prc_Dim3],[Prc_Q_QTY],[Prc_Q_PU]"
			DO CASE
			CASE ThisFormSet.cTBL= "S"
				cSQL=cSQL+ " FROM dbo.StockLst_Process "
			CASE ThisFormSet.cTBL= "B"
				cSQL=cSQL+ " FROM dbo.BrokerLst_Process "
			CASE ThisFormSet.cTBL = "W"
				cSQL=cSQL+ " FROM dbo.WIPLst_Precess "
			ENDCASE
			cSQL=cSQL+" WHERE ID_Detail="+STR(nOld_ID_Detail)
			cSQL=cSQL+" AND [Process_ID]='SELECTED'"
			*cSQL=cSQL+" AND [AllowSub]='N'"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisFormSet.nConnhandle,nSQLEXEC)
				lOK = .F.
				TrackError("Could not Insert copy of 'SELECTED' into new ID_Detail_Process ","SELECTED ID_Detail_Process", PROGRAM(), LINENO(1))
			ENDIF
		
		ENDIF
		
		RETURN lOK
	ENDPROC

	PROCEDURE create_incoming_process
		PARAMETERS pStockTable,pTableID_Detail,pSOitem,pPOitem, nPounds
		*THISFORM.Create_Incoming_Process(cTableName,nTableID_Detail,pSOitem,pPOitem,nPounds)
		* creates an INCOMING process
		*Returns nID_Detail_Process
		
		PRIVATE cStockTable,nTableID_Detail,cSOitem,cPOitem,nReceivingID
		PRIVATE nID_Detail
		IF VARTYPE(pStockTable)="C"
			cStockTable = pStockTable
		ELSE
			TrackError("Receiving:Receiving_Create_Incoming_Process(cTableName:NO TABLE ,nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")", "bad variable",PROGRAM(),LINENO(1))
			cStockTable = "N"
		ENDIF
		IF VARTYPE(pTableID_Detail)="N"
			nTableID_Detail = pTableID_Detail
			nID_Detail = nTableID_Detail
		ELSE
			nTableID_Detail = 0
			nID_Detail = nTableID_Detail
		ENDIF
		IF VARTYPE(pSOitem)="C"
			cSOitem = pSOitem
		ELSE
			cSOitem = "N"
		ENDIF
		IF VARTYPE(pPOitem)="C"
			cPOitem = pPOitem
		ELSE
			cPOitem= "N"
		ENDIF
		
		nReceivingID = 0
		
		*TrackMess("Receiving:Receiving_Create_Incoming_Process(cTableName:"+cStockTable+",nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")" )
		
		IF cStockTable = "N"
			RETURN 0
		ENDIF
		
		*nTableID_Detail = get_ID_Detail_with_POitem(pPOitem, pStockTable, ThisFormSet.nConnhandle)
		IF EMPTY(nTableID_Detail)
			nTableID_Detail = get_ID_Detail_with_SOitem(cSOitem, cStockTable, "", ThisFormSet.nConnhandle)
			TrackMess("Receiving:Receiving_Create_Incoming_Process(cTableName:"+cStockTable+",nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
		ENDIF
		
		IF EMPTY(nTableID_Detail)
			RETURN 0
		ENDIF
		
		PRIVATE nWO,nWO_Detail
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cPrc_Form, nPrc_PCs ,nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form = ''
		nPrc_PCs	= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		nPrc_Dim1	= 0
		nPrc_Dim2	= 0
		nPrc_Dim3	= 0
		
		PRIVATE cUser,cSalesPerson, cAllowSub,dStartDate,dDueDate, nID_Detail_Process 
		PRIVATE nPounds,npPc,cProcess_ID,cProcessor,cComment
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		cUser	= LEFT( SUBSTR(SYS(0), AT("#",SYS(0))+1 ), 20)
		cSalesPerson = PrepareSQLtxt( cUser,'SalesPerson', 20)
		cAllowSub	= "N"
		nPounds	= 0
		npPc		= 0
		dStartDate	= DATE()
		dDueDate	= DATE()
		nID_Detail_Process = 0
		
		IF Proper_PO_item(cPOitem)=Proper_PO_item("")
			cProcess_ID		= "INCOMING"  
		ELSE
			PRIVATE nShipWhere
			nShipWhere = Get_From_POitem(cPOitem,"ShipWhere",ThisFormSet.nConnhandle)
			IF nShipWhere = 1 OR nShipWhere = 5
				cProcess_ID		= "INCOMING"  
			ELSE
				cProcess_ID 	= 'NOT2HPA'
			ENDIF
		ENDIF
		
		cProcessor		= "RecvEdit "+LEFT( ALLTRIM(SYS(0))+" "+DTOC(date())+" "+time(), 20)
		cProcessor		= PrepareSQLtxt( cProcessor,'Processor',20)
		cComment 		= "Created INCOMING, no ReceivingID yet"
		*nReceivingID	= PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		
		
		*****************************
		*Check for Existing 'INCOMING' OR 'PARTRECV'
		
		IF USED('tmpPO_IDDP')
			USE IN tmpPO_IDDP
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID_Detail_Process FROM "
		DO CASE
		CASE cStockTable = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE cStockTable = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE cStockTable = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)+""
		*cSQL  = cSQL + " AND Process_ID = 'INCOMING'"
		cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
		cSQL = cSQL + " AND ReceivingID = 0"
		cSQL = cSQL + " AND PO_Item = '"+cPoItem+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_IDDP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_IDDP')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_IDDP")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_IDDP")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_IDDP')
		ENDIF
		
		IF USED('tmpPO_IDDP')
			IF RECCOUNT('tmpPO_IDDP') > 0
				nID_Detail_Process  = PrepareSQLnum(tmpPO_IDDP.ID_Detail_Process,'ID_Detail_Process',-3)
			ENDIF
			USE IN tmpPO_IDDP
			RETURN nID_Detail_Process
		ENDIF
		
		
		******************************
		PRIVATE nS_PU, nS_QTY, nP
		nS_PU	= 0
		nS_QTY = 0
		nP = 0
		
		IF USED('tmpPO_QTY')
			USE IN tmpPO_QTY
		ENDIF
		SELECT 0
		
		cSQL = "SELECT StockLst_QTY, StockLst_P, dbo.f_GetFormPU(Form) AS S_PU"
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPoItem+"')" 
		cSQL = cSQL + " AND ISNULL(Reconciled,0)=0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_QTY')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_QTY')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_QTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_QTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_QTY')
			TrackError(cSQL,"SQL ErrorWEB",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nS_QTY = PrepareSQLnum(tmpID_Detail_Process.StockLst_QTY,'S_QTY',-5)
				nP   = PrepareSQLnum(tmpID_Detail_Process.StockLst_P,'S_P',-5)
				nS_PU  = PrepareSQLnum(tmpID_Detail_Process.S_PU,'PU',-1)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		******************************
		IF nS_PU + nS_QTY + nP = 0
			SELECT Receiving
			RETURN 0
		ENDIF
		
		*****************************
		*Create Incoming Process
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		DO CASE
		CASE cTableName = "StockLst"
			cTBL = "S"
		CASE cTableName = "BrokerLst"
			cTBL = "B"
		CASE cTableName = "WIPLst"
			cTBL = "W"
		ENDCASE
		
		cSQLi = "EXEC dbo.p_Lst_Process_ins "
		cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
		cSQLi = cSQLi + ",@ID_Detail ="+STR(ID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@StartDate = '"+DTOC(DATETIME())+"'"	&&GetDate()"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"   &&'Y' Computer does not Select the Stock!
		
		cSQLi = cSQLi + ",@PU	= "+STR(nS_PU)
		cSQLi = cSQLi + ",@QTY	= "+STR(nS_QTY,18,4)
		cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
		
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		cSQLi = cSQLi + ",@WO 	= "+STR(nWO)
		cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)	
		
		cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
		cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
		cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
		cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
		
		cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPrc_PCs )
		cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
		cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
		cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
		cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nS_QTY,18,4)
		cSQLi = cSQLi + ",@Ordered_P = "+STR(0)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpID_Detail_Process')
			TrackError(cSQLi,"SQL Error",PROGRAM(),LINENO(1))
		ELSE
			*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"INFO: Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID))+' Receive_Edit.ReceivingSaveID_Master'+"Process_ID="+STR(tmpID_Detail_Process.EXP)+" StockTable="+cStockTable+" PO item="+cPOitem)
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		SELECT Receiving
		RETURN nID_Detail_Process 
	ENDPROC

	PROCEDURE create_incoming_process_show
		PARAMETERS cnNewTBL, nNewID, nNewID_Detail, nOld_ID, nOld_ID_Detail
		*THISFORMSET.Create_Incoming_Process_Show(cTBL,nTableID_Detail,nPounds)
		*creates an INCOMING process for the NEW balance due Stock entry
		*Returns nID_Detail_Process
		*Show_Recv_Order
		
		*IF VARTYPE(ThisFormSet.cTBL)!="C"
		*	TrackError("Receiving:Receiving_Create_Incoming_Process(cTBL:NO TABLE ,nID_Detail:"+STR(nID_Detail)+",nPounds"+")" ,"bad variable",PROGRAM(),LINENO(1))
		*	ThisFormSet.cTBL = "N"
		*	RETURN 0
		*ENDIF
		
		PRIVATE nID_Detail,cSOitem,cPOitem,nReceivingID
		nID_Detail = ThisFormSet.nID_Detail
		cSOitem = Proper_SO_item(ThisFormSet.cSOitem)
		cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
		nReceivingID = ThisFormSet.nReceivingID 
		
		
		IF nID_Detail = 0
			*nID_Detail = get_ID_Detail_with_SOitem(cSOitem, ThisFormSet.cTBL, "", ThisFormSet.nConnhandle)
			TrackMess("Show Received VS Ordered:Create_Incoming_Process(TBL:"+ThisFormSet.cTBL+",nID_Detail:"+STR(nID_Detail)+",cSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
			RETURN 0
		ENDIF
		
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisFormSet.nReceivingID ,'ReceivingID',-3)
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		*PRIVATE lTranAlreadySet, nProp, lOK 
		*nProp = SQLGETPROP(nConn, 'Transactions')
		*lTranAlreadySet = (nProp = 2)
		*lOK = .T.
		PRIVATE nQTY_Need, nLBS_Need, nPC_Need
		nQTY_Need	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtQTY_Need.Value,'QTY',-5)
		nLBS_Need	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtLBS_Need.Value,'Pounds',8,1)
		nPC_Need	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Need.Value,'PC',-3)
		
		PRIVATE cSalesPerson
		IF ThisFormSet.nWO_Detail > 0
			cSalesPerson = " HPA Shop WO"
		ELSE
			cSalesPerson = PrepareSQLtxt( AppSetup_Get_UserName( getSalesP_POitem( cPOitem, ThisFormSet.nConnhandle )),'SalesPerson', 20)
		ENDIF
		
		PRIVATE nWO, cProcess_ID, cProcessor, cComment
		nWO = 0 
		*nWO_Detail	= PrepareSQLnum(ThisFormSet.nWO_Detail,'WO_Detail',-3)
		cProcess_ID = "INCOMING"
		cProcessor	= LEFT( SUBSTR(SYS(0), AT("#",SYS(0))+1 ), 20)
		cComment 	= "Created INCOMING process with Received VS Ordered"
		
		PRIVATE cPrc_Form, nPU, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form = PrepareSQLtxt(ThisFormSet.Show_Recv_Order.txtForm.Value,'Form',2)
		nPU 	= nPU_Acct_Form(cPrc_Form ,ThisFormSet.nConnhandle)
		nPrc_Dim1	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtThck.Value,'DIM1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtSz2.Value,'DIM2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtSz3.Value,'DIM3',9,3)
		
		IF ThisFormSet.nWO_Detail > 0
			nOrdered_QTY = Get_From_WO_Detail(ThisFormSet.nWO_Detail,'fWeight',ThisFormSet.nConnhandle)
			nOrdered_P = 0
		ENDIF
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			nOrdered_QTY = Get_From_POitem(cPOitem, "StockLst_QTY", ThisFormSet.nConnhandle )
			nOrdered_P = Get_From_POitem(cPOitem, "StockLst_P", ThisFormSet.nConnhandle )
		ENDIF
		
		PRIVATE cAllowSub, dStartDate, dDueDate, nID_Detail_Process 
		cAllowSub	= "N"
		dtStartDate	= DATETIME()
		dDueDate	= DATE()
		nID_Detail_Process = 0
		
		IF Proper_PO_item(cPOitem)=Proper_PO_item("")
			cProcess_ID		= "INCOMING"  
		ELSE
			PRIVATE nShipWhere
			nShipWhere = Get_From_POitem(cPOitem,"ShipWhere",ThisFormSet.nConnhandle)
			IF nShipWhere = 1 OR nShipWhere = 5
				cProcess_ID		= "INCOMING"  
			ELSE
				cProcess_ID 	= 'NOT2HPA'
			ENDIF
		ENDIF
		
		*!*	*****************************
		*!*	*Check for Existing 'INCOMING'
		
		*!*	IF USED('tmpPO_IDDP')
		*!*		USE IN tmpPO_IDDP
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT ID_Detail_Process FROM "
		*!*	*DO CASE
		*!*	*CASE ThisFormSet.cTBL = "S"
		*!*		cSQL = cSQL + " dbo.StockLst_Process WITH(NOLOCK) "
		*!*	*CASE ThisFormSet.cTBL = "B"
		*!*	*	cSQL = cSQL + " dbo.BrokerLst_Process WITH(NOLOCK) "
		*!*	*CASE ThisFormSet.cTBL = "W"
		*!*	*	cSQL = cSQL + " dbo.WIPLst_Process WITH(NOLOCK) "
		*!*	*ENDCASE
		
		*!*	cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)+""
		*!*	cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'NOT2HPA' OR Process_ID = 'PARTRECV' )"
		*!*	*cSQL = cSQL + " AND ReceivingID = 0"
		*!*	*cSQL = cSQL + " AND PO_Item = '"+cPoItem+"'"
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_IDDP')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_IDDP')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_IDDP")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_IDDP")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_IDDP')
		*!*		RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*	ENDIF
		
		IF USED('tmpPO_IDDP')
			IF RECCOUNT('tmpPO_IDDP') > 0
				nID_Detail_Process  = PrepareSQLnum(tmpPO_IDDP.ID_Detail_Process,'ID_Detail_Process',-3)
			ENDIF
			USE IN tmpPO_IDDP
			RETURN nID_Detail_Process
		ENDIF
		
		
		******************************
		* Look for UNReconciled POitem
		IF Proper_PO_item(cPoItem) <> Proper_PO_item('')
			IF USED('tmpPO_QTY')
				USE IN tmpPO_QTY
			ENDIF
			SELECT 0
		
			cSQL = "SELECT StockLst_QTY, StockLst_P, dbo.f_GetFormPU(Form) AS S_PU"
			cSQL = cSQL + " ,Due_Min,Due_Max "
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPoItem+"')" 
			cSQL = cSQL + " AND ISNULL(Reconciled,0)=0"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_QTY')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_QTY')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_QTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_QTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_QTY')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		
			IF USED('tmpID_Detail_Process')
				IF RECCOUNT('tmpID_Detail_Process') > 0
		*			nQTY = PrepareSQLnum(tmpID_Detail_Process.StockLst_QTY,'S_QTY',-5)
					nP   = PrepareSQLnum(tmpID_Detail_Process.StockLst_P,'S_P',-5)
					nPU  = PrepareSQLnum(tmpID_Detail_Process.S_PU,'PU',-1)
					dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Max,'Due_Max')
					IF EMPTY(dDue_Max)
						dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Min,'Due_Min')
					ENDIF
				ENDIF
				USE IN tmpID_Detail_Process
			ENDIF
		ENDIF
		
		******************************
		*Look for UNReconciled WO_Detail
		IF ThisFormSet.nWO_Detail > 0
			IF USED('tmpPO_QTY')
				USE IN tmpPO_QTY
			ENDIF
			SELECT 0
		
			cSQL = "SELECT fWeight AS StockLst_QTY, 0 AS StockLst_P, dbo.f_GetFormPU(fForm) AS S_PU"
			cSQL = cSQL + " ,dDue_Date AS Due_Min, fFinishDate AS Due_Max "
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisFormSet.nWO_Detail)
			cSQL = cSQL + " AND ISNULL(fReconciled,0)=0"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_QTY')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_QTY')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_QTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_QTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_QTY')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		
			IF USED('tmpID_Detail_Process')
				IF RECCOUNT('tmpID_Detail_Process') > 0
		*			nQTY = PrepareSQLnum(tmpID_Detail_Process.StockLst_QTY,'S_QTY',-5)
					nP   = PrepareSQLnum(tmpID_Detail_Process.StockLst_P,'S_P',-5)
					nPU  = PrepareSQLnum(tmpID_Detail_Process.S_PU,'PU',-1)
					dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Max,'Due_Max')
					IF EMPTY(dDue_Max)
						dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Min,'Due_Min')
					ENDIF
				ENDIF
				USE IN tmpID_Detail_Process
			ENDIF
		ENDIF
		
		
		******************************
		IF nQTY_Need = 0
			SELECT Receiving
			*TrackMess("Show Received VS Ordered:Create_Incoming_Process(TBL:"+ThisFormSet.cTBL+",nID_Detail:"+STR(nID_Detail)+",cSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
			RecordError( 0, 'No QTY', PROGRAM(), LINENO(),"No QTY to Create Process" )
			RETURN 0
		ENDIF
		*****************************nQTY_Need, nLBS_Need, nPC_Need
		
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		cSQLi = "EXEC dbo.p_Lst_Process_ins "
		cSQLi = cSQLi + " @TBL = 'S'"
		cSQLi = cSQLi + ",@ID_Detail ="+STR(nOld_ID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = 'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB
		
		cSQLi = cSQLi + ",@PU	= "+STR(nPU)
		cSQLi = cSQLi + ",@QTY	= "+STR(nQTY_Need,18,4)
		cSQLi = cSQLi + ",@Pounds ="+STR(nLBS_Need,9,1)
		
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		cSQLi = cSQLi + ",@WO 	= "+STR(0)
		cSQLi = cSQLi + ",@WO_Detail= "+STR(ThisFormSet.nWO_Detail)
		
		cSQLi = cSQLi + ",@Process_ID = 'INCOMING'"	&&+cProcess_ID+"'"  
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID =0" &&+STR(nReceivingID) This is the new INCOMING
		
		cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPC_Need)
		cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
		cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
		cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
		cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nOrdered_QTY,18,4)
		cSQLi = cSQLi + ",@Ordered_P = "+STR(nOrdered_P,18,4)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpID_Detail_Process')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
				IF nID_Detail_Process > 0
		
					PRIVATE cText
					cText = "INFO: Created Incoming Process "+STR(nID_Detail_Process)+" Show_Recv_Order.Create_Incoming_Process "+" StockTable="+ThisFormSet.cTBL+CHR(13)
					IF Proper_PO_item(cPOitem)<>Proper_PO_item("")
						cText = cText +" PO item="+cPOitem
					ENDIF
					IF ThisFormSet.nWO_Detail > 0
						cText = cText +" WO Detail="+ALLTRIM(STR(ThisFormSet.nWO_Detail))
					ENDIF
					*cText = cText +" Process_ID = '"+cProcess_ID+"'"  
					MESSAGEBOX( cText,0+48,"INFO: Created Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
					TrackMess(cText)
				ENDIF
		
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		SELECT Receiving
		RETURN nID_Detail_Process 
	ENDPROC

	PROCEDURE create_receive_process
		PARAMETERS pStockTable,pTableID_Detail,pSOitem,pPOitem, pReceivingID, nPounds, nID_Detail_Process
		*ThisFormSet.Create_Receive_Process(cTableName,nTableID_Detail,pSOitem,pPOitem,pReceivingID)
		* NO ID_Detail, No PU, NO QTY  !!!
		* creates a Receiving History
		PRIVATE cStockTable,nTableID_Detail,cSOitem,cPOitem,nReceivingID
		PRIVATE nID_Detail
		IF VARTYPE(pStockTable)="C"
			cStockTable = pStockTable
		ELSE
			cStockTable = "N"
		ENDIF
		IF VARTYPE(pTableID_Detail)="N"
			nTableID_Detail = pTableID_Detail
			nID_Detail = nTableID_Detail
		ELSE
			nTableID_Detail = 0
			nID_Detail = nTableID_Detail
		ENDIF
		IF VARTYPE(pSOitem)="C"
			cSOitem = pSOitem
		ELSE
			cSOitem = "N"
		ENDIF
		IF VARTYPE(pPOitem)="C"
			cPOitem = pPOitem
		ELSE
			cPOitem= "N"
		ENDIF
		
		IF VARTYPE(pReceivingID) != "N"
			TrackError("bad variable","pReceivingID is not a NUMBER",PROGRAM(),LINENO(1))
		ENDIF
		IF VARTYPE(pReceivingID)="N"
			nReceivingID = pReceivingID
		ELSE
			nReceivingID = 0
		ENDIF
		
		nID_Detail_Process = PrepareSQLnum(nID_Detail_Process,'ID_Detail_Process',-3)
		
		
		TrackMess("Receiving:Create_Receive_Process(cTableName:"+cStockTable+",nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+",pReceivingID:"+STR(nReceivingID)+")" )
		
		IF cStockTable = "N"
			RETURN .F.
		ENDIF
		
		*nTableID_Detail = get_ID_Detail_with_POitem(pPOitem, pStockTable, ThisFormSet.nConnhandle)
		IF EMPTY(nTableID_Detail)
			nTableID_Detail = get_ID_Detail_with_SOitem(cSOitem, cStockTable, "", ThisFormSet.nConnhandle)
			TrackMess("Receiving:Create_Receive_Process(cTableName:"+cStockTable+",nTableID_Detail:"+STR(nTableID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+",pReceivingID:"+STR(nReceivingID)+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
		ENDIF
		
		IF EMPTY(nTableID_Detail)
			RETURN .F.
		ENDIF
		
		******************************************************************
		**Check that History has NO Process_ID	= 'Receiving'
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		cSQLi = "SELECT COUNT(*) AS CNTD FROM "
		DO CASE
		CASE cStockTable="B"
			cSQLi = cSQLi + " dbo.Ar_BrokerLst_Process_History "
		CASE cStockTable="S"
			cSQLi = cSQLi + " dbo.Ar_StockLst_Process_History "
		CASE cStockTable="W"
			cSQLi = cSQLi + " dbo.Ar_WIPLst_Process_History "
		ENDCASE
		cSQLi = cSQLi + " WHERE Process_ID	= 'Receiving' "
		cSQLi = cSQLi + " AND ID_Detail = "+STR(nID_Detail)
		IF nID_Detail_Process > 0
			cSQLi = cSQLi + " AND ID_Detail_Process = "+STR(nID_Detail_Process )
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC > 0
			IF USED('tmpID_Detail_Process')
				IF tmpID_Detail_Process.Cntd > 0
					USE IN tmpID_Detail_Process
					*Found in History
					RETURN .T.
				ENDIF
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		*************
		
		
		PRIVATE nWO,nWO_Detail
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cPrc_Form, nPrc_PCs ,nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form = ''
		nPrc_PCs	= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		nPrc_Dim1	= 0
		nPrc_Dim2	= 0
		nPrc_Dim3	= 0
		
		PRIVATE cUser,cSalesPerson, cAllowSub,dStartDate,dDueDate
		
		cUser	= LEFT( SUBSTR(SYS(0), AT("#",SYS(0))+1 ), 20)
		cSalesPerson = PrepareSQLtxt( cUser,'SalesPerson', 20)
		cAllowSub	= "Y"
		dStartDate	= DATE()
		dDueDate	= DATE()
		
		
		PRIVATE  cProcess_ID, cProcessor, cComment
		cProcess_ID		= "Receiving"  &&Used in Hitory Searches, DO NOT change
		cProcessor		= LEFT( ALLTRIM(SYS(0))+" "+DTOC(date())+" "+time(), 20)
		cProcessor		= PrepareSQLtxt( cProcessor,'Processor',20)
		cComment 		= "Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID))
		nReceivingID	= PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		
		PRIVATE nS_PU, nS_QTY
		nS_PU	= 0
		nS_QTY = 0
		
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		DO CASE
		CASE cTableName = "StockLst"
			cTBL = "S"
		CASE cTableName = "BrokerLst"
			cTBL = "B"
		CASE cTableName = "WIPLst"
			cTBL = "W"
		ENDCASE
		
		cSQLi = "EXEC dbo.p_Lst_Process_ins "
		cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
		cSQLi = cSQLi + ",@ID_Detail ="+STR(ID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@StartDate = '"+DTOC(DATETIME())+"'"	&&GetDate()"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"   &&'Y' Computer does not Select the Stock!
		
		cSQLi = cSQLi + ",@PU	= "+STR(nS_PU)
		cSQLi = cSQLi + ",@QTY	= "+STR(nS_QTY,18,4)
		cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,18,4)
		
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		cSQLi = cSQLi + ",@WO 	= "+STR(nWO)
		cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)	
		
		cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
		cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
		cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
		cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
		
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nS_QTY,18,4)
		cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPrc_PCs )
		cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
		cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
		cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
		cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nS_QTY,18,4)
		cSQLi = cSQLi + ",@Ordered_P = "+STR(0)
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpID_Detail_Process')
			TrackError(cSQLi,"SQL Error",PROGRAM(),LINENO(1))
		ELSE
			PRIVATE cText
			cText = "INFO: Created INCOMING Process"+CHR(13)+"for Balance after this ReceivingID "+ALLTRIM(STR(nReceivingID))+" Process_ID="+STR(tmpID_Detail_Process.EXP)+;
				CHR(13)+" StockTable="+cStockTable+" PO item="+cPOitem+""
			TrackMess(cText)
			*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cText)
		ENDIF
		
		*--Check for SO/WO_Detail SELECT Process to apply if new stock??
		
		
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		
		
	ENDPROC

	PROCEDURE del_incomproc
		*ThisFormSet.Del_IncomProc()
		
		*ThisFormSet.nReceivingID 2 is filled by Update_PO Status()
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisFormSet.nReceivingID ,'ReceivingID',-3)
		
		IF nReceivingID < 1
			*Only Incoming Process with ReceivingID will be deleted.
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		*cSQL = " DELETE FROM "
		cSQL = " UPDATE "
		DO CASE
		CASE ThisFormSet.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisFormSet.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisFormSet.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
		*cSQL = cSQL + " WHERE ( PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		*IF nReceivingID2 > 0
		*	cSQL = cSQL + " OR ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ReceivingID = "+STR(nReceivingID)
		*ENDIF
		*cSQL = cSQL + " ) "
		cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
	ENDPROC

	PROCEDURE getby_nwo
		PARAMETERS nWO
		*ThisFormSet.GetBy_nWO(nWO) ????
		
		MESSAGEBOX("Work In Progress",16,"This has not been Programmed")
		
	ENDPROC

	PROCEDURE getby_nwo_detail
		PARAMETERS pWO_Detail
		*ThisFormSet.GetBy_nWO_Detail(nWO_Detail ) ????
		*Receive_Edit
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
		IF nWO_Detail < 1
			MESSAGEBOX("No WO Detail",16,"cannot continue.")
			RETURN .F.
		ENDIF
		
		PRIVATE  nReceivingID
		nReceivingID = PrepareSQLnum(ThisFormSet.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		
		IF Count_WODinWO_Detail( nWO_Detail, ThisFormSet.nConnhandle, "NOTCANCELLED" ) = 0
			MESSAGEBOX("The WO_Detail '"+STR(nWO_Detail)+"'"+CHR(13)+" entered in Receiving "+ALLTRIM(STR(nReceivingID))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for problems.",48,"Weird")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The WO_Detail '"+STR(nWO_Detail)+"' entered in Receiving "+ALLTRIM(STR(nReceivingID))+" does not Exists!")
			RETURN .F.
		ENDIF
			
		***************************
		PRIVATE nID_Detail, cMess
		nID_Detail = get_ID_Detail_from_WOD(nWO_Detail, ThisFormSet.nConnhandle)
		IF nID_Detail = 0
			cMess= "The WO_Detail '"+ALLTRIM(STR(nWO_Detail))+"'"+CHR(13)
			IF nReceivingID > 0
				cMess=cMess+" for Receiving "+ALLTRIM(STR(nReceivingID))+CHR(13)
			ENDIF
			cMess=cMess+CHR(13)+"No INCOMING Process to receive!"+CHR(13)+CHR(13)
			cMess=cMess+"You will not be able to adjust the Stock like Heat."+CHR(13)+CHR(13)
			cMess=cMess+"Use the WorkOrder Detail program to"+CHR(13)
			cMess=cMess+"create a Stock Incoming Process to Receive to!"
			MESSAGEBOX(cMess,48,"INFO")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
			RETURN .F.
		ENDIF
		
		***************************
		IF USED('tmpRecv_WOD')
			USE IN tmpRecv_WOD
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT COUNT(*) AS CNTD"
		cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		cSQL = cSQL + " WHERE WO_Detail = "+STR(nWO_Detail)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRecv_WOD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRecv_WOD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRecv_WOD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRecv_WOD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRecv_WOD')
			RETURN
		ENDIF
		
		
		IF USED('tmpRecv_WOD')
			IF RECCOUNT('tmpRecv_WOD') > 0
				IF PrepareSQLnum(tmpRecv_WOD.CNTD,'CNTD',-3) > 0
					MESSAGEBOX("This is not the first WO_Detail="+ALLTRIM(STR(nWO_Detail))+" in the Receiving Table!"+CHR(13)+"Counted "+STR(PrepareSQLnum(tmpRecv_WOD.CNTD,'CNTD',-3)),64,"Found WO_Detail in Receiving.")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"This is not the first WO_Detail="+ALLTRIM(STR(nWO_Detail))+" in the Receiving Table!"+CHR(13)+"Counted "+STR(PrepareSQLnum(tmpRecv_WOD.CNTD,'CNTD',-3)))
				ENDIF
			ENDIF
		
			USE IN tmpRecv_WOD
		ENDIF
		**************************
		
		PRIVATE nMess
		nMess = 0
		*IF ThisFormSet.cWhat <> "ADD"
			PRIVATE cDescription,cSpecs,cComments
			cDescription = PrepareSQLtxt(ThisFormSet.Receive_Edit.edtDescription.Value,'Description',-1)
			cSpecs		= PrepareSQLtxt(ThisFormSet.Receive_Edit.edtSpecs.Value,'Specs',-1)
			cComments	= PrepareSQLtxt(ThisFormSet.Receive_Edit.edtComments.Value,'Comments',-1)
			
			IF LEN( ALLTRIM(cDescription)+ALLTRIM(cSpecs)+ALLTRIM(cComments)) > 0
				nMess = MESSAGEBOX("Do you want to retreive the WO Detail "+ALLTRIM(STR(nWO_Detail))+" data."+CHR(13)+"over write data already on form?",4+32,"Over write?")
				IF nMess <> 6
					RETURN
				ENDIF
			ENDIF
		*ENDIF
		
		***************************
		
		IF USED('tmpWOD_Recv')
			USE IN tmpWOD_Recv
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT * FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
		cSQL = cSQL + " WHERE WO_Detail = "+STR(nWO_Detail)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpWOD_Recv')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpWOD_Recv')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpWOD_Recv")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpWOD_Recv")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpWOD_Recv')
			RETURN
		ENDIF
		
		IF USED('tmpWOD_Recv')
			*ThisFormSet.Receive_Edit.txtReceivingID.Value = 
			
			ThisFormSet.Receive_Edit.txtWO.Value		= PrepareSQLnum(tmpWOD_Recv.WO,'WO',-3)
			*ThisFormSet.Receive_Edit.txtWO_Detail.Value	= PrepareSQLnum(tmpWOD_Recv.WO_Detail,'WO_Detail',-3)
			
			IF EMPTY(ThisFormSet.Receive_Edit.txtReceived.Value)
				ThisFormSet.Receive_Edit.txtReceived.Value = PrepareSQLDate(tmpWOD_Recv.fFinishDate,'FinishDate')
			ENDIF
			IF EMPTY(ThisFormSet.Receive_Edit.txtReceived.Value)
				ThisFormSet.Receive_Edit.txtReceived.Value = DATE()
			ENDIF
			*Show the WO_Detail
			
			*ThisFormSet.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisFormSet.cPOitem)
			*ThisFormSet.cSOitem			= PrepareSQLtxt(tmpWOD_Recv.SOitem,'SOitem',10)
			*ThisFormSet.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(ThisFormSet.cSOitem)
			*ThisFormSet.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(ThisFormSet.cSOitem)
						
			ThisFormSet.Receive_Edit.txtAlloy.Value		= PrepareSQLtxt(tmpWOD_Recv.fAlloy,'Alloy',12)
			ThisFormSet.Receive_Edit.txtHeat.Value		= PrepareSQLtxt(tmpWOD_Recv.fHeat,'Heat',50)
			ThisFormSet.Receive_Edit.txtLot.Value		= "HPA "+LEFT(PrepareSQLtxt(tmpWOD_Recv.FinishM,'FinishM',10),1)+ALLTRIM(PrepareSQLtxt(tmpWOD_Recv.FinishLot,'FinishLot',10))
			ThisFormSet.Receive_Edit.chkCert.Value		= 1		&&IIF(tmpWOD_Recv.Cert,1,0)
			ThisFormSet.Receive_Edit.txtPieces.Value	= tmpWOD_Recv.fPieces
			ThisFormSet.Receive_Edit.edtDescription.Value = ThisFormSet.Receive_Edit.StripDescription( tmpWOD_Recv.fDescript )
			
			ThisFormSet.Receive_Edit.edtSpecs.Value		= tmpWOD_Recv.fSpec
			ThisFormSet.Receive_Edit.edtComments.Value 	= ''		&&tmpWOD_Recv.Comments
			ThisFormSet.Receive_Edit.txtInit.Value		= ''		&&tmpWOD_Recv.Init
			ThisFormSet.Receive_Edit.txtDate.Value		= DTOC(DATE())	&&DTOC(tmpWOD_Recv.Date)
			ThisFormSet.Receive_Edit.chkPass.Value		= IIF(tmpWOD_Recv.PassTest,1,0)
			ThisFormSet.Receive_Edit.chkGoodPapers.Value = 1		&&IIF(tmpWOD_Recv.GoodPapers,1,0)
			
			ThisFormSet.Receive_Edit.txtActualW.Value	= tmpWOD_Recv.fWeight
			ThisFormSet.Receive_Edit.txtBillW.Value		= tmpWOD_Recv.fWeight
			
			PRIVATE nAcct_PU 
			nAcct_PU = 1 	&&PrepareSQLnum(tmpWOD_Recv.R_PU,'S_PU',-1)
			ThisFormSet.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisFormSet.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormSet.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			
			ThisFormSet.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpWOD_Recv.fWeight,'S_QTY',-5)
			ThisFormSet.Receive_Edit.txtAcct_P.Value	= 0	&&PrepareSQLnum(tmpWOD_Recv.R_P,'S_P',-5)
			
			ThisFormSet.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpWOD_Recv.fWeight,'PO_QTY',-5)
			ThisFormSet.Receive_Edit.txtPO_P.Value		= 0		&& PrepareSQLnum(tmpWOD_Recv.PO_P,'PO_P',-5)
			
			PRIVATE nVend_PU 
			nVend_PU = 1		&&PrepareSQLnum(tmpWOD_Recv.PO_PU,'PO_PU',-1)
			ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
			ThisFormSet.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
			ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
		
				
			*ThisFormSet.Receive_Edit.lblAcct_PriceU.Caption	= Get_PriceU_from_nPU(PrepareSQLnum(tmpWOD_Recv.R_PU,'R_PU',-1))
			nPO_Prev = 0		&&PrepareSQLnum(ThisFormSet.Receive_Edit.txtPO_P.Value,'Recv_P',-5)
			nPO_P = 0		&&PrepareSQLnum(tmpWOD_Recv.R_P,'Recv_P',-5)
			
		
			ThisFormSet.Receive_Edit.txtVendor.Value = 'HPA'	&&PrepareSQLtxt(tmpWOD_Recv.Vendor,'Vendor',30,.F.,.T.)
			*ThisFormSet.Receive_Edit.txtVendor.Value	= tmpWOD_Recv.Vendor
			
			*tmpWOD_Recv.Cancelled
			*tmpWOD_Recv.WhoAdd
			*tmpWOD_Recv.WhenAdd
			
			ThisFormSet.Receive_Edit.txtRejectPC.Value		= 0		&&tmpWOD_Recv.RejectPC
			ThisFormSet.Receive_Edit.txtRejectReason.Value	= ''		&&tmpWOD_Recv.RejectReason
			ThisFormSet.Receive_Edit.txtRMA_No.Value		= 0		&&tmpWOD_Recv.RMA_No
			ThisFormSet.Receive_Edit.txtRMA_Detail.Value	= 0
			
			ThisFormSet.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(0,'Services')
			ThisFormSet.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
			ThisFormSet.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
			PRIVATE nNewID, nNewID_Detail, cNewTBL
			nNewID		= 0	&&PrepareSQLnum(tmpWOD_Recv.ID_Master,'ID_Master',-3)
			nNewID_Detail	= PrepareSQLnum(tmpWOD_Recv.fID_Detail,'ID_Detail',-3)
			cNewTBL		= PrepareSQLtxt(tmpWOD_Recv.fTBL,'TBL',1)
			
			IF LEN(cNewTBL)=0
				cNewTBL = "S"
			ENDIF
			ThisFormSet.Receive_Edit.txtTBL.Value = cNewTBL
			
			IF nNewID_Detail > 0
				ThisFormSet.Receive_Edit.txtID_Detail.Value	= nNewID_Detail
				
				IF nNewID = 0
					nNewID = GetIDfromID_Detail( nNewID_Detail, cNewTBL, ThisFormSet.nConnhandle)
				ENDIF
			ENDIF
			IF nNewID > 0
				ThisFormSet.Receive_Edit.txtID_Master.Value	= nNewID
			ENDIF
			
			IF nNewID > 0 AND nNewID_Detail > 0 AND LEN(cNewTBL) > 0 AND LEN(PrepareSQLtxt(tmpWOD_Recv.fHeat,'Heat',50)) = 0
				*Get Heat Lot
				
				cHeat = getStk_Heat(nNewID,"S",ThisFormSet.nConnhandle)
				cLot = getStk_HeatLot(nNewID,"S",ThisFormSet.nConnhandle)
				IF LEN(cHeat) > 0 
					IF UPPER(cHeat) = "DUE IN"
						*TRY TO find Heat in WO
						cHeat = getHeat_WO(0,nWO_Detail,ThisFormSet.nConnhandle)
					ENDIF
					IF NOT UPPER(cHeat) = "DUE IN"
						ThisFormSet.Receive_Edit.txtHeat.Value	= cHeat
					ENDIF
				ENDIF
				IF LEN(cLot) > 0
					IF NOT ( "HPA" $ UPPER(cLot) OR "HPA " $ UPPER(cLot) )
						cLot = "HPA "+cLot
					ENDIF
					ThisFormSet.Receive_Edit.txtLot.Value	= cLot 
				ENDIF
				
				PRIVATE nDI_D_P 
				nDI_D_P = getID_D_P_Incoming("WO_Detail",nWO_Detail,cNewTBL,ThisFormSet.nConnhandle)
				IF nDI_D_P  > 0
					ThisFormSet.Receive_Edit.txtID_Detail_Process.Value = nDI_D_P
				ENDIF
				*ThisFormSet.Receive_Edit.txtLot.Value		= "HPA "+LEFT(PrepareSQLtxt(tmpWOD_Recv.FinishM,'FinishM',10),1)+
				
			ENDIF
			*********************
			PRIVATE cForm
			cForm = PrepareSQLtxt(tmpWOD_Recv.fForm,'Form',2) 
			ThisFormSet.Receive_Edit.txtForm.Value = cForm 
			
			IF nAcct_PU = 0
				nAcct_PU = nPU_Acct_Form(cForm,ThisFormSet.nConnhandle)
			ENDIF
			ThisFormSet.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisFormSet.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormSet.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		
			*need to get from dbo.PurchareOrder
			PRIVATE nCust_PU
			nCust_PU = 1		&&PrepareSQLnum( GetOrder_PUfrom_POitem(ThisFormSet.cPOitem,ThisFormSet.nConnhandle),'PO_PU',-1)	&&Cust
			ThisFormSet.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
			ThisFormSet.Receive_Edit.lblPO_PUstr.Caption 	= Get_PUstr_from_nPU( nCust_PU, ThisFormSet.nConnhandle)
			ThisFormSet.Receive_Edit.lblPO_PUlabel.Caption = Get_Label_from_nPU( nCust_PU, ThisFormSet.nConnhandle)
			
		
			IF USED('tmpWOD_Recv')
				USE IN tmpWOD_Recv
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE getby_receivingid
		*ThisFormSet.getBy_ReceivingID()
		*Receive_Edit
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID < 1
			TrackError("bad variable","ReceivingID is not a NUMBER",PROGRAM(),LINENO(1))
			MESSAGEBOX("No ReceivingID for GetBy_ReceivingID( )",0,"Error")
			RecordError(0,"No ReceivingID for GetBy_ReceivingID( )" ,PROGRAM(),LINENO(1),"No ReceivingID for GetBy_ReceivingID( )" )
			RETURN .F.
		ENDIF
		
		PRIVATE cPOitem
		IF USED('tmpReceivingPOitem')
			cPOitem = PrepareSQLtxt(tmpReceivingPOitem.POitem,'POitem',12)
		ELSE
			cPOitem = PrepareSQLtxt( Get_From_Receiving_ID(nReceivingID , "POitem", ThisFormSet.nConnhandle ), 'POitem',12)
		ENDIF
		
		*get PO info -even if not Metal -This function is to retreive All RID info.
		*IF Proper_PO_Item(ThisFormSet.cPOitem) <> Proper_PO_Item(cPOitem)
		*	IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
				ThisFormset.Receive_Edit.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem)
				ThisFormSet.cPOitem = cPOitem 
		*	ENDIF
		*ENDIF
		
		***************************
		
		IF USED('tmpReceivingPOitem')
			USE IN tmpReceivingPOitem
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT * FROM dbo.Receiving WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN
		ENDIF
		
		
		IF USED('tmpReceivingPOitem')
			*ThisFormset.Receive_Edit.txtReceivingID.Value = 
			
			ThisFormset.Receive_Edit.txtWO.Value		= PrepareSQLnum(tmpReceivingPOitem.WO,'WO',-3)
			ThisFormset.Receive_Edit.txtWO_Detail.Value	= PrepareSQLnum(tmpReceivingPOitem.WO_Detail,'WO_Detail',-3)
			
			ThisFormset.Receive_Edit.txtReceived.Value = PrepareSQLDate(tmpReceivingPOitem.Received,'Received')
			
			*Show the POitem
			
			ThisFormset.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisFormSet.cPOitem)
			ThisFormSet.cSOitem			= PrepareSQLtxt(tmpReceivingPOitem.SOitem,'SOitem',10)
			ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(ThisFormSet.cSOitem)
			ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(ThisFormSet.cSOitem)
						
			*ThisFormSet.ChecknHpaPO		= Proper_PO_Item_PO(ThisFormSet.cPOitem)
			*ThisFormSet.ChecknItemPO		= Proper_PO_Item_Item(ThisFormSet.cPOitem)
		
			ThisFormset.Receive_Edit.txtAlloy.Value		= tmpReceivingPOitem.Alloy
			ThisFormset.Receive_Edit.txtHeat.Value		= tmpReceivingPOitem.Heat
			ThisFormset.Receive_Edit.txtLot.Value		= tmpReceivingPOitem.Lot
			
			ThisFormset.Receive_Edit.chkCert.Value		= IIF(tmpReceivingPOitem.Cert,1,0)
			ThisFormset.Receive_Edit.txtPieces.Value	= tmpReceivingPOitem.Pieces
			ThisFormset.Receive_Edit.edtDescription.Value = tmpReceivingPOitem.Description
			
			ThisFormset.Receive_Edit.edtSpecs.Value		= tmpReceivingPOitem.Specs
			ThisFormset.Receive_Edit.edtComments.Value 	= tmpReceivingPOitem.Comments
			ThisFormset.Receive_Edit.txtInit.Value		= tmpReceivingPOitem.Init
			ThisFormset.Receive_Edit.txtDate.Value		= DTOC(tmpReceivingPOitem.Date)
			ThisFormset.Receive_Edit.chkPass.Value		= IIF(tmpReceivingPOitem.Pass,1,0)
			ThisFormset.Receive_Edit.chkGoodPapers.Value = IIF(tmpReceivingPOitem.GoodPapers,1,0)
			
			ThisFormset.Receive_Edit.txtActualW.Value	= tmpReceivingPOitem.ActualW
			ThisFormset.Receive_Edit.txtBillW.Value		= tmpReceivingPOitem.BillW
			
			PRIVATE nAcct_PU 
			nAcct_PU = PrepareSQLnum(tmpReceivingPOitem.R_PU,'S_PU',-1)
			ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			
			ThisFormset.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpReceivingPOitem.R_QTY,'S_QTY',-5)
			ThisFormset.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpReceivingPOitem.R_P,'S_P',-5)
			
			ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5)
			ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOitem.PO_P,'PO_P',-5)
			
			PRIVATE nVend_PU 
			nVend_PU = PrepareSQLnum(tmpReceivingPOitem.PO_PU,'PO_PU',-1)
			IF nVend_PU > 0 
			*	IF NOT ThisFormSet.cWhat = 'EDIT'
			*		IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
			*		ENDIF
			*	ENDIF		
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',-1)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
						
			ELSE
				*Old Receive - Get by POitem
				IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
					IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
						nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
						ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',-1)
						ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
						ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
						
						PRIVATE nVend_QTY, nVend_P
						nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_P", ThisFormSet.nConnhandle ), 'Order_PU',-1)
						ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
						
						nVend_QTY = PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'QTY',-5)
						*nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisFormSet.nConnhandle)
						ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
					ELSE
						ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',-1)
						ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(1, ThisFormSet.nConnhandle)
						ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisFormSet.nConnhandle)
					ENDIF								
		
				ELSE
					ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',-1)
					ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(1, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisFormSet.nConnhandle)
				ENDIF								
			ENDIF
							
		
			***
			PRIVATE nCust_PU 
			nCust_PU = nVend_PU 
			
			IF nCust_PU > 0
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',-1)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nCust_PU, ThisFormSet.nConnhandle)
			
			ELSE
				*Find PU
				IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
					IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
						nCust_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
					ENDIF
				ENDIF
				
				IF nCust_PU = 0
					IF Proper_SO_Item(ThisFormSet.cSOitem) <> Proper_SO_Item("")
						nCust_PU = PrepareSQLnum( Get_From_AllQuote_SOitem (ThisFormSet.cSOitem, "Q_PU", ThisFormSet.nConnhandle ), 'Q_PU',-1)
					ENDIF
				ENDIF
				
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',-1)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nCust_PU, ThisFormSet.nConnhandle)
				
			ENDIF
			
		
			nPO_Prev = PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_P.Value,'Recv_P',-5)
			nPO_P = PrepareSQLnum(tmpReceivingPOitem.R_P,'Recv_P',-5)
			
			IF nPO_P = 0
				*ThisFormset.Receive_Edit.txtPO_P.Value	= PrepareSQLnum(nPO_P,'Recv_P',-5)
			ELSE
				IF nPO_Prev > 0 AND NOT ThisFormSet.cWhat = 'EDIT'
					IF ROUND(nPO_Prev,1) <> ROUND(nPO_P,1)
						PRIVATE cMess
						cMess = "The PO item has a Price of "+CHR(13)
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.PO_PU,'PO_PU',-1) ,1,0)+" "
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5) ,10,2)+" * "
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.PO_P,'PO_P',-5) ,10,2)+" = "
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.PO_P*tmpReceivingPOitem.PO_QTY,'Total',-5) ,10,2)+" "
						*cMess = cMess +STR(nPO_Prev,10,2)+CHR(13)
						cMess = cMess +CHR(13)
						cMess = cMess +" The receive has a price of "+CHR(13)
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.R_QTY,'R_PU',-1) ,1,0)+" "
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.R_QTY,'R_QTY',-5) ,10,2)+" * "
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.R_P,'R_P',-5) ,10,2)+" = "
						cMess = cMess +STR( PrepareSQLnum(tmpReceivingPOitem.R_P+tmpReceivingPOitem.R_QTY,'Total',-5) ,10,2)+" "
						
						*cMess = cMess +STR(nPO_P,10,2)+CHR(13)
		
						IF MESSAGEBOX(cMess +CHR(13)+"Do you want to keep the PO item price?",4+32,"Use PO item") = 6
							*nPO_Prev
						ELSE
							ThisFormset.Receive_Edit.txtPO_P.Value = PrepareSQLnum(tmpReceivingPOitem.R_P,'Recv_P',-5)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
			ThisFormset.Receive_Edit.txtVendor.Value = PrepareSQLtxt(tmpReceivingPOitem.Vendor,'Vendor',30,.F.,.T.)
			*ThisFormset.Receive_Edit.txtVendor.Value	= tmpReceivingPOitem.Vendor
			
			*tmpReceivingPOitem.Cancelled
			*tmpReceivingPOitem.WhoAdd
			*tmpReceivingPOitem.WhenAdd
			
			ThisFormset.Receive_Edit.txtRejectPC.Value		= tmpReceivingPOitem.RejectPC
			ThisFormset.Receive_Edit.txtRejectReason.Value	= tmpReceivingPOitem.RejectReason
			ThisFormset.Receive_Edit.txtRMA_No.Value		= tmpReceivingPOitem.RMA_No
			ThisFormset.Receive_Edit.txtRMA_Detail.Value	= tmpReceivingPOitem.RMA_Detail
			
		*	IF PrepareSQLnum(tmpReceivingPOitem.RMA_No,'RMA_No',-3) > 0
		*		ThisFormset.Receive_Edit.shpRMA.Visible = .T.
		*		ThisFormset.Receive_Edit.lblReject.Visible = .T.
		*		ThisFormset.Receive_Edit.lblRejectPC.Visible = .T.
		*		ThisFormset.Receive_Edit.txtRejectPC.Visible = .T.
		*		ThisFormset.Receive_Edit.txtRejectReason.Visible = .T.
		*	ENDIF
			
			ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(tmpReceivingPOitem.Services,'Services')
			ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(tmpReceivingPOitem.ConvServ,'ConvServ') 
			ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(tmpReceivingPOitem.Equipment,'Equipment')
			 
			PRIVATE nNewID, nNewID_Detail, cNewTBL
			nNewID			= PrepareSQLnum(tmpReceivingPOitem.ID_Master,'ID_Master',-3)
			nNewID_Detail	= PrepareSQLnum(tmpReceivingPOitem.ID_Detail,'ID_Detail',-3)
			cNewTBL			= PrepareSQLtxt(tmpReceivingPOitem.StockTable,'TBL',1)
			
			IF nNewID > 0
				ThisFormset.Receive_Edit.txtID_Master.Value	= nNewID
			ENDIF
			IF nNewID_Detail > 0
				ThisFormset.Receive_Edit.txtID_Detail.Value	= nNewID_Detail
			ENDIF
			IF LEN(cNewTBL)>0 AND cNewTBL <> "N"
				ThisFormset.Receive_Edit.txtTBL.Value		= cNewTBL
			ENDIF
			
			*Test ID ID_Detail TBL
			IF nNewID > 0 AND  nNewID_Detail > 0
				PRIVATE cTBL2
				cTBL2 = get_TBLwithID_ID_Detail(nNewID, nNewID_Detail, ThisFormSet.nConnhandle)
				 IF LEN(cTBL2) > 0
					IF cNewTBL <> cTBL2
						IF LEN(ALLTRIM(cTBL2)) > 1
							WAIT WINDOW "Found in History!!" NOWAIT
						ENDIF
						ThisFormset.Receive_Edit.txtTBL.Value = LEFT(cTBL2,1)
					ENDIF
				ENDIF
			ENDIF
			**
			IF nNewID > 0 AND  nNewID_Detail > 0 AND LEN(ALLTRIM(cNewTBL)) > 0
				IF pcWhat = "EDIT" OR pcWhat = "VIEW"
					ThisFormset.Receive_Edit.cmdClone.Visible = .T.
					*ThisFormSet.lClone = .T.
				ENDIF
			ENDIF
			
			***
			PRIVATE cForm
			cForm = PrepareSQLtxt(tmpReceivingPOitem.form,'Form',2) 
			IF LEN(cForm) = 0
				IF Proper_SO_Item(ThisFormSet.cSOitem) <> Proper_SO_Item("")
					cForm = PrepareSQLtxt( Get_From_AllQuote_SOitem (ThisFormSet.cSOitem, "Form", ThisFormSet.nConnhandle ), 'Form', 2)
					ThisFormset.Receive_Edit.txtForm.Value = cForm
				ENDIF
			ENDIF
		
			IF nAcct_PU = 0
				nAcct_PU = nPU_Acct_Form(cForm,ThisFormSet.nConnhandle)
			ENDIF
			
			ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'PU',-1)	
			ThisFormset.Receive_Edit.lblAcct_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
				
			IF USED('tmpReceivingPOitem')
				USE IN tmpReceivingPOitem
			ENDIF
			
			**validate data
		*!*		IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
		*!*	*		IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle )=0
		*!*			IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) = 0
		*!*				MESSAGEBOX("The POitem '"+ThisFormSet.cPOitem+"'"+CHR(13)+" entered in Receiving "+ALLTRIM(STR(nReceivingID))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
		*!*				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem '"+ThisFormSet.cPOitem+"' entered in Receiving "+ALLTRIM(STR(nReceivingID))+" does not Exists!")
		*!*			ENDIF
		*!*		ENDIF
			IF Proper_SO_item(ThisFormSet.cSOitem) <> Proper_SO_item('')
				IF Count_SOIteminSales( ThisFormSet.cSOitem, ThisFormSet.nConnhandle )=0
					MESSAGEBOX("The SO item '"+ThisFormSet.cSOitem+"'"+CHR(13)+" entered in Receiving "+ALLTRIM(STR(nReceivingID))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisFormSet.cSOitem+"' entered in Receiving "+ALLTRIM(STR(nReceivingID))+" does not Exists!")
				ENDIF
			ENDIF
			
			*Check nWO_Detail
			
		ENDIF
		
		
		*******
		*Receive could be old,  update with the new PO field data
		IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
		
			IF PrepareSQLnum(ThisFormset.Receive_Edit.lblPO_PU.Caption,'PU',-1) < 1
				nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU ,'PO_PU',-1)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
			ENDIF
			IF PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_QTY.Value,'PO_QTY',-5) < .1
				nVend_QTY = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_QTY", ThisFormSet.nConnhandle ), 'Order_QTY',-5)
				ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
			ENDIF		
			IF PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_P.Value,'PO_P',-5) < 1
				nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_P", ThisFormSet.nConnhandle ), 'Order_P',-5)
				ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
			ENDIF
			
			ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU ,'PO_PU',-1)
			ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
		ENDIF
	ENDPROC

	PROCEDURE getby_stk_detail
		*ThisFormSet.GetBy_STK_Detail()
		*Receive_Edit
		*See if this ID_Detail can get the correct ReceivingID
		PRIVATE nID_Detail, cTBL, nReceivingID 
		nID_Detail = ThisFormset.Receive_Edit.txtID_Detail.Value
		cTBL = PrepareSQLtxt(ThisFormset.Receive_Edit.txtTBL.Value,'TBL',1)
		IF EMPTY(cTBL)
			cTBL = PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		ENDIF
		nReceivingID = 0
		
		PRIVATE cSQL, nSQLExec
		IF USED("tmpRcv_ID_Detail")
			USE IN tmpRcv_ID_Detail
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ReceivingID "
		IF cTBL = 'S'
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
		ELSE
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
		ENDIF
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail )
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRcv_ID_Detail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRcv_ID_Detail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRcv_ID_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRcv_ID_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRcv_ID_Detail' )
		ENDIF
		
		IF USED('tmpRcv_ID_Detail')
			IF RECCOUNT('tmpRcv_ID_Detail') > 0	
				nReceivingID = tmpRcv_ID_Detail.ReceivingID 
			ENDIF
			USE IN tmpRcv_ID_Detail
		ENDIF
		
		IF nReceivingID > 0
		
			*Read in by the ReceivingID
			ThisFormset.Receive_Edit.txtReceivingID.Value = nReceivingID 
			ThisFormSet.getBy_ReceivingID()
			RETURN .T.
		
		ENDIF
		
		*******************************
		*** New Add, No ReceiveID
		
		PRIVATE lFoundIncoming 
		lFoundIncoming = .F.
		
		*Look for 'INCOMING' or 'PartRecv' as Process_ID
		IF USED('tmpStk')
			USE IN tmpStk
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT * "
		DO CASE
		CASE cTBL = 'S'
			cSQL = cSQL + " FROM dbo.StockLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail"
		CASE cTBL = 'B'
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail"
		CASE cTBL = 'W'
			cSQL = cSQL + " FROM dbo.WIPLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail"
		ENDCASE
		cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail )
		cSQL = cSQL + " AND (P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'PARTRECV')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStk')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStk')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStk")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStk")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpStk')
			lFoundIncoming = .T.
			RETURN .F.
		ENDIF
		
		
		
		
		**********************************************
		* General search
		*nID_Detail, cTBL
		IF NOT lFoundIncoming 
			IF USED('tmpStk')
				USE IN tmpStk
			ENDIF
		
			PRIVATE nSQLEXEC, cSQL
			cSQL = "SELECT * ,P.PO_item AS PPOitem "
			cSQL = cSQL + ",(SELECT ISNULL(PO.Order_P,0) FROM dbo.PurchaseOrder PO WITH(NoLock) WHERE PO.POitem = P.PO_Item ) AS Order_P "
			DO CASE
			CASE cTBL = 'S'
				cSQL = cSQL + " FROM dbo.StockLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail"
			CASE cTBL = 'B'
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail"
			CASE cTBL = 'W'
				cSQL = cSQL + " FROM dbo.WIPLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail"
			ENDCASE
			cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail )
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStk')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStk')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStk")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStk")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpStk')
				RETURN .F.
			ENDIF
		ENDIF
		
		********************************
		*See what records where found
		PRIVATE nRecCount, nRecNum, nMess
		
		IF USED('tmpStk')
			nRecCount = RECCOUNT('tmpStk')
			
			ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLnum(tmpStk.ReceivingID,'ReceivingID',-3)
			
			ThisFormset.Receive_Edit.txtWO.Value		= PrepareSQLnum(tmpStk.WO,'WO',-3)
			ThisFormset.Receive_Edit.txtWO_Detail.Value	= PrepareSQLnum(tmpStk.WO_Detail,'WO_Detail',-3)
			
			*ThisFormset.Receive_Edit.txtReceived.Value = PrepareSQLDate(tmpStk.Received,'Received')
			ThisFormset.Receive_Edit.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
			
			PRIVATE cPPOitem, cPOitem 
			*IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
			cPPOitem = PrepareSQLtxt(tmpStk.PPOitem,'POitem',12)
			cPOitem = PrepareSQLtxt(tmpStk.PO_item,'POitem',12)
			IF Proper_PO_item(cPPOitem) != Proper_PO_item('')
				ThisFormSet.cPOitem 		= cPPOitem
				ThisFormset.Receive_Edit.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPPOitem) &&LEFT(ThisFormSet.cPOitem,AT("-",ThisFormSet.cPOitem)-1)
				ThisFormset.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(cPPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisFormSet.cPOitem,LEN(ThisFormSet.cPOitem)-AT("-",ThisFormSet.cPOitem)))))
				ThisFormSet.ChecknHpaPO = ThisFormset.Receive_Edit.txtHpaPONum.Value
				ThisFormSet.ChecknItemPO = ThisFormset.Receive_Edit.txtHpaPOItem.Value
			ELSE
				IF Proper_PO_item(cPOitem) != Proper_PO_item('')
					ThisFormSet.cPOitem 		= cPOitem
					ThisFormset.Receive_Edit.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem) &&LEFT(ThisFormSet.cPOitem,AT("-",ThisFormSet.cPOitem)-1)
					ThisFormset.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(cPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisFormSet.cPOitem,LEN(ThisFormSet.cPOitem)-AT("-",ThisFormSet.cPOitem)))))
					ThisFormSet.ChecknHpaPO = ThisFormset.Receive_Edit.txtHpaPONum.Value
					ThisFormSet.ChecknItemPO = ThisFormset.Receive_Edit.txtHpaPOItem.Value
				ELSE
					ThisFormSet.cPOitem 		= Proper_PO_item('')
					ThisFormset.Receive_Edit.txtHpaPONum.Value 	= 0
					ThisFormset.Receive_Edit.txtHpaPOItem.Value = 0
					ThisFormSet.ChecknHpaPO = 0
					ThisFormSet.ChecknItemPO = 0
				ENDIF
			ENDIF
				
			PRIVATE cSOitem 
			cSOitem = PrepareSQLtxt(tmpStk.SOitem,'SOitem',10)
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisFormSet.cSOitem			= cSOitem
				ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				ThisFormSet.cSOitem			= Proper_SO_item("")
				ThisFormset.Receive_Edit.txtSOnum.Value		= 0
				ThisFormset.Receive_Edit.txtSOitem.Value	= 0
			ENDIF
							
			ThisFormset.Receive_Edit.txtAlloy.Value		= PrepareSQLtxt(tmpStk.Alloy,'Alloy',12)
			ThisFormset.Receive_Edit.txtHeat.Value		= PrepareSQLtxt(tmpStk.Heat,'Heat',50)
			ThisFormset.Receive_Edit.txtLot.Value		= PrepareSQLtxt(tmpStk.Lot,'Lot',10)
			
			*ThisFormset.Receive_Edit.chkCert.Value		= IIF(tmpStk.Cert,1,0)
			ThisFormset.Receive_Edit.chkCert.Value		= 0
			
			ThisFormset.Receive_Edit.txtPieces.Value	= PrepareSQLnum(tmpStk.PC,'PC',-3)
			ThisFormset.Receive_Edit.edtDescription.Value = PrepareSQLtxt(tmpStk.Descript,'Decript',20)
			ThisFormset.Receive_Edit.edtSpecs.Value		= PrepareSQLtxt(tmpStk.Specs,'Specs',160)
			*ThisFormset.Receive_Edit.edtComments.Value 	= tmpStk.Comments,
			ThisFormset.Receive_Edit.edtComments.Value 	= ''
			
			*ThisFormset.Receive_Edit.txtInit.Value		= tmpStk.Init
			ThisFormset.Receive_Edit.txtInit.Value		= ''
			
			*ThisFormset.Receive_Edit.txtDate.Value		= DTOC(tmpStk.Date)
			ThisFormset.Receive_Edit.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
			
			*ThisFormset.Receive_Edit.chkPass.Value		= IIF(tmpStk.Pass,1,0)
			ThisFormset.Receive_Edit.chkPass.Value		= 0
			
			*ThisFormset.Receive_Edit.chkGoodPapers.Value = IIF(tmpStk.GoodPapers,1,0)
			ThisFormset.Receive_Edit.chkGoodPapers.Value = 0
			
			ThisFormset.Receive_Edit.txtActualW.Value	= PrepareSQLnum(tmpStk.S_QTY,'S_QTY',-5)
			ThisFormset.Receive_Edit.txtBillW.Value		= PrepareSQLnum(tmpStk.Weight,'Weight',9,1)
			
			ThisFormset.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpStk.S_QTY,'S_Qty',-5)
			ThisFormset.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpStk.S_P,'S_P',-5)
			
			
			PRIVATE nAcct_PU 
			nAcct_PU = PrepareSQLnum(nPU_Acct_Form( tmpStk.Form, ThisFormSet.nConnhandle),'S_PU',-1)
			ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nAcct_PU, 'PO_PU',2)
			ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
		*ThisFormSet.cPOitem
			ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(Calc_Vend_QTYleft_PO(ThisFormSet.cPOitem, ThisFormSet.nConnhandle),'PO_QTY',-5)
			ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(Get_From_Sales_SOitem (ThisFormSet.cPOitem, "Quoted_P", ThisFormSet.nConnhandle ),'Quoted_P',-5)
		*
			PRIVATE nVend_PU
			nVend_PU = PrepareSQLnum( Get_From_POitem(ThisFormSet.cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
			ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
			ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
		
		
			ThisFormset.Receive_Edit.txtVendor.Value	= PrepareSQLtxt( Get_From_POitem(ThisFormSet.cPOitem, "Company", ThisFormSet.nConnhandle ), 'Company',30)
			ThisFormset.Receive_Edit.txtRejectPC.Value		= 0
			ThisFormset.Receive_Edit.txtRejectReason.Value	= ''
			ThisFormset.Receive_Edit.txtRMA_No.Value		= 0
			ThisFormset.Receive_Edit.txtRMA_Detail.Value	= 0
			
			ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(0,'Services')
			ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
			ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
			ThisFormset.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(tmpStk.ID,'ID_Master',-3)
			ThisFormset.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(tmpStk.ID_Detail,'ID_Detail',-3)
		
			ThisFormset.Receive_Edit.txtTBL.Value		= cTBL
			ThisFormSet.StockLst_TBL		= cTBL
			
			ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpStk.Form,'Form',2)	
			
			IF USED('tmpStk')
				USE IN tmpStk
			ENDIF
			*******
			IF Proper_PO_item(PrepareSQLtxt(ThisFormSet.cPOitem,'POitem',12)) != Proper_PO_item('')
				*Get Vendor Company name, Description
				
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				cSQL = "SELECT Company, Alloy, Form, Order_Qty, Pieces, Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen "
		*		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		*		cSQL = cSQL + " ,dbo.f_Descript(Alloy,CC,CL,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen) AS Descript "
				cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(Pieces,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen,0,'','','') AS Descript "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE PoItem = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						ThisFormset.Receive_Edit.txtVendor.Value = PrepareSQLtxt(tmpPOp.Company,'Company',30)
						*ThisFormset.Receive_Edit.edtDescription.Value = ALLTRIM(PrepareSQLtxt(tmpPOp.Descript,'Descript',-1))+"  "+ALLTRIM(ThisFormset.Receive_Edit.edtComments.Value)
						PRIVATE cDesc,cDesc2
						cDesc = ALLTRIM(PrepareSQLtxt(ThisFormset.Receive_Edit.edtDescription.Value,'Descript',-1))
						cDesc2 = ALLTRIM(PrepareSQLtxt(tmpPOp.Descript,'Descript',-1))
						IF EMPTY(cDesc)
							ThisFormset.Receive_Edit.edtDescription.Value = cDesc2
						ELSE
							IF MESSAGEBOX("Add PO Description"+CHR(13)+cDesc2+","+CHR(13)+"before Process Description"+CHR(13)+cDesc+CHR(13)+"Answer No to just use Process Description.",4,"Add PO Description, before Process Description")=6
								ThisFormset.Receive_Edit.edtDescription.Value = cDesc2+". "+cDesc
							ENDIF
						ENDIF
		
					ENDIF
					USE IN tmpPOp
				ENDIF
		
			ENDIF
			
			**validate data
			IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) = 0
				*IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle )=0
				*	MESSAGEBOX("The POitem '"+ThisFormSet.cPOitem+"'"+CHR(13)+" entered in '"+cTBL+"' Detail= "+ALLTRIM(STR(nID_Detail))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem '"+ThisFormSet.cPOitem+"' entered in '"+cTBL+"' Detail= "+ALLTRIM(STR(nID_Detail))+", does not Exists!")
				ENDIF
			ENDIF
			IF Proper_SO_item(ThisFormSet.cSOitem) <> Proper_SO_item('')
				IF Count_SOIteminSales( ThisFormSet.cSOitem, ThisFormSet.nConnhandle )=0
					MESSAGEBOX("The SO item '"+ThisFormSet.cSOitem+"'"+CHR(13)+" entered in '"+cTBL+"' Detail= "+ALLTRIM(STR(nID_Detail))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisFormSet.cSOitem+"' entered in '"+cTBL+"' Detail= "+ALLTRIM(STR(nID_Detail))+", does not Exists!")
				ENDIF
			ENDIF
			********
			RETURN .T.
		ELSE
			RETURN .F.		
		ENDIF
		
		
	ENDPROC

	PROCEDURE getby_stk_detail_process
		*ThisFormSet.GetBy_STK_Detail()
		*Receive_Edit
		
		*See if this ID_Detail can get the correct ReceivingID
		PRIVATE nID_Detail_Process, cTBL, nReceivingID 
		nID_Detail_Process = PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail_Process.Value,'ID_Detail_Process.Value',-3)
		cTBL = PrepareSQLtxt(ThisFormset.Receive_Edit.txtTBL.Value,'TBL',1)
		nReceivingID = 0
		
		PRIVATE cSQL, nSQLExec
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		
		IF USED("tmpRcv_ID_Detail_P")
			USE IN tmpRcv_ID_Detail_P
		ENDIF
		SELECT 0
		*[SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID],[Processor],[AllowSub]
		*,[PU],[QTY],[Ordered_QTY],[Ordered_P],[Pounds],[ID_Detail],[ID_Detail_Process],[ReceivingID],[WO],[WO_Detail]
		*,[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3],[Prc_Q_QTY],[Prc_Q_PU]
		
		cSQL = "SELECT P.* "
		cSQL = cSQL + ",M.Alloy,M.Form,M.Heat,M.Lot,M.Specs, M.PO_item AS MPO_item, M.WO_Detail AS MWO_Detail "
		cSQL = cSQL + ",D.PC, D.ID_Detail, D.ID, D.S_P, D.S_PU "
		cSQL = cSQL + ",(SELECT ISNULL(PO.Order_P,0) FROM dbo.PurchaseOrder PO WITH(NoLock) WHERE PO.POitem = P.PO_Item ) AS Order_P  "
		DO CASE
		CASE cTBL = 'S'
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
		CASE cTBL = 'B'
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		CASE cTBL = 'W'
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRcv_ID_Detail_P')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRcv_ID_Detail_P' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRcv_ID_Detail_P")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRcv_ID_Detail_P")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRcv_ID_Detail_P' )
		ENDIF
		
		IF USED('tmpRcv_ID_Detail_P')
			IF RECCOUNT('tmpRcv_ID_Detail_P') > 0	
				lFoundProcess = .T.
			ENDIF
			*USE IN tmpRcv_ID_Detail_P
		ENDIF
		
		*******************************
		
		*IF NOT lFoundProcess 
		
		
		********************************
		*See what records where found
		PRIVATE nRecCount, nRecNum, nMess
		
		IF USED('tmpRcv_ID_Detail_P')
			nRecCount = RECCOUNT('tmpRcv_ID_Detail_P')
			
			ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLnum(tmpRcv_ID_Detail_P.ReceivingID,'ReceivingID',-3)
			
			ThisFormset.Receive_Edit.txtWO.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.WO,'WO',-3)
			ThisFormset.Receive_Edit.txtWO_Detail.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.WO_Detail,'WO_Detail',-3)
			
			
			*ThisFormset.Receive_Edit.txtReceived.Value = PrepareSQLDate(tmpRcv_ID_Detail_P.Received,'Received')
			ThisFormset.Receive_Edit.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
			
			PRIVATE cPOitem 
			cPOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.PO_item,'POitem',12)  &&Try from Process
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				*IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
				ThisFormSet.cPOitem 		= cPOitem
				ThisFormset.Receive_Edit.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem) &&LEFT(ThisFormSet.cPOitem,AT("-",ThisFormSet.cPOitem)-1)
				ThisFormset.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(cPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisFormSet.cPOitem,LEN(ThisFormSet.cPOitem)-AT("-",ThisFormSet.cPOitem)))))
				ThisFormSet.ChecknHpaPO = ThisFormset.Receive_Edit.txtHpaPONum.Value
				ThisFormSet.ChecknItemPO = ThisFormset.Receive_Edit.txtHpaPOItem.Value
			ELSE
				
				cPOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.MPO_item,'POitem',12)	&&Try from Master
				IF Proper_PO_item(cPOitem) != Proper_PO_item('')
					ThisFormSet.cPOitem 		= cPOitem
					ThisFormset.Receive_Edit.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem) &&LEFT(ThisFormSet.cPOitem,AT("-",ThisFormSet.cPOitem)-1)
					ThisFormset.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(cPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisFormSet.cPOitem,LEN(ThisFormSet.cPOitem)-AT("-",ThisFormSet.cPOitem)))))
					ThisFormSet.ChecknHpaPO = ThisFormset.Receive_Edit.txtHpaPONum.Value
					ThisFormSet.ChecknItemPO = ThisFormset.Receive_Edit.txtHpaPOItem.Value
				ELSE
					ThisFormSet.cPOitem 		= Proper_PO_item('')
					ThisFormset.Receive_Edit.txtHpaPONum.Value 	= 0
					ThisFormset.Receive_Edit.txtHpaPOItem.Value = 0
					ThisFormSet.ChecknHpaPO = ThisFormset.Receive_Edit.txtHpaPONum.Value
					ThisFormSet.ChecknItemPO = ThisFormset.Receive_Edit.txtHpaPOItem.Value
				ENDIF
			ENDIF
			
			PRIVATE cSOitem 	
			cSOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.SOitem,'SOitem',10)   &&Try from Process
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisFormSet.cSOitem			= cSOitem
				ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				cSOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.MSOitem,'SOitem',10)	&&Try from Master
				IF Proper_SO_item(cSOitem) != Proper_SO_item("")
					ThisFormSet.cSOitem			= cSOitem
					ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
					ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
				ELSE
					ThisFormSet.cSOitem			= Proper_SO_item("")
					ThisFormset.Receive_Edit.txtSOnum.Value		= 0
					ThisFormset.Receive_Edit.txtSOitem.Value	= 0
				ENDIF
			ENDIF
							
			ThisFormset.Receive_Edit.txtAlloy.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Alloy,'Alloy',12)
			
			IF NOT (ThisFormSet.cHeat = "ADD" OR ThisFormSet.cHeat = "EDIT")
				ThisFormset.Receive_Edit.txtHeat.Value		= ThisFormSet.cHeat 
			ENDIF
			
			IF NOT EMPTY(PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50))
				IF EMPTY(PrepareSQLtxt(ThisFormSet.cHeat,'Heat',50))
					ThisFormset.Receive_Edit.txtHeat.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)
				ELSE
					IF ALLTRIM(UPPER(PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50))) = ALLTRIM(UPPER(ThisFormSet.cHeat))
						ThisFormset.Receive_Edit.txtHeat.Value = ThisFormSet.cHeat
					ELSE
						IF NOT (ThisFormSet.cHeat = "ADD" OR ThisFormSet.cHeat = "EDIT")
							nMess = MESSAGEBOX("Heat was passed in as"+CHR(13)+ThisFormSet.cHeat+CHR(13)+"the Process ID Heat is"+CHR(13)+PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)+CHR(13)+CHR(13)+"Do you want to keep the Passed in Heat?",4+32,"Keep the Passed in Heat")
							IF nMess = 6
								ThisFormset.Receive_Edit.txtHeat.Value = ThisFormSet.cHeat
							ENDIF
							IF nMess = 7
								ThisFormset.Receive_Edit.txtHeat.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF ALLTRIM(UPPER(ThisFormset.Receive_Edit.txtHeat.Value)) = "DUE IN"
				ThisFormset.Receive_Edit.txtHeat.Value = ""
			ENDIF
			ThisFormset.Receive_Edit.txtLot.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Lot,'Lot',10)
			
			*ThisFormset.Receive_Edit.chkCert.Value		= IIF(tmpRcv_ID_Detail_P.Cert,1,0)
			ThisFormset.Receive_Edit.chkCert.Value		= 0
			
			ThisFormset.Receive_Edit.txtPieces.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.PC,'PC',-3)
		*	ThisFormset.Receive_Edit.edtDescription.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Descript,'Decript',20)  &&Do not use Descript from here!
			ThisFormset.Receive_Edit.edtSpecs.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Specs,'Specs',160)
			ThisFormset.Receive_Edit.edtComments.Value 	= PrepareSQLtxt(tmpRcv_ID_Detail_P.Comment,'Comment',100)
			*ThisFormset.Receive_Edit.edtComments.Value 	= ''
			
			*ThisFormset.Receive_Edit.txtInit.Value		= tmpRcv_ID_Detail_P.Init
			ThisFormset.Receive_Edit.txtInit.Value		= ''
			
			*ThisFormset.Receive_Edit.txtDate.Value		= DTOC(tmpRcv_ID_Detail_P.Date)
			ThisFormset.Receive_Edit.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
			
			*ThisFormset.Receive_Edit.chkPass.Value		= IIF(tmpRcv_ID_Detail_P.Pass,1,0)
			ThisFormset.Receive_Edit.chkPass.Value		= 0
			
			*ThisFormset.Receive_Edit.chkGoodPapers.Value = IIF(tmpRcv_ID_Detail_P.GoodPapers,1,0)
			ThisFormset.Receive_Edit.chkGoodPapers.Value = 0
			
			ThisFormset.Receive_Edit.txtActualW.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.Pounds,'Weight',9,1)
			ThisFormset.Receive_Edit.txtBillW.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.Pounds,'Weight',9,1)
			
			ThisFormset.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.QTY,'S_QTY',-5) &&Try from Process
			ThisFormset.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.S_P,'S_P',-5)
			
			PRIVATE nAcct_PU 
			nAcct_PU = PrepareSQLnum(tmpRcv_ID_Detail_P.S_PU,'PU',-1)
			ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			
			PRIVATE nVend_PU 
			nVend_PU = PrepareSQLnum(tmpRcv_ID_Detail_P.Prc_Q_PU,'PO_PU',-1)	 &&Try from Process
			IF nVend_PU > 0
				ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpRcv_ID_Detail_P.Prc_Q_QTY,'PO_QTY',-5)
				ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.Prc_Q_P,'PO_P',-5)
			ENDIF
			
			IF nVend_PU = 0
				*Old Receive - Get by POitem
				IF Proper_PO_Item(ThisFormSet.cPOitem) <> Proper_PO_Item("")
					nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)		
				ENDIF
			ENDIF
			
			IF nVend_PU = 0
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',2)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( 1, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisFormSet.nConnhandle)
			ELSE
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
			ENDIF
			
			IF EMPTY(ThisFormset.Receive_Edit.txtPO_QTY.Value)
				PRIVATE nVend_QTY, nVend_P
				nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisFormSet.nConnhandle)
				nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
				ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
				ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
			ENDIF
			
			*Done in next block of code.
			*ThisFormset.Receive_Edit.txtVendor.Value = PrepareSQLtxt(Get_From_POitem(cPOitem, "Company", ThisFormSet.nConnhandle ),'Vendor',30,.F.,.T.)
				
			*ThisFormset.Receive_Edit.txtRejectPC.Value		= tmpRcv_ID_Detail_P.RejectPC
			ThisFormset.Receive_Edit.txtRejectPC.Value		= 0
			
			*ThisFormset.Receive_Edit.txtRejectReason.Value	= tmpRcv_ID_Detail_P.RejectReason
			ThisFormset.Receive_Edit.txtRejectReason.Value	= ''
			
			*ThisFormset.Receive_Edit.txtRMA_No.Value		= tmpRcv_ID_Detail_P.RMA_No
			ThisFormset.Receive_Edit.txtRMA_No.Value		= 0
			ThisFormset.Receive_Edit.txtRMA_Detail.Value	= 0
			
			ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(0,'Services')
			ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
			ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
			ThisFormset.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.ID,'ID_Master',-3)
			ThisFormset.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.ID_Detail,'ID_Detail',-3)
			*ThisFormset.Receive_Edit.txtTBL.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.StockTable,'TBL',1)
			*IF EMPTY(ThisFormset.Receive_Edit.txtTBL.Value)
			*	ThisFormset.Receive_Edit.txtTBL.Value		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
			*ENDIF
			ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Form,'Form',2)
			
			************************************************************************************
			************************************************************************************
			************************************************************************************
			
			IF USED('tmpRcv_ID_Detail_P')
				USE IN tmpRcv_ID_Detail_P
			ENDIF
			*******
			IF Proper_PO_item(PrepareSQLtxt(ThisFormSet.cPOitem,'POitem',12)) != Proper_PO_item('')
				*Get Vendor Company name, Description
				
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				cSQL = "SELECT Company, Alloy"
		*		cSQL = cSQl + ", Form, Order_Qty, Pieces, Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen "
		*		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		*		cSQL = cSQL + " ,dbo.f_Descript(Alloy,CC,CL,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen) AS Descript "
				cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(Pieces,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen,0,'','','') AS Descript "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE PoItem = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						ThisFormset.Receive_Edit.txtVendor.Value	= PrepareSQLtxt(tmpPOp.Company,'Company',30)
						ThisFormset.Receive_Edit.txtAlloy.Value		= PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
						PRIVATE cDesc,cDesc2
						cDesc = ALLTRIM(PrepareSQLtxt(ThisFormset.Receive_Edit.edtDescription.Value,'Descript',-1))
						cDesc2 = ALLTRIM(PrepareSQLtxt(tmpPOp.Descript,'Descript',-1))
						IF EMPTY(cDesc)
							ThisFormset.Receive_Edit.edtDescription.Value = cDesc2
						ELSE
							IF MESSAGEBOX("Add PO Description"+CHR(13)+cDesc2+","+CHR(13)+"before Process Description"+CHR(13)+cDesc+CHR(13)+"Answer No to just use Process Description.",4,"Add PO Description, before Process Description")=6
								ThisFormset.Receive_Edit.edtDescription.Value = cDesc2+". "+cDesc
							ENDIF
						ENDIF
					ENDIF
					USE IN tmpPOp
				ENDIF
		
			ENDIF
			
			**validate data
			IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
				IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle )=0
					MESSAGEBOX("The POitem '"+ThisFormSet.cPOitem+"'"+CHR(13)+"entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem '"+ThisFormSet.cPOitem+"' entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+", does not Exists!")
				ENDIF
			ENDIF
			IF Proper_SO_item(ThisFormSet.cSOitem) <> Proper_SO_item('')
				IF Count_SOIteminSales( ThisFormSet.cSOitem, ThisFormSet.nConnhandle )=0
					MESSAGEBOX("The SO item '"+ThisFormSet.cSOitem+"'"+CHR(13)+"entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisFormSet.cSOitem+"' entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+", does not Exists!")
				ENDIF
			ENDIF
			********
			
			RETURN .T.
		ELSE
			RETURN .F.		
		ENDIF
		
		
	ENDPROC

	PROCEDURE getfromreceiving
		PARAMETER pcPoItem, pnWO_Detail, pcHeat, pcLot
		*ThisFormSet.GetFromReceiving(cPOitem, nWO_Detail ,cHeat)
		*returns .F. if did not get a receiving record.
		*Receive_Edit
		
		IF TYPE("pcPoItem") != "C"
			RETURN .F.
			*pHPAPo = ''
		ENDIF
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pnWO_Detail,'WO_Detail',-3)
		
		PRIVATE cAndHeat, nReceivingID, cLot
		cLot = PrepareSQLtxt(pcLot,'Lot',10)
		IF TYPE("pcHeat") != "C"
			cAndHeat = ""
			pcHeat = ''
		ELSE
			IF NOT EMPTY(pcHeat)
			 	cAndHeat = " AND HEAT = '"+ALLTRIM(pcHeat)+"' "
			 	IF LEN(cLot) > 0
			 		cAndHeat = cAndHeat +" AND Lot = '"+cLot+"' "
			 	ENDIF
			 ELSE
			 	cAndHeat = ""
			 ENDIF
		ENDIF
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ID',-3,0)
		
		PRIVATE cSOitem, nSalesNum, nItemSO
		PRIVATE cPOitem, nHpaPo, nItemPo
		cSOitem = Proper_SO_item('')
		cPOitem = Proper_PO_item('')
		pcPoItem = Proper_PO_item(pcPoItem)
		
		***********************************
		*** FROM RecStockGetByPOitem
		*** GetPOitemDetail
		***********************************
		IF USED('tmpReceivingPOitem')
			USE IN tmpReceivingPOitem
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		*cSQL = "SELECT Heat,Cert,Pieces,Description,Specs,Comments,Init,Date,ActualW,BillW,Vendor,pass,ID FROM dbo.Receiving "
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ( dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+pcPoItem+"')"
		IF nWO_Detail > 0
			cSQL = cSQL + " OR WO_Detail = "+STR(nWO_Detail)+" )"
			cSQL = cSQL + cAndHeat
		ELSE
			cSQL = cSQL + " ) "
			cSQL = cSQL + cAndHeat
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceivingPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN .F.
		ENDIF
		PRIVATE cDescription, lFoundOnetoEdit, nCurRec, nRecords, nRID 
		cDescription = ''
		lFoundOnetoEdit = .F.
		nCurRec = 0
		nRecords = 0
		
		IF USED('tmpReceivingPOitem')
			IF RECCOUNT('tmpReceivingPOitem') = 0
				PRIVATE cMess
				cMess = ''
				IF Proper_PO_item(pcPoItem) <> Proper_PO_item('')
					cMess = "The POitem "+pcPoItem+CHR(13)
				ENDIF
				IF nWO_Detail > 0
					cMess = cMess + "WO_Detail "+STR(nWO_Detail)+CHR(13)
				ENDIF
				IF LEN(pcHeat) > 0
					cMess = cMess + " and Heat/Lot "+pcHeat+CHR(13)
				ENDIF
				cMess = cMess + "was not found as received."+CHR(13)
				cMess = cMess + "Please check the Heat for a typing error."
				
				MESSAGEBOX(cMess ,48,"Not found")
				RETURN .F.
			ELSE
				GO TOP
				IF VARTYPE(tmpReceivingPOitem.Description) = "C"
					cDescription = ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
				ENDIF
			
		
				IF VARTYPE(tmpReceivingPOitem.Heat)="C" &&Heat
					IF !EMPTY(tmpReceivingPOitem.Heat)
						IF !EMPTY(pcHeat)
							IF nReceivingID > 0
								PRIVATE nReceivingID2
								nReceivingID2 = PrepareSQLnum(tmpReceivingPOitem.ID,'RID',-3)
								IF nReceivingID2 != nReceivingID 
									IF NOT ThisFormSet.cWhat = "EDIT"
										PRIVATE nMess, cMess
										cMess = "There is already a receiving record with this"+CHR(13)+"Heat= '"+ALLTRIM(pcHeat)+"'"
										
										IF LEN(cLot)>0
											cMess = cMess+"Lot= '"+ALLTRIM(cLot)+"'"+CHR(13)
										ENDIF
										cMess = cMess + " Your Receive ID "+ALLTRIM(STR(nReceivingID))+CHR(13)
										cMess = cMess + "Found Receive ID "+ALLTRIM(STR(nReceivingID2))+CHR(13)+CHR(13)
										
										cMess = cMess+CHR(13)+cDescription+CHR(13)+CHR(13)
										cMess = cMess+"Do you want to load the Found data?"
										
										nMess = MESSAGEBOX(cMess,4,"Overwrite current Data?") 
										IF nMess = 7
											*NO, do not overwrite
											ThisFormSet.ResetAddVars()
											
											RETURN .F.
										ENDIF
									ENDIF
								ENDIF
							ELSE
								*ID is 0, NEW
							ENDIF
						ELSE
							PRIVATE cEditNextRecord 
							cEditNextRecord = CHR(13)+"edit the next RECORD or"
							
							SELECT tmpReceivingPOitem
							nRecords = RECCOUNT()
							SCAN
							nCurRec = RECNO()
							cDescription = ALLTRIM(STR(tmpReceivingPOitem.Pieces))+"Pc "
							cDescription = cDescription + ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
							cDescription = cDescription + " Heat:"+tmpReceivingPOitem.Heat
							
							nRID = tmpReceivingPOitem.ID
							IF nRecords > nCurRec
								cEditNextRecord = CHR(13)+"edit the next RECORD or"
							ELSE
								cEditNextRecord = ""
							ENDIF
							PRIVATE cMess, nMess
							nMess = 0
							cMess = "There is already a receiving record. "
							IF nCurRec < nRecords 
								cMess = cMess + "Record "+ALLTRIM(STR(nCurRec))+"/"+ALLTRIM(STR(nRecords))+"."+CHR(13)
							ENDIF
							cMess = cMess + cDescription+CHR(13)+CHR(13)+"Do you want to edit this data?"+CHR(13)+CHR(13)
							IF nCurRec < nRecords 
								cMess = cMess +"Answer No and you will get a chance to edit the next RECORD"+CHR(13)
							ENDIF
							*cMess = cMess +"Create a new Receiving record."
							
							nMess = MESSAGEBOX(cMess,4,"Edit old Data?")
							IF nMess = 6
								*Edit this one
								lFoundOnetoEdit = .T.
								EXIT
							ELSE
								*IF nRecords = nCurRec
									nMess = MESSAGEBOX("This is a chance to 'Create' a receive."+CHR(13)+"Are you sure you want to create"+CHR(13)+"another receiving record"+CHR(13)+"for this same PO item?"+CHR(13)+" ",4,"Create new receiving record?")
									IF nMess = 6
										ThisFormset.Receive_Edit.txtReceivingID.Value = 0
										RETURN .F.
									ENDIF
								*ENDIF
							ENDIF
							
							cPOitem	= PrepareSQLtxt(tmpReceivingPOitem.POitem,'POitem',12)
		
							ENDSCAN
							
							IF lFoundOnetoEdit 
								IF MESSAGEBOX("Found a Receiving Record for this PO item '"+pcPoItem++"'"+CHR(13)+"Receiving ID: "+ALLTRIM(STR(nRID))+CHR(13)+CHR(13)+"Do you want to Edit this old receive?"+CHR(13)+"Answer No to be able to ADD another receive to this Po item.",4+32,"Edit old Receive?")=6
									ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLnum(nRID,'ReceivingID',-3)
									ThisFormSet.getBy_ReceivingID()
									RETURN .T.
								ELSE
									ThisFormset.Receive_Edit.txtReceivingID.Value = 0			
								ENDIF
							ELSE
								ThisFormset.Receive_Edit.txtReceivingID.Value = 0
								ThisFormSet.ResetAddVars()
								RETURN .F.
							ENDIF
		
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			*****
			
			*cPOitem	=	 PrepareSQLtxt(tmpReceivingPOitem.POitem,'POitem',12)
			IF Proper_PO_item(cPOitem) != Proper_PO_item("")
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
					ThisFormSet.cPOitem				= cPOitem
					ThisFormset.Receive_Edit.txtHPAPONum.Value		= Proper_PO_Item_PO(cPOitem)
					ThisFormset.Receive_Edit.txtHPAPOItem.Value		= Proper_PO_Item_Item(cPOitem)
					ThisFormSet.ChecknHpaPO 		= Proper_PO_Item_PO(cPOitem)
					ThisFormSet.ChecknItemPO		= Proper_PO_Item_Item(cPOitem)
				ELSE
					ThisFormSet.cPOitem			= Proper_PO_item("")
					ThisFormset.Receive_Edit.txtHPAPONum.Value	= 0
					ThisFormset.Receive_Edit.txtHPAPOItem.Value	= 0
					ThisFormSet.ChecknHpaPO 		= 0
					ThisFormSet.ChecknItemPO		= 0
				ENDIF
			ELSE
				*Just leave alone - function runs with the POitem or WO_Detail
		*		ThisFormSet.cPOitem			= Proper_PO_item("")
		*		ThisFormset.Receive_Edit.txtHPAPONum.Value	= 0
		*		ThisFormset.Receive_Edit.txtHPAPOItem.Value	= 0
		*		ThisFormSet.ChecknHpaPO 		= 0
		*		ThisFormSet.ChecknItemPO		= 0
			ENDIF
			
			cSOitem	=	 PrepareSQLtxt(tmpReceivingPOitem.SOitem,'SOitem',10)
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisFormSet.cSOitem			= cSOitem
				ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				ThisFormSet.cSOitem			= Proper_SO_item("")
				ThisFormset.Receive_Edit.txtSOnum.Value		= 0
				ThisFormset.Receive_Edit.txtSOitem.Value	= 0
			ENDIF
				
			ThisFormset.Receive_Edit.txtHeat.Value = PrepareSQLtxt(tmpReceivingPOitem.Heat,'Heat',50)
			ThisFormset.Receive_Edit.txtLot.Value = PrepareSQLtxt(tmpReceivingPOitem.Lot,'Lot',10)
			ThisFormset.Receive_Edit.chkCert.Value = PrepareSQLchk(tmpReceivingPOitem.Cert,'Cert')
			ThisFormset.Receive_Edit.txtPieces.Value = PrepareSQLnum(tmpReceivingPOitem.Pieces,'Pieces',-3)
			ThisFormset.Receive_Edit.edtDescription.Value = PrepareSQLtxt(tmpReceivingPOitem.Description,'Description',-1)
			ThisFormset.Receive_Edit.edtSpecs.Value = PrepareSQLtxt(tmpReceivingPOitem.Specs,'Specs',-1)
			ThisFormset.Receive_Edit.edtComments.Value = PrepareSQLtxt(tmpReceivingPOitem.Comments,'Comments',-1)
			ThisFormset.Receive_Edit.txtInit.Value = PrepareSQLtxt(tmpReceivingPOitem.Init,'Init',10)
			ThisFormset.Receive_Edit.txtDate.Value = DTOC(PrepareSQLdate(tmpReceivingPOitem.Date,'Date'))
			ThisFormset.Receive_Edit.chkPass.Value = PrepareSQLchk(tmpReceivingPOitem.Pass,'Pass')
			ThisFormset.Receive_Edit.chkGoodPapers.Value = PrepareSQLchk(tmpReceivingPOitem.GoodPapers,'GoodPapers')
		
			PRIVATE nActualW
			nActualW = PrepareSQLnum(ThisFormset.Receive_Edit.txtActualW.Value,'ActualW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1) > 0 AND nActualW < 2
				ThisFormset.Receive_Edit.txtActualW.Value = PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1)
			ENDIF
			PRIVATE nBillW
			nBillW = PrepareSQLnum(ThisFormset.Receive_Edit.txtBillW.Value,'BillW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1) > 0 AND nBillW < 2
				ThisFormset.Receive_Edit.txtBillW.Value = PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1)
			ENDIF
			
			ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(tmpReceivingPOitem.Services,'Services')
			ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(tmpReceivingPOitem.ConvServ,'ConvServ') 
			ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(tmpReceivingPOitem.Equipment,'Equipment')
		
			ThisFormset.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpReceivingPOitem.R_QTY,'S_QTY',-5)
			ThisFormset.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpReceivingPOitem.R_P,'S_P',-5)
			
			PRIVATE nAcct_PU 
			nAcct_PU = PrepareSQLnum(tmpReceivingPOitem.R_PU,'S_PU',-1)
			ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
			ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		*							
			IF EMPTY(ThisFormset.Receive_Edit.txtPO_QTY.Value)
				ThisFormset.Receive_Edit.txtPO_QTY.Value	= PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5)
			ENDIF
			
			PRIVATE nPO_P
			nPO_P = PrepareSQLnum(tmpReceivingPOitem.PO_P,'Order_P',-5)
			IF EMPTY(ThisFormset.Receive_Edit.txtPO_P.Value)
		*		IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "METAL" ) > 0
					ThisFormset.Receive_Edit.txtPO_P.Value		= nPO_P
		*		ENDIF
			ELSE
				IF nPO_P > 0
					PRIVATE nPO_Prev
					nPO_Prev = PrepareSQLnum(ThisFormset.Receive_Edit.txtPO_P.Value,'Order_P',-5)
					IF nPO_Prev > 0
						IF ROUND(nPO_Prev,1) <> ROUND(nPO_P ,1)
							IF MESSAGEBOX("The PO item has a Price of "+STR(nPO_Prev,10,2)+CHR(13)+" The receive has a price of "+STR(nPO_P,10,2)+CHR(13)+"Do you want to keep the PO item Price",4+32,"Use PO item") = 6
								*nPO_Prev
							ELSE
								ThisFormset.Receive_Edit.txtPO_P.Value = PrepareSQLnum(nPO_P,'Recv_P',-5)
							ENDIF	
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		*		
			*PRIVATE nCust_PU 
			*nCust_PU = PrepareSQLnum(tmpReceivingPOitem.PO_PU,'PO_PU',-1)
			PRIVATE nVend_PU 
			nVend_PU = PrepareSQLnum(tmpReceivingPOitem.PO_PU,'PO_PU',-1)
			IF nVend_PU > 0
				ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
				ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
				ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisFormSet.nConnhandle)
				
				ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpReceivingPOitem.Form,'Form',2)
				
				IF EMPTY(ThisFormset.Receive_Edit.txtPO_QTY.Value)
					ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5)
				ENDIF
				IF EMPTY(ThisFormset.Receive_Edit.txtPO_P.Value)
					ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOitem.PO_P,'PO_P',-5)
				ENDIF
			ELSE
				*Old Receive - Get by POitem
				IF Proper_PO_Item(ThisFormSet.cPOitem) <> Proper_PO_Item("")
					nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1)
					ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
					ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisFormSet.nConnhandle)
					
					PRIVATE nVend_QTY, nVend_P
					nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisFormSet.nConnhandle)
					nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "StockLst_P", ThisFormSet.nConnhandle ), 'StockLst_P',-5)
					IF EMPTY(ThisFormset.Receive_Edit.txtPO_QTY.Value) AND nVend_QTY > 0
						ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
					ENDIF
					IF EMPTY(ThisFormset.Receive_Edit.txtPO_P.Value) AND nVend_P > 0
						ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
					ENDIF
					
				ELSE
					ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',2)
					ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( 1, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisFormSet.nConnhandle)
				ENDIF								
			ENDIF
			
		*	ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5)
		*	ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOitem.PO_P,'PO_P',-5)
		*	ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
		*	ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
		
		
			ThisFormset.Receive_Edit.txtVendor.Value = PrepareSQLtxt(tmpReceivingPOitem.Vendor,'Vendor',30,.F.,.T.)
			
			ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLnum(tmpReceivingPOitem.ID,'ID',-3)
			
			ThisFormset.Receive_Edit.txtID_Master.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Master,'ID_Master',-3)
			ThisFormset.Receive_Edit.txtID_Detail.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail,'ID_Detail',-3)
			ThisFormset.Receive_Edit.txtTBL.Value = PrepareSQLtxt(tmpReceivingPOitem.StockTable,'StockTable',1)
			*ThisFormSet.StockLst_TBL = PrepareSQLtxt(tmpReceivingPOitem.StockTable,'StockTable',1)
			ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpReceivingPOitem.Form,'Form',2)
			
			*ID_Detail_Process is not stored in Receiving!
			*ThisFormset.Receive_Edit.txtID_Detail_Process.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail_Process,'ID_Detail_Process',-3)
				
			IF USED('tmpReceivingPOitem')
				USE IN tmpReceivingPOitem
			ENDIF
			
			*ThisFormset.Receive_Edit.Edit1.Value = ThisFormset.Receive_Edit.Edit1.Value+CHR(13)+"Retrieved PO item "+pcPoItem+" for edit."
			ThisFormset.Receive_Edit.Refresh	
		ENDIF
		
		**validate data
		IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
			IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle )=0
				MESSAGEBOX("The POitem '"+ThisFormSet.cPOitem+"'"+CHR(13)+" entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem '"+ThisFormSet.cPOitem+"' entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+", does not Exists!")
			ENDIF
		ENDIF
		IF Proper_SO_item(ThisFormSet.cSOitem) <> Proper_SO_item('')
			IF Count_SOIteminSales( ThisFormSet.cSOitem, ThisFormSet.nConnhandle )=0
				MESSAGEBOX("The SO item '"+ThisFormSet.cSOitem+"'"+CHR(13)+" entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisFormSet.cSOitem+"' entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+", does not Exists!")
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getpoitemdetail
		PARAMETERS pPOitem
		*ThisFormSet.GetPOitemDetail(cPOitem)
		* Receive_Edit
		
		*Check ThisFormSet.cPOitem and populated.
		IF Proper_PO_item(PrepareSQLtxt(ThisFormSet.cPOitem,'POitem',12)) = Proper_PO_item(pPOitem)
			*Already ran GetPOitemDetail(cPOitem)
		*	WAIT WINDOW 'Re-run the get POitem' NOWAIT
		ENDIF
		IF NOT Proper_PO_item(PrepareSQLtxt(pPOitem,'POitem',12)) = Proper_PO_item('')
			*pPoitem has data, use it
			ThisFormSet.cPOitem = Proper_PO_item(pPOitem)
			*cPOitem = Proper_PO_item(pPOitem) Done later
		ELSE
		*	TrackError("Need PO Item","Need SO Item",PROGRAM(),LINENO(1) )
			MESSAGEBOX("Need PO Item",0,"getPoItemDetail()" )
			RETURN .F.
		ENDIF
		
		**********************************************
		**check POitem in all tables including History
		PRIVATE nItemPO, nHpaPo, cPOitem, nID_Detail, nID_Detail_Process, nID_D_P
		cPOitem = Proper_PO_Item(PrepareSQLtxt(ThisFormSet.cPOitem,'POitem',12))
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nHpaPo	= Proper_PO_Item_PO(cPOitem)
		nID_Detail = 0
		nID_Detail_Process = 0
		nID_D_P = 0 
		
		PRIVATE nWO_Detail, nMess
		nWO_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		nMess = 0
		
		IF nHpaPo = 0
			MESSAGEBOX("No PO to show!",0,"No PO")
			RETURN .F.
		ENDIF
		
		*Check Vendor QAType
		IF is_Vendor_LabService(nHpaPo, ThisFormSet.nConnhandle) 
			* AND nWO_Detail = 0
			nMess = MESSAGEBOX("PO "+ALLTRIM(STR(nHPApo))+" is for a Test Report."+CHR(13)+"This is not the Vendor!"+CHR(13)+"Are you receiving to the right PO?"+CHR(13)+CHR(13)+"Do you still want to continue?",4+256+16,"Wrong PO") 
			IF nMess <> 6
				RETURN .F.
			ENDIF
		ENDIF
				
				
		*Check ThisFormSet.cHeat and populate
		IF NOT EMPTY(ThisFormSet.cHeat)
			ThisFormset.Receive_Edit.txtHeat.Value = ThisFormSet.cHeat
		ENDIF
		
		PRIVATE nPOcnt 
		nPOcnt = 0
		
		IF nItemPo = 0
			*Guess at Item
			ThisFormSet.ChecknItemPO = 0
			nPOcnt = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnhandle )
			IF nPOcnt = 0
				MESSAGEBOX("Nothing to return for that PO"+CHR(13)+" POitem '"+cPOitem+"' not found!",0,"No PO items")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Nothing to return for that PO"+CHR(13)+" POitem '"+cPOitem+"' not found!")
				RETURN .F.
			ENDIF
			IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnhandle, "METAL" ) = 0
				*Not for Stock!!!
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Receiving for POitem '"+cPOitem+"' but not for Stock!")
			ENDIF
			IF nPOcnt = 1
				*Must be only one
				nItemPo = GetMaxItemforPO( nHpaPo, ThisFormSet.nConnhandle )  &&nItemPO started as 0!
		
				ThisFormset.Receive_Edit.txtHPAPOitem.Value = nItemPO
				ThisFormSet.ChecknItemPO = nItemPO
			ENDIF
			IF nPOcnt > 1
				*Show list of Item to Choose
				*PRIVATE cPoItem
				DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
				IF TYPE("cPoItem") = "C"
					IF Proper_PO_Item(cPoItem) != Proper_PO_Item('')
						nItemPo = Proper_PO_Item_Item(cPOitem)
						ThisFormset.Receive_Edit.txtHpaPOItem.Value = nItemPo
						ThisFormSet.ChecknItemPO = nItemPO
						ThisFormSet.cPOitem = cPOitem
					ELSE
						MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
						RETURN .F.
					ENDIF		
				ELSE
					MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		*****
		*Check for INCOMING Process or to EDIT old Receieve
		*
		PRIVATE lChoosePOstk, lDelHistPOstk, cHeat, cLot, cTBL, cTBLOld  
		lChoosePOstk = .F.
		lDelHistPOstk = .F.
		cHeat = PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50)
		cLot  = PrepareSQLtxt(ThisFormset.Receive_Edit.txtLot.Value,'Lot',10)
		cTBL = 'N'
		cTBLOld = ''
		PRIVATE nReceivingID, nEditReceivingID, lChecked_RcvID
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'RID',-3)
		nEditReceivingID = 0
		IF ThisFormSet.lClone 
			nReceivingID = 0
		ENDIF
		lChecked_RcvID = (nReceivingID > 0)
		
		*IF ThisFormSet.lClone	--does Clone matter here? !!!
		
		*******************************************
		**Look to see if POitem can have Stock!
		* or if a WO_Detail should be used.
		
		PRIVATE nCntPOitem, cProcess_ID  
		cProcess_ID = ''
		nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "NOT SERVICES CONVSERV EQUIPMENT" )
		
		IF nCntPOitem = 0
			IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "WORKORDER" ) > 0
				IF nWO_Detail > 0
					ThisFormset.Receive_Edit.txtWO_Detail.Value = nWO_Detail 
					ThisFormSet.GetBy_nWO_Detail(nWO_Detail)
					RETURN .T.
				ENDIF
				
				nWO_Detail = PrepareSQLnum( Get_From_POitem (cPOitem, "WO_Detail", ThisFormSet.nConnhandle ),"WO_Detail",-3)
				IF nWO_Detail > 0
					ThisFormset.Receive_Edit.txtWO_Detail.Value = nWO_Detail 
					ThisFormSet.GetBy_nWO_Detail(nWO_Detail)
					RETURN .T.	
				ENDIF
				
				nWO_Detail = getWOD_with_POitem( cPOitem, ThisFormSet.nConnhandle) 
				IF nWO_Detail > 0
					ThisFormset.Receive_Edit.txtWO_Detail.Value = nWO_Detail 
					ThisFormSet.GetBy_nWO_Detail(nWO_Detail)
					RETURN .T.	
				ENDIF
				
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "CONVSERV" ) > 0
					cMess = "This PO is for a Conversion Service"+CHR(13)
					cMess = cMess + "Please Enter the WO_Detail"+CHR(13)+"to receive to."
					MESSAGEBOX(cMess,48,"Need WO_Detail")
					ThisFormset.Receive_Edit.txtWO_Detail.SetFocus
					RETURN .T.
				ENDIF
				
				*************
				
		*!*			IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "EQUIPMENT" ) > 0
		*!*				cMess = "This PO is for a Equipment"+CHR(13)
		*!*				cMess = cMess + "You do not need to enter data here"+CHR(13)+"Go back to first Receiving screen"+CHR(13)+" and mark as Complete."
		*!*			*	MESSAGEBOX(cMess,48,"This PO is for a Equipment") &&"Do not record here.")
		*!*			*	RETURN
		*!*			ENDIF
		*!*			IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "SERVICES" ) > 0
		*!*				cMess = "This PO is for a Service"+CHR(13)
		*!*				cMess = cMess + "You do not need to enter data here"+CHR(13)+"Go back to first Receiving screen"+CHR(13)+" and mark as Complete."
		*!*			*	MESSAGEBOX(cMess,48,"This PO is for a Service") &&"Do not record here.")
		*!*			*	RETURN .T.
		*!*			ENDIF
				
				cMess = "This POitem "+cPOItem+" is not to receive Metal"+CHR(13)+"Tried to find WO_Detail"
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "CONVSERV" ) > 0
					cMess = cMess +CHR(13)+"This PO is for a Conversion Service"
				ENDIF
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "SERVICES" ) > 0
					cMess = cMess +CHR(13)+"This PO is for a Service"+CHR(13)
				ENDIF
				IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle, "EQUIPMENT" ) > 0
					cMess = cMess +CHR(13)+"This PO is for a Equipment"+CHR(13)
				ENDIF
				
				MESSAGEBOX(cMess,16,"Not Metal")
				TrackError(cMess,"Receiving PO", PROGRAM(), LINENO(1))
				*RETURN .T.
				*ThisFormSet.GetBy_nWO
			ENDIF
		ENDIF
		
		*Only for PO for Metal
		ThisFormset.Receive_Edit.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisFormSet.nConnhandle ) 
		
		*******************************************
		**Look for Incomning Process, Received Heats
		PRIVATE lFoundHeatRecv 
		lFoundHeatRecv = .F.
		IF USED('tmpPO_ProcessCNT')
			USE IN 'tmpPO_ProcessCNT'
		ENDIF
		
		IF nReceivingID > 0
			*Count for ReceivingID on Stock! --This should not fire
			cSQL = " SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
			cSQL = cSQL + " SELECT TOP 1 "
			cSQL = cSQL + " ( SELECT Count(*) AS CNT "
			cSQL = cSQL + " FROM dbo.StockLst_Detail D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)+ "  ) AS CNT "
			cSQL = cSQL + ", 'S' AS TBL, M.Heat, M.Lot "
			cSQL = cSQL + " ,D.ID_Detail, '' AS Process_ID, 0 AS ID_Detail_Process "
			cSQL = cSQL + " FROM dbo.StockLst_Detail D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)
		
			cSQL = cSQL + " UNION "
			
			cSQL = cSQL + " SELECT TOP 1 "
			cSQL = cSQL + " (SELECT Count(*) AS CNT "
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' ) AS CNT "
			cSQL = cSQL + ", 'A' AS TBL, M.Heat, M.Lot "
			cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' "
			cSQL = cSQL + " ) t ORDER BY TBL, Heat, Lot "
			
		ELSE
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				*Count for that POitem Process on Stock!
				
				cSQL = " SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
				*Stock Master
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT"
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'S' AS TBL, M.Heat, M.Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				cSQL = cSQL + " UNION "
				*Stock History
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' AND M.[heat] != 'DUE IN'"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + ", 'A' AS TBL, M.Heat, M.Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' AND M.[heat] != 'DUE IN'"
		
				cSQL = cSQL + " UNION "
				*Stock Process
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'S' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
				*LEFT OUTER ?
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
				
		
				cSQL = cSQL + " UNION "
				*Broker Master
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT"
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'B' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		
				cSQL = cSQL + " UNION "
				*Broker Process
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'B' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
				cSQL = cSQL + " UNION "
				*WIP Master
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT"
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'W' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				cSQL = cSQL + " UNION "
				*WIP Process
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'W' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
				cSQL = cSQL + " UNION "
				*Recieving  --May need TOP 1
				cSQL = cSQL + " SELECT 1 AS CNT "
				cSQL = cSQL + " , 'R' AS TBL, ISNULL(R.Heat,'') AS Heat, ISNULL(R.Lot,'') AS Lot"
				cSQL = cSQL + " , ISNULL(R.ID_Detail,0) AS ID_Detail, '' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Receiving R WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE R.POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
			ENDIF
			*IF nWO_Detail > 0
				*This is a POitem method, do not check WO_Detail here
				*Count for that WO_Detail Process on Stock!
			*" SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
			*cSQL = cSQL + " ) t ORDER BY TBL, Heat, Lot "
			cSQL = cSQL + " ) t ORDER BY [Process_ID] DESC, Heat, Lot "
			
		ENDIF
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_ProcessCNT')
		WAIT WINDOW 'TIMEOUT1' TIMEOUT 1
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 2
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPO_ProcessCNT' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_ProcessCNT")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 2
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_ProcessCNT")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			TrackError(cSQL,"Get POitem Detail, Bad Query", PROGRAM(), LINENO(1))
		
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_ProcessCNT' )	
		ENDIF
		
		IF USED('tmpPO_ProcessCNT')
			IF RECCOUNT('tmpPO_ProcessCNT') > 0
			
				PRIVATE cMess
				cMess = "Found many records"+CHR(13)+"you do not need to take action"+CHR(13)+"This could get messy:"+CHR(13)+CHR(13)
				
				SELECT tmpPO_ProcessCNT
				
				LOCATE FOR TBL = 'A'
				IF FOUND('tmpPO_ProcessCNT')
					lDelHistPOstk = .T.
					
					PRIVATE cHistHeat 
					cHistHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
					cMess = cMess + "Found '"+ALLTRIM(cHistHeat)+"' in Archive. "+CHR(13)
					cMess = cMess + "        The Archive data will not be used. "+CHR(13)
					DELETE FROM tmpPO_ProcessCNT WHERE Heat = cHistHeat 
				ENDIF
				GO TOP
				
				PRIVATE cHeatNew,cLotNew, nID_DetailNew
				
				SCAN
					IF DELETED('tmpPO_ProcessCNT')
						LOOP
					ENDIF
					IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "A"
						LOOP
					ENDIF
					IF tmpPO_ProcessCNT.CNT = 0
						LOOP
					ENDIF
					*IF NOT lChoosePOstk 
						IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "R"
							*Found a Heat in Receiving and PO_item
							lFoundHeatRecv = .T.
					*		lChoosePOstk = .T.
							
							cHeatNew = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
							cLotNew	= PrepareSQLtxt(tmpPO_ProcessCNT.Lot,'Lot',10)
							nID_DetailNew = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
							
							IF LEN(cHeat) > 0 AND LEN(cHeatNew) > 0 AND cHeat<>cHeatNew AND NOT cHeatNew = 'DUE IN' AND NOT cHeat = 'DUE IN' 
								cMess = cMess + "Found Heat '"+ALLTRIM(cHeatNew)+"' when looking for the Heat '"+cHeat+"'."+CHR(13)
								MESSAGEBOX( "The Heat '"+cHeat+"' is being changed to '"+cHeatNew+"' ",48,"Could be a problem")
							ENDIF
							IF LEN(cHeatNew) > 0 AND NOT cHeatNew = 'DUE IN'
								cHeat = cHeatNew
							ENDIF
							
					*		MESSAGEBOX("Found POitem in Receiving 'R'"+CHR(13)+"Received Heat='"+cHeat+"'",64,"Found in Receiving")
							cMess = cMess + "Found '"+ALLTRIM(cHeat)+"', Lot '"+ALLTRIM(cLotNew)+"', ID_Detail="+ALLTRIM(STR(nID_DetailNew))+"' in Receiving. "+CHR(13)
							LOOP
						ENDIF
					*ENDIF
					
					
					*Found in S,B,W AND not in DELETED History
					cTBL = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF LEN(cTBLOld) > 0
						IF cTBLOld <> cTBL
							cMess = cMess +CHR(13)+ "Found POitem in different tables:"+CHR(13)
							cMess = cMess + "Tables '"+cTBL+"' and '"+cTBLOld+"'"+CHR(13)
							cMess = cMess + "This is a weird, you could see incorrect data after this receive."+CHR(13)
							cMess = cMess + "Please double check stock after edit."+CHR(13)+CHR(13)
						ENDIF
					ENDIF
					cTBLOld = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF cTBL = "S" OR cTBL = "B" OR cTBL = "W" 
						*lChoosePOstk = .T.
						cHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
						cLot  = PrepareSQLtxt(tmpPO_ProcessCNT.Lot,'Lot',10)
						nID_Detail = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
						
						cMess = cMess + "Found Heat '"+ALLTRIM(cHeat)+"', Lot '"+cLot+"' in Table '"+cTBL+"'. "+CHR(13)
						cProcess_ID = PrepareSQLtxt(tmpPO_ProcessCNT.Process_ID,'Process_ID',10)
						IF LEN(cProcess_ID) = 0
							cMess = cMess + "   without an Incoming Process_ID ."+CHR(13)
							nID_D_P = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
							IF nID_D_P > 0
								cMess = cMess + " nID_Detail_Process = "+ALLTRIM(STR(nID_D_P))+CHR(13)+CHR(13)
								IF nID_Detail_Process = 0
									nID_Detail_Process = nID_D_P
								ENDIF
							ENDIF
						ELSE
		
							cMess = cMess + "   with a Process_ID of '"+cProcess_ID+"'."+CHR(13)
							cMess = cMess + " nID_Detail = "+ALLTRIM(STR(nID_Detail))+CHR(13)
							IF cProcess_ID = "INCOMING"
								*Use this nID_Detail_Process !
								nID_Detail_Process = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
								cMess = cMess + "INCOMING nID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)
							ENDIF
						ENDIF
					ENDIF
				
				ENDSCAN
				
				IF nID_Detail_Process = 0
					cMess = cMess + CHR(13)+"Did not find an Incoming Process to receive to!"+CHR(13)
				ELSE
					cMess = cMess + CHR(13)+"Using Incoming Process "+ALLTRIM(STR(nID_Detail_Process))+" to receive to!"+CHR(13)
					IF nID_D_P > 0
						cMess = cMess + CHR(13)+"Where did Process "+ALLTRIM(STR(nID_D_P))+" come from!?!"+CHR(13)
					ENDIF
				ENDIF
				
				PRIVATE lFoundHeatRecv 
				lFoundHeatRecv = .F.
		
				IF nID_Detail_Process > 0
					cMess = cMess + CHR(13)+"Incomming Process "+ALLTRIM(STR(nID_Detail_Process))+" will be choosen to be used."
				ENDIF
				cMess = cMess + CHR(13)+"You may get another screen"+CHR(13)+" where you can choose "+CHR(13)+"to EDIT a Certain Heat"
				
				IF ( NOT lFoundHeatRecv AND RECCOUNT('tmpPO_ProcessCNT') = 1 )
					MESSAGEBOX(cMess,48,"Found for POitem '"+cPOitem+"'")
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),cMess)
				ENDIF
				lChoosePOstk = .T.
			ENDIF
			USE IN tmpPO_ProcessCNT
		ENDIF
		
		**********
		PRIVATE nID_D_P
		nID_D_P = 0
		IF nID_Detail_Process > 0
			nID_D_P = nID_Detail_Process 
		ENDIF
		
		***
		IF nID_D_P = 0
			*Get Process ID with POitem ????
			IF lChoosePOstk 
				*IF Heat = 'Due In' - set lChoosePOstk = .F.		
				IF UPPER(cHeat) = UPPER("DUE IN") OR ( ThisFormSet.cWhat = 'ADD' AND LEN(ThisFormset.Receive_Edit.txtHeat.Value) = 0)
					lChoosePOstk = .F.
					*have not Heat
					*nEditReceivingID = 0
					*nID_D_P &&Could get the Process ID here
					
					IF USED('tmpCNT_Heat')
						USE IN 'tmpCNT_Heat'
					ENDIF
		
		
					cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
					cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
		
					DO CASE
					CASE cTBL = "S"
						cSQL = cSQL + ",'S' AS TBL "
						cSQL = cSQL + " FROM dbo.StockLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
					CASE cTBL = "B"
						cSQL = cSQL + ",'B' AS TBL "
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
					CASE cTBL = "W"
						cSQL = cSQL + ",'W' AS TBL "
						cSQL = cSQL + " FROM dbo.WIPLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
					ENDCASE		
					
					cSQL = cSQL + " WHERE M.Heat = 'DUE IN'"
					cSQL = cSQL + " AND M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCNT_Heat')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCNT_Heat')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCNT_Heat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCNT_Heat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCNT_Heat')
					ELSE
						IF USED('tmpCNT_Heat')
						
							IF RECCOUNT('tmpCNT_Heat') > 0
								nID_Detail = PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
								cProcess_ID = PrepareSQLtxt(tmpCNT_Heat.Process_ID,'Process_ID',10)
								nID_D_P = PrepareSQLnum(tmpCNT_Heat.ID_Detail_Process ,'ID_Detail_Process',-3)
								
								IF PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3) > 0
									nEditReceivingID = PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3)
									*cProcess_ID
								ELSE
									nEditReceivingID = nReceivingID
								ENDIF
		*!*							IF RECCOUNT('tmpCNT_Heat') = 1
		*!*								*Run Choose to make sure the data is right
		*!*								lChoosePOstk = .T.
		*!*								*lChoosePOstk = .F.	&&Do not run Choose
		*!*							ELSE
		*!*								lChoosePOstk = .T.
		*!*							ENDIF
							ENDIF
							USE IN 'tmpCNT_Heat'
						ENDIF
					ENDIF
					
					
				ELSE && Have a Heat!!
				
					
					IF USED('tmpCNT_Heat')
						USE IN 'tmpCNT_Heat'
					ENDIF
		
					DO CASE
					CASE cTBL = "S"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",'S' AS TBL "
						cSQL = cSQL + " FROM dbo.StockLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
					CASE cTBL = "B"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",'B' AS TBL "
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
					CASE cTBL = "W"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'W' AS TBL "
						cSQL = cSQL + " FROM dbo.WIPLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
					CASE cTBL = "N"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'S' AS TBL "
						cSQL = cSQL + " FROM dbo.StockLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'B' AS TBL "
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'W' AS TBL "
						cSQL = cSQL + " FROM dbo.WIPLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + " SELECT R.POitem AS PO_item, R.ID_Detail ,'' AS Process_ID "
						cSQL = cSQL + " ,ISNULL(R.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + " ,ISNULL(R.ID,0) AS ReceivingID, 0 AS ID_Detail_Process ,R.StockTable AS TBL "
						cSQL = cSQL + " FROM dbo.Receiving R "
						cSQL = cSQL + " WHERE R.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE R.Lot = '"+cLot+"'"	
						ENDIF
						cSQL = cSQL + " AND R.AcctFinish = 0 "
						
					ENDCASE			
								
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCNT_Heat')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCNT_Heat')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCNT_Heat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCNT_Heat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCNT_Heat')
					ELSE
						IF USED('tmpCNT_Heat')
							IF RECCOUNT('tmpCNT_Heat') > 0
							
								SELECT tmpCNT_Heat
								LOCATE FOR PO_Item = cPOitem
								
								IF FOUND('tmpCNT_Heat')
									*M.PO_item, 
									nID_Detail = PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
									cProcess_ID = PrepareSQLtxt(tmpCNT_Heat.Process_ID,'Process_ID',10)
									*nReceivingID
									nID_D_P = PrepareSQLnum(tmpCNT_Heat.ID_Detail_Process ,'ID_Detail_Process',-3)
									IF PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3) > 0
										nEditReceivingID = PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3)
										*cProcess_ID
									ELSE
										nEditReceivingID = nReceivingID
									ENDIF
									
									IF RECCOUNT('tmpCNT_Heat') = 1
										*Run Choose to make sure the data is right
										lChoosePOstk = .T.
										*lChoosePOstk = .F.	&&Do not run Choose
									ELSE
										lChoosePOstk = .T.
									ENDIF
									
									IF cTBL = "N"
										cTBL = PrepareSQLtxt(tmpCNT_Heat.TBL,'TBL',1)
										IF LEN(cTBL) > 0
											IF cTBL = "N" 
												 cR_POitem = PrepareSQLtxt(tmpCNT_Heat.PO_item,'POitem',12)
												 nCount_POIteminPurchaseOrder = Count_POIteminPurchaseOrder( cR_POitem, ThisFormSet.nConnhandle, 'METAL' )
												 IF nCount_POIteminPurchaseOrder > 0
												 	IF Count_POIteminPurchaseOrder( cR_POitem, ThisFormSet.nConnhandle, 'BROKER' ) > 0
												 		cTBL = 'B'
												 	ELSE
												 		cTBL = 'S'
												 	ENDIF
			 										ThisFormSet.cTBL = cTBL
													ThisFormset.Receive_Edit.txtTBL.Value = cTBL
												 ENDIF
												 nWO_Detail = PrepareSQLnum(tmpCNT_Heat.WO_Detail,'WO_Detail',-3) 
												 IF nWO_Detail > 0
												 	cTBL = 'S'
			 										ThisFormSet.cTBL = cTBL
													ThisFormset.Receive_Edit.txtTBL.Value = cTBL
												 ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
							USE IN 'tmpCNT_Heat'
						ENDIF
					ENDIF			
				
				ENDIF
			ENDIF
		ENDIF
		***
		***
		
		*nID_Detail = PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
		********************
		IF nID_D_P = 0
			*Get ReceivingID without Process!
		
			*IF Heat = 'Due In' - set lChoosePOstk = .F.		
			IF UPPER(cHeat) = "DUE IN" OR ( ThisFormSet.cWhat = 'ADD' AND LEN(ThisFormset.Receive_Edit.txtHeat.Value) = 0)
				lChoosePOstk = .F.
				
				*nEditReceivingID = 0
				*nID_D_P - no process here
				
				IF USED('tmpCNT_Heat')
					USE IN 'tmpCNT_Heat'
				ENDIF
		
				cSQL = "SELECT D.ID_Detail, D.ReceivingID "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
				CASE cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
				CASE cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
				OTHERWISE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cTBL, Try Stock")
					*cTBL not Found.
					*cTBL = 'N'       Try StockLst ?
					cSQL = cSQL + " FROM dbo.StockLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
				ENDCASE			
				
				cSQL = cSQL + " WHERE M.Heat = 'DUE IN'"
				cSQL = cSQL + " AND M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCNT_Heat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCNT_Heat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCNT_Heat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCNT_Heat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpCNT_Heat')
				ELSE
					IF USED('tmpCNT_Heat')
						IF RECCOUNT('tmpCNT_Heat') > 0
							nID_Detail = PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
							nEditReceivingID = PrepareSQLnum(tmpCNT_Heat.ReceivingID,'RID',-3)
						ENDIF
						USE IN 'tmpCNT_Heat'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		******
		
		
		ThisFormSet.cTBL = cTBL
		IF nID_D_P = 0
			IF lChoosePOstk 
				*lDelHistPOstk 
				*nID_Detail_Process 
				
				*Show PO Process, choose EDIT of a heat or INCOMING, or ADD
				*-*write from so a POitem on stock can be choosen that has no ReceiveID !!!
				
				IF UPPER(cHeat) = "DUE IN" OR ( ThisFormSet.cWhat = 'ADD' AND LEN(ThisFormset.Receive_Edit.txtHeat.Value) = 0)
					*Do not look at dbo.Receiving for the nEditReceivingID
				ELSE
					*cTBL R is from Receiving Table
					IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
						IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
							cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
						ENDIF
					ENDIF
					
					IF Proper_PO_item(cPOitem) <> Proper_PO_item('') 
					**** AND nEditReceivingID = 0
						DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, cTBL TO nEditReceivingID
					ENDIF
				ENDIF
				
				*return Receiving ID or ''
				DO CASE
				CASE VARTYPE(nEditReceivingID) = "C"
					*User Cancelled
					nEditReceivingID = 0
				CASE PrepareSQLnum(nEditReceivingID,'ReceivingID',-3) > 0
					*Edit this old Receive
					IF nReceivingID > 0 AND nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3) 
						*ReceivingID did not change
						nEditReceivingID = nReceivingID
						lChecked_RcvID = .T.
					ELSE
						IF nEditReceivingID > 0
							lChecked_RcvID = .T.
							ThisFormset.Receive_Edit.txtReceivingID.Value = nEditReceivingID
							ThisFormset.Receive_Edit.txtReceivingID.Refresh
							ThisFormSet.getBy_ReceivingID()
						ENDIF
					ENDIF
				CASE PrepareSQLnum(nEditReceivingID,'ReceivingID',-3) < 0
					*Edit incoming Process
					lChecked_RcvID = .T.
					nID_D_P = -nEditReceivingID
					*Should TBL be returned? !!!
					IF nID_D_P = 1
						*Lost ID_Detail_Process!
						nID_D_P = 0
						nID_D_P = nID_Detail_Process 
					ENDIF
				CASE PrepareSQLnum(nEditReceivingID,'ReceivingID',-3) = 0
					lChecked_RcvID = .T.
				ENDCASE
			ENDIF	
		ENDIF
		
		**********************
		IF USED("tmpID_D_P")
			USE IN tmpID_D_P
		ENDIF
		cSQL = ''
		PRIVATE cMess
		IF nID_D_P > 0
			*nReceivingID
			cMess = "Do you want to use the 'INCOMING' record?"+CHR(13)+"Answer 'No' to Edit an old receive."+CHR(13)
			IF cHeat <> "DUE IN"
				cMess = cMess + "Heat = "+cHeat+CHR(13)
			ENDIF
			IF ThisFormSet.cWhat = 'ADD'
				cMess = cMess + CHR(13)+CHR(13)+ "This was to be an Add, not an Edit"
			ELSE
				cMess = cMess + CHR(13)+CHR(13)+ "This was to be an Edit"
			ENDIF
			nMess = MESSAGEBOX(cMess,4,"Receiving Incoming?")
			IF nMess = 7
				nID_D_P = 0
			ENDIF
		ENDIF
		IF nID_D_P > 0
			*bring in INCOMING/SELECTED Process by nID_D_P !!
		
			*ThisFormset.Receive_Edit.txtReceivingID.Value = nReceivingID
			*ThisFormset.Receive_Edit.txtReceivingID.refresh
			
			cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.Specs, P.Prc_PCs, P.Comment, P.Pounds, P.QTY, P.Ordered_QTY "
			cSQL = cSQL + ", M.ID, D.ID_Detail, P.ID_Detail_Process"
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			*cSQL = cSQL + ",dbo.f_Descript(M.Alloy,M.CC,M.Form,D.Dim1,D.Dim2,D.Dim3,D.S_QTY,D.RandLen ) AS Descript"
			cSQL = cSQL + ", dbo.f_DescriptionMetricReport(0, M.Form,D.Dim1,D.Dim2,D.Dim3, D.[Weight], D.RandLen, 0, '', '', '') AS Descript "
			cSQL = cSQL + ",(SELECT ISNULL(PO.Order_P,0) FROM dbo.PurchaseOrder PO WITH(NoLock) WHERE PO.POitem = P.PO_Item ) AS Order_P "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + ",'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			CASE cTBL = "B"
				cSQL = cSQL + ",'B' AS TBL "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			CASE cTBL = "W"
				cSQL = cSQL + ",'W' AS TBL "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			OTHERWISE
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cTBL, Try Stock")
				*cSQL = "SELECT 1 "
				*cTBL not Found
				*cTBL = "S"   try StockLst
				cSQL = cSQL + ",'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			ENDCASE
		ELSE
			IF nID_Detail > 0
				*bring in stock with ID_Detail
				**leads to errors if too many records
				cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.Specs, D.PC AS Prc_PCs, '' AS Comment, D.Weight AS Pounds, D.S_QTY AS QTY, D.S_QTY AS Ordered_QTY "
				cSQL = cSQL + ", M.ID, D.ID_Detail, 0 AS ID_Detail_Process"
				cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
				*cSQL = cSQL + ",dbo.f_Descript(M.Alloy,M.CC,M.Form,D.Dim1,D.Dim2,D.Dim3,D.S_QTY,D.RandLen ) AS Descript"
				cSQL = cSQL + ", dbo.f_DescriptionMetricReport(0, M.Form,D.Dim1,D.Dim2,D.Dim3, D.[Weight], D.RandLen, 0, '', '', '') AS Descript "
				cSQL = cSQL + ",D.S_P AS Order_P "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + ",'S' AS TBL "
					cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
				CASE cTBL = "B"
					cSQL = cSQL + ",'B' AS TBL "
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
				CASE cTBL = "W"
					cSQL = cSQL + ",'W' AS TBL "
					cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
				ENDCASE		
			ENDIF
		ENDIF
				
		SELECT 0  
		IF LEN(cSQL)>0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpID_D_P')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpID_D_P')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpID_D_P")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpID_D_P")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpID_D_P')
				RETURN .F.
			ENDIF
		ENDIF
			
		IF USED('tmpID_D_P')
			IF RECCOUNT('tmpID_D_P') > 0
				IF VARTYPE(tmpID_D_P.Alloy) = "C"
					
					*ThisFormset.Receive_Edit.txtWO.Value		= 0 &&PrepareSQLnum(tmpReceivingPOitem.WO,'WO',-3)
					*ThisFormset.Receive_Edit.txtWO_Detail.Value	= 0 &&PrepareSQLnum(tmpReceivingPOitem.WO_Detail,'WO_Detail',-3)
					*ThisFormset.Receive_Edit.txtReceived.Value = '' &&PrepareSQLDate(tmpReceivingPOitem.Received,'Received')
		
		
					*Show the POitem
					ThisFormSet.cPOitem 			= PrepareSQLtxt(cPOitem,'POitem',12)
					ThisFormset.Receive_Edit.txtHpaPONum.Value 	= Proper_PO_Item_PO(ThisFormSet.cPOitem)
					ThisFormset.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisFormSet.cPOitem)
					
					*ThisFormSet.cSOitem			= PrepareSQLtxt(tmpReceivingPOitem.SOitem,'SOitem',10)
					*ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(ThisFormSet.cSOitem)
					*ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(ThisFormSet.cSOitem)
		
					ThisFormSet.ChecknHpaPO		= Proper_PO_Item_PO(ThisFormSet.cPOitem)
					ThisFormSet.ChecknItemPO		= Proper_PO_Item_Item(ThisFormSet.cPOitem)
					
					ThisFormset.Receive_Edit.txtAlloy.Value 	= PrepareSQLtxt(tmpID_D_P.Alloy,'Alloy',12)
					ThisFormset.Receive_Edit.txtHeat.Value		= ALLTRIM(ShowSQLtxt(tmpID_D_P.Heat,'Heat',50,.F.,.T.))
				 	ThisFormset.Receive_Edit.txtLot.Value		= PrepareSQLtxt(tmpID_D_P.Lot,'Lot',10)
					
					ThisFormset.Receive_Edit.txtPieces.Value	= PrepareSQLnum(tmpID_D_P.Prc_PCs,'Prc_PCs',-3)
					ThisFormset.Receive_Edit.edtSpecs.Value 	= ALLTRIM(ShowSQLtxt(tmpID_D_P.Specs,'Specs',160))
					ThisFormset.Receive_Edit.edtDescription.Value = ALLTRIM(ShowSQLtxt(tmpID_D_P.Descript,'Descript',-1))
						
					ThisFormset.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(tmpID_D_P.ID,'ID',-3)
					ThisFormset.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(tmpID_D_P.ID_Detail,'ID_Detail',-3)
					ThisFormset.Receive_Edit.txtID_Detail_Process.Value	= PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
					ThisFormset.Receive_Edit.txtTBL.Value		= PrepareSQLtxt(tmpID_D_P.TBL,'TBL',1)
					ThisFormset.Receive_Edit.txtForm.Value		= PrepareSQLtxt(tmpID_D_P.Form,'Form',2)
					***
					ThisFormset.Receive_Edit.chkCert.Value		= 0
					*ThisFormset.Receive_Edit.edtSpecs.Value		= ''
					*ThisFormset.Receive_Edit.edtComments.Value	= ''
					ThisFormset.Receive_Edit.txtInit.Value		= ''
					ThisFormset.Receive_Edit.txtDate.Value		= DTOC(DATE())
					ThisFormset.Receive_Edit.chkPass.Value		= 0
					ThisFormset.Receive_Edit.chkGoodPapers.Value= 0
					
					ThisFormset.Receive_Edit.txtActualW.Value	= PrepareSQLnum(tmpID_D_P.Pounds,'Pounds',9,1)
					ThisFormset.Receive_Edit.txtBillW.Value		= PrepareSQLnum(tmpID_D_P.Pounds,'Pounds',9,1)
					
					PRIVATE nAcct_PU 
					nAcct_PU = PrepareSQLnum(tmpID_D_P.S_PU,'S_PU',-1)
					ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
					ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle)
					
					ThisFormset.Receive_Edit.txtAcct_Qty.Value	= PrepareSQLnum(tmpID_D_P.S_QTY,'S_QTY',-5)
					ThisFormset.Receive_Edit.txtAcct_P.Value	= PrepareSQLnum(tmpID_D_P.S_P,'S_P',-5)
					
		*			ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum( Calc_Vend_QTYleft_PO(ThisFormSet.cPOitem,ThisFormSet.nConnhandle),'PO_QTY',-5)
					ThisFormset.Receive_Edit.txtPO_QTY.Value 	= PrepareSQLnum(tmpID_D_P.S_QTY,'S_QTY',-5)
					ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum( Get_From_POitem(ThisFormSet.cPOitem, "Order_P", ThisFormSet.nConnhandle ), 'Order_P',-5)
			
					PRIVATE nCust_PU 
					nCust_PU = PrepareSQLnum( Get_From_POitem(ThisFormSet.cPOitem, "Order_PU", ThisFormSet.nConnhandle ), 'Order_PU',-1) &&Cust PU
					ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
					ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
					ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisFormSet.nConnhandle)
		
					ThisFormset.Receive_Edit.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisFormSet.nConnhandle ) 
					
					ThisFormset.Receive_Edit.txtRMA_No.Value	= 0
					ThisFormset.Receive_Edit.txtRMA_Detail.Value= 0
					ThisFormset.Receive_Edit.txtRejectPC.Value	= 0
					ThisFormset.Receive_Edit.txtRejectReason.Value	= ''
					
					ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(0,'Services')
					ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
					ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
					*: Cannot call SetFocus from within a When, Valid, RangeHigh or RangeLow event.. 
					*ThisFormset.Receive_Edit.txtAlloy.SetFocus()
				ENDIF
			ELSE
				TrackError("nID_D_P = "+ALLTRIM(STR(nID_D_P))+" but no records."+CHR(13)+CHR(13)+cSQL,"No records", PROGRAM(), LINENO(1))
			ENDIF
			USE IN tmpID_D_P
		
		ENDIF
		
		IF nEditReceivingID > 0
			ThisFormset.Receive_Edit.txtReceivingID.Value = nEditReceivingID	&&needed by GetBy_ReceivingID()
			
			ThisFormSet.getBy_ReceivingID()		&&??
			
			RETURN .T.
		ENDIF
		
		IF nID_D_P > 0
			RETURN .T.
		ENDIF
		
		IF lChecked_RcvID 
			RETURN .T.
		ENDIF
		
		************************************************************************************************
		*Still here?
		**************
		
		IF USED('tmpPO_Process')
			USE IN 'tmpPO_Process'
		ENDIF
			
		IF nID_Detail > 0 AND ( cTBL='S' OR cTBL='B' OR cTBL='W' )
		
			cSQL = "SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'S' AS TBL, M.PO_Item  "
			cSQL = cSQL + " ,D.WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.[Weight], M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOItem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + " ,P.Process_ID "
			cSQL = cSQL + " ,D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + " ,PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds "
			DO CASE
			CASE cTBL = 'S'
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = 'B'
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = 'W'
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			ENDCASE
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " AND D.ID_Detail = "+STR(nID_Detail)
			
		ELSE
			
			cSQL = "SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'S' AS TBL, M.PO_Item  "
			cSQL = cSQL + " ,D.WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.Weight, M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOItem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + ",P.Process_ID "
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + ",PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds "
		
			cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " OR P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') )"
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
			
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'B' AS TBL, M.PO_Item "
			cSQL = cSQL + " ,0 AS WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.[Weight], M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOitem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + ",P.Process_ID "
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + ",PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds"
			
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " OR  P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') )"
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
			
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'W' AS TBL, M.PO_Item "
			cSQL = cSQL + " ,0 AS WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.[Weight], M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOitem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + ",P.Process_ID "
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + ",PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds"
				
			cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " OR P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') ) "
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
			cSQL = cSQL + " ORDER BY P.Process_ID "
			
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPO_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPO_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPO_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPO_Process' )
		ENDIF
		
		**
		PRIVATE nMess 
		nMess = 6
		*PRIVATE cHeat
		cHeat = ''
		
		IF USED('tmpPO_Process')
			IF RECCOUNT('tmpPO_Process') > 0
				PRIVATE nRecCount, nRecNum, nMess
				nRecCount = RECCOUNT('tmpPO_Process')
				PRIVATE nInvoiceValue, cTBL
				PRIVATE cPO_Item, cSOitem, nPounds, nS_QTY
				*, cPPOItem, dDueDate, cProcess_ID
				cHeat = '*'
				SCAN
					IF ThisFormSet.lClone 
						nReceivingID 	= 0
						nInvoiceValue	= 0
						*cHeat		 	= '*'   &&This is the Heat of the Process!
					ELSE
						nReceivingID	= PrepareSQLnum(tmpPO_Process.ReceivingID,'ReceivingID',-3)
						IF nReceivingID > 0
							PRIVATE cMess, nNum
							nNum = 4+32
							cMess = "Found a record with that PO item"+CHR(13)
							cMess = cMess + "POitem '"+cPOitem+"'"+CHR(13)
							cMess = cMess + "Receiving ID = "+ALLTRIM(STR(nReceivingID))+CHR(13)
							
							cHeatMess = "Heat "+ALLTRIM(PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50))
							IF LEN(PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)) > 0
								cHeatMess = cHeatMess + "/Lot "+PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)
							ENDIF
							IF LEN(cHeatMess )> 8
								cMess = cMess +CHR(13)+cHeatMess +CHR(13)+CHR(13)
							ENDIF
							cMess = cMess +"Answer (Y) to edit this Receive ID."+CHR(13)
							IF ThisFormSet.cWhat = "ADD"
								cMess = cMess + "But, this was to be an Add, not an Edit."+CHR(13)
								nNum = 4+32+256
							ENDIF
							IF RECNO('tmpPO_Process') < RECCOUNT('tmpPO_Process')
								cMess = cMess+CHR(13)+ "Record "+ALLTRIM(STR(RECNO('tmpPO_Process')))+" of "+ALLTRIM(STR(RECCOUNT('tmpPO_Process')))+" Records."
								cMess = cMess+CHR(13)+"Answer (N) to see next Heat/Lot."
							ELSE
								cMess = cMess+CHR(13)+"Answer (N) to ADD another Heat/Lot."
							ENDIF
							
							nMess = MESSAGEBOX(cMess,nNum,"Edit this Heat/Lot?")
							IF nMess = 6
								nInvoiceValue	= PrepareSQLnum(tmpPO_Process.InvoiceValue,'InvoiceValue',-5)
								cHeat			= PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50)
								cLot 			= PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)
							ELSE
								nReceivingID 	= 0
								nInvoiceValue	= 0
								cHeat			= '*'   &&This is the Heat of the Process!
								
							ENDIF
						ELSE
							nReceivingID	= 0
							nInvoiceValue	= 0
							*cHeat			= '*'   &&This is the Heat of the Process!
							
							IF RECCOUNT('tmpPO_Process') = 1 AND PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50) = "DUE IN"
								nMess = 0
							ELSE
								IF NOT PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50) = "DUE IN"
									cMess = "Found a PO Process record with that PO item"+CHR(13)
									cMess = cMess + "POitem '"+cPOitem+"'"+CHR(13)
									cMess = cMess + "Receiving ID = "+ALLTRIM(STR(nReceivingID))+CHR(13)
									
									cHeatMess = "Heat "+ALLTRIM(PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50))
									IF LEN(PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)) > 0
										cHeatMess = cHeatMess + "/Lot "+PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)
									ENDIF
									IF LEN(cHeatMess )> 8
										cMess = cMess +CHR(13)+cHeatMess +CHR(13)+CHR(13)
									ENDIF
									
									IF LEN(cHeatMess )>6
										cMess = cMess +CHR(13)+cHeatMess +CHR(13)+CHR(13)
										cMess = cMess +CHR(13)+"Will default to this Heat/Lot."
									ENDIF
									
									cMess = cMess+CHR(13)+ "Record "+ALLTRIM(STR(RECNO('tmpPO_Process')))+" of "+ALLTRIM(STR(RECCOUNT('tmpPO_Process')))+" Records."
									cMess = cMess+CHR(13)+ "No INCOMING POitem Process."
									cMess = cMess+CHR(13)+CHR(13)+ "Last Status info screen."
									nMess = MESSAGEBOX(cMess,0+64,"No INCOMING POitem Process!")
									nMess = 0
								ENDIF
							ENDIF
						ENDIF					
					ENDIF
					
					cTBL		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
					cPO_Item	= PrepareSQLtxt(tmpPO_Process.PO_Item,'PO_Item',12)
					cSOitem		= PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10)
					*cPPOItem	= PrepareSQLtxt(tmpPO_Process.PPOItem,'POItem',12)
					*dDueDate	= PrepareSQLdate(tmpPO_Process.DueDate,'DueDate')
					*cProcess_ID	= PrepareSQLtxt(tmpPO_Process.Process_ID,'Process_ID',10)
					nPounds		= PrepareSQLnum(tmpPO_Process.Pounds,'Pounds',9,1)
					nS_QTY		= PrepareSQLnum(tmpPO_Process.S_QTY,'QTY',-5)
					*nEditReceivingID	= PrepareSQLnum(tmpPO_Process.PReceivingID,'ReceivingID',-3)
					nRecNum		= RECNO('tmpPO_Process')
					nID_Detail	= PrepareSQLnum(tmpPO_Process.ID_Detail,'ID_Detail',-3)
					
		*!*					*Find best POitem
		*!*					IF Proper_PO_item(cPPOItem) != Proper_PO_item('')
		*!*						IF Proper_PO_item(cPO_item) != Proper_PO_item('')
		*!*							cPOitem = cPPOItem
		*!*						ELSE
		*!*							cPOitem = cPO_item
		*!*						ENDIF
		*!*					ELSE
		*!*						IF Proper_PO_item(cPO_item) != Proper_PO_item('')
		*!*							cPOitem = cPO_item
		*!*						ELSE
		*!*							*cPOitem = ''
		*!*						ENDIF
		*!*					ENDIF
		
					IF nRecCount = 1
						*Only 1 Record found
						DO CASE
						CASE nReceivingID = 0
							IF LEN(cHeat)=0 OR cHeat = '*' 
								* No need to Ask, just use this one record.
								IF cProcess_ID = "SELECTED"
									*cProcess_ID = "INCOMING" "NOT2HPA" "PARTRECV"
								ELSE
									nMess = 6
								ENDIF
							ELSE
								IF cHeat = 'DUE IN'
									IF UPPER(cProcess_ID) = "INCOMING"
										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "PARTRECV"
										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
								ENDIF
							ENDIF
		*!*						CASE nEditReceivingID = 0
		*!*							IF EMPTY(cHeat) OR cHeat = '*'
		*!*								IF UPPER(cProcess_ID) = "INCOMING"
		*!*									nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*								IF UPPER(cProcess_ID) = "NOT2HPA"
		*!*									nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*								IF UPPER(cProcess_ID) = "PARTRECV"
		*!*									nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*							ELSE
		*!*								IF cHeat = 'Due In'
		*!*									IF UPPER(cProcess_ID) = "INCOMING"
		*!*										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*									ENDIF
		*!*									IF UPPER(cProcess_ID) = "NOT2HPA"
		*!*										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*									ENDIF
		*!*									IF UPPER(cProcess_ID) = "PARTRECV"
		*!*										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDIF
						CASE nReceivingID > 0
							IF EMPTY(cHeat) OR cHeat = '*'
								IF UPPER(cProcess_ID) = "INCOMING"
									nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "NOT2HPA"
									nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:NOT2HPA"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "PARTRECV"
									nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
							ELSE
								IF cHeat = 'DUE IN'
									IF UPPER(cProcess_ID) = "INCOMING"
										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:NOT2HPA"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "PARTRECV"
										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF					
								ENDIF
							ENDIF
		*!*						CASE nEditReceivingID > 0
		*!*							IF EMPTY(cHeat) OR cHeat = '*'
		*!*								IF UPPER(cProcess_ID) = "INCOMING"
		*!*									nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*								IF UPPER(cProcess_ID) = "NOT2HPA"
		*!*									nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*								IF UPPER(cProcess_ID) = "PARTRECV"
		*!*									nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*							ELSE
		*!*								IF cHeat = 'Due In'
		*!*									IF UPPER(cProcess_ID) = "INCOMING"
		*!*										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*									ENDIF
		*!*									IF UPPER(cProcess_ID) = "NOT2HPA"
		*!*										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:NOT2HPA"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*									ENDIF
		*!*									IF UPPER(cProcess_ID) = "PARTRECV"
		*!*										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDIF
						ENDCASE
					ENDIF
					****
					
					IF nMess = 6	&&Correct record
						IF ThisFormSet.lClone
							ThisFormset.Receive_Edit.txtReceivingID.Value = ''
							*ThisFormset.Receive_Edit.txtID_Master.Value	= 0
							*ThisFormset.Receive_Edit.txtID_Detail.Value	= 0
							*ThisFormset.Receive_Edit.txtTBL.Value		= ''
						ELSE
							ThisFormset.Receive_Edit.txtReceivingID.Value = PrepareSQLnum(tmpPO_Process.ReceivingID,'ReceivingID',-3)
						ENDIF
						
						ThisFormset.Receive_Edit.txtID_Master.Value	= PrepareSQLnum(tmpPO_Process.ID,'ID_Master',-3)
						ThisFormset.Receive_Edit.txtID_Detail.Value	= PrepareSQLnum(tmpPO_Process.ID_Detail,'ID_Detail',-3)
						ThisFormset.Receive_Edit.txtTBL.Value		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
						ThisFormset.Receive_Edit.txtForm.Value		= PrepareSQLtxt(tmpPO_Process.Form,'Form',2)
						
						ThisFormset.Receive_Edit.txtWO.Value		= PrepareSQLnum(tmpPO_Process.WO,'WO',-3)
						*WO is not used for Receiving
						ThisFormset.Receive_Edit.txtWO_Detail.Value	= 0
						
						**Field Received is not here, seen in Receiving table
						*IF nReceivingID > 0
						*	ThisFormset.Receive_Edit.txtReceived.Value = PrepareSQLDate(tmpPO_Process.Received,'Received')
						*ELSE
							IF EMPTY(ThisFormset.Receive_Edit.txtReceived.Value)
								ThisFormset.Receive_Edit.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
							ENDIF
						*ENDIF
						
						
						ThisFormSet.cPOitem 			= PrepareSQLtxt(cPOitem,'POitem',12)
						ThisFormset.Receive_Edit.txtHpaPONum.Value 	= Proper_PO_Item_PO(ThisFormSet.cPOitem)
						ThisFormset.Receive_Edit.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisFormSet.cPOitem)
						
						PRIVATE cSOitem
						cSOitem = Proper_SO_item(PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10))
						
						ThisFormSet.cSOitem			= ''
						ThisFormset.Receive_Edit.txtSOnum.Value		= 0
						ThisFormset.Receive_Edit.txtSOitem.Value	= 0
		
						IF cSOitem != Proper_SO_item("")	
							*Do not use a SOitem if it is Cancelled.
							IF Count_SOIteminSales(cSOitem, ThisFormSet.nConnhandle ) > 0
								IF Count_SOIteminSales(cSOitem, ThisFormSet.nConnhandle, "CANCEL") < 1
									ThisFormSet.cSOitem			= PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10)
									ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(ThisFormSet.cSOitem)
									ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(ThisFormSet.cSOitem)
								ENDIF
							ENDIF
						ENDIF
						
						*******
										
						ThisFormset.Receive_Edit.txtAlloy.Value		= PrepareSQLtxt(tmpPO_Process.Alloy,'Alloy',12)
						IF NOT ThisFormSet.lClone
							IF NOT EMPTY(ThisFormSet.cHeat)
								* ThisFormSet.cHeat was passed in as a Parameter.
							ELSE
								ThisFormset.Receive_Edit.txtHeat.Value		= PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50)
							ENDIF
						ENDIF
						ThisFormset.Receive_Edit.txtLot.Value 		= ''
						*ThisFormset.Receive_Edit.chkCert.Value		= IIF(tmpPO_Process.Cert,1,0)
						ThisFormset.Receive_Edit.chkCert.Value		= 0
						
						ThisFormset.Receive_Edit.txtPieces.Value	= PrepareSQLnum(tmpPO_Process.PC,'PC',-3)
		*					ThisFormset.Receive_Edit.edtDescription.Value = PrepareSQLtxt(tmpPO_Process.Descript,'Decript',20)
						ThisFormset.Receive_Edit.edtSpecs.Value		= PrepareSQLtxt(tmpPO_Process.Specs,'Specs',160)
						*ThisFormset.Receive_Edit.edtComments.Value 	= tmpPO_Process.Comments,
						ThisFormset.Receive_Edit.edtComments.Value 	= ''
						
						*ThisFormset.Receive_Edit.txtInit.Value		= tmpPO_Process.Init
						ThisFormset.Receive_Edit.txtInit.Value		= ''
						
						*ThisFormset.Receive_Edit.txtDate.Value		= DTOC(tmpPO_Process.Date)
						ThisFormset.Receive_Edit.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
						
						*ThisFormset.Receive_Edit.chkPass.Value		= IIF(tmpPO_Process.Pass,1,0)
						ThisFormset.Receive_Edit.chkPass.Value		= 0
						
						*ThisFormset.Receive_Edit.chkGoodPapers.Value = IIF(tmpPO_Process.GoodPapers,1,0)
						ThisFormset.Receive_Edit.chkGoodPapers.Value = 0
						
