	PROCEDURE receivedtoordered
		PARAMETER pcPOitem
		*THISFORMSET.ReportReceivedtoOrdered(cPOitem)
		*Show_Recv_Order
		*-* Check Received to Ordered and display difference
		
		IF TYPE("pcPOitem") != "C"
			MESSAGEBOX("No POitem for ReportReceivedtoOrdered(pcPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No POitem for ReportReceivedtoOrdered(pcPOitem)" )
			RETURN
		ENDIF
		
		IF Proper_PO_item(pcPOitem)=Proper_PO_item('')
			MESSAGEBOX("No POitem for ReportReceivedtoOrdered(pcPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No POitem for ReportReceivedtoOrdered(pcPOitem)" )
			RETURN
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item( pcPOitem )
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		PRIVATE nItemPO, nPO
		nItemPO = VAL( RIGHT( cPOitem,2 ) )
		nPO		= VAL( LEFT(  cPOitem,9 ) )
		SET DECIMAL TO nDec
		
		IF nPO > 0 AND nItemPO > 0
			IF USED("tmpSumPO")
				USE IN tmpSumPO
			ENDIF
			PRIVATE nT_Pc, nT_Weight, nT_Count
			PRIVATE cSQL
			cSQL = "SELECT SUM(d.PC) AS T_pc, SUM(d.Weight) AS T_Weight, COUNT(d.ID) AS T_Count FROM dbo.BrokerLst_Detail d, dbo.BrokerLst_Master m "
			cSQL = cSQL + " WHERE dbo.f_ProperPOitem(m.PO_item) = dbo.f_ProperPOitem('" + cPOitem + "') AND m.ID = d.ID"
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpSumPO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpSumPO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSumPO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSumPO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpSumPO')
				nT_Pc		= 0
				nT_Weight	= 0
				nT_Count	= 0
			ELSE
				nT_Pc		= tmpSumPO.T_Pc
				nT_Weight	= tmpSumPO.T_Weight
				nT_Count	= tmpSumPO.T_Count
			ENDIF
			
			IF USED("tmpSumPO")
				USE IN tmpSumPO
			ENDIF
			
			IF nT_Count = 0 &&Try StockLst
			
				cSQL = "SELECT SUM(d.PC) AS T_pc, SUM(d.Weight) AS T_Weight, COUNT(d.ID) AS T_Count FROM dbo.StockLst_Detail d, dbo.StockLst_Master m "
				cSQL = cSQL + " WHERE dbo.f_ProperPOitem(m.PO_item) = dbo.f_ProperPOitem('" + cPOitem + "') AND m.ID = d.ID"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpSumPO')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpSumPO')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSumPO")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpSumPO")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpSumPO')
					nT_Pc		= 0
					nT_Weight	= 0
					nT_Count	= 0
				ELSE
					nT_Pc		= tmpSumPO.T_Pc
					nT_Weight	= tmpSumPO.T_Weight
					nT_Count	= tmpSumPO.T_Count
				ENDIF
				
				IF USED("tmpSumPO")
					USE IN tmpSumPO
				ENDIF
			
			ENDIF
			
			IF nT_Count = 0
				nT_Pc		= 0
				nT_Weight	= 0
			ENDIF
					
			PRIVATE nT_pcR, nT_ActualR, nT_BillR, nT_CountR 
			nT_pcR		= 0
			nT_ActualR	= 0
			nT_BillR	= 0
			nT_CountR 	= 0
					
			DIMENSION aTotalW(1,4)
			cSQL = "SELECT SUM(Pieces) AS T_pc, SUM(ActualW) AS T_Actual, SUM(BillW) AS T_Bill, COUNT(*) AS T_CountR FROM dbo.Receiving WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			IF USED("tmpReceiving")
				USE IN tmpReceiving
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceiving')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceiving')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceiving")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceiving")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceiving')
			ELSE
				IF !EOF("tmpReceiving")
					IF TYPE("tmpReceiving.T_pc") = "N" OR VARTYPE(tmpReceiving.T_pc)="Y"
						nT_pcR = tmpReceiving.T_pc
					ENDIF
					IF TYPE("tmpReceiving.T_Actual") = "N" OR VARTYPE(tmpReceiving.T_Actual)="Y"
						nT_ActualR = tmpReceiving.T_Actual
					ENDIF
					IF TYPE("tmpReceiving.T_Bill") = "N" OR VARTYPE(tmpReceiving.T_Bill)="Y"
						nT_BillR = tmpReceiving.T_Bill
					ENDIF
					IF TYPE("tmpReceiving.T_CountR") = "N" OR VARTYPE(tmpReceiving.T_CountR)="Y"
						nT_CountR = tmpReceiving.T_CountR
						*Do not keep doubling when their are muliple receiveing records
						IF nT_CountR > 1 AND nT_BillR > 0
							nT_BillR = nT_BillR / nT_CountR 
						ENDIF
					ENDIF
				
				ENDIF
			ENDIF
			
		*	MESSAGEBOX(SPACE(15)+"-Ordered-"+SPACE(7)+"-Received-"  +CHR(13)+;
					   "        PC:"+PADL(STR(nT_Pc),10)    +SPACE(12)+PADL(STR(nT_pcR),10)+CHR(13)+;
					   "  Weight:"+PADL(STR(nT_Weight),10)+SPACE(10)+PADL(STR(nT_ActualR),10)+CHR(13)+;
					   "Billed W:"+PADL(STR(nT_BillR),10) +SPACE(10)+" "+CHR(13)+;
					   "       ID's:"+PADL(STR(nT_Count),10) +SPACE(11)+PADL(STR(nT_CountR),10);
					   ,0+64,"Report Purchase Order Summary for PO-item '"+ALLTRIM(cPOitem)+"'")
					   
		*	DO FORM Forms\ReportReceived_Ordered WITH nT_Pc,nT_pcR,nT_Weight,nT_ActualR,nT_BillR,nT_Count,nT_CountR,cPOitem
		*	DO FORM Forms\ShowReceived_Ordered WITH "what",cPOitem, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingID,cTBL
		
		
		ENDIF
		
		SELECT Receiving
	ENDPROC

	PROCEDURE receive_stock		&& was receivepostocklst
		PARAMETER pPOitem, pnReceivingID, cHeat, cLot, nRMA_Detail, pSOitem, pWO_Detail
		*ThisformSet.Receive_Stock( purchaseorder.poitem ,pnReceivingID, cHeat, nRMA_Detail, cSOitem, nWO_Detail ) 
		*Calls DO FORM Forms\Recv_Stock
		*Relays pReceivingID 
		*Receive_Edit
		
		IF VARTYPE(pnReceivingID) != "N"
			TrackError("Parameter pnReceivingID is not a NUMBER","bad variable",PROGRAM(),LINENO(1))
			pnReceivingID = 0
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(pPoItem,'POitem',12)
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pnReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ""
		ENDIF
		cHeat = ALLTRIM(cHeat)
		
		IF VARTYPE(cLot) != "C"
			cLot = ""
		ENDIF
		cLot = ALLTRIM(cLot)
		
		IF VARTYPE(nRMA_Detail) != "N"
			nRMA_Detail = 0
		ENDIF
		PRIVATE lRMA
		lRMA = .F.
		IF nRMA_Detail > 0
			lRMA = RMA_Detail_Exists( nRMA_Detail, ThisFormSet.nConnhandle)	
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
		
		
		*Update StockLst
		************************** StockLst SQL
		
		PRIVATE cSQL_Master_PO, nID_Master, nID_Detail
		nID_Master = 0
		nID_Detail = 0
		PRIVATE nBkrMastCnt, nBkrMastCntRid
		nStkMastCntRid = 0
		nBkrMastCntRid = 0
		PRIVATE nStkMastCnt, nBkrMastCnt 
		nStkMastCnt = 0
		nBkrMastCnt = 0
		PRIVATE cTBL2
		cTBL2 = "N"
		
		IF nReceivingID = 0
			nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		ENDIF
		
		IF nReceivingID > 0
			********************* Check History, never overwrite when it has history
			PRIVATE lFoundStockHistory 
			lFoundStockHistory = .F.
			
			IF USED("tmpHistCnt")
				USE IN tmpHistCnt
			ENDIF
			
			cSQL =		  " SELECT COUNT(ID) AS Cntd "
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History "
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
			cSQL = cSQL + " AND [WHAT] = 'BEFOREEDIT' "
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT COUNT(ID) AS Cntd "
			cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Detail_History "
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
			cSQL = cSQL + " AND [WHAT] = 'BEFOREEDIT' "
			
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpHistCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpHistCnt')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpHistCnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpHistCnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpHistCnt')
				nStkMastCntRid = 0
			ELSE
				IF RECCOUNT('tmpHistCnt') > 0
					IF tmpHistCnt.CNTD > 0
						lFoundStockHistory = .T.
					ENDIF
				ENDIF
			ENDIF
			IF USED("tmpHistCnt")
				USE IN tmpHistCnt
			ENDIF
		
			IF lFoundStockHistory 
				MESSAGEBOX("Found this Receiving ID in Archives."+CHR(13)+"the Receive to StockLst to Edit Window will NOT show."+CHR(13)+CHR(13)+"If you still need to Edit for StockLst"+CHR(13)+"Use StockLst Maintenance.",0+48,"Not allowed to edit stock.")
				*Return True here to indicate that Recv_Stock was good, go on.
				RETURN .T.
			ENDIF
		
			********************* Check StockLst_Detail for Receiving ID
			*Could be used for RMA
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			
			cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Detail "
			cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'StkMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'StkMastCnt')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "StkMastCnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "StkMastCnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_S_Master_PO,ThisFormSet.nConnhandle, nSQLEXEC, 'StkMastCnt')
				nStkMastCntRid = 0
			ELSE
				nStkMastCntRid = StkMastCnt.Cntd
				IF nStkMastCntRid > 0
					*ReceivingID is not stored to Stock untill Recv_Stock is run
					nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,'StockLst',ThisFormSet.nConnhandle)
					nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisFormSet.nConnhandle)  
					IF nID_Master > 0
						cTBL2 = "S"
					ENDIF
				ENDIF
			ENDIF
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			
			********************* Check BrokerLst_Detail for Receiving ID	
			IF USED("BkrMastCnt")
				USE IN BkrMastCnt
			ENDIF
		
			cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Detail "
			cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
				
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'BkrMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'BkrMastCnt')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "BkrMastCnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "BkrMastCnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_S_Master_PO, ThisFormSet.nConnhandle, nSQLEXEC, 'BkrMastCnt')
				nBkrMastCntRid = 0
			ELSE
				nBkrMastCntRid = BkrMastCnt.Cntd
				IF nBkrMastCntRid > 0
					*ReceivingID is not stored to Stock untill Recv_Stock is run
					nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisFormSet.nConnhandle)
					nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,'BrokerLst',ThisFormSet.nConnhandle)
					IF nID_Master > 0
						cTBL2 = "B"
					ENDIF
				ENDIF
			ENDIF
		
			IF USED("BkrMastCnt")
				USE IN BkrMastCnt
			ENDIF
		ELSE
			*Why is there no nReceivingID!!!!
			TrackError("nReceivingID = 0","No nReceivingID!",PROGRAM(),LINENO(1))
			*RMA has no
		ENDIF
		
		***********************
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCntRid + nBkrMastCntRid = 0
				*Not in Detail record for ReceivingID
				*Look by POitem - 
				
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("")
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL_S_Master_PO = cSQL_S_Master_PO +" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO +" AND ( POStatus LIKE 'D' OR POStatus LIKE 'P' OR POStatus IS NULL )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "StkMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "StkMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisFormSet.nConnhandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
		
							nID_Detail = get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisFormSet.nConnhandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisFormSet.nConnhandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnhandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "S"
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO +" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus LIKE 'D' OR POStatus LIKE 'P' OR POStatus IS NULL )"
					*OR POStatus IS NULL )"
					
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "BkrMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "BkrMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO,ThisFormSet.nConnhandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisFormSet.nConnhandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisFormSet.nConnhandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisFormSet.nConnhandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "B"
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ELSE
				IF nReceivingID = 0
					*Why is there no nReceivingID!!!!
					TrackError("No nReceivingID!","No nReceivingID",PROGRAM(),LINENO(1))		
				ENDIF
			ENDIF
		ENDIF
		
		***********************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid= 0
				*No Detail record have ReceivingID
				*Look by POitem - 
		
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("") 
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL_S_Master_PO = cSQL_S_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='DUE IN' )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "StkMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "StkMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisFormSet.nConnhandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Detail = get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisFormSet.nConnhandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisFormSet.nConnhandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnhandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "S"
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='DUE IN' )"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "BkrMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL_S_Master_PO, "BkrMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO, ThisFormSet.nConnhandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisFormSet.nConnhandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisFormSet.nConnhandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisFormSet.nConnhandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "B"
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ELSE
				IF nReceivingID = 0
					*Why is there no nReceivingID!!!!
					TrackError("No nReceivingID!"+" , nStkMastCnt="+STR(nStkMastCnt)+", nBkrMastCnt="+STR(nBkrMastCnt)+", nStkMastCntRid="+STR(nStkMastCntRid)+", nBkrMastCntRid="+STR(nBkrMastCntRid),"No nReceivingID",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
		ENDIF
		***********************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid = 0
				*No Detail record have ReceivingID
				*Look by WO_Detail
		
				*IF Proper_PO_Item(pPoItem) = Proper_PO_Item("") 
				IF nWO_Detail > 0
					*Lst_Detail Does not have ReceivingID
					cSQL = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL = cSQL+" WHERE WO_Detail="+STR(nWO_Detail)
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "StkMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "StkMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL ,ThisFormSet.nConnhandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'StockLst',ThisFormSet.nConnhandle)
							nID_Detail = get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisFormSet.nConnhandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'StockLst',ThisFormSet.nConnhandle)
							ENDIF
							IF nID_Detail > 0 AND nID_Master = 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnhandle)
								IF nID_Master > 0
									cTBL2 = "S"
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "BkrMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "BkrMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'BrokerLst',ThisFormSet.nConnhandle)
							nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisFormSet.nConnhandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'BrokerLst',ThisFormSet.nConnhandle,.T.)
							ENDIF
							IF nID_Detail > 0 AND nID_Master = 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisFormSet.nConnhandle)
								IF nID_Master > 0
									cTBL2 = "B"
								ENDIF
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		**************************
		
		IF NOT lRMA AND NOT ThisFormSet.lRan_Recv_Stock 
			DO CASE 
			CASE nStkMastCntRid > 0
			*	DO FORM forms\Recv_Stock WITH pPOitem, pTableName, nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master, pnWO_Detail
				DO FORM Forms\Recv_Stock WITH pPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
				*					PARAMETER  pPOitem,    pLst,    nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master 
				ThisFormSet.lRan_Recv_Stock = .T.
			CASE nBkrMastCntRid > 0
				DO FORM Forms\Recv_Stock WITH pPOitem, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
				*ThisFormset.Receive_Edit.RecvStockLoad( pPOitem, ThisFormSet.nConnhandle, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				ThisFormSet.lRan_Recv_Stock = .T.
			CASE nStkMastCnt > 0
				* SetReceivingID_in_Detail( cPOitem ,pnID_Detail, nConn, cTBL2, pnReceiveID, lCancel )
				nID_Detail = SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisFormSet.nConnhandle, 'StockLst', nReceivingID, .F. )
				IF nID_Detail > 0 AND nID_Master = 0
					nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnhandle)
				ENDIF
				
				DO FORM Forms\Recv_Stock WITH pPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
				*ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnhandle, 'StockLst ', nReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				ThisFormSet.lRan_Recv_Stock = .T.
			CASE nBkrMastCnt > 0
				* SetReceivingID_in_Detail( cPOitem ,pnID_Detail, nConn, cTBL2, pnReceiveID, lCancel )
				nID_Detail = SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisFormSet.nConnhandle, 'BrokerLst', nReceivingID, .F. )
				IF nID_Detail > 0 AND nID_Master = 0
					nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisFormSet.nConnhandle)
				ENDIF
					
				DO FORM Forms\Recv_Stock WITH pPOitem, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail 
				*ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnhandle, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				ThisFormSet.lRan_Recv_Stock = .T.
			OTHERWISE
					
				*Is this a Lab Test?
				PRIVATE nCountPOitem 
				nCountPOitem = PO_POitem_Cnt( cPOitem, ThisFormSet.nConnhandle, "NOTRECEIVE" )
				*Only counts if Services = 0 AND ConvServ = 0 AND Equipment = 0 
				IF nCountPOitem > 0
					
					cMess = "Receive_Stock(POitem,ReceivingID,Heat,RMA)."+CHR(13)
					cMess = cMess+"Could not find a Master with ( POStatus NOT LIKE 'A' OR POStatus IS NULL ) "
					cMess = cMess+CHR(13)+"or Detail WHERE ReceivingID="
					cMess = cMess+STR(nReceivingID)+CHR(13)
					cMess = cMess+" POitem='"+pPOitem+"'"
					cMess = cMess+", Heat='"+ALLTRIM(cHeat)+"'"
					cMess = cMess+", RMA_Detail"+ALLTRIM(STR(nRMA_Detail))
					cMess = cMess+", TBL='"+cTBL2+"'"
					*TrackError(cMess,"nStkMastCntRid Not Found",PROGRAM(),LINENO(1) )
					TrackMess(cMess)
		
					*DO FORM forms\Recv_Stock WITH pPOitem, pTableName, nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, cLot, pnID_Master, pnWO_Detail
					
					PRIVATE cTableName 
					cTableName = 'StockLst'
					*Probably not the First receive, Check to see if for StockLst
					IF Count_POitem_StockLst ( cPOitem, 'S', ThisFormSet.nConnhandle ) > 0
						cTableName = 'StockLst'
						cTBL2 = "S"
					ELSE
						IF Count_POitem_StockLst ( cPOitem, 'B', ThisFormSet.nConnhandle ) > 0
							cTableName = 'BrokerLst'
							cTBL2 = "B"
						ENDIF
					ENDIF
					
					nMess = MESSAGEBOX("The PO item 'INCOMING' or 'NOT2HPA' or 'PARTRECV' mark is missing."+CHR(13)+CHR(13)+"This is most like a receive for '"+cTableName+"' table."+CHR(13)+"Just double checking!"+CHR(13)+"Do not worry about if you are to consume it."+CHR(13)+"Is this correct ? (Y)",3+32,"Save to "+cTableName )
					IF nMess != 6 &&No,Canc
					
						cTableName = IIF(cTableName = 'StockLst', 'BrokerLst', 'StockLst' )
						nMess = MESSAGEBOX("Would you rather receive to '"+cTableName+"' table?",3+32,"Save to "+cTableName )
						
						IF nMess!= 6
							*Must cancel!
							RETURN .F.
						ENDIF
						
					ENDIF
		
					*DO FORM forms\Recv_Stock WITH pPOitem, pTableName, nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, cLot, pnID_Master, pnWO_Detail
					DO FORM Forms\Recv_Stock WITH pPOitem, cTableName, nReceivingID, nRMA_Detail  ,   0        , cHeat, cLot,           0,  0
					ThisFormSet.lRan_Recv_Stock = .T.
					
					*Retrieve Detail by ReceivingID
					nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,cTableName,ThisFormSet.nConnhandle)
					nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTableName,ThisFormSet.nConnhandle) 
					ThisFormset.Receive_Edit.txtID_Master.Value = PrepareSQLnum(nID_Master,'ID',-3)
					ThisFormset.Receive_Edit.txtID_Detail.Value = PrepareSQLnum(nID_Detail,'ID_Detail',-3)
					ThisFormset.Receive_Edit.txtTBL.Value		= cTBL2
					
				ELSE
					* Services OR ConvServ OR Equipment
					*Do not add to stock
				ENDIF
			ENDCASE
			
		ENDIF
		
		*IF NOT lRMA
		*	IF nID_Master > 0 AND nID_Detail > 0
		*		Update_POStatus()
		*	ENDIF
		*ENDIF
		
		IF nRMA_Detail > 0
			*Is there a Detail record with this ReceivingID?
			nTestID_Detail = get_ID_Detail_from_RMA_Detail(cTBL2, nRMA_Detail, ThisFormSet.nConnhandle)
			
			IF nTestID_Detail <> nID_Detail AND nID_Detail > 0
				*Run this if NO ID_Detail,  Sometimes the Stock ID is recorded without ID_Master
		
				IF MESSAGEBOX("Will this Returned Material need to be relisted on Stock List?"+CHR(13)+"Open the Stock Add/Edit screen?",4,"Open Stock Edit screen?") = 6
					*
					*Is Master ID Still in Stock.
					*return needs a new ID_Detail
					*
					nID_Master = PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
					nID_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
					
		*!*				IF nID_Master = 0
		*!*					*Search of ID
		*!*					IF USED('tmpHist')
		*!*						USE IN tmpHist
		*!*					ENDIF
		*!*					
		*!*					SELECT 0
		*!*					cSQL = "SELECT Distinct M.ID,D.ID_Detail,M.Heat,M.Lot,M.Form "
		*!*					cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History P "
		*!*					cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D ON D.ID_Detail = P.ID_Detail "
		*!*					cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M ON M.ID = D.ID "
		*!*					cSQL = cSQL + " WHERE P.SOitem = '"+cSOitem+"'"
		*!*					cSQL = cSQL + " AND M.Heat = '"+ALLTRIM(cHeat)+"'"
		*!*					*Broker does not record Heat
		*!*					
		*!*					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpHist')
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpHist')
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0 &&Try again!
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpHist")
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpHist")
		*!*							
		*!*							IF nSQLEXEC < 0
		*!*								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*									nSQLEXEC = 0
		*!*								ENDIF
		*!*							ENDIF
		*!*						ENDDO
		*!*					ENDIF 
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL , ThisFormSet.nConnhandle, nSQLEXEC, 'tmpHist')
		*!*					ENDIF
		*!*					IF USED('tmpHist')
		*!*						IF RECCOUNT('tmpHist') > 0
		*!*							nID_Master = PrepareSQLnum(tmpHist.ID,'ID_Master',-3)
		*!*							ThisFormset.Receive_Edit.txtID_Master.Value = nID_Master
		*!*							*nID_Detail = tmpHist.ID_Detail
		*!*						ENDIF
		*!*						USE IN tmpHist
		*!*					ENDIF
		*!*				ENDIF		
					*
					*ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnhandle, 'StockLst ', nReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
					*DO FORM forms\Recv_Stock WITH pPOitem, pTableName, nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master, pnWO_Detail
					DO FORM Forms\Recv_Stock WITH pPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
					ThisFormSet.lRan_Recv_Stock = .T.
					
				ENDIF
			ENDIF
		ENDIF
		
		RETURN .T.
		
		
		
	ENDPROC

	PROCEDURE receivingsaveid_master
		PARAMETERS pReceivingID, pSOitem, pPOitem, nWO_Detail, cHeat, nPieces, nRMA, nActualW
		*ThisFormSet.ReceivingSaveID_Master( nReceivingID, cSOitem, cPOitem, cHeat, nPieces, nRMA )
		*Show_Recv_Order
		***Update ID_Master and StockTable in Receiving
		*a new receive should not have stock marked!
		*RecordID_Master to Receiving.
			
		IF VARTYPE(pReceivingID) != "N"
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF pReceivingID < 1
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(pSOitem) != "C"
			pSOitem = ""
		ENDIF
		
		IF VARTYPE(pPOitem) != "C"
			pPOitem = ""
		ENDIF
		IF pSOitem = Proper_SO_Item("")
			pSOitem = ''
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem)
			MESSAGEBOX("No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)" )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPieces) != "N"
			nPieces = 0
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem) AND EMPTY(nWO_Detail)
			MESSAGEBOX("No SO, PO, or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, nWO_Detail)",0,"Parameter Error")
			TrackError("Parameter Error","No SO, PO or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, nWO_Detail)",PROGRAM(),LINENO(1) )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPieces) != "N"
			nPieces = 0
		ENDIF
		
		IF VARTYPE(nRMA) != "N"
			nRMA = 0
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC 
		
		PRIVATE cLot
		cLot = PrepareSQLtxt(ThisFormset.Receive_Edit.txtLot.Value,'Lot',10)
		
		**Find StockLst or BrokerLst and store ID to Receiving
		*Check for Process
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process,cForm
		nID			= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail.Value,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormset.Receive_Edit.txtTBL.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisFormset.Receive_Edit.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		cForm = PrepareSQLtxt(ThisFormset.Receive_Edit.txtForm.Value,'Form',2)
		IF cTBL = "N"
			cTBL = " "
		ENDIF
		
		***********************************
		PRIVATE nTableID_Master, nTableID_Detail
		nTableID_Master = 0
		nTableID_Detail = 0
		
		********
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableName_ReceivingID("+STR(nReceivingID)+") AS TblName"  &&Returns Init
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						SCAN
							IF EMPTY(PrepareSQLtxt(tmpTable.TblName,'TblName',1))
								LOOP
							ELSE
								cTBL = PrepareSQLtxt(tmpTable.TblName,'TblName',1)
								ThisFormset.Receive_Edit.txtTBL.Value = cTBL
								EXIT
							ENDIF
						ENDSCAN
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ENDIF
		
		********
		
		IF nID_Detail < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_Detail_ReceivingID("+STR(nReceivingID)+") AS TableID_Detail"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
		
					IF RECCOUNT('tmpTable') > 0
						nTableID_Detail = PrepareSQLnum(tmpTable.TableID_Detail,'TableID_Detail',-3)
						ThisFormset.Receive_Edit.txtID_Detail.Value = nTableID_Detail 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Detail = nID_Detail
		ENDIF
		
		***********************************
		
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0
		
			*try for TBL using 'Listing created from %'
			IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
				IF nID > 0 AND nID_Detail > 0
					*Find TBL
					IF USED("tmpTBL")
						USE IN tmpTBL
					ENDIF
					SELECT 0
					
					cSQL =        " SELECT 'S' AS TBL, Form"	
					cSQL = cSQL + " FROM dbo.StockLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'B' AS TBL, Form"	
					cSQL = cSQL + " FROM dbo.BrokerLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'W' AS TBL, Form"	
					cSQL = cSQL + " FROM dbo.WIPLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTBL')
					ELSE
						IF USED('tmpTBL')
		
							IF RECCOUNT('tmpTBL') > 0
								cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
								cForm = PrepareSQLtxt(tmpTBL.Form,'Form',2)
							ENDIF
							USE IN 'tmpTBL'
						ENDIF
					ENDIF
				ENDIF	
			ENDIF
		
		ENDIF
		
		***********************************
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0 AND nReceivingID > 0
			&&*Process is updated with ReceivingId, not Set _Detail with ReceivingId
			DO CASE
			CASE cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail "
			CASE cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail "
			CASE cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
			
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		********
		
		IF nID < 1 AND nReceivingID > 0
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_ReceivingID("+STR(nReceivingID)+") AS TableID"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						nTableID_Master = PrepareSQLnum(tmpTable.TableID,'TableID',-3)
						ThisFormset.Receive_Edit.txtID_Master.Value = nTableID_Master 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Master = nID
		ENDIF
		
		
		***********************************
		
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			IF nTableID_Master = 0
				IF nRMA = 0
					IF nWO_Detail > 0
						*Consider a WO_Detail for Stock.
						cTBL = 'S'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		*recheck for ID,ID_Detail, ID_Detail_Process by POitem
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		IF Proper_PO_Item(pPOitem) != Proper_PO_Item('')
			IF nID = 0 AND nID_Detail = 0 AND nID_Detail_Process = 0
			
				*Check for a Process with that SOitem\WO_Detail and Heat
				nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"S",cHeat,ThisFormSet.nConnhandle)
				IF nID_Detail_Process = 0
					*Try Broker
					nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"B",cHeat,ThisFormSet.nConnhandle)
					IF nID_Detail_Process > 0
						cTBL = "B"
					ELSE
					
						*Try WIP WO_Detail
						nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"W",cHeat,ThisFormSet.nConnhandle)
						IF nID_Detail_Process > 0
							cTBL = "W"
						ELSE
						
							*Try S WO_Detail
							nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"S",cHeat,ThisFormSet.nConnhandle)
							IF nID_Detail_Process > 0
								cTBL = "S"
							ELSE
								*Try B WO_Detail
								nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"B",cHeat,ThisFormSet.nConnhandle)
								IF nID_Detail_Process > 0
									cTBL = "B"
								ELSE
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					cTBL = "S"
				ENDIF
				
				IF nID_Detail_Process > 0
					*FOUND IT, Get ID_Detail, ID
					DO CASE
					CASE cTBL = "S"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisFormSet.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisFormSet.nConnhandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF
					CASE cTBL = "B"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisFormSet.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisFormSet.nConnhandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF			
					CASE cTBL = "W"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisFormSet.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisFormSet.nConnhandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF				
					ENDCASE
					
					IF lFoundProcess
						ThisFormset.Receive_Edit.txtID_Master.Value = nID
						nTableID_Master = nID
						ThisFormset.Receive_Edit.txtID_Detail.Value = nID_Detail
						nTableID_Detail = nID_Detail
						ThisFormset.Receive_Edit.txtID_Detail_Process.Value = nID_Detail_Process
						ThisFormset.Receive_Edit.txtTBL.Value = cTBL
						ThisFormset.Receive_Edit.txtForm.Value = cForm
						
						ThisFormSet.Stocklst_ID		= nTableID_Master 
						ThisFormSet.Stocklst_ID_Detail	= nTableID_Detail 
						ThisFormSet.StockLst_TBL		= UPPER(cTBL)
					ENDIF
				ELSE
					*ADD to Stock?		
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Recheck for TBL
		IF cTBL!= "S" AND cTBL!= "B" AND cTBL!= "W" 
			IF nID > 0 AND nID_Detail > 0
				*Find TBL
				
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				SELECT 0
				cSQL =        " SELECT 'S' AS TBL"	
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'B' AS TBL"	
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'W' AS TBL"	
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
		
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
		
						IF RECCOUNT('tmpTBL') > 0
							cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
		*					TrackError("Found ID and ID_Detail in table '"+cTBL+"'.","Change in TBL!",PROGRAM(),LINENO(1))
						ELSE
							PRIVAT cMess
							cMess = "Stocklst ID = "+STR(nID)+CHR(13)
							cMess = cMess +"Stocklst ID_Detail = "+STR(nID_Detail)+CHR(13)
							cMess = cMess +"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +"TBL Could not be Identified"
							TrackError(cMess,"No TBL!",PROGRAM(),LINENO(1))
							
						ENDIF
						USE IN 'tmpTBL'
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		***********************************
		*Get nID_Detail_Process 
		
		IF nID > 0 AND nID_Detail > 0 AND nID_Detail_Process = 0
			IF cTBL!= "S" AND cTBL!= "B" AND cTBL!= "W" 
				IF USED("tmpID_D_P")
					USE IN tmpID_D_P
				ENDIF
				SELECT 0
				cSQL = " SELECT * FROM "	
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Process "
				CASE cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Process "
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
				IF nReceivingID > 0
					cSQL = cSQL + " AND ReceivingID = "+STR(nReceivingID)
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpID_D_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpID_D_P')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpID_D_P")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpID_D_P")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpID_D_P')
				ELSE
					IF USED('tmpID_D_P')
		
						IF RECCOUNT('tmpID_D_P') > 0
							SCAN
								nID_Detail_Process = PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
							ENDSCAN
						ENDIF
						
						USE IN tmpID_D_P
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Create Receive Process if have Table, ID_Detail AND no ID_Detail_Proc, BUT not found in History!
		IF nID_Detail_Process = 0
			IF NOT EMPTY(cTBL)
				IF nTableID_Detail > 0
					*Add a Receiving record to History, Only one that shows the ReceivingID
					ThisFormSet.Create_Receive_Process(cTBL,nTableID_Detail,pSOitem,pPOitem,nReceivingID, nActualW, nID_Detail_Process)
				ENDIF
			ENDIF		
		ENDIF
		
		
		***********************************
		IF nID_Detail_Process > 0 AND nReceivingID > 0
			IF NOT EMPTY(cTBL)
				*Update Process with ReceivingID
				DO CASE
				CASE cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Process SET"
				CASE cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Process SET"
				CASE cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Process SET"
				ENDCASE
				cSQLu = cSQLu +" ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update"+CHR(13)+"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		
		***********************************
		IF nID_Detail > 0
			IF NOT EMPTY(cTBL)
				*Update Detail with Receiving ID
				DO CASE
				CASE cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Detail "
				CASE cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Detail "
				CASE cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Detail "
				ENDCASE
				cSQLu = cSQLu +" SET ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail = "+STR(nID_Detail )
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"Could not update" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		***********************************
		
		IF nTableID_Master > 0
			IF NOT EMPTY(cTBL)
				*Check for Heat match
				
				IF USED("tmpMasterHeat")
					USE IN tmpMasterHeat
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS CTND "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +" FROM dbo.StockLst_Master "
				CASE cTBL = "B"
					cSQL = cSQL +" FROM dbo.BrokerLst_Master "
				CASE cTBL = "W"
					cSQL = cSQL +" FROM dbo.WIPLst_Master "
				ENDCASE
				cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
				cSQL = cSQL +" AND Heat = '"+cHeat+"'"
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterHeat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterHeat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterHeat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpMasterHeat')
				ELSE
					IF USED('tmpMasterHeat')
						IF VARTYPE(tmpMasterHeat.CTND)='N'
							*********
							IF tmpMasterHeat.CTND = 0			
								*Did not Find Correct Heat!
								*look for 'Due in'
								
								IF USED("tmpMasterDueIn")
									USE IN tmpMasterDueIn
								ENDIF
								
								cSQL = "SELECT COUNT(*) AS CTND "
								DO CASE
								CASE cTBL = "S"
									cSQL = cSQL +" FROM dbo.StockLst_Master "
								CASE cTBL = "B"
									cSQL = cSQL +" FROM dbo.BrokerLst_Master "
								CASE cTBL = "W"
									cSQL = cSQL +" FROM dbo.WIPLst_Master "
								ENDCASE
								cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
								cSQL = cSQL +" AND Heat = 'DUE IN'" 
		
								SELECT 0
		
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterDueIn')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterDueIn')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterDueIn")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterDueIn")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpMasterDueIn')
								ELSE
									IF USED('tmpMasterDueIn')
										IF VARTYPE(tmpMasterDueIn.CTND)='N'
											IF tmpMasterDueIn.CTND = 0
												*Did not Find Correct Heat or 'Due In'!
												nTableID_Master = 0
											ENDIF
										ENDIF
										USE IN tmpMasterDueIn
									ENDIF				
								ENDIF
							*********					
							ENDIF
						ENDIF
						USE IN tmpMasterHeat
					ENDIF				
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		
		PRIVATE lSaved
		lSaved = .F.
		
		IF nTableID_Master = 0
			IF nID > 0
				nTableID_Master = nID
			ENDIF
			IF nID_Master > 0
				nTableID_Master = nID_Master
			ENDIF	
		ENDIF
		
		IF nTableID_Master > 0
			
			cSQLu = "UPDATE dbo.Receiving SET"
			cSQLu = cSQLu +" ID_Master = "+STR(nTableID_Master)+""
			cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)+""
			cSQLu = cSQLu +",StockTable = '"+cTBL+"'"
			cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not update dbo.Receiving" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
			ELSE 
				lSaved = .T.
			ENDIF
		ELSE
			lSaved = .F.
		
		*	PRIVATE cText
		*	cText = "Not in StockLst or BrokerLst!"+CHR(13)+"Did not save StockLst ID to Receiving table! No ID_Master for StockTable = '"+cTBL+"' AND Receiving ID = "+STR(nReceivingID)
		*	MESSAGEBOX( cText ,0+48,"ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		*	TrackMess(cText)
		ENDIF
		
		***********************************
		
		IF nTableID_Master > 0
			IF NOT ( ThisFormSet.Stocklst_ID = nTableID_Master AND ThisFormSet.Stocklst_ID_Detail = nTableID_Detail AND ThisFormSet.StockLst_TBL = UPPER(cTBL) )
				IF EMPTY(cTBL) OR ThisFormSet.Stocklst_ID>0
					PRIVAT cMess
					cMess = "Stocklst_ID = "+STR(ThisFormSet.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
					cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisFormSet.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
					cMess = cMess +"StockLst_TBL = '"+ThisFormSet.StockLst_TBL+"' 		TBL1 = '"+UPPER(cTBL)+"'"+CHR(13)
					cMess = cMess +"ReceivingID="+STR(nReceivingID)
					TrackError(cMess,"Change in ID, ID_Detail, or TBL!",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
			
			IF ThisFormSet.Stocklst_ID = 0
				ThisFormSet.Stocklst_ID		= nTableID_Master 
				ThisFormSet.Stocklst_ID_Detail	= nTableID_Detail 
				*ThisFormSet.ID_Detail_process
			ENDIF
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			IF ThisFormSet.Stocklst_ID > 0 AND ThisFormSet.Stocklst_ID_Detail > 0
			
				*What Table has ID and ID_Detail combo
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				
				cSQL = "SELECT 'S' AS TBL FROM dbo.Stocklst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisFormSet.Stocklst_ID) 
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisFormSet.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'B' AS TBL FROM dbo.BrokerLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisFormSet.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisFormSet.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'W' AS TBL FROM dbo.WIPLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisFormSet.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisFormSet.Stocklst_ID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
						IF RECCOUNT('tmpTBL')>0
							cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							PRIVAT cMess
							cMess = "Stocklst_ID = "+STR(ThisFormSet.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
							cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisFormSet.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
							cMess = cMess +"StockLst_TBL = '"+ThisFormSet.StockLst_TBL+"' 		TBL1 = ''"
							cMess = cMess +CHR(13)+"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +CHR(13)+"TBL1 now= '"+UPPER(cTBL)+"'"
		*					TrackError(cMess+CHR(13)+CHR(13)+cSQL,"Change TBL!",PROGRAM(),LINENO(1))
						ENDIF
						USE IN tmpTBL
					ENDIF
				ENDIF	
			ENDIF
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			*Found a TBL, Show it on screen
			ThisFormSet.StockLst_TBL = UPPER(cTBL)
			ThisFormset.Receive_Edit.txtTBL.Value = UPPER(cTBL)
			ThisFormset.Receive_Edit.txtTBL.Refresh
		ENDIF
		
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
		
		RETURN lSaved
	ENDPROC

	PROCEDURE receivingsaveid_master2
		PARAMETERS pReceivingID, pSOitem, pPOitem, cHeat, nPC_Recv, nRMA, nRcv_HPA_QTY
		*PARAMETERS pReceivingID, pSOitem, pPOitem, nWO_Detail, cHeat, nPC_Recv, nRMA, nRcv_HPA_QTY
		*ThisFormSet.ReceivingSaveID_Master( nReceivingID, cSOitem, cPOitem, cHeat, nPC_Recv, nRMA )
		
		***Update ID_Master and StockTable in Receiving
		*a new receive should not have stock marked!
		*RecordID_Master to Receiving.
		
			
		IF VARTYPE(pReceivingID) != "N"
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisFormSet.nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisFormSet.nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF pReceivingID < 1
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisFormSet.nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisFormSet.nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(pSOitem) != "C"
			pSOitem = ""
		ENDIF
		
		IF VARTYPE(pPOitem) != "C"
			pPOitem = ""
		ENDIF
		IF pSOitem = Proper_SO_Item("")
			pSOitem = ''
		ENDIF
		
		*IF VARTYPE(nWO_Detail) != "N"
		*	nWO_Detail = 0
		*ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem)
			MESSAGEBOX("No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)" )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPC_Recv) != "N"
			nPC_Recv = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem) AND EMPTY(ThisFormSet.nWO_Detail)
			MESSAGEBOX("No SO, PO, or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, ThisFormSet.nWO_Detail)",0,"Parameter Error")
			TrackError("Parameter Error","No SO, PO or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, ThisFormSet.nWO_Detail)",PROGRAM(),LINENO(1) )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPC_Recv) != "N"
			nPC_Recv = 0
		ENDIF
		
		IF VARTYPE(nRMA) != "N"
			nRMA = 0
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC 
		
		**Find StockLst or BrokerLst and store ID to Receiving
		*Check for Process
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID			= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtID_Detail.Value,'ID_Detail',-3)
		ThisFormSet.cTBL	= PrepareSQLtxt(ThisFormSet.Show_Recv_Order.txtTBL.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		
		***********************************
		PRIVATE nTableID_Master, nTableID_Detail
		nTableID_Master = 0
		nTableID_Detail = 0
		
		********
		IF NOT ( ThisFormSet.cTBL = "S" OR ThisFormSet.cTBL = "B" OR ThisFormSet.cTBL = "W" )
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableName_ReceivingID("+STR(nReceivingID)+") AS TblName"  &&Returns Init
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						SCAN
							IF EMPTY(PrepareSQLtxt(tmpTable.TblName,'TblName',1))
								LOOP
							ELSE
								ThisFormSet.cTBL = PrepareSQLtxt(tmpTable.TblName,'TblName',1)
								ThisFormSet.Show_Recv_Order.txtTBL.Value = ThisFormSet.cTBL
								EXIT
							ENDIF
						ENDSCAN
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ENDIF
		
		********
		
		IF nID_Detail < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_Detail_ReceivingID("+STR(nReceivingID)+") AS TableID_Detail"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
		
					IF RECCOUNT('tmpTable') > 0
						nTableID_Detail = PrepareSQLnum(tmpTable.TableID_Detail,'TableID_Detail',-3)
						ThisFormSet.Show_Recv_Order.txtID_Detail.Value = nTableID_Detail 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Detail = nID_Detail
		ENDIF
		
		***********************************
		
		
		IF NOT ( ThisFormSet.cTBL = "S" OR ThisFormSet.cTBL = "B" OR ThisFormSet.cTBL = "W" ) AND nID_Detail > 0
		
			*try for TBL using 'Listing created from %'
			IF NOT ( ThisFormSet.cTBL = "S" OR ThisFormSet.cTBL = "B" OR ThisFormSet.cTBL = "W" )
				IF nID > 0 AND nID_Detail > 0
					*Find TBL
					IF USED("tmpTBL")
						USE IN tmpTBL
					ENDIF
					SELECT 0
					
					cSQL =        " SELECT 'S' AS TBL"	
					cSQL = cSQL + " FROM dbo.StockLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'B' AS TBL"	
					cSQL = cSQL + " FROM dbo.BrokerLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'W' AS TBL"	
					cSQL = cSQL + " FROM dbo.WIPLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTBL')
					ELSE
						IF USED('tmpTBL')
		
							IF RECCOUNT('tmpTBL') > 0
								ThisFormSet.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							ENDIF
							USE IN 'tmpTBL'
						ENDIF
					ENDIF
				ENDIF	
			ENDIF
		
		ENDIF
		
		***********************************
		
		IF NOT ( ThisFormSet.cTBL = "S" OR ThisFormSet.cTBL = "B" OR ThisFormSet.cTBL = "W" ) AND nID_Detail > 0	
			&&*Process is updated with ReceivingId, not Set _Detail with ReceivingId
			DO CASE
			CASE ThisFormSet.cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail "
			CASE ThisFormSet.cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail "
			CASE ThisFormSet.cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
			
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		********
		
		IF nID < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_ReceivingID("+STR(nReceivingID)+") AS TableID"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						nTableID_Master = PrepareSQLnum(tmpTable.TableID,'TableID',-3)
						ThisFormSet.Show_Recv_Order.txtID_Master.Value = nTableID_Master 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Master = nID
		ENDIF
		
		
		***********************************
		
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			IF nTableID_Master = 0
				IF nRMA = 0
					IF ThisFormSet.nWO_Detail > 0
						*Consider a WO_Detail for Stock.
						ThisFormSet.cTBL = 'S'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		*recheck for ID,ID_Detail, ID_Detail_Process by POitem
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		IF Proper_PO_Item(pPOitem) != Proper_PO_Item('')
			IF nID = 0 AND nID_Detail = 0 AND nID_Detail_Process = 0
			
				*Check for a Process with that SOitem\WO_Detail and Heat
				nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"S",cHeat,ThisFormSet.nConnhandle)
				IF nID_Detail_Process = 0
					*Try Broker
					nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"B",cHeat,ThisFormSet.nConnhandle)
					IF nID_Detail_Process > 0
						ThisFormSet.cTBL = "B"
					ELSE
					
						*Try WIP WO_Detail
						nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisFormSet.nWO_Detail,"W",cHeat,ThisFormSet.nConnhandle)
						IF nID_Detail_Process > 0
							ThisFormSet.cTBL = "W"
						ELSE
						
							*Try S WO_Detail
							nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisFormSet.nWO_Detail,"S",cHeat,ThisFormSet.nConnhandle)
							IF nID_Detail_Process > 0
								ThisFormSet.cTBL = "S"
							ELSE
								*Try B WO_Detail
								nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisFormSet.nWO_Detail,"B",cHeat,ThisFormSet.nConnhandle)
								IF nID_Detail_Process > 0
									ThisFormSet.cTBL = "B"
								ELSE
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					ThisFormSet.cTBL = "S"
				ENDIF
				
				IF nID_Detail_Process > 0
					*FOUND IT, Get ID_Detail, ID
					DO CASE
					CASE ThisFormSet.cTBL = "S"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisFormSet.cTBL ,ThisFormSet.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisFormSet.cTBL, ThisFormSet.nConnhandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF
					CASE ThisFormSet.cTBL = "B"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisFormSet.cTBL ,ThisFormSet.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisFormSet.cTBL, ThisFormSet.nConnhandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF			
					CASE ThisFormSet.cTBL = "W"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisFormSet.cTBL ,ThisFormSet.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisFormSet.cTBL, ThisFormSet.nConnhandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF				
					ENDCASE
					
					IF lFoundProcess
						ThisFormSet.Show_Recv_Order.txtID_Master.Value = nID
						nTableID_Master = nID
						ThisFormSet.Show_Recv_Order.txtID_Detail.Value = nID_Detail
						nTableID_Detail = nID_Detail
						ThisFormSet.Show_Recv_Order.txtID_Detail_Process.Value = nID_Detail_Process
						ThisFormSet.Show_Recv_Order.txtTBL.Value = ThisFormSet.cTBL
					
						ThisFormSet.Stocklst_ID		= nTableID_Master 
						ThisFormSet.Stocklst_ID_Detail	= nTableID_Detail 
						ThisFormSet.StockLst_TBL		= UPPER(ThisFormSet.cTBL)
					ENDIF
				ELSE
					*ADD to Stock?		
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Recheck for TBL
		IF ThisFormSet.cTBL!= "S" AND ThisFormSet.cTBL!= "B" AND ThisFormSet.cTBL!= "W" 
			IF nID > 0 AND nID_Detail > 0
				*Find TBL
				
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				SELECT 0
				cSQL =        " SELECT 'S' AS TBL"	
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'B' AS TBL"	
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'W' AS TBL"	
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
		
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
		
						IF RECCOUNT('tmpTBL') > 0
							ThisFormSet.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
		*					TrackError("Found ID and ID_Detail in table '"+ThisFormSet.cTBL+"'.","Change in TBL!",PROGRAM(),LINENO(1))
						ELSE
							PRIVAT cMess
							cMess = "Stocklst ID = "+STR(nID)+CHR(13)
							cMess = cMess +"Stocklst ID_Detail = "+STR(nID_Detail)+CHR(13)
							cMess = cMess +"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +"TBL Could not be Identified"
							TrackError(cMess,"No TBL!",PROGRAM(),LINENO(1))
							
						ENDIF
						USE IN 'tmpTBL'
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		***********************************
		*Get nID_Detail_Process 
		
		IF nID > 0 AND nID_Detail > 0 AND nID_Detail_Process = 0
			IF ThisFormSet.cTBL!= "S" AND ThisFormSet.cTBL!= "B" AND ThisFormSet.cTBL!= "W" 
				IF USED("tmpID_D_P")
					USE IN tmpID_D_P
				ENDIF
				SELECT 0
				cSQL = " SELECT * FROM "	
				DO CASE
				CASE ThisFormSet.cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Process "
				CASE ThisFormSet.cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Process "
				CASE ThisFormSet.cTBL = "S"
					cSQL = cSQL + " dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
				IF nReceivingID > 0
					cSQL = cSQL + " AND ReceivingID = "+STR(nReceivingID)
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpID_D_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpID_D_P')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpID_D_P")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpID_D_P")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpID_D_P')
				ELSE
					IF USED('tmpID_D_P')
		
						IF RECCOUNT('tmpID_D_P') > 0
							SCAN
								nID_Detail_Process = PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
							ENDSCAN
						ENDIF
						
						USE IN tmpID_D_P
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Create Receive Process if have Table, ID_Detail AND no ID_Detail_Proc, BUT not found in History!
		IF nID_Detail_Process = 0
			IF NOT EMPTY(ThisFormSet.cTBL)
				IF nTableID_Detail > 0
					*Add a Receiving record to History, Only one that shows the ReceivingID
					ThisFormSet.Create_Receive_Process(ThisFormSet.cTBL,nTableID_Detail,pSOitem,pPOitem,nReceivingID, nRcv_HPA_QTY, nID_Detail_Process)
				ENDIF
			ENDIF		
		ENDIF
		
		
		***********************************
		IF nID_Detail_Process > 0 AND nReceivingID > 0
			IF NOT EMPTY(ThisFormSet.cTBL)
				*Update Process with ReceivingID
				DO CASE
				CASE ThisFormSet.cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Process SET"
				CASE ThisFormSet.cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Process SET"
				CASE ThisFormSet.cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Process SET"
				ENDCASE
				cSQLu = cSQLu +" ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update"+CHR(13)+"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		
		***********************************
		IF nID_Detail > 0
			IF NOT EMPTY(ThisFormSet.cTBL)
				*Update Detail with Receiving ID
				DO CASE
				CASE ThisFormSet.cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Detail "
				CASE ThisFormSet.cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Detail "
				CASE ThisFormSet.cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Detail "
				ENDCASE
				cSQLu = cSQLu +" SET ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail = "+STR(nID_Detail )
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"Could not update" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		***********************************
		
		IF nTableID_Master > 0
			IF NOT EMPTY(ThisFormSet.cTBL)
				*Check for Heat match
				
				IF USED("tmpMasterHeat")
					USE IN tmpMasterHeat
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS CTND "
				DO CASE
				CASE ThisFormSet.cTBL = "S"
					cSQL = cSQL +" FROM dbo.StockLst_Master "
				CASE ThisFormSet.cTBL = "B"
					cSQL = cSQL +" FROM dbo.BrokerLst_Master "
				CASE ThisFormSet.cTBL = "W"
					cSQL = cSQL +" FROM dbo.WIPLst_Master "
				ENDCASE
				cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
				cSQL = cSQL +" AND Heat = '"+cHeat+"'"
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterHeat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterHeat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterHeat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpMasterHeat')
				ELSE
					IF USED('tmpMasterHeat')
						IF VARTYPE(tmpMasterHeat.CTND)='N'
							*********
							IF tmpMasterHeat.CTND = 0			
								*Did not Find Correct Heat!
								*look for 'Due in'
								
								IF USED("tmpMasterDueIn")
									USE IN tmpMasterDueIn
								ENDIF
								
								cSQL = "SELECT COUNT(*) AS CTND "
								DO CASE
								CASE ThisFormSet.cTBL = "S"
									cSQL = cSQL +" FROM dbo.StockLst_Master "
								CASE ThisFormSet.cTBL = "B"
									cSQL = cSQL +" FROM dbo.BrokerLst_Master "
								CASE ThisFormSet.cTBL = "W"
									cSQL = cSQL +" FROM dbo.WIPLst_Master "
								ENDCASE
								cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
								cSQL = cSQL +" AND Heat = 'DUE IN'" 
		
								SELECT 0
		
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterDueIn')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpMasterDueIn')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterDueIn")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpMasterDueIn")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpMasterDueIn')
								ELSE
									IF USED('tmpMasterDueIn')
										IF VARTYPE(tmpMasterDueIn.CTND)='N'
											IF tmpMasterDueIn.CTND = 0
												*Did not Find Correct Heat or 'Due In'!
												nTableID_Master = 0
											ENDIF
										ENDIF
										USE IN tmpMasterDueIn
									ENDIF				
								ENDIF
							*********					
							ENDIF
						ENDIF
						USE IN tmpMasterHeat
					ENDIF				
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		
		PRIVATE lSaved
		lSaved = .F.
		
		IF nTableID_Master = 0
			IF nID > 0
				nTableID_Master = nID
			ENDIF
			IF nID_Master > 0
				nTableID_Master = nID_Master
			ENDIF	
		ENDIF
		
		IF nTableID_Master > 0
			
			cSQLu = "UPDATE dbo.Receiving SET"
			cSQLu = cSQLu +" ID_Master = "+STR(nTableID_Master)+""
			cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)+""
			cSQLu = cSQLu +",StockTable = '"+ThisFormSet.cTBL+"'"
			cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not update dbo.Receiving" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
			ELSE 
				lSaved = .T.
			ENDIF
		ELSE
			lSaved = .F.
		
		*	PRIVATE cText
		*	cText = "Not in StockLst or BrokerLst!"+CHR(13)+"Did not save StockLst ID to Receiving table! No ID_Master for StockTable = '"+ThisFormSet.cTBL+"' AND Receiving ID = "+STR(nReceivingID)
		*	MESSAGEBOX( cText ,0+48,"ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		*	TrackMess(cText)
		ENDIF
		
		***********************************
		
		IF nTableID_Master > 0
			IF NOT ( ThisFormSet.Stocklst_ID = nTableID_Master AND ThisFormSet.Stocklst_ID_Detail = nTableID_Detail AND ThisFormSet.StockLst_TBL = UPPER(ThisFormSet.cTBL) )
				IF EMPTY(ThisFormSet.cTBL) OR ThisFormSet.Stocklst_ID>0
					PRIVAT cMess
					cMess = "Stocklst_ID = "+STR(ThisFormSet.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
					cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisFormSet.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
					cMess = cMess +"StockLst_TBL = '"+ThisFormSet.StockLst_TBL+"' 		TBL1 = '"+UPPER(ThisFormSet.cTBL)+"'"+CHR(13)
					cMess = cMess +"ReceivingID="+STR(nReceivingID)
					TrackError(cMess,"Change in ID, ID_Detail, or TBL!",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
			
			IF ThisFormSet.Stocklst_ID = 0
				ThisFormSet.Stocklst_ID		= nTableID_Master 
				ThisFormSet.Stocklst_ID_Detail	= nTableID_Detail 
				*ThisFormSet.Show_Recv_Order.ID_Detail_process
			ENDIF
		ENDIF
		
		IF NOT ( ThisFormSet.cTBL = "S" OR ThisFormSet.cTBL = "B" OR ThisFormSet.cTBL = "W" )
			IF ThisFormSet.Stocklst_ID > 0 AND ThisFormSet.Stocklst_ID_Detail > 0
			
				*What Table has ID and ID_Detail combo
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				
				cSQL = "SELECT 'S' AS TBL FROM dbo.Stocklst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisFormSet.Stocklst_ID) 
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisFormSet.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'B' AS TBL FROM dbo.BrokerLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisFormSet.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisFormSet.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'W' AS TBL FROM dbo.WIPLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisFormSet.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisFormSet.Stocklst_ID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
						IF RECCOUNT('tmpTBL')>0
							ThisFormSet.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							PRIVAT cMess
							cMess = "Stocklst_ID = "+STR(ThisFormSet.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
							cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisFormSet.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
							cMess = cMess +"StockLst_TBL = '"+ThisFormSet.StockLst_TBL+"' 		TBL1 = ''"
							cMess = cMess +CHR(13)+"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +CHR(13)+"TBL1 now= '"+UPPER(ThisFormSet.cTBL)+"'"
		*					TrackError(cMess+CHR(13)+CHR(13)+cSQL,"Change TBL!",PROGRAM(),LINENO(1))
						ENDIF
						USE IN tmpTBL
					ENDIF
				ENDIF	
			ENDIF
		ENDIF
		
		IF NOT ( ThisFormSet.cTBL = "S" OR ThisFormSet.cTBL = "B" OR ThisFormSet.cTBL = "W" )
			*Found a TBL, Show it on screen
			ThisFormSet.StockLst_TBL = UPPER(ThisFormSet.cTBL)
			ThisFormSet.Show_Recv_Order.txtTBL.Value = UPPER(ThisFormSet.cTBL)
			ThisFormSet.Show_Recv_Order.txtTBL.Refresh
		ENDIF
		
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
		
		RETURN lSaved
	ENDPROC

	PROCEDURE refresh_rma_detail
		*ThisFormSet.Refresh_RMA_Detail()
		*Receive_Edit
		
		PRIVATE nRMA_Detail, nRMA, cHeat
		nRMA_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
		IF nRMA_Detail = 0
			RETURN
		ENDIF
		
		nRMA 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisFormset.Receive_Edit.txtHeat.Value,'Heat',50)
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormset.Receive_Edit.txtSoitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		PRIVATE cMess
		PRIVATE cSQL, nSQLExec
		
		IF nRMA_Detail > 0
			IF USED("tmpRcvRMA")
				USE IN tmpRcvRMA
			ENDIF
		
			cSQL = "SELECT ID "
			cSQL = cSQL + " FROM dbo.Receiving "
			cSQL = cSQL + " WHERE RMA_Detail = "+STR(nRMA_Detail)
					
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRcvRMA')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRcvRMA' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRcvRMA")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRcvRMA")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRcvRMA' )
			ENDIF
						
			IF USED('tmpRcvRMA')
				IF RECCOUNT('tmpRcvRMA') > 0	
					nReceivingID = PrepareSQLnum(tmpRcvRMA.ID,'ReceiveID',-3)
					PRIVATE nMess
					nMess =  MESSAGEBOX("Found a Receive with this RMA Detail: "+ALLTRIM(STR(nRMA_Detail))+CHR(13)+"Receiving ID: "+ALLTRIM(STR(nReceivingID))+CHR(13)+"Do you want to Edit this Receive? (Y)"+CHR(13)+"Here is a chance to edit the Receive."+CHR(13)+CHR(13)+"Answer No to be able to ADD another receive to this RMA.",4+32,"Edit Data") 
					IF nMess = 6
						ThisFormset.Receive_Edit.txtReceivingID.Value = nReceivingID 
						ThisFormSet.getBy_ReceivingID()
						RETURN
					ENDIF
					IF nMess <> 7
						RETURN
					ENDIF
				ENDIF
				USE IN tmpRcvRMA
			ENDIF
		ENDIF
		
		************************************************************************
		IF nRMA_Detail > 0
			
			IF USED("tmpRMA_D")
				USE IN tmpRMA_D
			ENDIF
		
			cSQL = "SELECT RMA.Money,RMA_Detail.Reason,RMA.Aprv_By,RMA_Detail.SO_item ,RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
			cSQL = cSQL + ",SS.StockLst_ID,SS.StockLst_ID_Detail,SS.TBL,SS.ID "
			cSQL = cSQL + ",SS.StockLst_PU,SS.StockLst_PC,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3, SS.StockLst_LBS,SS.Heat,SS.Lot,SS.PS_PC "
			cSQL = cSQL + ",SS.Removed_QTY ,SS.Form ,SS.Invoice_QTY ,SS.Invoice_P ,SS.PS_QTY ,SS.Left_QTY,SS.PackingSli, SS.Reconciled,SS.Returned, SS.Alloy "
			cSQL = cSQL + ",dbo.f_DescriptCL(SS.Alloy,SS.CC,SS.CL,SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY,0) AS Descript_CL "
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Removed_PC, SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY, 0, 0, '', '', '') AS Descript_M "
		
			cSQL = cSQL + " FROM dbo.RMA RMA WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.RMA_Detail WITH(NOLOCK) ON RMA.RMA_No = RMA_Detail.RMA_NO "
			cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH(NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
			cSQL = cSQL + " WHERE RMA_Detail.RMA_Detail_ID = "+STR(nRMA_Detail)
			IF NOT EMPTY(cHeat)	
				cSQL = cSQL + " AND SS.Heat = '"+cHeat+"'"
			ENDIF
					
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRMA_D')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRMA_D' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_D")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_D")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRMA_D' )
			ENDIF
		
			IF NOT USED('tmpRMA_D') OR RECCOUNT('tmpRMA_D') = 0	
				*try without HEAT
				cSQL = "SELECT RMA.Money,RMA_Detail.Reason,RMA.Aprv_By,RMA_Detail.SO_item ,RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
				cSQL = cSQL + ",SS.StockLst_ID,SS.StockLst_ID_Detail,SS.TBL, SS.ID "
				cSQL = cSQL + ",SS.StockLst_PU,SS.StockLst_PC,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3, SS.StockLst_LBS,SS.Heat,SS.Lot,SS.PS_PC "
				cSQL = cSQL + ",SS.Removed_QTY ,SS.Form ,SS.Invoice_QTY ,SS.Invoice_P ,SS.PS_QTY ,SS.Left_QTY,SS.PackingSli, SS.Reconciled,SS.Returned, SS.Alloy "
				cSQL = cSQL + ",dbo.f_DescriptCL(SS.Alloy,SS.CC,SS.CL,SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY,0) AS Descript_CL "
				cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Removed_PC, SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY, 0, 0, '', '', '') AS Descript_M "
		
				cSQL = cSQL + " FROM dbo.RMA RMA WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.RMA_Detail WITH(NOLOCK) ON RMA.RMA_No = RMA_Detail.RMA_NO "
				cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH(NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
				cSQL = cSQL + " WHERE RMA_Detail.RMA_Detail_ID = "+STR(nRMA_Detail)
						
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRMA_D')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRMA_D' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_D")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_D")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRMA_D' )
				ENDIF
				
			ENDIF	
				
				
			IF USED('tmpRMA_D')
				IF RECCOUNT('tmpRMA_D') > 0	
					PRIVATE nRecCount, nRecNo, nMess, cMess
					nRecCount = RECCOUNT()
					nRecNo	= RECNO()
					*cSOitem = Proper_SO_item(ThisFormSet.cSOitem)
					
					SCAN
					
		*!*					IF Proper_SO_item(tmpRMA_D.SO_item) <> Proper_SO_item('') AND Proper_SO_item(cSOitem) <> Proper_SO_item('')
		*!*						IF Proper_SO_item(tmpRMA_D.SO_item) <> cSOitem
		*!*							MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem = "+Proper_SO_item(tmpRMA_D.SO_item),16,"Does not Match")
		*!*							*EXIT
		*!*							IF USED('tmpRMA_D')
		*!*								USE IN tmpRMA_D
		*!*							ENDIF
		*!*							RETURN
		*!*						ENDIF
		*!*					ENDIF
						
						IF nRecNo < nRecCount
							cMess = "Record: "+ALLTRIM(STR(nRecNo))+" of "+ALLTRIM(STR(nRecCount))+" records."+CHR(13)
						ELSE
							cMess = "1 Record."+CHR(13)
						ENDIF
						cMess = cMess + "Description: "+tmpRMA_D.Descript_CL+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA_D.Money,'Money',-3))+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA_D.Reason,'Reason',-3))+CHR(13)+CHR(13)
						cMess = cMess + "Is this the RMA Item you want to use for Receiving?"
						*cMess = cMess + "Approved By:"+ALLTRIM(PrepareSQLtxt(tmpRMA_D.Aprv_By,'Appv_By',-3))
						
						nMess = MESSAGEBOX(cMess,4+32,"RMA Description") 
						
						IF nMess = 6		
							ThisFormSet.RMA_SS_ID = PrepareSQLnum(tmpRMA_D.ID,'SS_ID',-3)
								
							ThisFormset.Receive_Edit.txtReceivingID.Value = 0
							
							ThisFormset.Receive_Edit.txtReceived.Value = DATE()
							
							ThisFormset.Receive_Edit.txtSOnum.Value = Proper_SO_Item_SO(tmpRMA_D.SO_item)
							ThisFormset.Receive_Edit.txtSOitem.Value = Proper_SO_Item_Item(tmpRMA_D.SO_item)
							ThisFormSet.cSOitem = Proper_SO_Item(tmpRMA_D.SO_item)
		
							ThisFormset.Receive_Edit.txtAlloy.Value = PrepareSQLtxt(tmpRMA_D.Alloy,'Alloy',12)
							ThisFormset.Receive_Edit.txtHeat.Value	= PrepareSQLtxt(tmpRMA_D.Heat,'Heat',50)
							ThisFormset.Receive_Edit.txtLot.Value	= PrepareSQLtxt(tmpRMA_D.Lot,'Lot',10)
							ThisFormset.Receive_Edit.chkCert.Value	= 1
							ThisFormset.Receive_Edit.txtPieces.Value= PrepareSQLnum(tmpRMA_D.PS_PC,'Pieces',-3)
		
							ThisFormset.Receive_Edit.edtDescription.Value = PrepareSQLtxt(tmpRMA_D.Descript_M,'Descript',-1)					
							ThisFormset.Receive_Edit.edtSpecs.Value 	= PrepareSQLtxt(tmpRMA_D.Money,'Money',-3)
							ThisFormset.Receive_Edit.edtComments.Value	= PrepareSQLtxt(tmpRMA_D.Reason,'Reason',-3)
		
							ThisFormset.Receive_Edit.txtDate.Value = DATE()	
							ThisFormset.Receive_Edit.chkPass.Value = 1
							ThisFormset.Receive_Edit.chkGoodPapers.Value = 1
							ThisFormset.Receive_Edit.chkHold.Value = 0
							ThisFormset.Receive_Edit.txtVendor.Value = ''
							
							PRIVATE nStockLst_QTY
							nStockLst_QTY = PrepareSQLnum(tmpRMA_D.Removed_QTY,'StockLst_QTY',-5)
							*IF nStockLst_QTY > 0
								ThisFormset.Receive_Edit.txtActualW.Value = nStockLst_QTY
								ThisFormset.Receive_Edit.txtBillW.Value = nStockLst_QTY
							*ENDIF
							
							*tmpRMA_D.SO_item 
							PRIVATE nAcct_PU, nAcct_QTY, nAcct_P
							nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "Form", ThisFormSet.nConnhandle ), ThisFormSet.nConnhandle ),'PU',-1 )
							nAcct_QTY = PrepareSQLnum(Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "S_QTY", ThisFormSet.nConnhandle ),'S_QTY',-5)
							nAcct_P = 0
							ThisFormset.Receive_Edit.txtAcct_Qty.Value		= nAcct_QTY
							ThisFormset.Receive_Edit.txtAcct_P.Value		= nAcct_P
							
							ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
							ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
							ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
		
							ThisFormset.Receive_Edit.txtPO_QTY.Value 	= nAcct_QTY  &&PrepareSQLnum(Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "Q_QTY", ThisFormSet.nConnhandle ),'Q_QTY',-5)
							ThisFormset.Receive_Edit.txtPO_P.Value		= PrepareSQLnum(Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "Q_P", ThisFormSet.nConnhandle ),'Q_P',-5)
		
							ThisFormset.Receive_Edit.lblPO_PU.Caption 		= PrepareSQLtxt(nAcct_PU, 'PO_PU',2)
							ThisFormset.Receive_Edit.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
							ThisFormset.Receive_Edit.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle )
		
							
							PRIVATE cTBL
							cTBL = PrepareSQLtxt(tmpRMA_D.TBL,'TBL',1)
							IF cTBL = 'S'
								*Use the MasterID of Stock
								ThisFormset.Receive_Edit.txtID_Master.Value = PrepareSQLnum(tmpRMA_D.StockLst_ID,'Master_ID',-3)
								ThisFormset.Receive_Edit.txtID_Detail.Value = 0 &&PrepareSQLnum(tmpRMA_D.StockLst_ID_Detail,'ID_Detail',-3)
								ThisFormset.Receive_Edit.txtTBL.Value	= cTBL
								ThisFormSet.cTBL = cTBL
							ELSE
								ThisFormset.Receive_Edit.txtID_Master.Value = 0
								ThisFormset.Receive_Edit.txtID_Detail.Value = 0
								ThisFormset.Receive_Edit.txtTBL.Value	= 'S'					
								ThisFormSet.cTBL = 'S'
							ENDIF
											
							PRIVATE nAcct_PU 
							nAcct_PU = PrepareSQLtxt(tmpRMA_D.StockLst_PU,'PU',-1)
							ThisFormset.Receive_Edit.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
							ThisFormset.Receive_Edit.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
							ThisFormset.Receive_Edit.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
							
							ThisFormset.Receive_Edit.txtForm.Value = PrepareSQLtxt(tmpRMA_D.Form,'Form',2)
							
							ThisFormset.Receive_Edit.txtRMA_No.Value	= PrepareSQLnum(tmpRMA_D.RMA_No,'RMA_No',-3)
							ThisFormset.Receive_Edit.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA_D.RMA_Detail_ID,'RMA_Detail_ID',-3)
							
							ThisFormset.Receive_Edit.chkServicesPO.Value= PrepareSQLchk(0,'Services')
							ThisFormset.Receive_Edit.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
							ThisFormset.Receive_Edit.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
							
							*This Reject area is NOT for an RMA
							*ThisFormset.Receive_Edit.shpRMA.Visible = .T.
							*ThisFormset.Receive_Edit.lblReject.Visible = .T.
							*ThisFormset.Receive_Edit.lblRejectPC.Visible = .T.
							*ThisFormset.Receive_Edit.txtRejectPC.Visible = .T.
							*ThisFormset.Receive_Edit.txtRejectReason.Visible = .T.
							*
							*ThisFormset.Receive_Edit.txtRejectPC.Value		= PrepareSQLnum(tmpRMA_D.PS_PC,'Pieces',-3)
							*ThisFormset.Receive_Edit.txtRejectReason.Value	= PrepareSQLtxt(tmpRMA_D.Reason,'Reason',-3)
							
						ENDIF
						
					ENDSCAN			
				ENDIF
				USE IN tmpRMA_D
				
			ENDIF
		ENDIF
	ENDPROC

