	PROCEDURE showpoitem
		PARAMETERS pcPOitem
		*ThisForm.ShowPOitem(cPOitem)
		
		*!*	PRIVATE cPOitem, cSOitem
		*!*	cPOitem = ''
		
		*!*	IF VARTYPE(pcPOitem) = "C"
		*!*		cPOitem = Proper_PO_Item( pcPOitem )
		*!*	ENDIF
		
		*!*	IF EMPTY(cPOitem )
		*!*		MESSAGEBOX("Cannot get PO.",0+32,"No PO-item")
		*!*		RETURN .F.
		*!*	ENDIF
		
		*!*	PRIVATE lnText2Find  
		*!*	lnText2Find  = VAL(LEFT(cPOitem,AT("-",cPOitem)-1))
		
		*!*	ThisForm.txtFindText.Value = STR(lnText2Find)
		
		*!*	SELECT Receiving
		*!*	*POitem
		*!*	SET ORDER TO TAG HPAPO
		*!*	SEEK lnText2Find  IN 'Receiving' ORDER HPAPO
		
		*!*	IF NOT FOUND('Receiving')
		*!*		IF Count_HPAPOinPurchaseOrder( lnText2Find, ThisFormSet.nConnhandle ) = 0
		*!*			MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" has not been entered!"+CHR(13)+"Have this PO added in PurchaseOrder screen",0+16,"PO Not Found, Stop receiving and enter PO first!")
		*!*		ELSE
		*!*			IF Count_HPAPOinStockLst( lnText2Find, ThisFormSet.nConnhandle ) = 0
		*!*				MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" was not found in StockLst\BrokerLst list."+CHR(13)+"Have this PO edited in PurchaseOrder screen"+CHR(13)+"so ALL PO related tables are updated!",0+16,"PO Not Found, Stop receiving and enter PO first!")
		*!*			ELSE
		*!*				MESSAGEBOX(	"Po ="+ALLTRIM(STR(lnText2Find))+" was not found."+CHR(13)+CHR(13)+"But was found in PurchaseOrder and StockLst/BrokerLst!.",0+64,"Not found in Receiving.")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE stripdescription
		PARAMETERS pDescription
		*ThisFormSet.StripDescription(pDescription) 
		
		pDescription = PrepareSQLtxt(pDescription,'pDescription',-1)
		
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(ThisFormSet.Receive_Edit.txtAlloy.Value,'Alloy',12)
		
		PRIVATE cDescAlloy
		cDescAlloy = LEFT(pDescription,12)
		
		IF ALLTRIM(cDescAlloy) = ALLTRIM(cAlloy)
			*Strip Alloy
			pDescription = SUBSTR(pDescription,LEN(ALLTRIM(cAlloy))+2 )
			*pDescription = SUBSTR(pDescription,LEN(ALLTRIM(cAlloy))
		
		ENDIF
		
		IF AT( ")", pDescription ) > 0
			pDescription = SUBSTR(pDescription,AT( ")", pDescription )+2 )
		ENDIF
		
		RETURN pDescription 
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpReceive')	
			USE IN tmpReceive
		ENDIF
		
		IF USED('Receiving')	
			USE IN Receiving 
		ENDIF
		
		IF USED('poStatusDef')
			USE IN poStatusDef
		ENDIF
		
		IF USED("tmpStockLst_Master")
			USE IN tmpStockLst_Master
		ENDIF
		*Private Data
		
		= SQLDISCONNECT( ThisFormSet.nConnhandle )
		
		
		*RETURN ThisFormSet.nReturn
	ENDPROC

	PROCEDURE updatepoitemrecdt
		PARAMETERS dReceived, cPOitem, nPOcomplete 
		*ThisFormSet.UpdatePOitemRecDt(dReceived,cPOitem,nPOcomplete )
		
		IF ( VARTYPE(dReceived) = "D" OR VARTYPE(dReceived) = "T" )
			*good
		ELSE
			RETURN .F.
		ENDIF
		
		IF VARTYPE(cPOitem) != "C"
			RETURN .F.
		ENDIF
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item("0-00")
			RETURN .F.
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC, lSaved 
		lSaved = .T.
		
		cSQLu = "IF EXISTS (SELECT * FROM dbo.PurchaseOrder "
		cSQLu = cSQLu +" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"	
		cSQLu = cSQLu +" AND Received IS NULL) "
		
		cSQLu = cSQLu +" UPDATE dbo.PurchaseOrder SET"
		cSQLu = cSQLu +" Received = '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"	
		cSQLu = cSQLu +" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"') ;"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
			lSaved = .F.
			*RETURN
			RecordError(0,"Could not update dbo.PurchaseOrder " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
		ELSE 
			lSaved = .T.
		ENDIF
		
		
		
		*************************
		IF lSaved 
			PRIVATE cNotes, nReceivingID 
			cNotes = "POitem '"+cPOitem+"' was Received on '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
			nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
			IF nReceivingID > 0
				cNotes = cNotes + " with ReceivingID = "+ALLTRIM(STR(nReceivingID))
			ENDIF
			IF nPOcomplete = 2
				cNotes = cNotes + " and Delivered in Complete"
			ENDIF
			cSQL = "INSERT INTO dbo.PO_Item_Notes "
			cSQL = cSQL +" ([POitem],[Notes]) VALUES ("
			cSQL = cSQL +"'"+cPOitem+"','"+PrepareSQLtxt(cNotes,'Notes',-1)+"') ;"
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not Insert into dbo.PO_ProcessNotes " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQL )
			ELSE 
				lSaved = .T.
			ENDIF
		ENDIF
		
		**************************************
		
		RETURN lSaved 
	ENDPROC

	PROCEDURE updateprocess
		PARAMETERS nID_Detail_Process, nReceivingID 
		*ThisFormSet.UpdateProcess(nID_Detail_Process, ThisFormSet.cTBL, ThisFormSet.nReceivingID )
		cSQL = " UPDATE "
		DO CASE
		CASE ThisFormSet.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisFormSet.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisFormSet.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE updatepurchaseorder
	ENDPROC

	PROCEDURE updatewo_detailrecdt
		PARAMETERS dReceived, nWO_Detail, nPOcomplete 
		*ThisFormSet.UpdateWO_DetailRecDt(dReceived, nWO_Detail, nPOcomplete)
		
		IF ( VARTYPE(dReceived) = "D" OR VARTYPE(dReceived) = "T" )
			*good
		ELSE
			RETURN .F.
		ENDIF
		
		nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC, lSaved 
		lSaved = .T.
		
		cSQLu = "IF EXISTS (SELECT * FROM dbo.WorkOrder_Detail  "
		cSQLu = cSQLu +" WHERE WO_Detail = "+STR(nWO_Detail)
		cSQLu = cSQLu +" AND ISNULL(fReconciled ,0) = 0 ) "
		
		cSQLu = cSQLu +" UPDATE dbo.WorkOrder_Detail SET"
		cSQLu = cSQLu +" [fFinishDate] = '"+IIF(EMPTY(dReceived),DTOC(DATE()),DTOC(dReceived))+"'"	
		IF PrepareSQLnum(nPOcomplete,'complete',-1) = 2 
			cSQLu = cSQLu +" ,fCmplt = 1 "
		ENDIF
		cSQLu = cSQLu +" WHERE WO_Detail = "+STR(nWO_Detail)
		cSQLu = cSQLu +" ;"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQLu,ThisFormSet.nConnhandle, nSQLEXEC, '')
			lSaved = .F.
			*RETURN
			RecordError(0,"Could not update dbo.PurchaseOrder " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
		ELSE 
			lSaved = .T.
		ENDIF
		
		
		*************************
		IF lSaved 
			PRIVATE cNotes, nReceivingID 
			cNotes = "WO_Detail "+STR(nWO_Detail)+" was Received on '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
			nReceivingID = PrepareSQLnum(ThisFormSet.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
			ThisFormSet.nReceivingID  = nReceivingID
			
			IF nReceivingID > 0
				cNotes = cNotes + " with ReceivingID = "+ALLTRIM(STR(nReceivingID))
			ENDIF
			IF nPOcomplete = 1
				cNotes = cNotes + " and WO_Detail NOT Complete"
			ENDIF
			IF nPOcomplete = 2
				cNotes = cNotes + " and WO_Detail is Complete"
			ENDIF
			cSQL = "INSERT INTO dbo.WorkOrder_Notes "
			cSQL = cSQL +" ([WO_Detail],[Notes]) VALUES ("
			cSQL = cSQL +""+STR(nWO_Detail)+",'"+PrepareSQLtxt(cNotes,'Notes',-1)+"') ;"
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisFormSet.nConnhandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not Insert into dbo.PO_ProcessNotes " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQL )
			ELSE 
				lSaved = .T.
			ENDIF
		ENDIF
		
		**************************************
		
		RETURN lSaved 
	ENDPROC

	PROCEDURE update_incoming_process
		PARAMETERS nNewTBL, nNewID, nNewID_Detail, nOld_ID, nOld_ID_Detail
		*ThisFormSet.Update_Incoming_Process()
		*Updates the Incomming process with the new Edit data
		*Show_Recv_Order
		
		IF VARTYPE(nNewTBL)!="C"
			nNewTBL = ThisFormSet.cTBL
		ENDIF
		IF VARTYPE(nNewTBL)!="C"
			TrackError("Receiving:Receiving_Create_Incoming_Process(cTBL:NO TABLE ,nID_Detail:"+STR(nID_Detail)+",nPounds"+")" ,"bad variable",PROGRAM(),LINENO(1))
			ThisFormSet.cTBL = ""
			RETURN .F.
		ENDIF
		
		PRIVATE cSOitem,cPOitem
		cSOitem = Proper_SO_item(ThisFormSet.cSOitem)
		cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisFormSet.nReceivingID ,'ReceivingID',-3)
		
		IF nNewTBL = "N"
			TrackMess("Receiving:Receiving_Create_Incoming_Process(cTBL :"+nNewTBL +",nID_Detail:"+STR(nID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")" )
			RETURN .F.
		ENDIF
		
		IF nID_Detail = 0
			*nID_Detail = get_ID_Detail_with_SOitem(cSOitem, nNewTBL, "", ThisFormSet.nConnhandle)
			TrackMess("Show Received VS Ordered:Create_Incoming_Process(cTBL:"+nNewTBL+",nID_Detail:"+STR(nID_Detail)+",cSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
			RETURN .F.
		ENDIF
		
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE cPrc_Form, nPU, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= PrepareSQLtxt(ThisFormSet.Show_Recv_Order.txtForm.Value,'Form',2)
		nPU 		= nPU_Acct_Form(cPrc_Form ,ThisFormSet.nConnhandle)
		nPrc_PCs	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Need.Value,'PC',-3)
		nPrc_Dim1	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtThck.Value,'DIM1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtSz2.Value,'DIM2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtSz3.Value,'DIM3',9,3)
		
		PRIVATE nPrc_Q_QTY, nPrc_Q_PU, nOrdered_QTY, nOrdered_P
		nPrc_Q_QTY = 0
		nPrc_Q_PU = nPU_Acct_Form(cPrc_Form ,ThisFormSet.nConnhandle)
		IF ThisFormSet.nWO_Detail > 0
			nOrdered_QTY = Get_From_WO_Detail(ThisFormSet.nWO_Detail,'fWeight',ThisFormSet.nConnhandle)
			nOrdered_P = 0
		ENDIF
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			nOrdered_QTY = Get_From_POitem(cPOitem, "StockLst_QTY", ThisFormSet.nConnhandle )
			nOrdered_P = Get_From_POitem(cPOitem, "StockLst_P", ThisFormSet.nConnhandle )
		ENDIF
		
		PRIVATE nQTY_Need, nLBS_Need, nPC_Need
		nQTY_Need	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtQTY_Need.Value,'QTY',-5)
		nLBS_Need	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtLBS_Need.Value,'Pounds',8,1)
		nPC_Need	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Need.Value,'PC',-3)
		
		PRIVATE nPast_QTY, nPast_LBS, nPast_PCs
		nPast_QTY	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPast_QTY.Value,'QTY',-5)
		nPast_LBS	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPast_LBS.Value,'Pounds',8,1)
		nPast_PCs	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPast_PC.Value,'PC',-3)
		
		PRIVATE nQTY_Recv, nLBS_Recv, nPC_Recv
		nQTY_Recv	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtRcv_QTY.Value,'QTY',-5)
		nLBS_Recv	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtActualW.Value,'Pounds',8,1)
		nPC_Recv	= PrepareSQLnum(ThisFormSet.Show_Recv_Order.txtPC_Recv.Value,'PC',-3)
		
		PRIVATE cSalesPerson, dtStartDate, dDueDate
		cSalesPerson = PrepareSQLtxt( AppSetup_Get_UserName( getSalesP_POitem( cPOitem, ThisFormSet.nConnhandle )),'SalesPerson', 20)
		dtStartDate = DATE()
		dDueDate = GetNewDueDate( cPOItem, ThisFormSet.nConnhandle )
		*dDueDate = Get_From_Purchase_POitem (cPOitem, "Field", ThisFormSet.nConnhandle )
		
		PRIVATE cProcessor, cComment
		cProcessor = RIGHT( SYS(0) ,LEN(SYS(0))-AT("#",SYS(0))-1 )	&&cUserName 
		cComment = "ReceivingID = "+ALLTRIM(STR(nReceivingID))+" ran on "+DTOC(DATE())
		
		**********************
		*INSERT an 'RECEIVED' Process first with the NEW data for New ID_Detail\Receive
		*-- call it Received so it will be automatically deleted.
		**
		PRIVATE cSQLi
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		cSQLi = "EXEC dbo.p_Lst_Process_ins "
		cSQLi = cSQLi + " @TBL = '"+nNewTBL+"'"
		cSQLi = cSQLi + ",@ID_Detail ="+STR(nNewID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = 'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB
		
		cSQLi = cSQLi + ",@PU	= "+STR(nPU)
		cSQLi = cSQLi + ",@QTY	= "+STR(nQTY_Recv,18,4)
		cSQLi = cSQLi + ",@Pounds ="+STR(nLBS_Recv,9,1)
		
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		cSQLi = cSQLi + ",@WO 	= "+STR(0)
		cSQLi = cSQLi + ",@WO_Detail= "+STR(ThisFormSet.nWO_Detail)
		
		cSQLi = cSQLi + ",@Process_ID = 'RECEIVED'"	&&+cProcess_ID+"'"  
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID) 
		
		cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPC_Recv)
		cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
		cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
		cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
		cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nOrdered_QTY,18,4)
		cSQLi = cSQLi + ",@Ordered_P = "+STR(nOrdered_P,18,4)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpID_Detail_Process')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
			lOK=.F.
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
				IF nID_Detail_Process > 0
		
					PRIVATE cText
					cText = "INFO: Created RECEIVED Process "+STR(nID_Detail_Process)+" Show_Recv_Order.Create_Incoming_Process "+" StockTable="+ThisFormSet.cTBL+CHR(13)
					IF Proper_PO_item(cPOitem)<>Proper_PO_item("")
						cText = cText +" PO item="+cPOitem
					ENDIF
					IF ThisFormSet.nWO_Detail > 0
						cText = cText +" WO Detail="+ALLTRIM(STR(ThisFormSet.nWO_Detail))
					ENDIF
					*cText = cText +" Process_ID = '"+cProcess_ID+"'"  
					*MESSAGEBOX( cText,0+48,"INFO: Updated Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
					TrackMess(cText)
				ENDIF
		
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		
		****************************************************************
		*Edit The old Incoming a Received!
		*"Updated Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		
		PRIVATE nID_Detail_Prc
		**Check for ID of INCOMING Process 
		nID_Detail_Prc = Get_ID_Detail_Prc_by_ID_Detail(nOld_ID_Detail,ThisFormSet.cTBL,'INCOMING',ThisFormSet.nConnhandle)
		
		IF nID_Detail_Prc > 0
			cSQL = " UPDATE "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL = cSQL + " SET QTY = "+STR(nQTY_Need,18,4)
			cSQL = cSQL + ",Pounds = "+STR(nLBS_Need,9,1)
			cSQL = cSQL + ",Prc_PCs ="+STR(nPC_Need)	&&nPrc_PCs
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)
			cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
			cSQL = cSQL + " AND ReceivingID = 0"
		ELSE
			cSQL = " INSERT INTO "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL= cSQL + " (SOitem,PO_item,SalesPerson,Startdate,DueDate,Comment     "
			cSQL= cSQL + ",[Process_ID],Processor,AllowSub,PU,QTY,Ordered_QTY,Ordered_P,Pounds "
			cSQL= cSQL + ",ID_Detail ,WO,WO_Detail"
			cSQL= cSQL + ",Prc_Form ,Prc_PCs,Prc_Dim1 ,Prc_Dim2,Prc_Dim3 ,Prc_Q_QTY ,Prc_Q_PU "
			
			cSQL= cSQL + " ) VALUES ("
			cSQL= cSQL + "'"+cSOitem+"'"
			cSQL= cSQL + ",'"+cPoItem+"'"
			cSQL= cSQL + ",'"+cSalesPerson+"'"
			cSQL= cSQL + ",'"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"	
			cSQL= cSQL + ",'"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQL= cSQL + ",'Revised INCOMING'"	
			
			cSQL= cSQL + ",'INCOMING'" 
			cSQL= cSQL + ",'Partial receive by "+RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )	
			cSQL= cSQL + ",'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB	
			cSQL= cSQL + ","+STR(nPU)
		
			cSQL= cSQL + ","+STR(nQTY_Need,18,4)
			cSQL= cSQL + ","+STR(nOrdered_QTY,18,4)
			cSQL= cSQL + ","+STR(nOrdered_P,18,4)
			cSQL= cSQL + ","+STR(nLBS_Need,9,1)
			cSQL= cSQL + ","+STR(nNewID_Detail)+""
			cSQL= cSQL + ",0"
			cSQL= cSQL + ","+STR(ThisFormSet.nWO_Detail)
		
			cSQL = cSQL + ",'"+cPrc_Form+"'"
			cSQL = cSQL + ","+STR(nPC_Need)	&&nPrc_PCs
		
			cSQL = cSQL + ", "+STR(nPrc_Dim1,10,4)
			cSQL = cSQL + ", "+STR(nPrc_Dim2,9,3)
			cSQL = cSQL + ", "+STR(nPrc_Dim3,9,3)
			cSQL = cSQL + ", "+STR(nQTY_Need,18,4)
			cSQL = cSQL + ", "+STR(nPrc_Q_PU)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
						lOK = .F.
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			lOK = .F.
		ENDIF
		
		IF lOK 
			*UPDATE old_ID_Detail set Receiving = 0
			*Clean old style if found
			cSQL = " UPDATE "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID=0"
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)
			cSQL = cSQL + " AND ISNULL(ReceivingID,0)>0 "
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
							lOK = .F.
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				*lOK = .F.
			ENDIF
		ENDIF
		
		RETURN lOK
		
		
	ENDPROC

	PROCEDURE update_postatus
		PARAMETERS lCmplt_the_Prc
		*ThisFormSet.Update_POStatus()
		
		IF VARTYPE(lCmplt_the_Prc) <> "L"
			lCmplt_the_Prc = .T.
		ENDIF
		PRIVATE nReceivingID, nWO_Detail
		nReceivingID = PrepareSQLnum(ThisFormset.Receive_Edit.txtReceivingID.Value,'ReceivingID',-3)
		nWO_Detail = PrepareSQLnum(ThisFormset.Receive_Edit.txtWO_Detail.Value,'WO_Detail',-3)
		
		*Check POStatus
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOStat')	
			USE IN tmpPOStat
		ENDIF
		
		cSQL = 		  " SELECT M.POStatus, 'S' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ENDIF
		IF nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'B' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ENDIF
		IF nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'W' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ENDIF
		IF nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID)
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOStat')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOStat")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOStat")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		
		PRIVATE nMess,  nReceivingID2, cPOStatusText
		nMess = 0
		
		nReceivingID2 = 0
		cPOStatusText = ''
		
		***************************************
		
		IF USED('tmpPOStat')	
			IF RECCOUNT('tmpPOStat') > 0
			
				DO CASE
				CASE tmpPOStat.TBL = 'S'
					ThisFormSet.cTBL = "S"
				CASE tmpPOStat.TBL = 'B'
					ThisFormSet.cTBL = "B"
				CASE tmpPOStat.TBL = 'W'
					ThisFormSet.cTBL = "W"
				OTHERWISE
					TrackError(cSQL,"Could not find TBL.",PROGRAM(),LINENO(1) )
					ThisFormSet.cTBL = "N"
				ENDCASE
				
				SCAN
					
					cPOStatus	= PrepareSQLtxt(tmpPOstat.POStatus,'POStatus',1)
					
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatusText = "DUE IN" && INCOMING
						lDueIn = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "P"	
						cPOStatusText = "Partial Receive" && "PARTRECV"
						lPartialReceive = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "W"	
						cPOStatusText = "Waiting for Bill"
						lWaitingforBill = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "A"	
						cPOStatusText = "Accounted for"
						lAccountedfor = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					ENDCASE
				ENDSCAN
			ENDIF
		ENDIF
				
		IF nReceivingID2 > 0
			IF nReceivingID <> nReceivingID2
				nReceivingID2 = nReceivingID2 
				*TrackMess("The POitem: '"+ThisFormSet.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+cSQL)
				IF nWO_Detail > 0
					TrackError("The WO Detail: '"+STR(nWO_Detail)+"' has a ReceivingID of "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL ,"Found nReceivingID2",PROGRAM(),LINENO(1))
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem: '"+ThisFormSet.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		PRIVATE cSOitem
		cSOitem 	= Proper_SO_Item( ThisFormSet.cSOitem )
		
		**********************
		*Mark Master as POStatus='P'	&&Partial
		*
		**********************
		*Never Mark as Partial again!!! 3/11/2019
		*Complete the Receive ' lClearIncomingProcess '
		* and Create a new INCOMING Master, Detail, Process! ???
		*
		
		PRIVATE nMess
		nMess = 0
		PRIVATE lClearIncomingProcess
		lClearIncomingProcess = .F.
		
		IF lAccountedfor 
			*Do Nothing
			*cPOStatusText = "Accounted for"
			IF NOT lCmplt_the_Prc
				TrackMess("Did NOT Updated Stock:"+ThisFormSet.cTBL+" POStatusText = 'Accounted for' Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
			ENDIF
			lClearIncomingProcess = .F.
		ELSE
			IF lWaitingforBill 
				*Do Nothing
				*cPOStatusText = "Waiting for Bill"
				IF NOT lCmplt_the_Prc
					TrackMess("Did NOT Updated Stock:"+ThisFormSet.cTBL+" POStatusText = 'Waiting for Bill' Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
				ENDIF
		
				lClearIncomingProcess = .F.
			ELSE
				IF NOT lCmplt_the_Prc
					*User selected Good recieve, Not Complete
					nMess = 6
				ELSE
					*User Selected 'Just Editing' or Completes POitem
					IF lDueIn 
						IF nWO_Detail > 0
							nMess = MESSAGEBOX("This WO Detail:"+STR(nWO_Detail)+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"WO Detail status will be listed as Complete.")
						ELSE
							nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"PO status will be listed as Complete.")
						ENDIF
					ELSE
						IF lPartialReceive 
							IF nWO_Detail > 0
								nMess = MESSAGEBOX("This WO Detail:"+STR(nWO_Detail)+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"WO Detail status will be listed as Complete.")
							ELSE
								nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"PO status will be listed as Complete.")
							ENDIF			
						ENDIF
					ENDIF
				ENDIF
						
				IF nMess = 6
					lClearIncomingProcess = .T.
					cSQL = ""
					DO CASE
					CASE ThisFormSet.cTBL = "S"
						cSQL = " UPDATE dbo.StockLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisFormSet.cTBL = "B"
						cSQL = " UPDATE dbo.BrokerLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisFormSet.cTBL = "W"
						cSQL = " UPDATE dbo.WIPLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisFormSet.cTBL = "N"
						*
					OTHERWISE 
						ThisFormSet.cTBL = "N"
					ENDCASE
					
					IF ThisFormSet.cTBL = "N"
						*No TBL
					ELSE
						IF nWO_Detail > 0
							cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
						ELSE
							cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
						ENDIF
						IF nReceivingID2 > 0
							cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID2)
						ENDIF
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 				
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
						ELSE 
							TrackMess("Updated Stock:"+ThisFormSet.cTBL+" POStatusText set to W 'Waiting for Bill', Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
							*MESSAGEBOX(cSQL,0,"Success")
						ENDIF
					ENDIF		
		
				ELSE
					IF NOT lCmplt_the_Prc
						TrackMess("Did NOT Updated Stock:"+ThisFormSet.cTBL+" User choose to not Complete. Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		RETURN lClearIncomingProcess
	ENDPROC

	PROCEDURE update_postatus2
		PARAMETERS lCmplt_the_Prc
		*ThisFormSet.Update_POStatus()
		
		IF VARTYPE(lCmplt_the_Prc) <> "L"
			lCmplt_the_Prc = .T.
		ENDIF
		*Check POStatus
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOStat')	
			USE IN tmpPOStat
		ENDIF
		
		cSQL = 		  " SELECT M.POStatus, 'S' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisFormSet.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisFormSet.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ENDIF
		IF ThisFormSet.nReceivingID  > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisFormSet.nReceivingID )
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'B' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisFormSet.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisFormSet.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ENDIF
		IF ThisFormSet.nReceivingID  > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisFormSet.nReceivingID )
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'W' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisFormSet.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisFormSet.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ENDIF
		IF ThisFormSet.nReceivingID  > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisFormSet.nReceivingID )
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOStat')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOStat")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOStat")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		
		PRIVATE nMess,  nReceivingID2, cPOStatusText
		nMess = 0
		
		nReceivingID2 = 0
		cPOStatusText = ''
		
		***************************************
		
		IF USED('tmpPOStat')	
			IF RECCOUNT('tmpPOStat') > 0
			
				DO CASE
				CASE tmpPOStat.TBL = 'S'
					ThisFormSet.cTBL = "S"
				CASE tmpPOStat.TBL = 'B'
					ThisFormSet.cTBL = "B"
				CASE tmpPOStat.TBL = 'W'
					ThisFormSet.cTBL = "W"
				OTHERWISE
					TrackError(cSQL,"Could not find TBL.",PROGRAM(),LINENO(1) )
					ThisFormSet.cTBL = "N"
				ENDCASE
				
				SCAN
					
					cPOStatus	= PrepareSQLtxt(tmpPOstat.POStatus,'POStatus',1)
					
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatusText = "DUE IN" && INCOMING
						lDueIn = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "P"	
						cPOStatusText = "Partial Receive" && "PARTRECV"
						lPartialReceive = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "W"	
						cPOStatusText = "Waiting for Bill"
						lWaitingforBill = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "A"	
						cPOStatusText = "Accounted for"
						lAccountedfor = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					ENDCASE
				ENDSCAN
			ENDIF
		ENDIF
				
		IF nReceivingID2 > 0
			IF ThisFormSet.nReceivingID  <> nReceivingID2
				ThisFormSet.nReceivingID = nReceivingID2 
				*TrackMess("The POitem: '"+ThisFormSet.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+"."+CHR(13)+cSQL)
				IF ThisFormSet.nWO_Detail > 0
					TrackError("The WO Detail: '"+STR(ThisFormSet.nWO_Detail)+"' has a ReceivingID of "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL ,"Found nReceivingID2",PROGRAM(),LINENO(1))
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem: '"+ThisFormSet.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		PRIVATE cSOitem
		cSOitem 	= Proper_SO_Item( ThisFormSet.cSOitem )
		
		**********************
		*Mark Master as POStatus='P'	&&Partial
		*
		**********************
		*Never Mark as Partial again!!! 3/11/2019
		*Complete the Receive ' lClearIncomingProcess '
		* and Create a new INCOMING Master, Detail, Process! ???
		*
		
		PRIVATE nMess
		nMess = 0
		PRIVATE lClearIncomingProcess
		lClearIncomingProcess = .F.
		
		IF lAccountedfor 
			*Do Nothing
			*cPOStatusText = "Accounted for"
			IF NOT lCmplt_the_Prc
				TrackMess("Did NOT Updated Stock:"+ThisFormSet.cTBL+" POStatusText = 'Accounted for' Receiving ID "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
			ENDIF
			lClearIncomingProcess = .F.
		ELSE
			IF lWaitingforBill 
				*Do Nothing
				*cPOStatusText = "Waiting for Bill"
				IF NOT lCmplt_the_Prc
					TrackMess("Did NOT Updated Stock:"+ThisFormSet.cTBL+" POStatusText = 'Waiting for Bill' Receiving ID "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
				ENDIF
		
				lClearIncomingProcess = .F.
			ELSE
				IF NOT lCmplt_the_Prc
					*User selected Good recieve, Not Complete
					nMess = 6
				ELSE
					*User Selected 'Just Editing' or Completes POitem
					IF lDueIn 
						IF ThisFormSet.nWO_Detail > 0
							nMess = MESSAGEBOX("This WO Detail:"+STR(ThisFormSet.nWO_Detail)+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"WO Detail status will be listed as Complete.")
						ELSE
							nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"PO status will be listed as Complete.")
						ENDIF
					ELSE
						IF lPartialReceive 
							IF ThisFormSet.nWO_Detail > 0
								nMess = MESSAGEBOX("This WO Detail:"+STR(ThisFormSet.nWO_Detail)+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"WO Detail status will be listed as Complete.")
							ELSE
								nMess = MESSAGEBOX("This PO_Item:"+ThisFormSet.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"PO status will be listed as Complete.")
							ENDIF			
						ENDIF
					ENDIF
				ENDIF
						
				IF nMess = 6
					lClearIncomingProcess = .T.
					cSQL = ""
					DO CASE
					CASE ThisFormSet.cTBL = "S"
						cSQL = " UPDATE dbo.StockLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisFormSet.cTBL = "B"
						cSQL = " UPDATE dbo.BrokerLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisFormSet.cTBL = "W"
						cSQL = " UPDATE dbo.WIPLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisFormSet.cTBL = "N"
						*
					OTHERWISE 
						ThisFormSet.cTBL = "N"
					ENDCASE
					
					IF ThisFormSet.cTBL = "N"
						*No TBL
					ELSE
						IF ThisFormSet.nWO_Detail > 0
							cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisFormSet.nWO_Detail)
						ELSE
							cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
						ENDIF
						IF nReceivingID2 > 0
							cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID2)
						ENDIF
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF		
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
						ELSE 
							TrackMess("Updated Stock:"+ThisFormSet.cTBL+" POStatusText set to W 'Waiting for Bill', Receiving ID "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
							*MESSAGEBOX(cSQL,0,"Success")
						ENDIF
					ENDIF		
		
				ELSE
					IF NOT lCmplt_the_Prc
						TrackMess("Did NOT Updated Stock:"+ThisFormSet.cTBL+" User choose to not Complete. Receiving ID "+ALLTRIM(STR(ThisFormSet.nReceivingID ))+", PO:"+ALLTRIM(ThisFormSet.cPOitem)+", SO:"+ALLTRIM(cSOitem))
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		RETURN lClearIncomingProcess
	ENDPROC

	PROCEDURE update_rma
	ENDPROC

	PROCEDURE validate_rma
		*ThisFormSet.Validate_RMA
		*Called from: txtRMA_No.Valid
		PRIVATE nRMA_Detail, nRMA, cHeat, cLot
		nRMA_Detail= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtHeat.Value,'Heat',50)
		cLot	= PrepareSQLtxt(ThisFormSet.Receive_Edit.txtLot.Value,'Lot',10)
		
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisFormSet.Receive_Edit.txtSOitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		IF nRMA = 0
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				*No SOitem to compare with
				RETURN .T.
			ELSE
				
			ENDIF
		ENDIF
				
		PRIVATE cSQL, nSQLExec
		IF USED("tmpRMA_V")
			USE IN tmpRMA_V
		ENDIF
		
		PRIVATE cMess
		
		cSQL = "SELECT RD.SO_item "
		cSQL = cSQL + ",RMA.RMA_No, RD.RMA_Detail_ID"
		cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_NO "
		
		cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRMA_V')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRMA_V' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_V")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_V")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRMA_V' )
		ENDIF
		
		IF NOT USED('tmpRMA_V') OR RECCOUNT('tmpRMA_V') = 0	
			*try without HEAT
			cSQL = "SELECT RD.SO_item "
			cSQL = cSQL + ",RMA.RMA_No, RD.RMA_Detail_ID"
			cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_NO "
		
			cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
					
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpRMA_V')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpRMA_V' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_V")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpRMA_V")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpRMA_V' )
			ENDIF
		
		ENDIF	
		
		PRIVATE lFound 
		lFound = .F.
		
		IF USED('tmpRMA_V')
			IF RECCOUNT('tmpRMA_V') > 0
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					SELECT tmpRMA_V
					LOCATE FOR SO_item = cSOitem
					IF FOUND('tmpRMA_V')
						lFound = .T.
					ELSE
						MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA_V.SO_item),16,"Does not Match")
						GO TOP			
					ENDIF
				ELSE
					*No SOitem to Compare
				ENDIF
			ENDIF
			
			USE IN tmpRMA_V		
		ENDIF
		
		IF nRMA_Detail = 0
			*TRY TO get Detail
			IF ThisFormSet.CheckRMA()
		*		ThisFormSet.Get_RMA_Detail()
		*		*CALLS:ThisFormSet.Refresh_RMA_Detail()
			ENDIF
		ENDIF
			
		RETURN .T.
		
	ENDPROC

