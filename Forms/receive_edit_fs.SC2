	PROCEDURE Receive_Edit.lblOrderdate.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = ThisForm.txtReceived.Value
		DO FORM "forms\olecalendar.scx" WITH m.dDate1, 'Dock Date', ThisForm.Top, ThisForm.Left TO m.dDate2
		
		ThisForm.txtReceived.Value = m.dDate2
		ThisForm.txtReceived.Refresh
		ThisForm.txtReceived.SetFocus
		
		
	ENDPROC

	PROCEDURE Receive_Edit.lblPO.Click
		IF Proper_PO_item(ThisFormSet.cPOitem) = Proper_PO_item('')
			MESSAGEBOX("Enter the Po item first.",16,"No PO item")
			RETURN .F.
		ENDIF
		IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle) = 0
			MESSAGEBOX("ERP POItem was not found."+CHR(13)+ThisFormSet.cPOitem,48,"Bad POItem Number")
			RETURN .F.
		ENDIF
		
		PRIVATE nOrder_QTY, nOrder_P, nOrder_PU, nStockLst_Total
		nOrder_QTY = 0
		nOrder_P = 0
		nOrder_PU = 0
		nStockLst_Total = 0
		
		*************************
		IF USED("tmpPOitemP")
			USE IN tmpPOitemP
		ENDIF
		
		
		cSQL = "SELECT Order_QTY, Order_P, Order_PU, StockLst_Total "
		cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"') "
		
		IF USED("tmpPOitemP")
			SELECT tmpPOitemP 
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOitemP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOitemP')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOitemP')
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOitemP")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOitemP")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF USED("tmpPOitemP")
			IF RECCOUNT("tmpPOitemP") > 0
				nOrder_QTY 	= PrepareSQLnum(tmpPOitemP.Order_QTY,'Order_QTY',-5)
				nOrder_P	= PrepareSQLnum(tmpPOitemP.Order_P,'Order_p',-5)
				nOrder_PU	= PrepareSQLnum(tmpPOitemP.Order_PU,'Order_PU',-1)
				nStockLst_Total	= PrepareSQLnum(tmpPOitemP.StockLst_Total,'StockLst_Total',-5)
						
			ENDIF
			USE IN tmpPOitemP
		ENDIF
		IF nOrder_QTY > 0
			ThisForm.txtPO_QTY.Value =  nOrder_QTY
		ENDIF
		IF nOrder_P > 0
			ThisForm.txtPO_P.Value = nOrder_P
		ENDIF
		IF nOrder_PU > 0
			ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
			ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
			ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisFormSet.nConnhandle)
		
		ENDIF
		
		IF nStockLst_Total > 0
			
		ENDIF
		
	ENDPROC

	PROCEDURE Receive_Edit.lblRMA_No.Click
		*RMA_No Receive
		PRIVATE nRMA_Detail, nRMA
		nRMA_Detail= PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		PRIVATE nNewRMA
		nNewRMA = 0
		
		IF nRMA = 0
			*Get RMA
			IF nSalesNum = 0
				DO FORM Forms\Choose_RMA WITH '' TO nNewRMA
				nNewRMA = PrepareSQLnum(nNewRMA,'NewRMA',-3)
			ELSE
				DO FORM Forms\Choose_RMA WITH cSOitem TO nNewRMA
				nNewRMA = PrepareSQLnum(nNewRMA,'NewRMA',-3)
			ENDIF
			
			***
			IF nNewRMA > 0
				ThisForm.txtRMA_No.Value = nNewRMA
				IF ThisFormSet.CheckRMA()
					ThisFormSet.Get_RMA_Detail()
					*CALLS:ThisFormSet.Refresh_RMA_Detail()
				ENDIF
			ENDIF
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE Receive_Edit.lblSOnum.Click
		PRIVATE nHpaPo, nItemPo, cPOitem 
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		PRIVATE cSOitem
		
		IF nHpaPo > 0 AND nItemPo > 0
			*Look for SO that belong to this POitem
			*ThisForm.ChooseSOitemLoad(cPOitem)
			cSOItem = get_SOitem_from_POitem(cPOItem, ThisFormSet.nConnhandle ) 
			
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				nSalesNum = Proper_SO_Item_SO(cSOitem)
				nSOitem_Item = Proper_SO_Item_Item(cSOitem)
				
				ThisForm.txtSOnum.Value = nSalesNum 
				ThisForm.txtSOItem.Value = nSOitem_Item 
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE Receive_Edit.lblSpecs.Click
		*Retrieve Spec from PO
		
		PRIVATE cPOitem, nHpaPo, nItemPo, nWO_Detail 
		nHpaPo		= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail 	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
		
			IF USED('tmpPOp')
				USE IN tmpPOp
			ENDIF
		
			cSQL = "SELECT Cond_Spec "
			cSQL = cSQl + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQl + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOp')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOp' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOp' )
			ENDIF
		
			IF USED('tmpPOp')
				IF RECCOUNT('tmpPOp') > 0
					*get PO Item data
					ThisForm.edtSpecs.Value = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-3)
				ENDIF
				USE IN tmpPOp
			ENDIF
		ELSE
			IF nWO_Detail > 0
				IF USED('tmpWODp')
					USE IN tmpWODp
				ENDIF
		
				cSQL = "SELECT fSpec "
				cSQL = cSQl + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
				cSQL = cSQl + " WHERE WO_Detail = "+STR(nWO_Detail)
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpWODp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpWODp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpWODp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpWODp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpWODp' )
				ENDIF
		
				IF USED('tmpWODp')
					IF RECCOUNT('tmpWODp') > 0
		
						ThisForm.edtSpecs.Value = PrepareSQLtxt(tmpWODp.fSpec,'Spec',50)
					ENDIF
					USE IN tmpWODp
				ENDIF		
			ELSE
				WAIT WINDOW 'Not Found' NOWAIT	
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.lblWO.Click
		PRIVATE nWO
		nWO = PrepareSQLnum(This.Parent.txtWO.Value,'WO',-3)
		
		IF nWO > 0
			MESSAGEBOX("Ther is already a WO "+ALLTRIM(STR(nWO))+CHR(13)+"Click the Blue WO number to see it in a web browser",64,"Cannot change")
		ELSE
			
			PRIVATE nNewWO, cSOitem, cPOitem
			nNewWO = 0
			cSOitem	= Proper_SO_item(ThisFormSet.cSOitem)
			cPOitem	= Proper_PO_Item(ThisFormSet.cPOitem)
			
			
			DO FORM Forms\Select_WorkOrder WITH cSOitem, cPOitem to nNewWO
			IF nNewWO > 0
				ThisForm.txtWO.Value = nNewWO
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.lblWO_Detail.Click
		PRIVATE nWO_Detail, nWO
		nWO_Detail = PrepareSQLnum(This.Parent.txtWO_Detail.Value,'WO_Detail',-3)
		nWO = 0
		
		IF nWO_Detail > 0
			MESSAGEBOX("There is already a WO_Detail "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"Click the Blue WO Detail number to see it in a web browser",64,"Cannot change")
		ELSE
			*DO FORM Forms\Select_WorkOrder_Detail WITH cSOitem, cPOitem, nWO to nWO_Detail
			PRIVATE nNewWO_Detail, cSOitem, cPOitem, nWO 
			nNewWO_Detail = 0 
			cSOitem	= Proper_SO_item(ThisFormSet.cSOitem)
			cPOitem	= Proper_PO_Item(ThisFormSet.cPOitem)
			
			nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
			
			DO FORM Forms\Select_WorkOrder_Detail WITH cSOitem, cPOitem, nWO to nNewWO_Detail
			
			IF nNewWO_Detail > 0
				ThisForm.txtWO_Detail.Value = PrepareSQLnum(nNewWO_Detail,'WO_Detail',-3)
				ThisForm.txtWO.Value =  GetWO_WO_Detail( nNewWO_Detail, ThisFormSet.nConnhandle)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.Resize
		*PRIVATE nHeight, nWidth
		*nHeight	= This.Height - 370
		*nWidth	= This.Width - 616
	ENDPROC

	PROCEDURE Receive_Edit.txtAcct_Qty.Valid
		PRIVATE nRecv_Qty
		nRecv_Qty		= PrepareSQLnum(This.VALUE,'Recv_Qty',11,3)
		
		PRIVATE lShowMess
		lShowMess = .F.
		IF nRecv_Qty < 1
			lShowMess = .T.
			*PRIVATE	lEquipment 
			*lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
			*IF lEquipment 
			IF ThisFormSet.cSOitem = 'Equipment' OR ThisFormSet.cSOitem = 'LabService'
				This.Value = 1
				lShowMess = .F.
				RETURN .T.
			ENDIF
		
			IF lShowMess
				MESSAGEBOX("Please enter the number of units to be priced.",48,"Units priced is empty!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtActualW.Valid
		PRIVATE nActualW, nAcct_PU, nPO_PU, nWO_Detail
		nActualW = PrepareSQLnum(This.Value,'Actual',9,1)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		
		IF nActualW > 0
			nAcct_PU = PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
			
			IF nAcct_PU = 0 AND nWO_Detail > 0
				nAcct_PU = 1
				ThisForm.lblAcct_PU.Caption = '1'
				ThisForm.lblAcct_PUstr.Caption	 = Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
				ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle )
		
		
				ThisForm.lblPO_PU.Caption = '1'
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisFormSet.nConnhandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nAcct_PU, ThisFormSet.nConnhandle )
		
			ENDIF
		
			IF nAcct_PU = 1
				ThisForm.txtAcct_Qty.Value = nActualW 
				IF nWO_Detail > 0
		
					ThisForm.txtPO_QTY.Value = nActualW 
				ENDIF
			ENDIF
			
			nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
			IF nPO_PU = 1
				ThisForm.txtPO_QTY.Value = nActualW 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnhandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE Receive_Edit.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisFormSet.nConnhandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE Receive_Edit.txtBillW.Valid
		PRIVATE nBillW, nAcct_PU, nPO_PU
		nBillW = PrepareSQLnum(This.Value,'BillW',9,1)
		
		IF nBillW > 0
			nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
			IF nPO_PU = 1
				ThisForm.txtPO_QTY.Value = nBillW 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtDate.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE("dDate") = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtHeat.Valid
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat, cLot, cAlloy
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cHeat = PrepareSQLtxt(This.Value,'Heat',50)
		cLot  = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		IF UPPER(cHeat)  = "DUE IN"
			MESSAGEBOX("This Receive will not save till a Heat is entered.",48,"No Heat")
			cHeat = ""	&&Do not check for Due In
		ENDIF
		
		PRIVATE nReceivingID, nEditReceivingID, nID_Detail_Prc
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		nEditReceivingID = 0
		nID_Detail_Prc	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		IF nReceivingID > 0 OR nID_Detail_Prc > 0
			*Skip Heat look up if already have ReceiveID or known nID_Detail_Prc
			RETURN .T.
		ENDIF
		
		IF NOT EMPTY(cHeat) 
		
			IF nHpaPo > 0 AND nItemPo = 0
				IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
					ThisForm.ChoosePOitemLoad(nHpaPo)
				ENDIF
			ELSE
				IF nHpaPo > 0 AND EMPTY(cHeat) 
					IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
						ThisFormSet.cPOitem = cPOitem
						ThisFormSet.GetPOitemDetail(cPOitem)
					ENDIF
				*ELSE
					*IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
					*	ThisFormSet.cPOitem = cPOitem
					*	ThisForm.GetFromReceiving(cPOitem,nWO_Detail,cHeat,cLot)
					*ENDIF
				ENDIF
			ENDIF
			
			IF USED('Receiving')
				SELECT Receiving
				LOCATE FOR ID = nReceivingID
			ENDIF
			
			*************
			IF NOT EMPTY(cAlloy)
				********************************	
				*Warn if that Heat/Lot is NOT Unique  --Also with Poitem is known
				
				
				IF USED("tmpOtherHeat")
					USE IN tmpOtherHeat
				ENDIF
		
		
				cSQL = "SELECT ID, POitem, SOitem, ISNULL(WO_Detail,0) AS WO_Detail, WhenAdd, Description "
				cSQL = cSQL + " FROM dbo.Receiving "
				cSQL = cSQL + " WHERE Heat = '"+cHeat+"'"
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND Lot = '"+cLot+"'"
				ENDIF
				cSQL = cSQL + " AND Alloy = '"+cAlloy+"'"
				cSQL = cSQL + " AND ID<>"+STR(nReceivingID)
				cSQL = cSQL + " AND ISNULL(Cancelled,0)=0 "  
				cSQL = cSQL + " AND dbo.f_Is_POitem_NOT_Stock(POitem) = 0 "
				IF Proper_PO_Item(cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " AND POitem = '"+cPOitem+"'"
				ENDIF
				
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOtherHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOtherHeat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOtherHeat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOtherHeat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpOtherHeat')
				ENDIF
		
				IF USED("tmpOtherHeat")
					IF RECCOUNT("tmpOtherHeat") > 0
		
						*Show screen of matching Heats!
						IF nWO_Detail > 0
							DO FORM Forms\ChooseReceivingDetails WITH nWO_Detail, cHeat, '' TO nEditReceivingID
							IF nEditReceivingID > 0
								ThisForm.txtReceivingID.Value = nEditReceivingID
								ThisForm.txtReceivingID.Refresh
								ThisFormSet.getBy_ReceivingID()
							ENDIF
						ELSE
							DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, '' TO nEditReceivingID
							IF nEditReceivingID > 0
								ThisForm.txtReceivingID.Value = nEditReceivingID
								ThisForm.txtReceivingID.Refresh
								ThisFormSet.getBy_ReceivingID()
							ENDIF
						ENDIF
						
						
		
					ENDIF
					USE IN tmpOtherHeat
				ENDIF
		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Receive_Edit.txtHpaPOItem.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0 OR ThisFormSet.cWhat = 'EDIT'
			*If it has a receivingID the POitem is good.
			RETURN .T.
		ENDIF
		
		*ThisFormSet.cWhat = 'ADD'
		
		PRIVATE cPOitem, nHpaPo, nItemPo, nWO_Detail, cHeat, cLot
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		cHeat 	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot 	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		IF nItemPo = 0
			ThisFormSet.ChecknItemPO = 0
		ENDIF
		
		****
		IF nItemPo = 0 AND nHpaPo > 0
			*Choose a HPApo
			ThisForm.ChoosePOitemLoad(nHPApo)
			*Refresh
			nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
			nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
			cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		ELSE
			IF ThisFormSet.ChecknItemPO = nItemPo
				IF nItemPo > 0
					*WAIT WINDOW "Already Checked this PO item:"+ALLTRIM(STR(nItemPO)) NOWAIT
				ENDIF
			ELSE
				IF nHpaPo > 0 AND nItemPo > 0
					IF ThisFormSet.ChecknHpaPO <> nHpaPo OR ThisFormSet.ChecknItemPO <> nItemPo
						IF EMPTY(cHeat) 
							ThisFormSet.cPOitem = cPOitem
							ThisFormSet.GetPOitemDetail(cPOitem)
						ELSE
							ThisFormSet.cPOitem = cPOitem
							ThisForm.GetFromReceiving(cPOitem,nWO_Detail,cHeat,cLot)
						ENDIF
						ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisFormSet.nConnhandle )
					ELSE
						*Do not Recheck
					ENDIF
				ENDIF
			ENDIF
		ENDIF	
		
		********
		IF ThisFormSet.cPOitem <> Proper_PO_Item('')
			IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle) = 0
				*Problem
				MESSAGEBOX("ERP POItem was not found."+CHR(13)+ThisFormSet.cPOitem+CHR(13)+"Cannot save!",48,"Bad POItem Number")
				
				This.Value = 0
				ThisForm.txtHpaPONum.Value = 0
				ThisForm.txtHpaPOItem.Value = Proper_PO_item('')
				ThisFormSet.cPOitem = Proper_PO_item('')
				
				RETURN .F.
			ENDIF
			
			*cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50))
			IF UPPER(cHeat) = "DUE IN" 
				IF nReceivingID > 0
					ThisFormSet.getBy_ReceivingID()
				ENDIF
			ENDIF
			
			*IF Count_POIteminPurchaseOrder( ThisFormSet.cPOitem, ThisFormSet.nConnhandle, 'WORKORDER') = 1  &&Done in GetPoItemDetail
			
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtHpaPONum.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0
			*If it has a Receiving ID, the POitem is good.
			*ThisForm.txtAlloy.SetFocus()
			RETURN .T.
		ENDIF
		
		
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat, cLot, nWO_Detail
		nHpaPo  = PrepareSQLnum(This.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE nCntPO,nCntPOitem 
		nCntPO = 0
		
		IF nItemPo = 0
			nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnhandle )
			IF nCntPO = 1
				cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-01" )
				nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnhandle,'' )
				IF nCntPOitem = 1
					*have the correct cPOitem!
					nItemPo = 1
					ThisForm.txtHpaPOItem.Value = 1
				ENDIF
			ELSE
				IF ThisForm.ChoosePOitemLoad(nHpaPo)
					*ThisForm.txtSOnum.SetFocus --not allowed
				ENDIF
			ENDIF
		ENDIF
		
		IF nItemPo > 0
			IF nHpaPo > 0
				IF ThisFormSet.ChecknHpaPO <> nHpaPo OR ThisFormSet.ChecknItemPO <> nItemPo
					ThisFormSet.cPOitem = cPOitem
					IF EMPTY(cHeat) OR UPPER(cHeat) = "DUE IN"
						IF ThisFormSet.GetPOitemDetail(cPOitem)
							ThisFormSet.ChecknItemPO = nItemPo
						ENDIF
					ELSE
						IF ThisForm.GetFromReceiving(cPOitem,nWO_Detail,cHeat,cLot)
							ThisFormSet.ChecknItemPO = nItemPo
						ENDIF
					ENDIF
		
				ELSE
					*Do not Recheck
				ENDIF
				IF EMPTY(ThisForm.txtVendor.Value)
					ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisFormSet.nConnhandle )
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtLot.GotFocus
		ThisForm.cLot = PrepareSQLtxt(This.Value,'Lot',10)
	ENDPROC

	PROCEDURE Receive_Edit.txtLot.Valid
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat, cLot, cAlloy
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy 	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cHeat 	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot 	= PrepareSQLtxt(This.Value,'Lot',10)
		
		IF ThisForm.cLot = cLot
			*Do not recheck, has not changed since GotFocus
			RETURN .T.
		ENDIF
		
		IF UPPER(cHeat)  = "DUE IN"
			MESSAGEBOX("This Receive will not save till a Heat is entered.",48,"No Heat")
			cHeat = ""	&&Do not check for Due In
			*RETURN .F.
		ENDIF
		
		PRIVATE nReceivingID, nEditReceivingID
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		nEditReceivingID = 0
		PRIVATE nID_Detail_Prc
		IF nReceivingID > 0 OR nID_Detail_Prc > 0
			*Skip Heat look up if already have ReceiveID or known nID_Detail_Prc
			RETURN .T.
		ENDIF
		
		IF NOT EMPTY(cHeat) 
		
			IF nHpaPo > 0 AND nItemPo = 0
				IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
					ThisForm.ChoosePOitemLoad(nHpaPo)
				ENDIF
			ELSE
				IF nHpaPo > 0 AND EMPTY(cHeat) 
					IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
						ThisFormSet.cPOitem = cPOitem
						ThisFormSet.GetPOitemDetail(cPOitem)
					ENDIF
				*ELSE
					*IF MESSAGEBOX("Do you want to look for a PO that used this Heat/Lot number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
					*	ThisFormSet.cPOitem = cPOitem
					*	ThisForm.GetFromReceiving(cPOitem,nWO_Detail,cHeat,cLot)
					*ENDIF
				ENDIF
			ENDIF
			
			IF USED('Receiving')
				SELECT Receiving
				LOCATE FOR ID = nReceivingID
			ENDIF
			
			*************		
			IF NOT EMPTY(cAlloy)
				********************************	
				*Warn if that Heat/Lot is NOT Unique
				
				
				IF USED("tmpOtherHeat")
					USE IN tmpOtherHeat
				ENDIF
		
		
				cSQL = "SELECT ID, POitem, SOitem, ISNULL(WO_Detail,0) AS WO_Detail, WhenAdd, Description "
				cSQL = cSQL + " FROM dbo.Receiving "
				cSQL = cSQL + " WHERE Heat = '"+cHeat+"'"
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND Lot = '"+cLot+"'"
				ENDIF
				cSQL = cSQL + " AND Alloy = '"+cAlloy+"'"
				cSQL = cSQL + " AND ID<>"+STR(nReceivingID)
				cSQL = cSQL + " AND ISNULL(Cancelled,0)=0 "  
				cSQL = cSQL + " AND dbo.f_Is_POitem_NOT_Stock(POitem) = 0 "
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOtherHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOtherHeat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOtherHeat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOtherHeat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpOtherHeat')
				ENDIF
		
				IF USED("tmpOtherHeat")
					IF RECCOUNT("tmpOtherHeat") > 0
		
						*Show screen of matching Heats!
						IF nWO_Detail > 0
							DO FORM Forms\ChooseReceivingDetails WITH nWO_Detail, cHeat, '' TO nEditReceivingID
							IF nEditReceivingID > 0
								ThisForm.txtReceivingID.Value = nEditReceivingID
								ThisForm.txtReceivingID.Refresh
								ThisFormSet.getBy_ReceivingID()
							ENDIF
						ELSE
							DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, '' TO nEditReceivingID
							IF nEditReceivingID > 0
								ThisForm.txtReceivingID.Value = nEditReceivingID
								ThisForm.txtReceivingID.Refresh
								ThisFormSet.getBy_ReceivingID()
							ENDIF
						ENDIF
						
					ENDIF
					USE IN tmpOtherHeat
				ENDIF
				
			ENDIF			
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtReceived.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE('dDate') = "C"
				dDate = CtoD(ALLTRIM(This.Value))
				This.Value = dDate
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtReceivingID.DblClick
		PRIVATE nMess
		nMess = MESSAGEBOX("Do you wish to reset Receiving ID to 0? (Y)"+CHR(13)+"Reseting to 0 will allow you to receive another Heat/Lot!",4+32,"Create new Receiving Record?")
		IF nMess = 6
			This.Parent.txtReceivingID.Value =0
			*This.Parent.txtID_Detail.Value	= 0
		ENDIF
	ENDPROC

