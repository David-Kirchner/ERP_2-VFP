	PROCEDURE Receive_Edit.txtSOitem.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(This.Value,'SOitem',2,0)
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					ThisFormSet.cSOitem = cSOitem
				ENDIF
				ThisFormSet.GetSoItemDetail()
			ELSE
				DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				
					IF Count_SOIteminSales( cSOItem, ThisFormSet.nConnhandle, '' ) = 0
						*Problem
						MESSAGEBOX("HPA SOItem was not found."+CHR(13)+cSOItem+CHR(13)+"Cannot save!",48,"Bad SOItem Number")
						
						This.Value = 0
						ThisForm.txtSOnum.Value = 0
						ThisFormSet.cSOitem = Proper_SO_item('')
						
						RETURN .F.
					ENDIF
						
					ThisFormSet.cSOitem = cSOitem
					This.Value = Proper_SO_item_item(cSOitem)
					ThisFormSet.GetSoItemDetail()
				ENDIF
			ENDIF
		ELSE
			*do not have full SOitem
		ENDIF
	ENDPROC

	PROCEDURE Receive_Edit.txtSOnum.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo, nOldSO
		nSalesNum	= PrepareSQLnum(This.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		nOldSO		= VAL(ThisFormSet.cSOitem)
		
		IF nOldSO > 0 AND nSalesNum > 0
			IF nOldSO <> nSalesNum 
				PRIVATE cPOitem, nHpaPo, nItemPo
				nHpaPo  = PrepareSQLnum(ThisForm.txtHPAPOnum.Value,'HPApo',-3)
				nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
				cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
				
				PRIVATE cMess, cSOitem
				
				cSOitem = PrepareSQLtxt(ThisFormSet.cSOitem,'SOitem',10)
				*cMess = "While Receiving for POitem='"+cPOitem+"'"
				cMess = "While Receiving for SOitem='"+cSOitem+"'"
				IF ThisFormSet.nReceivingID > 0
					cMess = cMess +CHR(13)+" ReceivingID="+ALLTRIM(STR(ThisFormSet.nReceivingID))
				ENDIF
				cMess = cMess +CHR(13)+" SalesNum="+ALLTRIM(STR(nOldSO ))+" was changed to"
				cMess = cMess +CHR(13)+" SalesNum="+ALLTRIM(STR(nSalesNum))+"."
				
				cMess = cMess +CHR(13)+CHR(13)+" POitem='"+cPOitem+"'"
				
				TrackMess(cMess)
			ENDIF
		ENDIF
		
		IF nSalesNum > 0 AND nItemSo > 0
		
			cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				ThisFormSet.cSOitem = cSOitem
			ENDIF
			*PRIVATE cPOitem, nHpaPo, nItemPo
			*nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
			*nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
			*cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
			*IF nSalesNum > 0 AND nHpaPo=0 AND nItemPo=0
				ThisFormSet.GetSoItemDetail()
			*ENDIF
		ELSE
			*do not have full SOitem
		ENDIF
	ENDPROC

