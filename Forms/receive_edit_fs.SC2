	PROCEDURE Show_Recv_Order.cmdCancel.Valid
		IF MESSAGEBOX("Are you sure you want to Abort this receive?",4+32,"Cancel")=6
			*cTBL = ThisFormSet.cTBL
			ThisFormSet.nReturn = 0
			ThisForm.Release
		ENDIF
		
	ENDPROC

	PROCEDURE Show_Recv_Order.cmdGood.Valid
		*This could be an Edit
		*Check for ReceivingID in Stock to see if new partial stock needs to be run
		
		*****************************
		ThisForm.Clean_Stock("NOT_CMPLT")
		
		*******************************
		*See if ID_Detail already exists -Should be as a 'Due In'
		PRIVATE nCountDetail, cHeat, nCountHeat, cLot
		*nCountDetail = Count_Lst_Detail_by_ID_Detail(ThisFormSet.cTBL,nID_Detail,ThisFormSet.nConnhandle)
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		nCountHeat = Count_Lst_by_ID_Detail_Heat(ThisFormSet.cTBL,nID_Detail,cHeat,ThisFormSet.nConnhandle)
		cLot = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',0)
		
		IF nCountHeat > 0
			*nMess = MESSAGEBOX("This heat was found"+CHR(13)+"Do you want to Edit (Y)"+CHR(13)+"Answer No if this is a seperate Receive.",32,"Contine with Edit")
		
			ThisFormSet.nReturn = 1
			ThisForm.Release
			RETURN .T.
		ENDIF
		
		********************************
		*PRIVATE lTranAlreadySet, nProp, lOK 
		*nProp = SQLGETPROP(nConn, 'Transactions')
		*lTranAlreadySet = (nProp = 2)
		*lOK = .T.
		
		***********************************
		PRIVATE nQTY_Rcv,nQTY_Need,nPounds_Need,nPC_Need, nS_QTY, nPast_QTY, nRcv_HPA_QTY, nPast_PC, cCompany
		nQTY_Rcv		= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'Rcv QTY',18,4)
		nQTY_Need 		= PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY_Need',18,4)
		nPounds_Need    = PrepareSQLnum(ThisForm.txtLBS_Need.Value,'Pounds_Need',9,1)
		nPC_Need		= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC_Need',-3)
		nS_QTY 			= PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		nS_P			= PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		nPast_QTY 		= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'Past_QTY',-5)
		nPast_PC 		= PrepareSQLnum(ThisForm.txtPast_PC.Value,'Past_PC',-3)
		nRcv_HPA_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'Receive_QTY',-5)
		cCompany		= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		
		PRIVATE nMess
		
		IF (( nPast_QTY + nRcv_HPA_QTY +5 ) < (nS_QTY+5) * 1.2 ) AND (( nPast_QTY + nRcv_HPA_QTY +5 ) > (nS_QTY+5) / 1.2)
			nMess = MESSAGEBOX("The quantity Received is about the same "+CHR(13)+"as the quantity Ordered!"+CHR(13)+CHR(13)+;
			"Are you sure you DO NOT want to mark this"+CHR(13)+"as a COMPLETE Receive? (Y)"+CHR(13)+CHR(13)+;
			"Answer No here to go back and then mark as COMPLETE."+CHR(13)+;
			"Answer Yes to continue as 'UN COMPLETE'."+CHR(13),4+32,"Order not Completed")
			IF nMess != 6
				RETURN .F.
			ELSE
				IF ThisFormSet.nWO_Detail = 0
					TrackMess("The POitem: '"+ThisFormSet.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"This QTY Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The previous QTY Received is "+ALLTRIM(STR(nPast_QTY))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisFormSet.nReceivingID))+"." +CHR(13)+"User override the 15% 'looks complete' message and saved as NOT complete.")
				ELSE
					TrackMess("The WO Detail: '"+ALLTRIM(STR(ThisFormSet.nWO_Detail))+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"This QTY this Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The previous QTY Received is "+ALLTRIM(STR(nPast_QTY))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisFormSet.nReceivingID))+"." +CHR(13)+"User override the 15% 'looks complete' message and saved as NOT complete.")
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		PRIVATE nPO_OrigQTY, nO_QTY, nID_Detail_Process
		nPO_OrigQTY = 0
		nO_QTY	= 0
		nID_Detail_Process = 0
		PRIVATE lNOT2HPA, lPARTRECV
		lNOT2HPA = .F.
		lPARTRECV = .F.
		PRIVATE nPrc_PCs_need 
		
		*****************************************************************************
		*Create a new Master, Detail, Process for this Received metal
		*Update the Old Detail listing with new lower QTY, Pounds, Pieces.
		*Update the Old Process listing with new lower QTY, Pounds, Pieces as INCOMING.
		*****************************************************************************
		
		*Look for INCOMING PO item
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = " SELECT QTY, Ordered_QTY, Ordered_P, ReceivingID, Process_ID, 'Original' AS Process, ID_Detail, ID_Detail_Process "
		cSQL = cSQL + " ,[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3],[Prc_Q_QTY],[Prc_Q_PU] "
		DO CASE
		CASE ThisFormSet.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE ThisFormSet.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE ThisFormSet.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_Item('')
			cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
			cSQL = cSQL + " AND WO_Detail = "+STR(ThisFormSet.nWO_Detail)
		ELSE
			IF ThisFormSet.nWO_Detail > 0
				cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisFormSet.nWO_Detail)
			ELSE
				cSQL = cSQL = " WHERE 0>0 "
			ENDIF
		ENDIF
		cSQL = cSQL+" AND ( Process_ID='INCOMING' OR Process_ID = 'NOT2HPA' )"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStkProc')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStkProc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStkProc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		* Old School- Not sure if still relevant
		IF USED('tmpStkProc')
			IF RECCOUNT('tmpStkProc') > 0
				***************************
				SCAN	&& NOT sure if multiple exists ???
					
					DO CASE
					CASE tmpStkProc.Process = 'Original'
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process_ID = 'INCOMING' 
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process_ID = 'NOT2HPA' 
						lNOT2HPA = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process_ID = 'PARTRECV' 
						lPARTRECV = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					ENDCASE
				ENDSCAN
		
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		****************************************************************************
		*get Orig PO QTY and PU from WO_Detail or POitem here
		
		PRIVATE nPO_QTY, nPO_P, nPU ,nStk_QTY, nStk_P, nStk_PU, cForm 
		nPO_QTY = 0
		nPO_P = 0
		nPU = 0
		nStk_QTY = 0
		nStk_P = 0
		nStk_PU = 0
		cForm = ''
		
		IF USED('tmpPOqty')	
			USE IN tmpPOqty
		ENDIF
		IF ThisFormSet.nWO_Detail > 0
			cSQL = "SELECT fWeight AS StockLst_QTY, 0 AS StockLst_P, 1 AS StockLst_PU, 0 AS StockLst_Total, fWeight AS Pounds "
			cSQL = cSQL + ", fWeight AS Order_QTY, 0 AS Order_P, 1 AS Order_PU, FForm AS Form "
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisFormSet.nWO_Detail)
		ELSE
			cSQL = "SELECT StockLst_QTY, StockLst_P, StockLst_PU, StockLst_Total, Pounds "
			cSQL = cSQL + ", Order_QTY, Order_P, Order_PU, Form "
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOqty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOqty')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOqty")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOqty")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOqty')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpPOqty')
			IF RECCOUNT('tmpPOqty') > 0
				nPO_QTY = PrepareSQLnum(tmpPOqty.Order_QTY,'Order_QTY',-5)
				nPO_P	= PrepareSQLnum(tmpPOqty.Order_P, 'Order_P',-5)
				nPU 	= PrepareSQLnum(tmpPOqty.Order_PU,'Order_PU',-1)
				
				nPounds	 = PrepareSQLnum(tmpPOqty.Pounds,'Pounds',9,1)
				
				nStk_QTY = PrepareSQLnum(tmpPOqty.StockLst_QTY,'S_QTY',-5)
				nStk_P	 = PrepareSQLnum(tmpPOqty.StockLst_P, 'Order_P',-5)
				nStk_PU  = PrepareSQLnum(tmpPOqty.StockLst_PU,'Order_PU',-1)
				
				cForm = PrepareSQLtxt(tmpPOqty.Form,'Form',2)
				IF nStk_PU = 0
					nStk_PU = nPU_Acct_Form(cForm, ThisFormSet.nConnhandle)
				ENDIF
			ENDIF
			USE IN tmpPOqty
		ENDIF
		
		****************************************************************************
		*collect data to Edit Master, Detail, Process with remaining QTY (Incoming)
		*Add Stock to Master, Detail and Process
		
		PRIVATE cSOitem,cPOitem,cSalesPerson,dtStartDate,dDueDate,cComment,cProcess_ID, nRcvID_Incoming
		cSOitem = Proper_SO_item(ThisFormSet.cSOitem)
		cPOitem = Proper_PO_item(ThisFormSet.cPOitem)
		cSalesPerson = ''
		dtStartDate = DATETIME()
		dDueDate = DATE()+2 
		cComment = ''
		cProcess_ID	= "INCOMING"
		*nReceivingID = ThisFormSet.nReceivingID
		nRcvID_Incoming = 0
		
		PRIVATE cProcessor,cAllowSub
		cProcessor = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
		cAllowSub	= 'N'
		
		PRIVATE cForm,nPU
		cForm = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		IF nStk_PU > 0
			nPU = nStk_PU  
		ELSE
			nPU = GetPUfromForm(cForm, ThisFormSet.nConnhandle)  
		ENDIF
		cUnit = GetUNITfromFORM(cForm, ThisFormSet.nConnhandle)
		
		PRIVATE nQTY_P,nQTY
		nQTY_P	= nStk_P
		nQTY	= 0
		
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		PRIVATE nWO, nWO_Detail
		nWO			= 0 
		nWO_Detail	= ThisFormSet.nWO_Detail
		PRIVATE lFoundOldPrc
		lFoundOldPrc = .F.
		
		***********************************************
		*Retreive INCOMING Process Detail before editing - If Exists
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = "SELECT * "
		DO CASE
		CASE ThisFormSet.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE ThisFormSet.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE ThisFormSet.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		IF ThisFormSet.cPOitem <> Proper_PO_item('')
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
		ELSE
			IF ThisFormSet.nWO_Detail > 0
				cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisFormSet.nWO_Detail)
			ENDIF
		ENDIF
		cSQL = cSQL + " AND ( [Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PARTRECV' )"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpStkProc')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStkProc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpStkProc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpStkProc')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpStkProc')	
			IF RECCOUNT('tmpStkProc') > 0
			
				lFoundOldPrc = .T.
				
				cSOitem	= PrepareSQLtxt(tmpStkProc.SOitem,'SOitem',10)
				ThisFormSet.cSOitem = cSOitem
				cPOitem	= PrepareSQLtxt(tmpStkProc.PO_item,'POitem',12)
				cSalesPerson = PrepareSQLtxt(tmpStkProc.SalesPerson,'SalesPerson',20)
				dtStartDate = PrepareSQLdateTime(tmpStkProc.StartDate,'StartDate')
				dDueDate = PrepareSQLdate(tmpStkProc.DueDate,'DueDate')
				cComment = PrepareSQLtxt( tmpStkProc.Comment,'Comment',100)
				cProcess_ID	= PrepareSQLtxt(tmpStkProc.Process_ID,'Process_ID',10)
				
				IF nPU=0
					nPU	= PrepareSQLnum(tmpStkProc.PU,'PU',-1)
				ENDIF
				*nQTY_P	= PrepareSQLnum(tmpStkProc.QTY_P,'QTY_P',-5)	&&Could implement S_P (Price per Unit)
				nQTY	= PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
				nO_QTY	= PrepareSQLnum(tmpStkProc.Ordered_QTY,'QTY',-5)
				nPounds				= PrepareSQLnum(tmpStkProc.Pounds,'Pounds',9,1)		
				nID_Detail			= PrepareSQLnum(tmpStkProc.ID_Detail,'ID_Detail',-3)
				nID_Detail_Process	= PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_Detail_Process',-3)
				*nReceivingID		= PrepareSQLnum(tmpStkProc.ReceivingID,'ReceivingID',-3)
				nRcvID_Incoming		= PrepareSQLnum(tmpStkProc.ReceivingID,'ReceivingID',-3)
				nWO			= PrepareSQLnum(tmpStkProc.WO,'WO',-3)
				nWO_Detail	= PrepareSQLnum(tmpStkProc.WO_Detail,'WO_Detail',-3)
				
				IF RECCOUNT('tmpStkProc') > 1
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(STR(RECCOUNT('tmpStkProc')))+CHR(13)+cSQL )
				ENDIF
			
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		
		****************************************
		IF NOT lFoundOldPrc
			*Could not find [Process_ID]='INCOMING'"
			*Get data from dbo.Receiving
			
			IF ThisFormSet.nReceivingID > 0
				*get from Receiving!
				IF USED('tmpReceiving2')	
					USE IN tmpReceiving2
				ENDIF
		
				cSQL = "SELECT * "
				cSQL = cSQL + " FROM dbo.Receiving "
				cSQL = cSQL + " WHERE ID = "+STR(ThisFormSet.nReceivingID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceiving2')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpReceiving2')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceiving2")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpReceiving2")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpReceiving2')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpReceiving2')	
					IF RECCOUNT('tmpReceiving2') > 0
						*lFoundOldPrc = .T.
						
						cSOitem	= PrepareSQLtxt(tmpReceiving2.SOitem,'SOitem',10)
						ThisFormSet.cSOitem = cSOitem
						cPOitem	= PrepareSQLtxt(tmpReceiving2.POitem,'POitem',12)
						IF LEN(cSalesPerson) < 1
							cSalesPerson = PrepareSQLtxt(cProcessor ,'SalesPerson',20)
						ENDIF
						dtStartDate = PrepareSQLdateTime(tmpReceiving2.Date,'StartDate', .F.,.T.)
						dDueDate = PrepareSQLdate(tmpReceiving2.Received,'DueDate')
						cComment = PrepareSQLtxt( tmpReceiving2.Comments,'Comment',100)
		
						cProcess_ID	= "INCOMING"
						cProcessor	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
						cAllowSub	= 'N'
						nQTY = nRcv_HPA_QTY	&&PrepareSQLnum(tmpReceiving2.ActualW,'ActualW',9,1)	
						nID_Detail			= 0 &&PrepareSQLnum(tmpReceiving2.ID_Detail,'ID_Detail',-3)
						nID_Detail_Process	= 0
						nWO			= PrepareSQLnum(tmpReceiving2.WO,'WO',-3)
						nWO_Detail	= PrepareSQLnum(tmpReceiving2.WO_Detail,'WO_Detail',-3)
						
					ENDIF
					USE IN tmpReceiving2
				ENDIF
						
			ENDIF
		ENDIF
		
		***********************************************************************************************
		*Clone a new Master Stock record for this receive
		*get Old ID to Clone
		
		PRIVATE nOld_ID	
		PRIVATE nOld_ID_Detail  &&get Old ID_Detail to Clone
		nOld_ID = 0
		nOld_ID_Detail = 0
		
		IF ThisFormSet.nID_Detail > 0
			IF LEN(ThisFormSet.cTBL) > 0
				nOld_ID_Detail = ThisFormSet.nID_Detail
			ELSE
				nOld_ID_Detail = nID_Detail
			ENDIF
		ELSE
			nOld_ID_Detail = nID_Detail
		ENDIF
		
		**************************************
		IF nOld_ID_Detail = 0
			*Find ID_Detail with PO_Item or WO_Detail - not accurate!!!
			*remove code when new code works 4-22
			IF lFoundOldPrc
				IF USED('tmpOldID')	
					USE IN tmpOldID
				ENDIF
		
				cSQL = "SELECT D.ID, D.ID_Detail, P.ID_Detail_Process  "
				DO CASE
				CASE ThisFormSet.cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail"
				CASE ThisFormSet.cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail"
				CASE ThisFormSet.cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail"
				ENDCASE
				cSQL = cSQL + " WHERE ( P.[Process_ID]='INCOMING' OR P.[Process_ID]='NOT2HPA' OR P.[Process_ID]='PARTRECV' )"
				IF ThisFormSet.nWO_Detail > 0
					cSQL = cSQL + " AND P.WO_Detail = "+STR(ThisFormSet.nWO_Detail)
				ENDIF
				IF ThisFormSet.cPOitem <> Proper_PO_item('')
					cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOldID')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOldID')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOldID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOldID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpOldID')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpOldID')	
					IF RECCOUNT('tmpOldID') > 0
						SCAN
							nOld_ID	= PrepareSQLnum(tmpOldID.ID,'ID',-3)
							IF nOld_ID = 0
								SKIP
							ELSE
								nOld_ID_Detail	= PrepareSQLnum(tmpOldID.ID_Detail,'ID_Detail',-3)
								nID_Detail_Process = PrepareSQLnum(tmpOldID.ID_Detail_Process,'ID_D_P',-3)
								
							*	IF ThisForm.UpdateProcess(nID_Detail_Process, ThisFormSet.nReceivingID )
								EXIT	&&Exit Scan
							*	ENDIF
							ENDIF				 
						ENDSCAN
						
						IF RECCOUNT('tmpOldID') > 1
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(STR(RECCOUNT('tmpOldID')))+CHR(13)+cSQL )
						ENDIF
					ENDIF
					USE IN tmpOldID
				ENDIF
		
				IF nOld_ID = 0
			*		MESSAGEBOX("Did not find old data"+CHR(13)+"",0+48,"No")
					lFoundOldPrc = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*************************************
		*This Block of Code is probably just redundate
		IF nOld_ID_Detail = 0 AND NOT lFoundOldPrc
			*No INCOMING process
			*get the Old ID and ID_Detail by PO_item or WO_Detail  - not accurate!!!
			IF ThisFormSet.cPOitem <> Proper_PO_item('')
				IF USED('tmpOldID')	
					USE IN tmpOldID
				ENDIF
		
				cSQL = "SELECT M.ID, 'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
					IF NOT EMPTY(cHeat)
						cSQL = cSQL + " AND Heat = '"+ALLTRIM(cHeat)+"'"
					ENDIF
					IF NOT EMPTY(cLot)
						cSQL = cSQL + " AND Lot = '"+ALLTRIM(cLot)+"'"
					ENDIF
		
				ELSE
					IF ThisFormSet.nID_Detail > 0
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITHNOLOK) ON M.ID = D.ID "
						cSQL = cSQL + " WHERE D.ID_Detail = "+STR(ThisFormSet.nID_Detail)
					ENDIF
				ENDIF
				
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT M.ID, 'B' AS TBL "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
					IF NOT EMPTY(cHeat)
						cSQL = cSQL + " AND Heat = '"+ALLTRIM(cHeat)+"'"
					ENDIF
					IF NOT EMPTY(cLot)
						cSQL = cSQL + " AND Lot = '"+ALLTRIM(cLot)+"'"
					ENDIF
		
				ELSE
					IF ThisFormSet.nID_Detail > 0
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITHNOLOK) ON M.ID = D.ID "
						cSQL = cSQL + " WHERE D.ID_Detail = "+STR(ThisFormSet.nID_Detail)
					ENDIF
				ENDIF
				
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT M.ID, 'W' AS TBL "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				
				IF Proper_PO_item(ThisFormSet.cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisFormSet.cPOitem+"')"
					IF NOT EMPTY(cHeat)
						cSQL = cSQL + " AND Heat = '"+ALLTRIM(cHeat)+"'"
					ENDIF
					IF NOT EMPTY(cLot)
						cSQL = cSQL + " AND Lot = '"+ALLTRIM(cLot)+"'"
					ENDIF
		
				ELSE
					IF ThisFormSet.nID_Detail > 0
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITHNOLOK) ON M.ID = D.ID "
						cSQL = cSQL + " WHERE D.ID_Detail = "+STR(ThisFormSet.nID_Detail)
					ENDIF
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOldID')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpOldID')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOldID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpOldID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpOldID')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpOldID')	
					IF RECCOUNT('tmpOldID') > 0
						SCAN 
							IF ThisFormSet.cTBL = PrepareSQLtxt(tmpOldID.TBL,'TBL',1)
								nOld_ID	= PrepareSQLnum(tmpOldID.ID,'ID',-3)
								IF nOld_ID = 0
									SKIP
								ELSE
									ThisFormSet.cTBL 	= PrepareSQLtxt(tmpOldID.TBL,'TBL',1)
									EXIT
								ENDIF
								
							ENDIF
						ENDSCAN
						
						nOld_ID_Detail	= 0
						IF RECCOUNT('tmpOldID') > 1
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(STR(RECCOUNT('tmpOldID')))+CHR(13)+ThisFormSet.cTBL+CHR(13)+cSQL )
						ENDIF
						
					ENDIF
					USE IN tmpOldID
				ENDIF
		
				IF nOld_ID = 0
					*Create StockListing is run in Receive_Edit !! not here
					
					lFoundOldPrc = .F.
				ENDIF		
			
			ENDIF
		ENDIF
		
		IF nOld_ID_Detail > 0
			IF nOld_ID = 0
				nOld_ID = GetIDfromID_Detail( nOld_ID_Detail, ThisFormSet.cTBL, ThisFormSet.nConnhandle )
			ENDIF
		ENDIF
		
		***********************************************************************************************
		= SQLSETPROP(ThisFormSet.nConnhandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		* Manual transactions
		***********************************************************************************************
		
		PRIVATE lCommit, lOK, cBadMess
		lCommit = .T.
		lOK = .T.
		cBadMess = ''
		
		********************
		PRIVATE nNewID, nNewID_Detail, nNewTBL
		nNewID = 0
		nNewID_Detail = 0
		nNewTBL = "S"
		********************
		IF nOld_ID > 0 AND ThisFormSet.nReceivingID > 0
		
			******************************
			*Create new MASTER Stock record for new Receive 
			*Makes a Stock Lst entry
			nNewID = ThisForm.Lst_Master_Clone(ThisFormSet.cTBL,nOld_ID,nQTY_Rcv,cHeat,cLot)
			
			IF nNewID = 0
				MESSAGEBOX("Could not Create new MASTER Stock record",16,"Error")
				TrackError("Could not Create new MASTER Stock record "+CHR(13)+"TBL "+ThisFormSet.cTBL+CHR(13)+"ID= "+STR(nOld_ID)+CHR(13)+"Receive QTY "+STR(nQTY_Rcv),"Could not Create new MASTER Stock record ", PROGRAM(), LINENO(1))
				cBadMess = cBadMess + "Could not Create new MASTER Stock record "+CHR(13)
				lOK = .F.
			ENDIF
			
			IF lOK 
				IF nNewID > 0
					******************************
					*Create new DETAIL Stock record with Receive data 
					*nOld_ID_Detail = PrepareSQLnum(ThisFormSet.nID_Detail,'ID_Detail',-3)
					IF nOld_ID_Detail = 0
						*Should never be 0
						nOld_ID_Detail = getHighestID_DetailbyID(nOld_ID,ThisFormSet.cTBL,ThisFormSet.nConnhandle)	&&Not a good Practice
					ENDIF
					IF nOld_ID_Detail = 0
						*lOK = .F.
						*cBadMess = cBadMess + "Do not have the Old ID_Detail to update. "+CHR(13)
						*EXEC dbo.p_Lst_Detail_ins
						nNewID_Detail = ThisForm.Lst_Detail_Ins(nNewID, nNewTBL )
					ELSE
						nNewID_Detail = ThisForm.Lst_Detail_Clone(nNewID, nOld_ID_Detail)
					ENDIF
					
					ThisFormSet.nID_Detail = nNewID_Detail 
					IF nNewID_Detail > 0
						ThisForm.Copy_SelectedPrc(nOld_ID_Detail, nNewID_Detail)		
					ELSE
						cBadMess = cBadMess + "Did not create a new ID_Detail . "+CHR(13)
					ENDIF
					
				ENDIF
			ENDIF
			*
			IF lOK
				*update the NEW Detail
				**********************
				IF nNewID_Detail > 0	
					*UPDATE new ID_Detail with the current data!  
					
					PRIVATE nPC_Recv, nActualW, nRcv_QTY, nS_P, nS_Total
					nPC_Recv	= PrepareSQLnum(ThisForm.txtPC_Recv.Value,'Pieces',-3)
					nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)	
					nRcv_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'QTY',-5)
					nS_P		= PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
					nS_Total	= nRcv_QTY * nS_P
		
					DO CASE
					CASE nNewTBL = "S"
						cSQL = "UPDATE dbo.StockLst_Detail SET "
					CASE nNewTBL = "B"
						cSQL = "UPDATE dbo.BrokerLst_Detail SET "
					CASE ThisFormSet.cTBL = "W"
						cSQL = "UPDATE dbo.WIPLst_Detail SET "
					ENDCASE
								
					cSQL = cSQL+ " PC="+STR(nPC_Recv)+""
					cSQL = cSQL+ ",Weight="+STR(nActualW,18,4)+""
					cSQL = cSQL+ ",ReceivingID="+STR(ThisFormSet.nReceivingID)
					cSQL = cSQL+ ",InvCheck=GetDate()" &&+"'"+DTOC(DATE())+"'"
					cSQL = cSQL+ ",S_QTY = " + STR(nRcv_QTY,18,4) + ""
					cSQL = cSQL+ ",S_P = "+STR(nS_P,18,4)
					cSQL = cSQL+ ",S_Total = "+STR(nS_Total,18,4)
					cSQL = cSQL+ ",Prime = 1"
					
					cSQL  = cSQL+ " WHERE ID_Detail="+STR(nNewID_Detail)
				
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError(cSQL, ThisFormSet.nConnhandle,nSQLEXEC)
						lCommit = .F.
						lOK = .F.
						cBadMess = cBadMess + "Could not Update the new Detail record "+CHR(13)
					ENDIF
				
				ENDIF
			ENDIF
			
			IF lOK
				**Update the NEW Master
				* --Totally redundant!!!
				PRIVATE cHeat, cLot, cPOitem, nFrom_ID, nWO_Detail
				cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
				cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
				cPOitem = PrepareSQLtxt(ThisFormSet.cPOitem,'POitem',12)
				nFrom_ID = nOld_ID 
				nWO_Detail	= PrepareSQLnum(ThisFormSet.nWO_Detail,'WO_Detail',-3)
				
				DO CASE
				CASE nNewTBL = "S"
					cSQL = "UPDATE dbo.StockLst_Master SET "
				CASE nNewTBL = "B"
					cSQL = "UPDATE dbo.BrokerLst_Master SET "
				CASE nNewTBL = "W"
					cSQL = "UPDATE dbo.WIPLst_Master SET "
				ENDCASE
				
				cSQL = cSQL +" Heat = '"+cHeat+"'"
				cSQL = cSQL +",Lot = '"+cLot+"'"
				cSQL = cSQL +",StkDate='"+TTOC(DATETIME())+"'"
				cSQL = cSQL +",POStatus = 'W'"
				IF cPOitem <> Proper_PO_item('')
					cSQL = cSQL+",PO_item = '"+cPOitem+"'"
				ENDIF
				IF nWO_Detail > 0
					cSQL = cSQL + ",WO_Detail = "+STR(nWO_Detail)
				ENDIF
				cSQL = cSQL + ",From_ID="+STR(nFrom_ID)
				cSQL = cSQL +" WHERE ID ="+STR(nNewID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnhandle,nSQLEXEC)
					lCommit = .F.
					lOK = .F.
					cBadMess = cBadMess + "Could not Update Master "+CHR(13)
				ENDIF
			ENDIF
			
			***************************************************************************
			IF lOK AND nNewID > 0 AND nNewID_Detail > 0 AND ThisFormSet.nReceivingID > 0
			
				*Update Receiving
				cSQL = "UPDATE dbo.Receiving "
				cSQL = cSQL +" SET StockTable = '"+nNewTBL +"'"
				cSQL = cSQL +",ID_Master = "+STR(nNewID)
				cSQL = cSQL +",ID_Detail = "+STR(nNewID_Detail)
				cSQL = cSQL +" WHERE ID ="+STR(ThisFormSet.nReceivingID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
			ENDIF
			
		ENDIF
		
		********************
		******************************
		********************
		IF lOK AND nNewID > 0 AND nNewID_Detail > 0 AND nOld_ID_Detail > 0 AND ThisFormSet.nReceivingID > 0 AND lOK
			*Update the 'Due In' with the QTY Needed
			*Detail QTY
			
			PRIVATE cLength, nS_Total
			cLength = "Balance DUE IN for "
			IF cPOitem <> Proper_PO_item('')
				cLength = cLength+"PO_item = "+ALLTRIM(cPOitem)
			ENDIF
			IF nWO_Detail > 0
				cLength = cLength+ "WO_Detail = "+ALLTRIM(STR(nWO_Detail))
			ENDIF
			IF nPC_Need < 1
				nPC_Need = 1
			ENDIF
			IF nQTY_Need < 0
				nQTY_Need = 0
			ENDIF
			DO CASE
			CASE nNewTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			CASE nNewTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			CASE nNewTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail SET "
			ENDCASE
			cSQL = cSQL +" Length='"+cLength+"'"
			cSQL = cSQL +",PC="+STR(nPC_Need)
			cSQL = cSQL +",Weight="+STR(nPounds_Need,9,1)
			cSQL = cSQL +",S_QTY="+STR(nQTY_Need,18,4)
			cSQL = cSQL +",S_Total="+STR(nQTY_Need,18,4)+"*[S_P]"
			
			cSQL = cSQL +" WHERE ID_Detail ="+STR(nOld_ID_Detail)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		ENDIF
		
		
		********************
		*Create new INCOMING PROCESS Stock, Broker or WIP record for new balance after Receive!
		************************
		IF lFoundOldPrc
			*Fix Process, Receive old INCOMING and create new INCOMING for balance
			lOK = ThisForm.Update_Incoming_Process(nNewTBL, nNewID, nNewID_Detail, nOld_ID, nOld_ID_Detail )
		ELSE
			*Just Received- Do not Create 
			*ThisForm.Create_Incoming_Process()
			
		ENDIF
		
		
		
		
		*Create a Received Process?
		
		
		******************************************
		IF lCommit 
			WAIT WINDOW "Saved!" NOWAIT
			=SQLCOMMIT(ThisFormSet.nConnhandle)
		ELSE
			MESSAGEBOX("SQL Transaction Rolled Back",0,"Could not save!")
			=SQLROLLBACK(ThisFormSet.nConnhandle)
			TrackError("SQL Transaction Rolled Back"+CHR(13)+CHR(13)+cBadMess,"Could not save!",PROGRAM(),LINENO(1))
			*= SQLSETPROP(ThisFormSet.nConnhandle, 'Transactions', 1) 
			*RETURN .F.
			
		ENDIF
		
		
		***************************************************************************************
		= SQLSETPROP(ThisFormSet.nConnhandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		***************************************************************************************
		
		*ThisForm.Check_PartRecv("NOT_CMPLT")
		
		*Good, Receive matches PO,  ** NOT Complete **
		IF nNewID_Detail > 0
			ThisFormSet.nReturn = PrepareSQLnum(("1."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
		ELSE
			ThisFormSet.nReturn = 1
		ENDIF
		ThisForm.Release
		
	ENDPROC

	PROCEDURE Show_Recv_Order.cmdGoodCmplt.Valid
		*check for Complete by QTY
		PRIVATE nQTY_Need, nS_QTY, nRcv_QTY, cCompany, nMess, nPast_QTY, nRcv_HPA_QTY, nPO_P
		nQTY_Need	= PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY_Need',-5)
		nS_QTY 		= PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		nRcv_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'S_QTY',-5)
		cCompany	= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		
		nS_P = PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		
		nPast_QTY 	= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'Past_QTY',-5)
		nRcv_HPA_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'Receive_QTY',9,1)
		
		*nPast_PC	= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'Past_QTY',-5)
		nPast_PC	= PrepareSQLnum(ThisForm.txtPast_PC.Value,'Past_PC',9,1)  
		
		IF (( nPast_QTY + nRcv_HPA_QTY +5) * 1.2 < (nS_QTY+5) ) OR (( nPast_QTY + nRcv_HPA_QTY +5 ) > (nS_QTY+5) * 1.2 )
			nMess = MESSAGEBOX("The Quantity Ordered to Quantity Received is more the 15% off!"+CHR(13)+CHR(13)+"Are you sure you want to make this as a COMPLETE receive?",4+32,"Complete?")
			IF nMess != 6
				RETURN .F.
			ELSE
				IF Proper_PO_Item(ThisFormSet.cPOitem) <> Proper_PO_Item('')
					PRIVATE cMess
					cMess = "The POitem: '"+ThisFormSet.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"This QTY this Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The previous QTY Received is "+ALLTRIM(STR(nPast_QTY))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisFormSet.nReceivingID))+"." +CHR(13)+"User override the 15% Error message and saved as complete."
					TrackMess(cMess)
					Send_Chatter("PO_Item_Overage",ThisFormSet.cPOitem,ThisFormSet.cPOitem, cMess, ThisFormSet.nConnhandle)
					*PARAMETERS pcType_Name, pnNumber, pcNumber, pcMessage, pConnHandle
				ENDIF
				IF ThisFormSet.nWO_Detail > 0
					TrackMess("The WO Detail: '"+STR(ThisFormSet.nWO_Detail)+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"This QTY this Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The previous QTY Received is "+ALLTRIM(STR(nPast_QTY))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisFormSet.nReceivingID))+"." +CHR(13)+"User override the 15% Error message and saved as complete.")
				ENDIF
			ENDIF
		ENDIF
		
		
		*****************************
		ThisForm.Clean_Stock("CMPLT")
		
		* ThisForm.Del_IncomProc()
		
		PRIVATE nNewID_Detail
		nNewID_Detail = 0 &&Did not Add a new ID_Detail
		*****************************
		IF nNewID_Detail > 0
			ThisFormSet.nReturn = PrepareSQLnum(("2."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
		ELSE
			ThisFormSet.nReturn = 2
		ENDIF
		
		ThisForm.Release
		
	ENDPROC

	PROCEDURE Show_Recv_Order.cmdJustEdit.Valid
		
		*****************************
		*PRIVATE lClearIncomingProcess
		*lClearIncomingProcess = .T.
		*lClearIncomingProcess = ThisForm.Update_POStatus(.F.)
		
		*****************************
		ThisForm.Check_PartRecv("EDIT")
		
		PRIVATE lComplete
		lComplete = (ThisForm.ogPOitem.Value = 1)
		IF lComplete 
			*!*	*Done in ShowReceived_Ordered 
			*!*	nPOcomplete = 2
			ThisFormSet.nReturn = 2
		ELSE
			ThisFormSet.nReturn = 3
		ENDIF
		*Check to see if the Receive made it to StockLst
		*-- This is done in Receive_Edit.SaveAdd()
		
		*******************
		**Good, Just Editing the Receiving Record.
		*ThisFormSet.nReturn = 3
		*cTBL = ThisFormSet.cTBL
		ThisForm.Release
		
	ENDPROC

