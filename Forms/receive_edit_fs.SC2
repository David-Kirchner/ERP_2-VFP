		IF EMPTY(ThisFormset.Receive_Edit.edtDescription.Value) AND EMPTY(ThisFormset.Receive_Edit.edtSpecs.Value)
		
			*Past the Receive and INCOMING checks - just find data by POitem
			***Look at PurchaseOrder to back fill data 
			*--ThisFormset.Receive_Edit.frmReceiving-Not PO RecvStock
		
			PRIVATE cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, cLot, lRandLen, cDispAlloy, nStandSize, cMisc_purch
			PRIVATE nSalesNum, nItemSo, cDescription, nWeight
			PRIVATE cSOitem, cHeatCurr
		
			IF USED('tmpPOp')
				USE IN tmpPOp
			ENDIF
		
			cSQL = "SELECT * "
			cSQL = cSQl + ",dbo.f_Descript(Alloy,CC,Form,Thck,Sz2,Sz3,Order_QTY,RandLen ) AS Descript"
			cSQL = cSQl + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQl + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpPOp')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQL, 'tmpPOp' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpPOp")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, 'tmpPOp' )
			ENDIF
		
			IF USED('tmpPOp')
				IF RECCOUNT('tmpPOp') > 0
					*get PO Item data
					ThisFormset.Receive_Edit.txtHPAPOItem.Value = PrepareSQLnum(tmpPOp.ItemPO,'ItemPO',2)
					ThisFormSet.cPOitem		=  cPOitem
					ThisFormset.Receive_Edit.txtHPAPONum.Value = VAL(cPOitem)
					ThisFormSet.ChecknItemPO	= ThisFormset.Receive_Edit.txtHPAPOItem.Value
					ThisFormSet.ChecknHpaPO	= VAL(cPOitem)
					
					cSOitem = Proper_SO_Item(tmpPOp.SOitem)
					*********************************
					*Do not Add SOitem automatic, make use enter correct one- could be mutiple!!!
		*!*				IF !EMPTY(cSOitem) AND Proper_SO_Item(cSOitem) != Proper_SO_Item('')
		*!*				
		*!*					IF Count_SOIteminSales(cSOitem, ThisFormSet.nConnhandle ) > 0
		*!*						IF Count_SOIteminSales(cSOitem, ThisFormSet.nConnhandle, "CANCEL") < 1
		*!*							*Do not use if Cancelled
		*!*							ThisFormSet.cSOitem			= PrepareSQLtxt(tmpPOp.SOitem,'SOitem',10)
		*!*							ThisFormset.Receive_Edit.txtSOnum.Value		= Proper_SO_Item_SO(ThisFormSet.cSOitem)
		*!*							ThisFormset.Receive_Edit.txtSOitem.Value	= Proper_SO_Item_Item(ThisFormSet.cSOitem)
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
					
					*
					*Only ask only if a Service or Conv or Service PO ??? removed 01/16/19
					*IF PO_POitem_Cnt( cPOitem, ThisFormSet.nConnhandle, 'SERVICECONVSERV' ) > 0 removed 01/16/19
						cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
						IF !EMPTY(cCompany)
							IF !EMPTY(ThisFormset.Receive_Edit.txtVendor.Value)
								IF ALLTRIM(UPPER(get_NoNoiseName(ThisFormset.Receive_Edit.txtVendor.Value,ThisFormSet.nConnhandle))) != ALLTRIM(UPPER(get_NoNoiseName(cCompany,ThisFormSet.nConnhandle)))
			*						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisFormset.Receive_Edit.txtVendor.Value)+"' with '"+Alltrim(cCompany)+"?"+CHR(13)+"ThisFormSet.GetPOitemDetail()",4+32,"Purchase Order Table has Vendor listed differently.") = 6
										ThisFormset.Receive_Edit.txtVendor.Value = cCompany
			*						ENDIF
								ENDIF
							ELSE
								ThisFormset.Receive_Edit.txtVendor.Value = ALLTRIM(ShowSQLtxt(cCompany,'Company',30))
							ENDIF
						ENDIF
					*ENDIF
					*
					cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
					IF !EMPTY(cAlloy)
						IF !EMPTY(ThisFormset.Receive_Edit.txtAlloy.Value)
							IF ThisFormset.Receive_Edit.txtAlloy.Value != cAlloy
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisFormset.Receive_Edit.txtAlloy.Value)+"' with '"+Alltrim(cAlloy)+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetPOitemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
									ThisFormset.Receive_Edit.txtAlloy.Value = cAlloy
								ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.txtAlloy.Value = cAlloy
						ENDIF
					ENDIF
					*
					cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
					ThisFormset.Receive_Edit.txtForm.Value = cForm
					
					nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
					IF nPieces > 0
						IF !EMPTY(ThisFormset.Receive_Edit.txtPieces.Value)
							IF ROUND(ThisFormset.Receive_Edit.txtPieces.Value,0) != ROUND(nPieces,0)
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisFormset.Receive_Edit.txtPieces.Value))+"'"+CHR(13)+"with the Complate PO count of'"+Alltrim(STR(nPieces))+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetPOitemDetail()",4+32,"Purchase Order Table has Pieces listed differently.") = 6
									ThisFormset.Receive_Edit.txtPieces.Value = nPieces
								ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.txtPieces.Value = nPieces
						ENDIF
					ENDIF
					*
					nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
					nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
					nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
					cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
					IF !EMPTY(cCond_Spec)
						IF !EMPTY(ThisFormset.Receive_Edit.edtSpecs.Value)
							IF NOT ALLTRIM(UPPER(ThisFormset.Receive_Edit.edtSpecs.Value)) == ALLTRIM(UPPER(cCond_Spec))
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Specs '"+ALLTRIM(ThisFormset.Receive_Edit.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cCond_Spec)+"?"+CHR(13)+CHR(13)+"ThisFormSet.GetPOitemDetail()",4+32,"Purchase Order Table has Specs listed differently.") = 6
									ThisFormset.Receive_Edit.edtSpecs.Value = cCond_Spec
								ENDIF
							ENDIF
						ELSE
							ThisFormset.Receive_Edit.edtSpecs.Value = cCond_Spec
						ENDIF
					ENDIF
					*
			*!*			cHeat = PrepareSQLtxt(tmpPOp.Heat,'Heat',50)
			*!*			IF !EMPTY(cHeat)
			*!*				IF !EMPTY( ALLTRIM(ThisFormset.Receive_Edit.txtHeat.Value ))
			*!*					*IF ALLTRIM(UPPER(ThisFormset.Receive_Edit.txtHeat.Value)) != ALLTRIM(UPPER(cHeat))
			*!*					
			*!*						*CHOOSE Receiving Details if different heat
			*!*		
			*!*					*ENDIF
			*!*				ELSE
			*!*					ThisFormset.Receive_Edit.txtHeat.Value = cHeat
			*!*				ENDIF
			*!*			ENDIF
					*
