	ENDPROC

	PROCEDURE settowod2
		*SetToWOD()
		This.Caption = "Show Received Vs Produced"
		
		ThisFormSet.Show_Recv_Order.cmdCancel.Caption = "Stop, Receive does not match Produced!"
		ThisFormSet.Show_Recv_Order.cmdGood.Caption = "Good, Receive matches WOD,  ** but NOT Complete **"
		ThisFormSet.Show_Recv_Order.cmdGoodCmplt.Caption = "Good, Receive matches WOD and COMPLETES the WO Detail!"
