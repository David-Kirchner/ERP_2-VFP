	ENDPROC

	PROCEDURE editbywod
		PARAMETERS pWOD,pWO
		*ThisFormSet.EditbyWO(pWOD,pWO)
		
		PRIVATE nWOD
		IF VARTYPE(pWOD) = "N"
			nWOD = pWOD
		ELSE
			MESSAGEBOX("Parameter WOD missing",0,"ThisFormSet.EditbyWOD")
			RETURN .F.
		ENDIF
		
		PRIVATE nWO
		IF VARTYPE(pWO) = "N"
			nWO = pWO
		ELSE
			MESSAGEBOX("Parameter WO missing",0,"ThisFormSet.EditbyWO")
			RETURN .F.
		ENDIF
		
		PRIVATE lFoundWOD, lFoundWO, lCreateWO
		lFoundWOD	= .F.
		lFoundWO 	= .F.
		lCreateWO		= .T.
		
		*****************************************
		IF USED("tmpWOD")	
			USE IN tmpWOD
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder_Detail WHERE WO_Detail ="+STR(nWOD)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOD')
		ELSE
			IF USED('tmpWOD')
				IF tmpWOD.Cnt > 0
					lFoundWOD = .T.
				ENDIF
				USE IN tmpWOD
			ENDIF
		ENDIF
		
		
		*****************************************
		IF lFoundWOD
			cSQL = "SELECT * FROM dbo.WorkOrder_Detail WHERE WO_Detail ="+STR(nWOD)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
			ELSE
				IF USED('tmpWO_Detail')
					IF RECCOUNT('tmpWO_Detail') > 0
					
						IF nWO = 0
							*Get WO while table is open
							nWO = PrepareSQLnum(tmpWO_Detail.WO,'WO',-3)
							ThisFormSet.nWO = nWO
						ENDIF
		
						ThisFormSet.ShowWO_Detail(nWOD)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		*****************************************
		
		IF USED("tmpWO")	
			USE IN tmpWO
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder WHERE WO ="+STR(nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
		ELSE
			IF USED('tmpWO')
				IF tmpWO.Cnt > 0
					lFoundWO = .T.
				ENDIF
				USE IN tmpWO
			ENDIF
		ENDIF
		
		*****************************************
		IF lFoundWO
			cSQL = "SELECT * FROM dbo.WorkOrder WHERE WO ="+STR(nWO)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
			ELSE
				IF USED('tmpWO')
					IF NOT EOF('tmpWO')
						ThisFormset.frmWorkOrder.txtWO.Value = tmpWO.WO
						ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
						*ThisFormset.frmWorkOrder.txtWO.Enabled = .F.
						ThisFormset.frmWorkOrder.txtPieces.Value = tmpWO.sPieces
						ThisFormset.frmWorkOrder.txtAlloy.Value	= tmpWO.sAlloy
						ThisFormset.frmWorkOrder.cmbForm.Value	= tmpWO.sForm
						ThisFormSet.RefreshForms(tmpWO.sForm)
						ThisFormset.frmWorkOrder.cmbCC.Value	= tmpWO.sCC
						ThisFormSet.InitcmbCL()
		
						ThisFormset.frmWorkOrder.cmbCL.Value	= tmpWO.sCL
						ThisFormset.frmWorkOrder.txtThck.Value	= tmpWO.sThck
						ThisFormset.frmWorkOrder.txtSz2.Value	= tmpWO.sSz2
						ThisFormset.frmWorkOrder.txtSz3.Value	= tmpWO.sSz3
						ThisFormSet.frmWorkOrder.chkPinSWeight.Value	=  PrepareSQLchk(tmpWO.pinSWeight,'pinSWeight')
						ThisFormset.frmWorkOrder.txtWeight.Value = tmpWO.sWeight
						*ThisFormSet.frmWorkOrder.txtID_Detail.Value		= PrepareSQLnum(tmpWO.sID_Detail,'ID_Detail',-3)
						*ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value = PrepareSQLnum(tmpWO.sID_Detail_Process,'ID_Detail_Process',-3)
						*
						IF ISNULL( tmpWO.StartDate )
							ThisFormset.frmWorkOrder.txtStartDate.Value	= DATE()
						ELSE
							ThisFormset.frmWorkOrder.txtStartDate.Value	= PrepareSQLDate(tmpWO.StartDate,'StartDate')
						ENDIF
						ThisFormset.frmWorkOrder.chkIntP.Value		= PrepareSQLchk(tmpWO.IntP,'IntP')
						ThisFormset.frmWorkOrder.chkRE.Value		= PrepareSQLchk(tmpWO.RE,'RE')
						
						ThisFormset.frmWorkOrder.txtDescript.Value	= PrepareSQLtxt(tmpWO.Descript,'Descript',100)
						ThisFormset.frmWorkOrder.edtWO_Notes.Value	= PrepareSQLtxt(tmpWO.Notes,'Notes',-1)
						
						ThisFormset.frmWorkOrder.txtSalesRep.Value	= PrepareSQLtxt(tmpWO.SalesRep,'SalesRep',20)
						ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpWO.SOitem,'SOitem',10)
						ThisFormSet.frmWorkOrder.txtPOitem.Value	= PrepareSQLtxt(tmpWO.POitem,'POitem',12)
						
						ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= PrepareSQLchk(tmpWO.lPrc_Stock,'lPrc_Stock')
						ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= PrepareSQLchk(tmpWO.StkConsumed,'StkConsumed')
		
						ThisFormSet.Refresh_ChooseWO_Detail(tmpWO.WO)
						
						ThisFormSet.Show_StockLst_Process(tmpWO.WO)
						
						ThisFormSet.WOscreen('Enable')
		
					ENDIF
					USE IN tmpWO
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Did not find WO data",0,"No Data")
			TrackError("Did not find WO data","Did not find WO '"+STR(nWO)+"'.","WorkOrder:EditByWOD",LINENO(1) )
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pWhat, pType, pID , nTop, nLeft, cCaption
		
		*DO FORM Forms\Router WITH "EDIT","WOD",1081 ,nTop, nLeft, cCaption
		SET SAFETY OFF
		
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		IF VARTYPE(pType) != "C"
			pType = ""
		ENDIF
		
		PRIVATE biID
		biID = PrepareSQLnum(pID,'rtr_ID',-4)
		*pID could be bi or INT or TXT
		
		IF TYPE('nTop') = 'N'
			IF nTop < _SCREEN.Height - ThisFormSet.frmRouter.Height
				ThisFormSet.frmRouter.Top = nTop
			ENDIF
		ENDIF
		IF TYPE('nLeft') = 'N'
			IF nLeft < _SCREEN.Width - ThisFormSet.frmRouter.Width
				ThisFormSet.frmRouter.Left = nLeft
			ENDIF
		ENDIF
		IF TYPE('cCaption') = 'C'
			ThisFormSet.frmRouter.Caption = ThisFormSet.frmRouter.Caption+" "+cCaption
		ENDIF
		
		ThisFormSet.frmRouter.LoadRTR() &&Load All Data
			*use ThisFormSet.frmRouter.LoadRTR(biDI) to LOCATE FOR ID = STR(biID)
		
		*-- If this DO Case changes, repeat in libs\production.vcx
		DO CASE 
		CASE pType = "ROUTER"
			ThisFormSet.frmRouter.Router_Init(pWhat,pType,biID)
		CASE pType = "SOitem"
			ThisFormSet.frmRouter.Router_Init(pWhat,pType,biID )
		CASE pType = "POitem"
			ThisFormSet.frmRouter.Router_Init(pWhat,pType,biID )
		CASE pType = "WorkOrder"
			ThisFormSet.frmRouter.Router_Init(pWhat,pType,biID )
		CASE pType = "WO_Detail"
			ThisFormSet.frmRouter.Router_Init(pWhat,pType,biID )
		CASE pType = "QUOTE"
			ThisFormSet.frmRouter.Router_Init(pWhat,pType,biID )
			
		CASE pType = "ALL"
			ThisFormSet.frmRouter.LoadRTR_Detail(0)
		OTHERWISE
		
			ThisFormSet.frmRouter.LoadRTR_Detail(0)
		ENDCASE
		
		
		
	ENDPROC

	PROCEDURE Load
		*Load
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_rtr ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE refresh_rtr		&& Refresh the screen RTR order numbers.
	ENDPROC

	PROCEDURE refresh_rtr_detail
	ENDPROC

	PROCEDURE Unload
		IF ThisFormSet.nConnhandle > 0
			= SQLDISCONNECT(ThisFormSet.nConnhandle)
		ENDIF
	ENDPROC

