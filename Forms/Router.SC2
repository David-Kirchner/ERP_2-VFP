	PROCEDURE Destroy
		
		IF "ROUTER" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\ROUTER"
		ENDIF
		IF "ROUTERDETAILORDER" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\ROUTERDETAILORDER"
		ENDIF
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE detail_oper_refresh
		*ThisFormSet.Detail_Oper_Refresh()
		
		IF USED('tmpRTR_Detail')
			ThisFormSet.frmRtrDetail.lblDetail.Visible		= .T.
			ThisFormSet.frmRtrDetail.lblOperation.Visible	= .T.
			ThisFormSet.frmRtrDetail.lblOper_ID.Visible		= .T.
			
			ThisFormSet.frmRtrDetail.txtDetail.Visible		= .T.
			ThisFormSet.frmRtrDetail.txtOperation.Visible	= .T.
			ThisFormSet.frmRtrDetail.txtOper_ID.Visible		= .T.
			
			ThisFormSet.frmRtrDetail.txtDetail.Value	= ""
			ThisFormSet.frmRtrDetail.txtOperation.Value	= ""
			ThisFormSet.frmRtrDetail.txtOper_ID.Value	= ""
			
		ELSE
			ThisFormSet.frmRtrDetail.lblDetail.Visible		= .F.
			ThisFormSet.frmRtrDetail.lblOperation.Visible	= .F.
			ThisFormSet.frmRtrDetail.lblOper_ID.Visible		= .F.
			
			ThisFormSet.frmRtrDetail.txtDetail.Visible		= .F.
			ThisFormSet.frmRtrDetail.txtOperation.Visible	= .F.
			ThisFormSet.frmRtrDetail.txtOper_ID.Visible		= .F.
			
			ThisFormSet.frmRtrDetail.txtDetail.Value	= ""
			ThisFormSet.frmRtrDetail.txtOperation.Value	= ""
			ThisFormSet.frmRtrDetail.txtOper_ID.Value	= ""
		
		ENDIF
	ENDPROC

	PROCEDURE detail_refresh		&& Detail_Refresh
		*ThisFormSet.Detail_Refresh()
		IF USED('tmpRTR_Detail')
			ThisFormSet.frmRtrDetail.grd_Details.RecordSource = ''
			USE IN tmpRTR_Detail
		ENDIF
		
		PRIVATE lchk100,lchk150,lchk200,lchk300,lchk400,lchk500,lchk600,lchk700,lchk750,lchk800,lchk900
		lchk100 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'100')
		lchk150 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk150.Value,'150')
		lchk200 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'200')
		lchk300 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'300')
		lchk400 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'400')
		lchk500 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'500')
		lchk600 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'600')
		lchk700 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'700')
		lchk750 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'750')
		lchk800 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'800')
		lchk900 = PrepareSQLlogic(ThisFormSet.frmRtrDetail.chk100.Value,'900')
		
		
		IF lchk100 OR lchk150 OR lchk200 OR lchk300 OR lchk400 OR lchk500 OR lchk600 OR lchk700 OR lchk750 OR lchk800 OR lchk900
			*Something is selected.
			PRIVATE cSQL, nSQLEXEC 
			cSQL = ''
			
			IF lchk100
				cSQL = "SELECT 100 AS [Detail], 'Select Material     ' AS [Operation], 523 AS [Oper_ID]"
			ENDIF
			IF lchk150
				IF LEN(cSQL) = 0
					cSQL = "SELECT 150 AS [Detail], 'Pull Material     ' AS [Operation], 522 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 150 AS [Detail], 'Pull Material     ' AS [Operation], 522 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk200
				IF LEN(cSQL) = 0
					cSQL = "SELECT 200 AS [Detail], 'PO Conversion     ' AS [Operation], 0 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 200 AS [Detail], 'PO Conversion     ' AS [Operation], 0 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk300
				IF LEN(cSQL) = 0
					cSQL = "SELECT 300 AS [Detail], 'Radial Forge ' AS [Operation], 525 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 300 AS [Detail], 'Radial Forge ' AS [Operation], 525 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk400
				IF LEN(cSQL) = 0
					cSQL = "SELECT 400 AS [Detail], 'Modify Stock' AS [Operation], 0 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 400 AS [Detail], 'Modify Stock' AS [Operation], 0 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk500
				IF LEN(cSQL) = 0
					cSQL = "SELECT 500 AS [Detail], 'Machining  ' AS [Operation], 0 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 500 AS [Detail], 'Machining  ' AS [Operation], 0 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk600
				IF LEN(cSQL) = 0
					cSQL = "SELECT 600 AS [Detail], 'Testing ' AS [Operation], 506 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 600 AS [Detail], 'Testing ' AS [Operation], 506 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk700
				IF LEN(cSQL) = 0
					cSQL = "SELECT 700 AS [Detail], 'Straighten and CG ' AS [Operation], 520 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 700 AS [Detail], 'Straighten and CG ' AS [Operation], 520 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk750
				IF LEN(cSQL) = 0
					cSQL = "SELECT 750 AS [Detail], 'Cut ends Square ' AS [Operation], 521 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 750 AS [Detail], 'Cut ends Square ' AS [Operation], 521 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk800
				IF LEN(cSQL) = 0
					cSQL = "SELECT 800 AS [Detail], 'Packaging ' AS [Operation], 501 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 800 AS [Detail], 'Packaging ' AS [Operation], 501 AS [Oper_ID]"
				ENDIF
			ENDIF
			IF lchk900
				IF LEN(cSQL) = 0
					cSQL = "SELECT 900 AS [Detail], 'Inspection \ Receive ' AS [Operation], 503 AS [Oper_ID]"
				ELSE
					cSQL = cSQL + ", 900 AS [Detail], 'Inspection \ Receive ' AS [Operation], 503 AS [Oper_ID]"
				ENDIF
			ENDIF
		
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRTR_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpRTR_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTR_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTR_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRTR_Detail')
			ELSE
				IF USED('tmpRTR_Detail')
					IF RECCOUNT('tmpRTR_Detail') > 0
						ThisFormSet.frmRtrDetail.grd_Details.RecordSource = 'tmpRTR_Detail'
						ThisFormSet.frmRtrDetail.grd_Details.Visible = .T.
						
						ThisFormSet.Detail_Oper_Refresh()
					ENDIF
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

