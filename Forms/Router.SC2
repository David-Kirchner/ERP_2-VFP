	PROCEDURE frmRouter.cmdReOrderDetail.Click
		
		PRIVATE biRTR_ID
		biRTR_ID = PrepareSQLnum(ThisForm.txtID.Value,'rtr_ID',-4)
		IF biRTR_ID > 0
			ThisForm.Visible = .F.
			ThisFormSet.frmRtrDetail.Visible = .T.
		
			ThisFormSet.frmRtrDetail.Top = ThisForm.Top
			ThisFormSet.frmRtrDetail.Left = ThisForm.Left
		
			ThisFormSet.frmRtrDetail.Load_rtr(biRTR_ID)
		ELSE
		
		ENDIF
		
	ENDPROC

	PROCEDURE frmRouter.shprtr_Operation.DblClick
		DO FORM "c:\program files (x86)\hpa\forms\rtr_operation.scx"
	ENDPROC

	PROCEDURE frmRtrDetail.cmdReturn.Click
		
		*DODEFAULT()
		*ThisFormSet.Release
		
		ThisForm.Visible = .F.
		ThisFormSet.frmRouter.Visible = .T.
	ENDPROC

ENDDEFINE
