	PROCEDURE findheat
		PARAMETERS pHeat
		
		
		IF TYPE("pHeat") = "C"
			IF NOT EMPTY( ALLTRIM( pHeat ))	
				ThisForm.grdStockLst.RecordSource = ""
				
				PRIVATE lFoundCurrent 
				lFoundCurrent = .F.
				
				PRIVATE cHeat
				cHeat = ALLTRIM( pHeat )
				
				PRIVATE cSQL,nSQLEXEC
				
		*		cSQL = "SELECT 'T' as [Current], ' ' as [WHO], ' ' as [WHAT], GetDate() as [WHEN], *, 0 as [ID_History] FROM dbo.StockLst_Master "
		*		cSQL = cSQL + " WHERE HEAT LIKE '%" + cHeat + "%'"
		*		cSQL = cSQL + " UNION SELECT 'F' as [Current], * FROM dbo.Ar_Stocklst_Master_History"
		*		cSQL = cSQL + " WHERE HEAT LIKE '%" + cHeat + "%'"
				*cSQL = cSQL = " AND [WHAT] = 'DELETE'"
		*		cSQL = cSQL + " ORDER BY Alloy,Form,cc,Size,Heat,[Current],[What] "
		
				cSQL = "SELECT *,TBL = 'S' FROM dbo.StockLst_Master_union WHERE HEAT LIKE '%" + cHeat + "%'"
				cSQL = cSQL + " ORDER BY id, alloy, form, cc, size, heat, What"
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF
				
				***************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your heat was not found"+CHR(13)+"Do you want to search "+CHR(13)+"History?",4+32,"Your heat was not found")
					IF nMess = 6
						cSQL = "SELECT *,TBL = 'S' FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) "
						cSQL = cSQL + " WHERE HEAT LIKE '%" + cHeat + "%'"
						cSQL = cSQL + " AND What = 'DELETE' "
						cSQL = cSQL + " ORDER BY id, alloy, form, cc, size, heat, What"
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
				***************
				***************
				
				IF lFoundCurrent 
					SELECT tStockLst_SQL	
					ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
					ThisForm.grdStockLst.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE findpo_item
		PARAMETERS pPO_item
		
		PRIVATE nItem
		
		IF Proper_PO_Item(pPO_item) = Proper_PO_Item('')
			*empty
			MESSAGEBOX("Not a proper PO item",0,"Cannot find")
			RETURN .F.
		ENDIF
		PRIVATE nHPAPO, nItem, cPOitem
		nHPAPO	= Proper_PO_Item_PO(pPO_item)
		nItem	= Proper_PO_Item_Item(pPO_item)
		cPOitem = Proper_PO_Item(pPO_item) 
		
		IF nHPAPO = 0
			*empty
			MESSAGEBOX("Not a proper PO item",0,"Cannot find")
			RETURN .F.
		ENDIF
		PRIVATE cNewPOitem
		IF nItem = 0
			DO FORM Forms\ChoosePOitem WITH nHPAPO TO cNewPOitem
			cPOitem	= Proper_PO_Item(cNewPOitem)	
		ENDIF
		
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
			*empty
			MESSAGEBOX("Not a proper PO item",0,"Cannot find")
			RETURN .F.
		ENDIF
		
		
		PRIVATE lFoundCurrent 
		lFoundCurrent = .F.
		
		ThisForm.txtText.Value = cPOitem
		
		ThisForm.grdStockLst.RecordSource = ""
				
		PRIVATE cSQL,nSQLEXEC
		
		cSQL = "SELECT *,TBL = 'S' FROM dbo.StockLst_Master_Union WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ID IN ( "
		cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.StockLst_Detail_Union WITH(NOLOCK) WHERE ID_Detail IN ("
		cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.Ar_StockLst_Process_History PH WITH(NOLOCK) "
		cSQL = cSQL + " WHERE PH.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
		
		IF USED("tStockLst_SQL")
			USE IN tStockLst_SQL
		ENDIF
		
		SELECT 0
		WAIT WINDOW "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union " NOWAIT
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
		ELSE
			IF RECCOUNT('tStockLst_SQL') > 0
				lFoundCurrent = .T.
			ENDIF
		ENDIF
		***************
		***************
		IF NOT lFoundCurrent 
			PRIVATE nMess
			nMess = MESSAGEBOX("Your PO item was not found"+CHR(13)+"Do you want to search "+CHR(13)+"Broker?",4+32,"Your PO item was not found")
			IF nMess = 6
				cSQL = "SELECT *,TBL = 'B' FROM dbo.BrokerLst_Master_Union WITH(NOLOCK) "
				cSQL = cSQL + " WHERE ID IN ( "
				cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.BrokerLst_Detail WITH(NOLOCK) WHERE ID_Detail IN ("
				cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.Ar_BrokerLst_Process_History PH WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PH.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
				
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				*WAIT WINDOW "SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF		
			ENDIF
		ENDIF
		***************
		***************
		IF NOT lFoundCurrent 
			PRIVATE nMess
			nMess = MESSAGEBOX("Your PO item was not found"+CHR(13)+"Do you want to search again in "+CHR(13)+"History?",4+32,"Your PO item was not found")
			IF nMess = 6
				cSQL = "SELECT *,TBL = 'S' FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + " AND What = 'DELETE' "
				
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT *,TBL = 'B' FROM dbo.Ar_BrokerLst_Master_history WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + " AND What = 'DELETE' "
				
				cSQL = cSQL + " ORDER BY id, alloy, form, cc, size, heat, What"
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				*WAIT WINDOW "SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF		
			ENDIF
		ENDIF
		***************
		***************
		
		
		IF lFoundCurrent 
			SELECT tStockLst_SQL	
			LOCATE FOR PO_item = ThisForm.txtText.Value
			ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
			ThisForm.grdStockLst.Refresh
		ENDIF
			
		
		
	ENDPROC

	PROCEDURE findsoitem
		PARAMETERS pSOitem
		
		PRIVATE nItem
		
		IF TYPE("pSOitem") = "N"
			pSOitem = STR(pSOitem)
		ENDIF
		
		IF TYPE("pSOitem") = "C"
			IF NOT EMPTY( ALLTRIM( pSOitem))	
				IF AT("-",pSOitem) = 0
					pSOitem = ALLTRIM(pSOitem)+"-01"
					*MESSAGEBOX("No Item entered"+CHR(13)+"You must enter the Item after the salesNumber"+"Item has been defaulted to 1",0+64,"Item defaulted to 1")
					WAIT WINDOW "No 'Item Number' entered, You should enter the Item after the SalesNumber, Item has been defaulted to 01" TIMEOUT 2
				ENDIF
		
				PRIVATE lFoundCurrent 
				lFoundCurrent = .F.
		
				pSOitem = Proper_SO_Item(pSOitem)
				
				ThisForm.txtText.Value = pSOitem
			
				ThisForm.grdStockLst.RecordSource = ""
				
				PRIVATE cSOItem
				cSOItem = pSOitem
				
				PRIVATE cSQL,nSQLEXEC
		
				cSQL = "SELECT *,TBL = 'S' FROM dbo.StockLst_Master_Union M WITH(NOLOCK) "
				cSQL = cSQL + " WHERE ID IN ( "
				cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ID_Detail IN ("
				cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.Ar_StockLst_Process_History PH WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PH.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				cSQL = cSQL + " )) ORDER BY M.id, M.alloy, M.form, M.cc, M.size, M.heat, M.What"
				
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				WAIT WINDOW "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union " NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF
				
				***************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your SOitem was not found"+CHR(13)+"Do you want to search "+CHR(13)+"Broker?",4+32,"Your SO item was not found")
					IF nMess = 6
						cSQL = "SELECT *,TBL = 'B' FROM dbo.BrokerLst_Master_Union WITH(NOLOCK) "
						cSQL = cSQL + " WHERE ID IN ( "
						cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.BrokerLst_Detail WITH(NOLOCK) WHERE ID_Detail IN ("
						cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.Ar_BrokerLst_Process_History PH WITH(NOLOCK) "
						cSQL = cSQL + " WHERE PH.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
						
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						*WAIT WINDOW "SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
				
				**************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your SOitem was not found"+CHR(13)+"Do you want to search again in "+CHR(13)+"History?",4+32,"Your SO item was not found")
					IF nMess = 6
						cSQL = "SELECT *,TBL = 'S' FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.Ar_StockLst_Process_History P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						cSQL = cSQL + " AND M.What = 'DELETE' "
						cSQL = cSQL + " AND D.What = 'DELETE' "
						cSQL = cSQL + " AND P.What = 'DELETE' "
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + " SELECT *,TBL = 'B' FROM dbo.Ar_BrokerLst_Master_history M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.Ar_BrokerLst_Detail_History D WITH(NOLOCK) ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.Ar_BrokerLst_Process_History P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						cSQL = cSQL + " AND M.What = 'DELETE' "
						cSQL = cSQL + " AND D.What = 'DELETE' "
						cSQL = cSQL + " AND P.What = 'DELETE' "
		
						cSQL = cSQL + " ORDER BY M.id, M.alloy, M.form, M.cc, M.size, M.heat, M.What"
						
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						*WAIT WINDOW "SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
				***************
				***************
								
				IF lFoundCurrent 
					SELECT tStockLst_SQL	
					ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
					ThisForm.grdStockLst.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE findworkorder
		PARAMETERS pWO
		
		IF TYPE("pWO") = "C"
			pWO = VAL(pWO)
		ENDIF
		
		IF TYPE("pWO") = "N"
			IF pWO > 0
			
				PRIVATE lFoundCurrent 
				lFoundCurrent = .F.
		
				ThisForm.txtText.Value = pWO
			
				ThisForm.grdStockLst.RecordSource = ""
				
				PRIVATE cSQL,nSQLEXEC
				
				cSQL = "SELECT *,TBL = 'S' FROM dbo.StockLst_Master_Union WITH(NOLOCK) "
				cSQL = cSQL + " WHERE ID IN ( "
				cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.StockLst_Detail_Union WITH(NOLOCK) WHERE ID_Detail IN ("
				cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.Ar_StockLst_Process_History PH WITH(NOLOCK)  "
		
				cSQL = cSQL + " WHERE PH.WO = "+STR(pWO)
				cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
				
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF
				
				***************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your WO was not found"+CHR(13)+"Do you want to search "+CHR(13)+"Broker?",4+32,"Your Work Order was not found")
					IF nMess = 6
						cSQL = "SELECT *,TBL = 'B' FROM dbo.BrokerLst_Master_Union WITH(NOLOCK) "
						cSQL = cSQL + " WHERE ID IN ( "
						cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.BrokerLst_Detail WITH(NOLOCK) WHERE ID_Detail IN ("
						cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.Ar_BrokerLst_Process_History PH WITH(NOLOCK) "
		
						cSQL = cSQL + " WHERE PH.WO = "+STR(pWO)
						cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
		
		
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						*WAIT WINDOW "SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
				***************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your WO was not found"+CHR(13)+"Do you want to search again in "+CHR(13)+"History?",4+32,"Your Work Order was not found")
					IF nMess = 6
						cSQL = "SELECT *,TBL = 'S' FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.Ar_StockLst_Process_History P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE P.WO = "+STR(pWO)
						cSQL = cSQL + " AND M.What = 'DELETE' "
						cSQL = cSQL + " AND D.What = 'DELETE' "
						cSQL = cSQL + " AND P.What = 'DELETE' "
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + " SELECT *,TBL = 'B' FROM dbo.Ar_BrokerLst_Master_history M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.Ar_BrokerLst_Detail_History D WITH(NOLOCK) ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.Ar_BrokerLst_Process_History P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE P.WO = "+STR(pWO)
						cSQL = cSQL + " AND M.What = 'DELETE' "
						cSQL = cSQL + " AND D.What = 'DELETE' "
						cSQL = cSQL + " AND P.What = 'DELETE' "
						
						cSQL = cSQL + " ORDER BY M.id, M.alloy, M.form, M.cc, M.size, M.heat, M.What"
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						*WAIT WINDOW "SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
		
				***************
				***************
						
				IF lFoundCurrent 
					SELECT tStockLst_SQL	
					ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
					ThisForm.grdStockLst.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE findwo_detail
		PARAMETERS pWO_Detail
		
		IF TYPE("pWO_Detail") = "C"
			pWO_Detail = VAL(pWO_Detail)
		ENDIF
		
		IF TYPE("pWO_Detail") = "N"
			IF pWO_Detail > 0
				PRIVATE lFoundCurrent 
