	PROCEDURE COMPANY1.InteractiveChange
		IF ThisForm.AutoFQuotes
		
			PRIVATE lSearchFound
			lSearchFound = .F.
		
			PRIVATE lnInsertionPt, lcSearchStr, lcSearchStrSQL
			lnInsertionPt = IIF(this.SelStart=0,30,this.SelStart)
			lcSearchStr = substr(this.value,1,lnInsertionPt)
			*lcSearchStrSQL = PrepareSQLtxt(lcSearchStr,'Company',30)
			lcSearchStrSQL = STRTRAN(lcSearchStr,"'","''")
		
			IF !empty(lcSearchStr)
				IF USED('tmpQcompany')
					USE IN tmpQcompany
				ENDIF
				
				PRIVATE nConn
				nConn = get_SQLSTRINGCONNECT()
				
				IF NOT EMPTY(lcName)
					*Find Name and Company
					cSQL = "SELECT company "
					cSQL = cSQL + " FROM dbo.QuickCompany WHERE Company LIKE '"+lcSearchStrSQL+"%'"  &&Do not TRIM!
		
					SELECT 0
					nSQLEXEC = SQLEXEC(nConn , cSQL, 'tmpQcompany' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpQcompany' )
					ENDDO
					IF nSQLEXEC < 0  &&Try again. Problem query.
						nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpQcompany' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpQcompany' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(nConn , cSQL, "tmpQcompany")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(nConn , cSQL, "tmpQcompany")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError(cSQL, nConn , nSQLEXEC, 'tmpQcompany')
					ENDIF
					IF USED('tmpQcompany')
						IF VARTYPE( tmpQcompany.Company ) = "C"
							IF NOT EMPTY(tmpQcompany.Company)
								this.VALUE = tmpQcompany.company			
								=insmode(.f.)
							ENDIF
						ENDIF
					ENDIF		
				ENDIF
				
				SQLDISCONNECT(nConn)
				
			ENDIF
		
			this.selstart = lnInsertionPt
		ENDIF
		
		*!*	**************************
		*!*	IF ThisForm.AutoFQuotes
		*!*		lnInsertionPt = this.SelStart
		*!*		lcSearchStr = substr(this.value,1,lnInsertionPt)
		*!*		IF !empty(lcSearchStr)
		*!*			=seek(upper(lcSearchStr),"QuotesID","UPPComp")
		*!*			IF found("QuotesID")
		*!*				this.VALUE=QuotesID.Company
		*!*			ELSE
		*!*				**No replacement for Name
		*!*				this.value=lcSearchStr
		*!*			ENDIF
		*!*		ELSE
		*!*			this.value=space(0)
		*!*		ENDIF
		*!*		this.selstart = lnInsertionPt
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE COMPANY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE COMPANY1.Valid
		ThisForm.fCompany = This.Value
	ENDPROC

	PROCEDURE OPEN1.When
		ThisForm.fOpen = This.Value
	ENDPROC

	PROCEDURE PO_NUM1.When
		ThisForm.fPO_Num = This.Value
	ENDPROC

	PROCEDURE SALESNUM1.When
