		ThisForm.cmdPO.Enabled = .F.
		ThisForm.cmdOpen.Enabled = .F.
		ThisForm.cmdCancel.Enabled = .T.
	ENDPROC

	PROCEDURE cmdfAlloy.Click
		Private fAlloy, fForm
		fAlloy = UPPER(ThisForm.fAlloy)
		
		DO CASE
			CASE ThisForm.gForm= 0
				fForm = ""
			CASE ThisForm.gForm= 1
				fForm = " AND Form = '10'"
			CASE ThisForm.gForm= 2
				fForm = " AND Form = '20'"
			CASE ThisForm.gForm= 3
				fForm = " AND Form = '30'"
			CASE ThisForm.gForm= 4
				fForm = " AND Form = '40'"
			CASE ThisForm.gForm = 5
				fForm = " AND Form = '60'"
			CASE ThisForm.gForm = 6
				fForm = " AND Form = '65'"
			CASE ThisForm.gForm = 7
				fForm = " AND Form = '70'"
			CASE ThisForm.gForm = 8
				fForm = " AND Form = '80'"
		ENDCASE
		
		SELECT Quotes
		*SET ORDER TO TAG uppAlloy
		LOCATE FOR UPPER(Alloy) = fAlloy &fForm
		IF FOUND()
			ACTIVATE WINDOW Qfind
			BROW FOR UPPER(Alloy) = fAlloy &fForm IN WINDOW Qfind
			DEACTIVATE WINDOW Qfind
		ELSE
			LOCATE FOR UPPER(LEFT(Alloy,6)) = LEFT(fAlloy,6) &fForm 
			IF FOUND()
				ACTIVATE WINDOW Qfind
				BROW FOR UPPER(LEFT(Alloy,6)) = LEFT(fAlloy,6) &fForm IN WINDOW Qfind
				DEACTIVATE WINDOW Qfind
			ELSE
				LOCATE FOR UPPER(LEFT(alloy,4)) = LEFT(fAlloy,4) &fForm 
				IF FOUND()
					ACTIVATE WINDOW Qfind
					BROW FOR UPPER(LEFT(Alloy,4)) = LEFT(fAlloy,4) &fForm IN WINDOW Qfind
					DEACTIVATE WINDOW Qfind
				ELSE
					WAIT WINDOW 'Not Found!' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		This.Enabled = .f.
		thisform.Alloy1.Enabled = .F.
		thisform.cmdShowForm.Enabled = .F.
		ThisForm.cmdAlloy.Enabled = .T.
		ThisForm.cmdcompany.Enabled = .T.
		ThisForm.cmdSO.Enabled = .T.
		ThisForm.cmdPO.Enabled = .T.
		ThisForm.cmdOpen.Enabled = .T.
	ENDPROC

	PROCEDURE cmdFcompany.Click
		PRIVATE fCompany,exactset
		fCompany = UPPER(ThisForm.fCompany)
		exactset = SET('EXACT')
			
		SELECT Quotes
		*SET ORDER TO TAG uppComp
		LOCATE FOR UPPER(company) = fCompany
		IF FOUND()
			Activate WINDOW Qfind
			BROW FOR UPPER(company) = fCompany IN WINDOW Qfind
			Deactivate WINDOW Qfind
		ELSE
			SET EXACT OFF
			LOCATE FOR UPPER(company) = fCompany
			IF FOUND()
				Activate WINDOW Qfind
				BROW FOR UPPER(company) = fCompany IN WINDOW Qfind
				Deactivate WINDOW Qfind
			ELSE
		
				LOCATE FOR UPPER(LEFT(company,6)) = LEFT(fCompany,6)
				IF FOUND()
					Activate WINDOW Qfind
					BROW FOR UPPER(LEFT(company,6)) = LEFT(fCompany,6) IN WINDOW Qfind
					Deactivate WINDOW Qfind
				ELSE
					LOCATE FOR UPPER(LEFT(company,4)) = LEFT(fCompany,4)
					IF FOUND()
						Activate WINDOW Qfind
						BROW FOR UPPER(LEFT(company,4)) = LEFT(fCompany,4) IN WINDOW Qfind
						Deactivate WINDOW Qfind
					ELSE
						WAIT WINDOW 'Not Found!' NOWAIT
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		SET EXACT &exactSet
		this.Enabled = .f.
		thisform.company1.Enabled = .F.
		thisform.cmdcompany.Enabled = .T.
		thisform.cmdAlloy.Enabled = .T.
		
	ENDPROC

	PROCEDURE cmdfOpen.Click
		Private fOpen
		fOpen = ThisForm.fOpen
		SELECT Quotes
		SET ORDER TO TAG Open
		LOCATE FOR FOpen
			ACTIVATE WINDOW Qfind
			BROW FOR FOpen IN WINDOW Qfind
			DEACTIVATE WINDOW Qfind
		This.Enabled = .f.
		thisform.Open1.Enabled = .F.
		
		ThisForm.cmdcompany.Enabled = .T.
		ThisForm.cmdAlloy.Enabled = .T.
		ThisForm.cmdSO.Enabled = .T.
		ThisForm.cmdPO.Enabled = .T.
		ThisForm.cmdOpen.Enabled = .T.
	ENDPROC

	PROCEDURE cmdfPO.Click
		Private fPO_Num
		fPO_Num = UPPER(ThisForm.fPO_Num)
		SELECT Quotes
		SET ORDER TO 
		LOCATE FOR UPPER(PO_Num) = FPO_Num
		IF FOUND()
			ACTIVATE WINDOW Qfind
			BROW FOR UPPER(PO_Num) = FPO_Num IN WINDOW Qfind
			DEACTIVATE WINDOW Qfind
		ELSE
			LOCATE FOR UPPER(LEFT(PO_Num,6)) = LEFT(fPO_Num,6)
			IF FOUND()
				ACTIVATE WINDOW Qfind
				BROW FOR UPPER(LEFT(PO_Num,6)) = LEFT(FPO_Num,6) IN WINDOW Qfind
				DEACTIVATE WINDOW Qfind
			ELSE
				LOCATE FOR UPPER(LEFT(PO_Num,4)) = LEFT(FPO_Num,4)
				IF FOUND()
					ACTIVATE WINDOW Qfind
					BROW FOR UPPER(LEFT(PO_Num,4)) = LEFT(FPO_Num,4) IN WINDOW Qfind
					DEACTIVATE WINDOW Qfind
				ELSE
					WAIT WINDOW 'Not Found!' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		This.Enabled = .f.
		thisform.PO_Num1.Enabled = .F.
		
		ThisForm.cmdcompany.Enabled = .T.
		ThisForm.cmdAlloy.Enabled = .T.
		ThisForm.cmdSO.Enabled = .T.
		ThisForm.cmdPO.Enabled = .T.
		ThisForm.cmdOpen.Enabled = .T.
	ENDPROC

	PROCEDURE cmdfSO.Click
		Private fSalesnum
		fSalesnum = ThisForm.fSalesnum
		SELECT Quotes
		SET ORDER TO TAG Salesnum
		LOCATE FOR Salesnum = FSalesnum
		IF NOT FOUND()
			Wait WINDOW 'Did not find the EXACT number!' NOWAIT
		ENDIF
			ACTIVATE WINDOW Qfind
			BROW IN WINDOW Qfind
			DEACTIVATE WINDOW Qfind
		This.Enabled = .f.
		thisform.Salesnum1.Enabled = .F.
		
		ThisForm.cmdcompany.Enabled = .T.
		ThisForm.cmdAlloy.Enabled = .T.
		ThisForm.cmdSO.Enabled = .T.
		ThisForm.cmdPO.Enabled = .T.
		ThisForm.cmdOpen.Enabled = .T.
	ENDPROC

