	PROCEDURE Init
		DEFINE WINDOW QFind FROM 14,2 TO 30,75 NAME Qfind in FINDQUOTES DOUBLE FLOAT GROW ZOOM
		
		
	ENDPROC

	PROCEDURE Load
		PRIVATE curDBF, curTBL, curREC
		
		ThisForm.curDBF = DBC()
		THISForm.curTBL = ALIAS()
		IF USED('Quotes')
			SELECT Quotes
		ELSE
			USE Quotes!Quotes IN 0
		ENDIF
		THISForm.curREC = RECNO()
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF NOT EMPTY(ThisForm.curDBF)
			SET DATABASE TO (ThisForm.curDBF)
		ENDIF
		
		IF NOT EMPTY(ThisForm.curDBF)
			IF USED(ThisForm.curTBL)
				SELECT (ThisForm.curTBL)
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE ALLOY1.Click
		ThisForm.fAlloy = This.Value
		
		
	ENDPROC

	PROCEDURE ALLOY1.InteractiveChange
		IF ThisForm.AutoFQuotes
				
			PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
			lnInsertionPt = THIS.SELSTART
			lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
			lcTryAlloy  = ''
		
			IF !EMPTY(lcSearchStr)
				lcTryAlloy = SearchAlloyStandard(lcSearchStr, .F. )
				IF NOT EMPTY(lcTryAlloy)		
					IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
						THIS.VALUE=lcTryAlloy
						THIS.FORECOLOR = RGB(0,0,0)
					ELSE
						THIS.VALUE=lcSearchStr
						THIS.FORECOLOR = RGB(255,0,0)
					ENDIF
				ELSE
			*		*No replacement
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
				THIS.VALUE=SPACE(0)
			ENDIF
			THIS.SELSTART = lnInsertionPt
		ENDIF
		
	ENDPROC

	PROCEDURE ALLOY1.LostFocus
		=insmode(.T.)
		ThisForm.cmdShowForm.enabled = .T.
	ENDPROC

	PROCEDURE ALLOY1.Valid
		IF ThisForm.AutoFQuotes
			thisform.fAlloy = This.Value
			
			PRIVATE pCurAlloy,cAlloyStandard
			pCurAlloy= ALLTRIM(This.Value)
		
			IF NOT EMPTY(pcuralloy)
				cAlloyStandard = GetAlloyStandard( pCurAlloy, .F. )
				
				IF NOT EMPTY(cAlloyStandard)
					This.Value = cAlloyStandard
					thisform.fAlloy = cAlloyStandard
					THIS.FORECOLOR = RGB(0,0,0)
					RETURN .T.
				ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
				ENDIF
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdAlloy.Click
		ThisForm.fAlloy = Quotes.Alloy
		thisform.Alloy1.Enabled = .T.
		thisform.Alloy1.refresh
		thisform.cmdfAlloy.Enabled = .T.
		This.Enabled = .f.
		thisform.cmdCompany.Enabled = .F.
		ThisForm.cmdSO.Enabled = .F.
		ThisForm.cmdPO.Enabled = .F.
		ThisForm.cmdOpen.Enabled = .F.
		ThisForm.cmdCancel.Enabled = .T.
	ENDPROC

	PROCEDURE cmdAutoFQuotes.Click
		IF ThisForm.AutoFQuotes
			This.Picture = "graphics\strikthr.bmp"
			ThisForm.AutoFQuotes= !ThisForm.AutoFQuotes
		ELSE
			This.Picture = "graphics\spell.bmp"
			ThisForm.AutoFQuotes= !ThisForm.AutoFQuotes
		ENDIF
	ENDPROC

