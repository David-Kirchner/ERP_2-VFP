	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pPOitem
		*DO FORM Forms\ShowPO WITH POitem
		*DO FORM Forms\ShowPO WITH '    19386-01'
		PRIVATE nHPAPO, nItem, lHavePOitem
		lHavePOitem = .F.
		*PUBLIC gcPOItem
		PRIVATE cPOitem
		
		cPOItem = SPACE(10)
		nHPAPO = 0
		
		ThisForm.PrevTable = ALIAS()
		
		IF TYPE('pPOitem') = "C"
			nHPAPO	= Proper_PO( pPOitem )
			nItem	= VAL(RIGHT(pPOitem,2))
			cPOItem = Proper_PO_Item( pPOitem )&&STR(nHPApo)+"-"+ STR(nItem,2,0) )
			lHavePOitem = .T.
		ENDIF
		IF TYPE('pPOitem') = "N"  && Atually PO Number
			nHPAPO	= pPOitem
			nItem	= 1
			cPOItem	= Proper_PO_Item(STR(nHPAPo)+"-01")
		ENDIF
		
		*SELECT POitem,HPAPO,ItemPO,SOitem,SalesNum,Item,SalesP,Company,Alloy,Form,Pieces,Thck,Sz2,Sz3,P_LB,P_PC,P_FT
		*,LOTP,OherP,OtherFld,Order_Qty,OrderDate,Due_Min,Due_Max,Received,Cond_Spec,Misc_Purch 
		*FROM HPA!PurchaseOrder WHERE  INTO ARRAY aSPO
		*SEEK cPOItem ORDER POItem IN PurchaseOrder
		
		
		
		PUBLIC ARRAY gaPoItems(1)
		IF nHPAPO = 0
		*	SELECT PoItem FROM HPA!PurchaseOrder INTO ARRAY gaPoItems ORDER BY PoItem 
			cSQL = "SELECT TOP 200 PoItem FROM dbo.PurchaseOrder ORDER BY HPAPO DESC"
		ELSE
		*	SELECT PoItem FROM HPA!PurchaseOrder WHERE HPAPO = nHPAPO INTO ARRAY gaPoItems ORDER BY PoItem 
			cSQL = "SELECT PoItem FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOItems')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOItems' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOItems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceive")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOItems' )
		ENDIF
		
		SELECT PoItem FROM tmpPOItems INTO ARRAY gaPoItems ORDER BY PoItem 
		
		ThisForm.lstPoItems.Value = tmpPOItems.Poitem
		
		IF lHavePOitem
			ThisForm.lstPoItems.Value = cPOitem
		ENDIF
		
		Thisform.ShowPOitem()
		
		ThisForm.lstPoItems.SetFocus
		
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE showduenotes
		*ThisForm.ShowDueNotes
		IF NOT USED('tPurchaseOrder')
			RETURN
		ENDIF
		
		*********************************
		PRIVATE 	dDue_Min,dDue_Max,dHPA_Due_Min,dHPA_Due_Max, dReceived, dOrderDate
		
		dDue_Min		= PrepareSQLdate(tPurchaseOrder.Due_Min,'Due_Min',.F.,.T.)
		dDue_Max		= PrepareSQLdate(tPurchaseOrder.Due_Max,'Due_Max',.F.,.T.)
		dHPA_Due_Min	= PrepareSQLdate(tPurchaseOrder.HPA_Due_Min,'HPA_Due_Min',.F.,.T.)
		dHPA_Due_Max	= PrepareSQLdate(tPurchaseOrder.HPA_Due_Max,'HPA_Due_Max',.F.,.T.)
		
		dReceived		= PrepareSQLdate(tPurchaseOrder.Received,'Received',.F.,.T.)
		dOrderDate		= PrepareSQLdate(tPurchaseOrder.OrderDate,'OrderDate',.F.,.T.)	
		
		PRIVATE dHPA_Date_Update 
		dHPA_Date_Update = CTOD('')
		
		IF NOT EMPTY(dReceived)
			dHPA_Date_Update = dReceived
		ELSE
			IF NOT EMPTY(dHPA_Due_Max)
				dHPA_Date_Update = dHPA_Due_Max
			ELSE
				IF NOT EMPTY(dHPA_Due_Min)
					dHPA_Date_Update = dHPA_Due_Min
				ELSE
					IF NOT EMPTY(dDue_Max)
						dHPA_Date_Update = dDue_Max
					ELSE
						IF NOT EMPTY(dHPA_Due_Min)
							dHPA_Date_Update = dDue_Min
						ELSE
							IF NOT EMPTY(dOrderDate)
								dHPA_Date_Update = dOrderDate
							ELSE
								dHPA_Date_Update = CTOD('')
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		IF NOT EMPTY(dHPA_Date_Update )
			ThisForm.txtHPA_Due_Max.Value = dHPA_Date_Update 
		ELSE
			ThisForm.txtHPA_Due_Max.Value = DATE()
		ENDIF
		
		****************************************
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.lstPoItems.Value,'POitem',12)
		
		PRIVATE cProcessNotes
		cProcessNotes = ""
				
		IF USED('tmpProcessNotes')
			USE IN tmpProcessNotes
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Notes FROM dbo.PO_ProcessNotes "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessNotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpProcessNotes' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessNotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessNotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF  
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,'tmpProcessNotes')
		ELSE
			IF USED('tmpProcessNotes')
				IF RECCOUNT('tmpProcessNotes') > 0
					cProcessNotes = ShowSQLtxt(tmpProcessNotes.Notes,'Notes',-3)
				ENDIF
				USE IN tmpProcessNotes
			ENDIF
		ENDIF
		
		ThisForm.edtNotes.Value = cProcessNotes 
		
	ENDPROC

	PROCEDURE showpoitem
		*Thisform.ShowPoitem()
		**Thisform.SelectPoitem()
		
		PRIVATE cPoItem 
		cPoItem = ThisForm.lstPoItems.Value
		
		IF USED('tPurchaseOrder')
		*	USE IN tPurchaseOrder
			SELECT tPurchaseOrder
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tPurchaseOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tPurchaseOrder' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tPurchaseOrder")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tPurchaseOrder")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tPurchaseOrder' )
		ENDIF
		
		IF USED('tPurchaseOrder')
		
			SELECT tPurchaseOrder
			
			ThisForm.txtHpapo.Value	= tPurchaseOrder.HPApo
			ThisForm.txtItemPO.Value	= tPurchaseOrder.ItemPO
			ThisForm.txtCompany.Value	= tPurchaseOrder.Company
			ThisForm.txtSalesp.Value	= tPurchaseOrder.SalesP
			ThisForm.txtPieces.Value	= tPurchaseOrder.Pieces
			ThisForm.txtAlloy.Value	= tPurchaseOrder.Alloy
			ThisForm.cmbForm.Value	= tPurchaseOrder.Form
			ThisForm.txtThck.Value	= tPurchaseOrder.Thck
			ThisForm.txtSz2.Value	= tPurchaseOrder.Sz2
			ThisForm.txtSz3.Value	= tPurchaseOrder.Sz3
			ThisForm.txtCond_spec.Value	= tPurchaseOrder.Cond_Spec
			
			ThisForm.txtStockLst_QTY.Value	= tPurchaseOrder.StockLst_QTY
			ThisForm.txtStockLst_P.Value	= tPurchaseOrder.StockLst_P
			ThisForm.txtOrder_QTY.Value	= tPurchaseOrder.Order_QTY
			ThisForm.cmbOrder_PU.Value	= PrepareSQLnum(tPurchaseOrder.Order_PU,'Order_PU',-1)
			ThisForm.txtOrder_P.Value	= tPurchaseOrder.Order_P
			ThisForm.txtPounds.Value	= tPurchaseOrder.Pounds
			
			ThisForm.txtPOSalesP.Value	= tPurchaseOrder.POSalesP
			ThisForm.txtShipVia.Value	= tPurchaseOrder.ShipVia
			ThisForm.txtJobNumber.Value	= tPurchaseOrder.JobNumber
			ThisForm.txtOrderDate.Value	= tPurchaseOrder.OrderDate
			ThisForm.txtDue_min.Value	= tPurchaseOrder.Due_Min
			ThisForm.txtDue_max.Value	= tPurchaseOrder.Due_Max
			
			ThisForm.txtOtherp.Value	= tPurchaseOrder.OtherP
			ThisForm.txtOtherFld.Value	= tPurchaseOrder.OtherFld
			ThisForm.edtMisc_Purch.Value	= tPurchaseOrder.Misc_Purch
			
			ThisForm.chkDELIVEREDPO.Value	= tPurchaseOrder.DELIVERED
			ThisForm.chkCANCELPO.Value	= tPurchaseOrder.CANCELled
			ThisForm.chkSPS1.Value		= tPurchaseOrder.Sheet_PK
			ThisForm.chkSERVICESPO.Value	= tPurchaseOrder.Services
			ThisForm.chkCONVSERV.Value	= tPurchaseOrder.ConvServ
			ThisForm.chkEQUIPMENT.Value	= tPurchaseOrder.Equipment
			
			ThisForm.txtStock.Value	= tPurchaseOrder.Stock
			
			ThisForm.ShowReceiving(cPOItem)
			
		*	USE IN PurchaseOrder
		ELSE
			
		ENDIF
		
		
		ThisForm.ShowDueNotes()
		
	ENDPROC

	PROCEDURE showreceiving
		PARAMETERS cPOitem
		*ThisForm.ShowReceiving(cPOItem)
		
		IF USED('tmpReceive')
			SELECT tmpReceive
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT ID, Received FROM dbo.Receiving "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceive')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpReceive' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceive")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceive")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpReceive' )
		ENDIF
		
		ThisForm.lblReceived.Visible = .F.
		ThisForm.txtReceivingID.Visible = .F.
		ThisForm.txtReceived.Visible = .F.
		
		IF USED('tmpReceive')
			IF RECCOUNT('tmpReceive') > 0
				ThisForm.lblReceived.Visible = .T.
				ThisForm.txtReceivingID.Visible = .T.
				ThisForm.txtReceived.Visible = .T.
		
				ThisForm.txtReceivingID.Value	= tmpReceive.ID
				ThisForm.txtReceived.Value 		= tmpReceive.Received
				
				IF RECCOUNT('tmpReceive') > 1
					MESSAGEBOX("This POitem has more than 1 Receive record",0,"More records than shown")
				ENDIF
		
			ENDIF
			USE IN tmpReceive
		ENDIF
	ENDPROC

	PROCEDURE Unload
		*IF ThisForm.OpenedTable
			IF USED('tPurchaseOrder')
				USE IN tPurchaseOrder
			ENDIF
		*ENDIF
		
		IF USED('tmpPoitems')
			USE IN tmpPoitems
		ENDIF
		
		IF NOT EMPTY( ThisForm.PrevTable )
			IF USED( ThisForm.PrevTable )
				SELECT (ThisForm.PrevTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		IF WEXIST("frmStockLst_SQL_Browse")
			ACTIVATE WINDOW frmStockLst_SQL_Browse
		ENDIF
		IF WEXIST("frmStockLst_SQL_Quotes")
			ACTIVATE WINDOW frmStockLst_SQL_Quotes
		ENDIF
	ENDPROC

	PROCEDURE cmbForm.Valid
		*RowSource=10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
	ENDPROC

	PROCEDURE cmbOrder_PU.Init
		PRIVATE cSQL, nSQLEXEC
		IF USED('FormPU')
			SELECT FormPU
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL=" SELECT '0' AS PU, 'NA' AS Unit"
		cSQL=cSQL+" UNION "
		*cSQL=cSQL+" SELECT PU, Unit FROM dbo.PU "
		cSQL=cSQL+" SELECT CAST(PU AS CHAR(2)) AS PU, Unit FROM dbo.PU "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormPU')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormPU')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormPU")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormPU")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormPU')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormPU')
			SELECT * FROM FormPU INTO ARRAY aFormPU
			
			USE IN FormPU
			
		*	this.clear
			This.ColumnCount = 2
			This.NumberOfElements=ALEN(aFormPU,1)
			This.BoundColumn = 1
			This.ColumnWidths = "20,65"
		
			PRIVATE nArrayCount
			nArrayCount = ALEN(aFormPU,1)
			FOR I = 1 TO nArrayCount
				this.addListItem(aFormPU(I, 1),I,1)
				this.addListItem(aFormPU(I, 2),I,2)
			ENDFOR
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		
		PRIVATE cPOitem
		cPOitem = ThisForm.lstPoItems.Value
		
		DO FORM Forms\PODueDate WITH cPOitem
		
		Thisform.ShowPoitem()
		
		*!*	IF This.Caption = "Edit"
		*!*		IF NOT PrepareSQLlogic(ThisForm.chkDeliveredPO.Value,'Delivered',.F.)
		*!*			*Put in edit Mode
		*!*			ThisForm.edtNotes.ReadOnly = .F.
		*!*			ThisForm.txtHPA_Due_Max.Enabled = .T.
		*!*			This.Caption = "Save"
		*!*			ThisForm.cmdCancelEdit.Caption = "Cancel"
		*!*			ThisForm.cmdCancelEdit.Visible = .T.
		*!*		ELSE
		*!*			WAIT WINDOW "Already Delivered" NOWAIT
		*!*		ENDIF
		*!*	ELSE
		*!*		*Save and set Read only.
		*!*		PRIVATE cPOitem
		*!*		*cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,'POitem',12)
		*!*		cPOitem = PrepareSQLtxt(ThisForm.LstPoItems.Value,'POitem',12)
		*!*		
		*!*		IF Proper_PO_item(cPOitem) = Proper_PO_item('')
		*!*		ENDIF
		*!*		
		*!*		****************************************
		*!*		PRIVATE cSQL2, cSQL, nSQLEXEC 
		*!*		cSQL2 = ''
		*!*		
		*!*		PRIVATE dHPA_Date_Update
		*!*		dHPA_Date_Update = PrepareSQLdate(ThisForm.txtHPA_Due_Max.Value,'HPA_Due_Max')  &&,.F.,.T.
		*!*		
		*!*		cSQL = "UPDATE dbo.PurchaseOrder "
		*!*		cSQL = cSQL + " SET HPA_Due_Max = '"+DTOC(dHPA_Date_Update)+"'" 
		*!*		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle,'')
		*!*		ELSE
		*!*			TrackMess( cSQL +" in PurchaseOrder, Edit due date." )
		*!*		ENDIF
		*!*		****************************************
		*!*		
		*!*		PRIVATE cProcessNotes
		*!*		cProcessNotes = PrepareSQLtxt(ThisForm.edtNotes.Value,'Notes',-3)
		*!*		
		*!*		IF LEN(cProcessNotes)>0
		*!*					
		*!*			IF USED('tmpProcessNotes')
		*!*				USE IN tmpProcessNotes
		*!*			ENDIF
		*!*			SELECT 0
		
		*!*			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PO_ProcessNotes "
		*!*			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessNotes')
		
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpProcessNotes' )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessNotes")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessNotes")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisForm.nConnHandle,'tmpProcessNotes')
		*!*			ELSE
		*!*				IF USED('tmpProcessNotes')
		*!*					IF RECCOUNT('tmpProcessNotes') > 0
		*!*						IF tmpProcessNotes.CNTD > 0
		*!*							*Update
		*!*							cSQL2 = "UPDATE dbo.PO_ProcessNotes "
		*!*							cSQL2 = cSQL2 + " SET Notes = '"+cProcessNotes +"'"
		*!*							cSQL2 = cSQL2 + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*						ELSE
		*!*							*Insert
		*!*							cSQL2 = "INSERT INTO dbo.PO_ProcessNotes "
		*!*							cSQL2 = cSQL2 + " ( POitem,Notes ) VALUES "
		*!*							cSQL2 = cSQL2 + " (  '"+cPOitem+"'"
		*!*							cSQL2 = cSQL2 + ",'"+cProcessNotes+"' )"
		*!*						ENDIF
		*!*					ENDIF
		*!*					USE IN tmpProcessNotes
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			IF NOT EMPTY(cSQL2)
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2 )
		
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL2 )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, "")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, "")
		*!*						
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF  
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL2,ThisForm.nConnHandle,'')
		*!*				ELSE
		*!*					TrackMess( cSQL2 +" in PurchaseOrder, Edit Due Notes." )
		*!*					WAIT WINDOW 'Saved!' NOWAIT
		*!*				ENDIF
		*!*			
		*!*			ENDIF
		*!*		ENDIF   &&LEN(cProcessNotes) >0
		*!*		****************************************
		*!*		*Warn users
		*!*		
		*!*		IF USED('tmpTiedSO')
		*!*			USE IN tmpTiedSO
		*!*		ENDIF
		*!*		SELECT 0
		
		*!*		cSQL = "SELECT P.Due_Max,P.Due_Min"
		*!*		cSQL = cSQL + ",AQ.SOitem,AQ.Company,AQ.Alloy,AQ.Email"
		*!*		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS Descript"
		*!*		cSQL = cSQL + ",AQ.SaleDate, dbo.SalesPEmail(AQ.SalesP) AS SpEmail"
		*!*		cSQL = cSQL + " FROM dbo.PurchaseOrder P"
		*!*		cSQL = cSQL + " INNER JOIN dbo.AllQuotes AQ on AQ.SOitem = p.SOitem"
		*!*		cSQL = cSQL + " WHERE P.POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTiedSO')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpTiedSO' )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTiedSO")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTiedSO")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF  
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle,'tmpTiedSO')
		*!*		ELSE
		*!*			IF USED('tmpTiedSO')
		*!*				IF RECCOUNT('tmpTiedSO') > 0
		*!*					PRIVATE dDue_Max,dDue_Min
		*!*					PRIVATE cSOitem,cEmail,cCompany,cAlloy
		*!*					PRIVATE cDescript,dSaleDate,cSpEmail
		*!*					PRIVATE cText,cParameters
		*!*					
		*!*					SCAN
		*!*						dDue_Max	= PrepareSQLdate(tmpTiedSO.Due_Max,'Due_Max')
		*!*						dDue_Min	= PrepareSQLdate(tmpTiedSO.Due_Min,'Due_Min')
		*!*						cSOitem		= PrepareSQLtxt(tmpTiedSO.SOitem,'SOitem',10)
		*!*						cEmail		= PrepareSQLemail(tmpTiedSO.Email,'Email',100)
		*!*						cCompany	= PrepareSQLtxt(tmpTiedSO.Company,'Company',30)
		*!*						cAlloy		= PrepareSQLtxt(tmpTiedSO.Alloy,'Alloy',12)
		*!*						cDescript	= PrepareSQLtxt(tmpTiedSO.Descript,'Descript',150)
		*!*						dSaleDate	= PrepareSQLdate(tmpTiedSO.SaleDate,'SaleDate')
		*!*						cSpEmail	= PrepareSQLemail(tmpTiedSO.SpEmail,'Email',100)
		*!*						
		*!*						cText = "PO:"+ALLTRIM(cPOitem)+" has changed. Its Due Date is now '"+DTOC(dHPA_Date_Update)+"'" +CHR(13)
		*!*						cText = cText + "Your Sales Order:"+ALLTRIM(cSOitem)+" is to use this purchased stock."+CHR(13)
		*!*						cText = cText + "Company:"+ALLTRIM(cCompany)+"."+CHR(13)
		*!*						cText = cText + "  Email:"+ALLTRIM(cEmail)+"."+CHR(13)
		*!*						cText = cText + "Description:"+ALLTRIM(cAlloy)+" "+ALLTRIM(cDescript)+"."+CHR(13)
		*!*						cText = cText + "Sold Date:"+DTOC(dSaleDate)+CHR(13)
		*!*						cText = cText + "First due Min:"+DTOC(dDue_Min)+" First due Max:"+DTOC(dDue_Max)+CHR(13)
		*!*						cText = cText + "Is now set for:"+DTOC(dHPA_Date_Update)+"."+CHR(13)
		*!*						cText = cText + HTML_POitem(cPOitem,.F.)+CHR(13)
		*!*						cText = cText + HTML_SOitem(cSOitem,.F.)+CHR(13)
		*!*						cText = cText + SYS(0)+CHR(13)	
		*!*						
		*!*						*PARAMETERS pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, pConn, lQuiet, lNoHeadder
		*!*						*Send_HTML_Email( 'DavidKirchner@yahoo.com','David.Kirchner@SpaceAlloysUSA.com','Test','Just Testing',0,.T.,.T.)
		*!*						Send_HTML_Email( cSpEmail,get_Server_Email(),'PO for SO has been delayed.',cText,ThisForm.nConnHandle,.T.,.T.)
		*!*					ENDSCAN
		*!*				ENDIF
		*!*				USE IN tmpTiedSO
		*!*			ENDIF
		*!*		ENDIF
		
		*!*		****************************************
		*!*		
		*!*		ThisForm.edtNotes.ReadOnly = .T.
		*!*		ThisForm.txtHPA_Due_Max.Enabled = .F.
		*!*		This.Caption = "Edit"
		*!*		ThisForm.cmdCancelEdit.Caption = "Return"
		*!*		ThisForm.cmdCancelEdit.Visible = .F.
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE cmdPrintPO.Valid
		PRIVATE nHpaPo, lClosePurchaseOrder, lCloseShipAddr
		lClosePurchaseOrder = .F.
		lCloseShipAddr = .F.
		
		nHpaPo = PrepareSQLnum(THIS.PARENT.txtHpapo.VALUE,'HPApo',-3)
				
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PurchaseOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PurchaseOrder' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PurchaseOrder")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PurchaseOrder")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
		ENDIF
		
		lClosePurchaseOrder = .T.
		**************************
		
		
		IF USED('PO_No')
			USE IN PO_No
		ENDIF
		
		cSQL = "SELECT * FROM dbo.PO_No "
		cSQL = cSQL + " WHERE HpaPO = "+STR(nHpaPo)+""
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PO_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PO_No' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PO_No' )
		ENDIF
		
		**************************
		PRIVATE lFoundVendor
		*SEEK UPPER(PurchaseOrder.Company) IN VENDOR ORDER TAG UPPCompany
		lFoundVendor = SelectVendor(PurchaseOrder.VendCode, PurchaseOrder.Company, ThisForm.nConnHandle)
		
		
		IF !USED('ShipAddr')
		*		USE HPA!ShipAddr IN 0
			lCloseShipAddr = .T.
		ENDIF
		*SELECT ShipAddr
		*SEEK PurchaseOrder.POShipAddr IN ShipAddr ORDER TAG ShipCode
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE ShipCode = "+STR(PurchaseOrder.POShipAddr)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ShipAddr'  )
		ENDIF
		
		**Get VendorContact **
		SelectVendorContact(PurchaseOrder.ContactID,ThisForm.nConnHandle)
		
		SELECT purchaseOrder
		IF nHpaPo > 0
		
			REPORT FORM reports\PurchaseOrder26.FRX FOR purchaseOrder.HpaPo = nHpaPo PREVIEW
			*NOCONSOLE TO PRINTER
		
		ELSE
			MESSAGEBOX("No ERP PO Number!!!")
		ENDIF
		
		IF lClosePurchaseOrder
			IF USED('PurchaseOrder')
				USE IN purchaseOrder
			ENDIF
		ENDIF
		IF lCloseShipAddr
			IF USED('ShipAddr')
				USE IN ShipAddr
			ENDIF
		ENDIF
		IF USED('SoldAddr')	
			USE IN SoldAddr
		ENDIF
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		
		ThisForm.cmdReturn.SetFocus
		
		
	ENDPROC

	PROCEDURE cmdPrintPO.When
		
			IF EMPTY(THIS.PARENT.txtHpapo.VALUE)
				WAIT WINDOW 'Enter PO first' NOWAIT
				RETURN .F.
			ENDIF
		
			IF THIS.PARENT.txtItemPo.VALUE < 1
				=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
				RETURN .F.
			ENDIF
		
			IF EMPTY(ALLTRIM(THIS.PARENT.txtCompany.VALUE))
				=MESSAGEBOX("Purchase Order needs the Company Purchased from entered.",16,"Invalid input")
				RETURN .F.
			ENDIF
		
	ENDPROC

	PROCEDURE cmdReportServer.Click
		PRIVATE nHpaPo 
		nHpaPo = PrepareSQLnum(THIS.PARENT.txtHpapo.VALUE,'HPApo',-3)
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_PO(nHpaPo ,.T.) &&lReturnURL --not URL is an HTML code.
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		WAIT WINDOW "Look for a blinking Internet Explorer to read report!" NOWAIT
		
		
	ENDPROC

	PROCEDURE cmdReportServer.When
		
			IF EMPTY(THIS.PARENT.txtHpapo.VALUE)
				WAIT WINDOW 'Enter PO first' NOWAIT
				RETURN .F.
			ENDIF
		
			IF THIS.PARENT.txtItemPo.VALUE < 1
				=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
				RETURN .F.
			ENDIF
		
			IF EMPTY(ALLTRIM(THIS.PARENT.txtCompany.VALUE))
				=MESSAGEBOX("Purchase Order needs the Company Purchased from entered.",16,"Invalid input")
				RETURN .F.
			ENDIF
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdShowRecv.Click
		PRIVATE cPOitem
		cPOitem = ThisForm.lstPoItems.Value
		
		*DO FORM Forms\ShowReceiving WITH cPOitem
		*DO FORM Forms\ShowReceiving WITH 'POitem',cPOitem
		
		********************************************************
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_Receiving_POitem(cPOitem,.T.) &&lReturnURL --not URL is an HTML code.
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
		
	ENDPROC

	PROCEDURE cmdShowRecv.When
		
			IF EMPTY(THIS.PARENT.txtHpapo.VALUE)
				WAIT WINDOW 'Enter PO first' NOWAIT
				RETURN .F.
			ENDIF
		
			IF THIS.PARENT.txtItemPo.VALUE < 1
				=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
				RETURN .F.
			ENDIF
		
			IF EMPTY(ALLTRIM(THIS.PARENT.txtCompany.VALUE))
				=MESSAGEBOX("Purchase Order needs the Company Purchased from entered.",16,"Invalid input")
				RETURN .F.
			ENDIF
		
	ENDPROC

	PROCEDURE lstPoItems.Click
		Thisform.ShowPoitem()
		
		
	ENDPROC

	PROCEDURE txtReceivingID.Click
		PRIVATE nRID
		nRID = PrepareSQLnum(This.Value,'RID',-3)
		IF nRID > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_ReceivingID(nRID ,.T.)
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			
			WAIT WINDOW "Look for a blinking Internet Explorer to read report!" NOWAIT
		ENDIF
	ENDPROC

ENDDEFINE
