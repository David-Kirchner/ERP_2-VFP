	PROCEDURE Init
		LPARAMETERS tnFileType
		
		WITH THISFORM
			.nFileType        = tnFileType
			.opgOptions.VALUE = 1
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		THISFORM.Release()
		
		
	ENDPROC

	PROCEDURE cmdOk.Click
		THISFORM.Hide()
		
		
	ENDPROC

	PROCEDURE opgOptions.InteractiveChange
		#DEFINE cnWORD 					         		1
		#DEFINE cnHTML               			 		2
		#DEFINE cnRTF               			 		3
		#DEFINE cnEXCEL               			 		4
		#DEFINE cnPDF	               			 	    7
		#DEFINE cnIMAGE	               			 	    8
		
		WITH THISFORM
		
		
			DO CASE
				CASE .nFileType = cnHTML
					.pgfOutPutType.ActivePage =  1
		
				CASE .nFileType = cnPDF
					.pgfOutPutType.ActivePage =  2
		
				CASE .nFileType = cnEXCEL
					.pgfOutPutType.ActivePage =  3		
		
				CASE .nFileType = cnIMAGE
					.pgfOutPutType.ActivePage =  5
		
				CASE .nFileType = cnRTF
					.pgfOutPutType.ActivePage =  6
		
				OTHERWISE
					.pgfOutPutType.ActivePage =  4
		
			ENDCASE
		
			DO CASE
				CASE THIS.VALUE = 3
		
					.chkAttachment.ENABLED  = INLIST(.nFileType, cnHTML)		
					.chkAttachment.VALUE    = IIF(INLIST(.nFileType, cnHTML), .chkAttachment.VALUE, .T.)			
		
					.chkDisplay.ENABLED     = .T.
					.txtSendTo.ENABLED      = .T.
					.txtCc.ENABLED          = .T.
					.txtSubject.ENABLED     = .T.
					
			OTHERWISE
			
					.chkAttachment.ENABLED  = .F.
					.chkDisplay.ENABLED     = .F.
					.txtSendTo.ENABLED      = .F.
					.txtCc.ENABLED          = .F.
					.txtSubject.ENABLED     = .F.
		
			ENDCASE	
			
		ENDWITH
		
	ENDPROC

	PROCEDURE opgOptions.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgImage.opgOptions.InteractiveChange
		WITH THIS
			.PARENT.chkMultiPageTifFile.ENABLED = (.VALUE = 4)
		ENDWITH
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgPDF.cmdPickUpPDF.Click
		THIS.PARENT.txtPDFPath.VALUE = GETFILE('PDF')
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkExcelDraft.InteractiveChange
		WITH THIS
		
			IF .VALUE
				.PARENT.chkPlainExcel.VALUE     = .F.
				.PARENT.chkPlainExcelFull.VALUE = .F.
				.PARENT.chkXMLSS.VALUE          = .F.		
			ENDIF
		
			.PARENT.chkSuppressExtraRow.ENABLED = .VALUE
		
			IF !.VALUE
				.PARENT.chkSuppressExtraRow.VALUE = .F.
			ENDIF
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkExcelDraft.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkPlainExcel.InteractiveChange
		WITH THIS
		
			IF .VALUE
			
				.PARENT.chkPlainExcelFull.VALUE = .F.
				.PARENT.chkMultiWorkSheet.VALUE = .F.
		
				.PARENT.chkExcelDraft.VALUE = .F.
				.PARENT.chkSuppressExtraRow.VALUE = .F.
		
				.PARENT.chkXMLSS.VALUE = .F.
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkPlainExcel.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkPlainExcelFull.InteractiveChange
		WITH THIS
		
			IF .VALUE
				.PARENT.chkPlainExcel.VALUE = .F.
				.PARENT.chkExcelDraft.VALUE = .F.
				.PARENT.chkXMLSS.VALUE      = .F.		
			ENDIF
		
			.PARENT.chkMultiWorkSheet.ENABLED = .VALUE
		
			IF !.VALUE
				.PARENT.chkMultiWorkSheet.VALUE = .F.
			ENDIF
		
		ENDWITH
		
		
		
		
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkPlainExcelFull.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkSuppressExtraRow.InteractiveChange
		
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkSuppressExtraRow.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkXMLSS.InteractiveChange
		WITH THIS
		
			IF .VALUE
				.PARENT.chkPlainExcelFull.VALUE = .F.
				.PARENT.chkMultiWorkSheet.VALUE = .F.
		
				.PARENT.chkExcelDraft.VALUE       = .F.
				.PARENT.chkSuppressExtraRow.VALUE = .F.
		
				.PARENT.chkPlainExcel.VALUE       = .F.
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE pgfOutPutType.pgXLS.chkXMLSS.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
	ENDPROC

ENDDEFINE
