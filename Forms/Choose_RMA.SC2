	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpChooseRMA.cancelled,,RGB( 255, 0, 0 ),IIF(tmpChooseRMA.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpChooseRMA.cancelled
			nColor = RGB( 255, 0, 0 ) &&RED	
		CASE tmpPOitems.ReceivingID > 0
			nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pcSOitem
		*DO FORM Forms\Choose_RMA WITH '  121469-01' TO nRMA
		
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(pcSOitem,'SOitem',10)
		
		IF USED("tmpChooseRMA")
			USE IN tmpChooseRMA
		ENDIF
		
		IF cSOitem <> Proper_SO_item('')
			ThisForm.Caption = ThisForm.Caption+" for SO item '"+cSOitem+"'"
		ENDIF
		
		IF USED('tmpChooseRMA')
			USE IN tmpChooseRMA
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_No "
		
		IF cSOitem <> Proper_SO_item('')
			cSQL = cSQL + " WHERE SO_item = '"+cSOitem+"'"
		ENDIF
		cSQL = cSQL + " ORDER BY RMA.RMA_No DESC "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpChooseRMA')
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
			ENDDO
		ENDIF
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpChooseRMA' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpChooseRMA' )
		ENDIF
		
		IF RECCOUNT('tmpChooseRMA') < 1 AND cSOitem <> Proper_SO_item('')
			
			MESSAGEBOX("Did not find by SOitem"+CHR(13)+"'"+cSOitem+"'"+CHR(13)+"Showing All RMA Records.",0+48,"All records.")
			
			cSQL = "SELECT * "
			cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_No "
			cSQL = cSQL + " ORDER BY RMA.RMA_No DESC "
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpChooseRMA')
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
				ENDDO
			ENDIF
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpChooseRMA' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseRMA")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpChooseRMA' )
			ENDIF
		ENDIF
		
		*ThisForm.grid.RecordSource = "tmpChooseRMA"
		ThisForm.grdSOitem.RecordSource = "tmpChooseRMA"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		********************************
		*!*	ThisForm.grdSOitem.Column1.Controlsource = "tmpChooseRMA.POitem"
		*!*	ThisForm.grdSOitem.Column2.Controlsource = "tmpChooseRMA.SoItem"
		*!*	ThisForm.grdSOitem.Column3.Controlsource = "tmpChooseRMA.SalesMan"
		*!*	ThisForm.grdSOitem.Column4.Controlsource = "tmpChooseRMA.Company"
		*!*	ThisForm.grdSOitem.Column5.Controlsource = "tmpChooseRMA.Alloy"
		*!*	ThisForm.grdSOitem.Column6.Controlsource = "tmpChooseRMA.Pieces"
		*!*	ThisForm.grdSOitem.Column7.Controlsource = "tmpChooseRMA.Description"
		*!*	ThisForm.grdSOitem.Column8.Controlsource = "tmpChooseRMA.Cond_Spec"
		*!*	ThisForm.grdSOitem.Column9.Controlsource = "tmpChooseRMA.Heat"
		*!*	ThisForm.grdSOitem.Column10.Controlsource = "tmpChooseRMA.OrderDate"
		*!*	ThisForm.grdSOitem.Column11.Controlsource = "tmpChooseRMA.Received"
		*!*	ThisForm.grdSOitem.Column12.Controlsource = "tmpChooseRMA.Delivered"
		*!*	ThisForm.grdSOitem.Column13.Controlsource = "tmpChooseRMA.Cancelled"
		
		*!*	ThisForm.grdSOitem.Column1.Header1.Caption = "POitem"
		*!*	ThisForm.grdSOitem.Column2.Header1.Caption= "SoItem"
		*!*	ThisForm.grdSOitem.Column3.Header1.Caption= "SalesMan"
		*!*	ThisForm.grdSOitem.Column4.Header1.Caption= "Company"
		*!*	ThisForm.grdSOitem.Column5.Header1.Caption= "Alloy"
		*!*	ThisForm.grdSOitem.Column6.Header1.Caption= "Pieces"
		*!*	ThisForm.grdSOitem.Column7.Header1.Caption= "Description"
		*!*	ThisForm.grdSOitem.Column8.Header1.Caption= "Cond_Spec"
		*!*	ThisForm.grdSOitem.Column9.Header1.Caption= "Heat"
		*!*	ThisForm.grdSOitem.Column10.Header1.Caption= "OrderDate"
		*!*	ThisForm.grdSOitem.Column11.Header1.Caption= "Received"
		*!*	ThisForm.grdSOitem.Column12.Header1.Caption= "Delivered"
		*!*	ThisForm.grdSOitem.Column13.Header1.Caption= "Cancelled"
			
		********************************
		
		
		IF RECCOUNT("tmpChooseRMA") = 0
			MESSAGEBOX("Sorry, No RMA's Found",32,"No records to Show!")
		*	WAIT WINDOW "Sorry, Sales Number not Found" NOWAIT
		ENDIF
		
		ThisForm.txtCompany.Value 	= PrepareSQLtxt(tmpChooseRMA.Company,'Company',30)
		ThisForm.txtContact.Value	= PrepareSQLtxt(tmpChooseRMA.Contact,'Contact',20)
		ThisForm.txtRMA.Value		= PrepareSQLnum(tmpChooseRMA.RMA_No,'RMA_No',-3)
		ThisForm.txtAuth_By.Value	= PrepareSQLtxt(tmpChooseRMA.Auth_By,'Auth_By',20)
		ThisForm.txtSOitem.Value	= PrepareSQLnum(tmpChooseRMA.SO_item,'SOitem',10)
	ENDPROC

	PROCEDURE Load
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVEF
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.OrigTable = ALIAS()
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE Resize
		PRIVATE nHigh, nWidth
		
		nHigh = ThisForm.Height - 281
		nWidth = ThisForm.Width - 592
		
		ThisForm.grdSOitem.Width = 580 + nWidth
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpChooseRMA')
			USE IN tmpChooseRMA
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = 0
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE cHoldNumber
		*cHoldNumber = ""
		cHoldNumber = tmpChooseRMA.RMA_No
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE grdSOitem.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.txtCompany.Value 	= PrepareSQLtxt(tmpChooseRMA.Company,'Company',30)
		ThisForm.txtContact.Value	= PrepareSQLtxt(tmpChooseRMA.Contact,'Contact',20)
		ThisForm.txtRMA.Value		= PrepareSQLnum(tmpChooseRMA.RMA_No,'RMA_No',-3)
		ThisForm.txtAuth_By.Value	= PrepareSQLtxt(tmpChooseRMA.Auth_By,'Auth_By',20)
		ThisForm.txtSOitem.Value	= PrepareSQLnum(tmpChooseRMA.SO_item,'SOitem',10)
	ENDPROC

ENDDEFINE
