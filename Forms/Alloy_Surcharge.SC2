	PROCEDURE Init
		*DO FORM Forms\Alloy_Surcharge
		
		PRIVATE cUser
		cUser = SYS(0)
		*IF "David Kirchner" $ cUser
		
		ThisForm.Load_Alloy_Surchage()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE load_alloy_surchage
		*ThisForm.Load_Alloy_Surchage()
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.AlloySurcharge WITH(NOLOCK) "
		
		IF USED("Alloy_Surcharge")
			SELECT Alloy_Surcharge
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'AlloySurcharge')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'AlloySurcharge')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloySurcharge')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloySurcharge')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'AlloySurcharge')
		ENDIF
		
		
		IF USED("AlloySurcharge")
			SELECT AlloySurcharge
			*INDEX ON UPPER(Alloys) TAG UppAlloys
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			*Put in Edit Mode
			
			ThisForm.txtCo_Base.ReadOnly = .F.
			ThisForm.txtCr_Base.ReadOnly = .F.
			ThisForm.txtCu_Base.ReadOnly = .F.
			ThisForm.txtFe_Base.ReadOnly = .F.
			ThisForm.txtMo_Base.ReadOnly = .F.
			ThisForm.txtNi_Base.ReadOnly = .F.
			ThisForm.txtTi_Base.ReadOnly = .F.
		
			ThisForm.txtCo_Now.ReadOnly = .F.
			ThisForm.txtCr_Now.ReadOnly = .F.
			ThisForm.txtCu_Now.ReadOnly = .F.
			ThisForm.txtFe_Now.ReadOnly = .F.
			ThisForm.txtMo_Now.ReadOnly = .F.
			ThisForm.txtNi_Now.ReadOnly = .F.
			ThisForm.txtTi_Now.ReadOnly = .F.
			
			
			
			ThisForm.cmdExit.Caption = "Abort"
			This.Caption = "Save"
		ELSE
			*Save
			
			
			
			ThisForm.txtCo_Base.ReadOnly = .T.
			ThisForm.txtCr_Base.ReadOnly = .T.
			ThisForm.txtCu_Base.ReadOnly = .T.
			ThisForm.txtFe_Base.ReadOnly = .T.
			ThisForm.txtMo_Base.ReadOnly = .T.
			ThisForm.txtNi_Base.ReadOnly = .T.
			ThisForm.txtTi_Base.ReadOnly = .T.
		
			ThisForm.txtCo_Now.ReadOnly = .T.
			ThisForm.txtCr_Now.ReadOnly = .T.
			ThisForm.txtCu_Now.ReadOnly = .T.
			ThisForm.txtFe_Now.ReadOnly = .T.
			ThisForm.txtMo_Now.ReadOnly = .T.
			ThisForm.txtNi_Now.ReadOnly = .T.
			ThisForm.txtTi_Now.ReadOnly = .T.
			
			ThisForm.cmdExit.Caption = "Leave"
			This.Caption = "Edit"
		ENDIF
		
	ENDPROC

	PROCEDURE cmdExit.Click
		IF This.Caption = "Leave"
			ThisForm.Release
		ELSE
			*Abort
			
			ThisForm.Load_Alloy_Surchage()
			
			ThisForm.txtCo_Base.ReadOnly = .T.
			ThisForm.txtCr_Base.ReadOnly = .T.
			ThisForm.txtCu_Base.ReadOnly = .T.
			ThisForm.txtFe_Base.ReadOnly = .T.
			ThisForm.txtMo_Base.ReadOnly = .T.
			ThisForm.txtNi_Base.ReadOnly = .T.
			ThisForm.txtTi_Base.ReadOnly = .T.
		
			ThisForm.txtCo_Now.ReadOnly = .T.
			ThisForm.txtCr_Now.ReadOnly = .T.
			ThisForm.txtCu_Now.ReadOnly = .T.
			ThisForm.txtFe_Now.ReadOnly = .T.
			ThisForm.txtMo_Now.ReadOnly = .T.
			ThisForm.txtNi_Now.ReadOnly = .T.
			ThisForm.txtTi_Now.ReadOnly = .T.
			
			
			ThisForm.cmdEdit.Caption = "Edit"
			
		ENDIF
	ENDPROC

ENDDEFINE
