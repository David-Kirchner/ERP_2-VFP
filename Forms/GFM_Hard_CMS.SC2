	PROCEDURE Destroy
		IF USED('GFM_Hard_CMS')
			USE IN GFM_Hard_CMS
		ENDIF
	ENDPROC

	PROCEDURE getgfm_hard_cms
		*ThisForm.getGFM_Hard_CMS()
		
		IF USED('GFM_Hard_CMS')
			USE IN GFM_Hard_CMS
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT * FROM dbo.GFM_Hard_CMS "
		cSQL = cSQL +" WHERE GFM_ID="+ALLTRIM(STR(ThisForm.pData))
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'GFM_Hard_CMS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'GFM_Hard_CMS')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'GFM_Hard_CMS' )
		ENDIF
		
		IF USED('GFM_Hard_CMS')
			IF RECCOUNT('GFM_Hard_CMS') > 0
				ThisForm.txt1C.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard1C,'Hard1C',10)
				ThisForm.txt1M.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard1M,'Hard1M',10)
				ThisForm.txt1S.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard1S,'Hard1S',10)
				ThisForm.txt2C.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard2C,'Hard2C',10)
				ThisForm.txt2M.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard2M,'Hard2M',10)
				ThisForm.txt2S.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard2S,'Hard2S',10)
				ThisForm.txt3C.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard3C,'Hard3C',10)
				ThisForm.txt3M.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard3M,'Hard3M',10)
				ThisForm.txt3S.Value = PrepareSQLtxt(GFM_Hard_CMS.Hard3S,'Hard3S',10)
				
				ThisForm.txt1C.Enabled = .F.
				ThisForm.txt1M.Enabled = .F.
				ThisForm.txt1S.Enabled = .F.
				ThisForm.txt2C.Enabled = .F.
				ThisForm.txt2M.Enabled = .F.
				ThisForm.txt2S.Enabled = .F.
				ThisForm.txt3C.Enabled = .F.
				ThisForm.txt3M.Enabled = .F.
				ThisForm.txt3S.Enabled = .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pData, pConn, nTop, nLeft
		*DO FORM Forms\GFM_Hard_CMS WITH GFMLog.ID, ThisForm.ConnHandle, nTop, nLeft
		
		
		IF VARTYPE(pData) = "N"
			ThisForm.pData = pData
		ELSE
			ThisForm.pData = 0
		ENDIF
		
		IF VARTYPE(pConn) = "N"
			IF pConn > 0
				ThisForm.nConnHandle = pConn
			ENDIF
		ENDIF
		IF EMPTY(ThisForm.nConnHandle)
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		
		*****	
		*Test Connection!
		lConnection = .T.
		TRY
			SQLEXEC( ThisForm.nConnHandle, "SELECT GETDATE() as Today" , "TestSQL")
			
		CATCH 
			*Bad Connection
			lConnection = .F.
		ENDTRY
		IF NOT lConnection 
			PRIVATE nBadConn
			nBadConn = ThisForm.nConnHandle
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			TrackError("GFM_Hard_CMS.INIT. BadConn:"+ALLTRIM(STR(nBadConn))+" nConnHandle:"+ALLTRIM(STR(ThisForm.nConnHandle)),"Bad Conn","GFM_Hard_CMS",RECNO() )
		ENDIF
		
		****
		IF VARTYPE(nTop) = "N"
			ThisForm.Top = nTop
		ENDIF
		IF VARTYPE(nLeft) = "N"
			ThisForm.Left = nLeft+30
		ENDIF
		
		
		************************
		ThisForm.getGFM_Hard_CMS()
		************************
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDelete.Click
		IF This.Caption = "Abort"
			This.Caption = "Delete"
			ThisForm.cmdEdit.Caption = "Edit"
			
			RETURN
		ENDIF
		
		**Delete
		IF USED('GFM_Hard_CMS')
			PRIVATE nID
			nID		= GFM_Hard_CMS.GFM_ID
			
			IF nID > 0
			
				IF MESSAGEBOX("Are you sure you want to Delete this GFM Hardness Profile?",4+32,"Delete") = 6
		
					cSQL = "DELETE FROM dbo.GFM_Hard_CMS "
					cSQL = cSQL +" WHERE [ID]="+ALLTRIM(STR(nID))
		
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle )
					ENDIF
							
					ThisForm.Release
					
				ENDIF
			ELSE
				WAIT WINDOW "No ID to Delete!" NOWAIT
			ENDIF
		ELSE
			MESSAGEBOX("No 'GFM_Hard_CMS' in use to delete from'",48,'Error')
		ENDIF
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			PRIVATE nID, nData, cPOitem
			nID		= GFM_Hard_CMS.GFM_ID
			
			IF nID > 0
		
				This.Caption = "Save"
				ThisForm.cmdDelete.Caption = "Abort"
				
				ThisForm.txt1C.Enabled = .T.
				ThisForm.txt1M.Enabled = .T.
				ThisForm.txt1S.Enabled = .T.
				ThisForm.txt2C.Enabled = .T.
				ThisForm.txt2M.Enabled = .T.
				ThisForm.txt2S.Enabled = .T.
				ThisForm.txt3C.Enabled = .T.
				ThisForm.txt3M.Enabled = .T.
				ThisForm.txt3S.Enabled = .T.
			ELSE
				WAIT WINDOW "No ID to Edit, Add first!" NOWAIT
			ENDIF
		ELSE
			*Save
			
			*Check Data
			PRIVATE lOKtoSave
			lOKtoSave = .F.
			
			PRIVATE nGFM_ID,c1C,c1M,c1S,c2C,c2M,c2S,c3C,c3M,c3S
			nGFM_ID	= PrepareSQLnum(GFM_Hard_CMS.GFM_ID,'GFM_ID',-3)
			c1C = PrepareSQLtxt(ThisForm.txt1C.Value,'Hard1C',10)
			c1M = PrepareSQLtxt(ThisForm.txt1M.Value,'Hard1M',10)
			c1S = PrepareSQLtxt(ThisForm.txt1S.Value,'Hard1S',10)
			c2C = PrepareSQLtxt(ThisForm.txt2C.Value,'Hard2C',10)
			c2M	= PrepareSQLtxt(ThisForm.txt2M.Value,'Hard2M',10)
			c2S = PrepareSQLtxt(ThisForm.txt2S.Value,'Hard2S',10)
			c3C = PrepareSQLtxt(ThisForm.txt3C.Value,'Hard3C',10)
			c3M = PrepareSQLtxt(ThisForm.txt3M.Value,'Hard3M',10)
			c3S = PrepareSQLtxt(ThisForm.txt3S.Value,'Hard3S',10)
		
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
		
			cSQL = "MERGE dbo.GFM_Hard_CMS with(HOLDLOCK) AS target"
			cSQL = cSQL +" USING (VALUES ("+STR(nGFM_ID)+"))"
			cSQL = cSQL +" AS source (GFM_ID)"
			cSQL = cSQL +" ON target.GFM_ID = "+STR(nGFM_ID)
			cSQL = cSQL +" WHEN MATCHED THEN"
			cSQL = cSQL +"    UPDATE "
			cSQL = cSQL +"    SET Hard1C = '"+c1C+"'"
			cSQL = cSQL +",Hard1M = '"+c1M+"'" 
			cSQL = cSQL +",Hard1S = '"+c1S+"'" 
			cSQL = cSQL +",Hard2C = '"+c2C+"'"
			cSQL = cSQL +",Hard2M = '"+c2M+"'" 
			cSQL = cSQL +",Hard2S = '"+c2S+"'" 
			cSQL = cSQL +",Hard3C = '"+c3C+"'"
			cSQL = cSQL +",Hard3M = '"+c3M+"'" 
			cSQL = cSQL +",Hard3S = '"+c3S+"'" 
		
			cSQL = cSQL +" "
			cSQL = cSQL +" WHEN NOT MATCHED THEN "
			cSQL = cSQL +"     INSERT ( GFM_ID, Hard1C, Hard1M, Hard1S , Hard2C, Hard2M, Hard2S , Hard3C, Hard3M, Hard3S )"
			cSQL = cSQL +"     VALUES ( "+STR(nGFM_ID)
			cSQL = cSQL +",'"+c1C+"'"
			cSQL = cSQL +",'"+c1M+"'"    
			cSQL = cSQL +",'"+c1S+"'"    
			cSQL = cSQL +",'"+c2C+"'"
			cSQL = cSQL +",'"+c2M+"'"    
			cSQL = cSQL +",'"+c2S+"'"    
			cSQL = cSQL +",'"+c3C+"'"
			cSQL = cSQL +",'"+c3M+"'"    
			cSQL = cSQL +",'"+c3S+"'"    
			cSQL = cSQL +");"
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, '' )
			ELSE
				ThisForm.txt1C.Enabled = .F.
				ThisForm.txt1M.Enabled = .F.
				ThisForm.txt1S.Enabled = .F.
				ThisForm.txt2C.Enabled = .F.
				ThisForm.txt2M.Enabled = .F.
				ThisForm.txt2S.Enabled = .F.
				ThisForm.txt3C.Enabled = .F.
				ThisForm.txt3M.Enabled = .F.
				ThisForm.txt3S.Enabled = .F.
				
				This.Caption = "Edit"
				ThisForm.cmdDelete.Caption = "Delete"
			ENDIF
		
		ENDIF	
		**************************************	
		
		
	ENDPROC

	PROCEDURE cmdQuit.Click
					ThisForm.Release
					
		
	ENDPROC

ENDDEFINE
