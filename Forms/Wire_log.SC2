	PROCEDURE cmgGfm_calc.Valid
		*FIND L2 BY DIA'S AND L1
		private m.cutfctr,m.Tflength
		PRIVATE nslength,nssize,nRollsize,nrollsize,nflength 
		PRIVATE ncutfctr, nfpiece, nspiece, nColdwork
		PRIVATE nswidth, nfwidth
		
		*nslength = ThisForm.txtSlength.Value
		nssize = ThisForm.txtSsize.Value
		*nRollsize = ThisForm.txtRollsize.Value
		nDrawSize= ThisForm.txtDrawSize.Value
		*nflength  = ThisForm.txtFlength.Value
		
		nfpiece = ThisForm.txtFpiece.Value
		nspiece = ThisForm.txtSpiece.Value
		nColdWork = ThisForm.txtColdWork.Value
		
		*nswidth = ThisForm.txtSwidth.Value
		*nfwidth = ThisForm.txtFwidth.Value
		
		
		*Find RA by Thk
		IF nssize > 0 AND nDrawSize >0 AND nColdWork= 0 &&AND ( form="40" or form="51" )
			PRIVATE nOrigA, nFinalA
			nOrigA  = 3.14156 * nssize*nssize /4
			nFinalA = 3.14156 * nDrawSize*nDrawSize /4
		*	REPLACE coldwork WITH (nOrigA - nFinalA)/nOrigA
			nColdWork = (nOrigA - nFinalA)/nOrigA
		  	IF nColdWork < 1
				ThisForm.txtColdwork.Value = nColdWork
			ENDIF  
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE cmgGfm_calc.When
		RETURN ThisForm.isediting
	ENDPROC

