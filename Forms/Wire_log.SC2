	PROCEDURE txtItemSO.Valid
		SELECT tmpWire_Log
		PRIVATE nSalesNum,nItemSO
		nSalesNum = ThisForm.txtSalesNum.Value
		nItemSO = This.Value
		
		IF nSalesNum > 0 AND nItemSO < 1
			This.Value = 1
			nItemSO = 1
		ENDIF
		
		
		
		IF nSalesNum > 0 AND nItemSO > 0
			REPLACE SOItem WITH Proper_So_Item( STR(nSalesNum)+"-"+IIF(nItemSO<10,"0"+STR(nItemSO,1,0), STR(nItemSO,2,0) ))
		ENDIF
	ENDPROC

	PROCEDURE txtItemSO.When
		SELECT tmpWire_Log
		PRIVATE nSalesNum,nItemSO
		nSalesNum = ThisForm.txtSalesNum.Value
		nItemSO = This.Value
		
		IF ThisForm.isediting
			IF nSalesNum > 0 AND nItemSO < 1
		*		This.Value = 1
				*REPLACE tmpWire_Log.itemSO WITH 1
			ENDIF
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE txtLab.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		
		IF NOT USED('GFMLabs')
			THISFORM.LoadGFMlabs()
		ENDIF
		
		IF !EMPTY(lcSearchStr)
			SEEK UPPER(lcSearchStr) ORDER TAG UppLAB IN GFMlabs
		
			IF FOUND("GFMlabs")
			
		*	lcSearchStr2 =SUBSTR(Alloys.Alloy,1,lnInsertionPt)
			
				IF UPPER(lcSearchStr) = SUBSTR(GFMlabs.LAB,1,lnInsertionPt)
					THIS.VALUE=GFMlabs.LAB
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtLab.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtLaborP.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtLot.Valid
		PRIVATE nCurlot, cCurheat
		nCurlot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		cCurheat = PrepareSQLtxt(ThisForm.txtHEAT.Value,'Heat',50)
		
		IF nCurlot > 0 
		  *LOCATE FOR tmpWire_Log.lot = m.curlot AND NOT tmpWire_Log.heat = m.curheat
		  
			IF USED('tmpCountLot')	
				USE IN tmpCountLot
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Wire_Log WHERE Lot ="+STR(nCurLot)+" AND Heat NOT LIKE '"+ALLTRIM(cCurHeat)+"%'"
			cSQL = cSQL + " AND LEN(Heat) > 0 "
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
			ELSE
				IF USED('tmpCountLot')
					IF tmpCountLot.Cntd > 0
		*				MESSAGEBOX( 'You can not have the same Lot# for different Heats -any key',0+48,"Bad Lot Number")
		*				USE IN tmpCountLot 
		*				RETURN .F.
					ENDIF
					USE IN tmpCountLot 
				ENDIF
			ENDIF
		
		ENDIF
		
	ENDPROC

	PROCEDURE txtLot.When
		RETURN ThisForm.isediting
		
		*!*	PRIVATE M.TALKPROP
		*!*	PRIVATE m.mxlot, m.currec
		
		*!*	SELECT tmpWire_Log
		*!*	IF lot=0
		*!*		m.currec = RECNO()
		*!*		m.TALKPROP = SET('TALK')
		*!*		SET TALK OFF
		*!*		CALC MAX(lot) TO M.mxlot
		*!*		IF M.TALKPROP = "ON"
		*!*			SET TALK ON
		*!*		ENDIF
		*!*		WAIT WINDOW "The last Lot# is "+LTRIM(STR(M.mxlot)) NOWAIT
		*!*		GOTO m.currec
		*!*	ENDIF
		
	ENDPROC

