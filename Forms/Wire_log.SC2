	PROCEDURE cmdClone.Valid
		SELECT tmpWire_Log
		IF !ThisForm.isediting &&add record
			ThisForm.isediting=.T.
			ThisForm.IsAdding=.T.
			ThisForm.cmdEdit.Caption="Save"
			ThisForm.cmdDel.Caption="Abort"
			ThisForm.cmdTop.enabled = .F.
			ThisForm.cmdPrev.enabled = .F.
			ThisForm.cmdNext.enabled = .F.
			ThisForm.cmdEnd.enabled = .F.
			ThisForm.cmdSeeAll.enabled = .F.
			ThisForm.cmdCert.enabled = .F.
			ThisForm.cmdSO.enabled = .F.
			ThisForm.cmdRA.enabled = .F.
		*	ThisForm.cmdSsheet.enabled = .F.
			ThisForm.cmdBrow.enabled = .F.
			ThisForm.cmdReport.enabled = .F.	
			ThisForm.cmdBalloy.enabled = .F.	
			ThisForm.cmdClone.enabled = .F.	
			ThisForm.cmdAdd.enabled = .F.	
			ThisForm.cmdPrint.enabled = .F.	
			ThisForm.cmdClose.enabled = .F.	
			ThisForm.cmdStockLst.Enabled = .F.
			ThisForm.cmdPDF.Enabled = .F.
			
		*	SCATTER MEMVAR MEMO    && NO BLANK TO CLONE
		*	INSERT INTO tmpWire_Log FROM MEMVAR
		*	_CUROBJ=1
		*	m.countlot = 0
			
			ThisForm.txtLot.Value = 0
			ThisForm.txtDate.Value 		= DATE()
			ThisForm.txtID.Value		= 0
			ThisForm.DupLots()	&&*ThisForm.Lots.Caption		
			
			*ThisForm.Refresh_Log()
			MESSAGEBOX("Cloned record is ready to edit"+CHR(13)+"Click Lot to get next lot number",0+48,"Record Ready, showing old Lot.")
		*	WAIT WINDOW 'RECORD IS READY TO MODIFY' NOWAIT
			
			ThisForm.txtAlloyName.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE cmdClose.Valid
		THISFORM.Release
		m.bailout=.T.	&&this is needed if used with FoxApp
		
		
	ENDPROC

	PROCEDURE cmdDel.Valid
		SELECT tmpWire_Log
		IF ThisForm.isediting 	&&cancel record
			IF ThisForm.IsAdding
		*		=TABLEREVERT()
				GO BOTTOM 
				ThisForm.Refresh_Log()
				ThisForm.Refresh
			ENDIF
			
			ThisForm.isediting=.F.
			ThisForm.IsAdding=.F.
		*	UNLOCK
		
			this.Caption="\<Delete"
			ThisForm.cmdEdit.Caption="\<Edit"
			ThisForm.cmdTop.enabled = .T.
			ThisForm.cmdPrev.enabled = .T.
			ThisForm.cmdNext.enabled = .T.
			ThisForm.cmdEnd.enabled = .T.
			ThisForm.cmdSeeAll.enabled = .T.
			ThisForm.cmdCert.enabled = .T.
			ThisForm.cmdSO.enabled = .T.
			ThisForm.cmdRA.enabled = .T.
		*	ThisForm.cmdSsheet.enabled = .T.
			ThisForm.cmdBrow.enabled = .T.
			ThisForm.cmdReport.enabled = .T.
			ThisForm.cmdBalloy.enabled = .T.
			ThisForm.cmdClone.enabled = .T.
			ThisForm.cmdAdd.enabled = .T.
			ThisForm.cmdPrint.enabled = .T.
			ThisForm.cmdClose.enabled = .T.
			ThisForm.cmdStockLst.Enabled = .T.
			ThisForm.cmdPDF.Enabled = .T.
		
			WAIT WINDOW 'Cancelled' NOWAIT
			thisform.Refresh
		
		ELSE
			SELECT tmpWire_Log 
			
			IF MESSAGEBOX("Are you sure you want to Delete?",32,"Delete LOT") !=6
				RETURN -1
			ENDIF
			
			IF NOT HavePermission('DeleteMFGlog',.T.)
				MESSAGEBOX('You are not allowed to Delete')
				RETURN -1
			ENDIF
			
			PRIVATE nID, cSQL, nSQLEXEC 
			nID = ThisForm.txtID.Value
			
			IF nID > 0
				cSQL = "DELETE FROM dbo.Wire_Log WHERE ID ="+STR(nID)
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Deleted record!' NOWAIT
					ThisForm.Load_Log()			
				ENDIF
				
			ENDIF
		
		*		IF EOF()
		*			WAIT WINDOW 'End of file.' NOWAIT
		*			GO BOTTOM
		*		ENDIF
			
		
			
			thisform.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDrawSched.Click
		PRIVATE pinID, pMach, pLot
		pinID = PrepareSQLnum(ThisForm.txtSched.Value,'Sched',-3)
		pMach = 'Wire Draw'
		pLot  = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		
		DO FORM Forms\Draw_Sched WITH pinID, pMach, pLot
		*TO poutID
	ENDPROC

	PROCEDURE cmdEdit.Valid
		SELECT tmpWire_Log
		
		IF !ThisForm.isediting &&edit record
			*Start Editing
			IF EOF() OR BOF()
				WAIT WINDOW 'End of File' NOWAIT
				RETURN
			ENDIF
		
				ThisForm.GetLatestData()
				
				ThisForm.isediting=.T.
				this.Caption="Save"
				ThisForm.cmdDel.Caption="Abort"
				ThisForm.cmdTop.enabled = .F.
				ThisForm.cmdPrev.enabled = .F.
				ThisForm.cmdNext.enabled = .F.
				ThisForm.cmdEnd.enabled = .F.
				ThisForm.cmdSeeAll.enabled = .F.
				ThisForm.cmdCert.enabled = .F.
				ThisForm.cmdSO.enabled = .F.
				ThisForm.cmdRA.enabled = .F.
		*		ThisForm.cmdSsheet.enabled = .F.
				ThisForm.cmdBrow.enabled = .F.
				ThisForm.cmdReport.enabled = .F.
				ThisForm.cmdBalloy.enabled = .F.
				ThisForm.cmdClone.enabled = .F.
				ThisForm.cmdAdd.enabled = .F.
				ThisForm.cmdPrint.enabled = .F.
				ThisForm.cmdClose.enabled = .F.
				ThisForm.cmdStockLst.Enabled = .F.
				ThisForm.cmdPDF.Enabled = .F.
			
				ThisForm.txtAlloyname.SetFocus
				thisform.Refresh
				RETURN
		
		ELSE
			*SAVE!
			
		
			IF ThisForm.CheckSave()
				IF ThisForm.Save_Log()
					
					this.Caption="Ed\<it"
					ThisForm.cmdDel.Caption="\<Delete"
					ThisForm.cmdTop.enabled = .T.
					ThisForm.cmdPrev.enabled = .T.
					ThisForm.cmdNext.enabled = .T.
					ThisForm.cmdEnd.enabled = .T.
					ThisForm.cmdSeeAll.enabled = .T.
					ThisForm.cmdCert.enabled = .T.
					ThisForm.cmdSO.enabled = .T.
					ThisForm.cmdRA.enabled = .T.
				*	ThisForm.cmdSsheet.enabled = .T.
					ThisForm.cmdBrow.enabled = .T.
					ThisForm.cmdReport.enabled = .T.
					ThisForm.cmdBalloy.enabled = .T.
					ThisForm.cmdClone.enabled = .T.
					ThisForm.cmdAdd.enabled = .T.
					ThisForm.cmdPrint.enabled = .T.
					ThisForm.cmdClose.enabled = .T.
					ThisForm.cmdStockLst.Enabled = .T.
					ThisForm.cmdPDF.Enabled = .T.
						
					ThisForm.isediting=.F.
					ThisForm.IsAdding=.F.
					thisform.Refresh
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdEnd.Click
		=ThisForm.DupLots()
	ENDPROC

	PROCEDURE cmdEnd.Message
		RETURN 'Go to last record.'
	ENDPROC

	PROCEDURE cmdEnd.Valid
		IF USED('tmpWire_Log')
			SELECT tmpWire_Log
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.Load_Log()
		ENDIF
		
		GO BOTTOM
		WAIT WINDOW 'End of File' NOWAIT
		
		ThisForm.Refresh_Log()
		ThisForm.Refresh
	ENDPROC

	PROCEDURE cmdNext.Valid
		IF USED('tmpWire_Log')
			SELECT tmpWire_Log
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.Load_Log()
		ENDIF
		
		IF !EOF()
			SKIP 1
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM
		ENDIF
		ThisForm.Refresh_Log()
		*ThisForm.DupLots()
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdPDF.Valid
		SELECT tmpWire_Log
		PRIVATE curgrec
		curgrec = RECNO('tmpWire_Log')
		PRIVATE nLot
		nLot = IIF(ISNULL(tmpWire_Log.Lot),0,tmpWire_Log.Lot)
		
		LOCAL loFile
		LOCAL loOutPutOptions
		LOCAL loPreviewOptions
		
		LOCAL lcReportFullName
		LOCAL lcReportFile
		LOCAL lcExportPath
		LOCAL lcErrorMessage
		LOCAL lcVersion
		
		lcReportFullName = FULLPATH('reports\tmpWire_Log.FRX')
		*lcExportPath	= EmailFileName("HPA_Press"+ALLTRIM(STR(nLot,10,0))+".PDF")
		*lcReportFile	= JUSTSTEM(lcExportPath)
		*lcExportPath	= JUSTPATH(lcExportPath)
		lcReportFile	= "GFMLog"+ALLTRIM(STR(nLot,10,0))
		lcExportPath	= SYS(5)+SYS(2003)+"\"
		
		IF !FILE(lcReportFullName)
			lcErrorMessage = 'File ' + lcReportFullName + ' does not exist.'
			=MESSAGEBOX('Init method of dataenvironment returned false.', 16, 'Error')
		ELSE
		
			
			IF NOT "FRX2ANY" $ SET("CLASSLIB")
				SET CLASSLIB TO 'LIBS\FRX2Any' ADDITIVE
			ENDIF
		
			IF NOT "GRIDDEFINITION" $ SET("PROCEDURE")
				SET PROCEDURE TO 'PRoGs\GridDefinition' ADDITIVE
			ENDIF
		
			loFile = CREATEOBJECT('PDFFile')
			
			IF TYPE('loFile') = 'O'
				*loFile.Unlock('xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx') 
					
				loFile.cExportFileName = lcReportFile
				loFile.cSaveFolder     = lcExportPath
		
				*-- Set up Report Scope
				*1=cnSCOPE_CLAUSE_ALL, 2=cnSCOPE_CLAUSE_NEXT, 3=cnSCOPE_CLAUSE_RECORD, 4=cnSCOPE_CLAUSE_REST
				loFile.nScopeClauseType = 3
				loFile.nScopeRecordNumber = curgrec 
		
				*DO FORM Progs\PreviewOptions NAME loPreviewOptions LINKED
				
				
				tnFileType = 7 &&cnPDF
				DO FORM Forms\OutPutOptions NAME loOutPutOptions LINKED WITH tnFileType
				
		*		loFile.lIncludeFont = loOutPutOptions.pgfOutPutType.pgPDF.chkIncludeFontIntoPDF.VALUE
		*		loFile.lTranslateFontStyle = loOutPutOptions.pgfOutPutType.pgPDF.chkFontName.VALUE
		
				loFile.cAddTo       = loOutPutOptions.pgfOutPutType.pgPDF.txtPDFPath.VALUE								
				loFile.nAddToType   = loOutPutOptions.pgfOutPutType.pgPDF.opgOptions.VALUE								
		
				DO CASE
					CASE loOutPutOptions.opgOptions.VALUE = 1 &&Screen
						loFile.nOutPutType = 1 &&cnOUTPUT_SCREEN
					CASE loOutPutOptions.opgOptions.VALUE = 2 &&Print
						loFile.nOutPutType = 2 &&cnOUTPUT_PRINT
					CASE loOutPutOptions.opgOptions.VALUE = 3 &&E-Mail
						loFile.nOutPutType         = 3 &&cnOUTPUT_EMAIL
						loFile.lAsAttachment       = loOutPutOptions.chkAttachment.VALUE
						loFile.lDisplayBeforeEMail = loOutPutOptions.chkDisplay.VALUE
						loFile.cSendTo             = loOutPutOptions.txtSendTo.VALUE
						loFile.cSendCC             = loOutPutOptions.txtCc.VALUE
						loFile.cSubject            = loOutPutOptions.txtSubject.VALUE
					OTHERWISE &&File
						loFile.nOutPutType = 4 &&cnOUTPUT_FILE
						WAIT WINDOW "Writing PDF file to "+loFile.cSaveFolder+loFile.cExportFileName NOWAIT
				ENDCASE
		
				*-- Init DE
				lnSuccess = loFile.InitDataEnvironment(lcReportFullName)
		
					 
				DO CASE
					CASE lnSuccess = 17 &&cnDE_INIT_RETURN_FALSE
					OTHERWISE
		
						DO CASE
							CASE lnSuccess = 4 &&cnNO_OPEN_TABLE
								USE ?
						ENDCASE
		
						lnSuccess  		 = loFile.SAVE(lcReportFullName)
		
						loFile.RELEASE()
						loFile 			 = .NULL.
		
				ENDCASE
				
				DO CASE
					CASE lnSuccess = 17 &&cnDE_INIT_RETURN_FALSE
						lcErrorMessage = 'Init method of dataenvironment returned false.'
						=MESSAGEBOX(lcErrorMessage, 16, 'Error')
		
					CASE lnSuccess = 4 &&cnNO_OPEN_TABLE
						lcErrorMessage = 'No open table and no dataenvironment cursors in FRX file.'
						=MESSAGEBOX(lcErrorMessage, 16, 'Error')
				ENDCASE
		
		
			ELSE
				lcErrorMessage = 'Could not instatiate Frx2Any object.'
				=MESSAGEBOX(lcErrorMessage, 16, 'Error')
			ENDIF
		
		ENDIF
		
		SELECT tmpWire_Log
		GO curgrec
		RETURN
		
	ENDPROC

	PROCEDURE cmdPrev.Valid
		IF USED('tmpWire_Log')
			SELECT tmpWire_Log
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.Load_Log()
		ENDIF
		
		IF !BOF()
			SKIP -1
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file - Use See All for more!' NOWAIT
			GO TOP
		ENDIF
		ThisForm.Refresh_Log()
		*ThisForm.DupLots()
		Thisform.refresh
	ENDPROC

