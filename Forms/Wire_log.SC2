	PROCEDURE cmdSO.Valid
		PRIVATE cSOitem, nSalesNum, nItemSO
		nSalesNum	= ThisForm.txtSalesNum.Value
		nItemSO		= ThisForm.txtItemSO.Value
		
		cSOitem = Proper_SO_Item( STR(nSalesNum)+"-"+STR(nItemSO) )
		IF NOT EMPTY('cSOitem')
			DO FORM Forms\ShowvSOitem WITH cSOitem
		ENDIF
		Return
		
		*!*	PRIVATE m.psalesnum, M.CREC
		*!*	m.CREC = RECNO()
		*!*	  IF NOT USED('INQSOLD')
		*!*	    SELECT 0
		*!*	    USE  HPA!inqsold NOUPDATE shared
		*!*	  ELSE
		*!*	    SELECT inqsold
		*!*	  ENDIF
		*!*	  IF USED('INQSOLD')
		*!*	    &&may be locked by another
		*!*	    SELECT tmpWire_Log
		*!*	    GO TOP
		*!*	    DO WHILE NOT EOF()
		*!*	      IF tmpWire_Log.salesnum > 0 
		*!*	      *AND EMPTY(tmpWire_Log.company)
		*!*	      *IF tmpWire_Log.salesnum > 0
		*!*	        m.psalesnum = tmpWire_Log.salesnum
		
		*!*	        SELECT inqsold
		
		*!*	        LOCATE FOR salesnum = tmpWire_Log.salesnum
		*!*	        IF FOUND()
		*!*	          m.company  = inqsold.company
		*!*	          m.shipped  = inqsold.shipped
		*!*	          m.shipdate = inqsold.shipdate
		*!*	          m.SALESP   = inqsold.salesp
		*!*	          M.PO_NUM   = INQSOLD.PO_NUM
		*!*	          M.SALEDATE = INQSOLD.SALEDATE
		
		*!*	          SELECT tmpWire_Log
		*!*	          SHOW GETS
		*!*	          REPLACE tmpWire_Log.company  WITH m.company
		*!*	          REPLACE tmpWire_Log.shipped  WITH m.shipped
		*!*	          REPLACE tmpWire_Log.shipdate WITH m.shipdate
		*!*	          REPLACE tmpWire_Log.SALESP   WITH m.SALESP
		*!*	          REPLACE tmpWire_Log.PO_NUM   WITH M.PO_NUM
		*!*	          REPLACE tmpWire_Log.SALEDATE WITH M.SALEDATE
		*!*	        ELSE
		*!*	          WAIT WINDOW 'DID NOT FIND SALES NUMBER'+STR(m.psalesnum) NOWAIT
		*!*	        ENDIF
		*!*	      ELSE
		*!*	        *WAIT WINDOW 'NO SALES NUMBER!!' NOWAIT
		*!*	        IF tmpWire_Log.salesnum = 0 AND NOT EMPTY(tmpWire_Log.company)
		*!*	          SELECT tmpWire_Log
		*!*	          REPLACE tmpWire_Log.company  WITH ""
		*!*	          REPLACE tmpWire_Log.shipped  WITH .F.
		*!*	          REPLACE tmpWire_Log.shipdate WITH CTOD("  /  /  ")
		*!*	          REPLACE tmpWire_Log.SALESP   WITH " "
		*!*	        ENDIF
		*!*	      ENDIF
		*!*	      SELECT tmpWire_Log
		*!*	      SKIP
		*!*	    ENDDO
		*!*	  ELSE
		*!*	    WAIT WINDOW 'COULD NOT OPEN INQSOLD' NOWAIT
		*!*	  ENDIF
		
		
		*!*	IF USED('INQSOLD')
		*!*	  USE IN Inqsold
		*!*	ENDIF
		*!*	SELECT tmpWire_Log
		
		*!*	GOTO M.CREC
		*!*	ThisForm.Refresh
	ENDPROC

