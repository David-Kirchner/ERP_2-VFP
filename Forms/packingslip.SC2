	PROCEDURE addressscreen
		PARAMETER WhereWhat
		
		DO CASE
			CASE WhereWhat = "SoldToEdit"
				ThisForm.pf1.pgSoldTo.cmdEditSoldTo.Caption = "Edit"
				ThisForm.pf1.pgSoldTo.cmdClearSold.Caption = "Clear"
				ThisForm.pf1.pgSoldTo.txtCompany.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtAddr1.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtAddr2.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtCity.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtST.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtZip.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtCountry.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtContact.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtPhone.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtFax.Enabled = .F.
				ThisForm.pf1.pgSoldTo.txtEmail.Enabled = .F.
				
				ThisForm.pf1.pgSoldTo.cmdSearchSoldTo.Enabled = .F.
				
				ThisForm.pf1.pgOverView.Enabled = .T.
		*		ThisForm.pf1.pgSoldTo.Enabled = .T.
				ThisForm.pf1.pgShipTo.Enabled = .T.
				ThisForm.pf1.pgOrderNumber.Enabled = .T.
				ThisForm.pf1.pgItems.Enabled = .T.
				ThisForm.pf1.pgWhatEver.Enabled = .T.
				ThisForm.pf1.pgFreight.Enabled = .T.
				
				ThisForm.cmdHome.Enabled = .T.
				ThisForm.cmdPrev.Enabled = .T.
				ThisForm.cmdNext.Enabled = .T.
				ThisForm.cmdPrint.Enabled = .T.
				ThisForm.cmdPrintBlank.Enabled = .T.
				ThisForm.cmdCancel.Enabled = .T.
				
			CASE WhereWhat = "SoldToSave"
				ThisForm.pf1.pgSoldTo.cmdEditSoldTo.Caption = "Save"
				ThisForm.pf1.pgSoldTo.cmdClearSold.Caption = "Abort"
				ThisForm.pf1.pgSoldTo.txtCompany.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtAddr1.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtAddr2.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtCity.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtST.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtZip.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtCountry.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtContact.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtPhone.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtFax.Enabled = .T.
				ThisForm.pf1.pgSoldTo.txtEmail.Enabled = .T.
				
