			*OR CustID = "FlowTN"
			SELECT PackingSlipItem	&&PackingSlip Reprint uses table PackingSlip
			REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE		&&Needs SOi_cmplt
			
			MESSAGEBOX("Please note that the 'TW Metals' Bar Code label needs to be placed near Packing Slip and both ends.",64,"Barcode Label")
		ENDIF
		
		*******************
		IF "SENOIR" $ UPPER(SoldAddr.Company) OR "SENOIR" $ UPPER(ShipAddr.Company) OR "SENOIR" $ UPPER(Bill3Addr.Company)
			SELECT PackingSlipItem	&&PackingSlip Reprint uses table PackingSlip
			REPORT FORM Reports\PackingSlip_BarCode FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
		ENDIF
		
		*******************
		
		*IF "Lockheed Martin" 
		*	PackingSlip Report now has Part Number as ScanCode
		
		*******************
		
		nMess = MESSAGEBOX("Did you get your Packing Slip print out?"+CHR(13)+"Please Cancel in Packing Slip History if you decide to throw away.",4+32,"Did the Packing Slip print?") 
		IF nMess = 7 &&no
			MESSAGEBOX( "Please try the print again!"+CHR(13)+CHR(13)+;
			  "This data is saved when there has been a succsefull print."+CHR(13)+;
			  "This data will be lost if you do not Print or answer 'NO' here."+CHR(13)+CHR(13)+;
			  "If you feel you have a good enough print and want to save and exit now, answer 'NO' below."+CHR(13)+;
			  "       --reprints can be performed using the Packing Slip History program."+CHR(13)+CHR(13)+;
			  "Answer 'YES' and the packing slip will NOT be saved until you 'PRINT'."+CHR(13)+CHR(13)+;
			  "Will you try the Print button again? ",0+32,"You answered that the Packing Slip did not print!") 
		ENDIF
		IF nMess <> 6
			ThisForm.ReverseSQL()
			TrackMess( "Before DELETE_PackingSli_from_PackingSlip_No: where PackingSli ="+STR(nPS_No)+" "+CHR(13)+SYS(16,1) )
			DELETE_PackingSli_from_PackingSlip_No( nPS_No,ThisForm.nConnHandle )
			
			TrackError("Packing Slip did not print"+CHR(13)+"nPS_No "+STR(nPS_No),"Packing Slip did not print", PROGRAM(), LINENO(1))
			RETURN -1  
		ENDIF
		*
		*
		*
		*
		*
		*
		*
		*
		*
		*
		*
		*
		*
		*
		*
		
		PRIVATE nPrintStdTerm, nSS_ID 
		nPrintStdTerm = 0
		nSS_ID = 0
		*IF nMess = 6 &&yes
			nSQLEXEC = 1
			
			*Save from Temp files.
		
			IF MESSAGEBOX("Do you want to print a 'Bill of Lading'?",4+32+256) = 6 &&yes
				
		*		SELECT Bill3Addr
				***************
				IF USED('Bill3Addr')
					SELECT Bill3Addr
				ELSE
					SELECT 0
				ENDIF
		
				cSQL="SELECT * FROM dbo.SoldAddr "
				IF THISFORM.Bill3Addr = 0
					cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0"
				ELSE
					cSQL = cSQL + " WHERE SoldCode = "+STR(THISFORM.Bill3Addr)
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Bill3Addr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Bill3Addr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Bill3Addr')
				ENDIF
				***************
				IF VARTYPE(plBOLWindfall) = 'U'
					PUBLIC plBOLWindfall
					plBOLWindfall = .T.
				ENDIF
				IF cShipFrom = "Windfall"
					plBOLWindfall = .T.
				ELSE
					IF cShipFrom = "Tipton"
						plBOLWindfall = .F.
					ELSE
						IF MESSAGEBOX("Will this BoL be from Windfall?"+CHR(13)+"Answer No to be from Tipton.",4+32,"BoL from Windfall?") = 6
							plBOLWindfall = .T.
						ELSE
							plBOLWindfall = .F.
						ENDIF
					ENDIF									
				ENDIF
					
				
				***************
				IF VARTYPE(plBOL3rdP) = 'U'
					PUBLIC plBOL3rdP
					plBOL3rdP = .F.
				ENDIF
				
				***************
		
				SELECT tmpLading
				GO TOP
				REPORT FORM Reports\BillofLading TO PRINTER PROMPT NOCONSOLE
				TrackMess("Print BoL on PackingSlip "+ALLTRIM(STR(ThisForm.PackingSlipNo))+", Bill 3 Addr "+ALLTRIM(STR(THISFORM.Bill3Addr)) )
			ENDIF
		
			PRIVATE nPU, nQTY, nLBS, nWeight
			nPU = 0
			nQTY = 0
			nLBS = 0
			nWeight = 0
			PRIVATE nPCs, lSOitem_Complete
			
			******************************************************
			** PackingSlipItem ***********************************
			******************************************************
			*Mark all Item records as complete where Complete is marked on one SOitem!
			SELECT DISTINCT SOitem FROM PackingSlipItem WHERE SOi_cmplt INTO CURSOR tmpComplete
			IF USED('tmpComplete')
				IF RECCOUNT('tmpComplete') > 0
					SCAN
						SELECT PackingSlipItem 
						*REPLACE COMPLETE WITH .T. FOR SOitem = tmpComplete.SOitem IN PackingSlipItem
						REPLACE SOi_cmplt WITH .T. FOR SOitem = tmpComplete.SOitem IN PackingSlipItem
						
						SELECT tmpComplete
					ENDSCAN
				ENDIF
				USE IN tmpComplete
			ENDIF
			*After fixing the Complete issue, scan all PackingSlipItem
			
			*Test for Complete again.
			SELECT PackingSlipItem
			SCAN
				cSOitem = PrepareSQLtxt(PackingSlipItem.SOItem,'SOItem',10)
				
				nPCs	= PrepareSQLnum(PackingSlipItem.Pcs,'PCs',-3)
				nQTY	= Calc_QTY(PackingSlipItem.Alloy,PackingSlipItem.Form,PackingSlipItem.Pcs,PackingSlipItem.DIM1,PackingSlipItem.DIM2,PackingSlipItem.DIM3,'',ThisForm.nConnHandle)
				nWeight	= PrepareSQLnum(PackingSlipItem.Weight,'Weight',9,1)
				***		
				
				lSOitem_Complete = IS_SOitem_Complete( cSOItem, nPCs, nQTY, nWeight, nPS_No, ThisForm.nConnHandle)
					*compare this PS_No QTY with shipped QTY of previous packings Slip and this SOitem
					
				*DO CASE
				*CASE PrepareSQLlogic(lSOitem_Complete,'SOitem_Complete')  &&Can be NULL from IS_SOitem_Complete()
				IF PrepareSQLlogic(lSOitem_Complete,'SOitem_Complete')  &&Can be NULL from IS_SOitem_Complete()
					* IS_SOitem_Complete() Thinks the SOitem is complete
					IF PackingSlipItem.SOi_cmplt			
						*Good
					ELSE
						*PackingSlip Operatort did not mark as Complete
						*Correct it
						
						*Show another screen to verify wether it is complets!
						**Show Item detail screen to review Quotes to pacing slip shipped, before saving!
						PRIVATE nReturn
						nReturn = 0
						DO FORM Forms\Show_Ship_Order WITH "SOitem",cSOitem to nReturn
							*nReturn=1 Not Complete
							*nReturn=2 Complete
							*nReturn=3 Just view
							*nReturn=4 Saved as Complete
							
						nReturn = PrepareSQLnum(nReturn,'nReturn',-3)
						IF nReturn = 4 OR nReturn = 2
							TrackMess("SOitem:"+cSOItem+" has a packing Slip "+ALLTRIM(STR(nPS_NO))+", but was not marked as 'Complete' untill 'Show_Ship_Order' was run. Sent "+ALLTRIM(STR(PackingSlipItem.PCs))+" Pcs.")
						
							SELECT PackingSlipItem  
							REPLACE SOi_cmplt WITH .T. IN PackingSlipItem
						ENDIF
					
					
					ENDIF
					
				*CASE NOT PrepareSQLlogic(lSOitem_Complete,'SOitem_Complete')  &&Can be NULL
				ELSE
					* IS_SOitem_Complete() Thinks the SOitem is NOT complete
					IF PackingSlipItem.SOi_cmplt			
						*Check with user. User said Complete and IS_SOitem_Complete says not Complete
						
						*Show another screen to verify wether it is complets!
						**Show Item detail screen to review Quotes to pacing slip shipped, before saving!
						PRIVATE nReturn
						nReturn = 0
						DO FORM Forms\Show_Ship_Order WITH "SOitem",cSOitem to nReturn
							*nReturn=1 Not Complete
							*nReturn=2 Complete
							*nReturn=3 Just view
							*nReturn=4 Saved as Complete
							
						nReturn = PrepareSQLnum(nReturn,'nReturn',-3)
						IF nReturn = 1
							*TrackMess("SOitem:"+cSOItem+" has a packing Slip "+ALLTRIM(STR(nPS_NO))+", but was not marked as 'Complete' untill 'Show_Ship_Order' was run. Sent "+ALLTRIM(STR(PackingSlipItem.PCs))+" Pcs.")
						
							SELECT PackingSlipItem  
							REPLACE SOi_cmplt WITH .F. IN PackingSlipItem
						ENDIF
						
					ELSE
						*Good
					ENDIF
				ENDIF
					
			ENDSCAN
			
			********
			
			
			
			************************************************
			************************************************
			* the big save
			************************************************
			************************************************
			
			
			
			PRIVATE ldShip
			PRIVATE nTmpPSnum
			nTmpPSnum = PrepareSQLnum(PackingSlipItem.tmpPSnum,'tmpPSnum',-3)
			PRIVATE cWhere, nID_Packing
			cWhere = '' 
			nID_Packing = 0
			
			*Save the Packing Slip
			SELECT PackingSlipItem
			GO TOP
			
			
			SCAN
				*Kg calculated here
				nLBS = IIF(PackingSlipItem.Kg,PackingSlipItem.Weight*2.2,PackingSlipItem.Weight)
					
				nPU = GetPUfromForm( PackingSlipItem.Form, ThisForm.nConnHandle )
				DO CASE
				CASE nPU = 1
					*nQTY is Weight in LBS
					nQTY = nLBS
				CASE nPU = 2
					*nQTY = Feet
					IF Uses3rdDim( PackingSlipItem.Form, ThisForm.nConnHandle)
				 		nQTY  = PackingSlipItem.Pcs * (PackingSlipItem.Dim3 / 12)
				 	ELSE
				 		nQTY  = PackingSlipItem.Pcs * (PackingSlipItem.Dim2 / 12)
				 	ENDIF
				CASE nPU = 3
					*nQTY is PCs
					nQTY  = PackingSlipItem.Pcs 
				OTHERWISE
					nQTY  = 0
				ENDCASE
				
				
				***		
				cSOitem = PrepareSQLtxt(PackingSlipItem.SOItem,'SOItem',10)
				nPCs	= PrepareSQLnum(PackingSlipItem.Pcs,'PCs',-3)
				ldShip = ( Count_SOIteminSales(cSOitem, ThisForm.nConnHandle, 'dShip') > 0 )
				
				PRIVATE nSL_Paid, nBook_P, nSales_Stock_ID, cTBL, nID_Detail, nSOi_QTY, nCust_P, nSL_P, nSales_Detail_ID
				nSales_Stock_ID = PrepareSQLnum(PackingSlipItem.SS_ID,'SS_ID',-3)
				cTBL 		= PrepareSQLtxt(PackingSlipItem.TBL,'TBL',1)
				nID_Detail	= PrepareSQLnum(PackingSlipItem.Sl_ID,'ID_Detail',-3)
				nSL_Paid = 0
				IF nID_Detail > 0
					nSL_Paid = get_PricePaid_ID_Detail(cTBL, nID_Detail, ThisForm.nConnHandle)
					*nSL_Paid = getStkPaid_SOitem(cTBL, nID_Detail, ThisForm.nConnHandle)
				ENDIF
				nBook_P		= getBookPrice_SOitem(cSOitem, ThisForm.nConnHandle)  &&CalcPriceCL
				nSOi_QTY	= getQTY_SOitem(cSOitem, ThisForm.nConnHandle)
				nCust_P		= getCust_P_SOitem(cSOitem, ThisForm.nConnHandle)
				nCust_PU	= getCust_PU_SOitem(cSOitem, ThisForm.nConnHandle)
				nCust_QTY	= getCust_QTY_SOitem(cSOitem, ThisForm.nConnHandle)
				
				*Get nSL_P
				nSL_ID_Detail = PrepareSQLnum(PackingSlipItem.SL_ID_D,'ID_Detail',-3)
				nSL_P = 0
				IF nSL_ID_Detail > 0
					nSL_P	= get_Price_ID_Detail('S', PackingSlipItem.SL_ID_D, ThisForm.nConnHandle )
				ELSE
					IF nID_Detail > 0
						nSL_P	= get_Price_ID_Detail('S', nID_Detail, ThisForm.nConnHandle )
					ENDIF
				ENDIF
				
				nSales_Detail_ID = get_SD_ID(cSOitem,PackingSlipItem.TBL,PackingSlipItem.SL_ID,PackingSlipItem.SL_ID_D,PackingSlipItem.ID_D_Proc,ThisForm.nConnHandle)
				
		*		nQShipped	= get_SOitem_PCs_Complete( cSOitem, nPCs, nPS_No, ThisForm.nConnHandle )
		*		IF NOT nQshipped = PrepareSQLnum(PackingSlipItem.qShipped,'qShipped',-3)
		*			REPLACE qShipped WITH nQShipped IN PackingSlipItem
		*		ENDIF
					
				SELECT PackingSlipItem
				***
				cDescription = PrepareSQLtxt(PackingSlipItem.DESCRIPT,'Decription',80)
				*Field SOitem_Cmplt is too long to be used in FoxPro cursor, use SOi_cmplt
				cSQL = "INSERT INTO dbo.PackingSlip ("
				cSQL=cSQL+" PackingSli"
				cSQL=cSQL+",PCs"
				cSQL=cSQL+",Descript"
				cSQL=cSQL+",SOItem"
		
				cSQL=cSQL+",PO_Num"
				cSQL=cSQL+",Heat"
				cSQL=cSQL+",Lot"
				cSQL=cSQL+",Weight"
				cSQL=cSQL+",Kg"
				cSQL=cSQL+",Alloy"
				cSQL=cSQL+",PartNo"
				
				cSQL=cSQL+",Sales_Detail_ID"
				cSQL=cSQL+",SOitem_cmplt"
		*		cSQL=cSQL+",First_RSO"
				
				cSQL = cSQL + " ) VALUES ("
				cSQL = cSQL + " "+STR(nPS_No)
				cSQL = cSQL + ","+STR(PackingSlipItem.PCs)
				cSQL = cSQL + ",'"+cDescription+"'"
				cSQL = cSQL + ",'"+PackingSlipItem.SOItem+"'"
		
				cSQL = cSQL + ",'"+PackingSlipItem.PO_Num+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(PackingSlipItem.Heat,"Heat",50)+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(PackingSlipItem.Lot,"Lot",10)+"'"
				cSQL = cSQL + ","+STR(PackingSlipItem.Weight,7,1)+"" 
				cSQL = cSQL + ","+IIF(PackingSlipItem.Kg,'1','0')+""
				cSQL = cSQL + ",'"+PrepareSQLtxt(PackingSlipItem.Alloy,"Alloy",12)+"'"	
				cSQL = cSQL + ",'"+PrepareSQLtxt(PackingSlipItem.PartNo,"PartNo",100)+"'"
				
				cSQL=cSQL+","+PrepareSQLtxt(PackingSlipItem.SS_ID,'Sales_Detail_ID',10)	&&Sales_Detail_ID
				cSQL=cSQL+",'"+IIF(PackingSlipItem.SOi_cmplt,'1','0')+"'"		&&SOitem_cmplt
		*		cSQL=cSQL+",First_RSO GETDATE()
		  	
				cSQL = cSQL + ")"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				ENDIF
				
				
				**************************
				* now get nID_Packing
				
				PRIVATE cWhere
				cWhere=" PackingSli="+STR(nPS_No)
				cWhere=cWhere+" AND PCs="+STR(PackingSlipItem.PCs)
				cWhere=cWhere+" AND Descript='"+cDescription+"'"
				cWhere=cWhere+" AND SOItem='"+PackingSlipItem.SOItem+"'"
				cWhere=cWhere+" AND PO_Num='"+PackingSlipItem.PO_Num+"'"
				cWhere=cWhere+" AND Heat='"+PrepareSQLtxt(PackingSlipItem.Heat,"Heat",50)+"'"
				cWhere=cWhere+" AND Lot='"+PrepareSQLtxt(PackingSlipItem.Lot,"Lot",10)+"'"
				cWhere=cWhere+" AND Weight="+STR(PackingSlipItem.Weight,7,1)
				cWhere=cWhere+" AND Kg="+IIF(PackingSlipItem.Kg,'1','0')+""
				cWhere=cWhere+" AND Alloy='"+PrepareSQLtxt(PackingSlipItem.Alloy,"Alloy",12)+"'"	
				cWhere=cWhere+" AND PartNo='"+PrepareSQLtxt(PackingSlipItem.PartNo,"PartNo",100)+"'"
						
				cWhere=cWhere+" AND Sales_Detail_ID="+PrepareSQLtxt(PackingSlipItem.SS_ID,'Sales_Detail_ID',10)
				cWhere=cWhere+" AND SOitem_cmplt='"+IIF(PackingSlipItem.SOi_cmplt,'1','0')+"'"
		
				
				nID_Packing = ThisForm.get_ID_Packing(cWhere)
				
				
				*--Scan PackingSlipItem
				********************************************
				*Save to Sales
				********************************************
				IF Count_SOIteminSales(PackingSlipItem.SOItem, ThisForm.nConnHandle) > 0 
					*need a lSOi_cmplt check here because this is the only field to be updated.
					IF PackingSlipItem.SOi_cmplt
						
						*SO exists in Sales
						cSQLu = "UPDATE dbo.Sales SET "
						*cSQLu = cSQLu +",MatlWt = "+STR(nLBS ,7,1)+""
						*IF NOT EMPTY(dShipDate)
						*	cSQLu = cSQLu +",Shipped = '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
						*ENDIF
						**Only Update a Complete as a True, do not write a False
						IF PackingSlipItem.SOi_cmplt
							cSQLu = cSQLu +"[Cmplt] = "+IIF(PackingSlipItem.SOi_cmplt,'1','0')
						ENDIF
						cSQLu = cSQLu +" WHERE Sales.SOItem = '"+PackingSlipItem.SOItem+"'"
						*RVW_Stock, RVW_Prod, Review_Date
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
						ENDIF		
					ENDIF
				ELSE
					cSQL = "INSERT INTO dbo.Sales "
					cSQL = cSQL + "( SOitem, SalesNum, Heat, Shipped, MatlWt, Cmplt ) VALUES ("
					cSQL = cSQL + " '"+PackingSlipItem.SOItem+"'"
					cSQL = cSQL + ","+STR(PackingSlipItem.SalesNum)
					cSQL = cSQL + ",'"+PrepareSQLtxt(PackingSlipItem.Heat,"Heat",50)+"'"
					cSQL = cSQL + ",'"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
					cSQL = cSQL + ","+STR(nLBS ,7,1)
					cSQL = cSQL + ","+IIF(PackingSlipItem.SOi_cmplt,'1','0')
					cSQL = cSQL + ")"
					*RVW_Stock, RVW_Prod, Review_Date
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'')
					ENDIF
					
				ENDIF
				
				********************************************
				*Get Customer Quote
				PRIVATE nCust_PU, nCust_P, nCust_QTY, nCust_Total
				nCust_PU 	= getCust_PU_SOitem (PackingSlipItem.SOitem,ThisForm.nConnHandle)
				nCust_P		= getCust_P_SOitem (PackingSlipItem.SOitem,ThisForm.nConnHandle)
				nCust_QTY	= getCust_Qty_SOitem (PackingSlipItem.SOitem,ThisForm.nConnHandle)
				nCust_Total	= (nCust_P * nCust_QTY)
				
				********************************************
				*for each PackingSlipItem
				********************************************
				
				cSQL = "INSERT INTO dbo.Sales_PS ( "
				cSQL = cSQL + " ID_Packing "
				cSQL = cSQL + ",PackingSli "
				
		  		cSQL = cSQL + ",SOitem"
		  		cSQL = cSQL + ",SalesNum"
		  		cSQL = cSQL + ",[Acct_PU]"
		  		cSQL = cSQL + ",[Acct_QTY]"
		  		cSQL = cSQL + ",[Acct_P]"
		  		cSQL = cSQL + ",[Pounds]"
		  		
		    	cSQL = cSQL + ",[Cust_PU]"
		  		cSQL = cSQL + ",[Cust_QTY]"
