		ENDIF
		***************
		IF USED('ShipAddr')
			SELECT ShipAddr
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.ShipAddr "
		IF THISFORM.ShipAddr= 0
			cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0"
		ELSE
			cSQL = cSQL + " WHERE ShipCode = "+STR(THISFORM.ShipAddr)
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		ENDIF
		***************
		IF USED('Bill3Addr')
			SELECT Bill3Addr
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.SoldAddr WHERE WITH(NOLOCK) "
		IF THISFORM.Bill3Addr = 0
			cSQL = cSQL + "0>0"
		ELSE
			cSQL = cSQL + " SoldCode = "+STR(THISFORM.Bill3Addr)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Bill3Addr')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Bill3Addr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Bill3Addr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Bill3Addr')
		ENDIF
		***********************
		IF NOT USED('tmpSales')
			PRIVATE cAll_SO
			cAll_SO	= PrepareSQLtxt(PackingSlip_no.All_SO,'All_SO',-1)
			*IF NOT EMPTY(  )
			IF LEN(cAll_SO) > 0
		
				SELECT 0
				cSQL="SELECT * FROM dbo.Sales WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SalesNum IN ("+cAll_SO+")"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'tmpSales')
				ENDIF
			ENDIF		
		ENDIF
		
		***********************
		
		SELECT PackingSlipItem
		
		IF FILE('Reports\PackingSlip.FRX')
			MESSAGEBOX("Please Choose a Printer that can send a FAX."+CHR(13)+"Fax number:"+cFax,0,"Print to Fax Printer.")
			REPORT FORM Reports\PackingSlipFax FOR PackingSlipItem.PackingSli = ThisForm.PackingSlipNo  NOCONSOLE TO PRINTER Prompt
		ELSE
			WAIT WINDOW "Report form 'Reports\PackingSlip' not found" NOWAIT
		ENDIF
		
		
		SET PRINTER OFF
		SET PRINTER TO DEFAULT
		
		WAIT WINDOW 'Fax routine done' NOWAIT
		
	ENDPROC

	PROCEDURE showsalesorderitemsgrd
		PARAMETER pAction
		*ThisForm.ShowSalesOrderItemsGrd( 'NoFocus' )
		
		IF TYPE('pAction') != "C" 
			pAction = ""
		ENDIF
		
		**Build the WHERE clause
		PRIVATE lFoundSO
		lFoundSO = .F.
		PRIVATE msql, m.so_where
		m.so_where = ""
		
		SELECT PackingSlipSO
		DIMENSION aSO_Posted( RECCOUNT('PackingSlipSO'),2 )
		nCnt = 0
		SCAN
			nCnt = nCnt + 1
			aSO_Posted( nCnt, 1) = PrepareSQLtxt(tmpSalesNum.SOitem,'SOitem',10)
			aSO_Posted( nCnt, 2) = PrepareSQLtxt(tmpSalesNum.Posted,'Posted',1)
			
			IF PackingSlipSO.SO > 0
				lFoundSO = .T.
				IF NOT EMPTY(m.so_where)
					m.so_where = m.so_where + " OR "
				ELSE
					*first time
					m.so_where = " WHERE "
				ENDIF
				m.so_where = m.so_where + "AQ.SALESNUM = "+ALLTRIM(STR(PackingSlipSO.SO,10,0))
			ENDIF
		ENDSCAN
		
		ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.RECORDSOURCE	=''
		
		
		IF USED('tmpSalesNum')
			USE IN tmpSalesNum
		ENDIF
		SELECT 0
		
		*make Chages in Load Also
		PRIVATE cSQL, nSQLEXEC
		cSQL =   " SELECT AQ.SOitem,AQ.Alloy,AQ.Form,AQ.Pieces,AQ.Weight,AQ.Descript "
		
		*cSQL =cSQL+",dbo.f_Descript(AQ.Alloy,AQ.CC,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS AQDescript "
		cSQL =cSQL+",dbo.f_ItemDescription(AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS ItemDescription"
		cSQL =cSQL+",CAST(AQ.Comments AS CHAR(100)) AS Comment "
		cSQL =cSQL+",AQ.HPAPO,'N' AS Posted,ISNULL(S.cncld,0) AS CnCld "
		cSQL =cSQL+",AQ.InqNum,AQ.SalesP,AQ.Item,AQ.Salesnum,AQ.PO_num "
		cSQL =cSQL+",AQ.Metric,AQ.InqnumP,AQ.CC,AQ.CL "
		cSQL =cSQL+",AQ.Thck,AQ.Sz2,AQ.Sz3 "
		cSQL =cSQL+",S.dShip "
		cSQL =cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
		cSQL =cSQL+" INNER JOIN dbo.Sales S ON AQ.SOitem = S.SOitem "
		cSQL =cSQL+  m.so_where
		cSQL =cSQL+" ORDER BY AQ.SOitem "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesNum')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSalesNum')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesNum')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesNum')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesNum")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesNum")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesNum')
		ENDIF
		
		PRIVATE nScan1, cPosted
		PRIVATE nCountShip, cSOitem
		
		IF USED('tmpSalesNum')
			SELECT tmpSalesNum
			GO TOP
			
			
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.ReadOnly = .T.
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.ENABLED = .T.
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.VISIBLE = .T.
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.cmdSelectSOitem.VISIBLE = .T.
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.RECORDSOURCE = 'tmpSalesNum'
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.REFRESH()
			
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.lbldShip.Visible = PrepareSQLbit(tmpSalesNum.dShip,'dShip')
			
			
			SELECT tmpSalesNum
			SCAN
				cSOitem = PrepareSQLtxt(tmpSalesNum.SOitem,'SOitem',10)
				nCountShip = Count_ShipbySOitem( cSOitem, ThisForm.nConnHandle, "COMPLETE" )
				IF nCountShip >= 1
					REPLACE tmpSalesNum.Posted WITH 'Y' FOR SOitem = cSOitem
					LOOP
				ENDIF
				
				nScan1 = ASCAN(aSO_Posted, cSOitem, -1, -1, 1)
				IF nScan1 > 0
					cPosted = aSO_Posted(nScan1,2)
		
					IF cPosted = "Y"
						REPLACE tmpSalesNum.Posted WITH 'Y' FOR SOitem = cSOitem
					ENDIF
				ENDIF
			ENDSCAN
			
			GO TOP IN tmpSalesNum
			
			IF pAction != 'NoFocus'
				ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.ZORDER()
				ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.SetFocus()
			ENDIF
		*	USE IN tmpSalesNum
		ELSE
		
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.VISIBLE = .F.
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.grdInq.ENABLED = .F.
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.cmdSelectSOitem.VISIBLE = .F.
			ThisForm.pf1.pgItems.pf_SO_Items.pg_SO_items.lbldShip.Visible = .F.
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Unload
		** Private Data Session **
		*RELEASE aShipFrom()
		
		IF ThisForm.Close_Ship
			IF USED('SHIP')
				USE IN SHIP
			ENDIF
		ENDIF
		
		IF ThisForm.Close_PackingSlip 
			IF USED('PackingSlip')
				USE IN PackingSlip
			ENDIF
		ENDIF
		
		IF ThisForm.Close_Sales
			IF USED('Sales')
				USE IN Sales
			ENDIF
		ENDIF
		
		IF ThisForm.Close_Sales_No
			IF USED('Sales_No')
				USE IN Sales_No
			ENDIF
		ENDIF
		
		IF ThisForm.Close_ShipAddr
			IF USED('ShipAddr')
				USE IN ShipAddr
			ENDIF
		ENDIF
		
		IF ThisForm.Close_Sold_Ship
			IF USED('Sold_Ship')
				USE IN Sold_Ship
			ENDIF
		ENDIF
		
		IF ThisForm.Close_Bill3Addr
			IF USED('Bill3Addr')
				USE IN Bill3Addr 
			ENDIF
		ENDIF
		IF ThisForm.Close_SoldAddr 
			IF USED('SoldAddr')
				USE IN SoldAddr 
			ENDIF
		ENDIF
		
		IF ThisForm.Close_AllQuotes
			IF USED('AllQuotes')
				USE IN AllQuotes
			ENDIF
		ENDIF
		IF ThisForm.Close_Lading
			IF USED('Lading')
				USE IN Lading
			ENDIF
		ENDIF
		*************************************
		IF USED('PackingSlipItem')
			USE IN PackingSlipItem
			UniqDBFdel(ThisForm.Uniq_PSI)
			*UniqDBFdel(ThisForm.PSI_SOItem)
			*UniqDBFdel(ThisForm.S_SOItem)
			
		ENDIF
		
		IF USED("PackingSlipPO")
			USE IN PackingSlipPO
			UniqDBFdel(ThisForm.Uniq_PPO)
		ENDIF
		IF USED("PackingSlipSO")
			USE IN PackingSlipSO
			UniqDBFdel(ThisForm.Uniq_PSO)
		ENDIF
		
		IF USED('PackingSlip_NO')
			USE IN PackingSlip_NO
		ENDIF
		*!*	IF USED('PackingSlip')
		*!*		USE IN PackingSlip
		*!*	ENDIF
		IF USED('SoldAddrCode')
			USE IN SoldAddrCode
		ENDIF
		IF USED('ShipAddrCode')
			USE IN ShipAddrCode
		ENDIF
		IF USED('tempBillAddr')
			USE IN tempBillAddr
		ENDIF
		IF USED('tempShipAddr')
			USE IN tempShipAddr
		ENDIF
		IF USED('tempCustID')
			USE IN tempCustID
		ENDIF
		IF USED('tmpSalesNum')
			USE IN tmpSalesNum
		ENDIF
		IF USED('tmpSales')
			USE IN tmpSales
			UniqDBFdel(ThisForm.Uniq_SAL)
		ENDIF
		IF USED('tmpLading')
			USE IN tmpLading
			UniqDBFdel(ThisForm.Uniq_LAD)
		ENDIF
		
		
		
		
		IF USED("tmpPSItem")
			USE IN tmpPSItem
			UniqDBFdel(ThisForm.Uniq_PSItem)
		ENDIF
		
		IF USED("tmpQuote")
			USE IN tmpQuote
			UniqDBFdel(ThisForm.Uniq_Quote)
		ENDIF
		
		
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdCancel.Click
		IF ThisForm.cmdPrint.Enabled
			IF MESSAGEBOX("Are you sure you want to discard this data?",4+32,"Not Saved!") = 7
				RETURN .F.
			ENDIF
		ENDIF
		
		ThisForm.ReverseSQL()
		
		&& leave if yes
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdHome.Click
		ThisForm.pf1.pgOverView.Zorder
		ThisForm.pf1.pgOverView.Click
		ThisForm.CurrPage = 1
		ThisForm.Refresh()
	ENDPROC

	PROCEDURE cmdNext.Click
		DO CASE
			CASE ThisForm.CurrPage = 1
				ThisForm.CurrPage = 2
				ThisForm.pf1.pgSoldTo.Zorder
				ThisForm.pf1.pgSoldTo.Click
				ThisForm.pf1.pgSoldTo.cmdEditSoldTo.SetFocus()
			CASE ThisForm.CurrPage = 2
				ThisForm.CurrPage = 3
				ThisForm.pf1.pgShipTo.Zorder
				ThisForm.pf1.pgShipTo.Click
				ThisForm.pf1.pgShipTo.cmdEditShipTo.SetFocus()
			CASE ThisForm.CurrPage = 3
				ThisForm.CurrPage = 4
				ThisForm.pf1.pgOrderNumber.Zorder
				ThisForm.pf1.pgOrderNumber.Click
			CASE ThisForm.CurrPage = 4
				ThisForm.CurrPage = 5
				ThisForm.pf1.pgItems.Zorder
				ThisForm.pf1.pgItems.Click
			CASE ThisForm.CurrPage = 5
				ThisForm.CurrPage = 6
				ThisForm.pf1.pgFreight.Zorder		
				ThisForm.pf1.pgFreight.Click
			CASE ThisForm.CurrPage = 6
				ThisForm.CurrPage = 7
				ThisForm.pf1.pgWhatEver.Zorder
				ThisForm.pf1.pgWhatEver.Click
			CASE ThisForm.CurrPage = 7
				* already at end
		ENDCASE
		ThisForm.Refresh()
	ENDPROC

	PROCEDURE cmdPrev.Click
		DO CASE
		CASE ThisForm.CurrPage = 1
			*already there
			ThisForm.pf1.pgOverView.Zorder
		CASE ThisForm.CurrPage = 2
			ThisForm.CurrPage = 1
			ThisForm.pf1.pgOverView.Zorder
			ThisForm.pf1.pgOverView.Click
		CASE ThisForm.CurrPage = 3
			ThisForm.CurrPage = 2
			ThisForm.pf1.pgSoldTo.Zorder
			ThisForm.pf1.pgSoldTo.Click
		CASE ThisForm.CurrPage = 4
			ThisForm.CurrPage = 3
			ThisForm.pf1.pgShipTo.Zorder
			ThisForm.pf1.pgShipTo.Click
		CASE ThisForm.CurrPage = 5
			ThisForm.CurrPage = 4
			ThisForm.pf1.pgOrderNumber.Zorder
			ThisForm.pf1.pgOrderNumber.Click
		CASE ThisForm.CurrPage = 6
			ThisForm.CurrPage = 5
			ThisForm.pf1.pgItems.Zorder
			ThisForm.pf1.pgItems.Click
		CASE ThisForm.CurrPage = 7
			ThisForm.CurrPage = 6
			ThisForm.pf1.pgFreight.Zorder		
			ThisForm.pf1.pgFreight.Click
		
		*	ThisForm.pf1.pgWhatEver.Zorder
		*	ThisForm.pf1.pgWhatEver.Click
		
		ENDCASE
		ThisForm.Refresh()
	ENDPROC

	PROCEDURE cmdPrint.Click
		IF ThisForm.Check2Save()
		
		ELSE
			Return -1
		ENDIF
		
		PRIVATE msettalk, msetdeci
		
		
		PRIVATE ll2Blind, ll2Fax, ll2Email
		PRIVATE cSQL_Process_U, cSQL_Process_HU
		
		
		
		
		*!*	IF !USED('Ship')
		*!*		USE HPA!Ship SHARED IN 0
		*!*	ENDIF
		
		
		
		**This was removed in version 3.8.38 but is required below. Re-adding
		**********************************************************************************************************************************************
		PRIVATE dShipDate
		dShipDate = PrepareSQLdate(THISFORM.pf1.pgWhatEver.txtShipDate.VALUE,'ShipDate')
		IF dShipDate = CTOD('1900-01-01')
			dShipDate  =  DATE()
		ENDIF
		IF EMPTY(dShipDate)
			dShipDate  =  DATE()
		ENDIF
		
		PRIVATE cTracking, cShippedVia
		cTracking = UPPER(ALLTRIM(PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtTracking.VALUE,'Tracking',30)))
		cShippedVia	= PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtshippedvia.VALUE,'ShippedVia',20)
		
		IF "UPS" $ UPPER(cShippedVia)
			IF LEN(cTracking) = 18
				IF LEFT(cTracking,8) = "1Z740338" OR LEFT(cTracking,8) = "1Z4F942R"
					*correct tracking
				ELSE
					IF MESSAGEBOX("UPS tracking number "+cTracking+" is bad."+CHR(13)+"to ship from HPA you would use UPS Code:"+CHR(13)+"'1Z740336' OR '1Z4F942R'"+CHR(13)+CHR(13)+" Enter (Y)es to go back and Edit.",4+48,"Edit Tracking Number?") = 6
						RETURN -1
					ENDIF
				ENDIF
			ELSE
				IF EMPTY(cTracking)
					MESSAGEBOX("Please Enter the UPS tracking number!",0,"No tracking!")
				ELSE
					IF MESSAGEBOX("UPS tracking number "+cTracking+" is bad."+CHR(13)+CHR(13)+" Enter (Y)es to go back and Edit.",4+48,"Edit Tracking Number?") = 6
						RETURN -1
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		
		**end data Check
		**********************************************************************************************************************************************
		
		PRIVATE nshipcode, nsoldcode, cpackedby, ccheckedby, ccarton, cbox_size
		PRIVATE cTotalPackWeight, lKgTPK, cAll_PO, cAll_SO, nTotalPackedWeight
		
		nshipcode 	= THISFORM.ShipAddr
		nsoldcode 	= THISFORM.SoldAddr
		cpackedby 	= PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtPackedBy.VALUE,'PackedBy',10)
		ccheckedby	= PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtCheckedBy.VALUE,'CheckedBy',10)
		ccarton		= PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtCarton.VALUE,'Carton',10)
		cbox_size	= PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtPackage.VALUE,'Box_Size',60)
		cTotalPackWeight= PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtTotalweight.VALUE,'TotalWeight',9)
		lKgTPK		= PrepareSQLchk(ThisForm.pf1.pgWhatEver.chkKgTPK.Value,'Kg')
		cAll_PO 	= THISFORM.ReturnAll('PO')
		cAll_SO 	= THISFORM.ReturnAll('SO')
		
		
		nTotalPackedWeight = VAL(cTotalPackWeight)
		
		PRIVATE nFreightCharge
		IF NOT EMPTY(THISFORM.pf1.pgFreight.ogFreightCharges.VALUE)
			nFreightCharge = THISFORM.pf1.pgFreight.ogFreightCharges.VALUE
		ELSE
			IF NOT EMPTY(THISFORM.pf1.pgWhatEver.txtFreightEst.VALUE)
				nFreightCharge = THISFORM.pf1.pgWhatEver.txtFreightEst.VALUE
			ELSE
				nFreightCharge = 0
			ENDIF
		ENDIF
		
		PRIVATE nDutyTax
		nDutyTax = THISFORM.pf1.pgFreight.ogDutyTax.VALUE
		
		PRIVATE nbill3code
		IF THISFORM.pf1.pgFreight.ogFreightCharges.VALUE = 3
			nbill3code = THISFORM.Bill3Addr
		ELSE
			nbill3code = 0
		ENDIF
		
		PRIVATE lCOD, nCODCheck, nCODFreightFee
		IF THISFORM.pf1.pgFreight.chkCOD.VALUE = 1
			lCOD = .T.
			nCODCheck 		= THISFORM.pf1.pgFreight.ogCheck.VALUE
			nCODFreightFee 	= THISFORM.pf1.pgFreight.ogCODFreightFee.VALUE
		ELSE
			lCOD = .F.
			nCODCheck 		= 0
			nCODFreightFee 	= 0
		ENDIF
		
		**************************************
		IF USED('PackingSlip_No_ID')
			USE IN PackingSlip_No_ID
		ENDIF
		SELECT 0
		
		PRIVATE cSQLi
		cSQLi = "EXEC dbo.p_PackingSlip_No_ins "
		cSQLi = cSQLi+ " @ps_Date ='"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
		cSQLi = cSQLi+ ",@ShipCode ="+STR(nShipCode)+""
		cSQLi = cSQLi+ ",@SoldCode ="+STR(nSoldCode)+""
		cSQLi = cSQLi+ ",@Bill3Code ="+STR(nbill3code)+""
		cSQLi = cSQLi+ ",@PackedBy ='"+cpackedby+"'"   
		cSQLi = cSQLi+ ",@CheckedBy ='"+ccheckedby+"'"   
		cSQLi = cSQLi+ ",@Carton ='"+ccarton+"'"   
		cSQLi = cSQLi+ ",@TotalWeight='"+cTotalPackWeight+"'"   &&Packed Weight
		cSQLi = cSQLi+ ",@Kg="+IIF(lKgTPK,'1','0')
		cSQLi = cSQLi+ ",@ShippedVia='"+cShippedVia+"'"   
		cSQLi = cSQLi+ ",@All_Po='"+cAll_PO+"'"   	
		cSQLi = cSQLi+ ",@All_So='"+cAll_SO+"'"   	
		cSQLi = cSQLi+ ",@Tracking='"+ctracking+"'"   	
		cSQLi = cSQLi+ ",@FreightCharge="+STR(nFreightCharge)+""
		cSQLi = cSQLi+ ",@DutyTax="+STR(nDutyTax)+""
		cSQLi = cSQLi+ ",@COD="+IIF(lCOD,'1','0')
		cSQLi = cSQLi+ ",@CODCheck="+STR(nCODCheck)+""
		cSQLi = cSQLi+ ",@CODFreightFee="+STR(nCODFreightFee)+""
		cSQLi = cSQLi+ ",@Box_Size='"+cbox_size+"'"   	
		cSQLi = cSQLi+ ",@PackedWeight ="+STR(nTotalPackedWeight)+""	
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'PackingSlip_No_ID' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'PackingSlip_No_ID' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'PackingSlip_No_ID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'PackingSlip_No_ID')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "PackingSlip_No_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "PackingSlip_No_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'PackingSlip_No_ID')
		ENDIF
		
		
		PRIVATE nPS_NO
		nPS_NO = 0
		ThisForm.PackingSlipNo = 0
		IF USED('PackingSlip_No_ID')
			*nPS_NO = GetMaxPackinSliinPackingSlip_No()
			ThisForm.PackingSlipNo = PackingSlip_No_ID.EXP
			nPS_No = PackingSlip_No_ID.EXP
			USE IN PackingSlip_No_ID
		ENDIF
		IF ThisForm.PackingSlipNo = 0
			MESSAGEBOX("Could not Save to PackingSlip_No",0+16,"SQL Error")
			RETURN -1
		ENDIF
		
		PRIVATE cShipFrom
		cShipFrom = PrepareSQLtxt(ThisForm.pf1.pgWhatEver.cmbShipFrom.DisplayValue,'ShipFrom',20)
		
		PRIVATE cSQL
		
		IF nPS_NO > 0
			*Saved!!!
			*update columns not in p_PackingSlip_No_ins 
			cSQL="UPDATE dbo.PackingSlip_No "
			cSQL=cSQL+" SET [ShipFrom]='"+cShipFrom+"' "
			cSQL=cSQL+" ,[RSO_Date]=GETDATE() "
			cSQL=cSQL+" ,[PW_ready]=0 "		&&Default to False
			cSQL=cSQL+" ,[PW_verified]=0 "
		
			cSQL=cSQL+" WHERE PackingSli = "+STR(nPS_NO)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		***********************************************************************
		PRIVATE nDecValue, nbil3code, cFrtCharges 
		PRIVATE cDutyTaxText, lCOD, lCODFrtColl, lCODCertChk
		nDecValue = 0
		nbil3code = 0
		cFrtCharges = ""
		cDutyTaxText = ""
		lCOD = .F.
		lCODFrtColl = .F.
		lCODCertChk = .F.
		
		PRIVATE cDescription 
		
		IF NOT EMPTY(ThisForm.pf1.pgFreight.txtDecValue.Value)
			vDecValue = ThisForm.pf1.pgFreight.txtDecValue.Value
			IF TYPE("vDecValue")="N"
				nDecValue = vDecValue
			ELSE
				IF TYPE("vDecValue")="C"
					nDecValue = VAL(vDecValue)
				ENDIF
			ENDIF
		ENDIF
		
		IF nbill3code = 3
			nbil3code = THISFORM.Bill3Addr
		ELSE
			nbil3code = 0	
		ENDIF
		
		DO CASE
		CASE ThisForm.pf1.pgFreight.ogFreightCharges.Value = 1
			cFrtCharges = "COLLECT"
		CASE ThisForm.pf1.pgFreight.ogFreightCharges.Value = 2
			cFrtCharges = "PREPAY"
		CASE ThisForm.pf1.pgFreight.ogFreightCharges.Value = 3
			cFrtCharges = "3RD PARTY"
		OTHERWISE
			cFrtCharges = ""
		ENDCASE
		
		DO CASE
		CASE ThisForm.pf1.pgFreight.ogDutyTax.Value = 1
			cDutyTaxText = "RECIPIENT"
		CASE ThisForm.pf1.pgFreight.ogDutyTax.Value = 2
			cDutyTaxText = "HPA"
		CASE ThisForm.pf1.pgFreight.ogDutyTax.Value = 3
			cDutyTaxText = "3RD PARTY"
		OTHERWISE
			cDutyTaxText = ""
		ENDCASE
		
		
		lCOD = (ThisForm.pf1.pgFreight.chkCOD.Value = 1 )
		lCODFrtColl = ( ThisForm.pf1.pgFreight.ogCODFreightFee.Value = 1 )
		lCODCertChk = ( ThisForm.pf1.pgFreight.ogCheck.value = 1 )
		
		SELECT tmpLading  &&Not SQL, a temp foxpro table
		REPLACE ALL DecValue WITH nDecValue,;
		 bil3code WITH nbil3code, FrtCharges WITH cFrtCharges,;
		 DutyTax WITH cDutyTaxText, COD WITH lCOD,; 
		 CODFrtColl WITH lCODFrtColl, CODCertChk WITH lCODCertChk
		
		***********************************************************************
		
		*Save Blind, Fax and Email to tmpSales
		ll2Blind = PrepareSQLlogic(THISFORM.pf1.pgWhatEver.chkBlind.VALUE,'Blind',.F.)
		ll2Fax	 = PrepareSQLlogic(THISFORM.pf1.pgWhatEver.chkFaxConf.VALUE,'FaxConf',.F.)
		ll2Email = PrepareSQLlogic(THISFORM.pf1.pgWhatEver.chkEmailConf.VALUE,'EmailConf',.F.)
		
		IF USED('tmpSales')
			*Update all records
			UPDATE tmpSales SET ;
				Blind 	= ll2Blind,;
				FaxConf	= ll2Fax,;
				EmailConf=ll2Email,;
				ShipRoute=cShippedVia
				
		ELSE
			MESSAGEBOX("Tell David -tmpSales- was not in use!!")
			TrackError("tmpSales- was not in use!!","Tell David",PROGRAM(),LINENO(1))
		ENDIF
		
		
		*************************
		
		SELECT PackingSlipItem
		INDEX ON SOItem TAG PSI_SOItem
		
		PRIVATE lReturn
		lReturn = .F.
		TRY	
			SET ORDER TO PSI_SOItem
		CATCH
			MESSAGEBOX("Only one instance can be run at a time.",0+16,"Error with Index File")
			TrackError("SET ORDER TO PSI_SOItem Failed. "+"Error with Index File","SET ORDER TO PSI_SOItem",PROGRAM(),LINENO(1) )
			lReturn = .T.
		ENDTRY
		
		IF lReturn
			ThisForm.ReverseSQL()
			RETURN
		ENDIF
		
		SELECT tmpSales
		INDEX ON SOItem TAG S_SOItem
		
		
		TRY	
			SET ORDER TO S_SOItem
			*SET INDEX TO ThisForm.S_SOItem
		CATCH
			MESSAGEBOX("Only one instance can be run at a time.",0+16,"Error with Index File")
			TrackError("SET ORDER TO S_SOItem Failed . Error with Index File","SET ORDER TO S_SOItem",PROGRAM(),LINENO(1))
			lReturn = .T.
		ENDTRY
		
		IF lReturn
			ThisForm.ReverseSQL()
			RETURN
		ENDIF
