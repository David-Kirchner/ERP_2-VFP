					cSQLu = cSQLu + ",PS_Dim2="+STR(PackingSlipItem.Dim2,9,3)
					cSQLu = cSQLu + ",PS_Dim3="+STR(PackingSlipItem.Dim3,9,3)
					cSQLu = cSQLu + ",PS_LBS="+STR(PackingSlipItem.Weight,9,1)
