	PROCEDURE seekpackingsliinpackingslip
		PARAMETERS nPackingSli
		*ThisForm.SeekPackingSliInPackingSlip(PackingSlip_NO.PackingSli)
		IF EMPTY(nPackingSli)
			nPackingSli = 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('PackingSlip')
			SELECT PackingSlip
		ELSE
			SELECT 0
		ENDIF
		
		cSQL=" SELECT * FROM dbo.PackingSlip "
		IF nPackingSli > 0
			cSQL = cSQL + " WHERE PackingSli = "+STR(nPackingSli)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PackingSlip')
		ENDIF
		
		IF USED('PackingSlip')
		
			IF USED('PackingSlip_No')
				SELECT PackingSlip_No
			ELSE
				SELECT 0
			ENDIF
		
			cSQL=" SELECT * FROM dbo.PackingSlip_No "
			IF nPackingSli > 0
				cSQL = cSQL + " WHERE PackingSli = "+STR(nPackingSli)
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PackingSlip_No')
				RETURN .F.
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE seek_psno_in_packingslip_no
		PARAMETERS pnPSNo
		*seek_PSNo_in_packingslip_No(nPS_No)
		
		IF VARTYPE( pnPSNo) != "N"
			pnPSNo= 0
		ENDIF
		
		IF USED('PackingSlip_No')
			USE IN PackingSlip_No
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.PackingSlip_No "
		
		IF EMPTY(pnPSNo)
			cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0 "
		ELSE
			cSQL = cSQL + " WHERE PackingSli = "+STR(pnPSNo)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'PackingSlip_No')
		ENDIF
		
		
		IF USED('Sales_No') &&&????????????
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE sendconfemail		&& Send Conf Email
		*ThisForm.SendConfEmail()
		
		PRIVATE cEmailAddress
		cEmailAddress = PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtEmail.VALUE,'Email',60)
		IF EMPTY(cEmailAddress)
			cEmailAddress = getFromQuotesSO(ThisForm.nSO,'EMAIL',ThisForm.nConnHandle)
		ENDIF
		
		IF EMPTY(cEmailAddress)
			MESSAGEBOX("Cannot Send the Packing Slip Acknowledgement by Email.",0+16,"No email Address")
			TrackMess( "Cannot Send the Packing Slip Acknowledgement by Email. in SO "+ALLTRIM(STR(ThisForm.nSO))+". No email Address" )
			*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip could not Email Acknowledgement',"SO:"+ALLTRIM(STR(ThisForm.nSO))+" PackingSlip:"+ALLTRIM(STR(ThisForm.PackingSlipNo))+CHR(13)+"PackingSlip:SendConfEmail()",0,.T.)
			PRIVATE cMess
			cMess = "Cannot Send the Packing Slip Acknowledgement by Email."
			cMess = cMess +"for SO "+ALLTRIM(STR(ThisForm.nSO))+CHR(13)
			cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
			cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
			cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
			cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
		*	cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
			cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
			cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
			cMess = cMess + PROGRAM()
			Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),"Cannot Send the Packing Slip Acknowledgement by Email.",cMess,0,.T.)	
			
		ENDIF
		
		PRIVATE nShipAddr, cSalesRep, cEmailHPAsp
		nShipAddr = THISFORM.ShipAddr
		nBillAddr = PrepareSQLnum( THISFORM.SoldAddr,'SoldCode',-3)
		
		cSalesRep = SalesRepfromSO(ThisForm.nSO)
		cEmailHPAsp = AppSetup_Get_Email(cSalesRep)
		*Send_HTML_Email(cEmailHPAsp,'plant.manager@SpaceAlloysUSA.com',cTitle,cBody,pConn,.T.,.T.)	
		*Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, pConn, lQuiet, lNoHeadder)
		
		*REPORT FORM Reports\PackingSlip FOR PackingSlip_NO.PackingSli = ThisForm.PackingSlipNo NOCONSOLE TO FILE (SYS(2003)+"\HPAOrder.txt" ASCII
		IF ThisForm.SeekPackingSliInPackingSlip(ThisForm.PackingSlipNo)
		
			*CreateHTML_PS_Conf( pPackingSlipNo, pEmailAddress, pEmailHPA, pShipAddr, cSalesRep )
			PRIVATE m.MsgNoteHTML
			m.MsgNoteHTML = CreateHTML_PS_Conf( ThisForm.PackingSlipNo, cEmailAddress, cEmailHPAsp, nShipAddr, cSalesRep, nBillAddr  )
		
			PRIVATE m.MsgSubject 
			m.MsgSubject = "HPAlloy PackingSlip #"+ALLTRIM(STR(ThisForm.PackingSlipNo))
		
			IF MESSAGEBOX("Are you sure want to Email this Packingslip?",4,"Send Email?") = 6
				PRIVATE lQuiet, lNoHeadder
				lQuiet = .F.
				lNoHeadder = .T.  &&already have the Address Header 
				
				*Send_HTML_Email(cToEmailAddress, cFromEmailHPA, MsgSubject, m.MsgNoteHTML, ThisForm.nConnHandle, lQuiet, lNoHeadder )   &&Proc_SQL
				*Send_HTML_Email( get_Server_Email(), cEmailAddress+';David.Kirchner@SpaceAlloysUSA.com', m.MsgSubject, m.MsgNoteHTML, ThisForm.nConnHandle,0,.T.)	
				Send_HTML_Email( cEmailAddress, cEmailHPAsp, m.MsgSubject, m.MsgNoteHTML, ThisForm.nConnHandle,0,.T.)	
				
		*!*			PRIVATE cMess
		*!*			cMess = "Cannot Send the Packing Slip Acknowledgement by Email."
		*!*			cMess = cMess +"for SO "+ALLTRIM(STR(ThisForm.nSO))+CHR(13)
		*!*			cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
		*!*			cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
		*!*			cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
		*!*			cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
		*!*		*	cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
		*!*			cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
		*!*			cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
		*!*			cMess = cMess + PROGRAM()
		*!*			Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),m.MsgSubject,cMess,0,.T.)	
		*!*			
			ENDIF
		ELSE
			MESSAGEBOX("Seek PackingSli In PackingSlip Returned an Error",0,"Cannot Send Conformation Email.")
		ENDIF
		
		IF USED('PackingSlip')
			USE IN PackingSlip
		ENDIF
		
		IF USED('PackingSlip_No')
			USE IN PackingSlip_No
		ENDIF
		
		RETURN
		
		
		
		
	ENDPROC

	PROCEDURE sendconffax		&& Send Conf Fax
		*ThisForm.SendConfFax()
		*MESSAGEBOX("Send by FAX has been depricated.",0,"No FAX")
		
		PRIVATE cFax, nPrinters,CT,lWinFax 
		
		cFax = ALLTRIM(ThisForm.pf1.pgWhatEver.txtFax.Value)
		IF EMPTY(cFax)
			cFax = getFromQuotesSO(ThisForm.nSO,'FAX',ThisForm.nConnHandle)
		ENDIF
		
		IF EMPTY(cFax)
			MESSAGEBOX("No Fax number")
			RETURN .F.
		ENDIF
		
		cFax = cFax+SPACE(19-LEN(ALLTRIM(cFax)))
		
		PRIVATE cSQL, nSQLEXEC
		***************
		IF USED('PackingSlip_No')
			SELECT PackingSlip_No
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.PackingSlip_No "
		IF EMPTY(ThisForm.PackingSlipNo)
			cSQL = cSQL + " WITH(NOLOCK) WHERE  0>0"
		ELSE
			cSQL = cSQL + " WHERE PackingSli = "+STR(ThisForm.PackingSlipNo)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PackingSlip_No')
		ENDIF
		***************
		IF USED('SoldAddr')
			SELECT SoldAddr
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.SoldAddr "
		IF THISFORM.SoldAddr = 0
			cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0"
		ELSE
			cSQL = cSQL + " WHERE SoldCode = "+STR(THISFORM.SoldAddr)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
