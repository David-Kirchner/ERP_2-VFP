	PROCEDURE pf1.pgItems.pf_SO_Items.pg_SO_items.lblCheckPosted.Click
		IF USED('cntShipAddr')
			USE IN cntShipAddr
		ENDIF
		
		SELECT 0
		
		PRIVATE nSalesNum
		nSalesNum = tmpSalesNum.SalesNum
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT "
		cSQL = cSQL + " Sales.SOitem,Sales.cncld,Sales.cmplt "
		cSQL = cSQL + " ,Sales_No.cncld AS Sales_No_Cncld, Sales_No.cmplt AS Sales_No_Cmplt "
		cSQL = cSQL + " ,Ship.Cncld AS Ship_Cncld, Ship.Complete AS Ship_Complete "
		cSQL = cSQL + " FROM dbo.Sales_No "
		cSQL = cSQL + " INNER JOIN dbo.Ship ON Ship.SalesNum = Sales_No.SalesNum "
		cSQL = cSQL + " INNER JOIN dbo.Sales ON Sales.SalesNum = Sales_No.SalesNum "
		cSQL = cSQL + " WHERE Sales_No.SalesNum = "+ALLTRIM(STR(nSalesNum))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
		ENDIF
		
		IF USED('cntShipAddr')
			IF RECCOUNT('cntShipAddr') > 0
				BROWSE
			ENDIF
			USE IN cntShipAddr
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgOrderNumber.Click
		ThisForm.CurrPage = 4
		ThisForm.Refresh()
	ENDPROC

	PROCEDURE pf1.pgOrderNumber.cmdDelPO.Click
		This.Parent.grdPO.RecordSource = ""
		SELECT PackingSlipPO
		PACK
		MESSAGEBOX("Removeing PO Numbers here will change the PO# print out on the Packing Slip."+CHR(10)+"It would be better if the Sales Person Modified this Order to use this PO# correctly."+CHR(10)+CHR(10)+"Cancel and try again after the Sales Person is done.",0,"The PO was added.")
		GO TOP
		IF EOF('PackingSlipPO')
			INSERT INTO PackingSlipPO (PO) VALUES ("")
		ENDIF
		This.Parent.grdPO.RecordSource = "PackingSlipPO"
		This.Parent.grdPO.Refresh()
		
		
	ENDPROC

	PROCEDURE pf1.pgOrderNumber.cmdDelSO.Click
		PRIVATE lb_DELETE_txtSO1
		lb_DELETE_txtSO1 = .F.
		
		This.Parent.grdSO.RecordSource = ""
		SELECT PackingSlipSO
		SCAN 
			IF ALLTRIM(This.Parent.Parent.pgOverView.txtSO1.Value) = Alltrim(STR(PackingSlipSO.SO))
				lb_DELETE_txtSO1 = .T.
			ENDIF 
		ENDSCAN 
		PACK
		GO TOP
		
		IF EOF('PackingSlipPO')
			INSERT INTO PackingSlipSO (SO) VALUES (0)
			ThisForm.AddressScreen("ReleaseAddress")
		ENDIF
		This.Parent.grdSO.RecordSource = "PackingSlipSO"
		This.Parent.grdSO.Refresh()
		
		IF lb_DELETE_txtSO1 
			IF PackingSlipSO.SO = 0
				This.Parent.Parent.pgOverView.txtSO1.Enabled = .T.
				This.Parent.Parent.pgOverView.txtSO1.Value = ""
			ELSE 
				This.Parent.Parent.pgOverView.txtSO1.Value = STR(PackingSlipSO.SO)
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE pf1.pgOrderNumber.cmdEnterPo.Click
		PRIVATE tPO, lDup
		tPO = ALLTRIM(This.Parent.txtPO.Value)
		lDup = .F.
		
		IF NOT Empty(tPO)
			*got something to save
			SELECT PackingSlipPO
			GO TOP
			IF EMPTY(PackingSlipPO.PO)
				*has been initialized, but no value
				REPLACE PO WITH tPO
			ELSE
				*has value
				*check for duplicate
				SCAN
					IF PO = tPO
						lDup = .T.
					ENDIF
				ENDSCAN
				IF NOT lDup
					*Save the PO
					INSERT INTO PackingSlipPO (PO) VALUES (tPO)
					this.Parent.GrdPO.Refresh()
					MESSAGEBOX("This PO# will not print out on the Packing Slip where it belongs."+CHR(10)+"It would be better if the Sales Person Modified this Order to use this PO# correctly."+CHR(10)+CHR(10)+"Cancel and try again after the Sales Person is done.",0,"The PO was added.")
				ELSE
					WAIT WINDOW "That PO number has already been entered" NOWAIT
				ENDIF
			ENDIF
		ELSE
			WAIT WINDOW 'Nothing to save' NOWAIT
		ENDIF
		this.Parent.txtPO.Value = ""
		
	ENDPROC

	PROCEDURE pf1.pgOrderNumber.cmdEnterSO.Click
		PRIVATE nNewSO, nLenSO, lDup
		nNewSO = PrepareSQLnum(This.Parent.txtSO.Value,'SalesNum',-3)
		lDup = .F.
		
		*IF NOT Empty(tSO) 
		*	nNewSO = VAL(tSO)
			IF nNewSO > 0
				*got something to save
				SELECT PackingSlipSO
				GO TOP
				IF PackingSlipSO.SO = 0
					*has been initialized, but no value
					*Save the SO
					IF ThisForm.CheckNewSO(nNewSO)
						REPLACE PackingSlipSO.SO WITH nNewSO
						This.Parent.Parent.pgOverView.txtSO1.Value = nNewSO
						This.Parent.Parent.pgOverView.txtSO1.Enabled = .F.
						ThisForm.ShowSalesOrderItemsGRD('NoFocus')
					ELSE
					
					ENDIF
				ELSE
					*has value
					*check for duplicate
					SCAN
					 IF PackingSlipSO.SO = nNewSO 
					 	lDup = .T.
					 EndIF
					ENDSCAN
					IF NOT lDup
						*Save the SO
						IF ThisForm.CheckNewSO(nNewSO)
							INSERT INTO PackingSlipSO (SO) VALUES (nNewSO)
							This.Parent.GrdSO.Refresh()
							ThisForm.ShowSalesOrderItemsGRD('NoFocus')
						ELSE
							
						ENDIF
					Else
						MESSAGEBOX("That SO number has already been entered") 
					ENDIF
				ENDIF
			Else
				WAIT WINDOW 'Need a number' nowait
			EndIF
		*Else
		*	WAIT WINDOW 'Nothing to save' NOWAIT
		*EndIF
		This.Parent.txtSO.Value = ""
		
	ENDPROC

	PROCEDURE pf1.pgOrderNumber.Init
		This.grdPO.RecordSource = ""
		IF USED('PackingSlipPO')
			USE IN PackingSlipPO
		ENDIF
		SELECT 0
		
		*PRIVATE cFileName
		*cFileName = SYS(3)
		*cFileName = 'PPO_' + cFileName
		
		ThisForm.Uniq_PPO = UniqDBF(ThisForm.Uniq_PPO)
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_PPO) ) FREE 	(PO C(30))
			USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_PPO) EXCL ALIAS PackingSlipPO
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_PPO) ) FREE 	(PO C(30))
			USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_PPO) EXCL ALIAS PackingSlipPO
		ENDIF
		
		*CREATE TABLE SYS(5)+SYS(2003)+"\"+"PackingSlipPO" FREE (PO C(30))
		SELECT PackingSlipPO
		
		*USE PackingSlipPO EXCLUSIVE
		ZAP
		INSERT INTO PackingSlipPO (PO) VALUES ("")
		GO TOP
		This.grdPO.RecordSource = "PackingSlipPO"
		This.grdPO.clmPO.ControlSource = "PO"
		select 0
		
		This.grdSO.RecordSource = ""
		IF USED('PackingSlipSO')
			USE IN PackingSlipSO
		ENDIF
		SELECT 0
		
		*PRIVATE cFileName
		*cFileName = SYS(3)
		*cFileName = 'PSO_' + cFileName
		
		ThisForm.Uniq_PSO = UniqDBF(ThisForm.Uniq_PSO)
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_PSO) ) FREE (SO n(10))
			USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_PSO) EXCL ALIAS PackingSlipSO
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_PSO) ) FREE (SO n(10))
			USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_PSO) EXCL ALIAS PackingSlipSO
		ENDIF
		
		*CREATE TABLE SYS(5)+SYS(2003)+"\"+"PackingSlipSO" FREE (SO n(10))
		TRY
			SELECT PackingSlipSO
		CATCH
			MESSAGEBOX("Could not load table ThisForm.Uniq_PSO 'PackingSlipSO'"+CHR(13)+"Only one instance of 'Packing Slip' can be run at a time!",0,"'PackingSlipSO' error")
			
			TrackError("Could not load table ThisForm.Uniq_PSO 'PackingSlipSO' Only one instance of 'Packing Slip' can be run at a time!","Could not load table 'PackingSlipSO'",PROGRAM(),LINENO(1) )
			
			RETURN TO MASTER
			ThisForm.Release
		ENDTRY
		
		*USE PackingSlipSO EXCLUSIVE
		ZAP
		INSERT INTO PackingSlipSO (SO) VALUES (0)
		This.grdSO.RecordSource = "PackingSlipSO"
	ENDPROC

	PROCEDURE pf1.pgOverView.Click
		ThisForm.CurrPage = 1
		IF This.Parent.pgSoldTo.cmdEditSoldTo.Caption = "Edit"
			This.Sold1.Caption = This.Parent.pgSoldTo.txtCompany.Value
			This.Sold2.Caption = This.Parent.pgSoldTo.txtAddr1.Value
			This.Sold3.Caption = This.Parent.pgSoldTo.txtAddr2.Value
			This.Sold4.Caption = ALLTRIM(This.Parent.pgSoldTo.txtCity.Value)+;
			IIF(EMPTY(This.Parent.pgSoldTo.txtST.Value),"",", ")+;
			ALLTRIM(This.Parent.pgSoldTo.txtST.Value)+;
			" "+ALLTRIM(This.Parent.pgSoldTo.txtZip.Value)
		ELSE
			This.Sold1.Caption = ""
			This.Sold2.Caption = ""
			This.Sold3.Caption = ""
			This.Sold4.Caption = ""
		ENDIF
		
		IF This.Parent.pgShipTo.cmdEditShipTo.Caption = "Edit"
			This.Ship1.Caption = This.Parent.pgShipTo.txtCompany.Value
			This.Ship2.Caption = This.Parent.pgShipTo.txtAddr1.Value
			This.Ship3.Caption = This.Parent.pgShipTo.txtAddr2.Value
			This.Ship4.Caption = ALLTRIM(This.Parent.pgShipTo.txtCity.Value)+;
			IIF(EMPTY(This.Parent.pgShipTo.txtST.Value),"",", ")+;
			ALLTRIM(This.Parent.pgShipTo.txtST.Value)+;
			" "+ALLTRIM(This.Parent.pgShipTo.txtZip.Value)
		ELSE
			This.Ship1.Caption = ""
			This.Ship2.Caption = ""
			This.Ship3.Caption = ""
			This.Ship4.Caption = ""
		ENDIF
		
		*SELECT PackingSlipItem
		GO TOP IN PackingSlipItem
		IF PackingSlipItem.pcs = 0
			This.Item1.Caption = "empty..."
		ELSE
			This.Item1.Caption = ALLTRIM(STR(PackingSlipItem.pcs,10,0))+SPACE(10-LEN(ALLTRIM(STR(PackingSlipItem.pcs,10,0))))+PackingSlipItem.Descript
		ENDIF
		SKIP IN PackingSlipItem
		IF NOT EOF('PackingSlipItem')
			This.Item2.Caption = ALLTRIM(STR(PackingSlipItem.pcs,10,0))+SPACE(10-LEN(ALLTRIM(STR(PackingSlipItem.pcs,10,0))))+PackingSlipItem.Descript
			SKIP IN PackingSlipItem
			IF NOT EOF('PackingSlipItem')
				This.Item3.Caption = ALLTRIM(STR(PackingSlipItem.pcs,10,0))+SPACE(10-LEN(ALLTRIM(STR(PackingSlipItem.pcs,10,0))))+PackingSlipItem.Descript
				SKIP IN PackingSlipItem
				IF NOT EOF('PackingSlipItem')
					This.Item4.Caption = ALLTRIM(STR(PackingSlipItem.pcs,10,0))+SPACE(10-LEN(ALLTRIM(STR(PackingSlipItem.pcs,10,0))))+PackingSlipItem.Descript
					SKIP IN PackingSlipItem
					IF NOT EOF('PackingSlipItem')
						This.Item5.Caption = ALLTRIM(STR(PackingSlipItem.pcs,10,0))+SPACE(10-LEN(ALLTRIM(STR(PackingSlipItem.pcs,10,0))))+PackingSlipItem.Descript
					ELSE
						This.Item5.Caption = ""
					ENDIF
				ELSE
					This.Item4.Caption = ""
					This.Item5.Caption = ""
				ENDIF
			ELSE
				This.Item3.Caption = ""
				This.Item4.Caption = ""
				This.Item5.Caption = ""
			ENDIF
		ELSE
			This.Item2.Caption = ""
			This.Item3.Caption = ""
			This.Item4.Caption = ""
			This.Item5.Caption = ""
		ENDIF
		ThisForm.Refresh()
		
	ENDPROC

	PROCEDURE pf1.pgOverView.txtSO1.DblClick
		PRIVATE loIE, nSO, cReportFile
		nSO = PrepareSQLnum(This.Value,'SalesNum',-3)
		IF nSO > 0
			
			RELEASE loIE
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_SO(nSO,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf1.pgOverView.txtSO1.Valid
		PRIVATE tSO, nSO, nLenSO, lDup
		*APsoldAddr,APshipAddr
		tSO = THIS.VALUE
		lDup = .F.
		
		IF NOT EMPTY(tSO)
			nSO = VAL(tSO)
			IF nSO > 0 AND nSO < 10000000000
				*got something to USE
				ThisForm.nSO = nSO
				
				IF Count_SOinSales_No(nSO, ThisForm.nConnHandle) < 1
					MESSAGEBOX("Did not find SO "+ALLTRIM(STR(nSO))+CHR(13)+"Check for a type error "+CHR(13)+"in the Sales Order field",0+48,'Bad Number')
					THIS.ENABLED = .T.
					RETURN .F.
				ENDIF
		
		
				
				SELECT PackingSlipSO
				GO TOP
				IF PackingSlipSO.SO = 0
					*has been initialized, but no value
					REPLACE PackingSlipSO.SO WITH nSO
				ELSE
					*has value
					*check for duplicate
					SCAN
						IF PackingSlipSO.SO = nSO
							lDup = .T.
						ENDIF
					ENDSCAN
					IF lDup
						*WAIT WINDOW "That SO number has already been entered" NOWAIT
					ELSE
						*Save the SO
						INSERT INTO PackingSlipSO (SO) VALUES (nSO)
					ENDIF
				ENDIF
				THIS.ENABLED = .F.
		
				*Check Sales_No for nSO
				IF USED('cntSales_No')
					USE IN cntSales_No
				ENDIF
				SELECT 0
				cSQL="SELECT COUNT(*) AS Cntd FROM dbo.Sales_No WHERE Sales_No.SalesNum = "+STR(nSO)
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntSales_No')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'cntSales_No')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No' )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_No")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_No")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'cntSales_No' )
				ENDIF
				IF NOT USED('cntSales_No')
		*			TrackError(cSQL,"Could not open table 'cntSales_No.'",PROGRAM(),LINENO(1))
					MESSAGEBOX("You may have another copy of Packing Slip running."+CHR(13)+"Could not open table 'cntSales_No.'"+CHR(13)+"Try again.",16,"SQL Error")
					RETURN .F.
				ENDIF
				IF cntSales_No.Cntd > 0
		
					*Check Sales_No for Cancelled nSO
					IF USED('cntSales_NoCanc')
						USE IN cntSales_NoCanc
					ENDIF
					SELECT 0
					cSQL="SELECT COUNT(*) AS Cntd FROM dbo.Sales_No WHERE Sales_No.SalesNum = "+STR(nSO)
					cSQL=cSQL+" AND ISNULL(CNCLD,0) = 1"  &&Sales_NO
		
					
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntSales_NoCanc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'cntSales_NoCanc')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_NoCanc' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_NoCanc' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_NoCanc")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_NoCanc")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'cntSales_NoCanc' )
					ENDIF
					
					IF cntSales_NoCanc.Cntd > 0
						MESSAGEBOX("SO "+ALLTRIM(STR(nSO))+" is marked as 'Cancelled'"+CHR(13)+"Not just an item, the whole SO.",0+16,"Cannot ship a cancelled SO.")
						*DELETE FROM PackingSlipSO WHERE SO = nSO
						*PACK
						SELECT PackingSlipSO
						REPLACE SO WITH 0 FOR SO = nSO
						THIS.VALUE = 0
						*UPDATE PackingSlipSO SET SO = nSO
					
						IF USED('cntSales_No')
							USE IN cntSales_No
						ENDIF
						IF USED('cntSales_NoCanc')
							USE IN cntSales_NoCanc
						ENDIF
						RETURN .F.
					ENDIF
					
					*Found SO, Get pSoldAddr
					IF USED('PsoldAddrSales_No')
						USE IN PsoldAddrSales_No
					ENDIF
					SELECT 0
					cSQL="SELECT PsoldAddr,PshipAddr FROM dbo.Sales_No WHERE Sales_No.SalesNum = "+STR(nSO)
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'PsoldAddrSales_No')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'PsoldAddrSales_No')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PsoldAddrSales_No' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PsoldAddrSales_No' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PsoldAddrSales_No")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PsoldAddrSales_No")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'PsoldAddrSales_No')
					ENDIF
		
					IF USED('PsoldAddrSales_No')
						IF PsoldAddrSales_No.PsoldAddr > 0
							
							IF USED('tSoldAddr')
								USE IN tSoldAddr
							ENDIF
							SELECT 0
							cSQL="SELECT * FROM dbo.SoldAddr WHERE SoldCode = "+STR(PsoldAddrSales_No.PsoldAddr)
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tSoldAddr')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'tSoldAddr')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
								ENDDO
							ENDIF
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO 
							ENDIF 
							IF nSQLEXEC < 0
								SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tSoldAddr' )
							ENDIF
							IF USED('tSoldAddr')
								THISFORM.SoldAddr = tSoldAddr.SoldCode
								THIS.PARENT.PARENT.pgSoldTo.txtSoldCode.VALUE = tSoldAddr.SoldCode
								THIS.PARENT.PARENT.pgSoldTo.txtCompany.VALUE = tSoldAddr.Company
								THIS.PARENT.PARENT.pgSoldTo.txtAddr1.VALUE = tSoldAddr.Addr1
								THIS.PARENT.PARENT.pgSoldTo.txtAddr2.VALUE = tSoldAddr.Addr2
								THIS.PARENT.PARENT.pgSoldTo.txtCity.VALUE = tSoldAddr.City
								THIS.PARENT.PARENT.pgSoldTo.txtST.VALUE = tSoldAddr.ST
								THIS.PARENT.PARENT.pgSoldTo.txtZip.VALUE = tSoldAddr.Zip
								THIS.PARENT.PARENT.pgSoldTo.txtCountry.VALUE = tSoldAddr.Country
								THIS.PARENT.PARENT.pgSoldTo.txtContact.VALUE = tSoldAddr.Contact
								THIS.PARENT.PARENT.pgSoldTo.txtPhone.VALUE = tSoldAddr.TelePhone
								THIS.PARENT.PARENT.pgSoldTo.txtFax.VALUE = tSoldAddr.Fax_number
								THIS.PARENT.PARENT.pgSoldTo.txtEmail.VALUE = tSoldAddr.Email
								THIS.PARENT.PARENT.pgSoldTo.txtLastEdit.VALUE = CTOD(DTOC(tSoldAddr.LastEdit))
		
								USE IN tSoldAddr
								
								This.Parent.Parent.pgsoldTo.CmdSearchSoldTo.Enabled = .F.
								
							ENDIF
						ENDIF
					ENDIF
				ENDIF  &&IF USED('PsoldAddrSales_No')
				*			SELECT PshipAddr FROM HPA!Sales_No WHERE Sales_No.SalesNum = nSO INTO ARRAY APshipAddr
				*			IF TYPE("APshipAddr(1)")="N"
				*				IF APshipAddr(1) > 0
		
				IF USED('PsoldAddrSales_No')
					IF PsoldAddrSales_No.PshipAddr > 0
		
						IF USED('tShipAddr')
							USE IN tShipAddr
						ENDIF
						SELECT 0
						cSQL="SELECT * FROM dbo.ShipAddr WHERE ShipCode = "+STR(PsoldAddrSales_No.PshipAddr)
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tShipAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'tShipAddr')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tShipAddr' )
						ENDIF
						IF USED('tShipAddr')
							THISFORM.ShipAddr = tShipAddr.ShipCode
							THIS.PARENT.PARENT.pgShipTo.txtShipCode.VALUE = tShipAddr.ShipCode
							THIS.PARENT.PARENT.pgShipTo.txtCompany.VALUE = tShipAddr.Company
							THIS.PARENT.PARENT.pgShipTo.txtAddr1.VALUE = tShipAddr.Addr1
							THIS.PARENT.PARENT.pgShipTo.txtAddr2.VALUE = tShipAddr.Addr2
							THIS.PARENT.PARENT.pgShipTo.txtCity.VALUE = tShipAddr.City
							THIS.PARENT.PARENT.pgShipTo.txtST.VALUE = tShipAddr.ST
							THIS.PARENT.PARENT.pgShipTo.txtZip.VALUE = tShipAddr.Zip
							THIS.PARENT.PARENT.pgShipTo.txtCountry.VALUE = tShipAddr.Country
							THIS.PARENT.PARENT.pgShipTo.txtContact.VALUE = tShipAddr.Contact
							THIS.PARENT.PARENT.pgShipTo.txtPhone.VALUE = tShipAddr.TelePhone
							THIS.PARENT.PARENT.pgShipTo.txtFax.VALUE = tShipAddr.Fax_number
							THIS.PARENT.PARENT.pgShipTo.txtEmail.VALUE = tShipAddr.Email
							THIS.PARENT.PARENT.pgShipTo.txtLastEdit.VALUE = CTOD(DTOC(tShipAddr.LastEdit))
		
							USE IN tShipAddr
							
							This.Parent.Parent.pgShipTo.cmdSearchShipTo.Enabled = .F.
						ENDIF
						*			ENDIF
					ENDIF &&IF USED('PsoldAddrSales_No')
		
					IF USED('PsoldAddrSales_No')
						USE IN PsoldAddrSales_No
					ENDIF
					
					IF USED('aSales_NO')
						USE IN aSales_NO
					ENDIF
					SELECT 0
					cSQL="SELECT * FROM dbo.Sales_No WHERE Sales_No.SalesNum = "+STR(nSO)
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'aSales_NO')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'aSales_NO')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSales_NO' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSales_NO' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aSales_NO")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aSales_NO")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'aSales_NO')
					ENDIF
		
					IF USED('aSales_NO')			
					*SELECT ShipRoute,Shippay,PayType,blind,FaxConf,EmailConf,FreightEst,Addr_Ref FROM HPA!Sales_No WHERE Sales_No.SalesNum = nSO INTO ARRAY aSales_NO
		
						THIS.PARENT.PARENT.pgWhatEver.txtShippedVIA.VALUE = PrepareSQLtxt(aSales_NO.ShipRoute,'ShipRoute',20)
						cShipPay = PrepareSQLtxt(aSales_NO.ShipPay,'ShipPay',12)
						DO CASE
						CASE EMPTY(cShipPay)
		
						CASE cShipPay="FRT COLLEC"
							THIS.PARENT.PARENT.pgFreight.ogFreightCharges.VALUE = 1
						CASE cShipPay="ADD FREIGH"
							THIS.PARENT.PARENT.pgFreight.ogFreightCharges.VALUE = 2
						CASE cShipPay="3RD"
							THIS.PARENT.PARENT.pgFreight.ogFreightCharges.VALUE = 3
						ENDCASE
		
						THIS.PARENT.PARENT.pgWhatEver.txtPayType.VALUE = PrepareSQLtxt(aSales_NO.PayType,'PayType',10)
						THIS.PARENT.PARENT.pgWhatEver.chkBlind.VALUE = PrepareSQLchk(aSales_NO.Blind,'Blind')
						THIS.PARENT.PARENT.pgWhatEver.chkFaxConf.VALUE = PrepareSQLchk(aSales_NO.FaxConf,'FaxConf',.F.)
						THIS.PARENT.PARENT.pgWhatEver.chkEmailConf.VALUE = PrepareSQLchk(aSales_NO.EmailConf,'EmailConf',.F.)
						THIS.PARENT.PARENT.pgWhatEver.txtFreightEst.VALUE = "Freight Est. $"+ALLTRIM( STR(PrepareSQLnum(aSales_NO.FreightEst,'FreightEst',9,2),9,2) )
						ThisForm.cAddr_Ref = PrepareSQLtxt(aSales_NO.Addr_Ref,'Addr_Ref',40)+" " 
					ENDIF &&USED('aSales_NO')	
					IF USED('aSales_NO')
						USE IN aSales_NO
					ENDIF
					
						
					IF USED('aSalesDetail')
						USE IN aSalesDetail
					ENDIF
					SELECT 0
					cSQL = "SELECT * FROM dbo.Sales WITH(NOLOCK) "
					cSQL = cSQL+" WHERE Sales.SalesNum = "+STR(nSO)
					
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'aSalesDetail')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'aSalesDetail')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSalesDetail' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSalesDetail' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aSalesDetail")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aSalesDetail")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'aSalesDetail' )
					ENDIF
					
					IF USED('aSalesDetail')
						DIMENSION aS_Instrc(1)
						SELECT SOITEM, S_Instrct, ShipOn, ShipDue FROM aSalesDetail WHERE aSalesDetail.SalesNum = nSO INTO ARRAY aS_Instrc
						
						PRIVATE lcS_Instrct
						lcS_Instrct = " "
						FOR I = 1 TO ALEN(aS_Instrc,1)
							IF NOT EMPTY(aS_Instrc(I,2))
								lcS_Instrct=lcS_Instrct+aS_Instrc(I,1)+": "+ALLTRIM(aS_Instrc(I,2))+CHR(13)+" "
							ENDIF
							IF aS_Instrc(I,3)
								*Check Cannot ship before
								THISFORM.ShipOn = .T.
								IF VARTYPE(aS_Instrc(I,4)) = "T"
									aS_Instrc(I,4) = TTOD( aS_Instrc(I,4) )
								ENDIF
								IF VARTYPE(aS_Instrc(I,4)) = "D" 
									IF aS_Instrc(I,4) < DATE()
										MESSAGEBOX("SO item "+ALLTRIM(aS_Instrc(I,1))+" was written to not ship before ("+DTOC(aS_Instrc(I,4))+")" ,0+64,'Item has ShipOn marked' )
		*!*									IF MESSAGEBOX( "The Sales Order Item:"+ALLTRIM(aS_Instrc(I,1))+" is only to be shipped on "+DTOC(aS_Instrc(I,4))+"!"+CHR(13)+;
		*!*									  CHR(13)+ "Do you have Permission to overide the 'ship on' Date?"+CHR(13);
		*!*									  ,4+32+256,"Item is marked as 'SHIP ON' date." ) = 7
		*!*										
		*!*										RETURN .F.
		*!*									ELSE
		*!*										***Let SalesP know order is early
		*!*										TrackMess("SO item "+ALLTRIM(aS_Instrc(I,1))+" Shipped early ("+DTOC(DATE())+"), Order written to not ship before ("+DTOC(aS_Instrc(I,4))+")"  )
		*!*									ENDIF
									ENDIF
								ENDIF
							ENDIF
						NEXT I
						IF NOT EMPTY(lcS_Instrct)
							THIS.PARENT.sdtInstrct.VALUE = lcS_Instrct
							THIS.PARENT.sdtInstrct.VISIBLE = .T.
							THIS.PARENT.sdtInstrct.REFRESH
						ENDIF
		
						THIS.PARENT.PARENT.pgSoldTo.CLICK
						THIS.PARENT.PARENT.pgShipTo.CLICK
						
						USE IN aSalesDetail
					ENDIF
				ELSE
					*No records found in Sales_NO
				ENDIF
				IF USED('cntSales_No')
					USE IN cntSales_No
				ENDIF
		
				*SELECT COUNT(*) FROM AllQuotes WHERE AllQuotes.SalesNum = nSO INTO ARRAY aCount
				*IF aCount(1) > 0
					*Found record in AllQuotes!
				
				IF USED('PO_NumAllQuotes')
					USE IN PO_NumAllQuotes
				ENDIF
				SELECT 0
				cSQL="SELECT DISTINCT PO_Num FROM dbo.AllQuotes WITH(NOLOCK) WHERE SalesNum = "+STR(nSO)
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'PO_NumAllQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'PO_NumAllQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PO_NumAllQuotes' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PO_NumAllQuotes' )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PO_NumAllQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PO_NumAllQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'PO_NumAllQuotes' )
				ENDIF
					
				IF USED('PO_NumAllQuotes')	
					IF VARTYPE(PO_NumAllQuotes.PO_Num) = "C"
						DIMENSION APO_Num(1)
						SELECT DISTINCT PO_Num FROM PO_NumAllQuotes INTO ARRAY APO_Num	
						PRIVATE iPO
						FOR iPO = 1 TO ALEN(APO_Num)
							IF TYPE("APO_Num(iPO)")="C"
								IF !EMPTY(APO_Num(iPO))
									*FILL PO_Nums
									SELECT PackingSlipPO
									GO TOP
									IF EMPTY(PackingSlipPO.PO)
										*has been initialized, but no value
										REPLACE PackingSlipPO.PO WITH APO_Num(iPO)
									ELSE
										*Save the PO
										INSERT INTO PackingSlipPO (PO) VALUES (APO_Num(iPO))
									ENDIF
								ENDIF
							ENDIF
						ENDFOR
						THIS.PARENT.PARENT.pgOrderNumber.grdPO.REFRESH()
						*ThisForm.pf1.pgOrderNumber.grdPO.Refresh()
						
						
					ENDIF
					USE IN PO_NumAllQuotes
				ENDIF 
				
				ThisForm.ShowSalesOrderItemsGrd( 'NoFocus' )
		
		
				THIS.PARENT.PARENT.pgItems.pf_SO_Items.pg_add_item.txtSO.VALUE = nSO
				THIS.PARENT.PARENT.pgItems.pf_SO_Items.pg_add_item.txtSO.REFRESH
		
				THIS.PARENT.CLICK
				*Simulate ThisForm.cmdNext.click, can not use click from Valide since it has a SetFocus
				*		ThisForm.CurrPage = 2
				*		ThisForm.pf1.pgSoldTo.Zorder
		
			ELSE &&nSO > 0
				*WAIT WINDOW 'Need a number' NOWAIT
				MESSAGEBOX('Need a SO number grater then 0 and less than 100,000,000,000'+CHR(13)+"in the Sales Order field",0+48,'Bad Number')
				THIS.ENABLED = .T.
				THIS.VALUE = ""
			ENDIF
		
		ELSE &&NOT EMPTY(tSO)
			MESSAGEBOX('Need a SO number grater then 0 and less than 100,000,000,000'+CHR(13)+"in the Sales Order field",0+48,'Bad Number')
			THIS.ENABLED = .T.
			THIS.VALUE = ""
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE pf1.pgShipTo.Click
		PRIVATE matchCodes, LinkCodes
		matchCodes = 0
		LinkCodes = 0
		thisform.CurrPage = 3
		thisform.Refresh()
		
		IF ThisForm.nSO > 0
		*	user has entered a SO
			IF EMPTY(this.txtCompany.Value) ;
				AND EMPTY(this.txtAddr1.Value) ;
				AND EMPTY(this.txtAddr2.Value) ;
				AND EMPTY(this.txtCity.Value) ;
				AND EMPTY(this.txtST.Value) ;
				AND EMPTY(this.txtZip.Value) ;
				AND EMPTY(this.txtCountry.Value)
		*		Need to fill values
		
		*revise Find/use last Shipto assigned to this SoldTo
		****************************************
				IF thisform.SoldAddr > 0
					*get ShipCode
					PRIVATE nUseShipCode 
					nUseShipCode = Get_ShipCodeinSoldShip( thisform.SoldAddr, ThisForm.nConnHandle)			
		
					IF nUseShipCode  > 0
						matchCodes = nUseShipCode  
					ENDIF
				ENDIF
		*		if SoldAddr soldCode has a matching ShipCode Number, use it
				IF matchCodes = 0
					matchCodes = Get_ShipCode_CustomerinShipAddr( STR(thisform.SoldAddr,10,0), ThisForm.nConnHandle)
				ENDIF
				IF matchCodes > 0
					IF USED("tempShipAddr")
						USE IN tempShipAddr
					ENDIF
					
					SELECT 0
					cSQL = "SELECT * FROM dbo.ShipAddr WHERE ShipAddr.ShipCode = "+STR(matchCodes) 
					*INTO CURSOR tempShipAddr NOFILTER
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tempShipAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tempShipAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tempShipAddr' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tempShipAddr' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tempShipAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tempShipAddr")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tempShipAddr')
					ENDIF
		
				ENDIF
				IF USED("tempShipAddr")
					SELECT tempShipAddr
					GO BOTTOM
					IF NOT EMPTY(tempShipAddr.ShipCode)
						thisform.ShipAddr = tempShipAddr.ShipCode
						this.txtShipCode.Value = tempShipAddr.ShipCode
						this.txtCompany.Value = tempShipAddr.Company
						this.txtAddr1.Value = tempShipAddr.Addr1
						this.txtAddr2.Value = tempShipAddr.Addr2
						this.txtCity.Value = tempShipAddr.City
						this.txtST.Value = tempShipAddr.ST
						this.txtZip.Value = tempShipAddr.zip
						this.txtCountry.Value = tempShipAddr.Country
						this.txtContact.Value = tempShipAddr.Contact
						this.txtPhone.Value = tempShipAddr.Telephone
						this.txtFax.Value = tempShipAddr.Fax_Number
						this.txtEmail.Value = tempShipAddr.Email
						This.txtLastEdit.Value = tempShipAddr.LastEdit
		
						thisform.AddressScreen("ShipToEdit")
					ENDIF
					IF USED("tempShipAddr")
						USE IN tempShipAddr
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pf1.pgShipTo.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF THISFORM.ShipAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			THISFORM.ShipAddr = 0
			THIS.PARENT.cmdSearchShipTo.ENABLED = .T.
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
			THIS.PARENT.txtShipCode.Value	= 0
			
			This.Parent.cmdSearchShipTo.Enabled = .T.
			
			THISFORM.AddressScreen("ShipToEdit")
			
		ELSE
			IF This.parent.cmdEditShipTo.Caption = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
		
					IF USED( 'tShipAddr' )
						USE IN tShipAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.ShipAddr"
					cSQL = cSQl + " WHERE ShipAddr.ShipCode = "+STR(THISFORM.ShipAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tShipAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tShipAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tShipAddr")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tShipAddr')
					ENDIF
					IF USED( 'tShipAddr' )
						THISFORM.ShipAddr = tShipAddr.ShipCode
						THIS.PARENT.txtShipCode.VALUE = tShipAddr.ShipCode
						THIS.PARENT.txtCompany.VALUE = tShipAddr.Company
						THIS.PARENT.txtAddr1.VALUE = tShipAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE = tShipAddr.Addr2
						THIS.PARENT.txtCity.VALUE = tShipAddr.City
						THIS.PARENT.txtST.VALUE = tShipAddr.ST
						THIS.PARENT.txtZip.VALUE = tShipAddr.Zip
						THIS.PARENT.txtCountry.VALUE = tShipAddr.Country
						THIS.PARENT.txtContact.VALUE = tShipAddr.Contact
						THIS.PARENT.txtPhone.VALUE = tShipAddr.TELEPhone
						THIS.PARENT.txtFax.VALUE = tShipAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE = tShipAddr.Email
						THIS.PARENT.txtLastEdit.VALUE = CTOD(DTOC(tShipAddr.LastEdit))
						
						THISFORM.AddressScreen("ShipToEdit")	
						USE IN tShipAddr			
					ENDIF		
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf1.pgShipTo.cmdEditShipTo.Click
		PRIVATE	maxShipCode,maxSoldCode, oldShipCode, useShipCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnSoldAddr
		PRIVATE lcContact, lcPhone, lcFax, lcEmail
		PRIVATE mHoldRecordNum
		maxShipCode = 0
		PRIVATE oldShipCode, useShipCode 
		oldShipCode = 0
		useShipCode = 0
		
		lcCompany 	= PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
		lcAddr1 	= PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
		lcAddr2 	= PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
		lcCity  	= PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',50)
		lcST    	= PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'ST',50)
		lcZip   	= PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',50)
		lcCountry 	= PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)
		lcContact 	= PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
		lcPhone 	= PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
		lcFax 		= PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
		lcEmail		= PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		ldLastEdit 	= DATE()
		lnShipAddr 	= THISFORM.ShipAddr
		
		PRIVATE lSaveAddress,lSaveAddrn, NoChange
		lSaveAddress = .F.
		lSaveAddr = .F.
		nNoChange = 0
		
		PRIVATE cSQL, nSQLEXEC
		
		IF THIS.CAPTION = "Save" &&"Edit"
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry))
				lSaveAddress = .T.
			ENDIF
		
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!",0,"Not saved.")
				lSaveAddress = .F.
				RETURN .F.
			ENDIF
		
			IF lnShipAddr > 0
		
		*		IF EMPTY(THISFORM.ShipAddr)
					*look for a change
					
					IF USED('aCodeUsed')
						USE IN aCodeUsed
					ENDIF
					SELECT 0
					cSQL="SELECT ShipCode FROM dbo.ShipAddr WHERE "
					cSQL = cSQL+" Company = '"+lcCompany+"'"
					cSQL = cSQL+" AND Addr1 = '"+lcAddr1+"'"
					cSQL = cSQL+" AND Addr2 = '"+lcAddr2+"'"
					cSQL = cSQL+" AND City = '"+lcCity+"'"
					cSQL = cSQL+" AND ST = '"+lcST+"'"
					cSQL = cSQL+" AND ZIP = '"+lcZip+"'"
					cSQL = cSQL+" AND Country = '"+lcCountry+"'"
					cSQL = cSQL+" AND Contact = '"+lcContact+"'"
					cSQL = cSQL+" AND Telephone = '"+lcPhone+"'"
					cSQL = cSQL+" AND Fax_Number = '"+lcFax+"'"
					cSQL = cSQL+" AND Email	= '"+lcEmail+"'"
					cSQL = cSQL+" AND ShipCode = "+STR(lnShipAddr)
		
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'aCodeUsed')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'aCodeUsed')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aCodeUsed' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aCodeUsed' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aCodeUsed")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aCodeUsed")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'aCodeUsed' )
					ENDIF
					
					IF USED('aCodeUsed')
						IF aCodeUsed.ShipCode > 0	
							*Found Exact
							MESSAGEBOX("Did not find a diference to Save",0,"No Save")
							lSaveAddress = .F.
							THISFORM.ShipAddr = aCodeUsed.ShipCode
							This.Parent.txtShipCode.refresh		
						ELSE
							*Did not find Exact address
							lSaveAddress = .T.
						ENDIF
						USE IN aCodeUsed
					ELSE
						lSaveAddress = .T.
					ENDIF
				ELSE
					*Not changed
				ENDIF
		*	ENDIF   &&nNoChange = 0		* Did NOT find Exact
		
			
			IF lSaveAddress
				PRIVATE	nSaveNew
				
				IF lnShipAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
					
					IF nSaveNew = 7 &&No
						*correcting Address
						*CHECK FOR Orders in progress!!!
						PRIVATE nCntShipAddr 
						nCntShipAddr = Count_pShipAddrinSales_No( lnShipAddr, ThisForm.nConnHandle )
						IF nCntShipAddr > 0
							PRIVATE cMess
							cMess = "There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)
							cMess = cMess + ALLTRIM(STR(nCntShipAddr))+" unshipped Order(s) use the Address number "
							cMess = cMess + ALLTRIM(STR(lnShipAddr))+"."
							MESSAGEBOX(cMess,0+16,"CAUTION")
							
							cMess = cMess+CHR(13)+"First SO changed is:"+ALLTRIM(STR(ThisForm.nSO))
							TrackMess(cMess)
							*UpdateShipAddr_in_sales_No ( ThisForm.nSO, lnShipAddr, ThisForm.nConnHandle )
							
							cMess = "Changed Ship To Address ("+ALLTRIM(STR(lnShipAddr))+") in Packing Slip."
							Save_Sales_Status( ThisForm.nSO, "Change Address", cMess, ThisForm.nConnHandle)
							
						ENDIF
						RELEASE nCntShipAddr
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
				IF nSaveNew = 6 && Yes, save as new
					****** big save procedure********
					
					IF THISFORM.ShipAddr > 0 &&Check old ShipCode to see if anything changed.
						IF USED( 'cntShipAddr' )
							USE IN cntShipAddr
						ENDIF
						SELECT 0
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.ShipAddr WHERE "
						cSQL = cSQL + " Company = '"+lcCompany+"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City  = '"+lcCity+"'"
						cSQL = cSQL + " AND ST    = '"+lcST+"'" 
						cSQL = cSQL + " AND Zip   = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'" 
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number = '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
						cSQL = cSQL + " AND ShipCode = "+STR(THISFORM.ShipAddr)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'cntShipAddr')
						ENDIF
						IF USED('cntShipAddr')
							IF cntShipAddr.Cntd > 0
								lSaveAddr = .F.
							ELSE &&did not match all Fields - Save
								lSaveAddr = .T.
								oldShipCode = THISFORM.ShipAddr
							ENDIF
							USE IN cntShipAddr
						ELSE
							lSaveAddr = .T.
						ENDIF
					ELSE && No ShipCode - add if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							lSaveAddr = .T.
						ELSE
							*No Company or Address to save! Clear!!!
							lSaveAddr = .F.
						ENDIF
					ENDIF && No ShipCode
		
					IF lSaveAddr
		
						IF useShipCode = 0 &&need to find a ShipCode
							*Get maxShipCode
							maxSoldCode = THISFORM.maxSoldCode()
							maxShipCode = THISFORM.maxShipCode()
							useShipCode = MAX( maxSoldCode, maxShipCode )
		
						ENDIF
						IF useShipCode > 0 &&Save here
							THISFORM.ShipAddr = useShipCode
		
							THIS.PARENT.txtShipCode.VALUE = useShipCode
							THIS.PARENT.numShipAddr.VALUE = useShipCode
							
		******************************************************************************					
							PRIVATE cCompany, cAddr1,cAddr2, cCity, cST, cZip, cCountry, cContact, cPhone, cFax, cEmail
							cCompany	= PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
							cAddr1	= PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
							cAddr2	= PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
							cCity	= PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',100)
							cST		= PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',50)
							cZip	= PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',50)
							cCountry	= PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)
							cContact	= PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
							cPhone	= PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
							cFax	= PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
							cEmail	= PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		
							Save_ShipAddrCode(useShipCode, "ShipAddr", oldShipCode, THISFORM.nConnHandle)	
							
							PRIVATE cSQLi
							cSQLi = "INSERT INTO dbo.ShipAddr (shipcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email, Customer, LastEdit) VALUES "
							cSQLi = cSQLi+"("+STR(useShipCode)+""
							cSQLi = cSQLi+",'"+cCompany+"'"
							cSQLi = cSQLi+",'"+cAddr1+"'"
							cSQLi = cSQLi+",'"+cAddr2+"'"
							cSQLi = cSQLi+",'"+cCity+"'"
							cSQLi = cSQLi+",'"+cST+"'"
							cSQLi = cSQLi+",'"+cZip+"'"
							cSQLi = cSQLi+",'"+cCountry+"'"
							cSQLi = cSQLi+",'"+cContact+"'"
							cSQLi = cSQLi+",'"+cPhone+"'"
							cSQLi = cSQLi+",'"+cFax+"'"
							cSQLi = cSQLi+",'"+cEmail+"'"
							cSQLi = cSQLi+", "+ALLTRIM(STR(useShipCode,10,0))+""  &&CustomerID
							cSQLi = cSQLi+",'"+DTOC(DATE())+"' )"
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
								ENDDO
							ENDIF
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO 
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi ,ThisForm.nConnHandle, nSQLEXEC,'')
							ENDIF
		
							IF THISFORM.SoldAddr > 0
								Save_Sold_Ship(THISFORM.SoldAddr, useShipCode, THISFORM.nConnHandle)
							ENDIF
							
							THISFORM.UpdateCustID = .T.
							THIS.PARENT.txtLastEdit.VALUE = DATE()
							THIS.PARENT.txtLastEdit.REFRESH
							THIS.PARENT.numShipAddr.VALUE = useShipCode
							
							***************
							
							IF USED('PackingSlipSO')
								SELECT PackingSlipSO
								SCAN
								IF PackingSlipSO.SO > 0
									IF UpdateShipAddr_in_Sales_No( PackingSlipSO.SO, useShipCode, ThisForm.nConnHandle ) =0
										PRIVATE cMess
										cMess = "Update pShipCode to "+ALLTRIM(STR(useShipCode))
										cMess = cMess +IIF(oldShipCode>0," FROM Ship Code "+ALLTRIM(STR(oldShipCode)),'')
										cMess = cMess +" in SO "+ALLTRIM(STR(PackingSlipSO.SO))+" when packingSlip changed the Shipping Address." 
											
										TrackMess( cMess )
										
										cMess = cMess + CHR(13)
										cMess = cMess + HTML_SO(PackingSlipSO.SO,.T.)+CHR(13)
										cMess = cMess + HTML_SO(PackingSlipSO.SO,.F.)+CHR(13)
										cMess = cMess + HTML_SO_Status(PackingSlipSO.SO,.T.)+CHR(13)
										cMess = cMess + HTML_SO_Status(PackingSlipSO.SO,.F.)+CHR(13)
										cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
										cMess = cMess + HTML_PackingSlip_SO(PackingSlipSO.SO,.T.)+CHR(13)
										cMess = cMess + HTML_PackingSlip_SO(PackingSlipSO.SO,.F.)+CHR(13)
										cMess = cMess + PROGRAM() + " " + SYS(0)
										
										Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited Ship To Address',cMess,0,.T.)
										
									ENDIF					
								ENDIF
								ENDSCAN
							ENDIF
							***************
							
							
						ENDIF
						WAIT CLEAR
					ENDIF
					
				ELSE  &&IF nSaveNew = 6 && Yes
					*REPLACE DATA
					
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.ShipAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
		*			cSQLu= cSQLu+",Customer="+STR(useShipCode,10,0))+""  &&CustomerID
					cSQLu= cSQLu+",LastEdit='"+DTOC(ldLastEdit)+"'"
					cSQLu= cSQLu+" WHERE ShipCode = "+STR(lnShipAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC,'')
					ELSE
						
						PRIVATE cMess
						cMess = "Edited pShipCode "+ALLTRIM(STR(lnShipAddr))
						cMess = cMess +" in SO "+ALLTRIM(STR(PackingSlipSO.SO))+" when packingSlip changed the Shipping Address." 
											
						TrackMess( cMess )
										
						cMess = cMess + CHR(13)
						cMess = cMess +"when packingSlip EDITED the Ship To Address."+CHR(13)
						cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
						cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
						cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
						cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
						cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
						cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
						cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
						cMess = cMess + PROGRAM()
						
						Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited Ship To Address',cMess,0,.T.)
					ENDIF
					
						
					THISFORM.UpdateCustID = .T.
		
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
					
					THIS.PARENT.txtShipCode.VALUE = lnShipAddr
					THIS.PARENT.numShipAddr.VALUE = lnShipAddr
					THISFORM.ShipAddr = lnShipAddr
					
				ENDIF   &&  &&IF nSaveNew = 6 && Yes
			ENDIF &&IF lSaveAddress
		
		
			THISFORM.AddressScreen("ShipToEdit")
			THISFORM.cmdNext.SETFOCUS()
		
		ELSE   &&IF THIS.CAPTION = "Save"
			*Set to Edit mode
			THISFORM.AddressScreen("ShipToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF  
		
	ENDPROC

	PROCEDURE pf1.pgShipTo.cmdSearchShipTo.Click
		Private matchCodes, nNewShipToCode ,lcCurrTable, nShipAddr 
		nNewShipToCode = 0
		matchCodes = 0
		lcCurrTable = ALIAS()
		nShipAddr = PrepareSQLnum(ThisForm.ShipAddr,'ShipAddr',-3)
		
		PRIVATE lcCompany
		lcCompany = PrepareSQLtxt(This.Parent.txtCompany.Value,'Company',100)
		IF LEN(lcCompany) = 0
			lcCompany = PrepareSQLtxt(ThisForm.Pf1.pgOverView.Sold1.Caption,'Company',100)
		ENDIF
		
		DO FORM Forms\SearchForm WITH "ShipAddr",lcCompany  TO nNewShipToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
		*		SELECT 
			ENDIF
		EndIF
		
		IF nNewShipToCode > 0 AND nNewShipToCode <> nShipAddr 
			IF USED("tShipAddr")
				USE IN tShipAddr
			ENDIF
			
			SELECT 0
			cSQL = "SELECT * FROM dbo.ShipAddr WHERE ShipAddr.ShipCode = "+STR(nNewShipToCode) 
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tShipAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tShipAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tShipAddr')
			ENDIF
			
			IF VARTYPE(tShipAddr.ShipCode) = "N"
				ThisForm.ShipAddr = tShipAddr.ShipCode
				This.Parent.txtShipCode.Value = tShipAddr.ShipCode
				This.Parent.txtCompany.Value = tShipAddr.Company
				This.Parent.txtAddr1.Value = tShipAddr.Addr1
				This.Parent.txtAddr2.Value = tShipAddr.Addr2
				This.Parent.txtCity.Value = tShipAddr.City
				This.Parent.txtST.Value = tShipAddr.ST
				This.Parent.txtZip.Value = tShipAddr.Zip
				This.Parent.txtCountry.Value = tShipAddr.Country
				This.Parent.txtContact.Value = tShipAddr.Contact
				This.Parent.txtPhone.Value = tShipAddr.TelePhone
				This.Parent.txtFax.Value = tShipAddr.Fax_Number
				This.Parent.txtEmail.Value = tShipAddr.Email
				This.Parent.txtLastEdit.Value = CTOD(DTOC(tShipAddr.LastEdit))
				
				ThisForm.AddressScreen("ShipToSave")
				
				PRIVATE cHTML
				cHTML = "Packing Slip Program Update pShipCode to "+ALLTRIM(STR(PrepareSQLnum(ThisForm.ShipAddr,'ShipCode',-3)))+" in SO "+HTML_SO(PrepareSQLnum(ThisForm.nSO,'SalesNum',-3))+CHR(13)+" when PackingSlip changed the Ship To Address."
				TrackMess( cHTML )
				cHTML = cHTML + CHR(13)+"PackingSlip:cmdSearchShipTo.Click"
				Send_HTML_Email('David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited Sold To Address',cHTML,0,.T.)
				
				This.Enabled = .f.
				
			ENDIF
			IF USED("tShipAddr")
				USE IN tShipAddr
			ENDIF
		ENDIF 
	ENDPROC

	PROCEDURE pf1.pgShipTo.Init
		*ThisForm.AddressScreen("ShipToEdit")
		
	ENDPROC

	PROCEDURE pf1.pgSoldTo.Click
		thisform.CurrPage = 2
		thisform.Refresh()
		
	ENDPROC

	PROCEDURE pf1.pgSoldTo.cmdClearSold.Click
		PRIVATE lcMessAns, mHoldRecordNum 
		lcMessAns = 6
		
		IF THISFORM.SoldAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			THISFORM.SoldAddr = 0
			THIS.PARENT.cmdSearchSoldTo.ENABLED = .T.
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
			THIS.PARENT.txtSoldCode.Value	= 0
			
			This.Parent.cmdSearchSoldTo.Enabled = .T.
			
			THISFORM.AddressScreen("SoldToEdit")
			
		ELSE
			IF THIS.PARENT.cmdEditSoldTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
					
		*			DIMENSION aSoldAddr(1,13)
		*			SELECT SoldCode,Company,Addr1,Addr2,City,ST,Zip,Country,Contact,Telephone,Fax_Number,Email,LastEdit ;
		*				FROM HPA!SoldAddr ;
		*				INTO ARRAY aSoldAddr ;
		*				WHERE SoldAddr.SoldCode = THISFORM.SoldAddr
		
					IF USED( 'tSoldAddr' )
						USE IN tSoldAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.SoldAddr"
					cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(THISFORM.SoldAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tSoldAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tSoldAddr')
					ENDIF
			
					IF USED('tSoldAddr')
						THISFORM.SoldAddr = tSoldAddr.SoldCode
						THIS.PARENT.txtSoldCode.VALUE = tSoldAddr.SoldCode
						THIS.PARENT.txtCompany.VALUE = tSoldAddr.Company
						THIS.PARENT.txtAddr1.VALUE = tSoldAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE = tSoldAddr.Addr2
						THIS.PARENT.txtCity.VALUE = tSoldAddr.City
						THIS.PARENT.txtST.VALUE = tSoldAddr.ST
						THIS.PARENT.txtZip.VALUE = tSoldAddr.Zip
						THIS.PARENT.txtCountry.VALUE = tSoldAddr.Country
						THIS.PARENT.txtContact.VALUE = tSoldAddr.Contact
						THIS.PARENT.txtPhone.VALUE = tSoldAddr.Telephone
						THIS.PARENT.txtFax.VALUE = tSoldAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE = tSoldAddr.Email
						THIS.PARENT.txtLastEdit.VALUE = CTOD(DTOC(tSoldAddr.LastEdit))
					
						USE IN tSoldAddr
					ENDIF
		
					THISFORM.AddressScreen("SoldToEdit")
					
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pf1.pgSoldTo.cmdEditSoldTo.Click
		PRIVATE	maxSoldCode, maxShipCode, oldSoldCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnSoldAddr
		PRIVATE lcContact,lcPhone,lcFax,lcEmail
		PRIVATE mCopy2Ship
		mCopy2Ship = 0
		PRIVATE oldSoldCode, useSoldCode 
		oldSoldCode = 0
		useSoldCode = 0
		
		
		lcCompany 	= PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
		lcAddr1 	= PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
		lcAddr2 	= PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
		lcCity  	= PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',50)
		lcST    	= PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'St',50)
		lcZip   	= PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',50)
		lcCountry 	= PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)
		lcContact 	= PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
		lcPhone 	= PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
		lcFax		= PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
		lcEmail 	= PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		ldLastEdit 	= DATE()
		lnSoldAddr = THISFORM.SoldAddr
		
		PRIVATE lSaveAddress, lSaveAddr, nNoChange  
		lSaveAddress = .F.
		lSaveAddr = .F.
		nNoChange   = 0
		
		*oldSoldCode = 0
		PRIVATE cSQL, nSQLEXEC
		
		IF THIS.CAPTION = "Save"	
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry))
				lSaveAddress = .T.
			ENDIF
			
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!",0,"Not saved.")
				lSaveAddress = .F.
				Return .F.
			ENDIF
			
			IF lnSoldAddr > 0
				
				*IF EMPTY(THISFORM.SoldAddr)
					*look for a change
							
					IF USED('aCodeUsed')
						USE IN aCodeUsed
					ENDIF
					SELECT 0
					cSQL="SELECT soldcode FROM dbo.SoldAddr WHERE "
					cSQL = cSQL+" Company = '"+lcCompany+"'"
					cSQL = cSQL+" AND Addr1 = '"+lcAddr1+"'"
					cSQL = cSQL+" AND Addr2 = '"+lcAddr2+"'"
					cSQL = cSQL+" AND City = '"+lcCity+"'"
					cSQL = cSQL+" AND ST = '"+lcST+"'"
					cSQL = cSQL+" AND ZIP = '"+lcZip+"'"
					cSQL = cSQL+" AND Country = '"+lcCountry+"'"
					cSQL = cSQL+" AND Contact = '"+lcContact+"'"
					cSQL = cSQL+" AND Telephone = '"+lcPhone+"'"
					cSQL = cSQL+" AND Fax_Number = '"+lcFax+"'"
					cSQL = cSQL+" AND Email	= '"+lcEmail+"'"
					cSQL = cSQL+" AND soldcode = "+STR(lnSoldAddr)
		
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'aCodeUsed')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'aCodeUsed')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aCodeUsed' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aCodeUsed' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aCodeUsed")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aCodeUsed")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'aCodeUsed' )
					ENDIF
					
					IF USED('aCodeUsed')
						IF aCodeUsed.SoldCode > 0	
							*Found Exact
							MESSAGEBOX("Did not find a diference to Save",0,"No Save")
							lSaveAddress = .F.
							THISFORM.SoldAddr = aCodeUsed.SoldCode
							This.Parent.txtSoldCode.refresh	
						ELSE
							*Did not find Exact address
							lSaveAddress = .T.
						ENDIF
						USE IN aCodeUsed
					ELSE
						lSaveAddress = .T.
					ENDIF
				ELSE
					*Not changed
				ENDIF
		*	ENDIF &&nNoChange = 0		* Did NOT find Exact
		
		
			IF lSaveAddress
				PRIVATE	nSaveNew
			
				IF lnSoldAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
		
					IF nSaveNew = 7 &&No
						*correcting Address
						*CHECK FOR Orders in progress!!!
						PRIVATE nCntSoldAddr 
						nCntSoldAddr = Count_pSoldAddrinSales_No( lnSoldAddr,ThisForm.nConnHandle )
						IF nCntSoldAddr > 0
							PRIVATE cMess
							cMess = "There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)
							cMess = cMess + ALLTRIM(STR(nCntSoldAddr))+" unshipped Order(s) use the Address number "
							cMess = cMess + ALLTRIM(STR(lnSoldAddr))+"."
							MESSAGEBOX(cMess,0+16,"CAUTION")
							
							cMess = cMess+CHR(13)+"First SO changed is:"+ALLTRIM(STR(ThisForm.nSO))
							TrackMess(cMess)
							Save_Sales_Status( ThisForm.nSO, "Change Address", "Changed Sold To Address ("+ALLTRIM(STR(lnSoldAddr))+") in Packing Slip.", ThisForm.nConnHandle)
							
						ENDIF
						RELEASE nCntSoldAddr
							
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
		
				IF nSaveNew = 6 && Yes, save as new
					****** big save procedure********
					
					IF THISFORM.SoldAddr > 0 &&Check old SoldCode to see if anything changed.
						IF USED( 'cntSoldAddr' )
							USE IN cntSoldAddr
						ENDIF
						SELECT 0
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SoldAddr WHERE "
						cSQL = cSQL + " Company = '"+lcCompany+"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City  = '"+lcCity+"'"
						cSQL = cSQL + " AND ST    = '"+lcST+"'" 
						cSQL = cSQL + " AND Zip   = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'" 
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number = '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
						cSQL = cSQL + " AND SoldCode = "+STR(THISFORM.SoldAddr)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSoldAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSoldAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSoldAddr' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSoldAddr' )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSoldAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSoldAddr')
						ENDIF
						IF USED('cntSoldAddr')
							IF cntSoldAddr.Cntd > 0
								lSaveAddr = .F.
							ELSE &&did not match all Fields - Save
								lSaveAddr = .T.
								oldSoldCode = THISFORM.SoldAddr
							ENDIF
							USE IN cntSoldAddr
						ELSE
							lSaveAddr = .T.
						ENDIF
					ELSE && No SoldCode - add if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							lSaveAddr = .T.
						ELSE
							*No Company or Address to save! Clear!!!
							lSaveAddr = .F.
						ENDIF
					ENDIF && No SoldCode
		
					IF lSaveAddr
			
						IF useSoldCode = 0 &&need to find a SoldCode
							*Get maxSoldCode
							maxSoldCode = THISFORM.maxSoldCode()
							maxShipCode = THISFORM.maxShipCode()
							
							DO WHILE FoundSoldCode( maxSoldCode,ThisForm.nConnHandle)
								maxSoldCode = maxSoldCode + 1
							ENDDO
		
							maxSoldCode= MAX( maxSoldCode, maxShipCode )
							maxSoldCode = maxSoldCode + 2 &&leave space for Shipto Edits
							useSoldCode = maxSoldCode
							
						ENDIF
						IF useSoldCode > 0 &&Save here
							THISFORM.SoldAddr = useSoldCode
		
							THIS.PARENT.txtSoldCode.VALUE = useSoldCode
							THIS.PARENT.numSoldAddr.VALUE = useSoldCode
		
		
		*****************************************************************				
							PRIVATE cCompany, cAddr1,cAddr2, cCity, cST, cZip, cCountry, cContact, cPhone, cFax, cEmail
							cCompany	= PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
							cAddr1	= PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
							cAddr2	= PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
							cCity	= PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',50)
							cST		= PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',50)
							cZip	= PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',12)
							cCountry	= PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)
							cContact	= PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
							cPhone	= PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
							cFax	= PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
							cEmail	= PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
							
							*IF Save_ShipAddrCode(maxSoldCode, ALLTRIM(STR(maxSoldCode,10,0)), oldSoldCode, THISFORM.nConnHandle)
							*ENDIF
							
							PRIVATE cSQLi
							*cSQLi = "INSERT INTO dbo.ShipAddr (shipcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email,Customer, LastEdit) VALUES "
							cSQLi = "INSERT INTO dbo.SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email, Customer, LastEdit) VALUES "
							cSQLi = cSQLi+"("+STR(maxSoldCode)+""
							cSQLi = cSQLi+",'"+cCompany+"'"
							cSQLi = cSQLi+",'"+cAddr1+"'"
							cSQLi = cSQLi+",'"+cAddr2+"'"
							cSQLi = cSQLi+",'"+cCity+"'"
							cSQLi = cSQLi+",'"+cST+"'"
							cSQLi = cSQLi+",'"+cZip+"'"
							cSQLi = cSQLi+",'"+cCountry+"'"
							cSQLi = cSQLi+",'"+cContact+"'"
							cSQLi = cSQLi+",'"+cPhone+"'"
							cSQLi = cSQLi+",'"+cFax+"'"
							cSQLi = cSQLi+",'"+cEmail+"'"
							cSQLi = cSQLi+", "+ALLTRIM(STR(maxSoldCode,10,0))+""  &&CustomerID
							cSQLi = cSQLi+",'"+DTOC(DATE())+"' )"
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle , cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle , cSQLi)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
								ENDDO
							ENDIF
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO 
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi ,ThisForm.nConnHandle, nSQLEXEC, '' )
							ENDIF
						
							IF THISFORM.ShipAddr > 0
								Save_Sold_Ship(THISFORM.SoldAddr, THISFORM.ShipAddr, THISFORM.nConnHandle)
							ENDIF
							
							THISFORM.UpdateCustID = .T.
							THIS.PARENT.txtLastEdit.VALUE = DATE()
							THIS.PARENT.txtLastEdit.REFRESH
							THIS.PARENT.numSoldAddr.VALUE = maxSoldCode
							
							***************
							IF USED('PackingSlipSO')
								SELECT PackingSlipSO
								SCAN
								IF PackingSlipSO.SO > 0
									IF UpdateSoldAddr_in_Sales_No( PackingSlipSO.SO, maxSoldCode, ThisForm.nConnHandle ) = 0
										PRIVATE cMess
										cMess = "Update pSoldCode to "+ALLTRIM(STR(PrepareSQLnum(maxSoldCode,'SoldCode',-3)))
										cMess = cMess + IIF(useSoldCode >0," From SoldCode "+ALLTRIM(STR(useSoldCode)),"")
										cMess = cMess +" in SO "+ALLTRIM(STR(PackingSlipSO.SO))+" when packingSlip changed the Sold To Address." 
															
										TrackMess( cMess )
														
										cMess = cMess + CHR(13)
										cMess = cMess +"when packingSlip changed the Sold To Address."+CHR(13)
										cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
										cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
										cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
										cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
										cMess = cMess + " when packingSlip changed the Sold to Address."+CHR(13)
										cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
										cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
										cMess = cMess + PROGRAM()+" "+SYS(0)
										
										Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited Sold To Address for SO '+STR(PackingSlipSO.SO),"Updated pSoldCode to "+ALLTRIM(STR(lnSoldAddr))+" in SO "+ALLTRIM(STR(ThisForm.nSO))+" when packingSlip EDITED the Sold To Address."+CHR(13)+"PackingSlip:cmdEditSoldTo.Click()",0,.T.)
										
										*PRIVATE cHTML
										*cHTML = "Update pSoldCode to "+ALLTRIM(STR(PrepareSQLnum(maxSoldCode,'SoldCode',-3)))+" in SO "+ALLTRIM(STR(PrepareSQLnum(ThisForm.nSO,'SalesNum',-3)))+" when PackingSlip changed the Billing Address."
										*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited Sold To Address for SO '+STR(PackingSlipSO.SO),cHTML+CHR(13)+PROGRAM(),0,.T.)
										
									ENDIF
								ENDIF
								ENDSCAN
							ENDIF
							***************
						
		
						ENDIF
						WAIT CLEAR
					ENDIF
				ELSE
					*REPLACE DATA
		
					PRIVATE cSQLu
					cSQLu = "UPDATE dbo.SoldAddr SET "
					cSQLu = cSQLu + " Company='"+lcCompany+"'"
					cSQLu = cSQLu + ",Addr1='"+lcAddr1+"'"
					cSQLu = cSQLu + ",Addr2='"+lcAddr2+"'"
					cSQLu = cSQLu + ",City='"+lcCity+"'"
					cSQLu = cSQLu + ",ST='"+lcST+"'"
					cSQLu = cSQLu + ",Zip='"+lcZip+"'"
					cSQLu = cSQLu + ",Country='"+lcCountry+"'"
					cSQLu = cSQLu + ",Contact='"+lcContact+"'"
					cSQLu = cSQLu + ",Telephone='"+lcPhone+"'"
					cSQLu = cSQLu + ",Fax_Number='"+lcFax+"'"
					cSQLu = cSQLu + ",Email='"+lcEmail+"'"
		*			cSQLu = cSQLu + ",Customer="+ALLTRIM(STR(maxSoldCode,10,0))+""  &&Peach Customer is not avaliable here!
					cSQLu = cSQLu + ",LastEdit='"+DTOC(DATE())+"'"
					cSQLu = cSQLu + " WHERE SoldCode = "+STR(lnSoldAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC,'')
					ELSE
						PRIVATE cMess
						cMess = "Edited pSoldCode "+ALLTRIM(STR(lnSoldAddr))
						cMess = cMess +" in SO "+ALLTRIM(STR(PackingSlipSO.SO))+" when packingSlip changed the Sold To Address." 
											
						TrackMess( cMess )
										
						cMess = cMess + CHR(13)
						cMess = cMess +"when packingSlip EDITED the Sold To Address."+CHR(13)
						cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
						cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
						cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
						cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
						cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
						cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
						cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
						cMess = cMess + PROGRAM()+" "+SYS(0)
						
						Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(), "PackingSlip edited Sold To Address for SO "+STR(PackingSlipSO.SO), "Updated pSoldCode to "+ALLTRIM(STR(lnSoldAddr))+" in SO "+ALLTRIM(STR(ThisForm.nSO))+" when packingSlip EDITED the Sold To Address."+CHR(13)+"PackingSlip:cmdEditSoldTo.Click()",0,.T.)
						
					ENDIF
		
					THISFORM.UpdateCustID = .T.
					
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
					THIS.PARENT.txtSoldCode.VALUE = lnSoldAddr
					This.Parent.numSoldAddr.Value = lnSoldAddr
					THISFORM.SoldAddr = lnSoldAddr
		
				ENDIF
			ENDIF
			
		*!*		IF mCopy2Ship = 6
		*!*			THISFORM.AddressScreen("SoldToEdit")
		*!*			*THISFORM.cmdNext.SETFOCUS()
		*!*			This.Parent.Parent.pgShipTo.SETFOCUS
		*!*			WAIT WINDOW "Remember to Click Save on the Ship Address." NOWAIT
		*!*		ELSE
					THISFORM.AddressScreen("SoldToEdit")
					THISFORM.cmdNext.SETFOCUS()
		*!*		ENDIF
			
		ELSE &&Caption was Edit
			*Set to Edit mode
			THISFORM.AddressScreen("SoldToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE pf1.pgSoldTo.cmdSearchSoldTo.Click
		Private matchCodes, nNewSoldToCode, lcCurrTable, nSoldAddr
		nNewSoldToCode = 0
		matchCodes = 0
		lcCurrTable = ALIAS()
		nSoldAddr = PrepareSQLnum(ThisForm.SoldAddr,'SoldAddr',-3)
		
		PRIVATE lcCompany
		lcCompany = PrepareSQLtxt(This.Parent.txtCompany.Value,'Company',100)
		IF LEN(lcCompany) = 0
			lcCompany = PrepareSQLtxt(ThisForm.Pf1.pgOverView.Sold1.Caption,'Company',100)
		ENDIF
		
		DO FORM Forms\SearchForm WITH "SoldAddr",lcCompany TO nNewSoldToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesNum
			ENDIF
		EndIF
		
		IF nNewSoldToCode > 0 AND nSoldAddr <> nNewSoldToCode
			IF USED('tSoldAddr')
				USE IN tSoldAddr
			ENDIF
			SELECT 0
			cSQL="SELECT * FROM dbo.SoldAddr WHERE SoldAddr.SoldCode = "+STR(nNewSoldToCode)
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tSoldAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'tSoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 	
			IF nSQLEXEC < 0
				SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tSoldAddr' )
			ENDIF
				
			IF USED("tSoldAddr")
				IF NOT EMPTY(tSoldAddr.SoldCode)
					ThisForm.SoldAddr = tSoldAddr.SoldCode
					This.Parent.txtSoldCode.Value = tSoldAddr.SoldCode
					This.Parent.txtCompany.Value = tSoldAddr.Company
					This.Parent.txtAddr1.Value = tSoldAddr.Addr1
					This.Parent.txtAddr2.Value = tSoldAddr.Addr2
					This.Parent.txtCity.Value = tSoldAddr.City
					This.Parent.txtST.Value = tSoldAddr.ST
					This.Parent.txtZip.Value = tSoldAddr.Zip
					This.Parent.txtCountry.Value = tSoldAddr.Country
					This.Parent.txtContact.Value = tSoldAddr.Contact
					This.Parent.txtPhone.Value = tSoldAddr.TelePhone
					This.Parent.txtFax.Value = tSoldAddr.Fax_Number
					This.Parent.txtEmail.Value = tSoldAddr.Email
					This.Parent.txtLastEdit.Value = CTOD(DTOC(tSoldAddr.LastEdit))
					
					ThisForm.AddressScreen("SoldToSave")
					
					PRIVATE cHTML
					cHTML = "Packing Slip Program Update pSoldCode to "+ALLTRIM(STR(PrepareSQLnum(tSoldAddr.SoldCode,'SoldCode',-3)))+" in SO "+HTML_SO(PrepareSQLnum(ThisForm.nSO,'SalesNum',-3))+CHR(13)+" when PackingSlip changed the Sold To Address."
					TrackMess( cHTML )
					cHTML = cHTML + CHR(13)+"PackingSlip:cmdSearchSoldTo.Click"
					*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited Sold To Address',cHTML,0,.T.)
					PRIVATE cMess
					cMess = "Packing Slip Program Update pSoldCode to "+PrepareSQLtxt(tSoldAddr.SoldCode,'SoldCode',10)+" in SO "+PrepareSQLtxt(ThisForm.nSO,'SalesNum',10)+CHR(13)
					cMess = cMess +" when PackingSlip changed the Sold To Address."+CHR(13) 
					cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
					cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
					cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
					cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
					cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
					cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
					cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
					cMess = cMess + PROGRAM()
					Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),"Packing Slip Program Update pSoldCode",cMess,0,.T.)	
					
			
					This.Enabled = .f.
					
				ENDIF
				USE IN tSoldAddr
				
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgSoldTo.Init
		*ThisForm.AddressScreen("SoldToEdit")
		
	ENDPROC

	PROCEDURE pf1.pgWhatEver.chkEmailConf.Valid
		IF PrepareSQLlogic(THIS.VALUE,'EmailConf')
			This.Parent.txtEmail.Visible = .T.
			*Need an Address
			IF EMPTY(This.Parent.txtEmail.Value)
				IF !EMPTY(This.Parent.Parent.pgSoldTo.txtEmail.Value)
					This.Parent.txtEmail.Value = This.Parent.Parent.pgSoldTo.txtEmail.Value
				ENDIF
			ENDIF
			This.Parent.txtEmail.SetFocus()
		ELSE
			This.Parent.txtEmail.Visible = .F.
			This.Parent.txtEmail.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgWhatEver.chkFaxConf.Click
		IF PrepareSQLlogic(THIS.VALUE,'FaxConf')
			This.Parent.txtFax.Visible = .T.
			*Need an Address
			IF EMPTY(This.Parent.txtFax.Value)
				IF !EMPTY(This.Parent.Parent.pgSoldTo.txtFax.Value)
					This.Parent.txtFax.Value = "1"+This.Parent.Parent.pgSoldTo.txtFax.Value
				ENDIF
			ENDIF
			This.Parent.txtFax.SetFocus()
		ELSE
			This.Parent.txtFax.Visible = .F.
			This.Parent.txtFax.Value = ""
		ENDIF
		
	ENDPROC

	PROCEDURE pf1.pgWhatEver.Click
		ThisForm.CurrPage = 7
		
		*check with BOL to Populate here
		ThisForm.FillPacked_BoL()
		
		
		PRIVATE cSOitem, dPS_Date 
		dPS_Date = PrepareSQLdate(This.txtShipDate.Value,'ShipDate')
		
		IF Empty(dPS_Date)
			
			cSOitem = ''
			dPS_Date = DATE()
			
			*Use the Cancelled ShipDate before the default of today.
			IF USED('PackingSlipItem')
				cSOitem = PrepareSQLtxt(PackingSlipItem.SOitem,'SOitem',10)
			ENDIF
			
			IF LEN(cSOitem) > 1
				IF USED('cntPSCancld')
					USE IN cntPSCancld
				ENDIF
				SELECT 0
				
				cSQL = "SELECT pn.PickUpDate FROM dbo.PackingSlip P "
				cSQL = cSQL + " INNER JOIN dbo.PackingSlip_No PN ON PN.PackingSli = P.PackingSli "
				cSQL = cSQL + " WHERE P.Cancld = 1 "
				cSQL = cSQL + " AND P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntPSCancld')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'cntPSCancld')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPSCancld')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPSCancld')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPSCancld")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPSCancld")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'cntPSCancld' )
				ENDIF
				
				IF USED('cntPSCancld')
					IF RECCOUNT('cntPSCancld') > 0
						dPS_Date = cntPSCancld.PickUpDate
					ENDIF
					USE IN cntPSCancld
				ENDIF
			ENDIF
				
			This.txtShipDate.Value = dPS_Date  &&DATE()
		ENDIF
		
		
		IF PrepareSQLlogic(This.chkFaxConf.Value,'FaxConf',.F.) AND This.txtFax.Visible = .F.
			*So check says to fax, try to get fax no
			IF !EMPTY(This.Parent.pgSoldTo.txtFax.Value) 
				This.txtFax.Value = "1"+This.Parent.pgSoldTo.txtFax.Value
			ENDIF
			This.txtFax.Visible = .T.
		ENDIF
		
		IF PrepareSQLlogic(This.chkEmailConf.Value,'EmailConf',.F.) AND This.txtEmail.Visible = .F.
			*So check says to fax, try to get fax no
			IF !EMPTY(This.Parent.pgSoldTo.txtEmail.Value) 
				This.txtEmail.Value = This.Parent.pgSoldTo.txtEmail.Value
			ENDIF
			This.txtEmail.Visible = .T.
		ENDIF
		
		ThisForm.Refresh()
		
	ENDPROC

	PROCEDURE pf1.pgWhatEver.cmbShipFrom.Init
		PRIVATE cSQL, nSQLEXEC
		IF USED('tmpShipFrom')
			SELECT tmpShipFrom
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT Distinct [ShipFrom] FROM dbo.PackingSlip_No "
		cSQL = cSQL + " WHERE [ShipFrom] IS NOT NULL "
		cSQL = cSQL + " ORDER BY [ShipFrom] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShipFrom')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShipFrom')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShipFrom')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShipFrom')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShipFrom")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShipFrom")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipFrom')
		ENDIF
		
		*DIMENSION atmpShipFrom(1,2)
		DIMENSION aShipFrom[1]
		
		IF USED('tmpShipFrom')
			SELECT ShipFrom FROM tmpShipFrom INTO ARRAY aShipFrom
			
			USE IN tmpShipFrom
		ENDIF
		
		this.clear
		This.ColumnCount = 1
		This.NumberOfElements=ALEN(aShipFrom)
		This.BoundColumn = 1
		This.ColumnWidths = "125"
		This.RowSourceType = 5
		This.RowSource = 'aShipFrom'
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aShipFrom,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aShipFrom(I, 1),I,1)
		*	this.addListitem(aShipFrom(I, 2),I,2)
		ENDFOR
		
		PRIVATE nASCAN_Num
		nASCAN_Num = ASCAN(aShipFrom, 'Tipton') 
		IF nASCAN_Num > 0
			This.Value = nASCAN_Num 
		ELSE
			This.Value = 1
			aShipFrom(1)='Tipton'
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgWhatEver.cmbShipFrom.Valid
		*ThisForm.RefreshForms(This.Value)
		
	ENDPROC

	PROCEDURE pf1.pgWhatEver.Label7.Click
		*cmbShipFrom.Value = aShipFrom(aLen(aShipFrom))
		*cShipFrom = PrepareSQLtxt(ThisForm.pf1.pgWhatEver.cmbShipFrom.DisplayValue,'ShipFrom',20)
	ENDPROC

	PROCEDURE pf1.pgWhatEver.lblShipDate.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = This.Parent.txtShipDate.Value
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		This.Parent.txtShipDate.Value = dDate2
		
	ENDPROC

	PROCEDURE pf1.pgWhatEver.txtShippedVIA.Destroy
		RELEASE aShipRoutes
	ENDPROC

	PROCEDURE pf1.pgWhatEver.txtShippedVIA.Init
		PUBLIC aShipRoutes(1)
		aShipRoutes(1)=" "
		
		*SELECT DISTINCT UPPER(ShipRoute) FROM Sales_No INTO ARRAY aShipRoutes
		IF USED("tmpSales_No")
			USE IN tmpSales_No
		ENDIF
		SELECT 0
		cSQL = "SELECT DISTINCT UPPER(ShipRoute) AS ShipRoute FROM dbo.Sales_No ORDER BY ShipRoute"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_No')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSales_No')
		ENDIF
		
		IF USED('tmpSales_No')
			SELECT tmpSales_No
			COPY TO ARRAY aShipRoutes FIELDS ShipRoute
			USE IN tmpSales_No
		ELSE
			aShipRoutes(1) = ""
		ENDIF
		*ThisForm.cShipVia
	ENDPROC

	PROCEDURE pf1.pgWhatEver.txtShippedVIA.InteractiveChange
		lnInsertionPt = IIF(this.SelStart=0,25,this.SelStart)
		*lcSearchStr = substr(this.value,1,lnInsertionPt)
		lcSearchStr = UPPER(substr(this.value,1,lnInsertionPt))
		
		
		PRIVATE nPos
		nPos = 0
		
		IF !empty(lcSearchStr)
			nPos = ASCAN(aShipRoutes, lcSearchStr ) && Search for company
			
			IF nPos != 0
				this.VALUE=aShipRoutes(nPos )
			ELSE
				this.value=lcSearchStr
			ENDIF
		ELSE
			this.value=space(0)
		ENDIF
		this.selstart = lnInsertionPt
	ENDPROC

	PROCEDURE pf1.pgWhatEver.txtShippedVIA.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE pf1.pgWhatEver.txtShippedVIA.Valid
		PRIVATE cShipVia, cShipViaOrig
		cShipVia = PrepareSQLtxt(This.Value,'ShipVia',20)
		cShipViaOrig = ThisForm.cShipVia
		
		IF cShipViaOrig = "''"
			cShipViaOrig = ""
			ThisForm.cShipVia = ""
		ENDIF
		
		PRIVATE cMess
		cMess = ''
		
		PRIVATE cSO,cSalesP,cSalesPemail,cSoldCompany
		cSO = ALLTRIM(STR( PrepareSQLnum(ThisForm.nSO,'SalesNum',-3)))
		*cSalesP = SalesPfromSO(ThisForm.nSO)
		cSalesP = getFromQuotesSO(ThisForm.nSO,'SALESP',ThisForm.nConnhandle)
		cSalesPemail = SalesPemail(cSalesP)
		cSoldCompany = ALLTRIM(PrepareSQLtxt(This.parent.parent.pgSoldTo.txtCompany.Value,'Company',30))
		
		IF NOT EMPTY(cShipVia) 
			IF UPPER(cShipVia) = "WILL CALL"
				RETURN .T.
			ENDIF
			IF UPPER(cShipViaOrig) = "TBD"
				RETURN .T.
			ENDIF
			IF UPPER(cShipViaOrig) = "TBA"
				RETURN .T.
			ENDIF
		
			IF NOT EMPTY(ALLTRIM(cShipViaOrig))
				cMess = "SalesP:"+cSalesP+" wrote order "+cSO+" to Ship Via:"+cShipViaOrig+" to "+cSoldCompany+". Now its to ship Via:"+cShipVia
				MESSAGEBOX(cMess,48,"Not as written")
				
				TrackMess( cMess )
		
				*Send_HTML_Email( cSalesPemail,'David.Kirchner@SpaceAlloysUSA.com','PackingSlip edited ShipVia',cMess,0,.T.)
				PRIVATE cMess
				cMess = "SalesP:"+cSalesP+" wrote order "+cSO+" to Ship Via:"+cShipViaOrig+" to "+cSoldCompany+"."+CHR(13) 
				cMess = cMess +"Now its to ship Via:"+cShipVia+CHR(13)
				cMess = cMess +"when packingSlip was created."+CHR(13)
				cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
				cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
				cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
				cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
				cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
				cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
				cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
				cMess = cMess + PROGRAM()
				Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited ShipVIA',cMess,0,.T.)					
			ENDIF
		ELSE
			IF NOT EMPTY(ALLTRIM(cShipViaOrig))
				cMess = "SalesP:"+cSalesP+" wrote order "+cSO+" to Ship Via:'"+cShipViaOrig+"' to "+cSoldCompany+". Now it's blank."
				MESSAGEBOX(cMess,48,"Not as written")
		
				TrackMess( cMess )
		
				PRIVATE cMess
				cMess = "SalesP:"+cSalesP+" wrote order "+cSO+" to Ship Via:"+cShipViaOrig+" to "+cSoldCompany+"."+CHR(13) 
				cMess = cMess +"Now ShipVIA is blank."+CHR(13)
				cMess = cMess +"when packingSlip was created."+CHR(13)
				cMess = cMess + HTML_SO(ThisForm.nSO,.T.)+CHR(13)
				cMess = cMess + HTML_SO(ThisForm.nSO,.F.)+CHR(13)
				cMess = cMess + HTML_SO_Status(ThisForm.nSO,.T.)+CHR(13)
				cMess = cMess + HTML_SO_Status(ThisForm.nSO,.F.)+CHR(13)
				cMess = cMess + " when packingSlip changed the Shipping Address."+CHR(13)
				cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.T.)+CHR(13)
				cMess = cMess + HTML_PackingSlip_SO(ThisForm.nSO,.F.)+CHR(13)
				cMess = cMess + PROGRAM()
				Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'PackingSlip edited ShipVIA',cMess,0,.T.)	
				
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
