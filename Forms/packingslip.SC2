	PROCEDURE packingslip_soitem
		PARAMETERS pSOitem
		*ThisForm.PackingSlip_SOitem(cSOitem)
		*RETURNs LAST PackingSlip for this item
		
		PRIVATE nCount
		nCount = 0
		
		IF VARTYPE(pSOitem) != "C"
			RecordError( 0, 'PARAMETERS ', PROGRAM(), LINENO(),"VFP message: No pSOitem Parameter" )
			RETURN 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("cntPc_PS")
			USE IN cntPc_PS
		ENDIF
		
		cSQL = "SELECT TOP 1 PackingSli FROM dbo.PackingSlip WINT(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOitem+"')"
		cSQL = cSQL + " ORDER BY PackingSli DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPc_PS')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPc_PS' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPc_PS' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPc_PS' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPc_PS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPc_PS")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPc_PS')
		ENDIF
		
		IF USED('cntPc_PS')
			IF RECCOUNT('cntPc_PS') > 0
				nCount = cntPc_PS.PackingSli 
			ENDIF
			USE IN cntPc_PS
		ENDIF
		
		RETURN nCount
	ENDPROC

	PROCEDURE Refresh
		Do Case
			CASE This.CurrPage = 1
				ThisForm.cmdHome.Enabled = .F.
				ThisForm.cmdPrev.Enabled = .F.
				ThisForm.cmdPrev.Visible = .F.
				ThisForm.cmdNext.Enabled = .T.
				ThisForm.cmdNext.Visible = .T.
		*!*		CASE This.CurrPage = 6
		*!*			ThisForm.cmdHome.Enabled = .T.
		*!*			ThisForm.cmdPrev.Enabled = .T.
		*!*			ThisForm.cmdPrev.Visible = .T.
		*!*			ThisForm.cmdNext.Enabled = .T.
		*!*			ThisForm.cmdNext.Visible = .T.
			CASE This.CurrPage = 7
				ThisForm.cmdHome.Enabled = .T.
				ThisForm.cmdPrev.Enabled = .T.
				ThisForm.cmdPrev.Visible = .T.
				ThisForm.cmdNext.Enabled = .F.
				ThisForm.cmdNext.Visible = .F.
			OtherWise
				ThisForm.cmdHome.Enabled = .T.
				ThisForm.cmdPrev.Enabled = .T.
				ThisForm.cmdPrev.Visible = .T.
				ThisForm.cmdNext.Enabled = .T.
				ThisForm.cmdNext.Visible = .T.
		EndCase	
	ENDPROC

