				*SAVE TO Sales_Stock
				**Update with correct PackingSli
				
				nSS_ID = PrepareSQLnum(PackingSlipItem.SS_ID,'SS_ID',-3)
				
				IF nSS_ID > 0
				
					cSQLu = "UPDATE dbo.Sales_Stock SET "
					cSQLu = cSQLu + " ID_Packing="+STR( nID_Packing )
					cSQLu = cSQLu + ",PackingSli="+STR( nPS_NO )
					cSQLu = cSQLu + ",PS_PC="+STR(PackingSlipItem.PCs)
					cSQLu = cSQLu + ",PS_Form='"+(PackingSlipItem.Form)+"'"
