	*<DefinedPropArrayMethod>
		*m: addressscreen
		*m: check2save
		*m: checknewso
		*m: clonesales_stock
		*m: emailconf		&& Send EMAIL Confirmation
		*m: enableprint		&& Sets the Enable of Print.
		*m: faxconf		&& Send FAX Confirmation
		*m: fillpacked_bol
		*m: f_description
		*m: get_id_packing
		*m: maxshipcode		&& Return Max Ship Code
		*m: maxsoldcode		&& Return MAX sold Code
		*m: packingslip_soitem
		*m: refresh3party
		*m: refreshcod
		*m: refreshforms		&& Pass Form
		*m: returnall		&& Places all of one column in one string.
		*m: reversesql
		*m: save_tmplading
		*m: save_tmpquote
		*m: save_tmpsales
		*m: save_tmpsales_stock
		*m: seekpackingsliinpackingslip
		*m: seek_psno_in_packingslip_no
		*m: sendconfemail		&& Send Conf Email
		*m: sendconffax		&& Send Conf Fax
		*m: showsalesorderitemsgrd
		*p: bill3addr		&& 3rd Party Billing Adddres- like soldCode
		*p: caddr_ref
		*p: cc
		*p: cl
		*p: close_allquotes
		*p: close_bill3addr
		*p: close_lading		&& Close_Lading
		*p: close_packingslip
		*p: close_sales
		*p: close_sales_no
		*p: close_ship		&& Close_Ship table on exit
		*p: close_shipaddr
		*p: close_soldaddr
		*p: close_sold_ship
		*p: cshipvia
		*p: currpage		&& Keeps track of Page number.
		*p: nconnhandle
		*p: nsales_stock_ps		&& Used when PackinSli has not been created, but needed fo Sales_Stock.
		*p: nso
		*p: packingslipno		&& holds packing slip number
		*p: psi_soitem		&& Unique Index File Name
		*p: shipaddr		&& Ship to Address code.
		*p: shipon		&& Do not let ship before if true
		*p: soldaddr		&& Sold to Address code.
		*p: s_soitem		&& Unique Index name
		*p: uniq_lad
		*p: uniq_ppo
		*p: uniq_psi
		*p: uniq_psitem
		*p: uniq_pso
		*p: uniq_quote
		*p: uniq_sal
		*p: updatecustid		&& Mark to Update Allquotes CustID with new ID by Salesnum or SOitem.
	*</DefinedPropArrayMethod>

