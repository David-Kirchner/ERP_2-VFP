				ThisForm.cmdPrint.Enabled = .F.
				ThisForm.cmdPrintBlank.Enabled = .F.
				ThisForm.cmdCancel.Enabled = .F.
				
			CASE WhereWhat = "ReleaseAddress"	
		ENDCASE
		ThisForm.EnablePrint()
	ENDPROC

	PROCEDURE check2save
		*ThisForm.Check2Save()
		
		***Check Data
		IF THISFORM.pf1.pgSoldTo.cmdEditSoldTo.CAPTION = "Save"
			MESSAGEBOX("Sold to / Bill to address needs to be saved.",0,"Save first!")
			RETURN .F.
		ENDIF
		
		IF THISFORM.SoldAddr = 0
			IF MESSAGEBOX("There is no Billing Address."+CHR(13)+"Are you sure you want to print?",4+16,"Enter BILLING Address!") = 6
				*
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
		IF THISFORM.pf1.pgShipTo.cmdEditShipTo.CAPTION = "Save"
			MESSAGEBOX("Ship to address needs to be saved.",0,"Save first!")
			RETURN .F.
		ENDIF
		
		IF THISFORM.ShipAddr = 0
			IF MESSAGEBOX("There is no Shipping Address."+CHR(13)+"Are you sure you want to print?",4+16,"Enter Shipping Address!") = 6
				*
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
		IF THISFORM.pf1.pgFreight.cmdEditSoldTo.CAPTION = "Save" AND THISFORM.pf1.pgFreight.ogFreightCharges.VALUE = 3
			MESSAGEBOX("3rd Party address needs to be saved.",0,"Save first!")
			RETURN .F.
		ENDIF
		
		IF EMPTY( THISFORM.pf1.pgWhatEver.txtPackedBy.VALUE + ;
				THISFORM.pf1.pgWhatEver.txtCheckedBy.VALUE + ;
				THISFORM.pf1.pgWhatEver.txtPackage.VALUE )
			*No pack info
			MESSAGEBOX("Please enter 'Packed' information."+CHR(13)+"At least one of these fields must be entered:"+CHR(13)+"Packed by, Checked By or Package Size",0,"No Packing Data found!")
			RETURN .F.
		ENDIF
		
		IF EMPTY(THISFORM.pf1.pgWhatEver.txtShipDate.VALUE)
			THISFORM.pf1.pgWhatEver.txtShipDate.VALUE = DATE()
		ENDIF
		
		PRIVATE dShipDate
		dShipDate = PrepareSQLdate(THISFORM.pf1.pgWhatEver.txtShipDate.VALUE,'ShipDate')
		IF dShipDate = CTOD('1900-01-01')
			dShipDate  =  DATE()
		ENDIF
		IF EMPTY(dShipDate)
			dShipDate  =  DATE()
		ENDIF
		
		PRIVATE cTracking, cShippedVia
		cTracking = UPPER(ALLTRIM(PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtTracking.VALUE,'Tracking',30)))
		cShippedVia	= PrepareSQLtxt(THISFORM.pf1.pgWhatEver.txtshippedvia.VALUE,'ShippedVia',20)
		
		IF "UPS" $ UPPER(cShippedVia)
			IF LEN(cTracking) = 18
				IF LEFT(cTracking,8) = "1Z740338" OR LEFT(cTracking,8) = "1Z4F942R"
					*correct tracking
				ELSE
					IF MESSAGEBOX("UPS tracking number "+cTracking+" is bad."+CHR(13)+"to ship from HPA you would use UPS Code:"+CHR(13)+"'1Z740336' OR '1Z4F942R'"+CHR(13)+CHR(13)+" Enter (Y)es to go back and Edit.",4+48,"Edit Tracking Number?") = 6
						RETURN .F.
					ENDIF
				ENDIF
			ELSE
				IF EMPTY(cTracking)
					MESSAGEBOX("Please Enter the UPS tracking number!",0,"No tracking!")
				ELSE
					IF MESSAGEBOX("UPS tracking number "+cTracking+" is bad."+CHR(13)+CHR(13)+" Enter (Y)es to go back and Edit.",4+48,"Edit Tracking Number?") = 6
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE cShipFrom
		*cShipFrom = RTRIM(PrepareSQLtxt(ThisForm.pf1.pgWhatEver.cmbShipFrom.Value,'ShipFrom',20) )
		cShipFrom = PrepareSQLtxt(ThisForm.pf1.pgWhatEver.cmbShipFrom.DisplayValue,'ShipFrom',20)
		
		
		IF ASCAN(aShipFrom, cShipFrom) > 0
		
		ELSE
		*	IF ASCAN(aShipFrom, cShipFrom2) > 0
		*		cShipFrom  = cShipFrom2
		*	ELSE
				TrackError("Packing Slip ShipFrom '"+cShipFrom+"' was entered." ,"Packing Slip ShipFrom "+cShipFrom , PROGRAM(), LINENO(1))
		*	ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE checknewso
		PARAMETER pSO
		*ThisForm.CheckNewSO(nSO)
		
		PRIVATE nSO, cMess
		nSO = PrepareSQLnum(pSO,'SalesNum',-3)
		cMess = ''
		SELECT 0
		
		*DIMENSION aCount(1)
		*SELECT COUNT(*) FROM HPA!Sales_No WHERE Sales_No.SalesNum = nSO INTO ARRAY aCount
		
		IF nSO > 0
			IF Count_SOinSales_No(nSO, ThisForm.nConnHandle) > 0
		
			*	SELECT PsoldAddr FROM HPA!Sales_No WHERE Sales_No.SalesNum = nSO INTO ARRAY APsoldAddr
			*	IF TYPE("APsoldAddr(1)")="N"
				IF USED('cntAddr')
					USE IN cntAddr
				ENDIF
				SELECT 0
				
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT PSoldAddr FROM dbo.Sales_No WHERE SalesNum = "+STR(nSO)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAddr')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntAddr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAddr')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAddr')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntAddr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntAddr')
				ENDIF
		
				IF USED('cntAddr')
		
					IF VARTYPE(cntAddr.PsoldAddr) = 'N'
						*FILL SOLD ADDR
			*			DIMENSION aSoldAddr(1,13)
			*			SELECT SoldCode,Company,Addr1,Addr2,City,ST,Zip,Country,Contact,Telephone,Fax_number,email,LastEdit ;
			*				FROM HPA!SoldAddr ;
			*				INTO ARRAY aSoldAddr ;
			*				WHERE SoldAddr.SoldCode = APsoldAddr(1)
		
						IF USED('tSoldAddr')
							USE IN tSoldAddr
						ENDIF
						SELECT 0
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT * FROM dbo.SoldAddr WHERE SoldCode = "+STR(cntAddr.PsoldAddr)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tSoldAddr')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tSoldAddr')
						ENDIF
		
						IF USED('tSoldAddr')
							IF EMPTY(THISFORM.SoldAddr)
								THISFORM.SoldAddr = tSoldAddr.SoldCode
								
								ThisForm.pf1.pgSoldTo.txtSoldCode.VALUE = tSoldAddr.SoldCode
								ThisForm.pf1.pgSoldTo.txtCompany.VALUE = tSoldAddr.Company
								ThisForm.pf1.pgSoldTo.txtAddr1.VALUE = tSoldAddr.Addr1
								ThisForm.pf1.pgSoldTo.txtAddr2.VALUE = tSoldAddr.Addr2
								ThisForm.pf1.pgSoldTo.txtCity.VALUE = tSoldAddr.City
								ThisForm.pf1.pgSoldTo.txtST.VALUE = tSoldAddr.ST
								ThisForm.pf1.pgSoldTo.txtZip.VALUE = tSoldAddr.Zip
								ThisForm.pf1.pgSoldTo.txtCountry.VALUE = tSoldAddr.Country
								ThisForm.pf1.pgSoldTo.txtContact.VALUE = tSoldAddr.Contact
								ThisForm.pf1.pgSoldTo.txtPhone.VALUE = tSoldAddr.TelePhone
								ThisForm.pf1.pgSoldTo.txtFax.VALUE = tSoldAddr.Fax_Number
								ThisForm.pf1.pgSoldTo.txtEmail.VALUE = tSoldAddr.Email
								ThisForm.pf1.pgSoldTo.txtLastEdit.VALUE = CTOD(DTOC(tSoldAddr.LastEdit))
							ELSE
								IF THISFORM.SoldAddr <> tSoldAddr.SoldCode
									cMess = "The new SO "+ALLTRIM(STR(nSO))+" was to be Billed to a different Address!"+CHR(13)+"Address Code:"+;
									ALLTRIM(STR(THISFORM.SoldAddr))+" was first, this new SO is for Address Code:"+;
									ALLTRIM(STR(tSoldAddr.SoldCode))+CHR(13)+"Recheck Address before shipping!"
									RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
									
									MESSAGEBOX(cMess,0,"Different Address!")
								ENDIF
							ENDIF
						ENDIF
						USE IN tSoldAddr
					ENDIF
					USE IN cntAddr
				ENDIF
		
				IF USED('PshipAddrSales_No')
					USE IN PshipAddrSales_No
				ENDIF
				SELECT 0
				
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT PshipAddr FROM dbo.Sales_No WHERE SalesNum = "+STR(nSO)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PshipAddrSales_No')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PshipAddrSales_No')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PshipAddrSales_No')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PshipAddrSales_No')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PshipAddrSales_No")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PshipAddrSales_No")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'PshipAddrSales_No')
				ENDIF
		
				IF USED('PshipAddrSales_No')
					IF VARTYPE(PshipAddrSales_No.PshipAddr) = 'N'	
			*	SELECT PshipAddr FROM HPA!Sales_No WHERE Sales_No.SalesNum = nSO INTO ARRAY APshipAddr
			*	IF TYPE("APshipAddr(1)")="N"
			*		IF APshipAddr(1) > 0
						*FILL SHIP ADDR
			*			DIMENSION aShipAddr(1,13)
			*			SELECT ShipCode,Company,Addr1,Addr2,City,ST,Zip,Country,Contact,Telephone,Fax_number,email,LastEdit ;
			*				FROM HPA!ShipAddr ;
			*				INTO ARRAY aShipAddr ;
			*				WHERE ShipAddr.ShipCode = APshipAddr(1)
		
						IF USED('tShipAddr')
							USE IN tShipAddr
						ENDIF
						SELECT 0
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT * FROM dbo.ShipAddr WHERE ShipCode = "+STR(PshipAddrSales_No.PshipAddr)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr')
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tShipAddr')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tShipAddr')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tShipAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tShipAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tShipAddr')
						ENDIF
		
						IF USED('tShipAddr')
							IF EMPTY(THISFORM.ShipAddr)
				
								THISFORM.ShipAddr = tShipAddr.ShipCode
		
								ThisForm.pf1.pgShipTo.txtShipCode.VALUE = tShipAddr.ShipCode
								ThisForm.pf1.pgShipTo.txtCompany.VALUE = tShipAddr.Company
								ThisForm.pf1.pgShipTo.txtAddr1.VALUE = tShipAddr.Addr1
								ThisForm.pf1.pgShipTo.txtAddr2.VALUE = tShipAddr.Addr2
								ThisForm.pf1.pgShipTo.txtCity.VALUE = tShipAddr.City
								ThisForm.pf1.pgShipTo.txtST.VALUE = tShipAddr.ST
								ThisForm.pf1.pgShipTo.txtZip.VALUE = tShipAddr.Zip
								ThisForm.pf1.pgShipTo.txtCountry.VALUE = tShipAddr.Country
								ThisForm.pf1.pgShipTo.txtContact.VALUE = tShipAddr.Contact
								ThisForm.pf1.pgShipTo.txtPhone.VALUE = tShipAddr.TelePhone
								ThisForm.pf1.pgShipTo.txtFax.VALUE = tShipAddr.Fax_number
								ThisForm.pf1.pgShipTo.txtEmail.VALUE = tShipAddr.Email
								ThisForm.pf1.pgShipTo.txtLastEdit.VALUE = CTOD(DTOC(tShipAddr.LastEdit))
							ELSE
								IF THISFORM.ShipAddr <> tShipAddr.ShipCode
									cMess = "The new SO "+ALLTRIM(STR(nSO))+" was to be sent to a different Shipping Address!"+CHR(13)+"Address Code:"+;
									ALLTRIM(STR(THISFORM.ShipAddr))+" was first, this new SO is for Address Code:"+;
									ALLTRIM(STR(tShipAddr.ShipCode))+CHR(13)+"Recheck Address before shipping!"
									RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
									
									MESSAGEBOX(cMess,0,"Different Address!")
								ENDIF
							ENDIF
							USE IN tShipAddr
						ENDIF
		
					ENDIF
				ENDIF
		
				IF USED('tmpShipDetail')
					USE IN tmpShipDetail
				ENDIF
				SELECT 0
				
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT ShipRoute,Shippay,PayType,blind,FaxConf,EmailConf,FreightEst "
				cSQL = cSQL + " FROM dbo.Sales_No WHERE SalesNum = "+STR(nSO)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShipDetail')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShipDetail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShipDetail')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShipDetail')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShipDetail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShipDetail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpShipDetail')
				ENDIF
		
				IF USED('tmpShipDetail')
			*	SELECT ShipRoute,Shippay,PayType,blind,FaxConf,EmailConf,FreightEst  FROM HPA!Sales_No WHERE Sales_No.SalesNum = nSO INTO ARRAY tmpShipDetail
					*ShipRoute
					IF EMPTY(ThisForm.pf1.pgWhatEver.txtShippedVIA.VALUE)
						ThisForm.pf1.pgWhatEver.txtShippedVIA.VALUE = tmpShipDetail.ShipRoute
						ThisForm.cShipVia = tmpShipDetail.ShipRoute
					ELSE
						IF NOT ThisForm.pf1.pgWhatEver.txtShippedVIA.VALUE = tmpShipDetail.ShipRoute
							cMess = "The Ship VIA was first enterd as: "+;
							ALLTRIM(ThisForm.pf1.pgWhatEver.txtShippedVIA.VALUE)+CHR(13)+"This SO is to go to: "+;
							ALLTRIM(tmpShipDetail.ShipRoute)+CHR(13)+"Check before shipping"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
			
							MESSAGEBOX(cMess ,0,"New SO has different shipping instructions")
						ENDIF
					ENDIF
					*.Shippay
					PRIVATE cPrevShipPay
					DO CASE
					CASE ThisForm.pf1.pgFreight.ogFreightCharges.VALUE = 1
						cPrevShipPay ="FRT COLLEC"
					CASE ThisForm.pf1.pgFreight.ogFreightCharges.VALUE = 2
						cPrevShipPay="ADD FREIGH"
					CASE ThisForm.pf1.pgFreight.ogFreightCharges.VALUE = 3
						cPrevShipPay="3RD"
					OTHERWISE 
						cPrevShipPay= " "
					ENDCASE
					
					DO CASE
					CASE EMPTY(tmpShipDetail.Shippay)
					CASE tmpShipDetail.Shippay="FRT COLLEC"
						IF EMPTY(ThisForm.pf1.pgFreight.ogFreightCharges.VALUE)
							ThisForm.pf1.pgFreight.ogFreightCharges.VALUE = 1
						ELSE
							IF (ThisForm.pf1.pgFreight.ogFreightCharges.VALUE) <> 1
								MESSAGEBOX("The Previous ShipPay was entered as: "+cPrevShipPay+CHR(13)+;
								"This SO was set to go 'FREIGHT COLLECT'"+CHR(13)+;
								"Check before Shipping!",0,"New SO has different shipping instructions")
							ENDIF
						ENDIF
					CASE tmpShipDetail.Shippay="ADD FREIGH"
						IF EMPTY(ThisForm.pf1.pgFreight.ogFreightCharges.VALUE)
							ThisForm.pf1.pgFreight.ogFreightCharges.VALUE = 2
						ELSE
							IF (ThisForm.pf1.pgFreight.ogFreightCharges.VALUE) <> 2
								cMess = "The Previous ShipPay was entered as: "+cPrevShipPay+CHR(13)+;
								"This SO was set to go 'ADD FREIGHT'"+CHR(13)+;
								"Check before Shipping!"
								RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
								MESSAGEBOX(cMess,0,"New SO has different shipping instructions")
							ENDIF
						ENDIF
					CASE tmpShipDetail.Shippay="3RD"
						IF EMPTY(ThisForm.pf1.pgFreight.ogFreightCharges.VALUE)
							ThisForm.pf1.pgFreight.ogFreightCharges.VALUE = 3
						ELSE
							IF (ThisForm.pf1.pgFreight.ogFreightCharges.VALUE) <> 3
								cMess = "The Previous ShipPay was entered as: "+cPrevShipPay+CHR(13)+;
								"This SO was set to go '3RD Party Billing'"+CHR(13)+;
								"Check before Shipping!"
								RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
								MESSAGEBOX(cMess,0,"New SO has different shipping instructions")
							ENDIF
						ENDIF
					ENDCASE
				*SELECT PackingSlipSO
					
					*.PayType
					IF EMPTY(ThisForm.pf1.pgWhatEver.txtPayType.VALUE)
						ThisForm.pf1.pgWhatEver.txtPayType.VALUE = tmpShipDetail.PayType
						ThisForm.pf1.pgWhatEver.txtPayType.REFRESH
					ELSE
						IF ThisForm.pf1.pgWhatEver.txtPayType.VALUE != tmpShipDetail.PayType
							cMess = "The Previous PayType was entered as: "+;
							ALLTRIM(ThisForm.pf1.pgWhatEver.txtPayType.VALUE)+CHR(13)+;
							"This SO was set to go '3RD Party Billing'"+CHR(13)+;
							"Check before Shipping!"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
							MESSAGEBOX(cMess,0,"New SO has different shipping instructions")
						ENDIF
					ENDIF
		
					*.blind
					IF tmpShipDetail.blind
						IF PrepareSQLlogic(ThisForm.pf1.pgWhatEver.ChkBlind.VALUE,'Blind') 
							cMess = "The new SO "+ALLTRIM(STR(nSO))+" is marking this Shipment as BLIND!"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
							MESSAGEBOX(cMess,0,"New SO has different shipping instructions")
						ENDIF
						ThisForm.pf1.pgWhatEver.ChkBlind.VALUE = 1
						ThisForm.pf1.pgWhatEver.ChkBlind.REFRESH
					ELSE
						IF PrepareSQLlogic(ThisForm.pf1.pgWhatEver.ChkBlind.VALUE,'Blind') 
							cMess = "The new SO "+ALLTRIM(STR(nSO))+" tried to mark this Shipment as BLIND!"+CHR(13)+;
							"This Shipment will stay listed as BLIND!"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
							MESSAGEBOX(cMess ,0,"New SO has different shipping instructions")
						ELSE
							ThisForm.pf1.pgWhatEver.ChkBlind.VALUE = 0
							ThisForm.pf1.pgWhatEver.ChkBlind.REFRESH
						ENDIF
					ENDIF
					
		
					*.Fax
					IF tmpShipDetail.FaxConf
						IF NOT PrepareSQLlogic(ThisForm.pf1.pgWhatEver.chkFaxConf.VALUE,'FaxConf',.F.)
							cMess = "The new SO "+ALLTRIM(STR(nSO))+" is marking this Shipment as FAX Conformation!"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
							MESSAGEBOX(cMess,0,"New SO has different shipping instructions")
						ENDIF
						ThisForm.pf1.pgWhatEver.chkFaxConf.VALUE = 1
		
					ELSE
						IF PrepareSQLlogic(ThisForm.pf1.pgWhatEver.chkFaxConf.VALUE,'FaxConf')
							cMess = "The new SO "+ALLTRIM(STR(nSO))+" tried to mark this Shipment as FAX Conformation!"+CHR(13)+;
							"This Shipment will stay listed as FAX Conformation!"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
							MESSAGEBOX(cMess ,0,"New SO has different shipping instructions")
						ELSE
							ThisForm.pf1.pgWhatEver.chkFaxConf.VALUE = 0
		
						ENDIF
					ENDIF
					
		
					*.Email
					IF tmpShipDetail.EmailConf
						IF PrepareSQLlogic(ThisForm.pf1.pgWhatEver.chkEmailConf.VALUE,'EmailConf',.F.)
							cMess = "New SO is marking this Shipment as EMAIL Conformation!"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
							MESSAGEBOX(cMess,0,"New SO has different shipping instructions")
						ENDIF
						ThisForm.pf1.pgWhatEver.chkEmailConf.VALUE = 1
		
					ELSE
						IF PrepareSQLlogic(ThisForm.pf1.pgWhatEver.chkEmailConf.VALUE,'EmailConf',.F.)
							cMess = "Your new SO "+ALLTRIM(STR(nSO))+" marked this Shipment as EMAIL Conformation!"+CHR(13)+;
							"This Shipment will stay listed as EMAIL Conformation!"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess) 
		
							MESSAGEBOX(cMess,0,"New SO has different shipping instructions" )
						ELSE
							ThisForm.pf1.pgWhatEver.chkEmailConf.VALUE = 0
		
						endif
					ENDIF
		
		
					*.FreightEst
					IF tmpShipDetail.FreightEst > 0
						IF EMPTY(ThisForm.pf1.pgWhatEver.txtFreightEst.VALUE )
							ThisForm.pf1.pgWhatEver.txtFreightEst.VALUE = "Freight Est. $"+ALLTRIM( STR(tmpShipDetail.FreightEst ))
							ThisForm.pf1.pgWhatEver.txtFreightEst.REFRESH
						ELSE
							nFE = VAL(ThisForm.pf1.pgWhatEver.txtFreightEst.VALUE)
							ThisForm.pf1.pgWhatEver.txtFreightEst.VALUE = "Freight Est. $"+ALLTRIM( STR(tmpShipDetail.FreightEst+nFE ))
							ThisForm.pf1.pgWhatEver.txtFreightEst.REFRESH
						ENDIF
					ENDIF
					
					USE IN tmpShipDetail
				ENDIF
		
				IF USED('tmpSaleInst')
					USE IN tmpSaleInst
				ENDIF
				SELECT 0
				
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT SOITEM, S_Instrct, ShipOn, ShipDue "
				cSQL = cSQL+" FROM dbo.Sales WITH(NOLOCK) WHERE SalesNum = "+STR(nSO)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSaleInst')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSaleInst')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSaleInst')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSaleInst')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSaleInst")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSaleInst")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSaleInst')
				ENDIF
		
				IF USED('tmpSaleInst')
				
					*.S_Instrct
					DIMENSION aS_Instrc(1)
					SELECT SOITEM, S_Instrct, ShipOn, ShipDue FROM tmpSaleInst INTO ARRAY aS_Instrc
					PRIVATE lcS_Instrct
					lcS_Instrct = " "
					FOR I = 1 TO ALEN(aS_Instrc,1)
						IF NOT EMPTY(aS_Instrc(I,2))
							lcS_Instrct=lcS_Instrct+aS_Instrc(I,1)+": "+ALLTRIM(aS_Instrc(I,2))+CHR(13)+" "
						ENDIF
						IF aS_Instrc(I,3)
							*Check Cannot ship before
							ThisForm.ShipOn = .T.
							IF VARTYPE(aS_Instrc(I,4)) = "T"
								aS_Instrc(I,4) = TTOD( aS_Instrc(I,4) )
							ENDIF
							
							IF VARTYPE(aS_Instrc(I,4)) = "D" 
								IF aS_Instrc(I,4) > DATE()
									IF MESSAGEBOX( "The Sales Order Item:"+ALLTRIM(aS_Instrc(I,1))+" is only to be shipped on "+DTOC(aS_Instrc(I,4))+"!"+CHR(13)+;
									  CHR(13)+ "Do you have Permission to overide the 'ship on' Date?"+CHR(13);
									  ,4+32+256,"Item is marked as 'SHIP ON' date." ) = 7
										
										RETURN .F.
									ELSE
										
										***Let SalesP know order is early
										TrackMess("SO item "+ALLTRIM(aS_Instrc(I,1))+" Shipped early ("+DTOC(DATE())+"), Order written to not ship before ("+DTOC(aS_Instrc(I,4))+")"  )
										
										cBody = "SO item "+ALLTRIM(aS_Instrc(I,1))+" Shipped early "
										cBody = cBody+CHR(13)+"SO item "+ALLTRIM(aS_Instrc(I,1))+" Shipped early ("+DTOC(DATE())+"), Order written to not ship before ("+DTOC(aS_Instrc(I,4))+")"
										cBody = cBody+CHR(13)+"SO item '"+HTML_SOitem(ALLTRIM(aS_Instrc(I,1)),.T.)
										cBody = cBody+CHR(13)+"SO item '"+HTML_SOitem(ALLTRIM(aS_Instrc(I,1)),.F.)
										cBody = cBody+CHR(13)+ALLTRIM(SYS(0))+"."+CHR(13)+"PackingSlip.CheckNewSO()  Line:"+ALLTRIM(STR( LINENO(1) ))
										*cBody = cBody + CHR(13)+cSQL 
										
										TrackError(cBody,"SO item "+ALLTRIM(aS_Instrc(I,1))+" Shipped early ",PROGRAM(),LINENO(1)  )
										
										RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cBody )
										*Send_HTML_Email( 'Admin@SpaceAlloysUSA.com',get_Server_Email(),'HPA App Alert',cBody ,ThisForm.nConnHandle,.T.,.F.)
										
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					NEXT I
					IF NOT EMPTY(lcS_Instrct)
						IF EMPTY(ThisForm.pf1.pgWhatEver.txtFreightEst.VALUE)
							ThisForm.pf1.pgOverView.sdtInstrct.VALUE = lcS_Instrct
						ELSE
							ThisForm.pf1.pgOverView.sdtInstrct.VALUE = ThisForm.pf1.pgOverView.sdtInstrct.VALUE+;
								CHR(13)+lcS_Instrct
						ENDIF
						ThisForm.pf1.pgOverView.sdtInstrct.VISIBLE = .T.
						ThisForm.pf1.pgOverView.sdtInstrct.REFRESH
					ENDIF
					USE IN tmpSaleInst
				ENDIF
		
			*	THIS.PARENT.PARENT.pgSoldTo.CLICK
			*	THIS.PARENT.PARENT.pgShipTo.CLICK
			ELSE
				*No records found in Sales_NO
			ENDIF
		ELSE
			*No SalesNum nSO
		ENDIF
		*SELECT COUNT(*) FROM AllQuotes WHERE AllQuotes.SalesNum = nSO INTO ARRAY aCount
		*IF aCount(1) > 0
			*Found record in AllQuotes!
		
		
		IF USED('PO_NumAllQuotes')
			USE IN PO_NumAllQuotes
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT PO_Num FROM dbo.AllQuotes WHERE SalesNum = "+STR(nSO)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PO_NumAllQuotes')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PO_NumAllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PO_NumAllQuotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PO_NumAllQuotes')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PO_NumAllQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PO_NumAllQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'PO_NumAllQuotes')
		ENDIF
		
		IF USED('PO_NumAllQuotes')
			DIMENSION aCountPONum(1)
			PRIVATE nCountPONum 
			nCountPONum = 0
			SELECT COUNT(PO_Num) AS nCountPONum FROM PO_NumAllQuotes INTO ARRAY aCountPONum
			
			IF VARTYPE(aCountPONum(1)) = "N"
				nCountPONum = aCountPONum(1)
			ENDIF
			
			IF nCountPONum > 0
				SELECT PO_NumAllQuotes 
				GO TOP
				SELECT PO_Num FROM PO_NumAllQuotes INTO ARRAY APO_Num
				FOR iPO = 1 TO LEN(APO_Num)
					IF TYPE("APO_Num(iPO)")="C"
						IF !EMPTY(APO_Num(iPO))
							*FILL PO_Nums
							SELECT PackingSlipPO
							GO TOP
							IF EMPTY(PackingSlipPO.PO)
								*has been initialized, but no value
								REPLACE PackingSlipPO.PO WITH APO_Num(iPO)
							ELSE
								*Save the PO
								INSERT INTO PackingSlipPO (PO) VALUES (APO_Num(iPO))
							ENDIF
						ENDIF
					ENDIF
				ENDFOR
				ThisForm.pf1.pgOrderNumber.grdPO.Refresh()
			ENDIF
		
			USE IN PO_NumAllQuotes
		ENDIF
		RETURN .T.
		
		
		
		
		
	ENDPROC

	PROCEDURE clonesales_stock
		*ThisForm.CloneSales_Stock()
		************************************************
		*!*	CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpSales_Stock") FREE ;
		*!*	([ID] I,SOitem C(10),SL_Qty N(18,4),SL_P N(18,4),SL_Total N(18,4),SL_PU N(1);
		*!*	,SL_PC N(10),SL_Dim1 N(10,4),SL_Dim2 N(9,3),SL_Dim3 N(9,3),SL_LBS N(9,1);
		*!*	,SL_POitem C(12),Consumed L,StkBack L,StockEdit T,RecDate T,TBL C(1);
		*!*	,SL_ID I,SL_ID_D I,ID_D_Proc I,Alloy C(12),[Form] C(2),Heat C(50),Lot C(10),CC C(1),CL C(1);
		*!*	,RandLen L,Orig_PC I,Orig_Dim1 N(10,4),Orig_Dim2 N(9,3),Orig_Dim3 N(9,3),Orig_LBS N(9,1);
		*!*	,Reconciled L,Sales_D_ID N(10),StkPaid_P N(18,4),StkPaid_T N(18,4),PackingSli I
		*!*	,PS_PC I,PS_Form C(2),PS_Dim1 N(10,4),PS_Dim2 N(9,3),PS_Dim3 N(9, 3),PS_LBS N(9,1),WO I  )
		
		********************************************************************
		** Copy SQL dbo.Sales_Stock into tmpSales_Stock for SOitem
		*Windows Form PSItemDetail.scx uses this table tmpSales_Stock 
		*Make changes to tmp file and after print, save to SQL
		
		IF USED("curSales_Stock")	
			USE IN curSales_Stock
		ENDIF 
		SELECT 0
		
		cSQL = "SELECT SS.* FROM dbo.Sales_Stock SS"
		cSQL = cSQL+" WHERE SS.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL+" AND SS.Reconciled = 0"
		cSQL = cSQL+" AND SS.PackingSli <= 0 "
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'curSales_Stock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'curSales_Stock')
		ENDDO
		
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'curSales_Stock' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'curSales_Stock' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "curSales_Stock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "curSales_Stock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'curSales_Stock' )
		ELSE
			IF USED('curSales_Stock')
				IF RECCOUNT('curSales_Stock') > 0
					SELECT tmpSales_Stock
					SCAN
						SELECT tmpSales_Stock
						INSERT BLANK
						REPLACE ID 				WITH PrepareSQLnum(curSales_Stock.ID,'ID',-3)
						REPLACE SOitem 			WITH PrepareSQLtxt(curSales_Stock.SOitem,'SOitem',10)
						REPLACE SL_Qty 		WITH PrepareSQLnum(curSales_Stock.ID,'ID',-3)	&&each heat line on PackingSli QTY
						REPLACE SL_P		WITH PrepareSQLnum(curSales_Stock.StockLst_P,'StockLst_P',-5)
						REPLACE SL_Total	WITH PrepareSQLnum(curSales_Stock.StockLst_Total,'StockLst_Total',-5)
						REPLACE SL_PU 		WITH PrepareSQLnum(curSales_Stock.StockLst_PU,'StockLst_PU',-2)
						REPLACE SL_PC		WITH PrepareSQLnum(curSales_Stock.StockLst_PC,'StockLst_PC',-3)
						REPLACE SL_Dim1		WITH PrepareSQLnum(curSales_Stock.StockLst_Dim1,'StockLst_Dim1',10,4)
						REPLACE SL_Dim2		WITH PrepareSQLnum(curSales_Stock.StockLst_Dim2,'StockLst_Dim2',9,3)
						REPLACE SL_Dim3		WITH PrepareSQLnum(curSales_Stock.StockLst_Dim3,'StockLst_Dim3',9,3)
						REPLACE SL_LBS		WITH PrepareSQLnum(curSales_Stock.StockLst_LBS,'StockLst_LBS',9,1)
						REPLACE SL_POitem	WITH PrepareSQLtxt(curSales_Stock.StockLst_POitem,'POitem',12)
						REPLACE Consumed 		WITH PrepareSQLlogic(curSales_Stock.Consumed,'Consumed')
						REPLACE StkBack 		WITH PrepareSQLlogic(curSales_Stock.StkBack,'StkBack')
						REPLACE StockEdit		WITH ShowSQLdate(curSales_Stock.StockEdit,'StockEdit')
						REPLACE RecDate			WITH ShowSQLdate(curSales_Stock.RecDate,'RecDate')
						REPLACE TBL				WITH ShowSQLtxt(curSales_Stock.TBL,'TBL',1)
						REPLACE SL_ID			WITH PrepareSQLnum(curSales_Stock.StockLst_ID,'StocStockLst_IDkLst_P',-3)
						REPLACE SL_ID_D		WITH PrepareSQLnum(curSales_Stock.StockLst_ID_Detail,'StockLst_ID_Detail',-3)
						REPLACE ID_D_Proc	WITH PrepareSQLnum(curSales_Stock.ID_Detail_Process,'ID_Detail_Process',-3)
						REPLACE Alloy			WITH ShowSQLtxt(curSales_Stock.Alloy,'Alloy',12)
						REPLACE Form			WITH ShowSQLtxt(curSales_Stock.Form,'Form',2)
						REPLACE Heat			WITH ShowSQLtxt(curSales_Stock.Heat,'Heat',50)
						REPLACE Lot			WITH ShowSQLtxt(curSales_Stock.Lot,'Lot',10)
						REPLACE CC			WITH ShowSQLtxt(curSales_Stock.CC,'CC',1)
						REPLACE CL			WITH ShowSQLtxt(curSales_Stock.CL,'CL',1)
						REPLACE RandLen			WITH PrepareSQLlogic(curSales_Stock.RandLen,'RandLen')
						REPLACE Orig_PC			WITH PrepareSQLnum(curSales_Stock.Orig_PC,'Orig_PC',-3)
						REPLACE Orig_Dim1		WITH PrepareSQLnum(curSales_Stock.Orig_Dim1,'Orig_Dim1',10,4)
						REPLACE Orig_Dim2		WITH PrepareSQLnum(curSales_Stock.Orig_Dim2,'Orig_Dim2',9,3)
						REPLACE Orig_Dim3 		WITH PrepareSQLnum(curSales_Stock.Orig_Dim3,'Orig_Dim3',9,3)
						REPLACE Orig_LBS		WITH PrepareSQLnum(curSales_Stock.Orig_LBS,'Orig_LBS',9,1)
		*!*					REPLACE Who_Add
		*!*					REPLACE Reconciled
		*!*					REPLACE Who_Rec
		*!*					REPLACE Reconciled 
						REPLACE Sales_D_ID	WITH PrepareSQLnum(curSales_Stock.Sales_Detail_ID,'Sales_Detail_ID',-3)
						REPLACE StkPaid_P		WITH PrepareSQLnum(curSales_Stock.StkPaid_P,'StkPaid_P',-5)
						REPLACE StkPaid_T	WITH PrepareSQLnum(curSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
						REPLACE PackingSli		WITH PrepareSQLnum(curSales_Stock.PackingSli,'PackingSli',-3)
						REPLACE PS_PC 			WITH PrepareSQLnum(curSales_Stock.PS_PC,'PS_PC',-3)
						REPLACE PS_Form			WITH PrepareSQLtxt(curSales_Stock.PS_Form,'PS_Form',2)
						REPLACE PS_Dim1			WITH PrepareSQLnum(curSales_Stock.PS_Dim1,'PS_Dim1',10,4)
						REPLACE PS_Dim2			WITH PrepareSQLnum(curSales_Stock.PS_Dim2,'PS_Dim2',9,3)
						REPLACE PS_Dim3			WITH PrepareSQLnum(curSales_Stock.PS_Dim3,'PS_Dim3',9,3)
						REPLACE PS_LBS 			WITH PrepareSQLnum(curSales_Stock.PS_LBS,'PS_LBS',9,1)
						REPLACE WO				WITH PrepareSQLnum(curSales_Stock.WO,'WO',-3)
						
					ENDSCAN
				ENDIF
				USE IN curSales_Stock
			ENDIF
		ENDIF
		
		
		*IF lAddSales_Stock = .T.
			
			cSQL = "INSERT INTO dbo.Sales_Stock "
			cSQL=cSQL+"([SOitem]"
		*    cSQL=cSQL+",[StockLst_Qty]"	&&Depricated
		*    cSQL=cSQL+",[StockLst_P]"
		*    cSQL=cSQL+",[StockLst_Total]"
		*    cSQL=cSQL+",[StockLst_PU]"
		*    cSQL=cSQL+",[StockLst_PC]"
		*    cSQL=cSQL+",[StockLst_Dim1]"
		*    cSQL=cSQL+",[StockLst_Dim2]"
		*    cSQL=cSQL+",[StockLst_Dim3]"
		*    cSQL=cSQL+",[StockLst_LBS]"
		    cSQL=cSQL+",[StockLst_POitem]"
		    cSQL=cSQL+",[Consumed]"
		    cSQL=cSQL+",[StkBack]"
		    
		    cSQL=cSQL+",[StockEdit]"
		    cSQL=cSQL+",[RecDate]"
		    cSQL=cSQL+",[TBL]"
		    cSQL=cSQL+",[StockLst_ID]"
		    cSQL=cSQL+",[StockLst_ID_Detail]"
		    cSQL=cSQL+",[ID_Detail_Process]"
		    
		    cSQL=cSQL+",[Alloy]"
		    cSQL=cSQL+",[Form]"
		    cSQL=cSQL+",[Heat]"
		    cSQL=cSQL+",[Lot]"
		    cSQL=cSQL+",[CC]"
		    cSQL=cSQL+",[CL]"
		    cSQL=cSQL+",[RandLen]"
		    cSQL=cSQL+",[Orig_PC]"
		    cSQL=cSQL+",[Orig_Dim1]"
		    cSQL=cSQL+",[Orig_Dim2]"
		    cSQL=cSQL+",[Orig_Dim3]"
		    cSQL=cSQL+",[Orig_LBS]"
		 	
		 	cSQL=cSQL+",[Orig_QTY]"
		 	cSQL=cSQL+",[Orig_P]"
		 	cSQL=cSQL+",[Orig_PU]"
		 	
		    cSQL=cSQL+",[Who_Add]"
		    cSQL=cSQL+",[Reconciled]"
		    cSQL=cSQL+",[Who_Rec]"
		    cSQL=cSQL+",[Sales_Detail_ID]"
		    cSQL=cSQL+",[StkPaid_P]"
		    cSQL=cSQL+",[StkPaid_Total]"
		    cSQL=cSQL+",[PackingSli]"
		    cSQL=cSQL+",[PS_PC]"
		    cSQL=cSQL+",[PS_Form]"
		    cSQL=cSQL+",[PS_Dim1]"
		    cSQL=cSQL+",[PS_Dim2]"
		    cSQL=cSQL+",[PS_Dim3]"
		    cSQL=cSQL+",[PS_LBS]"
		    cSQL=cSQL+",[WO]"
			cSQL=cSQL+" ) "
			cSQL=cSQL+" SELECT"
			cSQL=cSQL+"[SOitem]"
		*    cSQL=cSQL+",[StockLst_Qty]"	&&Depricated
		*    cSQL=cSQL+",[StockLst_P]"
		*    cSQL=cSQL+",[StockLst_Total]"
		*    cSQL=cSQL+",[StockLst_PU]"
		*    cSQL=cSQL+",[StockLst_PC]"
		*    cSQL=cSQL+",[StockLst_Dim1]"
		*    cSQL=cSQL+",[StockLst_Dim2]"
		*    cSQL=cSQL+",[StockLst_Dim3]"
		*    cSQL=cSQL+",[StockLst_LBS]"
		    cSQL=cSQL+",[StockLst_POitem]"
		    cSQL=cSQL+",[Consumed]"
		    cSQL=cSQL+",[StkBack]"
		    cSQL=cSQL+",[StockEdit]"
		    cSQL=cSQL+",[RecDate]"
		    cSQL=cSQL+",[TBL]"
		    cSQL=cSQL+",[StockLst_ID]"
		    cSQL=cSQL+",[StockLst_ID_Detail]"
		    cSQL=cSQL+",[ID_Detail_Process]"
		    cSQL=cSQL+",[Alloy]"
		    cSQL=cSQL+",[Form]"
		    cSQL=cSQL+",[Heat]"
		    cSQL=cSQL+",[Lot]"
			cSQL=cSQL+",[CC]"
			cSQL=cSQL+",[CL]"
			cSQL=cSQL+",[RandLen]"
			cSQL=cSQL+",[Orig_PC]"
			cSQL=cSQL+",[Orig_Dim1]"
			cSQL=cSQL+",[Orig_Dim2]"
			cSQL=cSQL+",[Orig_Dim3]"
			cSQL=cSQL+",[Orig_LBS]"
			
		 	cSQL=cSQL+",[Orig_QTY]"
		 	cSQL=cSQL+",[Orig_P]"
		 	cSQL=cSQL+",[Orig_PU]"	
		
			cSQL=cSQL+",[Who_Add]"
			cSQL=cSQL+",[Reconciled]"
			cSQL=cSQL+",[Who_Rec]"
			cSQL=cSQL+",[Sales_Detail_ID]"
			cSQL=cSQL+",[StkPaid_P]"
			cSQL=cSQL+",[StkPaid_Total]"
			cSQL=cSQL+",[PackingSli]"
			cSQL=cSQL+",[PS_PC]"
			cSQL=cSQL+",[PS_Form]"
			cSQL=cSQL+",[PS_Dim1]"
			cSQL=cSQL+",[PS_Dim2]"
			cSQL=cSQL+",[PS_Dim3]"
			cSQL=cSQL+",[PS_LBS]"
			cSQL=cSQL+",[WO]"
			cSQL=cSQL+" FROM dbo.Sales_Stock SS "
			cSQL=cSQL+" WHERE SS.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL=cSQL+" AND AQ.SOitem = SS.SOitem"
			cSQL=cSQL+" AND SS.Reconciled = 0"
			cSQL=cSQL+" AND SS.PackingSli <= 0 "
				
		
	ENDPROC

	PROCEDURE Destroy
		RELEASE plBOLWindfall
		RELEASE plBOL3rdP 
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE emailconf		&& Send EMAIL Confirmation
	ENDPROC

	PROCEDURE enableprint		&& Sets the Enable of Print.
		*ThisForm.EnablePrint()
		PRIVATE EnablePrintButton
		EnablePrintButton = .F.
		
		DIMENSION aPackSlipPCS(1)
		SELECT SUM(Pcs) FROM PackingSlipItem INTO ARRAY aPackSlipPCS
		IF TYPE('aPackSlipPCS(1)') = "N"
			IF aPackSlipPCS(1) > 0
				EnablePrintButton = .T.
				ThisForm.pf1.pgItems.pf_SO_Items.pg_selected.lblNoSelectedItem.Visible = .F.
			ELSE
				ThisForm.pf1.pgItems.pf_SO_Items.pg_selected.lblNoSelectedItem.Visible = .T.
			ENDIF
		ENDIF
		
		IF EnablePrintButton
			IF ThisForm.pf1.pgSoldTo.cmdEditSoldTo.Caption = "Edit" AND ;
			ThisForm.pf1.pgShipTo.cmdEditShipTo.Caption = "Edit"
				EnablePrintButton = .T.
			ENDIF
		ENDIF
		
		IF EnablePrintButton
		*	ThisForm.cmdPrint.Visible = .T.
			ThisForm.cmdPrint.Enabled = .T.
		ELSE
			ThisForm.cmdPrint.Enabled = .F.
		*	ThisForm.cmdPrint.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE faxconf		&& Send FAX Confirmation
	ENDPROC

	PROCEDURE fillpacked_bol
		*ThisForm.FillPacked_BoL()
		
		IF LEN( ALLTRIM(PrepareSQLtxt( ThisForm.pf1.pgWhatEver.txtPackage.Value,'Box_Size',60)) ) > 0
			RETURN
			*Do not Process when has data
		ENDIF
		
		
		PRIVATE nPieces, cBox_Size, cBox_SizeS, nPounds
		nPieces = 0
		cBox_SizeS = ''
		nPounds = 0
		
		SELECT tmpLading
		SCAN
			*IF NOT EMPTY(PrepareSQLtxt(tmpLading.DESCRIPT,'Descript',80)) AND tmpLading.Pieces > 0 AND NOT DELETED()
			IF NOT DELETED('tmpLading')
				nPieces 	= nPieces + PrepareSQLnum(tmpLading.Pieces,'Pieces',-1)
				cBox_Size	= ALLTRIM(PrepareSQLtxt(tmpLading.Box_Size,'Box_Size',20))
				IF LEN(cBox_SizeS) = 0
					cBox_SizeS = cBox_Size
				ELSE
					cBox_SizeS = cBox_SizeS+", "+cBox_Size
				ENDIF
				nPounds = nPounds + PrepareSQLnum(tmpLading.Weight,'Weight',9,1)
			ENDIF
		ENDSCAN
		
		ThisForm.pf1.pgWhatEver.txtCarton.Value = ALLTRIM(STR(nPieces))
		ThisForm.pf1.pgWhatEver.txtPackage.Value = PrepareSQLtxt(cBox_SizeS,'Box_Size',60)
		ThisForm.pf1.pgWhatEver.txtTotalWeight.Value = ALLTRIM(STR(nPounds,10))
		
		
	ENDPROC

	PROCEDURE f_description
		PARAMETER tAlloy, tform, nthck, nsz2, nsz3, nWeight, lRL
		
		
		PRIVATE cFormDescription 
		cFormDescription = ALLTRIM(FormDescription(tForm, nThck))
		
		PRIVATE cReturnD
		cReturnD = ""
		*DO ItemDescriptionMetric IN PROC_Quotes WITH tform, nthck, nSZ2, nSZ3,Weight, lRL TO cReturnD
		cReturnD = ItemDescriptionMetric(tform, nthck, nSZ2, nSZ3, nWeight, lRL, .F.)
		
		cReturnD = PADL(TRIM(cFormDescription),11)+': '+cReturnD
		
		RETURN cReturnD
		
	ENDPROC

	PROCEDURE get_id_packing
		PARAMETERS pWhere
		*Get_ID_Packing()
		PRIVATE nID_PackingSlip 
		nID_PackingSlip = 0
		
		IF USED('tmpID_Pack')
			USE IN tmpID_Pack
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT ID_PackingSlip FROM dbo.PackingSlip WHERE "
		cSQL = cSQL + pWhere
				
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Pack')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Pack' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Pack')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Pack')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Pack")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Pack")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Pack')
		ENDIF
		
		IF USED('tmpID_Pack')
			IF RECCOUNT('tmpID_Pack') > 0
				nID_PackingSlip = tmpID_Pack.ID_PackingSlip 
			ENDIF
		ENDIF
		
		IF USED('tmpID_Pack')
			USE IN tmpID_Pack
		ENDIF
		
		RETURN nID_PackingSlip 
	ENDPROC

	PROCEDURE Init
		ThisForm.PackingSlipNo = 0
		ThisForm.CurrPage = 1
		ThisForm.RefreshForms('10')
		ThisForm.pf1.pgOverView.txtSO1.SetFocus()
		ThisForm.nSO = 0
		ThisForm.nSales_Stock_PS = 0
		PUBLIC gcAddr_Ref  && Used in Report
		ThisForm.cAddr_Ref = ''
		
		SET EXCLUSIVE ON
		
	ENDPROC

	PROCEDURE Load
		SET SAFETY OFF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_rtr ADDITIVE
		ENDIF
		
		***********************
		PUBLIC Array aShipFrom[1]
		
		IF USED("tmpLading")
			USE IN tmpLading
		ENDIF
		
		*PRIVATE cFileName
		*cFileName = SYS(3)
		*cFileName = 'Lad_' + cFileName
		
		ThisForm.Uniq_LAD = UniqDBF(ThisForm.Uniq_LAD)
		*cFileName = ThisForm.Uniq_LAD
		
		SELECT 0
		
		PRIVATE lDuplicate 
		lDuplicate = .F.
		
		TRY
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_LAD) ) FREE ;
				(Pieces N(10), DESCRIPT C(80), Box_Size C(20);
				, ClassRate C(4), Weight N(10,1), NMFC N(10), Kg L;
				, DecValue N(10,2), bil3code N(10,0), FrtCharges C(10), DutyTax C(11);
				, COD L, CODFrtColl L, CODCertChk L)
				
				USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_LAD) EXCL ALIAS tmpLading
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_LAD) ) FREE ;
				(Pieces N(10), DESCRIPT C(80), Box_Size C(20);
				, ClassRate C(4), Weight N(10,1), NMFC N(10), Kg L;
				, DecValue N(10,2), bil3code N(10,0), FrtCharges C(10), DutyTax C(11);
				, COD L, CODFrtColl L, CODCertChk L)
				
				USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_LAD) EXCL ALIAS tmpLading
		ENDIF
		
		CATCH
		
			MESSAGEBOX("Could not open table 'Lading'."+CHR(13)+"This sesion of Packing slip will not work!"+CHR(13)+"More errors to come...",16,"Packing Slip can run one at a time")
			lDuplicate = .T.
		ENDTRY	
			
		
		
		************
		*SELECT 0
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpLading") FREE ;
		*	(Pieces N(10), DESCRIPT C(80), Box_Size C(20), ClassRate C(4), Weight N(10,1), NMFC N(10), Kg L;
		*	, DecValue N(10,2), bil3code N(10,0), FrtCharges C(10), DutyTax C(11);
		*	, COD L, CODFrtColl L, CODCertChk L)
		IF NOT lDuplicate
			SELECT tmpLading
			IF NOT USED('tmpLading')
				MESSAGEBOX("Could not load temp files."+CHR(13)+"Make sure the HPA application is not already running!"+CHR(13)+CHR(13)+"Closing this application now!",0,"Error")
				ThisForm.Release
				RETURN 
			ENDIF
			APPEND BLANK
		ENDIF
		***********************
		
		IF NOT lDuplicate
			IF USED("PackingSlipItem")
				USE IN PackingSlipItem
			ENDIF
		
			SELECT 0
			*CREATE TABLE PackingSlipItem FREE
			*(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12),Form C(2), Heat C(50), CC C(1), CL C(1), DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
			*,Form C(2),Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),LBS N(7,1),RandLen L, Metric L, PO_num C(17),PackingSli N(10) ;
			*,PartNo C(100), QTY N(18,4), PU N(1), SS_ID N(10),SOitem_cmplt L ;
			,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4) )
		
			*cFileName = SYS(3)
			*cFileName = 'PSI_' + cFileName
			
			ThisForm.Uniq_PSI = UniqDBF(ThisForm.Uniq_PSI)
			*cFileName = ThisForm.Uniq_PSI
		
			*Make PackingSlipItem a Exclusive yet distinct file
			*Make Sure PackingSlipHistory gets same changes 'PackingSlipItem'
			
			IF "\MEM" $ SYS(2003)
				CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_PSI) ) FREE ;
					( SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12);
					 ,Heat C(50), Lot C(10), DESCRIPT C(80), Weight N(7,1);
					 ,PackingSli N(10), PartNo C(100) ,PackWeight N(7,1);
					 ,Form C(2), CC C(1), CL C(1), AQDescript C(50), Kg L;
					 ,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3);
					 ,RandLen L,Metric L, PO_num C(17);
					 ,QTY N(18,4),PU N(1), SS_ID N(10), tmpPSnum N(10), SOi_cmplt L;
					 ,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4)) &&ERP Acct Standard
					 *,qShipped N(10), qBackOrder N(10);
					 
				USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_PSI) EXCL ALIAS PackingSlipItem
			ELSE	
					*Make Sure PackingSlipHistory gets same changes 'PackingSlipItem'
					CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_PSI) ) FREE ;
					( SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12);
					 ,Heat C(50), Lot C(10),DESCRIPT C(80), Weight N(7,1);
					 ,PackingSli N(10), PartNo C(100) ,PackWeight N(7,1);
					 ,Form C(2), CC C(1), CL C(1), AQDescript C(50), Kg L;
					 ,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3);
					 ,RandLen L,Metric L, PO_num C(17);
					 ,QTY N(18,4),PU N(1), SS_ID N(10), tmpPSnum N(10), SOi_cmplt L;
					 ,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4)) &&ERP Acct Standard
					 *,qShipped N(10), qBackOrder N(10);
					 *
				USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_PSI) EXCL ALIAS PackingSlipItem
			ENDIF
			
		
			IF NOT USED('PackingSlipItem')
				MESSAGEBOX("Could not load PackingSlipItem temp files."+CHR(13)+"Make sure the HPA application is not already running!"+CHR(13)+CHR(13)+"Closing this application now!",0,"Error")
				ThisForm.Release
				RETURN 
			ENDIF
		
			SELECT PackingSlipItem
			INDEX ON PackingSli TAG PackingSli && OF PackingSlipItem - need to use the actual name, not the Alias here!!
			INDEX ON SOItem TAG SOItem && OF PackingSlipItem - need to use the actual name, not the Alias here!!
		ENDIF
		
		IF NOT lDuplicate
			************************
			IF USED('PackingSlip ')
				THISFORM.Close_PackingSlip = .F.
			ELSE
				THISFORM.Close_PackingSlip = .T.
			ENDIF
		
			************************
			IF USED('Sales')
				THISFORM.Close_Sales = .F.
			ELSE
				THISFORM.Close_Sales = .T.
			ENDIF
		
			************************
			IF USED('Sales_No')
				THISFORM.Close_Sales_No = .F.
			ELSE
				THISFORM.Close_Sales_No = .T.
			ENDIF
		
			************************
			IF USED('ShipAddr')
				THISFORM.Close_ShipAddr = .F.
			ELSE
				THISFORM.Close_ShipAddr = .T.
			ENDIF
		
			************************
			IF USED('SoldAddr')
				THISFORM.Close_SoldAddr = .F.
			ELSE
				THISFORM.Close_SoldAddr = .T.
			ENDIF
		
			************************
			IF USED('Sold_Ship')
				THISFORM.Close_Sold_Ship = .F.
			ELSE
				THISFORM.Close_Sold_Ship = .T.
			ENDIF
		ENDIF
		
		IF NOT lDuplicate
			************************
			PRIVATE cSQL, nSQLEXEC
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			IF ThisForm.nConnHandle < 0
				MESSAGEBOX("Could not connect to SQL Server")
				RETURN .F.
			ENDIF
		
			IF USED('AllQuotes')
				THISFORM.Close_AllQuotes = .F.
			ELSE
				THISFORM.Close_AllQuotes = .T.
			ENDIF
		
			SELECT 0
			cSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) WHERE 0>0"
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AllQuotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'AllQuotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AllQuotes' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AllQuotes' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AllQuotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AllQuotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'AllQuotes' )
			ENDIF
		ENDIF
		
		IF NOT lDuplicate
			***********************
			IF USED('tmpSalesNum')
				USE IN tmpSalesNum
			ENDIF
			SELECT 0
			
			PRIVATE cSQL
		
			cSQL=   "SELECT SOItem,Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3,Weight,Descript "
			cSQL=cSQL+",CAST(comments AS CHAR(100)) AS ItemDescription "
			cSQL=cSQL+",CAST(comments AS CHAR(100)) AS Comment "
			cSQL=cSQL+",HPAPO,'N' AS Posted,0 AS CnCld "
			cSQL=cSQL+",Inqnum,SalesP,Item,Salesnum,PO_num"
			cSQL=cSQL+",Metric,InqnumP,CC,CL "
			cSQL=cSQL+",Thck,Sz2,Sz3 "
			cSQL=cSQL+",0 AS dShip "
			cSQL=cSQL+",Q_QTY,S_QTY "
			cSQL=cSQL+" FROM dbo.AllQuotes "
			cSQL=cSQL+" WHERE 0>0 "
			cSQL=cSQL+" ORDER BY SOitem"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesNum')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSalesNum')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesNum' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesNum' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesNum")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesNum")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesNum')
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE maxshipcode		&& Return Max Ship Code
		PRIVATE useShipCode, maxShipCode
		*Get next code maxShipCode
		
		IF USED('cntShipAddr')
			USE IN cntShipAddr
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT MAX(ShipCode) AS Cntd FROM dbo.ShipAddrCode"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
		ENDIF
		
		IF USED('cntShipAddr')
			IF cntShipAddr.Cntd > 0
				useShipCode = cntShipAddr.Cntd + 1
			ELSE
				useShipCode = 1000
			ENDIF
		ENDIF
		
		IF USED('cntShipAddr')
			USE IN cntShipAddr
		ENDIF
		RETURN useShipCode
	ENDPROC

