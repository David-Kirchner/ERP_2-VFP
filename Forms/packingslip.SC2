				ThisForm.pf1.pgOrderNumber.Enabled = .F.
				ThisForm.pf1.pgItems.Enabled = .F.
				ThisForm.pf1.pgWhatEver.Enabled = .F.
				ThisForm.pf1.pgFreight.Enabled = .F.
				
