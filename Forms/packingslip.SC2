			******************************************************
			** PackingSlipSO *************************************
			******************************************************
			*Save to Sales_No
			PRIVATE nPS_SO
			nPS_SO = 0
			SELECT PackingSlipSO
			SCAN
			nPS_SO = PrepareSQLnum(PackingSlipSO.SO,'SalesNum',-3)
			IF nPS_SO > 0
				
				IF Count_SOinSales_No(nPS_SO, ThisForm.nConnHandle) > 0
					*SO exists in Sales_No
					cSQLu = "UPDATE dbo.Sales_No SET "
					cSQLu =cSQLu+" pSoldAddr = "+STR(nsoldcode)+""
					cSQLu =cSQLu+",pShipAddr = "+STR(nshipcode)
					cSQLu =cSQLu+" WHERE Sales_No.SalesNum = "+STR(nPS_SO)
						
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQLu, ThisForm.nConnHandle ,nSQLEXEC,'')
					ELSE
						Save_Sales_Status( nPS_SO, "PS Print", "Printed Packing Slip "+ALLTRIM(STR(nPS_No))+" UPDATE", ThisForm.nConnHandle)
					ENDIF
				ELSE
					*Not in Sales_No	
					cSQLi = "INSERT INTO dbo.Sales_No ( SalesNum, pSoldAddr, pShipAddr ) VALUES ("
					cSQLi =cSQLi+STR(nPS_SO)
					cSQLi =cSQLi+","+STR(nsoldcode)+""
					cSQLi =cSQLi+","+STR(nshipcode)+")"
						
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)  &&Fixed 2015-12-04 Accidently used cSQLu
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQLi, ThisForm.nConnHandle, nSQLEXEC,'' )
					ELSE
						Save_Sales_Status( nPS_SO, "PS Print", "Printed Packing Slip "+ALLTRIM(STR(nPS_No))+" INSERT", ThisForm.nConnHandle)
					ENDIF
					
				ENDIF
				
				Email_PSprint_SO_NoCheck(nPS_SO, nPS_No, ThisForm.nConnHandle)
				
				*Email_PSprint_SO_NoCheck Send Emails like:
				*"SalesNumber:"+HTML_SO(pnSO)+" is packed and ready for pickup."+CHR(13)+"PackingSlip:"+ALLTRIM(STR(pnPackingSlipNo))+" is ready to ship."
				*"PackingSlip ready but SO has not printed!"
			ENDIF
			ENDSCAN
			
			
			******************************************************
			*Save newly added items to AllQuotes and Sales
			
			IF USED('tmpQuote')
				LOCAL lcCompany, lcName, lcPo_num
				lcCompany	= THISFORM.pf1.pgSoldTo.txtCompany.VALUE
				lcName		= THISFORM.pf1.pgSoldTo.txtContact.VALUE
				ThisForm.Save_tmpQuote(lcCompany,lcName)
				* CALLS:ThisForm.Save_tmpQuote()
			ENDIF
			
		
			*****************************************************
			*SELECT tmpSales_Stock
			*ThisForm.Save_tmpSales_Stock()
			
			*****************************************************
			SELECT tmpSales
			ThisForm.Save_tmpSales()
			
			******************************************************
			SELECT tmpLading
			ThisForm.Save_tmpLading(nPS_NO)
		
			******************************************************
			*clean up
			
			TrackMess("Printed Packing Slip Number "+ALLTRIM(STR(ThisForm.PackingSlipNo))+ ", SO:"+cAll_SO  )
			
			IF USED('tmpSales')	
				USE IN tmpSales
			ENDIF
			IF USED('tmpLading')	
				USE IN tmpLading
			ENDIF
			IF USED('PackingSlip_NO')	
				USE IN PackingSlip_NO  &&release exclusive lock
			ENDIF
			IF USED('PackingSlip')	
				USE IN PackingSlip
			ENDIF
			
			ScavangeAfterPackingSlip(ThisForm.PackingSlipNo,ThisForm.nConnHandle)
		
			******************************
			IF ll2Email &&*IF THISFORM.pf1.pgWhatEver.chkEmailConf.VALUE = 1
				*Send Conf Email
				THISFORM.SendConfEmail()
			ENDIF
			******************************	
			IF ll2Fax	&&*IF THISFORM.pf1.pgWhatEver.chkFaxConf.VALUE = 1
				*Send Conf Fax
				MESSAGEBOX("Send by FAX has been depricated.",0,"No FAX")
				*THISFORM.SendConfFax()
			ENDIF
			******************************
			
			THIS.ENABLED = .F.
			WAIT WINDOW 'Saved!   Any key to leave...'
			
			ThisForm.Release
			
			*THISFORM.cmdCancel.CLICK
			
				
		*ELSE &&IF nMess = 6 &&yes
		*	ThisForm.ReverseSQL()
		*	DELETE_PackingSli_from_PackingSlip_No( nPS_No,ThisForm.nConnHandle )
		*ENDIF
		
		IF USED('PackingSlip_NO')
			USE IN PackingSlip_NO  &&release exclusive lock
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdPrintBlank.Click
		PRIVATE lOpenSN
		lOpenSN= .F.
		
		IF NOT USED('Sales_No')
			lOpenSN= .T.
			SELECT 0
			
			cSQL="SELECT * FROM dbo.Sales_No "
			cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0"
			
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'Sales_No')
			ENDIF
			
			APPEND BLANK
			*REPLACE PackingSlip_No.PackingSli WITH 1
			
		ELSE
			SELECT Sales_No
		ENDIF
		
		**********
		PRIVATE lOpenPSN
		lOpenPSN = .F.
		
		IF NOT USED('PackingSlip_no')
			lOpenPSN = .T.
			SELECT 0
			
			cSQL="SELECT * FROM dbo.PackingSlip_No "
			cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0"
			
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PackingSlip_No')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PackingSlip_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'PackingSlip_No')
			ENDIF
			
			APPEND BLANK
			REPLACE PackingSlip_No.PackingSli WITH 1
			
		ENDIF
		
		***********************
		PRIVATE lOpenSlsN
		lOpenSlsN = .F.
		
		IF NOT USED('tmpSales')
			lOpenSlsN = .T.
			
			PRIVATE cAll_SO
			cAll_SO	= PrepareSQLtxt(PackingSlip_no.All_SO,'All_SO',-1)
		
			SELECT 0
			IF LEN(cAll_SO) > 0
				
				cSQL="SELECT * FROM dbo.Sales "
				cSQL = cSQL + " WHERE SalesNum IN ("+cAll_SO+")"
			ELSE
				*Fake the data
				cSQL="SELECT * FROM dbo.Sales "
				cSQL = cSQL + " WHERE SalesNum <> 0 "			
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpSales')
			ENDIF
		
		ENDIF
		***********************
		
		SELECT PackingSlip_no
		
		REPORT FORM 'Reports\PackingSlip-BLANK' FOR PackingSlip_No.PackingSli = 1 TO PRINTER PROMPT NOCONSOLE
		
		IF VARTYPE(plBOLWindfall) = 'U'
			PUBLIC plBOLWindfall
			plBOLWindfall = .T.
		ENDIF
		IF MESSAGEBOX("Will this BoL be from Windfall?"+CHR(13)+"Answer No to be from Tipton.",4+32,"BoL from Windfall?") = 6
			plBOLWindfall = .T.
		ELSE
			plBOLWindfall = .F.
		ENDIF		
		***************
		IF VARTYPE(plBOL3rdP) = 'U'
			PUBLIC plBOL3rdP
		ENDIF
		plBOL3rdP = .F.
		***************
				
		REPORT FORM 'Reports\BillofLading-BLANK' FOR PackingSlip_No.PackingSli = 1 TO PRINTER PROMPT NOCONSOLE
		
		***
		IF lOpenPSN 
			IF USED('PackingSlip_No')
				USE IN PackingSlip_No
			ENDIF
		ENDIF
		***
		
		IF lOpenSN 
			IF USED('Sales_No')
				USE IN Sales_No
			ENDIF
		ENDIF
		***
		
		IF lOpenSlsN 
			IF USED('tmpSales')
				USE IN tmpSales
			ENDIF
		ENDIF
		***
	ENDPROC

