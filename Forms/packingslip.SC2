	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		this.clear
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmbForm.Valid
		ThisForm.RefreshForms(This.Value)
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmdAdd.Click
		* pg_Add_Item.cmdAddItem.click
		
		IF MESSAGEBOX("The Sales Person should enter this data!"+CHR(10)+"If you need to"+CHR(10)+CHR(10)+"Are you Sure you want to add this Sales Order Item?",4,"Are you Sure ?") = 6
		
			PRIVATE m.nItem, m.tSOItem, m.nPcs, m.tDesc, m.tAlloy, m.tHeat, m.tCC, m.tCL
			PRIVATE m.nSalesNum , m.lDup, m.nWeight,m.lKG ,m.tPO_Num, m.tSalesP
			PRIVATE m.nCmbForm, m.nThck, m.nSz2, m.nSz3, lDup, m.cPartNo
			PRIVATE m.nBlind, m.nFaxConf, m.nEmailConf
			PRIVATE m.lComplete,m.lRandLen,m.lMetric,m.lService
			
			PRIVATE currentDecimal
			currentDecimal = SET("DECIMAL")
			SET DECIMAL TO 0
			SET DECIMAL TO (currentDecimal)
			
			m.nItem 	= PrepareSQLnum(THIS.PARENT.txtItem.VALUE,'Item',2)
			m.nSalesNum = PrepareSQLnum(THIS.PARENT.txtSO.VALUE,'SalesNum',-3)
			m.tSOItem	= FixSOitem(m.nSalesNum,m.nItem)
			*m.tSOItem 	= Proper_SO_item(STR(m.nSalesNum)+"-"+STR(nItem,2))
			*m.tSOItem = SPACE(7-LEN(STR(m.nSalesNum,7,0)))+STR(m.nSalesNum,7,0)+"-"+IIF(nItem<10,"0"+STR(nItem,1,0), STR(nItem,2,0) )
			m.tPO_Num = ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtPO_Num.VALUE,'PO_num',20))
			m.tSalesP = ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtSalesP.VALUE,'SalesP',1))
			m.tAlloy = ALLTRIM(PrepareSQLtxt(THIS.PARENT.Alloy1.VALUE,'Alloy',12))
			*m.tForm
			m.tHeat  = ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtHeat.VALUE,'Heat',50))
			m.tCC	= PrepareSQLtxt(THIS.PARENT.cmbCC.VALUE,'CC',1)
			m.tCL	= PrepareSQLtxt(THIS.PARENT.cmbCL.VALUE,'CL',1)
			m.cForm = PrepareSQLtxt(This.Parent.cmbForm.Value,'Form',2)
			m.lRandLen	=PrepareSQLchk(This.parent.chkRL.Value,'RL')
			m.lMetric	=PrepareSQLchk(This.parent.chkMetric.Value,'Metric')
			m.lService	=PrepareSQLchk(This.parent.chkService.Value,'Service')
			
			m.nPcs   = PrepareSQLnum(THIS.PARENT.PIECES1.VALUE,'Pieces',-3)
			m.nThck  = PrepareSQLnum(THIS.PARENT.THCK1.VALUE,'Thck',9,4)
			m.nSz2   = PrepareSQLnum(THIS.PARENT.SZ21.VALUE,'Sz2',8,3)
			m.nSz3   = PrepareSQLnum(THIS.PARENT.SZ31.VALUE,'Sz3',8,3)
			m.lComplete = PrepareSQLchk(THIS.PARENT.chkComplete.VALUE,'Complete')
			m.nWeight	= PrepareSQLnum(THIS.PARENT.nWeight.VALUE,'Weight',7,1)
			m.lKG = PrepareSQLchk(This.parent.chkKg.Value,'Kg')
			m.nPackWeight= PrepareSQLnum(This.Parent.nWeight.Value,'Weight',7,1)
			m.tDesc = ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtDesc.VALUE,'Descript',80))
			m.cPartNo = ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtPartNo.VALUE,'PartNo',100))
			
		
		
			*Check SO-Item not 0
			IF m.nItem = 0 OR m.nSalesNum = 0 Then
				MESSAGEBOX("No Sales Order Number or Item Number was found"+CHR(13)+CHR(10)+"You are not allowed to add without a SO - Item.",1+16,"SO-Item Error")
				RETURN
			ENDIF
		
			*Check SO-Item in AllQuotes
			IF USED('cntAllQuotes')
				USE IN cntAllQuotes
			ENDIF
			SELECT 0
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.AllQuotes WHERE AllQuotes.SOItem = dbo.f_ProperSOitem('"+m.tSOItem+"')" && INTO ARRAY aSO_Item
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAllQuotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'cntAllQuotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAllQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAllQuotes')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntAllQuotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntAllQuotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAllQuotes')
			ENDIF
			IF USED('cntAllQuotes')
				IF cntAllQuotes.Cntd > 0
					MESSAGEBOX("You entered a Sales Order Number and Item Number that is already in Quotes."+;
						CHR(13)+CHR(10)+"Do not add from here unless this is a new 'Item'."+;
						CHR(13)+CHR(10)+"If this is to be a new item, use a different item number."+;
						CHR(13)+CHR(10)+"Otherwise use the Sales Order Items screen to add.",1+16,"SO-Item Error")
					RETURN
				ENDIF
		
				USE IN cntAllQuotes
			ENDIF
			
			*Do the PO thing
			lDup = .F.
			IF NOT EMPTY(m.tPO_Num)
				*got something to save
				SELECT PackingSlipPO
				GO TOP
				IF EMPTY(PackingSlipPO.PO)
					*has been initialized, but no value
					REPLACE PO WITH m.tPO_Num
				ELSE
					*has value
					*check for duplicate
					SCAN
						IF PO = m.tPO_Num
							lDup = .T.
						ENDIF
					ENDSCAN
					IF NOT lDup
						*Save the PO
						INSERT INTO PackingSlipPO (PO) VALUES (m.tPO_Num)
						THIS.PARENT.PARENT.PARENT.PARENT.pgOrderNumber.grdPO.REFRESH()
					ENDIF
				ENDIF
			ENDIF
		
			lDup = .F.
			*Do the SO thing
			IF m.nSalesNum> 0
				*got something to save
				SELECT PackingSlipSO
				GO TOP
				IF SO = 0
					*has been initialized, but no value
					REPLACE SO WITH m.nSalesNum
					THIS.PARENT.PARENT.PARENT.PARENT.pgOverView.txtSO1.VALUE = m.nSalesNum
					THIS.PARENT.PARENT.PARENT.PARENT.pgOverView.txtSO1.ENABLED = .F.
				ELSE
					*has value
					*check for duplicate
					SCAN
						IF SO = m.nSalesNum
							lDup = .T.
						ENDIF
					ENDSCAN
					IF NOT lDup
						*Save the SO
						INSERT INTO PackingSlipSO (SO) VALUES (m.nSalesNum)
						THIS.PARENT.PARENT.PARENT.PARENT.pgOrderNumber.grdSO.REFRESH()
					ENDIF
				ENDIF
			ENDIF
		
			IF TYPE('m.nPcs') <> 'N'
				m.nPcs = VAL(m.nPcs)
			ENDIF
			IF NOT EMPTY(m.tDesc) AND m.nPcs > 0
				*got something to save
				*Save Packing Slip Item
				SELECT PackingSlipItem
				
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"PackingSlipItem") FREE ;
		*	(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12), Form C(2),Heat C(50), CC C(1), CL C(1), DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
		*	,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),RandLen L,Metric L, PO_num C(17), PackingSli N(10);
		*	,PartNo C(100), QTY N(18,4), PU N(1), SS_ID N(10), tmpPSnum N(10), SOi_cmplt L;
		*,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4))
		
		*QTY and PU are Customer Units
		*SL_QTY and SL_P are ERP Acct Stnd  &&each heat line on PackingSli QTY
		*AQ_QTY is Customer	
		
				GO TOP
				IF EMPTY(DESCRIPT)
					*has been initialized, but no value
					REPLACE SalesNum	WITH m.nSalesNum
					REPLACE SOItem		WITH m.tSOItem
					REPLACE PO_Num		WITH m.tPO_Num
					REPLACE Pcs			WITH m.nPcs
					REPLACE Alloy		WITH m.tAlloy
					REPLACE Form		WITH m.cForm
					REPLACE Heat		WITH m.tHeat
					REPLACE CC			WITH m.tCC
					REPLACE CL			WITH m.tCL
					REPLACE DESCRIPT	WITH m.tDesc
					REPLACE Weight		WITH m.nWeight 
					
					REPLACE KG			WITH m.lKG
					REPLACE PackWeight	WITH m.nPackWeight
					REPLACE Dim1		WITH m.nThck
					REPLACE Dim2		WITH m.nSz2
					REPLACE Dim3		WITH m.nSz3
					REPLACE Weight		WITH m.nWeight
					REPLACE RandLen		WITH m.lRandLen
					REPLACE Metric		WITH m.lMetric
					
					REPLACE PackingSli	WITH 0
					*REPLACE COMPLETE 	WITH m.lComplete
					REPLACE PartNo		WITH m.cPartNo
					REPLACE QTY			WITH 0
					REPLACE PU			WITH 0
					REPLACE SS_ID		WITH 0
					REPLACE tmpPSnum	WITH 0
					REPLACE SOi_cmplt WITH m.lComplete
					
				ELSE
					*Save the PO
					INSERT INTO PackingSlipItem (SalesNum, SOItem, Pcs, Alloy,Form,Heat,CC,CL ;
						,DESCRIPT, Weight, Kg, PackWeight ;				
						,Dim1, Dim2, Dim3, LBS, RandLen, Metric, PO_Num;
						,PackingSli, PartNo, QTY;
						,PU, SS_ID, tmpPSnum, SOi_cmplt ;
						,TBL, SL_ID, SL_ID_D, ID_D_Proc, SL_P, SL_QTY) ;
					VALUES (m.nSalesNum, m.tSOItem, m.nPcs, m.tAlloy, m.cForm,m.tHeat,m.tCC,m.tCL;
						,m.tDesc, m.nWeight, lKg, m.nPackWeight ;
						,m.nThck, m.nSz2, m.nSz3, m.nWeight, m.lRandLen, m.lMetric, m.tPO_Num;
						,0,m.cPartNo, 0;
						,0,0,0, m.lComplete ;
						,'',0,0,0,0,0)
		
		*QTY and PU are Customer Units
		*SL_QTY and SL_P are ERP Acct Stnd  &&each heat line on PackingSli QTY
		*AQ_QTY is Customer	
		
						
					*(SalesNum N(7), SOItem C(10), po_num C(17), pcs N(10), Alloy C(12), Heat C(30), Descript C(80), Weight N(7,1), PackingSli N(10) ,Complete L, QTY, PU)
					THIS.PARENT.PARENT.pg_selected.grdItem.REFRESH()
				ENDIF
				
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"PackingSlip has added a SOitem by scratch. SalesNum "+ALLTRIM(STR(m.nSalesNum))+", SOItem='"+m.tSOItem+"', PartNo "+m.cPartNo+", Alloy "+m.tAlloy+", Form "+m.cForm+", Heat "+m.tHeat ) 
				
				*Save to tmpQuote to be transfered to AllQuotes
				IF NOT USED('tmpQuote')
					SELECT 0
					*PRIVATE cFileName
					*cFileName = SYS(3)
					*cFileName = 'Qou_' + cFileName
					
					ThisForm.Uniq_Quote = UniqDBF(ThisForm.Uniq_Quote)
					
					IF "\MEM" $ SYS(2003)
						CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_Quote) ) FREE ;
						(FORM C(2), Pcs N(4,0), thck N(10,4), Sz2 N(9,3), Sz3 N(9,3), DESCRIPT C(50), Alloy C(12), Heat C(30), SalesNum N(7), SOItem C(10), ITEM N(2,0), Weight N(8,1), SalesP C(1), PO_Num C(17), COMPLETE L )
							
						USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_Quote) EXCL ALIAS tmpQuote
					ELSE
						CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_Quote) ) FREE ;
						(FORM C(2), Pcs N(4,0), thck N(10,4), Sz2 N(9,3), Sz3 N(9,3), DESCRIPT C(50), Alloy C(12), Heat C(30), SalesNum N(7), SOItem C(10), ITEM N(2,0), Weight N(8,1), SalesP C(1), PO_Num C(17), COMPLETE L )
							
						USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_Quote) EXCL ALIAS tmpQuote
					ENDIF
								
					*CREATE TABLE SYS(5)+SYS(2003)+"\"+"tmpQuote" FREE ;
					*(FORM C(2), Pcs N(4,0), thck N(10,4), Sz2 N(9,3), Sz3 N(9,3), DESCRIPT C(50), Alloy C(12), Heat C(30), SalesNum N(7), SOItem C(10), ITEM N(2,0), Weight N(8,1), SalesP C(1), PO_Num C(17), COMPLETE L )
					SELECT tmpQuote
					*USE tmpQuote EXCLUSIVE
				ENDIF
				
				INSERT INTO tmpQuote (FORM, Pcs, thck, Sz2, Sz3, DESCRIPT, Alloy, Heat, SalesNum, SOItem, ITEM, Weight, SalesP, PO_Num, COMPLETE) ;
					VALUES (m.txForm, m.nPcs, m.nThck, m.nSz2, m.nSz3, m.tDesc, m.tAlloy, m.tHeat, m.nSalesNum, m.tSOItem, m.nItem, m.nWeight, m.tSalesP ,m.tPO_Num, m.lcomplete )
		
				*Save to tmpSales to be tranfered to Sales after print
				IF NOT USED('tmpSales')
					SELECT 0
					*PRIVATE cFileName
					*cFileName = SYS(3)
					*cFileName = 'Sls_' + cFileName
					
					ThisForm.Uniq_SAL = UniqDBF(ThisForm.Uniq_SAL)
					
					IF "\MEM" $ SYS(2003)
						CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_SAL) ) FREE ;
							(SOItem C(10), SalesNum N(7,0), PartNo C(100), blind L , FaxConf L , EmailConf L, ShipRoute C(20) )
							
						USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_SAL) EXCL ALIAS tmpSales
					ELSE
						CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_SAL) ) FREE ;
							(SOItem C(10), SalesNum N(7,0), PartNo C(100), blind L , FaxConf L , EmailConf L, ShipRoute C(20) )
							
						USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_SAL) EXCL ALIAS tmpSales
					ENDIF
					
					*CREATE TABLE SYS(5)+SYS(2003)+"\"+"tmpSales" FREE ;
					*(SOItem C(10), SalesNum N(7,0), PartNo C(100), blind L , FaxConf L , EmailConf L, ShipRoute C(20) )
					SELECT tmpSales
					*USE tmpSales EXCLUSIVE
				ENDIF
				
				INSERT INTO tmpSales (SOItem, SalesNum, PartNo ); 
					VALUES (m.tSOItem, m.nSalesNum, m.cPartNo ) 
					* Blind, FaxConf, EmailConf
					
				*Any tmpSales Code Changes should be also done in
				*This.Parent.Parent.pg_SO_items.cmdAddInq
		
		
				THISFORM.EnablePrint()
		
				*make changes in Clear also!
		
				THIS.PARENT.txtItem.VALUE = STR( m.nItem+1 ,2,0) &&IIF(m.nItem<10," ","")+
				THIS.PARENT.txtItem.Refresh
				
				*Track Usage
				TrackMess("SO item "+m.tSOItem+" was added by PackingSlip program, PartNo "+m.cPartNo+", Alloy "+m.tAlloy+", Form "+m.cForm+", Heat "+m.tHeat ) 
					
				This.parent.THCK1.Value = 0
				THIS.PARENT.SZ21.Value = 0
				THIS.PARENT.SZ31.Value = 0
				THIS.PARENT.nWeight.Value = 0
				THIS.PARENT.txtDesc.VALUE = ""
				THIS.PARENT.txtPartNo.VALUE = ""
				THIS.PARENT.chkComplete.VALUE = 0	
				THIS.PARENT.PIECES1.VALUE = 1
				
				THIS.PARENT.Alloy1.SetFocus()
			ELSE
				WAIT WINDOW 'Bad Quantity or Description' NOWAIT
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmdClear.Click
		IF USED('PackingSlipSO')
			IF PackingSlipSO.SO > 0
				this.Parent.txtSO.Value = STR(PackingSlipSO.SO,7,0)
			ELSE
				this.Parent.txtSO.Value = This.Parent.Parent.Parent.Parent.pgOverView.txtSO1.Value 
			ENDIF
		ELSE
			this.Parent.txtSO.Value = This.Parent.Parent.Parent.Parent.pgOverView.txtSO1.Value
		ENDIF
		
		this.Parent.txtItem.Value = " 1"
		
		IF USED('PackingSlipPO') 
			IF NOT EMPTY(PackingSlipPO.PO)
				this.Parent.txtPO_Num.Value = PackingSlipPO.PO
			ENDIF
		ENDIF
		
		this.Parent.txtSalesP.Value = ""
		this.Parent.Alloy1.Value = ""
		this.Parent.txtHeat.Value = ""
		*this.Parent.cmbForm.Value = 1
		this.Parent.PIECES1.Value = 1
		this.Parent.THCK1.Value = 0
		this.Parent.SZ21.Value = 0
		this.Parent.SZ31.Value = 0
		this.Parent.nWeight.Value = 0
		this.Parent.txtDesc.Value = ""
		*this.Parent.txtPartNo.Value = ""
		this.Parent.chkComplete.Value = 0
		
		this.Parent.txtSO.SetFocus()
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.Init
		
		This.ALLOY1.Value	= " "
		This.cmbForm.Value	= "10"
		
		This.PIECES1.Value	= 1
		This.THCK1.Value	= 0
		This.SZ21.Value		= 0
		This.SZ31.Value		= 0
		This.chkKg.Value 	= 0
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.nWeight.GotFocus
		*This.InputMask = "9999.999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.nWeight.Valid
		IF EMPTY(THIS.PARENT.txtDesc.VALUE) OR THIS.PARENT.txtDesc.VALUE = '  0" x 0'
		
			IF TYPE("m.txForm")="U"
				m.txForm = THIS.PARENT.cmbForm.VALUE
				IF TYPE("m.txForm") = "N"
					m.txForm = STR(m.txForm)
				ENDIF
			ENDIF
		
			PRIVATE tAlloy, tForm, tDescription
			PRIVATE nTHCK, nSz2, nSz3, nWeight
		
			tAlloy = THIS.PARENT.ALLOY1.VALUE
			*	tForm  = This.Parent.cmbForm.Value
			nTHCK  = (THIS.PARENT.THCK1.VALUE)
			nSz2   = (THIS.PARENT.SZ21.VALUE)
			nSz3   = (THIS.PARENT.SZ31.VALUE)
			nWeight= (THIS.Value)
			
			tDescription = THISFORM.f_description( tAlloy, m.txForm, nTHCK, nSz2, nSz3, nWeight, .F. )
		
			THIS.PARENT.txtDesc.VALUE = tDescription
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.PIECES1.GotFocus
		*This.InputMask = "9999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.PIECES1.LostFocus
		*This.InputMask = "9,999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.SZ21.GotFocus
		*This.InputMask = "9999.999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.SZ21.LostFocus
		*This.InputMask = "9,999.999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.SZ31.GotFocus
		This.InputMask = "9999.999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.SZ31.LostFocus
		This.InputMask = "9,999.999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.THCK1.GotFocus
		*This.InputMask = "99999.999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.THCK1.LostFocus
		*This.InputMask = "99,999.999"
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.txtDesc.When
		If EMPTY(This.Value) OR This.Value = '  0" x 0'
			PRIVATE tAlloy, tForm, tDescription
			Private nTHCK, nSz2, nSz3, nWeight
			
			tAlloy = This.Parent.ALLOY1.Value
			tForm  = This.Parent.cmbForm.Value
			nTHCK  = (This.Parent.THCK1.Value)
			nSz2   = (This.Parent.SZ21.Value)
			nSz3   = (This.Parent.SZ31.Value)
			nWeight= (This.Parent.NWeight.Value)
			
			tDescription = ThisForm.f_description( tAlloy, tForm, nTHCK, nSZ2, nSZ3, nWeight, .F. )
			
			This.Value = tDescription 
		EndIf
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_selected.Click
		GO TOP IN packingslipitem
		This.grdItem.RecordSource = "packingslipitem"
		This.grdItem.Refresh
		This.grdItem.Zorder()
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_selected.cmdDel.Click
		This.Parent.grdItem.RecordSource = ""
		SELECT PackingSlipItem
		DIMENSION aDelPSitem(1)
		SELECT SOitem FROM PackingSlipItem WHERE DELETED() INTO ARRAY aDelPSitem
		IF TYPE('aDelPSitem(1)') = "C"
			PRIVATE nDelItems, i
			nDelItems = ALEN(aDelPSitem,1)
			FOR i = 1 to nDelItems 
				*UNMARK in tmpSalesNum	*REPLACE tmpSalesNum.Posted WITH "Y"
				UPDATE tmpSalesNum SET Posted = "N" WHERE tmpSalesNum.SOItem = aDelPSitem(i)
				
			NEXT i
		ENDIF
		PACK
		GO TOP
		IF EOF()
			INSERT INTO PackingSlipItem ;
				(SalesNum, SOItem, PCs, Alloy, Form, Heat, CC,CL;
				,DESCRIPT, AQDescript,Weight, Kg, PackWeight;
				,Dim1,Dim2,Dim3,RandLen,Metric, PO_num, PackingSli;
				,PartNo, QTY;
				,PU, SS_ID, tmpPSnum, SOi_cmplt ;
				,TBL, SL_ID, SL_ID_D, ID_D_Proc, SL_P, SL_QTY); 
			VALUES ;
				(0,'',0,'','','','','','';
				,'',0,.F.,0;
				,0,0,0,.F.,.F.,'',0;
				,'',0;
				,0,0,0,.F. ;
				,'',0,0,0,0,0)
				
			ThisForm.EnablePrint()
		ENDIF
		This.Parent.grdItem.RecordSource = "PackingSlipItem"
		This.Parent.grdItem.Refresh()
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_selected.grdItem.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.EnablePrint()
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_SO_items.Click
		IF THIS.grdInq.VISIBLE = .F.
		*	ThisForm.ShowSalesOrderItemsGRD()
			THISFORM.REFRESH()
		ENDIF
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_SO_items.cmdSelectSOitem.Click
		**DO FORM Forms\PSItemDetail
		PRIVATE cSOitem, cPartNo, cPO_Num, cAQDescript 
		PRIVATE cAlloy, nWeight, lKg
		PRIVATE nQTY, nPU
		PRIVATE ldShip
		
		IF NOT USED('tmpSalesNum')
			MESSAGEBOX( "Could not find table 'tmpSalesNum'")
			RETURN
		ENDIF
		
		SELECT tmpSalesNum
		IF BOF() OR EOF()
			MESSAGEBOX( "No data in table 'tmpSalesNum'" )
			RETURN
		ENDIF
		PRIVATE cMess,nMess, lAddSales_Stock 
		lAddSales_Stock = .F.
		nMess = 0
		
		ldShip = PrepareSQLlogic(tmpSalesNum.dShip,'dShip')
		*ldShip = ( Count_SOIteminSales(cSOitem, ThisForm.nConnHandle, 'dShip') > 0 )
		************************************************
		
		IF tmpSalesNum.Posted = "Y"
			*nMess = MESSAGEBOX( "This Record has already been POSTED to the 'Selected Items' list"+CHR(13)+CHR(13)+"Shop may have Completed as a Service."+CHR(13)+"Have shop use 'Shop Stock List Edit' to undo this complete mark.",4+64,"Marked as Complete." )
			
			IF ldShip &&Direct Ship from Vendor
				cMess = "This was Direct Shipped from Vendor"+CHR(13)+"If true, Override and Continue Shipping in next message."
			ELSE
				cMess = "This item has already been COMPLETED or POSTED "+CHR(13)+"on the 'Selected Items' list."
			ENDIF
			MESSAGEBOX( cMess,64,"Marked as Complete." )
			
			PRIVATE lPerm_PS_Edit
			lPerm_PS_Edit = .F.
			
			IF NOT ldShip 
				*Check for permision if NOT a Drop Ship
				lPerm_PS_Edit = HavePermission('PackingSlip Edit')
			ELSE
				lPerm_PS_Edit = .T.
			ENDIF
			
			IF NOT lPerm_PS_Edit
				MESSAGEBOX("You do not have Permission."+CHR(13)+"HavePermission('PackingSlip Edit')"+CHR(13)+SYS(0)+CHR(13)+"Cannot continue with PackingSlip."+CHR(13)+"Edit in ship if this is an error.",16,"Cannot continue.")
				RETURN .F.
			ELSE
		
				IF ldShip &&Direct Ship from Vendor
					cMess = "This was Direct Shipped from Vendor"+CHR(13)
				ELSE
					cMess = "You have Permissions to Override."+CHR(13)+CHR(13)
				ENDIF
				cMess = cMess + "Do you want to Override the 'Complete' mark "+CHR(13)+"and Continue PackingSlip?"
				
				nMess = MESSAGEBOX( cMess,4+64,"Continue with PackingSlip?" )
				IF nMess = 6
					SELECT tmpSalesNum
					REPLACE Posted WITH "Y" IN tmpSalesNum
					PRIVATE nLastPS
					cSOitem	= PrepareSQLtxt(tmpSalesNum.SOitem,'SOitem',10)
					nLastPS	= ThisForm.PackingSlip_SOitem(cSOitem)
					TrackMess("SO item '"+cSOitem+"' was listed as Complete."+CHR(13)+SYS(0)+CHR(13)+"Override the PackingSlip program to make a PackingSlip."+CHR(13)+"The Last recorded PackingSli was "+ALLTRIM(STR(nLastPS)) )
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
			lAddSales_Stock = .T.
			*** Get the orig SS_ID
			*UPDATE the Orig SS_ID with pc
			*Clone Orig SS_ID, update Coled with PC remain
		*	 ThisFormSet.CloneSales_Stock()
		ENDIF
		
		*********************
		IF USED("tmpPSItem")
			USE IN tmpPSItem
		ENDIF
		*********************
		
		nSalesNum	= tmpSalesNum.SalesNum
		
		IF Proper_SO_item( PrepareSQLtxt(tmpSalesNum.SOitem,'SOitem',10) ) <> Proper_SO_item('')
			cSOitem		= PrepareSQLtxt(tmpSalesNum.SOitem,'SOitem',10)
		ELSE
			cSOitem = FixSOitem(tmpSalesNum.Salesnum,tmpSalesNum.Item,tmpSalesNum.SOitem)
			*cSOitem		= Proper_SO_Item( STR(tmpSalesNum.Salesnum)+"-"+IIF(tmpSalesNum.Item<10,"0"+STR(tmpSalesNum.item,1,0), STR(tmpSalesNum.item,2,0) ) )
		ENDIF
		
		cAlloy		= PrepareSQLtxt(tmpSalesNum.Alloy,'Alloy',12)
		nWeight		= tmpSalesNum.Weight
		*nWeight = 0		&&Stopped defaulting Weight, PackingSlip crew was not checking for the correct weight!!!!
		lKg 		= tmpSalesNum.Metric
		cDescription= THISFORM.f_description( cAlloy, tmpSalesNum.FORM, tmpSalesNum.THCK, tmpSalesNum.SZ2, tmpSalesNum.SZ3, tmpSalesNum.Weight, tmpSalesNum.Metric )
		cPO_Num		= tmpSalesNum.PO_num
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item("")
			cPartNo		= ''
		ELSE
			cPartNo		= get_PartNoinSales(cSOitem,THISFORM.nConnHandle)
		ENDIF
		nQTY		= Get_QTYinSales(cSOitem,THISFORM.nConnHandle)
		nPU			= Get_PUinSales(cSOitem,THISFORM.nConnHandle)
		cAQDescript = PrepareSQLtxt(tmpSalesNum.Descript,'AQDescript',50)
		
		PRIVATE nPCs,cHeat,cLot
		PRIVATE lComplete
		PRIVATE cCC,cCL,cForm,nDim1,nDim2,nDim3,lRandLen,nID_Detail,nSales_Detail_ID
		
		nPcs = tmpSalesNum.Pieces
		IF nPcs < 1
			nPcs = 1
		ENDIF
		cHeat	= ''
		cLot = ''
		lComplete	= .F.
		
		cCC		= PrepareSQLtxt(tmpSalesNum.CC,'CC',1)
		cCL		= PrepareSQLtxt(tmpSalesNum.CL,'CL',1)
		cForm	= PrepareSQLtxt(tmpSalesNum.Form,'Form',2)
		nWeight = PrepareSQLnum(tmpSalesNum.Weight,'LBS',7,1)
		*nWeight = 0
		nDim1	= PrepareSQLnum(tmpSalesNum.Thck,'Dim1',18,4)
		nDim2	= PrepareSQLnum(tmpSalesNum.Sz2,'Dim2',18,4)
		nDim3	= PrepareSQLnum(tmpSalesNum.Sz3,'Dim3',18,4)
		
		lRandLen	= .F.
		nID_Detail		= 0
		nSales_Detail_ID= 0
		
		
		*check for ShipOn **************************************************************
		IF ThisForm.ShipOn
			PRIVATE cSQL,nSQLEXEC
			IF USED('Ship_Sales')
				USE IN Ship_Sales
			ENDIF
			SELECT 0
			*DIMENSION aS_Ship(1,2)
			*SELECT ShipOn, ShipDue FROM HPA!Sales WHERE Sales.SOitem = cSOitem  INTO ARRAY aS_Ship
			cSQL = "SELECT ShipOn, ShipDue FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL+" WHERE Sales.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'Ship_Sales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'Ship_Sales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Ship_Sales')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Ship_Sales')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship_Sales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship_Sales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError( cSQL, THISFORM.nConnHandle,nSQLEXEC, 'Ship_Sales' )
			ENDIF
			
			IF USED('Ship_Sales')
				IF VARTYPE(Ship_Sales.ShipOn) = "L"
					IF Ship_Sales.ShipOn
						IF VARTYPE(Ship_Sales.ShipDue) = "D" OR VARTYPE(Ship_Sales.ShipDue) = "T"
							IF TTOD(Ship_Sales.ShipDue) > DATE()+1
		*						TrackMess("SO with item "+cSOitem+" was selectected in Packing slip on ("+DTOC(DATE())+"), Order  written to not ship before ("+DTOC(Ship_Sales.ShipDue)+")"  )
								IF MESSAGEBOX( "This Sales Order Item is only to be shipped on "+DTOC(TTOD(Ship_Sales.ShipDue))+"!"+CHR(13)+;
								  "or After, NOT BEFORE!"+CHR(13)+;
								  CHR(13)+ "Do you have customer Permission to overide the 'ship on' Date?";
								  ,4+32+256,"Item is marked as a 'SHIP ON' date." ) = 7
									RETURN
								ELSE
									***Let SalesP know order is early
									PRIVATE cHyperLink 
									cHyperLink = HTML_SOitem(cSOitem,.T.)
									TrackMess("SO item "+cSOitem+" Shipped early ("+DTOC(DATE())+"), Order was written to not ship before ("+DTOC(TTOD(Ship_Sales.ShipDue))+")" +CHR(13)+cHyperLink  )
									TrackError("SO item "+cSOitem+" Shipped early ("+DTOC(DATE())+"), Order was written to not ship before ("+DTOC(TTOD(Ship_Sales.ShipDue))+")"+CHR(10)+CHR(13)+HTML_SOitem(cSOitem,.T.),"SO item "+cSOitem+" Shipped early ", PROGRAM(),LINENO(1) )
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					USE IN Ship_Sales
				ENDIF
			ENDIF
		ENDIF
		
		************************************************
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			IF Is_SOitem_OnHold( cSOitem, "ANY", ThisForm.nConnhandle)
				MESSAGEBOX("This SOitem '"+cSOitem+"' is OnHold"+CHR(13)+"You can continue, but this will be record!",32,"Continue")
				TrackMess("The SOitem '"+cSOitem+"' is OnHold and Packing Slip is being run."+" "+CHR(13)+SYS(16,1))
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SOitem '"+cSOitem+"' is OnHold and Packing Slip is being run.") 
				nSalesNum = Proper_SO_Item_SO(cSOitem)
				Track_Sales_No_Chng("The SOitem '"+cSOitem+"' is OnHold and Packing Slip is being run.",nSalesNum,0,0)
		
				lOK = Chatter( SalesRepfromSO(nSalesNum ),"The SOitem '"+cSOitem+"' is OnHold and Packing Slip is being run."+CHR(13)+HTML_SOitem(cSOitem,.T.) ,ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		************************************************
		PRIVATE lMetric
		lMetric = .f.
		lMetric = IsMetric_SOitem(cSOitem,THISFORM.nConnHandle)
		
		
		************************************************
		SELECT 0
		PRIVATE cFileName
		cFileName = SYS(3)
		cFileName = 'PSI_' + cFileName
		
		ThisForm.Uniq_PSItem = UniqDBF(ThisForm.Uniq_PSItem)
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_PSItem) ) FREE ;
				(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12), Form C(2),Heat C(50),Lot C(10),CC C(1), CL C(1), DESCRIPT C(80), AQDescript C(50), Weight N(9,1), Kg L;
				,PackWeight N(7,1), Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),RandLen L,Metric L, PO_num C(17), PackingSli N(10);
				,PartNo C(100), QTY N(18,4), PU N(1), SS_ID N(10), tmpPSnum N(10);
				,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4),SOi_cmplt L )
					
			USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_PSItem) EXCL ALIAS tmpPSItem
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_PSItem) ) FREE ;
				(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12), Form C(2),Heat C(50),Lot C(10), CC C(1), CL C(1), DESCRIPT C(80), AQDescript C(50), Weight N(9,1), Kg L;
				,PackWeight N(7,1),Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),RandLen L,Metric L, PO_num C(17), PackingSli N(10);
				,PartNo C(100), QTY N(18,4), PU N(1), SS_ID N(10), tmpPSnum N(10);
				,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4),SOi_cmplt L )
		*SS_ID Sales_Stock_ID
		
					
		*QTY and PU are Customer Units
		*SL_QTY and SL_P are ERP Acct Stnd  -SL is for each heat QTY
																	*USED('tmpPSItem')
			USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_PSItem) EXCL ALIAS tmpPSItem
		ENDIF
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpPSItem") FREE ;
		* REPLACED COMPLETE with SOi_cmplt
		
		
		*************************************************************************************************************
		*************************************************************************************************************
		*************************************************************************************************************
		**Get data from dbo.Sales_Stock that Shop created into tmpPSItemDetail
		
		
		IF USED("tmpPSItemDetail")	
			USE IN tmpPSItemDetail
		ENDIF 
		SELECT 0
		
		*dbo.Sales_Stock
		cSQL = "SELECT SS.StockLst_PC "
		cSQL = cSQL+" ,SS.Alloy,SS.Form,AQ.Form AS [AQform] "
		cSQL = cSQL+" ,RTRIM(ISNULL(SS.Heat,'')) AS Heat "
		cSQL = cSQL+" ,RTRIM(ISNULL(SS.Lot,'')) AS Lot "
		cSQL = cSQL+" ,SS.CC,SS.CL "
		*cSQL = cSQL+" ,dbo.f_ItemDescription(SS.Form,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3,CASE WHEN SS.StockLst_LBS>0 THEN SS.StockLst_LBS ELSE SS.StockLst_Qty END,SS.RandLen) AS [Descript] "
		cSQL = cSQL+" ,AQ.Descript AS [AQDescript] "
		cSQL = cSQL+" ,CASE WHEN SS.Form = '  '"  &&If lost Form, Use AllQuote
		cSQL = cSQL+" THEN dbo.f_ItemDescription(AQ.Form,AQ.thck,AQ.sz2,AQ.Sz3,AQ.weight,AQ.RandLen) "
		*cSQL = cSQL+" ELSE dbo.f_ItemDescription(SS.Form,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3,CASE WHEN SS.StockLst_LBS>0 THEN SS.StockLst_LBS ELSE SS.StockLst_Qty END,SS.RandLen) "
		cSQL = cSQL+" ELSE dbo.f_ItemDescription(SS.Form,SS.Orig_Dim1,SS.Orig_Dim2,SS.Orig_Dim3,CASE WHEN SS.Orig_LBS >0 THEN SS.Orig_LBS ELSE SS.Orig_Qty END,SS.RandLen) "
		
		cSQL = cSQL+" END AS [Descript] "
		*cSQL = cSQL+" ,SS.StockLst_Dim1+" ,SS.StockLst_Dim2"+" ,SS.StockLst_Dim3"
		*cSQL = cSQL+" ,CASE WHEN SS.Orig_LBS>0 THEN SS.Orig_LBS ELSE SS.Orig_Qty END AS StockLst_LBS "
		cSQL = cSQL+" ,SS.RandLen"
		cSQL = cSQL+" ,SS.TBL"
		cSQL = cSQL+" ,SS.StockLst_ID"
		cSQL = cSQL+" ,SS.StockLst_ID_Detail"
		cSQL = cSQL+" ,SS.ID AS SS_ID "
		cSQL = cSQL+" ,SS.Consumed "
		cSQL = cSQL+" ,SS.StkBack "
		cSQL = cSQL+" ,SS.ID_Detail_Process "
		*cSQL = cSQL+" ,SS.StockLst_QTY"	&&depricated
		*cSQL = cSQL+" ,SS.StockLst_P"
		*cSQL = cSQL+" ,SS.StockLst_Total"
		*cSQL = cSQL+" ,SS.StockLst_PC"
		cSQL = cSQL+" ,SS.Orig_PC"
		cSQL = cSQL+" ,SS.Orig_DIM1"
		cSQL = cSQL+" ,SS.Orig_DIM2"
		cSQL = cSQL+" ,SS.Orig_DIM3"
		cSQL = cSQL+" ,SS.Orig_LBS"
		cSQL = cSQL+" ,SS.Orig_QTY"	&&ERP Acct Stnd
		cSQL = cSQL+" ,SS.Orig_Total"
		cSQL = cSQL+" ,SS.Orig_P"
		cSQL = cSQL+" ,SS.Orig_PU"
		
		cSQL = cSQL+" ,SS.Removed_PC, SS.Removed_Dim1, SS.Removed_Dim2, SS.Removed_Dim3, SS.Removed_LBS, SS.Removed_QTY, SS.Removed_Total, SS.Removed_Paid_Total "
		
		cSQL = cSQL+",AQ.Pieces AS AQ_Pieces"
		cSQL = cSQL+",AQ.Thck AS AQ_Dim1"
		cSQL = cSQL+",AQ.Sz2 AS Aq_Dim2"
		cSQL = cSQL+",AQ.Sz3 AS AQ_Dim3"
		cSQL = cSQL+",AQ.Weight AS AQ_LBS"
		cSQL = cSQL+",AQ.RandLen AS AQ_RandLen"
		*cSQL = cSQL+",dbo.f_Get_QTY_SOitem(AQ.SOitem) AS AQ_QTY"
		cSQL = cSQL+",AQ.Q_QTY AS AQ_Q_QTY"		&&Customer QTY
		cSQL = cSQL+",AQ.Q_P AS AQ_Q_P"
		cSQL = cSQL+",AQ.Q_PU AS AQ_Q_PU"
		cSQL = cSQL+",AQ.SOitem "
		cSQL = cSQL+" FROM dbo.Sales_Stock SS"
		cSQL = cSQL+" INNER JOIN dbo.AllQuotes AQ ON AQ.SOitem = SS.SOitem"
		cSQL = cSQL+" WHERE SS.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL+" AND SS.Reconciled = 0"
		cSQL = cSQL+" AND SS.PackingSli <= 0 "
		cSQL = cSQL+" AND SS.Added = 0 "
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPSItemDetail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'tmpPSItemDetail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSItemDetail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSItemDetail')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpPSItemDetail' )
		ENDIF
		
		********************************************************************
		* check for toll work of Customers material
		*Sales Order Type; Inventory, Broker, Mill, Production, Service,Conversion.  dbo.f_Sales_TYP()
		PRIVATE cTYP
		cTYP = Get_TYPinSales(cSOItem, ThisForm.nConnHandle)
		
		IF cTYP="S" OR cTYP = "C"
			* look for Receiving to get Heat....
			IF USED("tmpPSItemDetail")	
				IF RECCOUNT("tmpPSItemDetail") > 0
					TrackError("Packing Slip SOitem '"+cSOItem+"'is for TYP='"+cTYP +"'"+CHR(13)+"But dbo.Sales_Stock has it being removed from Stock"+CHR(13)+cSQL,"Packing Slip SOitem is for Service or Conversion", PROGRAM(), LINENO(1))
				ENDIF
				USE IN tmpPSItemDetail
			ENDIF 
			
			SELECT 0
		
			*dbo.Receiving
			cSQL = "SELECT R.[Received],R.[POitem],R.[SOitem],R.[WO],R.[WO_Detail]"
			cSQL = cSQL+",AQ.[Pieces] AS StockLst_PC,AQ.[Alloy]"
			cSQL = cSQL+",AQ.Form"
			cSQL = cSQL+",AQ.Form AS AQForm"
			cSQL = cSQL+",R.[Heat],R.[lot]"
			cSQL = cSQL+",AQ.CC"
			cSQL = cSQL+",AQ.CL "
			cSQL = cSQL+",R.[Description] AS Descript"
			cSQL = cSQL+",R.[Specs] AS AQDescript"
			cSQL = cSQL+",R.[Comments]"
			cSQL = cSQL+",R.[ID_Master] AS StockLst_ID"
			cSQL = cSQL+",R.[ID_Detail] AS StockLst_ID_Detail"
			cSQL = cSQL+", 0 AS SS_ID"
			cSQL = cSQL+",R.[ID_Detail_Process]"
			cSQL = cSQL+",R.[StockTable] AS TBL"
			cSQL = cSQL+",R.[R_QTY],R.[R_P],R.[R_Total],R.[R_PU]"
		*--,[R_AP_P],[R_AP_Total],[hold],[PO_QTY],[PO_P],[PO_Total],[PO_PU]
			cSQL = cSQL+",AQ.Pieces AS AQ_Pieces"
			cSQL = cSQL+",AQ.Thck AS AQ_Dim1"
			cSQL = cSQL+",AQ.Sz2 AS AQ_Dim2"
			cSQL = cSQL+",AQ.Sz3 AS AQ_Dim3"
			cSQL = cSQL+",AQ.Randlen AS AQ_RandLen"
			cSQL = cSQL+",AQ.Q_QTY AS AQ_Q_QTY"
			cSQL = cSQL+",0 AS Consumed"
			cSQL = cSQL+",AQ.Pieces AS Orig_PC"
			cSQL = cSQL+",AQ.Thck AS Orig_Dim1"
			cSQL = cSQL+",AQ.Sz2 AS Orig_Dim2"
			cSQL = cSQL+",AQ.Sz3 AS Orig_Dim3"
			cSQL = cSQL+",AQ.Weight AS Orig_LBS"
			cSQL = cSQL+",AQ.Q_QTY AS Orig_QTY"
			cSQL = cSQL+",AQ.Q_P AS Orig_P"
			cSQL = cSQL+",AQ.Q_QTY AS SL_QTY"	&&nStockLst_QTY	
			cSQL = cSQL+" FROM dbo.Receiving R WITH(NOLOCK) "
			cSQL = cSQL+" inner join dbo.AllQuotes AQ WITH(NOLOCK) ON R.SOitem = AQ.SOitem "
			cSQL = cSQL+" WHERE R.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPSItemDetail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'tmpPSItemDetail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSItemDetail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSItemDetail')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDetail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDetail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpPSItemDetail' )
			ENDIF
		ENDIF
		
		********************************************************************
		*Windows Form PSItemDetail.scx uses table tmpPSItem and does not need to passed parameters
		PRIVATE nPackWeight, lInsertBasic, nSS_ID &&Sales_Stock.ID
		nPackWeight = 0
		lInsertBasic = .T.
		nSS_ID = 0
		
		*************************************************************************************************************
		*************************************************************************************************************
		*************************************************************************************************************
		*get Data from Lst_Process_Grab that shop created into tmpPSItem
		PRIVATE nTmpPSnum
		PRIVATE cTBL, nSL_ID, nSL_ID_D, nID_D_Proc, nSL_P, nSL_QTY 
		PRIVATE cTBL,nStockLst_ID, nStockLst_ID_Detail, nID_Detail_Process, nStockLst_QTY, nStockLst_P, nStockLst_Total
		PRIVATE nStockLst_PC, nStockLst_Dim1, nStockLst_Dim2, nStockLst_Dim3, nStockLst_LBS
		PRIVATE nOrig_PC, nOrig_Dim1, nOrig_Dim2, nOrig_Dim3, nOrig_LBS, nOrig_QTY
		PRIVATE lConsumed
		lConsumed = .F.
						
						
		
		PRIVATE nCurrScanRec
		nCurrScanRec = 0
		
		** collect data from tmpPSItemDetail and add to tmpPSItem
		IF USED('tmpPSItemDetail')
			SELECT tmpPSItemDetail
			IF RECCOUNT('tmpPSItemDetail')>0
				****************************************************	
				*Clean out Stock Back QTY
				****************************************************	
		*!*			SCAN
		*!*				IF DELETED()
		*!*					LOOP
		*!*				ENDIF
		*!*				nCurrScanRec = RECNO()
		*!*				
		*!*				lStkBack = PrepareSQLlogic(tmpPSItemDetail.StkBack,'StkBack')
		*!*				IF lStkBack
		*!*					cTBL 				= PrepareSQLtxt(tmpPSItemDetail.TBL,'TBL',1)
		*!*					nStockLst_ID		= PrepareSQLnum(tmpPSItemDetail.StockLst_ID,'StockLst_ID',-3)
		*!*					nStockLst_ID_Detail	= PrepareSQLnum(tmpPSItemDetail.StockLst_ID_Detail,'StockLst_ID_Detail',-3)
		*!*					nID_Detail_Process	= PrepareSQLnum(tmpPSItemDetail.ID_Detail_Process,'ID_Detail_Process',-3)
		*!*					*nStockLst_QTY	= PrepareSQLnum(tmpPSItemDetail.StockLst_QTY,'StockLst_QTY',-5)
		*!*					*nStockLst_P		= PrepareSQLnum(tmpPSItemDetail.StockLst_P,'StockLst_P',-5)
		*!*					*nStockLst_Total	= PrepareSQLnum(tmpPSItemDetail.StockLst_Total,'StockLst_Total',-5)
		*!*					*nStockLst_PC	= PrepareSQLnum(tmpPSItemDetail.StockLst_PC,'StockLst_PC',-3)
		*!*					*nStockLst_Dim1	= PrepareSQLnum(tmpPSItemDetail.StockLst_Dim1,'StockLst_Dim1',10,4)
		*!*					*nStockLst_Dim2	= PrepareSQLnum(tmpPSItemDetail.StockLst_Dim2,'StockLst_Dim2',9,3)
		*!*					*nStockLst_Dim3	= PrepareSQLnum(tmpPSItemDetail.StockLst_Dim3,'StockLst_Dim3',9,3)
		*!*					*nStockLst_LBS	= PrepareSQLnum(tmpPSItemDetail.StockLst_LBS,'StockLst_LBS',9,1)
		*!*					nOrig_PC	= PrepareSQLnum(tmpPSItemDetail.Orig_PC,'Orig_PC',-3)
		*!*					nOrig_Dim1	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim1,'Orig_Dim1',10,4)
		*!*					nOrig_Dim2	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim2,'Orig_Dim2',9,3)
		*!*					nOrig_Dim3	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim3,'Orig_Dim3',9,3)
		*!*					nOrig_LBS	= PrepareSQLnum(tmpPSItemDetail.Orig_LBS,'Orig_LBS',9,1)
		*!*					nOrig_QTY	= PrepareSQLnum(tmpPSItemDetail.Orig_QTY,'Orig_QTY',18,4)
		*!*					nOrig_P		= PrepareSQLnum(tmpPSItemDetail.Orig_P,'Orig_P',-5)
		*!*					nOrig_Total	= PrepareSQLnum(tmpPSItemDetail.Orig_Total,'Orig_Total',-5)
		*!*					nOrig_PU	= PrepareSQLnum(tmpPSItemDetail.Orig_PU,'Orig_PU',-1)				
		*!*					
		*!*					
		*!*					SELECT tmpPSItemDetail 
		*!*					GO RECORD nCurrScanRec
		*!*					
		*!*				ENDIF
		*!*			ENDSCAN
		*!*			
				****************************************************	
				*Clean out Duplicate Heats
				****************************************************	
				
				SELECT tmpPSItemDetail
				SCAN
					IF DELETED('tmpPSItemDetail')
						LOOP
					ENDIF
					cHeat	= PrepareSQLtxt(tmpPSItemDetail.Heat,'Heat',30)
					cLot	= PrepareSQLtxt(tmpPSItemDetail.Lot,'Lot',10)
					nSS_ID	= PrepareSQLnum(tmpPSItemDetail.SS_ID,'SS_ID',-3)
					
					LOCATE FOR Heat = cHeat AND Lot = cLot AND SS_ID <> nSS_ID AND NOT DELETED()
					IF FOUND('tmpPSItemDetail')
						DELETE FOR Heat = cHeat AND Lot = cLot AND SS_ID <> nSS_ID AND NOT DELETED()
					ENDIF
					
				ENDSCAN
				
				***************************************************************************************************
				** Add the non deleted records to tmpPSItem 
				** Use the SalesOrder sizes instead of Stock Detail Sizes
				
				SELECT tmpPSItemDetail
				*PACK
				GO TOP
				
				*rescan with StkBack removed.
				SCAN
					IF DELETED()
						LOOP
					ENDIF
		
					cAlloy	= PrepareSQLtxt(tmpPSItemDetail.Alloy,'Alloy',12)
					cForm	= PrepareSQLtxt(tmpPSItemDetail.Form,'Form',2)
					IF EMPTY(cForm)
						cForm = PrepareSQLtxt(tmpPSItemDetail.AQForm,'Form',2)
					ENDIF
					cHeat	= PrepareSQLtxt(tmpPSItemDetail.Heat,'Heat',30)
					cLot	= PrepareSQLtxt(tmpPSItemDetail.Lot,'Lot',10)
					cCC		= PrepareSQLtxt(tmpPSItemDetail.CC,'CC',1)
					cCL		= PrepareSQLtxt(tmpPSItemDetail.CL,'CL',1)
					
					cDescription= PrepareSQLtxt(tmpPSItemDetail.Descript,'Descript',80)
					cAQDescript = PrepareSQLtxt(tmpPSItemDetail.AQDescript,'AQDescript',50,.T.)  &&PAD - makes different from tmpPSItemGrab
					
					*cSQL = cSQL+",AQ.Pieces AS AQ_Pieces"
					nPCs	= PrepareSQLnum(tmpPSItemDetail.AQ_Pieces,'PCs',18,4)
					nPCs	= IIF(nPCs < 1, 1, nPcs )
					
					nDim1			= PrepareSQLnum(tmpPSItemDetail.AQ_Dim1,'Dim1',18,4)
					nDim2			= PrepareSQLnum(tmpPSItemDetail.AQ_Dim2,'Dim2',18,4)
					nDim3			= PrepareSQLnum(tmpPSItemDetail.AQ_Dim3,'Dim3',18,4)
					lRandLen		= PrepareSQLlogic(tmpPSItemDetail.AQ_RandLen,'RandLen')
					*nWeight			= 0	&&PrepareSQLnum(tmpPSItemDetail.Weight,'LBS',7,1)
					nQTY			= PrepareSQLnum(tmpPSItemDetail.AQ_Q_QTY,'Customer_QTY',-5) &&Customer QTY
					*nQty and AQ_QTY are 
					
					nSS_ID		= PrepareSQLnum(tmpPSItemDetail.SS_ID,'SS_ID',-3)
					nTmpPSnum 	= 0
					cTBL		= PrepareSQLtxt(tmpPSItemDetail.TBL,'TBL',1)
					
					IF PrepareSQLlogic(tmpPSItemDetail.Consumed,'Consumed',.F.)
						nStockLst_PC	= PrepareSQLnum(tmpPSItemDetail.Removed_PC,'PCs',18,4)
						nStockLst_PC 	= IIF(nStockLst_PC < 1, 1, nStockLst_PC )			
						nStockLst_Dim1	= PrepareSQLnum(tmpPSItemDetail.Removed_Dim1,'Dim1',18,4)
						nStockLst_Dim2	= PrepareSQLnum(tmpPSItemDetail.Removed_Dim2,'Dim2',18,4)
						nStockLst_Dim3	= PrepareSQLnum(tmpPSItemDetail.Removed_Dim3,'Dim3',18,4)
						nStockLst_LBS	= PrepareSQLnum(tmpPSItemDetail.Removed_LBS,'LBS',7,1)
						nStockLst_QTY	= PrepareSQLnum(tmpPSItemDetail.Removed_QTY,'StockLst_QTY',-5)	&&Acct Stnd
					ELSE
		*!*					nOrig_PC	= PrepareSQLnum(tmpPSItemDetail.Orig_PC,'Orig_PC',-3)
		*!*					nOrig_PC	= IIF(nOrig_PC < 1, 1, nOrig_PC)
		*!*					nOrig_Dim1	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim1,'Orig_Dim1',10,4)
		*!*					nOrig_Dim2	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim2,'Orig_Dim2',9,3)
		*!*					nOrig_Dim3	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim3,'Orig_Dim3',9,3)
		*!*					nOrig_LBS	= PrepareSQLnum(tmpPSItemDetail.Orig_LBS,'Orig_LBS',9,1)
		*!*					nOrig_QTY	= PrepareSQLnum(tmpPSItemDetail.Orig_QTY,'Orig_QTY',18,4)
		*!*					nOrig_P		= PrepareSQLnum(tmpPSItemDetail.Orig_P,'Orig_P',-5)
		*!*					nOrig_Total	= PrepareSQLnum(tmpPSItemDetail.Orig_Total,'Orig_Total',-5)
		*!*					nOrig_PU	= PrepareSQLnum(tmpPSItemDetail.Orig_PU,'Orig_PU',-1)
						
						nStockLst_PC	= PrepareSQLnum(tmpPSItemDetail.Orig_PC,'PCs',18,4)
						nStockLst_PC 	= IIF(nStockLst_PC < 1, 1, nStockLst_PC )			
						nStockLst_Dim1	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim1,'Dim1',18,4)
						nStockLst_Dim2	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim2,'Dim2',18,4)
						nStockLst_Dim3	= PrepareSQLnum(tmpPSItemDetail.Orig_Dim3,'Dim3',18,4)
						nStockLst_LBS	= PrepareSQLnum(tmpPSItemDetail.Orig_LBS,'LBS',7,1)
						nStockLst_QTY	= PrepareSQLnum(tmpPSItemDetail.Orig_QTY,'S_QTY',-5)	&&Acct Stnd
					ENDIF
					
					nSL_ID 		= PrepareSQLnum(tmpPSItemDetail.StockLst_ID,'StockLst_ID',-3)
					nStockLst_ID = PrepareSQLnum(tmpPSItemDetail.StockLst_ID,'StockLst_ID',-3)
					
					nSL_ID_D		= PrepareSQLnum(tmpPSItemDetail.StockLst_ID_Detail,'StockLst_ID_Detail',-3)
					nStockLst_ID_Detail = PrepareSQLnum(tmpPSItemDetail.StockLst_ID_Detail,'StockLst_ID_Detail',-3)
					
					nID_D_Proc		= PrepareSQLnum(tmpPSItemDetail.ID_Detail_Process,'ID_Detail_Process',-3)
					nID_Detail_Process	= PrepareSQLnum(tmpPSItemDetail.ID_Detail_Process,'ID_Detail_Process',-3)
					
					nSL_QTY		= nStockLst_QTY		&&BAD, should be Acct Stnd QTY for each Heat line
					IF nSL_QTY = 0
						*nSL_QTY = nQTY &&Acct Stnd = Customer stnd - bad idea
						*nSL_QTY = GetUnitQty (nPCs,cAlloy,cForm,nThck,nSz2,nSz3,pConnHandle)
					ENDIF
					cSOitem		= PrepareSQLtxt(tmpPSItemDetail.SOitem,'SOitem',10)
					
					nSL_P		= PrepareSQLnum(tmpPSItemDetail.Orig_P,'S_P',-3)
					nStockLst_P	= PrepareSQLnum(tmpPSItemDetail.Orig_P,'S_P',-3)
		
					*** Check numbers!
					IF (nDim1+10)*1.1 > nStockLst_Dim1+10 AND nDim1+10 < (nStockLst_Dim1+10)*1.1
						*DIM1 is within 10%
						IF (nDim2+10)*1.2 > nStockLst_Dim2+10 AND nDim2+10 < (nStockLst_Dim2+10)*1.2
							*DIM2 is within 20%
							IF (nDim3+10)*1.2 > nStockLst_Dim3+10 AND nDim3+10 < (nStockLst_Dim3+10)*1.2
								*DIM3 is within 20%
								
								IF (nPCs+10)*1.1 > nStockLst_PC +10 AND nPCs+10 < (nStockLst_PC +10)*1.1
									*PC is within 10%
								ELSE
									*USE Stock_Lst
									nPCs = nStockLst_PC 
									nQTY = nStockLst_QTY
									nWeight = nStockLst_LBS
									*nWeight = 0
								ENDIF
							ELSE
								*Dim3 is Off
								
								IF (nPCs+10)*1.1 > nStockLst_PC +10 AND nPCs+10 < (nStockLst_PC +10)*1.1
									*PC is within 10%
									*USE Stock_Lst
									nDim3 = nStockLst_Dim3
									nQTY = nStockLst_QTY
									nWeight = nStockLst_LBS
									*nWeight = 0
								ENDIF							
								
							ENDIF
						ELSE
						
							*Dim2 is Off
							IF nDim3 = 0
								IF (nPCs+10)*1.1 > nStockLst_PC +10 AND nPCs+10 < (nStockLst_PC +10)*1.1
									*PC is within 10%
									*USE Stock_Lst
									nDim2 = nStockLst_Dim2
									nQTY = nStockLst_QTY
									nWeight = nStockLst_LBS
									*nWeight = 0
								ENDIF							
							ENDIF					
						ENDIF
					ENDIF
					
					*********************************************************
					
					
					*		   'tmpPSItem'
					INSERT INTO tmpPSItem (PCs, SalesNum, SOItem, Alloy, Form, Heat, Lot, CC, CL;
						,DESCRIPT, AQDescript, Weight, Kg, PackWeight;
						,Dim1,Dim2,Dim3,RandLen,Metric,PO_num,PackingSli ;
						,PartNo,QTY,PU,SS_ID,tmpPSnum ;
						,TBL, SL_ID, SL_ID_D, ID_D_Proc, SL_P, SL_QTY, SOi_cmplt);
					VALUES (nPCs, nSalesNum, cSOitem, cAlloy,cForm,cHeat,cLot, cCC, cCL;
						,cDescription, cAQDescript, nWeight, lKg, nPackWeight;
						,nDim1,nDim2,nDim3,lRandLen,lMetric,cPO_num,0 ;
						,cPartNo,nQTY,nPU,nSS_ID,nTmpPSnum;
						,cTBL, nSL_ID, nSL_ID_D, nID_D_Proc, nSL_P, nSL_QTY, lComplete )
		
						*QTY and PU are Customer Units
						*SL_QTY and SL_P are ERP Acct Stnd
						*AQ_QTY is Customer				
					
					
					*DELETE FOR ID_D_Proc = nID_D_Proc AND SS_ID = nSS_ID AND SOitem=cSOitem AND LEN(AQDescript)>10 AND NOT DELETED() IN tmpPSItem 
												
					lInsertBasic = .F.
					LOOP			
				
					*StkBack has been removed and subtratracted from is non StkBack record.			
					*Consumed records have been Added to tmpPSItem
					* now add to tmpPSitem what best describes the Sales_Stock and actual Packing Slip item.
					
					
				ENDSCAN
				
				*mark these as DETELED because they are Redundant to records found in GRAB
				DELETE FOR NOT DELETED() IN tmpPSItem 
				
			ELSE
				lInsertBasic = .T.
				*tmpPSItemDetail Count = 0
			ENDIF
			
			USE IN tmpPSItemDetail
		ELSE
			*tmpPSItemDetail Count = 0
			lInsertBasic = .T.
		ENDIF
		
		********************************************************************
		
		PRIVATE lInsertSales_Stock
		lInsertSales_Stock = .F.
		*ThisForm.nSales_Stock_PS = 0
		*ldShip = PrepareSQLlogic(tmpSalesNum.dShip,'dShip')
		
		IF lInsertBasic   &&did not find SOitem in 'tmpPSItemDetail'
			** No Sales_Stock data record!!!
			*May be a service cut, never from stock!!!!
			IF AQ_SOitem_Cnt(cSOitem, ThisForm.nConnhandle, " SERVICES") > 0  &&Needs space on " SERVICES"
				*A Sales Order of Service does not use Stock!
			ELSE
				*Count AllQuotes with that SOitem 
				*tmpPSItemDetail Count = 0
				IF NOT ldShip 
					*SELECT COUNT(*) AS CNTD FROM dbo.Sales_Stock WHERE SOitem=' 130888-01' AND ISNULL(PS_Cncl,0)=1
					IF Count_Sales_Stock ( cSOitem, "PS_CNCL", ThisForm.nConnHandle ) > 0
						*Found a Canceled Packing Slip
					ELSE
						MESSAGEBOX("Did not find where the Shop has removed the Stock for this SOitem '"+cSOitem+"'!"+CHR(13)+"There is no listing in table dbo.Sales_Stock."+CHR(13)+"This material still needes to be removed from Inventory.",0+48,"No Shop entered Sales_Detail data.")
						*MESSAGEBOX("Did not find where the Shop has removed the Stock for this SOitem '"+cSOitem+"'!"+CHR(13)+"There is no 'HEAT' entry in table dbo.Sales_Stock."+CHR(13)+"Do you need to cancel a bad PackingSlip entry?",4+48,"No Shop Data.")
						*+CHR(13)+CHR(13)+"You will have to type in the Heat"+CHR(13)+"and the SOitem to Stock connection will be lost."
					ENDIF
				ENDIF
				
				cMess = "Did not find where the Shop has removed the Stock for this SOitem'"+cSOitem+"'!"
				cMess = cMess+CHR(13)+"This material still needes to be removed from Inventory."
				cMess = cMess+CHR(13)+"EmailRule:NotRevomedfromINV"+CHR(13)
				IF ldShip 
					cMess = cMess+CHR(13)+"This material is to be Direct Shipped."
				ENDIF
				
				IF Count_Sales_Stock ( cSOitem, "PS_CNCL", ThisForm.nConnHandle ) > 0
					cMess = cMess+CHR(13)+"There is a Cancelled PackingLsip entry in dbo.Sales_Stock."
				ELSE
					cMess = cMess+CHR(13)+"There is no entry in dbo.Sales_Stock."
				ENDIF
				TrackMess(cMess) &&only 1024 Characters
				
				cMess = cMess+CHR(10)+CHR(13) +"PackingSlip will add with Heat as: Shop did not create before PACKING!!"
				
				cMess = cMess+CHR(10)+CHR(13) +"SELECT * FROM dbo.Sales_Stock SS INNER JOIN dbo.AllQuotes AQ ON AQ.SOitem = SS.SOitem WHERE SS.SOitem = dbo.f_ProperSOitem('"+cSOitem+"') AND SS.Reconciled = 0 AND SS.PackingSli <= 0 "
				cMess = cMess+CHR(10)+CHR(13) +"View Sales Order Item here:"
				cMess = cMess+CHR(10)+CHR(13) +HTML_SOitem(cSOitem,.T.)
				*cMess = cMess+CHR(10)+CHR(13) +HTML_SOitem(cSOitem,.F.)
				
				cMess = cMess+CHR(10)+CHR(13) +"View Sales_Stock data for SOitem here:"
				cMess = cMess+CHR(10)+CHR(13) +HTML_Sales_Stock_SOitem(cSOitem,.T.)
				
				
				PRIVATE nCntSOitem
				nCntSOitem = Count_SOitem_PurchaseOrder(cSOItem, ThisForm.nConnHandle)
				IF nCntSOitem > 0
					cMess = cMess+CHR(10)+CHR(13) +"Found "+ALLTRIM(STR(nCntSOitem))+" PO items for this SOitem. Top 1 shown."
					cPOitem = GetPOitem_PurchaseOrder_SOitem( cSoItem, ThisForm.nConnHandle )
					cMess = cMess+CHR(10)+CHR(13) +HTML_POitem(cPOitem,.T.)
				ENDIF
				
				PRIVATE nCntPOitemR, nCntSOitemR 
				nCntPOitemR = 0 &&Count_POitem_Receiving( cPOitem, ThisForm.nConnHandle, "NotCancelled" )
				nCntSOitemR = Count_SOitem_Receiving( cSOitem, ThisForm.nConnHandle, "NotCancelled" )
				
				*Count_ReceivedPOItem 
				*Count_ReceivedSOItem 
				IF nCntPOitemR > 0
					cMess = cMess+CHR(10)+CHR(13) +"Found "+ALLTRIM(STR(nCntPOitemR))+" PO item records in Receiving table."
				ENDIF
				IF nCntSOitemR > 0
					cMess = cMess+CHR(10)+CHR(13) +"Found "+ALLTRIM(STR(nCntSOitemR))+" SO item records in Receiving table."
				ENDIF
				
				cMess = cMess+CHR(10)+CHR(13) +"Did not find where the Shop has removed Stock while doing Packing Slip."
				
				*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No Sales_Stock while doing PackingSlip! "+"'"+cSOitem+"'"+CHR(13)+cMess )
				TrackError(cMess,"No Sales_Stock for SOitem '"+cSOitem+"' when building the PackingSlip! ",PROGRAM(),LINENO(1))
				
				lInsertSales_Stock = .T.
			ENDIF
			
			PRIVATE cFormDescription
			lKg 		= PrepareSQLlogic(tmpSalesNum.Metric,'Metric')
			cDescription= THISFORM.f_description( cAlloy, tmpSalesNum.FORM, tmpSalesNum.THCK, tmpSalesNum.SZ2, tmpSalesNum.SZ3, tmpSalesNum.Weight, tmpSalesNum.Metric )
			cPO_Num		= tmpSalesNum.PO_num
			IF Proper_SO_Item(cSOItem) = Proper_SO_Item("")
				cPartNo		= ''
			ELSE
				cPartNo		= get_PartNoinSales(cSOitem,THISFORM.nConnHandle)
			ENDIF
			
			cAQDescript = PrepareSQLtxt(tmpSalesNum.Descript,'AQDescript',50)
						
			nWeight = PrepareSQLnum(tmpSalesNum.Weight,'LBS',7,1)
		
			************************************************************
			*Use cDescription to fill in Form, Dim1, Dim2, Dim3
			IF EMPTY(cForm) AND nDim1 = 0 AND NOT EMPTY(cDescription)
				PRIVATE cDescript
				cDescript	= cDescription
		
				PRIVATE cDim1, cDim2, cDim3, nFT, nInch
				IF AT(":",cDescript) > 0
					cFormDescription = LEFT(cDescript,AT(":",cDescript)-1)
					cForm = FormNumber_FormDescription(cFormDescription)
					cDescript = RIGHT(cDescript,LEN(cDescript)-1-AT(":",cDescript))
				ELSE
					DO CASE 
					CASE cDescript $ "Dia"
						cForm = 10
					CASE cDescript $ "Hex"
						cForm = 12
					CASE cDescript $ "Thck"
						cForm = 40
					CASE cDescript $ "OD"
						cForm = 60
					CASE cDescript $ "IPS"
						cForm = 65
					CASE cDescript $ "Mach"
						cForm = 90
					ENDCASE
				ENDIF
				cDim1 	= LEFT(cDescript,AT('"',cDescript)-1 )
				nDim1	= VAL(cDim1)
				cDescript = RIGHT(cDescript,LEN(cDescript)-1-AT("x",cDescript))
		
				nFT		= AT("FT",cDescript) 
				nInch 	= AT(["],cDescript)
				IF nFT > 0
					IF nInch > 0
						IF nFT < nInch
							*Use Foot
							cDim2 	= LEFT(cDescript,AT('FT',cDescript)-1 )
							nDim2	= VAL(cDim2)*12
						ELSE
							cDim2 	= LEFT(cDescript,AT('"',cDescript)-1 )
							nDim2	= VAL(cDim2)
						ENDIF
					ELSE
						*No inch, Use Foot
						cDim2 	= LEFT(cDescript,AT('FT',cDescript)-1 )
						nDim2	= VAL(cDim2)*12
					ENDIF
				ELSE
					*No Foot use inch
					cDim2 	= LEFT(cDescript,AT('"',cDescript)-1 )
					nDim2	= VAL(cDim2)
				ENDIF
		
				IF AT("x",cDescript) > 0
					*have 3rd dim
					cDescript = RIGHT(cDescript,LEN(cDescript)-1-AT("x",cDescript))
		
					nFT		= AT("FT",cDescript) 
					nInch 	= AT(["],cDescript)
					IF nFT > 0
						IF nInch > 0
							IF nFT < nInch
								*Use Foot
								cDim3 	= LEFT(cDescript,AT('FT',cDescript)-1 )
								nDim3	= VAL(cDim3)*12
							ELSE
								cDim3 	= LEFT(cDescript,AT('"',cDescript)-1 )
								nDim3	= VAL(cDim3)
							ENDIF
						ELSE
							*No inch, Use Foot
							cDim3 	= LEFT(cDescript,AT('FT',cDescript)-1 )
							nDim3	= VAL(cDim3)*12
						ENDIF
					ELSE
						*No Foot use inch
						cDim3 	= LEFT(cDescript,AT('"',cDescript)-1 )
						nDim3	= VAL(cDim3)
					ENDIF
				ELSE
					nDim3 = 0
				ENDIF
				*lRandLen	= PrepareSQLchk(tmpPSItemDetail.RandLen,'RandLen')
				lRandLen	= .F.
			ENDIF
			
			IF lInsertSales_Stock
			*Shop did not enter what Stock was used!!!!!
				*cSOitem
				PRIVATE nQTY_NEW, nStkPaid_P,nStkPaid_Total
				PRIVATE nPU_OLD,nPC_NEW,nDim1_NEW,nDim2_NEW,nDim3_NEW,nStockLst_LBS
				PRIVATE nID,nID_Detail,nID_Detail_Process
		
				nQTY_NEW	= nQTY
				nStockLst_P	= 0
				nStkPaid_P	= 0
				nStockLst_Total = 0
				nStkPaid_Total = 0
				nPU_OLD	= nPU
				nPC_NEW = nPcs
				nDim1_NEW = nDim1
				nDim2_NEW = nDim2
				nDim3_NEW = nDim3
				nStockLst_LBS = nWeight
		
				cTBL 	= ""
				nID		= 0
				nID_Detail	= 0
				nID_Detail_Process = 0
				*cAlloy,cForm,cCC,lRandLen
				cLot = ''
				cHeat	= PrepareSQLtxt("PackingSlip, Shop did not create Sales_Stock before PACKING!!","Heat",50,.F.,.T.) && Used in Check_PS_Entry  dbo.Sales_Stock
				*Heat	= '12345678901234567890123456789012345678901234567890' C50
				
				nTmpPSnum = 0 - VAL( SYS(2) ) &&Seconds since Midnight, more Random
				ThisForm.nSales_Stock_PS = nTmpPSnum 
				
			ENDIF
			
			
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpPSItem") FREE 
		*(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12), Form C(2),Heat C(50),Lot C(10),CC C(1), CL C(1)
		*,DESCRIPT C(80), AQDescript C(50), Weight N(9,1), Kg L,PackWeight N(7,1)
		*,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),RandLen L,Metric L, PO_num C(17), PackingSli N(10)
		*,PartNo C(100), QTY N(18,4), PU N(1), SS_ID N(10), tmpPSnum N(10)
		*,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4),SOi_cmplt L )
		
			SELECT tmpPSItem 
			INSERT INTO tmpPSItem (SalesNum, SOItem, PCs, Alloy, Form, Heat, Lot, CC, CL;
						,DESCRIPT, AQDescript, Weight, Kg, PackWeight ;
						,Dim1,Dim2,Dim3,RandLen,Metric,PO_num,PackingSli;
						,PartNo, QTY,PU,SS_ID,tmpPSnum;
						,TBL, SL_ID, SL_ID_D, ID_D_Proc, SL_P, SL_QTY, SOi_cmplt );
				VALUES ( nSalesNum, cSOitem, m.nPcs,cAlloy,cForm,cHeat,cLot,cCC,cCL;
						,cDescription, cAQDescript, nWeight, lKg, nPackWeight ;
						,nDim1, nDim2, nDim3, lRandLen, lMetric, cPO_Num,0 ;
						,cPartNo,nQTY,nPU,0,0;
						,'', 0, 0, 0, 0, 0, lComplete )
						
						*QTY and PU are Customer Units
						*SL_QTY and SL_P are ERP Acct Stnd  &&each heat line on PackingSli QTY
						*AQ_QTY is Customer	
			
			DELETE FOR NOT DELETED() IN tmpPSItem 
			
		ENDIF
		
		********************************************************************
		
		** collect data from lst_Proccess_Grab and insert into tmpPSItem
		IF USED("tmpPSItemGrab")	
			USE IN tmpPSItemGrab
		ENDIF 
		SELECT 0
		
		
		cSQL = "SELECT * FROM dbo.vLst_Process_Grab "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*dbo.StockLst_Process_Grab
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPSItemGrab')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'tmpPSItemGrab')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSItemGrab')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSItemGrab')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemGrab")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemGrab")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError( cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpPSItemGrab' )
		ENDIF
		IF USED('tmpPSItemGrab')
			SELECT tmpPSItemGrab
			IF RECCOUNT('tmpPSItemGrab')>0
				****************************************************	
				*insert into 'tmpPSItem'
				****************************************************	
				SELECT tmpPSItemGrab
				SCAN
				
					nPCs			= PrepareSQLnum(tmpPSItemGrab.Prc_PCs,'Prc_PCs',-3)
					nSalesNum		= PrepareSQLnum(tmpPSItemGrab.SalesNum,'SalesNum',-3)
					cSOitem			= ShowSQLtxt(tmpPSItemGrab.SOitem,'SOitem',10)
					cAlloy			= ShowSQLtxt(tmpPSItemGrab.Alloy,'Alloy',12)
					cForm			= ShowSQLtxt(tmpPSItemGrab.Prc_Form,'Form',2)
					cHeat			= ShowSQLtxt(tmpPSItemGrab.Heat,'Heat',50)
					cLot			= ShowSQLtxt(tmpPSItemGrab.Lot,'Lot',10)
					cCC				= ShowSQLtxt(tmpPSItemGrab.CC,'CC',1)
					cCL				= ShowSQLtxt(tmpPSItemGrab.CL,'CL',1)
					cDescription	= ShowSQLtxt(tmpPSItemGrab.Descript,'Descript',100)
					cAQDescript		= "from Grab"
					nWeight			= PrepareSQLnum(tmpPSItemGrab.Pounds,'Pounds',8,1)		&&Pweight is gone
					*lKg
					*nPackWeight
					nDim1			= PrepareSQLnum(tmpPSItemGrab.Prc_Dim1,'Dim1',9,4)
					nDim2			= PrepareSQLnum(tmpPSItemGrab.Prc_Dim2,'Dim2',8,3)
					nDim3			= PrepareSQLnum(tmpPSItemGrab.Prc_Dim3,'Dim3',8,3)
					*lRandLen
					*lMetric
					*cPO_num
					*cPartNo
					nQTY			= PrepareSQLnum(tmpPSItemGrab.QTY,'QTY',-3)
					nPU				= PrepareSQLnum(tmpPSItemGrab.PU,'PU',-1)
					nSS_ID			= get_SS_IDfrom_ID_D_P( tmpPSItemGrab.TBL, tmpPSItemGrab.ID_Detail_Process, ThisForm.nConnHandle )
					nTmpPSnum=0
					cTBL			= ShowSQLtxt(tmpPSItemGrab.TBL,'TBL',1)
					nSL_ID 			= PrepareSQLnum(tmpPSItemGrab.ID_Master,'ID',-3)
					nSL_ID_D		= PrepareSQLnum(tmpPSItemGrab.ID_Detail,'ID_Detail',-3)
					nID_D_Proc		= PrepareSQLnum(tmpPSItemGrab.ID_Detail_Process,'ID_Detail_Process',-3)
					nSL_P 			= PrepareSQLnum(tmpPSItemGrab.S_P,'S_P',-5)
					nSL_QTY			= PrepareSQLnum(tmpPSItemGrab.QTY,'S_QTY',-5)		
					*lComplete
						
					INSERT INTO tmpPSItem (PCs, SalesNum, SOItem, Alloy, Form, Heat, Lot, CC, CL;
						,DESCRIPT, AQDescript, Weight, Kg, PackWeight;
						,Dim1,Dim2,Dim3,RandLen,Metric,PO_num,PackingSli ;
						,PartNo,QTY,PU,SS_ID,tmpPSnum ;
						,TBL, SL_ID, SL_ID_D, ID_D_Proc, SL_P, SL_QTY, SOi_cmplt);
					VALUES (nPCs, nSalesNum, cSOitem, cAlloy,cForm,cHeat,cLot, cCC, cCL;
						,cDescription, cAQDescript, nWeight, lKg, nPackWeight;
						,nDim1,nDim2,nDim3,lRandLen,lMetric,cPO_num,0 ;
						,cPartNo,nQTY,nPU,nSS_ID,nTmpPSnum;
						,cTBL, nSL_ID, nSL_ID_D, nID_D_Proc, nSL_P, nSL_QTY, lComplete )
					
					lInsertBasic = .F.
				ENDSCAN
			USE IN tmpPSItemGrab
			ENDIF
		ENDIF
						
		
		
		
		*********************************
		*Rewrite Desription for Packing Slip Style
		PRIVATE cFormDescription, cDescript 
		
		SELECT tmpPSItem
		GO TOP
		SCAN
			IF NOT EMPTY(tmpPSItem.Form)  &&Why does Sales_Stock not have Form????
				cFormDescription = ALLTRIM(FormDescription(tmpPSItem.Form, tmpPSItem.Dim1))
				cDescript = ItemDescriptionMetric(tmpPSItem.Form, tmpPSItem.Dim1, tmpPSItem.Dim2, tmpPSItem.Dim3, tmpPSItem.Weight, tmpPSItem.RandLen, tmpPSItem.Metric)
				cDescript = PADL(TRIM(cFormDescription),11)+': '+cDescript
		
				REPLACE tmpPSitem.Descript	WITH cDescript 
			ENDIF
		ENDSCAN
		
		**********************************************
		**********************************************
		* Open the Detail window
		**********************************************
		
		SELECT tmpPSItem &&PSitemDeail screen Saves tmpPSItem to PackingSlipItem 
		GO TOP
		
		
		PRIVATE ReturnLPosted
		IF FILE('PSItemDetail.SCX')
			DO FORM Forms\PSItemDetail TO ReturnLPosted
		ELSE
			IF FILE('Forms\PSItemDetail.SCX')
				DO FORM Forms\PSItemDetail TO ReturnLPosted
			ELSE
				IF FILE('\Program Files\VFP\PackingSlip\PSItemDetail.SCX')
					DO FORM '\Program Files\VFP\PackingSlip\PSItemDetail' TO ReturnLPosted
				ELSE
					IF FILE('\Program Files\HPA\Forms\PSItemDetail.SCX')
						DO FORM '\Program Files\HPA\Forms\PackingSlip\PSItemDetail' TO ReturnLPosted
					ELSE
						WAIT WINDOW 'NotFound'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************************
		**********************************************
		* Deal with Returned Value
		**********************************************
		
		IF Left(ReturnLPosted,1) = "1"
			SELECT tmpSalesNum
			REPLACE tmpSalesNum.Posted WITH "Y"
			
			PRIVATE cPartNo1,cPartNo2,cPartNo3
			cPartNo  = ALLTRIM(RIGHT(ReturnLPosted,LEN(ReturnLPosted)-1))
			cPartNo1 = ALLTRIM(ShowSQLtxt(RIGHT(ReturnLPosted,LEN(ReturnLPosted)-1),'PartNo',100))
			cPartNo2 = ALLTRIM(ShowSQLtxt(tmpPSItem.PartNo,'PartNo',100))
			cPartNo3 = ALLTRIM(ShowSQLtxt(PackingSlipItem.PartNo,'PartNo',100))
			
			
			DO CASE
			CASE EMPTY(cPartNo1)
				IF NOT EMPTY(cPartNo2)
					cPartNo = cPartNo2
					TrackError( CHR(13)+" cPartNo1 was empty, cPartNo was set to "+cPartNo2+".","EMPTY(cPartNo1)",PROGRAM(),LINENO(1) )
				ELSE
					IF NOT EMPTY(cPartNo3)
						cPartNo = cPartNo3
						TrackError(CHR(13)+" cPartNo1 was empty, cPartNo was set to "+cPartNo3, "EMPTY(cPartNo1)",PROGRAM(),LINENO(1) )
					ENDIF
				ENDIF	
			CASE cPartNo1 != cPartNo2
				IF NOT EMPTY(cPartNo2)
					cPartNo = cPartNo2
					TrackError( CHR(13)+" cPartNo was set to "+cPartNo2+"."+CHR(13)+"cPartNo1 is "+cPartNo1,"cPartNo1 != cPartNo2",PROGRAM(),LINENO(1) )			
				ENDIF
			CASE cPartNo1 != cPartNo3
				IF NOT EMPTY(cPartNo3)
					cPartNo = cPartNo3
					TrackError( CHR(13)+" cPartNo1 != cPartNo3)","cPartNo was set to "+cPartNo3,PROGRAM(),LINENO(1) )			
				ENDIF
			CASE cPartNo2 != cPartNo3
				IF NOT EMPTY(cPartNo2) AND NOT EMPTY(cPartNo3)
					TrackError( CHR(13)+" cPartNo1 is "+cPartNo1+"." +CHR(13)+ " cPartNo2 is "+cPartNo2+"." +CHR(13)+" cPartNo3 is "+cPartNo3,"cPartNo2 != cPartNo3",PROGRAM(),LINENO(1) )			
				ENDIF
			OTHERWISE
				*TrackError( "cPartNo1 is "+cPartNo1 +CHR(13)+ " cPartNo2 is "+cPartNo2 +CHR(13)+" cPartNo3 is "+cPartNo3,"OTHERWISE",PROGRAM(),LINENO(1) )			
			ENDCASE
			
			
			*Save to tmpSales to be tranfered to Sales after print
			IF NOT USED('tmpSales')
				SELECT 0
				*PRIVATE cFileName
				*cFileName = SYS(3)
				*cFileName = 'Sal_' + cFileName
				ThisForm.Uniq_SAL = UniqDBF(ThisForm.Uniq_SAL)
				
				IF "\MEM" $ SYS(2003)
					CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_SAL) ) FREE ;
						(SOItem C(10), SalesNum N(7,0), PartNo C(100), blind L , FaxConf L , EmailConf L, ShipRoute C(20) )
						
					USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_SAL) EXCL ALIAS tmpSales
				ELSE
					CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(ThisForm.Uniq_SAL) ) FREE ;
						(SOItem C(10), SalesNum N(7,0), PartNo C(100), blind L , FaxConf L , EmailConf L, ShipRoute C(20) )
						
					USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.Uniq_SAL) EXCL ALIAS tmpSales
				ENDIF
				
				
				*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpSales") FREE (SOItem C(10), SalesNum N(7,0), PartNo C(100), blind L , FaxConf L , EmailConf L, ShipRoute C(20) )
				SELECT tmpSales
				*USE tmpSales EXCLUSIVE
			ENDIF
			INSERT INTO tmpSales (SOItem, salesnum, PartNo ); 
				VALUES (tmpSalesNum.SOItem, tmpSalesNum.Salesnum, cPartNo )
				&&blind, FaxConf, EmailConf
			*Any tmpSales Code should be also done in
			*	This.Parent.Parent.pg_add_item.cmdAdd
		ELSE
			*MESSAGEBOX("Did not receive a PartNumber- Abort",0+48,"Add SOitem must have aborted.")
			WAIT WINDOW "Add SOitem must have aborted." NOWAIT
		ENDIF
		
		*PSitemDeail screen Saves tmpPSItem to PackingSlipItem table
		
		THIS.PARENT.grdInq.REFRESH()
		
		THISFORM.EnablePrint()
		
		
	ENDPROC

