				cSOitem = PrepareSQLtxt(PackingSlipItem.SOitem,'SOitem',10)
				cTBL	= PrepareSQLtxt(PackingSlipItem.TBL,'TBL',1)
				nSL_ID	= PrepareSQLnum(PackingSlipItem.SL_ID,'ID',-3)				&&StockLst ID
				nSL_ID_D	= PrepareSQLnum(PackingSlipItem.SL_ID_D,'ID_Detail',-3)	&&StockLst ID_Detail
				nID_D_Proc	= PrepareSQLnum(PackingSlipItem.ID_D_Proc,'ID_Detail_Proc',-3)
				
				
				PRIVATE nSD_ID 
				*nSD_ID = get_SD_ID(cSOitem,cTBL,nSL_ID,nSL_ID_D,nID_D_Proc, ThisForm.nConnHandle)
				nSD_ID = get_SD_IDfrom_ID_D_P(cTBL,nID_D_Proc, ThisForm.nConnHandle)
				
				* ID from dbo.Sales_Detail for cTBL,nID,nID_Detail,nID_D_P
				*TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4)
				
				IF nSD_ID > 0
					*SAVE PackingSli TO Sales_Detail
					**Update with correct PackingSli
					
					cSQLu = "UPDATE dbo.Sales_Detail SET "
					cSQLu = cSQLu + " ID_Packing="+STR(nID_Packing)
					cSQLu = cSQLu + ",PackingSli="+STR( nPS_NO )
					*cSQLu = cSQLu + " WHERE ID ="+STR(nSD_ID)	&&Multiple ID's for same Process
					cSQLu = cSQLu + " WHERE TBL = '"+cTBL+"'"
					*cSQLu = cSQLu + " AND ID = "+STR(nSD_ID)
					*cSQLu = cSQLu + " AND StockLst_ID = "+STR(nSL_ID)
					cSQLu = cSQLu + " AND StockLst_ID_Detail = "+STR(nSL_ID_D)
					
					
		*			cSQLu = cSQLu + " AND ID_Detail_Process = "+STR(nID_D_Proc) &&why is Process number OFF?
		*			cSQLu = cSQLu + " AND SOitem = '"+cSOitem+"'"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
						TrackError(cSQLu,"SAVE TO Sales_Detail",PROGRAM(),LINENO(1) )
					ENDIF
					
					*Save nSD_ID TO dbo.PackingSlip
					
				ELSE
					*Make a Sales_Detail_PackingSlip record to save the PackingSli number.
					*Screen Modify_StockLst_Detail needs to check that PackingSlip may have already been run.
					
					cSQLu = "INSERT INTO dbo.Sales_Detail_PackingSlip "
					cSQLu = cSQLu + " (ID_Packing,PackingSli,SOitem,SalesNum,Descript,QTY,Pieces,Pounds,Heat,dShip) VALUES "
					cSQLu = cSQLu + " ("+STR(nID_Packing)
					cSQLu = cSQLu + ","+STR( nPS_NO )
					cSQLu = cSQLu + ", '"+PrepareSQLtxt(PackingSlipItem.SOitem,'SOitem',10)+"'"
					cSQLu = cSQLu + ", "+STR(PrepareSQLnum(PackingSlipItem.SalesNum,'SalesNum',-3))
					cSQLu = cSQLu + ","+"LEFT( dbo.f_DescriptCL("
					cSQLu = cSQLu + 	" '"+PrepareSQLtxt(PackingSlipItem.Alloy,'Alloy',12)+"'"
					cSQLu = cSQLu + 	",'"+PrepareSQLtxt(PackingSlipItem.CC,'CC',1)+"'"
					cSQLu = cSQLu + 	",'"+PrepareSQLtxt(PackingSlipItem.CL,'CL',1)+"'"
					cSQLu = cSQLu + 	",'"+PrepareSQLtxt(PackingSlipItem.Form,'Form',2)+"'"
					cSQLu = cSQLu + 	", "+STR(PrepareSQLnum(PackingSlipItem.Dim1,'Thck',10,4),10,4)
					cSQLu = cSQLu + 	", "+STR(PrepareSQLnum(PackingSlipItem.Dim2,'Sz2',9,3),9,3)
					cSQLu = cSQLu + 	", "+STR(PrepareSQLnum(PackingSlipItem.Dim3,'Sz3',9,3),9,3)
					cSQLu = cSQLu + 	", "+STR(PrepareSQLnum(PackingSlipItem.Weight,'Pounds',9,1),9,1)
					cSQLu = cSQLu + 	", '0'"	&&+PackingSlipItem.RandLen
					cSQLu = cSQLu + ") ,100)"
					cSQLu = cSQLu + ", "+STR(PrepareSQLnum(PackingSlipItem.QTY,'QTY',-5),18,4)
					cSQLu = cSQLu + ", "+STR(PrepareSQLnum(PackingSlipItem.PCs,'Pieces',-3))
					cSQLu = cSQLu + ", "+STR(PrepareSQLnum(PackingSlipItem.Weight,'Pounds',9,1),9,1)
					cSQLu = cSQLu + ",'"+PrepareSQLtxt(PackingSlipItem.Heat,'Heat',50)+"'"
					cSQLu = cSQLu + ","+IIF(ldShip,'1','0')	&&DirectShip
					cSQLu = cSQLu + " )"
		
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"PackingSlip Print "+ALLTRIM(STR(nPS_NO))+CHR(13)+cSQLu)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
						TrackError(cSQLu ,"SAVE TO Sales_Detail_PackingSlip",PROGRAM(),LINENO(1) )
					ENDIF			
				ENDIF
						
				*********************************************************
				*--Middle of Scan PackingSlipItem
				
				*Save to Sales_Status
				Save_SOitem_Status( cSOItem, PackingSlipItem.SalesNum, "PackingSLP", "Packaged "+ALLTRIM(STR(PackingSlipItem.pcs))+"PC Heat:"+ALLTRIM(PackingSlipItem.Heat)+" "+ALLTRIM(STR(PackingSlipItem.Weight))+" Lbs.", ThisForm.nConnHandle )
				
				*Insert into dbo.Sales_Status
				*Insert_Sales_Status(cSOItem, PackingSlipItem.SalesNum,"PackingSLP", "Packaged "+ALLTRIM(STR(PackingSlipItem.pcs))+"PC Heat:"+ALLTRIM(PackingSlipItem.Heat)+" "+ALLTRIM(STR(PackingSlipItem.Weight))+" Lbs."
				
				*****************
				IF nPrintStdTerm = 0
					
					IF USED('Sales_No_PayType')
						SELECT Sales_No_PayType
					ELSE
						SELECT 0
					ENDIF
					
		*			cSQL = "SELECT COUNT(SalesNum) AS CNTD FROM dbo.Sales_No "
					cSQL = "SELECT ISNULL(PayType,'') AS PayType FROM dbo.Sales_No "
					cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(PackingSlipItem.SalesNum))
		*			cSQL = cSQL + " AND NOT (PayType ='STD TERMS' OR PayType ='CANADA STD' OR PayType ='FOREIGNSTD')"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No_PayType')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Sales_No_PayType')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'Sales_No_PayType')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'Sales_No_PayType')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No_PayType")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No_PayType")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Sales_No_PayType' )
					ENDIF
					
					IF USED('Sales_No_PayType')
						IF RECCOUNT('Sales_No_PayType') > 0
							IF NOT (PayType ='STD TERMS' OR PayType ='CANADA STD' OR PayType ='FOREIGNSTD')
								MESSAGEBOX("PayType is:"+Sales_No_PayType.PayType+CHR(13)+"Alert the Card processor if this is a Credit Card",64,"Caution -Not Standard Terms")
							ELSE
								nPrintStdTerm = 1
							ENDIF
						ENDIF
		*				IF Sales_No_PayType.CNTD > 0
		*					MESSAGEBOX("Alert the Card processor if this is a Credit Card",64,"Caution -Not Standard Terms")
		*					nPrintStdTerm = 1
		*				ENDIF
						USE IN Sales_No_PayType
					ENDIF		
				ENDIF
				
				***********************************
				*--Middle of Scan PackingSlipItem
		*!*			IF PrepareSQLlogic(PackingSlipItem.SOi_cmplt,'SOi_cmplt') = .F.
		*!*				*Show another screen to verify wether it is complets!
		*!*				**Show Item detail screen to review Quotes to pacing slip shipped, before saving!
		*!*				PRIVATE nReturn
		*!*				nReturn = 0
		*!*				DO FORM Forms\Show_Ship_Order WITH "SOitem",cSOitem to nReturn
		*!*					*nReturn=1 Not Complete
		*!*					*nReturn=2 Complete
		*!*					*nReturn=3 Just view
		*!*					*nReturn=4 Saved as Complete
		*!*					
		*!*				nReturn = PrepareSQLnum(nReturn,'nReturn',-3)
		*!*				IF nReturn = 4
		*!*					TrackMess("SOitem:"+cSOItem+" has a packing Slip "+ALLTRIM(STR(nPS_NO))+", but was not marked as 'Complete' untill 'Show_Ship_Order' was run. Sent "+ALLTRIM(STR(PackingSlipItem.PCs))+" Pcs.")
		*!*				ENDIF
		*!*			ENDIF
				
				IF PrepareSQLlogic(PackingSlipItem.SOi_cmplt,'SOi_cmplt') = .T.
					*update the three stock types.
					IF StockLst_Process_Count_SOitem( cSOitem, 'S', ThisForm.nConnHandle, "SELECTED") > 0
		
						cSQLu = "UPDATE dbo.StockLst_Process "
						cSQLu = cSQLu +" SET Process_ID = 'Shipped' "
						cSQLu = cSQLu +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						cSQLu = cSQLu +" AND Process_ID = 'SELECTED  '"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQLu , ThisForm.nConnHandle, nSQLEXEC,'' )
						ELSE
							TrackMess("SOitem: "+cSOitem+" is listed as Complete by PackingSlip "+STR(nPS_NO)+" dbo.StockLst_Process was UPDATED from 'SELECTED' to 'SHIPPED'" )
						ENDIF
					ENDIF
					***
					IF StockLst_Process_Count_SOitem( cSOitem, 'B', ThisForm.nConnHandle, "SELECTED") > 0
		
						cSQLu = "UPDATE dbo.BrokerLst_Process "
						cSQLu = cSQLu +" SET Process_ID = 'Shipped' "
						cSQLu = cSQLu +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						cSQLu = cSQLu +" AND Process_ID = 'SELECTED  '"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQLu , ThisForm.nConnHandle, nSQLEXEC,'' )
						ELSE
							TrackMess("SOitem: "+cSOitem+" is listed as Complete by PackingSlip "+STR(nPS_NO)+" dbo.BrokerLst_Process was UPDATED from 'SELECTED' to 'SHIPPED'" )
						ENDIF
					ENDIF
					***
					IF StockLst_Process_Count_SOitem( cSOitem, 'W', ThisForm.nConnHandle, "SELECTED") > 0
		
						cSQLu = "UPDATE dbo.WIPLst_Process "
						cSQLu = cSQLu +" SET Process_ID = 'Shipped' "
						cSQLu = cSQLu +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						cSQLu = cSQLu +" AND Process_ID = 'SELECTED  '"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQLu , ThisForm.nConnHandle, nSQLEXEC,'' )
						ELSE
							TrackMess("SOitem: "+cSOitem+" is listed as Complete by PackingSlip "+STR(nPS_NO)+" dbo.WIPLst_Process was UPDATED from 'SELECTED' to 'SHIPPED'" )
						ENDIF
					ENDIF
					***
					
					Save_SOitem_Status( cSOItem, PackingSlipItem.SalesNum, "Complete", "Package Complete.", ThisForm.nConnHandle )			
					
				ELSE
					* NOT PackingSlipItem.COMPLETE
							
					TrackMess("SOitem:"+cSOItem+" was shipped, but not 'Complete'. Sent "+ALLTRIM(STR(nPS_NO))+' '+ALLTRIM(STR(PackingSlipItem.PCs))+" Pcs.")
					*SUM the SL_QTY for lineHeat SOitem
					Save_SOitem_Status( cSOItem, PackingSlipItem.SalesNum, "INComplete", "Packing slip states item as incomplete. "+ALLTRIM(STR(nPS_NO))+' ', ThisForm.nConnHandle )
					
					*Email_PS_SONotComplete( cSOItem, PackingSlipItem.PCs, nPS_No, ThisForm.nConnHandle)
					*Email_PS_SO_Not_Complete( cSOItem, PackingSlipItem.SL_QTY, nPS_No, ThisForm.nConnHandle)
					Email_PS_SOi_NotComplete( cSOItem, PackingSlipItem.SL_QTY, nPS_No, ThisForm.nConnHandle)
				ENDIF
				
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					IF Is_SOitem_OnHold( cSOitem, "ANY", ThisForm.nConnhandle)
						*MESSAGEBOX("This SOitem '"+cSOitem+"' is OnHold"+CHR(13)+"You can continue, but this will be record!",32,"Continue")
						PRIVATE cComment, nSalesNum, cSalesRep, cEmailTo, lOK
						cComment = "The SOitem '"+cSOitem+"' is OnHold and Packing Slip is #"+ALLTRIM(STR(nPS_NO))+" "
						cComment = cComment+CHR(13)+"Company "+PrepareSQLtxt(SoldAddr.Company,'Company',30)
						TrackMess(cComment +CHR(13)+SYS(16,1))
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cComment) 
						
						nSalesNum = Proper_SO_Item_SO(cSOitem)
						Track_Sales_No_Chng(cComment,nSalesNum,0,0)
						
						cComment = cComment+ CHR(13)+HTML_SOitem(cSOitem,.T.)+CHR(13)+HTML_PackingSlipNo(nPS_NO,.T.)
						
						cSalesRep = SalesRepfromSO(nSalesNum)
						IF Chatter(cSalesRep,cComment,ThisForm.nConnHandle)
		*!*						IF Is_SOitem_OnHold( cSOitem, "QA", ThisForm.nConnhandle)
		*!*							lOK = Save_SOitem_Hold_Status( cSOitem, nSalesNum, "QA", .F., "Packing Slip created while on QA hold", cComment, ThisForm.nConnhandle)
		*!*						ENDIF
		*!*						IF Is_SOitem_OnHold( cSOitem, "AR", ThisForm.nConnhandle)
		*!*							lOK = Save_SOitem_Hold_Status( cSOitem, nSalesNum, "AR", .F., "Packing Slip created while on AR hold", cComment, ThisForm.nConnhandle)
		*!*						ENDIF
		*!*						IF Is_SOitem_OnHold( cSOitem, "CSTR", ThisForm.nConnhandle)
		*!*							lOK = Save_SOitem_Hold_Status( cSOitem, nSalesNum, "CSTR", .F., "Packing Slip created while on Customer hold", cComment, ThisForm.nConnhandle)
		*!*						ENDIF
						ENDIF
						
						
						*Send SaleRep an Email
						cEmailTo = AppSetup_Get_Email(cSalesRep)
						lOK = Send_HTML_Email("AP@SpaceAlloysUSA.com",cEmailTo, "Created the Packing Slip while OnHold", cComment+CHR(13)+"Do you need to stop this shipment?"+CHR(13)+"If the need to Hold is off, you will need to remove the hold here:"+CHR(13)+"http://raptor/ReportServer?%2FSales%20Reports%2FOn%20HOLD%20Sales%20-%20Summary&rs%3AParameterLanguage=en-US", ThisForm.nConnHandle, .T., .F.)
					ENDIF
				ENDIF
				
				*IF PrepareSQLlogic(PackingSlipItem.SOi_cmplt,'SOi_cmplt') = .T.			
					*lOK = set_rtr_Oper ('SOi',cSOitem,190,522,"SOitem:"+cSOitem+" Modified this Stock. "+cMess,.T.,ThisForm.nConnHandle)
				*ELSE
					*lOK = set_rtr_Oper ('SOi',cSOitem,190,522,"SOitem:"+cSOitem+" Modified this Stock. "+cMess,.T.,ThisForm.nConnHandle)
				*ENDIF
				
				PRIVATE cMess
				cMess =         "ID_PS:"+ALLTRIM(STR(nID_Packing))
		*		cMess = cMess + " PS_N:"+ALLTRIM(STR(PackingSlipItem.PackingSli))
				cMess = cMess + " Q:"+ALLTRIM(STR(PackingSlipItem.SL_QTY,18,4))  && QTY/heat line ACCT Stnd
				cMess = cMess + " P:"+ALLTRIM(STR(PackingSlipItem.SL_P,18,4))  	 &&[Acct_P]
				cMess = cMess + " T:"+PackingSlipItem.TBL
				cMess = cMess + " ID_D:"+ALLTRIM(STR(PackingSlipItem.SL_ID))		&&[ID_Detail]
				cMess = cMess + " SS_ID:"+ALLTRIM(STR(PackingSlipItem.SS_ID))		&&Sales_Stock_ID
				
				lOK = set_rtr_Detail_Oper('SOi',cSOitem,190,522,cMess,.T.,ThisForm.nConnHandle)
				
				*--End Scan PackingSlipItem		
			ENDSCAN  &&PackingSlipItem
		
