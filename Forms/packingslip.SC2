	PROCEDURE pf1.pgItems.Init
		SELECT PackingSlipItem
		SET ORDER TO PackingSli
		
		ZAP
		INSERT INTO PackingSlipItem ;
			(SalesNum, SOItem, PCs, Alloy, Form, Heat, CC, CL;
			,DESCRIPT, Weight, Kg, PackWeight;
			,Dim1,Dim2,Dim3,RandLen,Metric, PO_num, PackingSli;
			,PartNo, QTY;
			,PU, SS_ID, tmpPSnum, SOi_cmplt ;
			,TBL, SL_ID, SL_ID_D, ID_D_Proc, SL_P, SL_QTY ); &&ERP Acct Standard
		VALUES ;
			(0,'',0,'','','','','';
			,'',0,.F.,0;
			,0,0,0,.F.,.F.,'',0;
			,'',0;
			,0,0,0,.F. ;
			,'',0,0,0,0,0)
		
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"PackingSlipItem") FREE ;
		*(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12), Form C(2), Heat C(50), CC C(1), CL C(1), DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
		*,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),RandLen L,Metric L, PO_num C(17), PackingSli N(10);
		*,PartNo C(100), N(10), QTY N(18,4), PU N(1), SS_ID N(10), tmpPSnum N(10), SOi_cmplt L ;
		*,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4))
		This.pf_SO_Items.pg_selected.grdItem.RecordSource = "PackingSlipItem"
		
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.Click
		IF EMPTY(THIS.txtSO.VALUE)
			IF USED('PackingSlipSO')
				IF PackingSlipSO.SO > 0
					THIS.txtSO.VALUE = STR(PackingSlipSO.SO,7,0)
				ELSE
					This.txtSO.Value = ThisForm.nSO
				ENDIF
			ELSE
				This.txtSO.Value = ThisForm.nSO
			ENDIF
		ENDIF
		
		IF EMPTY(THIS.txtItem.VALUE)
			THIS.txtItem.VALUE = "1"
		ENDIF
		
		IF EMPTY(THIS.txtPO_Num.VALUE)
			IF USED('PackingSlipPO')
				IF NOT EMPTY(PackingSlipPO.PO)
					THIS.txtPO_Num.VALUE = PackingSlipPO.PO
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
		
		THIS.txtSO.ZORDER()
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CC
		
		
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmbCC.InteractiveChange
		PRIVATE cCC
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		
		This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmbCC.LostFocus
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Parent.cmbCL.Value = cCL1
		
		IF ThisForm.CC != PrepareSQLtxt(This.Value,'CC',1)
			ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
			This.Parent.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgItems.pf_SO_Items.pg_add_item.cmbCC.Valid
		PRIVATE cForm
		cForm = This.parent.cmbForm.Value
		
		ThisForm.RefreshForms( cForm )
	ENDPROC

