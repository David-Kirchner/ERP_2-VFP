	PROCEDURE pf1.pgFreight.cmdClearSold.Click
		PRIVATE lcMessAns, mHoldRecordNum 
		lcMessAns = 6
		
		IF THISFORM.SoldAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			IF THISFORM.Bill3Addr <> 0
				THISFORM.Bill3Addr = 0
				THISFORM.AddressScreen("Bill3ToSave")
			ENDIF
		
			THIS.PARENT.cmdSearchSoldTo.ENABLED = .T.
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
			THIS.PARENT.txtBill3Code.Value	= 0
			THISFORM.AddressScreen("Bill3ToEdit")
		ELSE
			IF THIS.PARENT.cmdEditSoldTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
					
		*			DIMENSION aSoldAddr(1,13)
		*			SELECT SoldCode,Company,Addr1,Addr2,City,ST,Zip,Country,Contact,Telephone,Fax_Number,Email,LastEdit ;
		*				FROM HPA!SoldAddr ;
		*				INTO ARRAY aSoldAddr ;
		*				WHERE SoldAddr.SoldCode = THISFORM.SoldAddr
					IF USED( 'tSoldAddr' )
						USE IN tSoldAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.SoldAddr"
					cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(THISFORM.SoldAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tSoldAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tSoldAddr')
					ENDIF
					
					
					IF USED('tSoldAddr')
		
						THIS.PARENT.txtBill3Code.VALUE = tSoldAddr.SoldCode
						THIS.PARENT.txtCompany.VALUE = tSoldAddr.Company
						THIS.PARENT.txtAddr1.VALUE = tSoldAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE = tSoldAddr.Addr2
						THIS.PARENT.txtCity.VALUE = tSoldAddr.City
						THIS.PARENT.txtST.VALUE = tSoldAddr.ST
						THIS.PARENT.txtZip.VALUE = tSoldAddr.Zip
						THIS.PARENT.txtCountry.VALUE = tSoldAddr.Country
						THIS.PARENT.txtContact.VALUE = tSoldAddr.Contact
						THIS.PARENT.txtPhone.VALUE = tSoldAddr.Telephone
						THIS.PARENT.txtFax.VALUE = tSoldAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE = tSoldAddr.Email
						THIS.PARENT.txtLastEdit.VALUE = CTOD(DTOC(tSoldAddr.LastEdit))
					
						USE IN tSoldAddr
					ENDIF		
							
					THISFORM.AddressScreen("Bill3ToEdit")
					
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf1.pgFreight.cmdEditSoldTo.Click
		PRIVATE	maxSoldCode, maxShipCode, oldSoldCode, msettalk
		PRIVATE SaveAddr, SaveAddress 
		SaveAddr = .F.
		oldSoldCode = 0
		IF This.Caption = "Save"
			** Do you have anything to save?
			SaveAddress = .T.
			IF EMPTY(This.Parent.txtCompany.Value)
				Messagebox("Cannot save without an Company name!")
				SaveAddress = .F.
			ENDIF
			IF SaveAddress
			****** big save procedure********
			*	Get maxSoldCode
				maxSoldCode = ThisForm.maxSoldCode()
				maxShipCode = ThisForm.MaxShipCode()
				
				maxSoldCode= MAX( maxSoldCode, maxShipCode )
				maxSoldCode = maxSoldCode + 2 &&leave space for Shipto Edits 
		
				IF ThisForm.SoldAddr > 0
		
					IF USED( 'tSoldAddr' )
						USE IN tSoldAddr
					ENDIF
					SELECT 0
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.SoldAddr"
					cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(thisform.SoldAddr)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tSoldAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tSoldAddr')
					ENDIF
					IF USED( 'tSoldAddr' )
						IF THISFORM.SoldAddr = tSoldAddr.SoldCode AND ;
							NVL(This.parent.txtBill3Code.VALUE,0) = NVL(tSoldAddr.SoldCode,0) AND ;
							NVL(THIS.PARENT.txtCompany.VALUE,'') = NVL(tSoldAddr.Company,'') AND ;
							NVL(THIS.PARENT.txtAddr1.VALUE,'') = NVL(tSoldAddr.Addr1,'') AND ;
							NVL(THIS.PARENT.txtAddr2.VALUE,'') = NVL(tSoldAddr.Addr2,'') AND ;
							NVL(THIS.PARENT.txtCity.VALUE,'') = NVL(tSoldAddr.City,'') AND ;
							NVL(THIS.PARENT.txtST.VALUE,'') = NVL(tSoldAddr.ST,'') AND ;
							NVL(THIS.PARENT.txtZip.VALUE,'') = NVL(tSoldAddr.Zip,'') AND ;
							NVL(THIS.PARENT.txtCountry.VALUE,'') = NVL(tSoldAddr.Country,'') AND ;
							NVL(THIS.PARENT.txtContact.VALUE,'') = NVL(tSoldAddr.Contact,'') AND ;
							NVL(THIS.PARENT.txtPhone.VALUE,'') = NVL(tSoldAddr.TelePhone,'') AND ;
							NVL(THIS.PARENT.txtFax.VALUE,'') = NVL(tSoldAddr.Fax_Number,'') AND ;
							NVL(THIS.PARENT.txtEmail.VALUE,'') = NVL(tSoldAddr.Email,'')
		
			*				no change - do not save
						ELSE &&did not match all Fields - Save
							SaveAddr = .T.
							oldSoldCode = ThisForm.Bill3Addr
						ENDIF
						USE IN tSoldAddr
					ELSE &&Not Used - add as new
						SaveAddr = .T.
					ENDIF
				ELSE && No SoldCode - add if have data
					IF LEN( ALLTRIM(This.Parent.txtCompany.Value+This.Parent.txtAddr1.Value)) > 1
						SaveAddr = .T.
					ELSE
						SaveAddr = .T.
					ENDIF
				ENDIF
				
				IF SaveAddr
					DO WHILE FoundSoldCode( maxSoldCode,ThisForm.nConnHandle )
						maxSoldCode = maxSoldCode + 1
					ENDDO
		
					
					
					PRIVATE cCompany, cAddr1,cAddr2, cCity, cST, cZip, cCountry, cContact, cPhone, cFax, cEmail
					cCompany	= PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
					cAddr1	= PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
					cAddr2	= PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
					cCity	= PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',100)
					cST		= PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',50)
					cZip	= PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',50)
					cCountry	= PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)
					cContact	= PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
					cPhone	= PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
					cFax	= PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
					cEmail	= PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
					
					Save_ShipAddrCode(maxSoldCode, ALLTRIM(STR(maxSoldCode,10,0)), oldSoldCode, ThisForm.nConnHandle)
		
					cSQL = "INSERT INTO dbo.SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number,Email,Customer, LastEdit ) VALUES ("
					cSQL = cSQL + STR(maxSoldCode)
					cSQL = cSQL + ",'"+cCompany+"'"
					cSQL = cSQL + ",'"+cAddr1+"'"
					cSQL = cSQL + ",'"+cAddr2+"'"
					cSQL = cSQL + ",'"+cCity+"'"
					cSQL = cSQL + ",'"+cST+"'"
					cSQL = cSQL + ",'"+cZip+"'"
					cSQL = cSQL + ",'"+cCountry+"'"
					cSQL = cSQL + ",'"+cContact+"'"
					cSQL = cSQL + ",'"+cPhone+"'"
					cSQL = cSQL + ",'"+cFax+"'"
					cSQL = cSQL + ",'"+cEmail+"'"
					cSQL = cSQL + ","+ALLTRIM(STR(maxSoldCode,10,0))+""  &&CustomerID
					cSQL = cSQL + ",'"+DTOC(DATE())+"')"
					
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'')
					ELSE
						This.Parent.txtBill3Code.Value = maxSoldCode
						ThisForm.Bill3Addr = maxSoldCode
						ThisForm.UpdateCustID = .T. 
						This.Parent.txtLastEdit.Value = DATE()
						This.Parent.txtLastEdit.Refresh
					ENDIF			
		
				ENDIF
			ENDIF
			thisform.AddressScreen("Bill3ToEdit")
			ThisForm.cmdNext.SetFocus()
		ELSE &&Caption was Edit
			IF NVL(This.parent.txtBill3Code.VALUE,0) = 0
				This.parent.cmdSearchSoldTo.Click
			ELSE
				thisform.AddressScreen("Bill3ToSave")
			ENDIF
			This.Parent.txtCompany.SetFocus()
		ENDIF
		
	ENDPROC

	PROCEDURE pf1.pgFreight.cmdLadingAdd.Click
		SELECT tmpLading
		APPEND BLANK
	ENDPROC

	PROCEDURE pf1.pgFreight.cmdLadingRemove.Click
		IF USED("tmpLading")
			This.Parent.grdLading.RecordSource = ""
			SELECT tmpLading
			PACK
			IF RECCOUNT("tmpLading") = 0
				APPEND BLANK
			ENDIF
			This.Parent.grdLading.RecordSource = "tmpLading"
		ELSE
			MESSAGEBOX("tmpLading not used.",0,"ERROR")
		ENDIF
	ENDPROC

	PROCEDURE pf1.pgFreight.cmdSearchSoldTo.Click
		Private matchCodes, nNewSoldToCode, lcCurrTable 
		nNewSoldToCode = 0
		matchCodes = 0
		lcCurrTable = ALIAS()
		
		PRIVATE lcCompany
		lcCompany = This.Parent.Parent.pgSoldTo.txtCompany.Value
		
		DO FORM Forms\SearchForm WITH "SoldAddr",lcCompany TO nNewSoldToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				*SELECT SalesNum
			ENDIF
		EndIF
		
		IF nNewSoldToCode > 0 
			IF USED( 'tSoldAddr' )
				USE IN tSoldAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr"
			cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nNewSoldToCode)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tSoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tSoldAddr')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tSoldAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tSoldAddr')
			ENDIF
			IF USED( 'tSoldAddr' )
				THISFORM.Bill3Addr = tSoldAddr.SoldCode
				THIS.PARENT.txtBill3Code.VALUE = tSoldAddr.SoldCode
				THIS.PARENT.txtCompany.VALUE = tSoldAddr.Company
				THIS.PARENT.txtAddr1.VALUE = tSoldAddr.Addr1
				THIS.PARENT.txtAddr2.VALUE = tSoldAddr.Addr2
				THIS.PARENT.txtCity.VALUE = tSoldAddr.City
				THIS.PARENT.txtST.VALUE = tSoldAddr.ST
				THIS.PARENT.txtZip.VALUE = tSoldAddr.Zip
				THIS.PARENT.txtCountry.VALUE = tSoldAddr.Country
				THIS.PARENT.txtContact.VALUE = tSoldAddr.Contact
				THIS.PARENT.txtPhone.VALUE = tSoldAddr.TelePhone
				THIS.PARENT.txtFax.VALUE = tSoldAddr.Fax_Number
				THIS.PARENT.txtEmail.VALUE = tSoldAddr.Email
				THIS.PARENT.txtLastEdit.VALUE = CTOD(DTOC(tSoldAddr.LastEdit))
				
				USE IN tSoldAddr
				
				thisform.AddressScreen("Bill3ToEdit")
			EndIf
			
		EndIf
	ENDPROC

