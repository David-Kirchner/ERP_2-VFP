				ThisForm.pf1.pgOverView.Sold2.Caption = ""
				ThisForm.pf1.pgOverView.Sold3.Caption = ""
				ThisForm.pf1.pgOverView.Sold4.Caption = ""
				
				ThisForm.pf1.pgSoldTo.cmdSearchSoldTo.Enabled = .T.
				
				ThisForm.pf1.pgOverView.Enabled = .F.
		*		ThisForm.pf1.pgSoldTo.Enabled = .F.
