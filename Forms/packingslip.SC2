					*cSQLu= cSQLu+ ",Qshipped = "+STR(nQshipped)
					*cSQLu= cSQLu+ ",Qshipped = CASE WHEN Qshipped IS NULL Then "+STR(nQshipped)+" Else Qshipped + "+STR(nQshipped)+" End "
					
