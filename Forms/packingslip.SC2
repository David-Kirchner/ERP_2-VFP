	PROCEDURE refreshforms		&& Pass Form
		PARAMETERS pForm
		*ThisForm.RefreshForms()
		
		PRIVATE cForm
		IF VARTYPE(pForm)="C"
			cForm = pForm
		ELSE
			cForm = '95'
		ENDIF
		
		
		IF GetFormCaptions(cForm,ThisForm.nConnHandle)
			IF USED('tmpFormCaptions')
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.LBLTHCK1.Caption	= RTRIM(tmpFormCaptions.txt1)
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.LBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.LBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.LBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.LBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.SZ31.Visible 		= tmpFormCaptions.use3rdDim
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.SZ31.Enabled 		= tmpFormCaptions.Sz3Enable
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.LBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
				ThisForm.pf1.pgItems.pf_SO_Items.pg_add_item.LBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
				
				USE IN tmpFormCaptions
			ELSE
				TrackError( "tmpFormCaptions is not used!","GetFormCaptions("+cForm+")",PROGRAM(),LINENO(1) )
			ENDIF
		ELSE
			TrackError("GetFormCaptions returned False!","GetFormCaptions("+cForm+")",PROGRAM(),LINENO(1) )
		ENDIF
		RETURN
		
	ENDPROC

	PROCEDURE returnall		&& Places all of one column in one string.
		PARAMETER ls_table
		
		
		PRIVATE cReturnLine, currselect
		cReturnLine = ""
		currselect = ALIAS()
		
		DO CASE 
		CASE ls_table = "PO"
			IF USED('PackingSlipPO')
				SELECT PackingSlipPO
				SCAN
				IF !EMPTY(PackingSlipPO.PO) 
					IF EMPTY(cReturnLine)
						cReturnLine = ALLTRIM(PackingSlipPO.PO) 
					Else
						cReturnLine = cReturnLine + "; "+ ALLTRIM(PackingSlipPO.PO) 
					ENDIF
				ENDIF
				ENDSCAN
				IF cReturnLine = "; "
					cReturnLine = ""
				ENDIF
			ELSE
				STORE .NULL. TO cReturnLinetmpPS
			ENDIF
		CASE ls_table = "SO"
			IF USED('PackingSlipSO')
				SELECT PackingSlipSO
				SCAN
				IF PackingSlipSO.SO > 0
					IF EMPTY(cReturnLine)
						cReturnLine = AllTrim(STR(PackingSlipSO.SO,10,0)) 
					Else
						cReturnLine = cReturnLine + "; "+ AllTrim(STR(PackingSlipSO.SO,10,0))
					ENDIF
				ENDIF
				ENDSCAN
			ELSE
				STORE .NULL. TO cReturnLine
			ENDIF
		OTHERWISE
			wait window "Parameter not programed"
			STORE .NULL. TO cReturnLine
		ENDCASE
		
		IF IsNull(cReturnLine)
		*
		ENDIF
		
		IF NOT EMPTY(currselect)
			SELECT (currselect)
		ENDIF
		RETURN cReturnLine
	ENDPROC

	PROCEDURE reversesql
		*ThisForm.ReverseSQL()
		
		IF USED('PackingSlipItem')
			SELECT PackingSlipItem
			
			SCAN
				ntmpPS = PrepareSQLnum(PackingSlipItem.PackingSli,'PackingSli',-3)
				IF ntmpPS > 0
					IF ntmpPS < 0
						*2147000000
						*use tmp Packing Slip
						
						cSQL = "UPDATE dbo.Sales_Stock SET PackingSli = 0 "
						cSQL = cSQL + " WHERE PackingSli ="+STR(ntmpPS)
						cSQL = cSQL + " AND ISNULL(Reconciled,0)= 0"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '' )
						ENDIF
		
					ENDIF	
				ENDIF
			ENDSCAN
		ENDIF
	ENDPROC

	PROCEDURE save_tmplading
		PARAMETERS nPS_NO
		*ThisFirm.Save_tmpLading(nPS_NO)
		
		PRIVATE nPieces,cBoLDesc,cBox_Size,nNMFC,cClassRate,nWeight, lKg, nDecValue
		PRIVATE nBil3code,cFrtCharges,cDutyTax,lCOD,lCODFrtColl,lCODCertChk 
					
		SELECT tmpLading
		SCAN
			IF NOT EMPTY(PrepareSQLtxt(tmpLading.DESCRIPT,'Descript',80)) AND tmpLading.Pieces > 0 AND NOT DELETED()
				
				*nPS_NO		= PrepareSQLnum(nPS_NO,'nPS_NO',-3)
				nPieces 	= PrepareSQLnum(tmpLading.Pieces,'Pieces',10,0)
				cBoLDesc	= PrepareSQLtxt(tmpLading.DESCRIPT,'Descript',80)
				cBox_Size	= PrepareSQLtxt(tmpLading.Box_Size,'Box_Size',20)
				nNMFC		= PrepareSQLnum(tmpLading.NMFC,'NMFC',15,0)
				cClassRate	= PrepareSQLtxt(tmpLading.ClassRate,'ClassRate',4)
				nWeight		= PrepareSQLnum(tmpLading.Weight,'Weight',9,1)
				lKg			= PrepareSQLchk(tmpLading.Kg,'Kg')
				nDecValue	= PrepareSQLnum(tmpLading.DecValue,'DecValue',9,2)
				nBil3code	= PrepareSQLnum(tmpLading.bil3code,'Bil3Code',-3)
				cFrtCharges	= PrepareSQLtxt(tmpLading.FrtCharges,'FrtCharges',10)
				cDutyTax	= PrepareSQLtxt(tmpLading.DutyTax,'DutyTax',11)
				lCOD		= PrepareSQLchk(tmpLading.COD,'COD')
				lCODFrtColl	= PrepareSQLchk(tmpLading.CODFrtColl,'CODFrtColl')
				lCODCertChk	= PrepareSQLchk(tmpLading.CODCertChk,'CODCertChk')
				
				cSQLu = "INSERT INTO dbo.Lading "
				cSQLu=cSQLu+"(PackingSli, Pieces,DESCRIPT,Box_Size,NMFC,ClassRate,Weight,Kg,DecValue,bil3code,FrtCharges,DutyTax,COD,CODFrtColl,CODCertChk) VALUES ("
				cSQLu=cSQLu+""+STR(nPS_NO)+"" 
				cSQLu=cSQLu+","+STR(nPieces)+"" 
				cSQLu=cSQLu+",'"+cBoLDesc+"'"
				cSQLu=cSQLu+",'"+cBox_Size+"'"
				cSQLu=cSQLu+","+STR(nNMFC)+""
				cSQLu=cSQLu+",'"+cClassRate+"'"
				cSQLu=cSQLu+","+STR(nWeight,9,1)+""
				cSQLu=cSQLu+","+IIF(lKg,'1','0')+""
				cSQLu=cSQLu+","+STR(nDecValue,9,2)+""
				cSQLu=cSQLu+","+STR(nBil3code)+""
				cSQLu=cSQLu+",'"+cFrtCharges+"'"
				cSQLu=cSQLu+",'"+cDutyTax+"'"
				cSQLu=cSQLu+","+IIF(lCOD,'1','0')+""
				cSQLu=cSQLu+","+IIF(lCODFrtColl,'1','0')+""
				cSQLu=cSQLu+","+IIF(lCODCertChk,'1','0')+""
				cSQLu=cSQLu+")"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError( cSQLu, ThisForm.nConnHandle,nSQLEXEC,'' )
				ENDIF	
					
			ENDIF
		ENDSCAN
		
	ENDPROC

	PROCEDURE save_tmpquote
		PARAMETERS lcCompany,lcCompany
		*ThisForm.Save_tmpQuote(lcCompany,lcCompany)
		** Never USE !, always has SalesP enter the Quote !!!
		
		IF USED('tmpQuote') &&Something to add
			SELECT tmpQuote
		
			*CREATE TABLE (SYS(5)+SYS(2003)+"\"+(ThisForm.Uniq_Quote) ) FREE ;
			*(FORM C(2), Pcs N(4,0), thck N(10,4), Sz2 N(9,3), Sz3 N(9,3), DESCRIPT C(50), Alloy C(12), Heat C(30), SalesNum N(7), SOItem C(10), ITEM N(2,0), Weight N(8,1), SalesP C(1), PO_Num C(17), COMPLETE L )
							
			SCAN
		
			*nLBS = IIF(PackingSlipItem.Kg,PackingSlipItem.Weight*2.2,PackingSlipItem.Weight)
			nLBS = PrepareSQLnum(tmpQuote.Weight,'Weight',7,1)
			nPCs = PrepareSQLnum(tmpQuote.Pcs,'Pcs',-3)
			******************************************************
			
			*Save to AllQuotes - cannot use SQL View
			m.SalesP = UPPER(tmpQuote.SalesP)
			*Get Max
			IF USED('MaxInqNum')
				USE IN MaxInqNum
			ENDIF
			SELECT 0
		
			PRIVATE cSQLMaxInqNum
			cSQLMaxInqNum = "SELECT MAX(inqnum) AS MaxInqN FROM dbo.AllQuotes WHERE SalesP = '"+m.SalesP+"'"
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLMaxInqNum, 'MaxInqNum') 
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLMaxInqNum, 'MaxInqNum')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLMaxInqNum, 'MaxInqNum')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLMaxInqNum, 'MaxInqNum')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLMaxInqNum, "MaxInqNum")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLMaxInqNum, "MaxInqNum")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError( cSQLMaxInqNum, ThisForm.nConnHandle, nSQLEXEC, 'MaxInqNum' )
				INQMAX=1000
			ELSE
				INQMAX = MaxInqNum.MaxInqN
			ENDIF
		
			IF USED('MaxInqNum')
				USE IN MaxInqNum
			ENDIF
		
			IF ISNULL(INQMAX)
				INQMAX = 1000
			ENDIF
		
			m.next_inq = INQMAX + 1
			m.InqNumP = STR(m.next_inq,8,0)+UPPER(m.SalesP)
		
			*cDescript = PrepareSQLtxt(tmpQuote.DESCRIPT,"Descript",80)
			PRIVATE cInsert
			cInsert = "INSERT INTO dbo.AllQuotes ("
			cInsert = cInsert + "COMPANY,"
			cInsert = cInsert + "NAME,"
			cInsert = cInsert + "PHONE,"
			cInsert = cInsert + "PHONE_EXT,"
			cInsert = cInsert + "FAX,"
			cInsert = cInsert + "EMAIL,"
			cInsert = cInsert + "PO_NUM,"
			cInsert = cInsert + "ALLOY,"
			cInsert = cInsert + "FORM," 
			cInsert = cInsert + "PIECES,"
			cInsert = cInsert + "THCK," 
			cInsert = cInsert + "SZ2,"
			cInsert = cInsert + "SZ3,"
			cInsert = cInsert + "Weight,"
			cInsert = cInsert + "DESCRIPT,"
			cInsert = cInsert + "P_lb,"
			cInsert = cInsert + "P_pc,"
			cInsert = cInsert + "P_ft,"
			cInsert = cInsert + "cuts,"
			cInsert = cInsert + "OtherFld,"
			cInsert = cInsert + "OtherP,"
			cInsert = cInsert + "LotP," 
			cInsert = cInsert + "LotCost,"
			cInsert = cInsert + "LeadTime,"
			cInsert = cInsert + "cWeight,"
			cInsert = cInsert + "cP_lb,"
			cInsert = cInsert + "cP_pc,"
			cInsert = cInsert + "cP_Pcc,"
			cInsert = cInsert + "cTHK,"
			cInsert = cInsert + "cLotP,"
			cInsert = cInsert + "cLotCp,"
			cInsert = cInsert + "cCut,"
		*			cInsert = cInsert + "Line1,"
		*			cInsert = cInsert + "InqDate,"
			cInsert = cInsert + "InqNum,"
