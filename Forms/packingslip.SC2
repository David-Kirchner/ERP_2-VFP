			ENDDO
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cInsert)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cInsert)
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cInsert, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cInsert, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cInsert, ThisForm.nConnHandle, nSQLEXEC,'')
			ELSE
				IF SQLCOMMIT(ThisForm.nConnHandle) < 1
					SQLExecError("Cannot commit."+CHR(13)+cInsert,ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF
			ENDIF
			******************************************************
			*Save to Ship
		
			*Check Ship for an existing SO-Item
			PRIVATE nCountShip 
			nCountShip = Count_ShipbySOitem( tmpQuote.SOItem, ThisForm.nConnHandle, '')
			*RecordTest('Record Test Data.'
			IF nCountShip > 0	
				*nQshipped = getQshipped_ShipbySOitem( Ship.SOItem, ThisForm.nConnHandle )
				*nQShipped = get_SOitem_PCs_Complete( tmpQuote.SOitem, nPCs, nPS_No, ThisForm.nConnHandle )
				
				cSQLu= "UPDATE dbo.Ship SET "
				cSQLu= cSQLu+ " SalesNum = "+STR(tmpQuote.SalesNum,7,0)
				cSQLu= cSQLu+ ",SOItem	= '"+tmpQuote.SOItem+"'"
				cSQLu= cSQLu+ ",ITEM = '"+STR(tmpQuote.Item,2,0)
				cSQLu= cSQLu+ ",PO_Num = '"+tmpQuote.PO_Num+"'"
				cSQLu= cSQLu+ ",SalesP = '"+tmpQuote.SalesP+"'"
				cSQLu= cSQLu+ ",Company = '"+lcCompany+"'"
				cSQLu= cSQLu+ ",Alloy = '"+tmpQuote.Alloy+"'"
				*cSQLu= cSQLu+ ",Qshipped = "+STR(nQshipped)
				cSQLu= cSQLu+ ",OrderDate= '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
				cSQLu= cSQLu+ ",OrderDate= '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
				cSQLu= cSQLu+ ",ShipDate = '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
				cSQLu= cSQLu+ ",ShipVia = '"+PrepareSQLtxt(cShippedVia,'ShipVia',20)+"'"
				
				**Only Update a Complete as a True, do not write a False
				IF VARTYPE(PackingSlipItem.SOi_cmplt) = "L"
					cSQLu= cSQLu+ ",[COMPLETE] = "+IIF(PackingSlipItem.SOi_cmplt,'1','0')
				ENDIF
				cSQLu= cSQLu+ " WHERE SOItem = dbo.f_ProperSOitem('"+tmpQuote.SOItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
				ENDIF
			ELSE
				RecordTest('Record Test Data.', "PackingSlip.Print.Click()",LINENO(1), "Did not find SOitem '"+tmpQuote.SOItem+"' in Ship."+CHR(13)+"Count_ShipbySOitem()" )
				
				cSQLi = "INSERT INTO dbo.Ship (SalesNum,SOItem,ITEM,PO_Num,SalesP,Company,Alloy,Qshipped,OrderDate,DueDate,ShipDate,ShipVia,COMPLETE) VALUES  ("	
				cSQLi = cSQLi + STR(tmpQuote.SalesNum,7,0)+",'"+tmpQuote.SOItem+"',"+STR(tmpQuote.Item,2,0)+",'"+tmpQuote.PO_Num+"'"
				cSQLi = cSQLi + ",'"+tmpQuote.SalesP+"','"+lcCompany+"','"+tmpQuote.Alloy+"',"+STR(tmpQuote.pcs,10,0)
				cSQLi = cSQLi + ",'"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"','"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"','"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
				cSQLi = cSQLi + ",'"+PrepareSQLtxt(cShippedVia,'ShipVia',30)+"',"+IIF(PackingSlipItem.SOi_cmplt,'1','0')+")"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError( cSQLi, ThisForm.nConnHandle, nSQLEXEC,'' )
				ENDIF
			ENDIF
		
				*Check Sales for an existing SO-Item
				*SELECT COUNT(*) FROM HPA!Sales INTO ARRAY aSOItemCount WHERE Sales.SOItem = tmpQuote.SOItem
				
				IF Count_SOIteminSales(tmpQuote.SOItem,ThisForm.nConnHandle) > 0
					*Does SO-item exists in Sales
					
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu+" MatlWt = "+STR(nLBS ,7,1)+""
					*cSQLu = cSQLu+",Qshipped = "+STR(nQshipped) +""
					IF NOT EMPTY(dShipDate)
						cSQLu = cSQLu+",Shipped  = '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
					ENDIF
					
					**Only Update a Complete as a True, do not write a False
					IF tmpQuote.COMPLETE
						cSQLu = cSQLu+",Cmplt = "+IIF(tmpQuote.COMPLETE,'1','0')
					ENDIF
					cSQLu = cSQLu+" WHERE Sales.SOItem = dbo.f_ProperSOitem('"+tmpQuote.SOItem+"')"
						
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
		
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
					ENDIF
		
					TrackError("SO item:"+tmpQuote.SOItem+" was marked "+IIF(tmpQuote.COMPLETE,'Complete','Not Complete')+" when PackingSlip No:"+STR(ThisForm.PackingSlipNo)+" was Printed!"+CHR(13)+cSQLu,"SO item:"+tmpQuote.SOItem+" was marked ",PROGRAM(),LINENO(1) )
					*heat
					
					IF PrepareSQLlogic(tmpQuote.COMPLETE,'Complete')
						** Repeat in SOitem_Hrs
						cSQL = "UPDATE dbo.SOitem_Hrs SET "
						cSQL = cSQL + " [Cmplt] = 1"
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+tmpQuote.SOItem+"')"
						
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
							
						IF nSQLEXEC < 0
							SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
						ENDIF
						**
					ENDIF
				ELSE
					cSQL = "INSERT INTO dbo.Sales ( SOitem, SalesNum, Shipped, MatlWt, Cmplt ) VALUES ("
					cSQL = cSQL + "'"+tmpQuote.SOItem+"'"
					cSQL = cSQL + ","+STR(tmpQuote.SalesNum)
					cSQL = cSQL + ",'"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"'"
		
					cSQL = cSQL + ","+STR(nLBS ,7,1)
					cSQL = cSQL + ","+STR(tmpQuote.COMPLETE)
					cSQL = cSQL + ")"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
					ENDIF
					
					
				ENDIF
				********
				
				cSQL = "INSERT INTO dbo.Sales_PS ( "
				cSQL = cSQL + " [PackingSli]"
		  			cSQL = cSQL + ",[SOitem]"
		  			cSQL = cSQL + ",[SalesNum]"
		  			
		  			cSQL = cSQL + ",[Acct_PU]"
		  			cSQL = cSQL + ",[Acct_QTY]"
		  			*cSQL = cSQL + ",[Acct_S]"
		  			cSQL = cSQL + ",[Pounds]"
		    		*cSQL = cSQL + ",[Cust_PU]"
		  			*cSQL = cSQL + ",[Cust_QTY]"
		  			*cSQL = cSQL + ",[Cust_P]"    
		  			*cSQL = cSQL + ",[Last_Ship]"
		
		  			cSQL = cSQL + ",[Cmplt]"
		  			*cSQL = cSQL + ",[ID_Detail]"
		  			*cSQL = cSQL + ",[TBL]"
		  			*cSQL = cSQL + ",[Heat]"
				cSQL = cSQL + ",[PS_Date]"
				cSQL = cSQL + " ) VALUES ("
				
				cSQL = cSQL + " "+STR(nPS_No)
		  			cSQL = cSQL + "'"+tmpQuote.SOItem+"'"
		  			cSQL = cSQL + ","+STR(tmpQuote.SalesNum)
		  			
		  			cSQL = cSQL + ","+STR( GetPUfromForm(tmpQuote.Form) )	&&Acct_PU
		  			
		  			cSQL = cSQL + ","+STR(tmpQuote.Weight,9,1) &&Acct_QTY
		  			*cSQL = cSQL + ",[Acct_S]"
		  			cSQL = cSQL + ","+STR(tmpQuote.Weight,9,1)	&&Pounds
		    	*cSQL = cSQL + ",[Cust_PU]"
		  			*cSQL = cSQL + ",[Cust_QTY]"
		  			*cSQL = cSQL + ",[Cust_P]"    
		  			*cSQL = cSQL + ","+STR(tmpQuote.COMPLETE) 	&&Last_Ship
		
		  			cSQL = cSQL + ","+IIF(tmpQuote.COMPLETE,'1','0')	&&Complete
		  			*cSQL = cSQL + ",[ID_Detail]"
		  			*cSQL = cSQL + ",[TBL]"
		  			*cSQL = cSQL + ",[Heat]"
		  			*cSQL = cSQL + ",'"+PrepareSQLtxt(PackingSlipItem.Heat,"Heat",50)+"'"
				cSQL = cSQL + ",'"+DTOC( DATE() )+"'"	&&PS_Date
				cSQL = cSQL + " ) "
				
		*!*			cSQL = cSQL + " "+STR(PackingSlipItem.PackingSli)
		*!*	  		cSQL = cSQL + ",'"+PackingSlipItem.SOItem+"'"
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.SalesNum)
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.PU)
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.SL_QTY,18,4)  &&[Acct_QTY]
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.SL_P,18,4)  	&&[Acct_P]"
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.Weight,9,1)
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.PU)		&&[Cust_PU]
		*!*	    	cSQL = cSQL + ","+STR(PackingSlipItem.SL_QTY,18,4)  && && each heat line on PackingSli QTY
		*!*	*  		cSQL = cSQL + ",[Cust_P]"    
		*!*	  		
		*!*	  		cSQL = cSQL + ","+IIF(PackingSlipItem.SOi_cmplt,"1","0")	 &&[Cmplt_QTY]
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.SL_ID)		&&[ID_Detail]
		*!*	  		cSQL = cSQL + ",'"+PackingSlipItem.TBL+"'"
		*!*	  		cSQL = cSQL + ",'"+PackingSlipItem.Heat+"'"
		*!*	  		cSQL = cSQL + ","+STR(PackingSlipItem.SS_ID)		&&Sales_Stock_ID
				
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
				ENDIF
		
			ENDSCAN
			USE IN tmpQuote
		ENDIF
		
	ENDPROC

	PROCEDURE save_tmpsales
		*ThisForm.Save_tmpSales()
		
		
		IF USED('tmpSales')
			SELECT tmpSales	
			SCAN
			
				*Save to PartNo Sales
				IF NOT EMPTY(tmpSales.SOItem)
					*Check Sales for an existing SO-Item
					IF Count_SOIteminSales(tmpSales.SOItem, ThisForm.nConnHandle) > 0
						*SO exists in Sales
		
						cSQLu = "UPDATE dbo.Sales SET "
						*cSQLu=cSQLu+" SalesNum="+STR(tmpSales.SalesNum)+","
						cSQLu=cSQLu+" PartNo= '"+PrepareSQLtxt(tmpSales.PartNo,"PartNo",100)+"'"
						cSQLu=cSQLu+" WHERE SOItem = dbo.f_ProperSOitem('"+tmpSales.SOItem+"')"
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						
						IF nSQLEXEC < 0 &&Try again!, long triger
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
						ENDIF
		
					ELSE
		
						cSQLu = "INSERT INTO dbo.Sales (SOItem, SalesNum, PartNo ) VALUES ("
						cSQLu=cSQLu+"'"+tmpSales.SOItem+"'"
						cSQLu=cSQLu+","+STR(tmpSales.SalesNum)
						cSQLu=cSQLu+","+LEFT(STRTRAN(tmpSales.PartNo,"'","''"),100)+"')"
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQLu, ThisForm.nConnHandle, nSQLEXEC,'' )
						ENDIF	
					ENDIF
		
				ENDIF
				****
						
				*Mark StockLst_Process
				IF NOT EMPTY(tmpSales.SOItem)
					
					
				ENDIF
			ENDSCAN
		ENDIF
		
		
	ENDPROC

	PROCEDURE save_tmpsales_stock
		*ThisForm.Save_tmpSales_Stock()
		*!*		******************************************************
		*!*		PRIVATE lFoundSales_Stock_ID
		*!*		SELECT tmpSales_Stock
		*!*		SCAN
		*!*			lFoundSales_Stock_ID = .F.
		*!*			
		*!*			nSS_ID = PrepareSQLnum(tmpSales_Stock.ID,'SS_ID',-3)
		*!*			IF nSS_ID > 0
		*!*			
		*!*				IF USED('tmpCountSS')
		*!*					SELECT tmpCountSS
		*!*				ELSE
		*!*					SELECT 0
		*!*				ENDIF
		*!*				
		*!*				cSQL = "Count ID AS Cntd FROM dbo.Sales_Stock "
		*!*				cSQL = cSQL + " WHERE ID="+STR( nSS_ID )
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountSS')
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCountSS')
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPcsAllQuotes")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPcsAllQuotes")
		*!*						
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO 
		*!*				ENDIF
		*!*				IF USED('tmpCountSS')
		*!*					IF RECCOUNT('tmpCountSS') > 0
		*!*						IF tmpCountSS.Cntd > 0
		*!*							lFoundSales_Stock_ID = .T
		*!*						ENDIF
		*!*					ENDIF
		*!*					USE IN tmpCountSS
		*!*				ENDIF
		*!*				
		*!*				SELECT tmpSales_Stock
		*!*			ELSE
		*!*				lFoundSales_Stock_ID = 0
		*!*			ENDIF
		*!*			
		*!*			IF lFoundSales_Stock_ID 
