	PROCEDURE hpacert.PF1.pgCert.cmdDelete.Valid
		PRIVATE currec
		IF ThisFormSet.isediting 	&&Do not SAVE
			*ABORT
			isadding=.F.
			*************
			ThisFormSet.SetNormal
			ThisFormSet.Refresh_HpaCert()
			WAIT WINDOW 'Edit Cancelled' NOWAIT
		
		ELSE   &&do the record delete
			*DELETE
			
			SELECT hpacert
			IF EOF() OR BOF()
				WAIT WINDOW 'End of File.' NOWAIT
				RETURN
			ENDIF
			currec = recno()
			
			IF AllowCertDelete(ThisFormSet.nConnHandle)
				IF MESSAGEBOX("Are you sure you want to delete this Cert?",4+32,"Delete Cert") = 6
		
					PRIVATE nID,cSQL,nSQLEXEC 
					nID = ThisForm.PF1.pgCert.txtID.Value
					
					cSQL = "DELETE FROM dbo.Cert_Co WHERE ID = "+STR(nID)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					cSQL = "DELETE FROM dbo.Cert WHERE ID ="+STR(nID)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					IF EMPTY(HPACert.Heat)
						ThisFormSet.Refresh_HpaCert('DELETED')
					ELSE
		*				ThisForm.txtGetHeat.Value = HPACert.Heat
						This.parent.txtGetHeat.Value = HPACert.Heat
						ThisFormSet.SearchHeat()
					ENDIF
				ENDIF
			ELSE
				MESSAGEBOX('You do not have Permission to delete!',48,'No Delete')
			ENDIF
		
			ThisForm.PF1.pgCert.Refresh
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdEdit.Click
		IF ThisFormSet.isediting
		*	SAVE THIS
			IF ThisFormSet.CheckCert()
				IF ThisFormSet.SaveCert()
				
				ENDIF
			ENDIF
		ELSE &&ThisFormSet.isediting
			SELECT HPACert
			*Edit !!!
			IF EOF() OR BOF()
				=MESSAGEBOX('End of File',16)
				RETURN
			ENDIF
			
		*	Must match Array in cmdEdit-Save
		*	Start Editting
			SCATTER FIELDS LIKE Al,B,C,Cb,Co,Cr,Cu,Fe,H,Mg,Mo,Mn,N,Na,Ni,O,P,S,Si,Ta,Ti,V,W,Y,CbandTa,NiandCo,Other TO gaChemistry
			*SCATTER FIELDS LIKE grainsizem,hardness,CORROSIONR,ULT1,yield1,elong1,ELONINCHES,ra1,SrTemp,SrStress,SrHours,SrRA,SrElong,HEATTREAT TO gaPhysical
			SCATTER FIELDS LIKE grainsizem,CorrosionR,SrTemp,SrStress,SrHours,SrRA,SrElong,HEATTREAT TO gaPhysical
			SCATTER FIELDS LIKE hardness,BHN,ULT1,yield1,elong1,ELONINCHES,ra1,hardness2,BHN2,ULT2,yield2,elong2,ELONINCHES2,ra2,hardness3,BHN3,ULT3,yield3,elong3,ELONINCHES3,ra3 TO gaMechanical
			SCATTER FIELDS LIKE heat, lot, machine, QA, QARev, MercFree, NoWeld TO gaCert
		
			IF signed
				IF MESSAGEBOX("Editing the chemical or physical properties of this Cert"+CHR(13)+"will remove the signature."+CHR(13)+"Do you want to continue with edit?",4+32,"This Cert is Signed.") = 7
					return
				ENDIF
			ENDIF
			
			WAIT WINDOW "Only user belonging to the 'WINDFALL\Certs' group are allowed to save to the Certs table." NOWAIT
			
		*	IF ISRLOCKED()
		*		ThisFormSet.SetNormal
		*		=MESSAGEBOX('Record could not be Lock for you.  Try again!',16)
		*	ELSE
				ThisFormSet.SetEditing()
		*	ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdEdit.Valid
		IF ThisFormSet.isediting
			ThisForm.PF1.pgCert.txtAlloy.SetFocus
		ENDIF
		ThisForm.PF1.pgCert.Refresh
		
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdGetHeat.Valid
		ThisFormSet.SearchHeat()
		
		
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdGetLot.Valid
		PRIVATE nLot
		
		nLot = PrepareSQLnum(This.parent.txtGetLot.Value,'Lot',-3)
		IF nLot = 0
			PRIVATE cLot
			cLot = PrepareSQLtxt(This.parent.txtGetLot.Value,'LOT',10)
			IF LEN(cLot)>1
				IF PrepareSQLnum( LEFT(cLot,1),'Lot',1) = 0
					*Drop first letter  Could be 'G4229'
					nLot = PrepareSQLnum( RIGHT(cLot, LEN(cLot)-1 ) ,'Lot',-3)
					IF nLot > 0
						This.parent.txtGetLot.Value = PrepareSQLtxt(nLot,'Lot',10)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF nLot > 0
			ThisFormSet.SearchLot()
		ENDIF
		
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdNext.Click
		
		IF This.parent.cmdUnFilter.Visible
			*Go next of Heat!	
			SELECT HPACert
			IF RECCOUNT('HPACert') > RECNO('HPACert')
		
				SKIP 1
				ThisForm.PF1.pgCert.Refresh
				
				ThisFormSet.Refresh_HpaCert()
				
			ELSE
				MESSAGEBOX("You are at the end of the 'Filtered' view."+CHR(13)+"Unfilter to see other certs.",0+48,"End of View.") 
			ENDIF
		ELSE
			PRIVATE nID
			nID = HPACert.ID
		
			PRIVATE cSQL, nSQLEXEC,nMaxID 
			nMaxID = 1000
		
		
			cSQL = "SELECT MAX(ID) AS MAXID FROM dbo.Cert "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert')
			ENDIF
			IF USED("tmpCert")
				nMaxID = tmpCert.MAXID
				USE IN tmpCert
			ENDIF
		
		
			IF USED("HPACert")
				SELECT HPACert
			ELSE
				SELECT 0
			ENDIF
		
			**********************
			DO WHILE nID <= nMaxID 
				nID = nID + 1
				IF ThisFormSet.Get_Cert("ID",nID) > 0
					EXIT
				ENDIF
			ENDDO
			**********************
			
			IF nID >= nMaxID 
				MESSAGEBOX('End of File',64,'')
			ENDIF
			ThisForm.PF1.pgCert.Refresh
		ENDIF
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdPrev.Click
		
		IF This.parent.cmdUnFilter.Visible
			*Go next of Heat!	
			SELECT HPACert
			IF RECNO('HPACert') > 1
				SKIP -1
				ThisForm.PF1.pgCert.Refresh
						
				ThisFormSet.Refresh_HpaCert()
				
			ELSE
				MESSAGEBOX("You are at the begining of the 'Filtered' view."+CHR(13)+"Unfilter to see other certs.",0+48,"Begining of View.") 
			ENDIF
		ELSE
			PRIVATE nID
			nID = HPACert.ID
		
			PRIVATE cSQL, nSQLEXEC
		
			IF USED("HPACert")
				SELECT HPACert
			ELSE
				SELECT 0
			ENDIF
		
			DO WHILE nID > 1
				nID = nID - 1
		
				IF ThisFormSet.Get_Cert("ID",nID) > 0
					EXIT
				ENDIF
			ENDDO
		
			IF nID <= 1
				MESSAGEBOX('Beginning of File',64,'')
			ENDIF
		
			ThisForm.PF1.pgCert.Refresh
		
		ENDIF
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdPrint1.Valid
		local m.currntrecrd
		
		IF NOT USED("HPACert_Co")
			MESSAGEBOX("Could not load the Customer Specific Database",0,"Data load Error")
		ENDIF
		
		PRIVATE cHeatLot, cLot, nMachine
		cHeatLot = PrepareSQLtxt(HPACert.Heat,'Heat',50)
		cLot	= PrepareSQLtxt(HPACert.Lot,'Lot',5)
		nMachine = PrepareSQLnum(HPACert.Machine,'Machine',1,0)
		
		DO CASE
		CASE nMachine = 0
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" "+cLot
			ENDIF
		CASE nMachine = 1
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" G"+cLot
			ENDIF
		CASE nMachine = 2
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" R"+cLot
			ENDIF
		CASE nMachine = 3
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" L"+cLot
			ENDIF
		OTHERWISE
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" "+cLot
			ENDIF
		ENDCASE
		
		SELECT HPACert
		m.currntrecrd = recno('HPACert')
		*REPORT FORM Reports\certs RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
		REPORT FORM Reports\certs_Set1 RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
		
		
		
		PRIVATE nMess
		nMess = MESSAGEBOX("Do you want to Email this Cert?",4+48,"Send thru Email")
		IF nMess = 6
			PRIVATE cFileName, cLocalFile
			*cFileName = EmailFileName("HPA_Cert.PDF") --On Server share
			cFileName	= "HPA_Cert_"+ALLTRIM(STR(HPACert.ID))+".PDF"	&&use local \MEM
			cLocalFile	= SYS(5)+SYS(2003)+"\"+cFileName	
			
			DO WHILE FILE(cLocalFile)
				nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared."+CHR(13)+CHR(13)+cLocalFile,4+48,"Please wait...")
				IF nMess = 7 &&No
					DELETE FILE (cLocalFile)
				ENDIF
			ENDDO
			
			*****************************
			Local loListener As "PdfListener" Of "Pdfx.vcx"
		
			loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
			loListener.cCodePage="CP1252" &&CodePage
			loListener.cTargetFileName = cFileName
			loListener.QuietMode=.F.
			loListener.lCanPrint=.T.
			loListener.lCanEdit=.F.
			loListener.lCanCopy=.T.
			loListener.lCanAddNotes=.F.
			loListener.lEncryptDocument=.F.
			loListener.cMasterPassword=''
			loListener.cUserPassword=''
			loListener.lOpenViewer=.F.
			THISFORM.VISIBLE = .F.
		
			REPORT FORM Reports\certs_Set1 RECORD m.currntrecrd Object loListener
			
			RELEASE loListener
			THISFORM.VISIBLE = .T.			
			
			********************************
			IF FILE(cFileName)
				nMess = MESSAGEBOX("Do you want to use your MS Outlook?"+CHR(13)+CHR(13)+"Anwer no to send straight from SQL."+CHR(13)+"Not everyone has Outlook installed."+CHR(13)+"but Outlook lets you add comments before sending and SQL does not.",4+48,"Email with MS Outlook")
				IF nMess = 6
					#DEFINE olFolderInbox 6
					#DEFINE olFolderOutbox 4
					#DEFINE olMailItem 0
					#DEFINE olRecipient 4
					#DEFINE olRecipients 17
					#DEFINE IMPORTANCENORMAL 1
					TRY
						loApp=CreateObject("Outlook.Application")
						IF VARTYPE(loApp)="O"
							loNamespace = loApp.GetNamespace("MAPI")
							loFolder = loNamespace.GetDefaultFolder(olFolderInbox)
							loEMailItem = loFolder.Items.Add(olMailItem)
							loEmailItem.Subject = "HPA Cert "+cHeatLot
							loEmailItem.Importance = IMPORTANCENORMAL
							loEmailItem.HTMLBody = [<html><font face = "Arial">];
							+ [<font size = 2> <font color = 0>High Performance Alloys Cert</font></html>]
							
							loEmailItem.Attachments.Add(cLocalFile)
		
							loemailitem.Display()
							*loEmailItem.Send
							*loApp.Quit()
							release loApp, loEmailItem
							
							WAIT WINDOW "Click on the blinking Outlook window to address your Email" NOWAIT
						ENDIF
					CATCH
						MESSAGEBOX("Could not Find Outlook on this PC.",0,"No Send")
						nMess = 7
					ENDTRY
				ENDIF
				IF nMess = 7
					*send SQL email
					
					IF FILE(get_Email_ServerDir()+cFileName )
						WAIT WINDOW "DELETE FILE "+get_Email_ServerDir()+cFileName TIMEOUT 3
						DELETE FILE (get_Email_ServerDir()+cFileName)
					ENDIF
		
		
		
					PRIVATE cEmailTo, cEmailFrom, cSQLfileName, cSubject, cMessage, lCheckEmailStatus
					cEmailTo	= AppSetup_Get_Email() 
					cEmailFrom	= get_Server_Email()
					cSQLfileName = get_Email_ServerDir()+cFileName
					cSubject	= "Cert from High Performance Alloys '"+cHeatLot+"'"
					cMessage = "See the Attached document."+CHR(13)+"Cert '"+cHeatLot+"'"+CHR(13)+CHR(10)+CHR(13)+"From High Performance Alloys, Inc."+CHR(13)+CHR(13)+"Headquarters:"+CHR(13)+"1985 E 500 N Windfall, IN 46076"+CHR(13)+"1-800-472-5569    (765)945-8230"+CHR(13)+CHR(13)
					cMessage = cMessage + "Sales and Production:"+CHR(13)+"444 Wilson St, Tipton, IN 46072"+CHR(13)+"765-675-8871"
		
					*cNewPDFName = "HPA_Cert_"+STRTRAN(cHeatLot," ","_")+".PDF"	&&remove spaces
					
					lCheckEmailStatus	= .F.
		
					IF FILE(cLocalFile)
						WAIT WINDOW "COPY FILE "+cLocalFile+" TO "+cSQLfileName  TIMEOUT 3
						COPY FILE (cLocalFile) TO (cSQLfileName)
						
						*WAIT WINDOW "SendPDFEmail(David.Kirchner@HPAlloy.com,"+cEmailFrom+","+get_Email_ServerDir()+"TestPage1.pdf,'','',1,'TestEmail.pdf'" TIMEOUT 3
		
						PRIVATE cReturnTxt 
						cReturnTxt = SendPDFEmail(cEmailTo, cEmailFrom, cSQLfileName,cSubject,cMessage,ThisFormSet.nConnHandle,cFileName,.F.)
						*cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, pnConn, cNewPDFName, lCheckEmailStatus
						
		*!*				cReturnTxt = Send_Email_Attach(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName, lCheckEmailStatus)
						IF LEN(cReturnTxt) > 0
							MESSAGEBOX(cReturnTxt,0+64,"The SQL returned text")
						ENDIF
					
						
					ELSE
						MESSAGEBOX("Test file at "+get_Email_ServerDir()+"'TestPage.pdf' is missing",0+32,"No file to test on.")
					ENDIF
				ENDIF
			
			ELSE
				MESSAGEBOX("Failed to create file."+CHR(13)+cNewPDFName ,16,"File not Created.")
				TrackError("Failed to create file."+CHR(13)+cNewPDFName ,"Failed to create file.", PROGRAM(), LINENO(1))
			ENDIF
			
			IF FILE(cLocalFile)
				DELETE FILE (cLocalFile)
			ENDIF
		
		ENDIF
		
		*******************
		SELECT HPACert
		IF m.currntrecrd <= RECCOUNT('HPACert')
			GOTO m.currntrecrd
		ELSE
			GO TOP
		ENDIF
		
	ENDPROC

