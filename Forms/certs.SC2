	PROCEDURE hpacert.PF1.pgCert.lblStockLst_ID.Click
		
		PRIVATE cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,cTBL,nQTY,lRL,cPOitem
		cAlloy	= GetAlloyStandard( This.parent.txtAlloy.Value, ThisFormSet.nConnhandle )
		cForm	= GetFormStandard(PrepareSQLtxt(This.parent.txtSize.Value,'Size',10))
		
		cCC		= ''
		cCL		= ''
		nThck	= VAL(ThisFormSet.frmCustomer.Description.Value)
		nSz2	= 0
		nSz3	= 0
		cSOItem	= ''
		nSalesNum	= 0
		nPC		= 0
		nLBS	= 0
		PRIVATE cLot,nLot,cHeat,nMachine
		cHeat	= ALLTRIM(PrepareSQLtxt(This.parent.txtHeat.Value,'Heat',40))
		nLot	= PrepareSQLnum(This.parent.txtLot.Value,'Lot',5,0)
		cHeatLot = cHeat
		nMachine	= PrepareSQLnum(This.parent.grpMach.Value,'Machine',1,0)
		DO CASE
		CASE nMachine = 1
			cLot = ""+ALLTRIM(STR(nLot))
		CASE nMachine = 2
			cHeatLot = "G"+ALLTRIM(STR(nLot))
		CASE nMachine = 3
			cHeatLot = "R"+ALLTRIM(STR(nLot))
		CASE nMachine = 4
			cHeatLot = "L"+ALLTRIM(STR(nLot))
		OTHERWISE
			cLot = ''
		ENDCASE
		* cHeatLot Use GFM lot,R,L only if found! Do not also pass Heat.
		
		cTBL	= 'S'
		nQTY	= 0
		lRL		= .F.
		cPOitem = ''
		
		PRIVATE nID_Detail
		nID_Detail = 0
		
		*old DO FORM Forms\StockLst_SQL_Quotes WITH "GET",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem TO nID_Detail 
		*DO FORM Forms\StockLst_SQL_Browse WITH "GET",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem TO nID_Detail 
		DO FORM Forms\StockLst_SQL_Modal WITH "GET",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem TO nID_Detail 
		*                        PARAMETER pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
		
		IF nID_Detail > 0
			PRIVATE nStkID
			nStkID = 0
			nStkID = GetIDfromID_Detail( nID_Detail, 'S', ThisFormSet.nConnhandle)
			
			PRIVATE nID
			nID		= PrepareSQLnum(This.parent.txtID.Value,'ID',-3)
			
			
			IF nStkID > 0 
				This.parent.txtStockLst_ID.Value = nStkID
				
				IF NOT ThisFormSet.isediting AND nID > 0
					PRIVATE nMess
					nMess=MESSAGEBOX("Do you want to save this StockLst_ID to the Cert Now (Y)",4+64,"Save")
					IF nMess = 6
						*Update
						cSQL = "UPDATE dbo.Cert SET "
						cSQL = cSQL +" StockLst_ID="+ALLTRIM(STR(nStkID))
						cSQL = cSQL +" WHERE ID="+STR(nID)
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							MESSAGEBOX("Try to edit and try to save again."+CHR(13)+"",16,"Record could not be saved")
							* Does not belong to Windfall\Certs AD group
						ELSE
							WAIT WINDOW 'Saved StockLst_ID' NOWAIT
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.txtAl.When
