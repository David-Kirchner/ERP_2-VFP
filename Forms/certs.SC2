	PROCEDURE hpacert.PF1.pgCert.lblPO.Click
		IF ThisFormSet.isediting
			PRIVATE cPOItem, cSQL, nSQLEXEC 
			
			cPOItem = PrepareSQLtxt(This.parent.txtTestPO.Value,'POitem',12)
			IF Proper_PO_item(cPOItem) = Proper_PO_item()
				DO FORM Forms\SelectPO_item TO cPOItem
			ELSE
				IF VAL(cPOitem) > 0
					DO FORM Forms\ChoosePOitem WITH VAL(cPOitem) TO cPoItem
				ENDIF
			ENDIF
			
			IF Proper_PO_item(cPOItem) != Proper_PO_item()
				This.parent.txtTestPO.Value = cPOItem
				
				PRIVATE nHPApo
				nHPApo = VAL(cPOitem)
				
				IF USED('tmpCompanyPO')
					USE IN tmpCompanyPO
				ENDIF
				SELECT 0
		
			
				cSQL = "SELECT Company FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE HPApo = "+STR(nHPApo)
		
				
				nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpCompanyPO' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpCompanyPO' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompanyPO")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompanyPO")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.ConnHandle,nSQLEXEC, 'tmpCompanyPO' )
				ENDIF
				
				
				IF USED('tmpCompanyPO')
					IF RECCOUNT('tmpCompanyPO') > 0
						IF NOT EMPTY(tmpCompanyPO.Company)
							This.parent.txtLabUsed.Value = tmpCompanyPO.Company
						ENDIF
						
					ENDIF
					USE IN tmpCompanyPO
				ENDIF
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.lblPO2.Click
		IF ThisFormSet.isediting
			PRIVATE cPOItem, cSQL, nSQLEXEC 
			
			cPOItem = PrepareSQLtxt(This.parent.txtTestPO2.Value,'POitem',12)
			IF Proper_PO_item(cPOItem) = Proper_PO_item()
