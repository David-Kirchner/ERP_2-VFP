		ThisFormset.hpacert.PF1.pgCert.txtSignDate.Value= PrepareSQLdate(HPACert.SignDate,'SignDate',.F.,.T.)
		
		************************************************
		
		PRIVATE nCurRec, nLot, nCLot, cHeat, nCHeat, nMachine, cTalk
		cHeat	= PrepareSQLtxt(HPACert.Heat,'Heat',40)
		nLot	= PrepareSQLnum(HPACert.Lot,'Lot',5,0)
		nMachine= PrepareSQLnum(HPACert.machine,'Machine',1,0)
		
		IF NOT EMPTY(cHeat)
			IF USED("tmpCert")
				SELECT tmpCert
			ELSE
				SELECT 0
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Cert WHERE HEAT = '"+cHeat+"'"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert')
			ENDIF
		
			IF USED('tmpCert')
				ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = tmpCert.Cntd
				USE IN tmpCert
			ELSE
				ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = 0
			ENDIF
			
		ELSE
			ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = 0
		ENDIF
		
		***********************************************************
		
		
		IF NOT nLot=0
			IF nMachine > 0
		*		CALCULATE COUNT() FOR Lot = nLot AND Machine = nMachine  TO nCLot
				IF USED("tmpCert")
					SELECT tmpCert
				ELSE
					SELECT 0
				ENDIF
		
				cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Cert WHERE Lot="+STR(nLot)
				
				IF NOT EMPTY(nMachine)
					cSQL=cSQL+" AND Machine="+STR(nMachine)
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert')
				ENDIF
		
				IF USED('tmpCert')
					ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = tmpCert.Cntd
					USE IN tmpCert
				ELSE
					ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = 0
				ENDIF	
			ELSE
				ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = 0
			ENDIF
		ELSE
			ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = 0
		ENDIF
		******************************************
		
		PRIVATE nCO_ID
		nCO_ID = 0
		
		IF USED("HPACert_Co")
			ThisFormset.frmCustomer.grdCO.RecordSource = ""
			USE IN HPACert_Co
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.Cert_Co WHERE ID = "+STR(HPACert.ID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert_Co')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'HPACert_Co')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert_Co')
		ENDIF
		
		IF USED('HPACert_Co')
			ThisFormset.frmCustomer.grdCO.RecordSource = "HPACert_Co"
			ThisFormset.frmCustomer.grdCO.ColumnCount = 3
			ThisFormset.frmCustomer.grdCO.Column1.Header1.Caption = "CO_ID"
			ThisFormset.frmCustomer.grdCO.Column1.ControlSource = "HPACert_Co.CO_ID"
			ThisFormset.frmCustomer.grdCO.Column2.Header1.Caption = "Company"
			ThisFormset.frmCustomer.grdCO.Column2.ControlSource = "HPACert_Co.Company"
			ThisFormset.frmCustomer.grdCO.Column2.Width = 200
			ThisFormset.frmCustomer.grdCO.Column2.Text1.Alignment = 0
		
			ThisFormset.frmCustomer.grdCO.Column3.Header1.Caption = "SO item"
			ThisFormset.frmCustomer.grdCO.Column3.ControlSource = "HPACert_Co.SOitem"
			
			ThisFormSet.RefreshHpaCertCo(HPACert_Co.CO_ID)
		ELSE
			ThisFormSet.RefreshHpaCertCo(0)
		ENDIF
		**********************************************
		
		
		IF USED("tmpCert_RC_Cnt")
			USE IN tmpCert_RC_Cnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Cert_RC_Profile WHERE CertID = "+STR(HPACert.ID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert_RC_Cnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCert_RC_Cnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_RC_Cnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_RC_Cnt")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert_RC_Cnt')
		ENDIF
		
		IF USED('tmpCert_RC_Cnt')
			IF RECCOUNT('tmpCert_RC_Cnt')>0
				IF tmpCert_RC_Cnt.Cntd > 0
					*ThisFormSet.frmSpaceX.Visible = .T.	
					ThisFormSet.ShowSpaceXHardness()
				ELSE
					ThisFormSet.frmSpaceX.Visible = .F.
				ENDIF
			ELSE
				ThisFormSet.frmSpaceX.Visible = .F.
			ENDIF
			USE IN tmpCert_RC_Cnt
		ELSE
			ThisFormSet.frmSpaceX.Visible = .F.
		ENDIF
		**********************************************
		
		SELECT HPACert
	ENDPROC

	PROCEDURE reload
	ENDPROC

