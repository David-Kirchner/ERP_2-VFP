					*loEmailItem.Send
					*loApp.Quit()
					RELEASE loApp, loEmailItem
					
					WAIT WINDOW "Click on the blinking Outlook window to address you Email" NOWAIT
					IF FILE(cFileName)
						DELETE FILE (cFileName)
					ENDIF
				ELSE
			*!*			WAIT WINDOW "Making PDF" TIMEOUT 1	
			*!*			PRIVATE nCount
			*!*			nCount = 0
			*!*			DO WHILE NOT FILE(cFileName) AND nCount < 3
			*!*				WAIT WINDOW "Waiting for file:"+cFileName+" to be made." TIMEOUT 1
			*!*				nCount = nCount + 1
			*!*			ENDDO
			*!*			
			*!*			PRIVATE cEmailTo, cEmailFrom, cSubject, cMessage
