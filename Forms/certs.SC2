	PROCEDURE setcert_co_edit
		PARAMETERS pBit
		
		*ThisFormSet.SetCert_CO_Edit(1)
		
		IF VARTYPE(pBit) = "N"
			IF pBit = 0
				ThisFormSet.frmCustomer.cmdAdd.Caption = "Add"
				ThisFormSet.frmCustomer.cmdEdit.Caption = "Edit"
				ThisFormSet.frmCustomer.cmdClone.Enabled = .T.
				ThisFormSet.frmCustomer.cmdBlank.Enabled = .T.
				ThisFormSet.frmCustomer.cmdDelete.Enabled = .T.
				
				ThisFormSet.isediting_co = .F.
			ELSE
				ThisFormSet.frmCustomer.cmdAdd.Caption = "Save"
				ThisFormSet.frmCustomer.cmdEdit.Caption = "Abort"
				ThisFormSet.frmCustomer.cmdClone.Enabled = .F.
				ThisFormSet.frmCustomer.cmdBlank.Enabled = .F.
				ThisFormSet.frmCustomer.cmdDelete.Enabled = .F.
						
				ThisFormSet.isediting_co = .T.
			ENDIF
		ENDIF
	ENDPROC

