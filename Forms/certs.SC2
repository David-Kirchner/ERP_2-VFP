			*!*			cEmailFrom = ''
			*!*			cSubject = ''
			*!*			cMessage = ''
			*!*			
			*!*			cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName)
			*!*			
			*!*			DO CASE
			*!*			CASE "Mail queued" $ cAns
			*!*				WAIT WINDOW "Mail queued." NOWAIT
			*!*			CASE NOT EMPTY(cAns)
			*!*				MESSAGEBOX( cANS,0,"SQL Returned Message!")
			*!*			OTHERWISE
			*!*				WAIT WINDOW "Email Complete" NOWAIT
			*!*			ENDCASE
				ENDIF
			ELSE
				MESSAGEBOX("Failed to create file."+CHR(13)+cFileName,16,"File not Created.")
			ENDIF
				
			IF FILE(cFileName)
				DELETE FILE (cFileName)
			ENDIF
		
		ENDIF
		
		SELECT HPACert
		IF m.currntrecrd <= RECCOUNT('HPACert')
			GOTO m.currntrecrd
		ELSE
			GO TOP
		ENDIF
		
	ENDPROC

