	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.txtAlloy.Valid
		PRIVATE cAlloy, cUNS
		cAlloy = PrepareSQLtxt(HPAcert.alloy,'Alloy',12,.F.,.T.)  &&Actually 35 is allowed, getAlloyStandard max is 12
		
		
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(LEFT(This.Value,12))
		cAlloyStandard = ''
		
		IF NOT EMPTY(pCurAlloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisFormSet.nConnhandle )
			
			IF NOT EMPTY(cAlloyStandard)
		*		This.Value = cAlloyStandard
				cAlloy = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				*RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				*MESSAGEBOX("Alloy '"+pCurAlloy+"' is unknown."+CHR(13)+"Use Quotes-Alloys Standard program to add a new Alloy.",0+64,"Unkown Alloy.")
				*RETURN .F.
			ENDIF
			
		ENDIF
		
		IF NOT EMPTY(cAlloyStandard)
			PRIVATE cUNS 
			cUNS = ''
			cUNS = GetUNS( cAlloyStandard,0 )
			IF NOT EMPTY(cUNS)
				ThisForm.PF1.pgCert.txtUNS.Value = cUNS 
			ENDIF
		ENDIF
	ENDPROC

