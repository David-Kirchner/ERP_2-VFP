	PROCEDURE searchheat
		*ThisFormSet.SearchHeat()
		
		PRIVATE nID, cSearchHeat
		nID 	= HPACert.ID
		cSearchHeat	= PrepareSQLtxt(ThisFormSet.HPACert.PF1.pgCert.txtGetHeat.Value,'Heat',40)
		
		ThisFormSet.cSearchHeat = cSearchHeat
		
		IF USED("tmpCountHPACert")
			SELECT tmpCountHPACert
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Cert WHERE HEAT LIKE '%"+cSearchHeat+"%'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountHPACert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCountHPACert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountHPACert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountHPACert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountHPACert')
		ENDIF
		IF USED('tmpCountHPACert')
			SELECT tmpCountHPACert
			IF tmpCountHPACert.CNTD > 0
				*WAIT WINDOW "Found "+ALLTRIM(STR(tmpCountHPACert.CNTD))+" records contain "+ALLTRIM(cSearchHeat)+" in the Heat name." NOWAIT
				
				ThisFormSet.Get_Cert('SEARCHHEAT',cSearchHeat)
				ThisFormSet.HPACert.PF1.pgCert.cmdUnFilter.Visible = .T.
				
			ELSE
				MESSAGEBOX("Heat:"+ALLTRIM(cSearchHeat)+" was not found!",0+48,"No Heat to show!")
				ThisFormSet.cSearchHeat = ''
				RETURN
			ENDIF
			USE IN tmpCountHPACert
		ENDIF
		
		
		ThisFormSet.HPACert.PF1.pgCert.Refresh
		
	ENDPROC

	PROCEDURE searchlot
		*ThisFormSet.SearchLot()
		
		PRIVATE nID, nLot
		nID 	= HPACert.ID
		nLot	= PrepareSQLnum(ThisFormSet.HPACert.PF1.pgCert.txtGetLot.Value,'Lot',-3)
		
		IF nLot = 0
			PRIVATE cLot
			cLot = PrepareSQLtxt(ThisFormSet.HPACert.PF1.pgCert.txtGetLot.Value,'LOT',10)
		
			IF LEN(cLot)>1
				IF PrepareSQLnum( LEFT(cLot,1),'Lot',1) = 0
					*Drop first letter  Could be 'G4229'
					nLot = PrepareSQLnum( RIGHT(cLot, LEN(cLot)-1 ) ,'Lot',5,0)
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpCountHPACert")
			SELECT tmpCountHPACert
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Cert WHERE LOT = "+STR(nLot)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountHPACert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCountHPACert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountHPACert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountHPACert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountHPACert')
		ENDIF
		IF USED('tmpCountHPACert')
			SELECT tmpCountHPACert
			IF tmpCountHPACert.CNTD > 0
				WAIT WINDOW "Found "+ALLTRIM(STR(tmpCountHPACert.CNTD))+" records with the Lot:"+ALLTRIM(STR(nLot))+"." NOWAIT
				
				
				ThisFormSet.Get_Cert('LOT',nLot)
				ThisFormSet.HPACert.PF1.pgCert.cmdUnFilter.Visible = .T.
				
			ELSE
				MESSAGEBOX("Lot:"+ALLTRIM(STR(nLot))+" was not found!",0+48,"No Heat to show!")
				RETURN
			ENDIF
			USE IN tmpCountHPACert
		ENDIF
		
		
		ThisFormSet.HPACert.PF1.pgCert.Refresh
		
		
		
		
	ENDPROC

	PROCEDURE selectcertid
		PARAMETER nID
		*ThisFormSet.SelectCertID(ID)
		
		IF VARTYPE(nID) != 'N'
			nID = 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT TOP 1 * FROM dbo.Cert WHERE ID="+STR(nID)
		
		IF USED("HPACert")
			SELECT HPACert
			TABLEREVERT(.T.,'HPACert')  &&CURSORSETPROP is not used!, rewrite so this old command can be dropped
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert')
		ENDIF
		
		
		PRIVATE nCO_ID
		nCO_ID = 0
		
		
		IF USED("HPACert_Co")
			ThisFormset.frmCustomer.grdCO.RecordSource = ""
			USE IN HPACert_Co
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.Cert_Co WHERE ID = "+STR(nID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert_Co')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'HPACert_Co')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert_Co')
		ENDIF
		
		IF USED('HPACert_Co')
			ThisFormset.frmCustomer.grdCO.RecordSource = "HPACert_Co"
			ThisFormset.frmCustomer.grdCO.ColumnCount = 3
			ThisFormset.frmCustomer.grdCO.Column1.Header1.Caption = "CO_ID"
			ThisFormset.frmCustomer.grdCO.Column1.ControlSource = "HPACert_Co.CO_ID"
			
			ThisFormset.frmCustomer.grdCO.Column2.Header1.Caption = "Company"
			ThisFormset.frmCustomer.grdCO.Column2.ControlSource = "HPACert_Co.Company"
			*ThisFormset.frmCustomer.grdCO.Column2.Width = 200
			*ThisFormset.frmCustomer.grdCO.Column2.Text1.Alignment = 0
			
			ThisFormset.frmCustomer.grdCO.Column3.Header1.Caption = "SO item"
			ThisFormset.frmCustomer.grdCO.Column3.ControlSource = "HPACert_Co.SOitem"
			
			ThisFormSet.RefreshHpaCertCo(HPACert_Co.CO_ID)
		ELSE
			ThisFormSet.RefreshHpaCertCo(0)
		ENDIF
		
		
		
	ENDPROC

