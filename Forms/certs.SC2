		Width = 100
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'frmCheckSpec' AS form WITH ;
		AlwaysOnTop = .T., ;
		BackColor = 0,0,255, ;
		Caption = "Check Spec.", ;
		Closable = .F., ;
		ControlBox = .F., ;
		DoCreate = .T., ;
		HalfHeightCaption = .T., ;
		Height = 193, ;
		Left = 668, ;
		Name = "frmCheckSpec", ;
		ShowTips = .T., ;
		Top = 317, ;
		Visible = .F., ;
		Width = 456
		*< END OBJECT: BaseClass="form" />

	ADD OBJECT 'frmCheckSpec.cmbGroup' AS combobox WITH ;
		ColumnCount = (ALEN(aGroup,2)), ;
		ColumnWidths = "", ;
		ControlSource = "m.Group", ;
		FirstElement = 1, ;
		ForeColor = 0,0,255, ;
		Height = 24, ;
		Left = 27, ;
		Name = "cmbGroup", ;
		NumberOfElements = (ALEN(aGroup)), ;
		RowSource = "aGroup", ;
		RowSourceType = 5, ;
		TabIndex = 4, ;
		Top = 40, ;
		Width = 100
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'frmCheckSpec.cmbRev' AS combobox WITH ;
		ColumnCount = (ALEN(aRev,2)), ;
		ColumnWidths = "", ;
		ControlSource = "m.Rev", ;
		FirstElement = 1, ;
		ForeColor = 0,0,255, ;
		Height = 24, ;
		Left = 364, ;
		Name = "cmbRev", ;
		NumberOfElements = (ALEN(aRev)), ;
		RowSource = "aRev", ;
		RowSourceType = 5, ;
		TabIndex = 8, ;
		Top = 40, ;
		Width = 76
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'frmCheckSpec.cmbSpec' AS combobox WITH ;
		ColumnCount = 1, ;
		ControlSource = "m.spec", ;
		FirstElement = 1, ;
		ForeColor = 0,0,255, ;
		Height = 24, ;
		IncrementalSearch = .T., ;
		Left = 134, ;
		Name = "cmbSpec", ;
		NumberOfElements = (ALEN(aSpec)), ;
		RowSource = "aSpec", ;
		RowSourceType = 5, ;
		TabIndex = 6, ;
		Top = 40, ;
		Width = 218
		*< END OBJECT: BaseClass="combobox" />

