		ThisFormset.hpacert.PF1.pgCert.txtYld3.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtRa3.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtEl3.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtHardness3.Value = ' '
		ThisFormset.hpacert.PF1.pgCert.txtBHN3.Value = 0
		ThisFormset.hpacert.PF1.pgCert.txttLoc3.Value = ''
		
		ThisFormset.hpacert.PF1.pgCert.txtUlt4.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtYld4.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtRa4.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtEl4.Value = ''
		*ThisFormset.hpacert.PF1.pgCert.txtHardness4.Value = ' '
		*ThisFormset.hpacert.PF1.pgCert.txtBHN4.Value = 0
		ThisFormset.hpacert.PF1.pgCert.txttLoc4.Value = ''
		
		ThisFormset.hpacert.PF1.pgCert.txtUlt5.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtYld5.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtRa5.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtEl5.Value = ''
		*ThisFormset.hpacert.PF1.pgCert.txtHardness5.Value = ' '
		*ThisFormset.hpacert.PF1.pgCert.txtBHN5.Value = 0
		ThisFormset.hpacert.PF1.pgCert.txttLoc5.Value = ''
		
		ThisFormset.hpacert.PF1.pgCert.txtUlt6.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtYld6.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtRa6.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtEl6.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txttLoc6.Value = ''
		
		ThisFormset.hpacert.PF1.pgCert.txtUlt7.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtYld7.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtRa7.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtEl7.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txttLoc7.Value = ''
		
		ThisFormset.hpacert.PF1.pgCert.txtSpecLMA.Value = ''
		ThisFormset.hpacert.PF1.pgCert.txtSpecSpaceX.Value = ''
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpROLLlog')	
			USE IN tmpROLLlog
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Roll_LOG WHERE Lot = "+STR(nLot)
				
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpROLLlog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpROLLlog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpROLLlog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpROLLlog")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpROLLlog')
			RETURN
		ELSE
			IF USED('tmpROLLlog')
				IF RECCOUNT('tmpROLLlog') > 0
		
					IF tmpROLLlog.heat != cHeat
						IF AT('-',tmpROLLlog.heat,1) > 1
							cgfmlogHeat = LEFT(tmpROLLlog.heat,AT('-',tmpROLLlog.heat,1)-1)
						ELSE
							cgfmlogHeat = ALLTRIM(tmpROLLlog.heat)
						ENDIF
						IF AT('-',cHeat,1) > 1
							cCertHeat = LEFT(cHeat,AT('-',cHeat,1)-1)
						ELSE
							cCertHeat = ALLTRIM(cHeat)
						ENDIF
						
						IF cgfmlogHeat != cCertHeat 
							MESSAGEBOX("Roll LOG Heat:"+cgfmlogHeat+" does not match Cert Heat:"+cCertHeat ,16,"Heat numbers do not match!")
						ENDIF
					ENDIF
		
					SELECT HPACERT
					ThisFormset.hpacert.PF1.pgCert.txtUlt.Value = tmpROLLlog.tensile
					ThisFormset.hpacert.PF1.pgCert.txtYield.Value = tmpROLLlog.yield
					ThisFormset.hpacert.PF1.pgCert.txtElong.Value = tmpROLLlog.elongation
					ThisFormset.hpacert.PF1.pgCert.txtElonInches.Value = "4D"
					ThisFormset.hpacert.PF1.pgCert.txtRA.Value = tmpROLLlog.red_area
					
					ThisFormset.hpacert.PF1.pgCert.txtHardness.Value = IIF(!empty(tmpROLLlog.rockwell),"R"+LOWER(tmpROLLlog.rockwell)," ")
					ThisFormset.hpacert.PF1.pgCert.txtBHN.Value = tmpROLLlog.bhn
					ThisFormset.hpacert.PF1.pgCert.txttLoc1.Value = '' &&tmpROLLlog.tLoc
					
					ThisFormset.hpacert.PF1.pgCert.txtLot.Value = nLot
					ThisFormset.hpacert.PF1.pgCert.txtReference.Value = 'Roll'
					ThisFormset.hpacert.PF1.pgCert.grpMach.Value = 3
					ThisFormset.hpacert.PF1.pgCert.txtDateCert.Value = tmpROLLlog.testsent+3
					ThisFormset.hpacert.PF1.pgCert.txtDateProd.Value = tmpROLLlog.date
					ThisFormset.hpacert.PF1.pgCert.txtAlloy.Value = tmpROLLlog.ALLOYNAME    &&C12
					ThisFormset.hpacert.PF1.pgCert.txtHeat.Value =  tmpROLLlog.heat         &&C35
					ThisFormset.hpacert.PF1.pgCert.txtSize.Value = "Bar"
					ThisFormset.hpacert.PF1.pgCert.txtSpec.Value = tmpROLLlog.SPEC         &&C40
					
					ThisFormset.hpacert.PF1.pgCert.txtLabUsed.Value = tmpROLLlog.lab 
					ThisFormset.hpacert.PF1.pgCert.txtTestPO.Value = tmpROLLlog.TestPO
					ThisFormset.hpacert.PF1.pgCert.txtLabUsed2.Value = '' &&tmpROLLlog.lab2
					ThisFormset.hpacert.PF1.pgCert.txtTestPO2.Value = '' &&tmpROLLlog.TestPO2
			
					ThisFormset.hpacert.PF1.pgCert.txtUlt2.Value = tmpROLLlog.Tensile2
					ThisFormset.hpacert.PF1.pgCert.txtYld2.Value = tmpROLLlog.Yield2
					ThisFormset.hpacert.PF1.pgCert.txtEl2.Value = tmpROLLlog.elongation2
					ThisFormset.hpacert.PF1.pgCert.txtRA2.Value = tmpROLLlog.red_area2
					ThisFormset.hpacert.PF1.pgCert.txtHardness2.Value = IIF(!empty(tmpROLLlog.rockwell2),"R"+LOWER(tmpROLLlog.rockwell2)," ")
					ThisFormset.hpacert.PF1.pgCert.txtBHN2.Value = tmpROLLlog.BHN2
					ThisFormset.hpacert.PF1.pgCert.txtEloninches2.Value = ' '
					ThisFormset.hpacert.PF1.pgCert.txttLoc2.Value = '' &&tmpROLLlog.tLoc2
					
					ThisFormset.hpacert.PF1.pgCert.txtUlt3.Value = tmpROLLlog.Tensile3
					ThisFormset.hpacert.PF1.pgCert.txtYld3.Value = tmpROLLlog.Yield3
					ThisFormset.hpacert.PF1.pgCert.txtEl3.Value = tmpROLLlog.elongation3
					ThisFormset.hpacert.PF1.pgCert.txtRA3.Value = tmpROLLlog.red_area3
					ThisFormset.hpacert.PF1.pgCert.txtHardness3.Value = IIF(!empty(tmpROLLlog.rockwell3),"R"+LOWER(tmpROLLlog.rockwell3)," ")
					ThisFormset.hpacert.PF1.pgCert.txtBHN3.Value = tmpROLLlog.BHN3
					ThisFormset.hpacert.PF1.pgCert.txtEloninches3.Value = ' '
					ThisFormset.hpacert.PF1.pgCert.txttLoc3.Value = '' &&tmpROLLlog.tLoc3
					
					ThisFormset.hpacert.PF1.pgCert.txtUlt4.Value = 0 &&tmpROLLlog.Tensile4
					ThisFormset.hpacert.PF1.pgCert.txtYld4.Value = 0 &&tmpROLLlog.Yield4
					ThisFormset.hpacert.PF1.pgCert.txtEl4.Value = 0 &&tmpROLLlog.elongation4
					ThisFormset.hpacert.PF1.pgCert.txtRA4.Value = 0 &&tmpROLLlog.red_area4
		*			ThisFormset.hpacert.PF1.pgCert.txtHardness4.Value = '' &&IIF(!empty(tmpROLLlog.rockwell4),"R"+LOWER(tmpROLLlog.rockwell4)," ")
		*			ThisFormset.hpacert.PF1.pgCert.txtBHN4.Value = 0 &&tmpROLLlog.BHN3
					ThisFormset.hpacert.PF1.pgCert.txtEloninches4.Value = ' '
					ThisFormset.hpacert.PF1.pgCert.txttLoc4.Value = '' &&tmpROLLlog.tLoc4
					
					ThisFormset.hpacert.PF1.pgCert.txtUlt5.Value = 0 &&tmpROLLlog.Tensile5
					ThisFormset.hpacert.PF1.pgCert.txtYld5.Value = 0 &&tmpROLLlog.Yield5
					ThisFormset.hpacert.PF1.pgCert.txtEl5.Value = 0 &&tmpROLLlog.elongation5
					ThisFormset.hpacert.PF1.pgCert.txtRA5.Value = 0 &&tmpROLLlog.red_area5
		*			ThisFormset.hpacert.PF1.pgCert.txtHardness5.Value = '' &&IIF(!empty(tmpROLLlog.rockwell5),"R"+LOWER(tmpROLLlog.rockwell5)," ")
		*			ThisFormset.hpacert.PF1.pgCert.txtBHN5.Value = 0 &&tmpROLLlog.BHN5
					ThisFormset.hpacert.PF1.pgCert.txtEloninches5.Value = ' '
					ThisFormset.hpacert.PF1.pgCert.txttLoc5.Value = '' &&tmpROLLlog.tLoc5
					
					ThisFormset.hpacert.PF1.pgCert.txtUlt6.Value = 0 &&tmpROLLlog.Tensile5
					ThisFormset.hpacert.PF1.pgCert.txtYld6.Value = 0 &&tmpROLLlog.Yield5
					ThisFormset.hpacert.PF1.pgCert.txtEl6.Value = 0 &&tmpROLLlog.elongation5
					ThisFormset.hpacert.PF1.pgCert.txtRA6.Value = 0 &&tmpROLLlog.red_area5
					ThisFormset.hpacert.PF1.pgCert.txtEloninches6.Value = ' '
					ThisFormset.hpacert.PF1.pgCert.txttLoc6.Value = '' &&tmpROLLlog.tLoc5
					
					ThisFormset.hpacert.PF1.pgCert.txtUlt7.Value = 0 &&tmpROLLlog.Tensile5
					ThisFormset.hpacert.PF1.pgCert.txtYld7.Value = 0 &&tmpROLLlog.Yield5
					ThisFormset.hpacert.PF1.pgCert.txtEl7.Value = 0 &&tmpROLLlog.elongation5
					ThisFormset.hpacert.PF1.pgCert.txtRA7.Value = 0 &&tmpROLLlog.red_area5
					ThisFormset.hpacert.PF1.pgCert.txtEloninches7.Value = ' '
					ThisFormset.hpacert.PF1.pgCert.txttLoc7.Value = '' &&tmpROLLlog.tLoc5
					
					
					ThisFormset.hpacert.PF1.pgCert.txtSpecLMA.Value = ' '
					ThisFormset.hpacert.PF1.pgCert.txtSpecSpaceX.Value = ' '
					
					PRIVATE cUNS
					cUNS = GetUNS( tmpROLLlog.ALLOYNAME, ThisFormSet.nConnHandle)
					IF !EMPTY(cUNS)
						ThisFormset.hpacert.PF1.pgCert.txtUNS.Value = cUNS
					ENDIF
					
					isadding=.T.
					ThisFormSet.SetEditing()
					
					ThisFormset.hpacert.PF1.pgCert.txtGetHeat.Value = ThisFormset.hpacert.PF1.pgCert.txtHeat.Value
					ThisFormset.hpacert.PF1.pgCert.txtGetLot.Value = PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtLot.Value,'Lot',10)		
					*MESSAGEBOX("Clone is ready")
				ENDIF
				
				USE IN tmpROLLlog
			ELSE
		
		*		Cancel CLONE FROM lot
				ThisFormSet.isediting=.F.
				isadding=.F.
				= MESSAGEBOX("Roll log Not found!  NO DATA CLONED!",16)
				SELECT HPACERT
				SET ORDER TO heat
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE get_cert		&& Replaced GetCert, would cause VFP to Exit.
		PARAMETERS pTitle, pData
		*ThisFormSet.Get_Cert('ID',2)
		
		PRIVATE cTitle, cData
		IF VARTYPE(pTitle) != 'C'
			cTitle = ''
			cData = ''
		ELSE
			DO CASE
			CASE pTitle = 'SEARCHHEAT'
				cTitle = 'SEARCHHEAT'
				cData = pData
			CASE pTitle = 'HEAT'
				cTitle = 'HEAT'
				cData = pData
			CASE pTitle = 'LOT'
				cTitle = 'LOT'
				IF VARTYPE(pData)="N"
					cData = STR(pData)
				ELSE
					cData = pData
				ENDIF
				IF VARTYPE(cData) != 'C'
					cData = ''
				ENDIF
		
			CASE pTitle = 'ID'
				cTitle = 'ID'
				IF VARTYPE(pData)="N"
					cData = STR(pData)
				ELSE
					cData = pData
				ENDIF
				IF VARTYPE(cData) != 'C'
					cData = ''
				ENDIF
			OTHERWISE
				cTitle = ''
				cData = ''
			ENDCASE
		ENDIF
		
		PRIVATE lGotCert, nReturnCount
		lGotCert = .F.
		nReturnCount = 0
		
		IF USED("HPACert")
			SELECT HPACert
			TABLEREVERT(.T.,'HPACert') &&CURSORSETPROP is not used!, rewrite so this old command can be dropped
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, nHeatCnt, nLotCnt
		
		ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = 0
		ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = 0
		ThisFormset.HPACert.PF1.pgCert.cmdBrowse.Visible = .F.
						
		IF EMPTY(cTitle + cData)
			*Just bring back a record
			cSQL = "SELECT TOP 1 * FROM dbo.Cert "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert')
			ELSE
				SELECT HPACert
				IF RECCOUNT('HPACert') > 0
					lGotCert = .T.
					nReturnCount = 1
					
					nHeatCnt = Count_Cert_Heat( HPACert.Heat, ThisFormSet.nConnHandle )
					ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
					nLotCnt = Count_Cert_Heat_Lot( HPACert.Heat, HPACert.Lot, ThisFormSet.nConnHandle )
					ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = nLotCnt
		
				ENDIF
			ENDIF
		ENDIF
		
		IF cTitle = 'SEARCHHEAT' AND NOT EMPTY(cData) 
			*ThisFormSet.Get_Cert('SEARCHHEAT',cData)
			cData = PrepareSQLtxt(cData,'Heat',40,.F.)
		
			cSQL = "SELECT * FROM dbo.Cert WHERE HEAT LIKE '%"+cData+"%'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'HPACert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert')
			ELSE
				SELECT HPACert
				IF RECCOUNT('HPACert') > 0
					lGotCert = .T.
				ENDIF
			ENDIF
		
			IF lGotCert 
			
				SELECT HPACert
				PRIVATE nID
				nID = HPACert.ID
				*BROWSE FIELDS Alloy,size,Heat,Machine,Lot,spec,spec2,uns,ult1,yield1,Elong1,Ra1,Heattreat,Hardness NODELETE NOEDIT TITLE "Esc to leave" 
				IF nID != HPACert.ID
					ThisFormSet.Get_Cert('ID',HPACert.ID )
					ThisForm.PF1.pgCert.Refresh
				ENDIF
		
				nHeatCnt = Count_Cert_Heat( HPACert.Heat, ThisFormSet.nConnHandle )
				ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
				nLotCnt = Count_Cert_Heat_Lot( HPACert.Heat, HPACert.Lot, ThisFormSet.nConnHandle )
				ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = nLotCnt
				IF nHeatCnt > 1 OR nLotCnt > 1
					ThisFormset.HPACert.PF1.pgCert.cmdBrowse.Visible = .T.
				ENDIF
			ELSE
				MESSAGEBOX("Heat:"+ALLTRIM(cData)+" was not found!",0+48,"No Heat to show!")
			ENDIF
		ENDIF
		
		IF cTitle = 'HEAT' AND NOT EMPTY(cData) 
			*ThisFormSet.Get_Cert('HEAT',cData)
			cData = PrepareSQLtxt(cData,'Heat',40,.F.)
		
			nHeatCnt = Count_Cert_Heat( cData, ThisFormSet.nConnHandle )
			IF nHeatCnt > 0
				cSQL = "SELECT * FROM dbo.Cert WHERE HEAT = '"+cData+"'"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert')
				ELSE
					SELECT HPACert
					IF RECCOUNT('HPACert') > 0
						lGotCert = .T.
						nReturnCount = nHeatCnt 
					ENDIF
				ENDIF
						
				ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
				nLotCnt = Count_Cert_Heat_Lot( HPACert.Heat, HPACert.Lot, ThisFormSet.nConnHandle )
				ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = nLotCnt
				IF nHeatCnt > 1 OR nLotCnt > 1
					ThisFormset.HPACert.PF1.pgCert.cmdBrowse.Visible = .T.
				ENDIF
			ENDIF
		ENDIF
		
		IF cTitle = 'LOT' AND NOT EMPTY(cData) 
			*ThisFormSet.Get_Cert('LOT',cData)
			
			cData = PrepareSQLtxt(cData,'LOT',5,.F.)
		
			nLotCnt = Count_Cert_Lot( cData, ThisFormSet.nConnHandle )
			IF nLotCnt > 0
				cSQL = "SELECT * FROM dbo.Cert WHERE LOT = "+ALLTRIM(cData)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'HPACert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert')
				ELSE
					SELECT HPACert
					IF RECCOUNT('HPACert') > 0
						lGotCert = .T.
						nReturnCount = nLotCnt 
					ENDIF
				ENDIF
				
				nHeatCnt = Count_Cert_Heat( HPACert.Heat, ThisFormSet.nConnHandle )
				ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = nLotCnt 
				ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
				IF nHeatCnt > 1 OR nLotCnt > 1
					ThisFormset.HPACert.PF1.pgCert.cmdBrowse.Visible = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		
		IF cTitle = 'ID' AND NOT EMPTY(cData) 
			cData = PrepareSQLtxt(cData,'ID',-3)
			PRIVATE nIDCnt
		*	nIDCnt = Count_Cert_ID( cData, ThisFormSet.nConnHandle )   Fake it!
			nIDCnt = 1
			IF nIDCnt > 0
				cSQL = "SELECT * FROM dbo.Cert WHERE ID = "+ALLTRIM(cData)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'HPACert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert')
				ELSE
					SELECT HPACert
					IF RECCOUNT('HPACert') > 0
						lGotCert = .T.
						nIDCnt = RECCOUNT('HPACert')
						nReturnCount = nIDCnt 
						
						nHeatCnt = Count_Cert_Heat( HPACert.Heat, ThisFormSet.nConnHandle )
						ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
						nLotCnt = Count_Cert_Heat_Lot( HPACert.Heat, HPACert.Lot, ThisFormSet.nConnHandle )
						ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = nLotCnt
						IF nHeatCnt > 1 OR nLotCnt > 1
							ThisFormset.HPACert.PF1.pgCert.cmdBrowse.Visible = .T.
						ENDIF
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*********************
		ThisFormSet.Refresh_HpaCert()	
		*ThisFormSet.Get_Cert_Co()
		***************************************
		SELECT HPACert
		
		IF lGotCert 
			RETURN nReturnCount 
		ELSE
			RETURN 0
		ENDIF
		
	ENDPROC

	PROCEDURE hpacertcoblank
		
		IF USED("HPACert_Co")
			USE IN HPACert_Co
		ENDIF
		
		SELECT 0
		
		
		cSQL = "SELECT * FROM dbo.Cert_Co WITH(NOLOCK) WHERE 0>0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert_Co')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert_Co')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert_Co')
		ENDIF
		
		IF USED('HPACert_Co')
		
			SELECT HPACert_Co
		
			ThisFormset.frmCustomer.txtCO_ID.Value	= HPACert_Co.CO_ID
			ThisFormset.frmCustomer.SalesNum.Value	= HPACert_Co.SalesNum
			ThisFormset.frmCustomer.ItemSO.Value	= RIGHT(HPACert_Co.SOitem,2)
			ThisFormset.frmCustomer.Company.Value	= HPACert_Co.Company
			ThisFormset.frmCustomer.POnum.Value		= HPACert_Co.PONum
			ThisFormset.frmCustomer.PartNo.Value	= HPACert_Co.PartNo
			ThisFormset.frmCustomer.Pcs.Value		= HPACert_Co.Pcs
			ThisFormset.frmCustomer.Description.Value	= HPACert_Co.description
		
		ENDIF
		
		
		ThisFormSet.isediting_co = .T.
		ThisFormset.frmCustomer.cmdAdd.Caption = "Add"
		ThisFormset.frmCustomer.cmdEdit.Caption = "Abort"
	ENDPROC

	PROCEDURE Init
		PARAMETER pcHEAT, pcLOT, pcType
		*DO FORMS\Certs WITH pcHEAT, pcLOT, pcType(GFM ROLL LakeErie)
		
		IF VARTYPE(pcHEAT)="C"
			ThisFormSet.pcHEAT = ALLTRIM(pcHEAT)
			ThisFormset.hpacert.PF1.pgCert.txtGetHeat.Value = ALLTRIM(pcHEAT)
		ELSE
			ThisFormSet.pcHEAT = ""
		ENDIF
		
		IF VARTYPE(pcLOT)="C"
			ThisFormSet.pcLOT = pcLOT
		ELSE
			IF VARTYPE(pcLOT)="N"
				ThisFormSet.pnLOT=pcLOT
				ThisFormSet.pcLOT= ALLTRIM(STR(pcLOT))
			ELSE
				ThisFormSet.pcLOT= ""
			ENDIF
		ENDIF
		ThisFormset.frmAddCert.txtLot.Value = ThisFormSet.pcLOT
		ThisFormset.hpacert.PF1.pgCert.txtGetLot.Value = PrepareSQLtxt(ThisFormSet.pcLOT,'Lot',10)
		
		IF VARTYPE(pcType) = "C"
			DO CASE
			CASE pcType = "GFM"
				ThisFormSet.nMachine = 2
			CASE pcType = "ROLL"
				ThisFormSet.nMachine = 3
			CASE pcType = "LakeErie"
				ThisFormSet.nMachine = 4
			OTHERWISE
				ThisFormSet.nMachine = 1
			ENDCASE
			*Machine 1= stnd ,2 GFM, 3 Roll, 4 Lake Erie Press
		ELSE
			ThisFormSet.nMachine = 1
		ENDIF
		
		***************************
		*ThisFormSet.Refresh_HpaCert()
		
		PRIVATE nCount
		nCount = 0
		
		SELECT HpaCert
		DO CASE
		CASE NOT EMPTY(ThisFormSet.pcLOT) AND ThisFormSet.nMachine > 1
			**keep lot up first, most releavent 
			*pcType sets ThisFormSet.nMachine
			nCount = ThisFormSet.Get_Cert('LOT',ThisFormSet.pcLOT)
			
		CASE NOT EMPTY(ThisFormSet.pcHEAT)
			nCount = ThisFormSet.Get_Cert('HEAT',ThisFormSet.pcHeat)
			
		CASE NOT EMPTY(ThisFormSet.pcLOT) 
			**Try lot again, but pcType is unknown 
			nCount = ThisFormSet.Get_Cert('LOT',ThisFormSet.pcLOT)
		
		OTHERWISE
			*Generic get
			nCount = ThisFormSet.Get_Cert("ID",HPACert.ID)
		ENDCASE
		
		IF nCount = 0
			MESSAGEBOX("HPA Cert did not find the Cert you where looking for.",64,"Not found")
		ENDIF
		
		********** Get Cert_Co
		PRIVATE nCO_ID
		nCO_ID = 0
		
		IF USED("HPACert_Co")
			ThisFormset.frmCustomer.grdCO.RecordSource = ""
			USE IN HPACert_Co
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.Cert_Co WHERE ID = "+STR(HPACert.ID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert_Co')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert_Co')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert_Co")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert_Co')
		ENDIF
		
		IF USED('HPACert_Co')
			ThisFormset.frmCustomer.grdCO.RecordSource = "HPACert_Co"
			ThisFormset.frmCustomer.grdCO.ColumnCount = 3
			ThisFormset.frmCustomer.grdCO.Column1.Header1.Caption = "CO_ID"
			ThisFormset.frmCustomer.grdCO.Column1.ControlSource = "HPACert_Co.CO_ID"
			ThisFormset.frmCustomer.grdCO.Column2.Header1.Caption = "Company"
			ThisFormset.frmCustomer.grdCO.Column2.ControlSource = "HPACert_Co.Company"
			ThisFormset.frmCustomer.grdCO.Column2.Width = 200
			ThisFormset.frmCustomer.grdCO.Column2.Text1.Alignment = 0
			
			ThisFormset.frmCustomer.grdCO.Column3.Header1.Caption = "SO item"
			ThisFormset.frmCustomer.grdCO.Column3.ControlSource = "HPACert_Co.SOitem"
		
			ThisFormSet.RefreshHpaCertCo(HPACert_Co.CO_ID)
		ELSE
			ThisFormSet.RefreshHpaCertCo(0)
		ENDIF
		
		PRIVATE nHeatCnt
		nHeatCnt = Count_Cert_Heat( HPACert.Heat, ThisFormSet.nConnHandle )
		ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = nHeatCnt
		ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = Count_Cert_Heat_Lot( HPACert.Heat, HPACert.Lot, ThisFormSet.nConnHandle )
		IF nHeatCnt > 1
			ThisFormset.HPACert.PF1.pgCert.cmdBrowse.Visible = .T.
		ENDIF
	ENDPROC

	PROCEDURE Load
		PUBLIC ARRAY gaCompany(1,2)
		
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT TOP 1 * FROM dbo.Cert WITH(NOLOCK)"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HPACert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HPACert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'HPACert')
		ENDIF
		
	ENDPROC

	PROCEDURE nlotv		&& Funtion to check Lot numbers
	ENDPROC

	PROCEDURE refreshfind_rev
		*ThisForm.RefreshFind_Rev()
		
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ThisformSet.frmCheckSpec.cmbGroup.Value 
		cSpec	= ThisformSet.frmCheckSpec.cmbSpec.Value
		
		DIMENSION aRev(1)
		SELECT DISTINCT Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.Group = cGroup;
		 AND Spec_check.Spec = cSpec;
		 ORDER BY Spec_check.Rev;
		 INTO ARRAY aRev
		 
		ThisformSet.frmCheckSpec.cmbRev.NumberOfElements = ALEN(aRev)
		
		ThisformSet.frmCheckSpec.cmbRev.Value = Spec_Check.Rev
		ThisformSet.frmCheckSpec.cmbRev.Refresh
		
		*******************************
		
		*!*	ThisForm.grdSpecRev.RecordSource='' 
		
		*!*	SELECT DISTINCT Spec_Check.Spec, Spec_Check.Rev;
		*!*	 FROM Spec_Check;
		*!*	 WHERE Spec_Check.group = cGroup;
		*!*	 ORDER BY Spec_Check.Spec, Spec_Check.Rev;
		*!*	 INTO CURSOR cursorSpec
		*!*	 
		*!*	ThisForm.grdSpecRev.RecordSource = 'cursorSpec'
		
		
	ENDPROC

	PROCEDURE refreshfind_spec
		*ThisForm.RefreshFind_Spec()
		PRIVATE cGroup, cSpec, cRev
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		cGroup = ThisFormSet.frmCheckSpec.cmbGroup.Value 
		
		DIMENSION aSpec(1)
		SELECT DISTINCT Spec_check.spec, Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.group = cGroup;
		 ORDER BY Spec_check.spec, Spec_check.rev;
		 INTO ARRAY aSpec
		 
		ThisFormSet.frmCheckSpec.cmbSpec.NumberOfElements = ALEN(aSpec)
		
		cSpec = Spec_Check.Spec
		ThisFormSet.frmCheckSpec.cmbSpec.Value = Spec_Check.Spec
		ThisFormSet.frmCheckSpec.cmbSpec.Refresh
		
		*******************************************************
		ThisFormSet.RefreshFind_Rev()
		
	ENDPROC

	PROCEDURE refreshhpacertco
		PARAMETERS nCO_ID
		*ThisFormSet.RefreshHPAcertCo(CO_ID)
		
		IF nCO_ID > 0
			ThisFormset.frmCustomer.txtCO_ID.Value	= HPACert_Co.CO_ID
			ThisFormset.frmCustomer.SalesNum.Value	= HPACert_Co.SalesNum
			ThisFormset.frmCustomer.ItemSO.Value	= RIGHT(HPACert_Co.SOitem,2)
			ThisFormset.frmCustomer.Company.Value	= HPACert_Co.Company
			ThisFormset.frmCustomer.POnum.Value		= HPACert_Co.PONum
			ThisFormset.frmCustomer.PartNo.Value	= HPACert_Co.PartNo
			ThisFormset.frmCustomer.Pcs.Value		= HPACert_Co.Pcs
			ThisFormset.frmCustomer.Description.Value	= HPACert_Co.description
		ELSE
			ThisFormSet.HPACertCoBlank()
		ENDIF
		
		
	ENDPROC

