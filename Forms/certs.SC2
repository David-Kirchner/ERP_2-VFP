		RETURN 100-m.eltot
		
	ENDPROC

	PROCEDURE convertform		&& Form digit to decription.
		PARAMETER pFORM, pTHCK
		
		DO CASE
		CASE pFORM = "10"
			cForm = "Bar"
		CASE pFORM = "20"
			cForm = "Wire"
		CASE pFORM = "40"
			IF pTHCK > .2
				cForm = "Plate"
			ELSE
				cForm = "Sheet"
			ENDIF
		CASE pFORM = "51"
			cForm = "Coil"
		OTHERWISE
			cForm = " "
		ENDCASE 	
		RETURN cForm
		
	ENDPROC

	PROCEDURE createtable_certspx
		PARAMETERS nCertID
		*CreateTable_CertSPX()
		
		PRIVATE lOK
		lOK = .F.
		
		SELECT 0
		IF USED('CertSPX')
			USE IN CertSPX
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT "
		cSQL=cSQL+" ISNULL([-3.875],0) AS N3875,ISNULL([-3.750],0) AS N3750,ISNULL([-3.625],0) AS N3625,ISNULL([-3.500],0) AS N3500"
		cSQL=cSQL+",ISNULL([-3.375],0) AS N3375,ISNULL([-3.250],0) AS N3250,ISNULL([-3.125],0) AS N3125,ISNULL([-3.000],0) AS N3000"
		cSQL=cSQL+",ISNULL([-2.875],0) AS N2875,ISNULL([-2.750],0) AS N2750,ISNULL([-2.625],0) AS N2625,ISNULL([-2.500],0) AS N2500"
		cSQL=cSQL+",ISNULL([-2.375],0) AS N2375,ISNULL([-2.250],0) AS N2250,ISNULL([-2.125],0) AS N2125,ISNULL([-2.000],0) AS N2000"
		cSQL=cSQL+",ISNULL([-1.875],0) AS N1875,ISNULL([-1.750],0) AS N1750,ISNULL([-1.625],0) AS N1625,ISNULL([-1.500],0) AS N1500"
		cSQL=cSQL+",ISNULL([-1.375],0) AS N1375,ISNULL([-1.250],0) AS N1250,ISNULL([-1.125],0) AS N1125,ISNULL([-1.000],0) AS N1000"
		cSQL=cSQL+",ISNULL([-0.875],0) AS N0875,ISNULL([-0.750],0) AS N0750,ISNULL([-0.625],0) AS N0625,ISNULL([-0.500],0) AS N0500"
		cSQL=cSQL+",ISNULL([-0.375],0) AS N0375,ISNULL([-0.250],0) AS N0250,ISNULL([-0.125],0) AS N0125,ISNULL( [0.000],0) AS P0000"
		cSQL=cSQL+",ISNULL([0.125],0) AS P0125,ISNULL([0.250],0) AS P0250,ISNULL([0.375],0) AS P0375"
		cSQL=cSQL+",ISNULL([0.500],0) AS P0500,ISNULL([0.625],0) AS P0625,ISNULL([0.750],0) AS P0750,ISNULL([0.875],0) AS P0875"
		cSQL=cSQL+",ISNULL([1.000],0) AS P1000,ISNULL([1.125],0) AS P1125,ISNULL([1.250],0) AS P1250,ISNULL([1.375],0) AS P1375"
		cSQL=cSQL+",ISNULL([1.500],0) AS P1500,ISNULL([1.625],0) AS P1625,ISNULL([1.750],0) AS P1750,ISNULL([1.875],0) AS P1875"
		cSQL=cSQL+",ISNULL([2.000],0) AS P2000,ISNULL([2.125],0) AS P2125,ISNULL([2.250],0) AS P2250,ISNULL([2.375],0) AS P2375"
		cSQL=cSQL+",ISNULL([2.500],0) AS P2500,ISNULL([2.625],0) AS P2625,ISNULL([2.750],0) AS P2750,ISNULL([2.875],0) AS P2875"
		cSQL=cSQL+",ISNULL([3.000],0) AS P3000,ISNULL([3.125],0) AS P3125,ISNULL([3.250],0) AS P3250,ISNULL([3.375],0) AS P3375"
		cSQL=cSQL+",ISNULL([3.500],0) AS P3500,ISNULL([3.625],0) AS P3625,ISNULL([3.750],0) AS P3750,ISNULL([3.875],0) AS P3875"
		cSQL=cSQL+" "
		cSQL=cSQL+" FROM "
		cSQL=cSQL+"( SELECT Inch,RockC "
		cSQL=cSQL+"	FROM dbo.Cert_RC_profile WHERE CertID="
		cSQL=cSQL+STR(nCertID)
		cSQL=cSQL+" ) AS p "
		cSQL=cSQL+" PIVOT "
		cSQL=cSQL+"(MAX(RockC) FOR Inch IN "
		cSQL=cSQL+"("
		cSQL=cSQL+" [-3.875],[-3.750],[-3.625],[-3.500],[-3.375],[-3.250],[-3.125],[-3.000]"
		cSQL=cSQL+",[-2.875],[-2.750],[-2.625],[-2.500],[-2.375],[-2.250],[-2.125],[-2.000]"
		cSQL=cSQL+",[-1.875],[-1.750],[-1.625],[-1.500],[-1.375],[-1.250],[-1.125],[-1.000]"
		cSQL=cSQL+",[-0.875],[-0.750],[-0.625],[-0.500],[-0.375],[-0.250],[-0.125]"
		cSQL=cSQL+",[0.000],[0.125],[0.250],[0.375],[0.500],[0.625],[0.750],[0.875]"
		cSQL=cSQL+",[1.000],[1.125],[1.250],[1.375],[1.500],[1.625],[1.750],[1.875]"
		cSQL=cSQL+",[2.000],[2.125],[2.250],[2.375],[2.500],[2.625],[2.750],[2.875]"
		cSQL=cSQL+",[3.000],[3.125],[3.250],[3.375],[3.500],[3.625],[3.750],[3.875]"
		cSQL=cSQL+")"
		cSQL=cSQL+") AS pvt; "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CertSPX')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CertSPX')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CertSPX")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CertSPX")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'CertSPX')
		ENDIF
		
		IF USED('CertSPX')
			IF RECCOUNT('CertSPX') > 0
				lOK = .T.
			ENDIF
		ENDIF
		
		
		RETURN lOK
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(HPA_Menu) = "O"  &&
			HPA_Menu.WindowState = 0
		ENDIF
	ENDPROC

