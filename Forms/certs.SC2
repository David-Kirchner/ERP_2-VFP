					ThisFormset.hpacert.PF1.pgCert.txtRA3.Value = nRA3
					ThisFormset.hpacert.PF1.pgCert.txtHardness3.Value = cHardness3
					ThisFormset.hpacert.PF1.pgCert.txtBHN3.Value = nBHN3
					ThisFormset.hpacert.PF1.pgCert.txtEloninches3.Value = cElonInches3
					ThisFormset.hpacert.PF1.pgCert.txttLoc3.Value = ctLoc3
					
					ThisFormset.hpacert.PF1.pgCert.txtUlt4.Value = nUlt4
					ThisFormset.hpacert.PF1.pgCert.txtYld4.Value = nYield4
					ThisFormset.hpacert.PF1.pgCert.txtEl4.Value = nElong4
					ThisFormset.hpacert.PF1.pgCert.txtRA4.Value = nRA4
		*			ThisFormset.hpacert.PF1.pgCert.txtHardness4.Value = cHardness4
		*			ThisFormset.hpacert.PF1.pgCert.txtBHN4.Value = nBHN4
					ThisFormset.hpacert.PF1.pgCert.txtEloninches4.Value = cElonInches4
					ThisFormset.hpacert.PF1.pgCert.txttLoc4.Value = ctLoc4
					
					ThisFormset.hpacert.PF1.pgCert.txtUlt5.Value = nUlt5
					ThisFormset.hpacert.PF1.pgCert.txtYld5.Value = nYield5
					ThisFormset.hpacert.PF1.pgCert.txtEl5.Value = nElong5
					ThisFormset.hpacert.PF1.pgCert.txtRA5.Value = nRA5
		*			ThisFormset.hpacert.PF1.pgCert.txtHardness5.Value = cHardness5
		*			ThisFormset.hpacert.PF1.pgCert.txtBHN5.Value = nBHN5
					ThisFormset.hpacert.PF1.pgCert.txtEloninches5.Value = cElonInches5
					ThisFormset.hpacert.PF1.pgCert.txttLoc5.Value = ctLoc5
														
					ThisFormset.hpacert.PF1.pgCert.txtUlt6.Value = nUlt6
					ThisFormset.hpacert.PF1.pgCert.txtYld6.Value = nYield6
					ThisFormset.hpacert.PF1.pgCert.txtEl6.Value = nElong6
					ThisFormset.hpacert.PF1.pgCert.txtRA6.Value = nRA6
					ThisFormset.hpacert.PF1.pgCert.txtEloninches6.Value = cElonInches6
					ThisFormset.hpacert.PF1.pgCert.txttLoc6.Value = ctLoc6
														
					ThisFormset.hpacert.PF1.pgCert.txtUlt7.Value = nUlt7
					ThisFormset.hpacert.PF1.pgCert.txtYld7.Value = nYield7
					ThisFormset.hpacert.PF1.pgCert.txtEl7.Value = nElong7
					ThisFormset.hpacert.PF1.pgCert.txtRA7.Value = nRA7
					ThisFormset.hpacert.PF1.pgCert.txtEloninches7.Value = cElonInches7
					ThisFormset.hpacert.PF1.pgCert.txttLoc7.Value = ctLoc7
														
					ThisFormset.hpacert.PF1.pgCert.txtCorrosionr.Value = cCorrosionr
					ThisFormset.hpacert.PF1.pgCert.txtGrainsize.Value = cGrainsize
					ThisFormset.hpacert.PF1.pgCert.txtTestPO.Value = cTestPO
					ThisFormset.hpacert.PF1.pgCert.txtLabUsed.Value = cLabUsed
					ThisFormset.hpacert.PF1.pgCert.txtTestPO2.Value = cTestPO2
					ThisFormset.hpacert.PF1.pgCert.txtLabUsed2.Value = cLabUsed2
					
					ThisFormset.hpacert.PF1.pgCert.grpMach.Value = nMachine
					ThisFormset.hpacert.PF1.pgCert.edtXtraInfo.Value = cXtraInfo
					ThisFormset.hpacert.PF1.pgCert.chkQA.Value = lQA
					ThisFormset.hpacert.PF1.pgCert.txtQArev.Value = cQArev
					ThisFormset.hpacert.PF1.pgCert.chkMercFree.Value = lMercFree
					ThisFormset.hpacert.PF1.pgCert.chkNoWeld.Value = lNoWeld
					ThisFormset.hpacert.PF1.pgCert.chkDFARS.Value = lDFARS
					
					ThisFormset.hpacert.PF1.pgCert.txtSrhours.Value = nSrhours
					ThisFormset.hpacert.PF1.pgCert.txtSrTemp.Value = cSrTemp
					ThisFormset.hpacert.PF1.pgCert.txtSrStress.Value = nSrStress
					ThisFormset.hpacert.PF1.pgCert.txtSrRA.Value = nSrRA
					ThisFormset.hpacert.PF1.pgCert.txtSrElong.Value = nSrElong
					
					ThisFormSet.GetLakeErieLotProp(nNewLot,cHeat)
					isadding=.T.
					ThisFormSet.SetEditing()
					ThisFormset.hpacert.PF1.pgCert.grpMach.OpStandard.Value = 3
					ThisFormset.hpacert.PF1.pgCert.grpMach.OpStandard.Refresh
					
					MESSAGEBOX("Clone is ready")
				ENDIF
				USE IN tmpCertID
			ENDIF
		
			
			
			
		CASE RetType = "NEW" AND RetMach = "LakeErie"
		**ADD NEW RECORD WITH LakeErie MECHANICALS  -no CHEMistry
		*OPEN LakeErie
			IF USED("tmpCertID")	
				USE IN tmpCertID
			ENDIF
			
			SELECT 0
			cSQL = "EXEC dbo.p_Cert_ins @Machine=4"
						
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCertID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCertID')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertID")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCertID')
			ENDIF
			
			IF USED('tmpCertID')
				IF VARTYPE(tmpCertID.ID) = 'N'
				
					nNewCertID = tmpCertID.ID
					ThisFormset.hpacert.PF1.pgCert.txtID.Value = nNewCertID
					ThisFormSet.SelectCertID(tmpCertID.ID)
		
					ThisFormSet.SetCertNew()
					ThisFormSet.GetLakeErieLotProp(nNewLot,cHeat)
					isadding=.T.
					ThisFormSet.SetEditing()
					ThisFormset.hpacert.PF1.pgCert.grpMach.OpStandard.Value = 3
					ThisFormset.hpacert.PF1.pgCert.grpMach.OpStandard.Refresh
					
					MESSAGEBOX("Cert is ready")
					
				ENDIF
				USE IN tmpCertID
			ENDIF
		
		ENDCASE
		
		
		SELECT HPACERT
		*SET ORDER TO heat
		
		ThisFormset.hpacert.PF1.pgCert.Refresh
		
		ThisFormSet.frmAddCert.Visible = .F.
		
		ThisFormset.hpacert.PF1.pgCert.txtHeatCount.Value = 0
		ThisFormset.hpacert.PF1.pgCert.txtLotCount.Value = 0
		
		*ThisFormset.frmAddCert.Commandgroup1.cmdNew.Caption = "New"
		*ThisFormset.frmAddCert.Commandgroup1.cmdEdit.Caption = "Clone"
		
		ThisFormSet.RefreshHpaCertCo(0)
	ENDPROC

	PROCEDURE checkcert
		*ThisFormSet.CheckCert()
		
		***
		PRIVATE cTestPOitem
		*Check for POitem
		cTestPOitem	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txtTestPO.Value,'POitem',12)
		
		IF VAL(cTestPOitem) > 0
			IF VAL(RIGHT(cTestPOitem,2)) = 0
				*No Item!  from old days
				*use Item 1
				cTestPOitem = STUFF(cTestPOitem, 12, 1, '1')
			ENDIF
		ENDIF
		
		IF Proper_PO_Item(cTestPOitem) <> Proper_PO_Item('')
			*Only check POitem if entered
			IF Count_POIteminPurchaseOrder( cTestPOitem, ThisFormSet.nConnHandle) = 0
				MESSAGEBOX("Test POitem:"+ALLTRIM(cTestPOitem)+" was not found."+CHR(13)+"Change Test PO or item.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE cLab
		cLab	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txtLabUsed.Value,'Lab',12)
		
		IF Proper_PO_Item(cTestPOitem) <> Proper_PO_Item('') AND EMPTY(cLab)
			IF USED('tmpCompanyPO')
				USE IN tmpCompanyPO
			ENDIF
			SELECT 0
		
		
			cSQL = "SELECT Company FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE HPApo = "+STR(VAL(cTestPOitem))
		
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCompanyPO' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCompanyPO' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompanyPO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompanyPO")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpCompanyPO' )
			ENDIF
			
			
			IF USED('tmpCompanyPO')
				IF RECCOUNT('tmpCompanyPO') > 0
					IF NOT EMPTY(tmpCompanyPO.Company)
						ThisFormSet.HPAcert.pf1.pgCert.txtLabUsed.Value = tmpCompanyPO.Company
					ENDIF
				ENDIF
				USE IN tmpCompanyPO
			ENDIF
				
		ENDIF
		
		***
		PRIVATE cTestPOitem2
		*Check for POitem2
		cTestPOitem2	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txtTestPO2.Value,'POitem',12)
		
		IF VAL(cTestPOitem2) > 0
			IF VAL(RIGHT(cTestPOitem2,2)) = 0
				*No Item!  from old days
				*use Item 1
				cTestPOitem2 = STUFF(cTestPOitem2, 12, 1, '1')
			ENDIF
		ENDIF
		
		IF Proper_PO_Item(cTestPOitem2) <> Proper_PO_Item('') 
			*Only check POitem if entered
			IF Count_POIteminPurchaseOrder( cTestPOitem2, ThisFormSet.nConnHandle) = 0
				MESSAGEBOX("Test POitem 2:"+ALLTRIM(cTestPOitem2)+" was not found."+CHR(13)+"Change Test PO 2 or item.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE cLab2
		cLab2 = PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txtLabUsed2.Value,'Lab',12)
		
		IF Proper_PO_Item(cTestPOitem2) <> Proper_PO_Item('') AND EMPTY(cLab2)
			IF USED('tmpCompanyPO')
				USE IN tmpCompanyPO
			ENDIF
			SELECT 0
		
		
			cSQL = "SELECT Company,OrderDate FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE HPApo = "+STR(VAL(cTestPOitem2))
		
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCompanyPO' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCompanyPO' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompanyPO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompanyPO")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpCompanyPO' )
			ENDIF
			
			
			IF USED('tmpCompanyPO')
				IF RECCOUNT('tmpCompanyPO') > 0
					IF NOT EMPTY(tmpCompanyPO.Company)
						ThisFormSet.HPAcert.pf1.pgCert.txtLabUsed2.Value = tmpCompanyPO.Company
					ENDIF
				ENDIF
				USE IN tmpCompanyPO
			ENDIF
				
		ENDIF
		
		****************** ThisFormSet.HPAcert.pf1.pgCert
		PRIVATE ctLoc1, ctLoc2, ctLoc3, ctLoc4, ctLoc5
		ctLoc1	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txttLoc1.Value,'tLoc',1)
		ctLoc2	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txttLoc2.Value,'tLoc',1)
		ctLoc3	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txttLoc3.Value,'tLoc',1)
		ctLoc4	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txttLoc4.Value,'tLoc',1)
		ctLoc5	= PrepareSQLtxt(ThisFormSet.HPAcert.pf1.pgCert.txttLoc5.Value,'tLoc',1)
		
		IF NOT EMPTY(ctLoc1)
			*Must be C M O
			IF UPPER(ctLoc1) = "C" OR UPPER(ctLoc1) = "M" OR UPPER(ctLoc1) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 1 is entered as:"+ctLoc1+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 1 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc2)
			*Must be C M O
			IF UPPER(ctLoc2) = "C" OR UPPER(ctLoc2) = "M" OR UPPER(ctLoc2) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 2 is entered as:"+ctLoc2+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 2 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc3)
			*Must be C M O
			IF UPPER(ctLoc3) = "C" OR UPPER(ctLoc3) = "M" OR UPPER(ctLoc3) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 3 is entered as:"+ctLoc3+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 3 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc4)
			*Must be C M O
			IF UPPER(ctLoc4) = "C" OR UPPER(ctLoc4) = "M" OR UPPER(ctLoc4) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 4 is entered as:"+ctLoc4+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 4 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc5)
			*Must be C M O
			IF UPPER(ctLoc5) = "C" OR UPPER(ctLoc5) = "M" OR UPPER(ctLoc5) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 5 is entered as:"+ctLoc5+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 5 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		********************************
		
		PRIVATE nTensile1,nYield1,nTensile2,nYield2,nTensile3,nYield3
		nTensile1	= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtUlt.Value,'Tensile',6,0)
		nYield1		= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtYield.Value,'Yield',6,0)
		nTensile2	= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtUlt2.Value,'Tensile',6,0)
		nYield2		= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtYld2.Value,'Yield',6,0)
		nTensile3	= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtUlt3.Value,'Tensile',6,0)
		nYield3		= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtYld3.Value,'Yield',6,0)
		
		PRIVATE nTensile4,nYield4,nTensile5,nYield5
		nTensile4	= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtUlt4.Value,'Tensile',6,0)
		nYield4		= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtYld4.Value,'Yield',6,0)
		nTensile5	= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtUlt5.Value,'Tensile',6,0)
		nYield5		= PrepareSQLnum(ThisFormSet.HPAcert.pf1.pgCert.txtYld5.Value,'Yield',6,0)
		
		IF nTensile4+nYield4 >0
			IF NOT ( UPPER(ctLoc4) = "C" OR UPPER(ctLoc4) = "M" OR UPPER(ctLoc4) = "O" )
				MESSAGEBOX("Test Location 4 is entered as:'"+ctLoc5+"'"+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 4 to an acceptable leter."+CHR(13)+"Location is required on Test 4 and 5",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		IF nTensile5+nYield5 >0
			IF NOT ( UPPER(ctLoc5) = "C" OR UPPER(ctLoc5) = "M" OR UPPER(ctLoc5) = "O" )
				MESSAGEBOX("Test Location 5 is entered as:'"+ctLoc5+"'"+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 5 to an acceptable leter."+CHR(13)+"Location is required on Test 4 and 5",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		
		IF nTensile1 < nYield1
			MESSAGEBOX("Test 1"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile1))+" is LESS than Yield "+ALLTRIM(STR(nYield1))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile2 < nYield2
			MESSAGEBOX("Test 2"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile2))+" is LESS than Yield "+ALLTRIM(STR(nYield2))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile3 < nYield3
			MESSAGEBOX("Test 3"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile3))+" is LESS than Yield "+ALLTRIM(STR(nYield3))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile4 < nYield4
			MESSAGEBOX("Test 4"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile4))+" is LESS than Yield "+ALLTRIM(STR(nYield4))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile5 < nYield5
			MESSAGEBOX("Test 5"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile5))+" is LESS than Yield "+ALLTRIM(STR(nYield5))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		
		
		
		
		********************************
		
		RETURN .T.
	ENDPROC

	PROCEDURE checkelements		&& Summarize Elements on save
		PRIVATE cAl,cB1,cBe,cC,cCa,cCb,cCd,cCl,cCo,cCr,cCu,cFe
		PRIVATE cH,cHf,cMg,cMn,cMo,cN,cNa,cNi,cO1,cP,cPb
		PRIVATE cS,cSi,cSn,cTa,cTi,cU1,cV,cW,cY,cZr
		PRIVATE cCbandTa,cNiandCo,cOther
		
		cAl			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtAl.Value,'Al',7))
		cB1			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtB.Value,'B',7))
		*cBe			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtBe.Value,'Be',7))
		cC			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtC.Value,'C',7))
		cCa			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCa.Value,'Ca',7))
		cCb			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCb.Value,'Cb',7))
		cCd			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCd.Value,'Cd',7))
		cCl			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCl.Value,'Cl',7))
		cCo			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCo.Value,'Co',7))
		cCr			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCr.Value,'Cr',7))
		cCu			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCu.Value,'Cu',7))
		cFe			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtFe.Value,'Fe',7))
		cH			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtH.Value,'H',7))
		cHf			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHf.Value,'Hf',7))
		cMg			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtMg.Value,'Mg',7))
		cMn			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtMn.Value,'Mn',7))
		cMo			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtMo.Value,'Mo',7))
		cN			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtN.Value,'N',7))
		cNa			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtNa.Value,'Na',7))
		cNi			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtNi.Value,'Ni',7))
		cO1			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtO.Value,'O',7))
		cP			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtP.Value,'P',7))
		cPb			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtPb.Value,'Pb',7))
		cS			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtS.Value,'S',7))
		cSi			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSi.Value,'Si',7))
		cSn			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSn.Value,'Sn',7))
		cTa			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtTa.Value,'Ta',7))
		cTi			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtTi.Value,'Ti',7))
		cU1			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtU.Value,'U',7))
		cV			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtV.Value,'V',7))
		cW			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtW.Value,'W',7))
		cY			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtY.Value,'Y',7))
		cZr			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtZr.Value,'Zr',7))
		cCbandTa	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCbandTa.Value,'CbandTa',10))
		cNiandCo	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtNiandCo.Value,'NiandCo',10))
		cOther		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtOther.Value,'Other',25))
		
		Private nEleCount
		nEleCount = 0
		nEleCount = IIF( EMPTY(cAl), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cB1), nEleCount, nEleCount +1 )
		*nEleCount = IIF( EMPTY(cBe), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cC), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cCb), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cCo), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cCr), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cCu), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cFe), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cH), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cMg), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cMo), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cMn), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cN), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cNa), nEleCount, nEleCount +1 )
		*nEleCount = IIF( EMPTY(cNb), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cNi), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cO1), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cP), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cS), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cSi), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cTa), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cTi), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cU1), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cV), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cW), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cY), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cZr), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cCbandTa), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cNiandCo), nEleCount, nEleCount +1 )
		nEleCount = IIF( EMPTY(cOther), nEleCount, nEleCount +1 )
		
		
		nTotal = VAL(cAl)+VAL(cB1)+VAL(cC)+VAL(cCa)+VAL(cCb)+VAL(cCd)+VAL(cCl)+VAL(cCo)+VAL(cCr)+VAL(cCu)+VAL(cFe)
		nTotal = nTotal+VAL(cH)+VAL(cHf)+VAL(cMg)+VAL(cMn)+VAL(cMo)+VAL(cN)+VAL(cNa)+VAL(cNi)+VAL(cO1)+VAL(cP)+VAL(cPb)
		nTotal = nTotal+VAL(cS)+VAL(cSi)+VAL(cSn)+VAL(cTa)+VAL(cTi)+VAL(cU1)+VAL(cV)+VAL(cW)+VAL(cY)+VAL(cZr)
		nTotal = nTotal+VAL(cCbandTa)+VAL(cNiandCo)+VAL(cOther)
		
		messagebox("Counted "+ALLTRIM(STR(nEleCount))+" Elements."+CHR(13)+"Totaling "+ALLTRIM(STR(nTotal,6,3))+" Percent.",0,"Cert Summary" )
	ENDPROC

	PROCEDURE checkspec_balance
		*ThisFormSet.CheckSpec_Balance() 
		PARAMETER m.balelement
		IF TYPE('m.balelement') = 'U'
			=MESSAGEBOX('Need to pass the Element you need the balance to',16,'No parameter')
			RETURN .f.
		ELSE
			m.balelement = ALLTRIM(m.balelement)
			m.balelement = UPPER(LEFT(m.balelement,1))+LOWER(RIGHT(m.balelement,LEN(m.balelement)-1))
		ENDIF
		
		IF !USED('HPACert')
			=MESSAGEBOX('Data table not in use!',16,'HPACert not opened.')
			RETURN .f.
		ENDIF
		
		m.eltot = 0
		
		IF m.balelement <> "Al"
			m.eltot = m.eltot + VAL(HPACert.Al)
		ELSE
			IF VAL(HPACert.Al) > 0
				=MESSAGEBOX('Al already has a value of '+HPACert.Al,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Al)
				=MESSAGEBOX('Al is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.B)
		m.eltot = m.eltot + VAL(HPACert.Be)
		m.eltot = m.eltot + VAL(HPACert.C)
		m.eltot = m.eltot + VAL(HPACert.Ca)
		m.eltot = m.eltot + VAL(HPACert.Cb)
		m.eltot = m.eltot + VAL(HPACert.Cd)
		m.eltot = m.eltot + VAL(HPACert.Cl)
		IF m.balelement <> "Co"
			m.eltot = m.eltot + VAL(HPACert.Co)
		ELSE
			IF VAL(HPACert.Co) > 0
				=MESSAGEBOX('Co already has a value of '+HPACert.Co,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Co)
				=MESSAGEBOX('Co is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.Cr)
		IF m.balelement <> "Cu"
			m.eltot = m.eltot + VAL(HPACert.Cu)
		ELSE
			IF VAL(HPACert.Cr) > 0
				=MESSAGEBOX('Cr already has a value of '+HPACert.Cr,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Cr)
				=MESSAGEBOX('Cr is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		IF m.balelement <> "Fe"
			m.eltot = m.eltot + VAL(HPACert.Fe)
		ELSE
			IF VAL(HPACert.Fe) > 0
				=MESSAGEBOX('Fe already has a value of '+HPACert.Fe,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Fe)
				=MESSAGEBOX('Fe is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.H)
		m.eltot = m.eltot + VAL(HPACert.Hf)
		IF m.balelement <> "Mg"
			m.eltot = m.eltot + VAL(HPACert.Mg)
		ELSE
			IF VAL(HPACert.Mg) > 0
				=MESSAGEBOX('Mg already has a value of '+HPACert.Mg,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Mg)
				=MESSAGEBOX('Mg is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.Mn)
		IF m.balelement <> "Mo"
			m.eltot = m.eltot + VAL(HPACert.Mo)
		ELSE
			IF VAL(HPACert.Mo) > 0
				=MESSAGEBOX('Mo already has a value of '+HPACert.Mo,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Mo)
				=MESSAGEBOX('Mo is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.N)
		m.eltot = m.eltot + VAL(HPACert.Na)
		IF m.balelement <> "Ni"
			m.eltot = m.eltot + VAL(HPACert.Ni)
		ELSE
			IF VAL(HPACert.Ni) > 0
				=MESSAGEBOX('Ni already has a value of '+HPACert.Ni,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Ni)
				=MESSAGEBOX('Ni is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.O)
		m.eltot = m.eltot + VAL(HPACert.P)
		IF m.balelement <> "Pb"
			m.eltot = m.eltot + VAL(HPACert.Pb)
		ELSE
			IF VAL(HPACert.Pb) > 0
				=MESSAGEBOX('Pb already has a value of '+HPACert.Pb,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Pb)
				=MESSAGEBOX('Pb is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.S)
		m.eltot = m.eltot + VAL(HPACert.Si)
		m.eltot = m.eltot + VAL(HPACert.Sn)
		IF m.balelement <> "Ta"
			m.eltot = m.eltot + VAL(HPACert.Ta)
		ELSE
			IF VAL(HPACert.Ta) > 0
				=MESSAGEBOX('Ta already has a value of '+HPACert.Ta,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Ta)
				=MESSAGEBOX('Ta is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		IF m.balelement <> "Ti"
			m.eltot = m.eltot + VAL(HPACert.Ti)
		ELSE
			IF VAL(HPACert.Ti) > 0
				=MESSAGEBOX('Ti already has a value of '+HPACert.Ti,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.Ti)
				=MESSAGEBOX('Ti is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.U)
		m.eltot = m.eltot + VAL(HPACert.V)
		IF m.balelement <> "W"
			m.eltot = m.eltot + VAL(HPACert.W)
		ELSE
			IF VAL(HPACert.W) > 0
				=MESSAGEBOX('W already has a value of '+HPACert.W,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(HPACert.W)
				=MESSAGEBOX('W is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(HPACert.Y)
		m.eltot = m.eltot + VAL(HPACert.Zr)
		m.eltot = m.eltot + VAL(HPACert.CbandTa)
		m.eltot = m.eltot + VAL(HPACert.NiandCo)
		
		m.eltot = m.eltot + VAL(HPACert.Other)
		
		
		*=MESSAGEBOX("Balance of "+CHR(13)+m.balelement+" is "+STR((100-m.eltot),5,2)+"%",48,'Found Balance.')
		RETURN 100-m.eltot
		
	ENDPROC

