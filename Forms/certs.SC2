	*<DefinedPropArrayMethod>
		*m: addnewcert
		*m: checkcert
		*m: checkelements		&& Summarize Elements on save
		*m: checkspec_balance
		*m: checkspec_hardness
		*m: convertform		&& Form digit to decription.
		*m: createtable_certspx
		*m: enablespacexhardness
		*m: getcert_co
		*m: getgfmlotprop
		*m: getlakeerielotprop
		*m: getrolllotprop
		*m: get_cert		&& Replaced GetCert, would cause VFP to Exit.
		*m: hpacertcoblank
		*m: nlotv		&& Funtion to check Lot numbers
		*m: refreshfind_rev
		*m: refreshfind_spec
		*m: refreshhpacertco
		*m: refresh_hpacert
		*m: reload
		*m: savecert
		*m: savespacexhardness
		*m: searchheat
		*m: searchlot
		*m: selectcertid
		*m: setcertnew
		*m: setcert_co_edit
		*m: setediting
		*m: setnormal		&& Restores buttons from editing.
		*m: showspacexhardness
		*p: csearchheat
		*p: isediting
		*p: isediting_co
		*p: lfiltered
		*p: nconnhandle
		*p: nmachine		&& 1 std, 2 GFM, 3 Roll
		*p: pcheat		&& Paramete Char HEAT
		*p: pclot		&& Parameter Char LOT
		*p: pnlot		&& Only the Lot Number
		*p: returnlot		&& From AddCert
		*p: returntype		&& From AddCert
		*p: returnwhatmach
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoRelease = .T.
		csearchheat = <fb2p_value>''&#13;</fb2p_value>
		DataSession = 2
		Icon = graphics\earth-globe.ico
		isediting = .F.
		lfiltered = .F.
		Name = "HPACert"
		nconnhandle = 0
		nmachine = 0
		pcheat =  
		pclot =  
		pnlot = 0
		returnlot = 0
		returntype = ''
		returnwhatmach = ''
	*</PropValue>

	ADD OBJECT 'frmAddCert' AS form WITH ;
		AlwaysOnTop = .T., ;
		BackColor = 0,255,255, ;
		Caption = "Add to HPA Cert file.", ;
		ClipControls = .T., ;
		Closable = .F., ;
		ControlBox = .F., ;
		DoCreate = .T., ;
		Height = 165, ;
		Left = 9, ;
		MaxButton = .F., ;
		MDIForm = .T., ;
		MinButton = .F., ;
		Name = "frmAddCert", ;
		ShowTips = .T., ;
		Top = 6, ;
		Visible = .F., ;
		Width = 277
		*< END OBJECT: BaseClass="form" />

	ADD OBJECT 'frmAddCert.cmdExit' AS commandbutton WITH ;
		Caption = "Exit", ;
		Height = 27, ;
		Left = 186, ;
		Name = "cmdExit", ;
		TabIndex = 6, ;
		TerminateRead = .T., ;
		Top = 128, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'frmAddCert.cmdNChem' AS commandbutton WITH ;
		Caption = "No Chemistry", ;
		Enabled = .F., ;
		Height = 27, ;
		Left = 168, ;
		Name = "cmdNChem", ;
		TabIndex = 5, ;
		Top = 64, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'frmAddCert.cmdTChem' AS commandbutton WITH ;
		Caption = "This Chemistry", ;
		Enabled = .F., ;
		Height = 27, ;
		Left = 168, ;
		Name = "cmdTChem", ;
		TabIndex = 4, ;
		Top = 36, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'frmAddCert.Commandgroup1' AS commandgroup WITH ;
		BackColor = 255,0,0, ;
		ButtonCount = 5, ;
		Height = 155, ;
		Left = 5, ;
		Name = "Commandgroup1", ;
		TabIndex = 1, ;
		Top = 1, ;
		Value = 1, ;
		Width = 130, ;
		Command1.Caption = "New", ;
		Command1.Height = 27, ;
		Command1.Left = 5, ;
		Command1.Name = "cmdNew", ;
		Command1.TerminateRead = .T., ;
		Command1.Top = 6, ;
		Command1.Width = 121, ;
		Command2.Caption = "Clone", ;
		Command2.Height = 27, ;
		Command2.Left = 5, ;
		Command2.Name = "cmdClone", ;
		Command2.TerminateRead = .T., ;
		Command2.Top = 35, ;
		Command2.Width = 121, ;
		Command3.Caption = "GFM Lot", ;
		Command3.Height = 27, ;
		Command3.Left = 5, ;
		Command3.Name = "cmdGFMLot", ;
		Command3.Top = 64, ;
		Command3.Width = 121, ;
		Command4.Caption = "Roll Lot", ;
		Command4.Height = 27, ;
		Command4.Left = 5, ;
		Command4.Name = "cmdRollLot", ;
		Command4.Top = 93, ;
		Command4.Width = 121, ;
		Command5.Caption = "Lake Erie Press lot", ;
		Command5.Height = 27, ;
		Command5.Left = 5, ;
		Command5.Name = "cmdLakeErieLot", ;
		Command5.Top = 122, ;
		Command5.Width = 122
		*< END OBJECT: BaseClass="commandgroup" />

	ADD OBJECT 'frmAddCert.Label1' AS label WITH ;
		Alignment = 1, ;
		BackColor = 0,255,255, ;
		Caption = "Lot#", ;
		Height = 17, ;
		Left = 121, ;
		Name = "Label1", ;
		TabIndex = 2, ;
		Top = 17, ;
		Width = 43
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'frmAddCert.txtLot' AS textbox WITH ;
		ControlSource = "nLot", ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 169, ;
		Name = "txtLot", ;
		SelectOnEntry = .T., ;
		TabIndex = 3, ;
