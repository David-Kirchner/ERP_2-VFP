	PROCEDURE hpacert.PF1.pgCert.chkChecked.Valid
		PRIVATE lcReturnText, lcReturnText2, ldSignDate, lcSignUser
		SELECT HPACert
				
		PRIVATE lSave
		lSave = .F.	
		
		
		IF MESSAGEBOX("Are you sure you want to change the Signed Status of this Cert? (Y/N)",4+32,"Are you sure?") = 6
		
			lChecked = PrepareSQLchk(This.Value,'Signed')
			IF lChecked
		
				PRIVATE cMachineID, cUser
				cMachineID = ID()
				cUser = RIGHT(cMachineID, LEN(cMachineID)-AT('#',cMachineID)-1 )
				cUser = ALLTRIM(cUser)
				
				lSave = Sign_Cert_Check()
		
				IF NOT lSave
					MESSAGEBOX(cUser+" is not Allowed to sign Cert.",0,"Prohibited!")
					RETURN .F.
				ELSE
					PRIVATE cGetHeat, cHeat, nID
					cGetHeat	= PrepareSQLtxt(This.Parent.txtGetHeat.Value,'Heat',40)
					cHeat		= PrepareSQLtxt(This.parent.txtHeat.Value,'Heat',40)
					nID			= PrepareSQLnum(This.parent.txtID.Value,'ID',-3)
					
					PRIVATE ldSignDate,lcSignUser
					ldSignDate = DATE()
						
					This.parent.txtSignUser.Value = cMachineID 
					This.parent.txtSignDate.Value = ldSignDate
					
					Sign_Cert(.T.,HPACert.ID,ThisFormSet.nConnHandle)	
					
					WAIT WINDOW 'Refreshing your DATA!' NOWAIT
		
					IF UPPER(cGetHeat) = UPPER(cHeat)
						ThisFormSet.Get_Cert('SEARCHHEAT',cHeat)
						ThisFormSet.HPACert.PF1.pgCert.cmdUnFilter.Visible = .T.
						SELECT HPAcert
						LOCATE FOR ID = nID
					ELSE
						ThisFormSet.Get_Cert('ID',nID)
					ENDIF
					WAIT CLEAR
				ENDIF	
		
			ELSE
				*Remove Signed checkmark
				PRIVATE cMachineID, cUser
				cMachineID = ID()
				cUser = RIGHT(cMachineID, LEN(cMachineID)-AT('#',cMachineID)-1 )
				cUser = ALLTRIM(cUser)
				
				lSave = Sign_Cert_Check()
		
				IF NOT lSave
					MESSAGEBOX(cUser+" is not Allowed to remove signature."+CHR(13)+"Proc_SQL:Sign_Cert_Check()",0,"Prohibited!")
					This.Value = !lChecked
					RETURN .F.
				ELSE
					This.parent.txtSignUser.Value = SPACE(50)
					This.parent.txtSignDate.Value = CTOD('  /  /  ')
					
					Sign_Cert(.F.,HPACert.ID,ThisFormSet.nConnHandle)
					
					WAIT WINDOW 'Refreshing your DATA!' NOWAIT
					PRIVATE cGetHeat, cHeat, nID
		
					cGetHeat	= PrepareSQLtxt(This.Parent.txtGetHeat.Value,'Heat',40)
					cHeat		= PrepareSQLtxt(This.parent.txtHeat.Value,'Heat',40)
					nID			= PrepareSQLnum(This.parent.txtID.Value,'ID',-3)
		
					IF UPPER(cGetHeat) = UPPER(cHeat)
						ThisFormSet.Get_Cert('SEARCHHEAT',cHeat)
						ThisFormSet.HPACert.PF1.pgCert.cmdUnFilter.Visible = .T.
						SELECT HPAcert
						LOCATE FOR ID = nID
					ELSE
						ThisFormSet.Get_Cert('ID',nID)
					ENDIF
					WAIT CLEAR
				ENDIF	
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

