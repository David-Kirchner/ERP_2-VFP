	PROCEDURE showspacexhardness
		*ThisFormSet.ShowSpaceXHardness()
		
		*Clean Window
		
		ThisFormSet.frmSpaceX.txtN3875.Value = 0
		ThisFormSet.frmSpaceX.txtN3750.Value = 0
		ThisFormSet.frmSpaceX.txtN3625.Value = 0
		ThisFormSet.frmSpaceX.txtN3500.Value = 0
		ThisFormSet.frmSpaceX.txtN3375.Value = 0
		ThisFormSet.frmSpaceX.txtN3250.Value = 0
		ThisFormSet.frmSpaceX.txtN3125.Value = 0
		ThisFormSet.frmSpaceX.txtN3000.Value = 0
		
		ThisFormSet.frmSpaceX.txtN2875.Value = 0
		ThisFormSet.frmSpaceX.txtN2750.Value = 0
		ThisFormSet.frmSpaceX.txtN2625.Value = 0
		ThisFormSet.frmSpaceX.txtN2500.Value = 0
		ThisFormSet.frmSpaceX.txtN2375.Value = 0
		ThisFormSet.frmSpaceX.txtN2250.Value = 0
		ThisFormSet.frmSpaceX.txtN2125.Value = 0
		ThisFormSet.frmSpaceX.txtN2000.Value = 0
		
		ThisFormSet.frmSpaceX.txtN1875.Value = 0
		ThisFormSet.frmSpaceX.txtN1750.Value = 0
		ThisFormSet.frmSpaceX.txtN1625.Value = 0
		ThisFormSet.frmSpaceX.txtN1500.Value = 0
		ThisFormSet.frmSpaceX.txtN1375.Value = 0
		ThisFormSet.frmSpaceX.txtN1250.Value = 0
		ThisFormSet.frmSpaceX.txtN1125.Value = 0
		ThisFormSet.frmSpaceX.txtN1000.Value = 0
		
		ThisFormSet.frmSpaceX.txtN0875.Value = 0
		ThisFormSet.frmSpaceX.txtN0750.Value = 0
		ThisFormSet.frmSpaceX.txtN0625.Value = 0
		ThisFormSet.frmSpaceX.txtN0500.Value = 0
		ThisFormSet.frmSpaceX.txtN0375.Value = 0
		ThisFormSet.frmSpaceX.txtN0250.Value = 0
		ThisFormSet.frmSpaceX.txtN0125.Value = 0
		
		ThisFormSet.frmSpaceX.txt0000.Value = 0
		
		ThisFormSet.frmSpaceX.txtP0125.Value = 0
		ThisFormSet.frmSpaceX.txtP0250.Value = 0
		ThisFormSet.frmSpaceX.txtP0375.Value = 0
		ThisFormSet.frmSpaceX.txtP0500.Value = 0
		ThisFormSet.frmSpaceX.txtP0625.Value = 0
		ThisFormSet.frmSpaceX.txtP0750.Value = 0
		ThisFormSet.frmSpaceX.txtP0875.Value = 0
		ThisFormSet.frmSpaceX.txtP1000.Value = 0
		
		ThisFormSet.frmSpaceX.txtP1125.Value = 0
		ThisFormSet.frmSpaceX.txtP1250.Value = 0
		ThisFormSet.frmSpaceX.txtP1375.Value = 0
		ThisFormSet.frmSpaceX.txtP1500.Value = 0
		ThisFormSet.frmSpaceX.txtP1625.Value = 0
		ThisFormSet.frmSpaceX.txtP1750.Value = 0
		ThisFormSet.frmSpaceX.txtP1875.Value = 0
		ThisFormSet.frmSpaceX.txtP2000.Value = 0
		
		ThisFormSet.frmSpaceX.txtP2125.Value = 0
		ThisFormSet.frmSpaceX.txtP2250.Value = 0
		ThisFormSet.frmSpaceX.txtP2375.Value = 0
		ThisFormSet.frmSpaceX.txtP2500.Value = 0
		ThisFormSet.frmSpaceX.txtP2625.Value = 0
		ThisFormSet.frmSpaceX.txtP2750.Value = 0
		ThisFormSet.frmSpaceX.txtP2875.Value = 0
		ThisFormSet.frmSpaceX.txtP3000.Value = 0
		
		ThisFormSet.frmSpaceX.txtP3125.Value = 0
		ThisFormSet.frmSpaceX.txtP3250.Value = 0
		ThisFormSet.frmSpaceX.txtP3375.Value = 0
		ThisFormSet.frmSpaceX.txtP3500.Value = 0
		ThisFormSet.frmSpaceX.txtP3625.Value = 0
		ThisFormSet.frmSpaceX.txtP3750.Value = 0
		ThisFormSet.frmSpaceX.txtP3875.Value = 0
		ThisFormSet.frmSpaceX.txtP3000.Value = 0
		
		*Get Data
		PRIVATE nID
		nID	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtID.Value,'ID',-3)
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT Inch,RockC "
		cSQL = cSQL +" FROM dbo.Cert_RC_profile "
		cSQL = cSQL +" WHERE CertID="+STR(nID)
		
		
		IF USED("tmpCertProfile")
			USE IN tmpCertProfile
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCertProfile')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCertProfile')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertProfile")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertProfile")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCertProfile')
		ENDIF
		
		PRIVATE nInch, nRockC
					
		IF USED('tmpCertProfile')	
			IF RECCOUNT('tmpCertProfile') > 0
				SCAN
					nInch	= PrepareSQLnum(tmpCertProfile.Inch,"Inch",5,3)
					nRockC	= PrepareSQLnum(tmpCertProfile.RockC,"RockC",4,1)
					
					DO CASE
					CASE nInch=-3.875
						ThisFormSet.frmSpaceX.txtN3875.Value = nRockC
					CASE nInch=-3.75
						ThisFormSet.frmSpaceX.txtN3750.Value = nRockC
					CASE nInch=-3.625
						ThisFormSet.frmSpaceX.txtN3625.Value = nRockC
					CASE nInch=-3.5
						ThisFormSet.frmSpaceX.txtN3500.Value = nRockC
					CASE nInch=-3.375
						ThisFormSet.frmSpaceX.txtN3375.Value = nRockC
					CASE nInch=-3.25
						ThisFormSet.frmSpaceX.txtN3250.Value = nRockC
					CASE nInch=-3.125
						ThisFormSet.frmSpaceX.txtN3125.Value = nRockC
					CASE nInch=-3.0
						ThisFormSet.frmSpaceX.txtN3000.Value = nRockC
		
					CASE nInch=-2.875
						ThisFormSet.frmSpaceX.txtN2875.Value = nRockC
					CASE nInch=-2.75
						ThisFormSet.frmSpaceX.txtN2750.Value = nRockC
					CASE nInch=-2.625
						ThisFormSet.frmSpaceX.txtN2625.Value = nRockC
					CASE nInch=-2.5
						ThisFormSet.frmSpaceX.txtN2500.Value = nRockC
					CASE nInch=-2.375
						ThisFormSet.frmSpaceX.txtN2375.Value = nRockC
					CASE nInch=-2.25
						ThisFormSet.frmSpaceX.txtN2250.Value = nRockC
					CASE nInch=-2.125
						ThisFormSet.frmSpaceX.txtN2125.Value = nRockC
					CASE nInch=-2
						ThisFormSet.frmSpaceX.txtN2000.Value = nRockC
					
					CASE nInch=-1.875
						ThisFormSet.frmSpaceX.txtN1875.Value = nRockC
					CASE nInch=-1.75
						ThisFormSet.frmSpaceX.txtN1750.Value = nRockC
					CASE nInch=-1.625
						ThisFormSet.frmSpaceX.txtN1625.Value = nRockC
					CASE nInch=-1.5
						ThisFormSet.frmSpaceX.txtN1500.Value = nRockC
					CASE nInch=-1.375
						ThisFormSet.frmSpaceX.txtN1375.Value = nRockC
					CASE nInch=-1.25
						ThisFormSet.frmSpaceX.txtN1250.Value = nRockC
					CASE nInch=-1.125
						ThisFormSet.frmSpaceX.txtN1125.Value = nRockC
					CASE nInch=-1.0
						ThisFormSet.frmSpaceX.txtN1000.Value = nRockC
					
					CASE nInch=-.875
						ThisFormSet.frmSpaceX.txtN0875.Value = nRockC
					CASE nInch=-.75
						ThisFormSet.frmSpaceX.txtN0750.Value = nRockC
					CASE nInch=-.625
						ThisFormSet.frmSpaceX.txtN0625.Value = nRockC
					CASE nInch=-.5
						ThisFormSet.frmSpaceX.txtN0500.Value = nRockC
					CASE nInch=-.375
						ThisFormSet.frmSpaceX.txtN0375.Value = nRockC
					CASE nInch=-.25
						ThisFormSet.frmSpaceX.txtN0250.Value = nRockC
					CASE nInch=-.125
						ThisFormSet.frmSpaceX.txtN0125.Value = nRockC
					
					CASE nInch=0.0
						ThisFormSet.frmSpaceX.txt0000.Value = nRockC
					
					CASE nInch=.125
						ThisFormSet.frmSpaceX.txtP0125.Value = nRockC
					CASE nInch=.25
						ThisFormSet.frmSpaceX.txtP0250.Value = nRockC
					CASE nInch=.375
						ThisFormSet.frmSpaceX.txtP0375.Value = nRockC
					CASE nInch=.5
						ThisFormSet.frmSpaceX.txtP0500.Value = nRockC
					CASE nInch=.625
						ThisFormSet.frmSpaceX.txtP0625.Value = nRockC
					CASE nInch=.75
						ThisFormSet.frmSpaceX.txtP0750.Value = nRockC
					CASE nInch=.875
						ThisFormSet.frmSpaceX.txtP0875.Value = nRockC
					CASE nInch=1
						ThisFormSet.frmSpaceX.txtP1000.Value = nRockC
					
					CASE nInch=1.125
						ThisFormSet.frmSpaceX.txtP1125.Value = nRockC
					CASE nInch=1.25
						ThisFormSet.frmSpaceX.txtP1250.Value = nRockC
					CASE nInch=1.375
						ThisFormSet.frmSpaceX.txtP1375.Value = nRockC
					CASE nInch=1.5
						ThisFormSet.frmSpaceX.txtP1500.Value = nRockC
					CASE nInch=1.625
						ThisFormSet.frmSpaceX.txtP1625.Value = nRockC
					CASE nInch=1.75
						ThisFormSet.frmSpaceX.txtP1750.Value = nRockC
					CASE nInch=1.875
						ThisFormSet.frmSpaceX.txtP1875.Value = nRockC
					CASE nInch=2.0
						ThisFormSet.frmSpaceX.txtP2000.Value = nRockC
					
					CASE nInch=2.125
						ThisFormSet.frmSpaceX.txtP2125.Value = nRockC
					CASE nInch=2.25
						ThisFormSet.frmSpaceX.txtP2250.Value = nRockC
					CASE nInch=2.375
						ThisFormSet.frmSpaceX.txtP2375.Value = nRockC
					CASE nInch=2.5
						ThisFormSet.frmSpaceX.txtP2500.Value = nRockC
					CASE nInch=2.625
						ThisFormSet.frmSpaceX.txtP2625.Value = nRockC
					CASE nInch=2.75
						ThisFormSet.frmSpaceX.txtP2750.Value = nRockC
					CASE nInch=2.875
						ThisFormSet.frmSpaceX.txtP2875.Value = nRockC
					CASE nInch=3.0
						ThisFormSet.frmSpaceX.txtP3000.Value = nRockC
						
					CASE nInch=3.125
						ThisFormSet.frmSpaceX.txtP3125.Value = nRockC
					CASE nInch=3.25
						ThisFormSet.frmSpaceX.txtP3250.Value = nRockC
					CASE nInch=3.375
						ThisFormSet.frmSpaceX.txtP3375.Value = nRockC
					CASE nInch=3.5
						ThisFormSet.frmSpaceX.txtP3500.Value = nRockC
					CASE nInch=3.625
						ThisFormSet.frmSpaceX.txtP3625.Value = nRockC
					CASE nInch=3.75
						ThisFormSet.frmSpaceX.txtP3750.Value = nRockC
					CASE nInch=3.875
						ThisFormSet.frmSpaceX.txtP3875.Value = nRockC
					
					OTHERWISE
						PRIVATE cMess
						cMess = "Inch = "+STR(nInch,5,3)+CHR(13)
						cMess = cMess + "ID = "+STR(nID)+CHR(13)
						cMess = cMess + "Show SpaceX Hardness Profile has data issue."
						MESSAGEBOX(cMess,32,'Data Error')
						*TrackMess(cMess)
						TrackError(cMess,"Show SpaceX Hardness Profile has data issue.","HPACert.ShowSpaceXHardness",LINENO(1) )
					ENDCASE
				ENDSCAN
				
			ENDIF
			USE IN tmpCertProfile
		ENDIF
		
		
		ThisFormSet.frmSpaceX.Visible = .T.
	ENDPROC

	PROCEDURE Unload
		IF USED('HPAcert_Co')
			USE IN HPAcert_Co 
		ENDIF
		
		IF USED("tmpHPACert_Co")
			USE IN tmpHPACert_Co
		ENDIF
		
		IF USED('HPAcert')
			TABLEREVERT(.T.,'HPACert') &&CURSORSETPROP is not used!, rewrite so this old command can be dropped
			USE IN HPAcert
		ENDIF
	ENDPROC

	PROCEDURE frmAddCert.cmdExit.Click
		THISFORMSet.ReturnType = " "
		*PRIVATE cReturnLot
		*ThisFormSet.ReturnLot = PADL(STR(ThisForm.RetValue,10),10)
		
		*RETURN THISFORM.RetType + ThisForm.RetMach + cReturnLot
		*THISFORMSet.ReturnType
		*ThisFormSet.ReturnWhatMach
		
		*ThisForm.Release
		ThisFormSet.frmAddcert.Visible = .F.
	ENDPROC

	PROCEDURE frmAddCert.cmdNChem.Click
		THISFORMSET.ReturnType = "N"
		*ThisFormSet.ReturnLot = IIF(TYPE('ThisForm.txtLot.Value')="N",ThisForm.txtLot.Value,VAL(ThisForm.txtLot.Value) )
		*ThisFormSet.ReturnLot = IIF(VARTYPE(ThisFormSet.pcLOT)="N",ThisFormSet.pcLOT,VAL(ThisFormSet.pcLOT) )
		ThisFormSet.ReturnLot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		
		*ThisForm.Release
		ThisFormSet.AddNewCert()
		
	ENDPROC

	PROCEDURE frmAddCert.cmdTChem.Click
		THISFORMSET.ReturnType = "C"
		ThisFormSet.ReturnLot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		*ThisFormSet.ReturnLot = IIF(VARTYPE(ThisFormSet.pcLOT)="N",ThisFormSet.pcLOT,VAL(ThisFormSet.pcLOT) )
		*ThisForm.Release
		ThisFormSet.AddNewCert()
	ENDPROC

	PROCEDURE frmAddCert.Commandgroup1.cmdClone.Click
		
		THISFORMSET.ReturnType = "C"
		ThisFormSet.ReturnWhatMach = " "
		ThisFormSet.ReturnLot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		ThisFormSet.AddNewCert()
	ENDPROC

	PROCEDURE frmAddCert.Commandgroup1.cmdGFMLot.Click
		ThisFormSet.ReturnWhatMach = "G"
		ThisForm.Commandgroup1.enabled = .F.
		ThisForm.Commandgroup1.cmdGFMLot.enabled = .F.
		ThisForm.Commandgroup1.cmdRollLot.enabled = .F.
		ThisForm.Commandgroup1.cmdClone.enabled = .F.
		ThisForm.Commandgroup1.cmdNew.enabled = .F.
		ThisForm.Commandgroup1.cmdLakeErieLot.enabled = .F.
		
		ThisForm.cmdTChem.enabled = .T.
		ThisForm.cmdNChem.enabled = .T.
		ThisForm.txtLot.enabled = .T.
		ThisForm.Refresh
		ThisForm.txtLot.SetFocus
		
	ENDPROC

	PROCEDURE frmAddCert.Commandgroup1.cmdLakeErieLot.Click
		ThisFormSet.ReturnWhatMach = "L"
		ThisForm.Commandgroup1.enabled = .F.
		ThisForm.Commandgroup1.cmdGFMLot.enabled = .F.
		ThisForm.Commandgroup1.cmdRollLot.enabled = .F.
		ThisForm.Commandgroup1.cmdClone.enabled = .F.
		ThisForm.Commandgroup1.cmdNew.enabled = .F.
		*ThisForm.Commandgroup1.cmdLakeErieLot.enabled = .F.
		
		*ThisForm.txtLot.Value = ThisFormSet.pcLOT
		
		ThisForm.cmdTChem.enabled = .T.
		ThisForm.cmdNChem.enabled = .T.
		ThisForm.txtLot.enabled = .T.
		ThisForm.Refresh
		ThisForm.txtLot.SetFocus
		
		
		
	ENDPROC

	PROCEDURE frmAddCert.Commandgroup1.cmdNew.Click
		THISFORMSET.ReturnType = "N"
		ThisFormSet.ReturnWhatMach = " "
		ThisFormSet.ReturnLot = 0
		ThisFormSet.AddNewCert()
	ENDPROC

	PROCEDURE frmAddCert.Commandgroup1.cmdRollLot.Click
		ThisFormSet.ReturnWhatMach = "R"
		ThisForm.Commandgroup1.enabled = .F.
		ThisForm.Commandgroup1.cmdGFMLot.enabled = .F.
		ThisForm.Commandgroup1.cmdRollLot.enabled = .F.
		ThisForm.Commandgroup1.cmdClone.enabled = .F.
		ThisForm.Commandgroup1.cmdNew.enabled = .F.
		ThisForm.Commandgroup1.cmdLakeErieLot.enabled = .F.
		*ThisForm.txtLot.Value = ThisFormSet.pcLOT
		
		ThisForm.cmdTChem.enabled = .T.
		ThisForm.cmdNChem.enabled = .T.
		ThisForm.txtLot.enabled = .T.
		ThisForm.Refresh
		ThisForm.txtLot.SetFocus
		
	ENDPROC

	PROCEDURE frmCheckSpec.cmbGroup.Valid
		ThisForm.RefreshFind_Spec()
		
		
		
	ENDPROC

	PROCEDURE frmCheckSpec.cmbSpec.GotFocus
		SELECT DISTINCT Spec_check.spec;
		 FROM spec_check;
		 WHERE Spec_check.group = m.Group;
		 ORDER BY Spec_check.spec;
		 INTO ARRAY aSpec
	ENDPROC

	PROCEDURE frmCheckSpec.cmbSpec.Valid
		ThisForm.RefreshFind_Rev()
		
		DIMENSION aRev(1)
		SELECT DISTINCT Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.Group = m.Group;
		 AND Spec_check.Spec = m.Spec;
		 ORDER BY Spec_check.Rev;
		 INTO ARRAY aRev
		 
		ThisForm.cmbRev.NumberOfElements = ALEN(aRev)
		
		IF VARTYPE(aRev(1)) = "L"
			aRev(1) = ''
		ENDIF
		
		ThisForm.cmbRev.Value = aRev(1)
		ThisForm.cmbRev.Refresh
		
	ENDPROC

	PROCEDURE frmCheckSpec.cmdCheck.Click
		
		IF !USED('HPACert')
			WAIT WINDOW 'Did not find the Cert to check'
			RETURN
		ENDIF
		
		PRIVATE m.Scand
		m.Scand = 0
		
		IF NOT ThisForm.Opened
			IF !USED('Spec_Check') && Error 3, File is in use ???????
				USE Spec_Check SHARED IN 0
				ThisForm.Opened = .T.
			ENDIF
		ENDIF
		
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ShowSQLtxt(ThisForm.cmbGroup.Value,'Group',10)
		cSpec	= ShowSQLtxt(ThisForm.cmbSpec.Value,'Spec',30)
		cRev	= ShowSQLtxt(ThisForm.cmbRev.Value,'Rev',10)
		
		SELECT Spec_Check
		SCAN
			IF NOT EMPTY(cRev)
				IF Spec_Check.Group = cGroup ;
					AND Spec_Check.Spec = cSpec;
					AND Spec_Check.Rev = cRev
					
					m.Scand = m.Scand +1
					DIMENSION aScand(M.Scand)
					aScand(M.Scand) = Recno()
					WAIT WINDOW 'Record #'+ALLTRIM(STR(RECNO(),10,0)) nowait &&timeout 5
				ENDIF
			ELSE
		
				IF Spec_Check.Group = cGroup AND Spec_Check.spec = cSpec
					m.Scand = m.Scand +1
					DIMENSION aScand(M.Scand)
					aScand(M.Scand) = Recno()
					WAIT WINDOW 'Record #'+ALLTRIM(STR(RECNO(),10,0)) nowait &&timeout 5
				ENDIF
			ENDIF
		ENDSCAN
		
		IF m.Scand = 0
			Release m.Scand
			WAIT window 'Did not find this Group+Spec'
			RETURN
		ENDIF
		
		********************************************************************************************
		**Open Spec Check 
		
		IF USED('SpecText')
			USE IN SpecText
		ENDIF
		
		PRIVATE cSafety
		cSafety = SET('Safety')
		SET SAFETY OFF
		
		Thisform.fnSpecText = UniqDBF(Thisform.fnSpecText)
		
		
		SELECT 0
		SET SAFETY OFF
		
		CREATE TABLE (SYS(5)+SYS(2003)+"\"+(Thisform.fnSpecText) ) FREE ;
		( SpecText CHAR(60) )
		
		IF "\MEM" $ SYS(2003)
			USE (SYS(5)+SYS(2003)+"\"+Thisform.fnSpecText) EXCL ALIAS SpecText
		ELSE
			USE (SYS(5)+SYS(2003)+"\MEM\"+Thisform.fnSpecText) EXCL ALIAS SpecText
		ENDIF
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"SpecText") FREE ( SpecText CHAR(60) )
		
		IF cSafety = "ON"
			SET SAFETY ON
		ENDIF
		
		INSERT INTO SpecText (SpecText) VALUES ( 'Alloy:'+ALLTRIM(HPACert.Alloy)+' '+ALLTRIM(HPACert.Size)   )
		INSERT INTO SpecText (SpecText) VALUES ( 'Heat:'+ALLTRIM(HPACert.Heat)+' Lot:'+ALLTRIM(STR(HPACert.Lot)) )
		INSERT INTO SpecText (SpecText) VALUES ( REPLICATE("-",60) )
		
		
		PRIVATE m.ChemPass
		PRIVATE m.CertDia,m.CertDiaPass
		PRIVATE m.CertUTS,m.CertUTSPass
		PRIVATE m.CertYLD,m.CertYLDPass
		PRIVATE m.CertEL,m.CertELPass
		PRIVATE m.CertRA,m.CertRAPass
		PRIVATE m.CertBHN,m.CertBHNPass
		PRIVATE m.CertRB,m.CertRBPass
		PRIVATE m.CertRC,m.CertRCPass
		PRIVATE m.CertGrainPass
		PRIVATE m.MechPass
		PRIVATE m.CertAlPass, m.CertAl
		PRIVATE m.CertBPass, m.CertB
		PRIVATE m.CertBePass, m.CertBe
		PRIVATE m.CertCPass, m.CertC
		PRIVATE m.CertCbPass, m.CertCb
		PRIVATE m.CertCoPass, m.CertCo
		PRIVATE m.CertCrPass, m.CertCr
		PRIVATE m.CertCuPass, m.CertCu
		PRIVATE m.CertFePass, m.CertFe
		PRIVATE m.CertHPass, m.CertH
		PRIVATE m.CertMgPass, m.CertMg
		PRIVATE m.CertMoPass, m.CertMo
		PRIVATE m.CertMnPass, m.CertMn
		PRIVATE m.CertNPass, m.CertN
		PRIVATE m.CertNaPass, m.CertNa
		PRIVATE m.CertNbPass, m.CertNb
		PRIVATE m.CertNiPass, m.CertNi
		PRIVATE m.CertOPass, m.CertO
		PRIVATE m.CertPPass, m.CertP
		PRIVATE m.CertSPass, m.CertS
		PRIVATE m.CertSiPass, m.CertSi
		PRIVATE m.CertTaPass, m.CertTa
		PRIVATE m.CertTiPass, m.CertTi
		PRIVATE m.CertVPass, m.CertV
		PRIVATE m.CertWPass, m.CertW
		PRIVATE m.CertYPass, m.CertY
		PRIVATE m.CertCbTaPass, m.CertCbTa
		PRIVATE m.CertNiCoPass, m.CertNiCo
		PRIVATE m.CertFeCrNiPass, m.CertFeCrNi
		
		FOR I = 1 TO m.Scand  &&Scan thru Group+Spec
			SELECT Spec_Check
			GOTO aScand(I)
			m.MechPass = .T.
		
			INSERT INTO SpecText (SpecText) VALUES ( 'Specification: '+ALLTRIM(Spec_Check.Group)+' '+ALLTRIM(Spec_Check.Spec)+' '+ALLTRIM(Spec_Check.Rev) )
		
			*Check for Dia
			m.CertDia = VAL(Description)
			m.CertDiaPass = .F.
			DO CASE
			CASE DiaMin > 0 AND DiaMax > 0
				*Check Agianst Min AND Max
				IF m.CertDia >= DiaMin AND m.CertDia <= DiaMax
					m.CertDiaPass = .T.
				ENDIF
			CASE DiaMin > 0 AND DiaMax = 0
				*Check Agianst Min ONLY
				IF m.CertDia >= DiaMin
					m.CertDiaPass = .T.
				ENDIF
			CASE DiaMin = 0 AND DiaMax > 0
				*Check Agianst Max ONLY
				IF m.CertDia <= DiaMax
					m.CertDiaPass = .T.
				ENDIF
			OTHERWISE
				*Dia not limited!
				m.CertDiaPass = .T.
			ENDCASE
		
			IF !m.CertDiaPass
				INSERT INTO SpecText (SpecText) VALUES ( 'This Spec does not match with the materials size' )
				INSERT INTO SpecText (SpecText) VALUES ( '   -Spec states Dia '+STR(Spec_Check.DiaMin,8,3)+' Min and '+STR(Spec_Check.DiaMax,8,3)+' Max' )
				INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Descriptio),"not listed.",ALLTRIM(STR(VAL(HPACert.Descriptio),6,3))+["Dia] ))
				IF 7=MESSAGEBOX('Do you want to continue'+CHR(13)+'',4+32,'Did not meet Dia requirements')
		&&Exit loop now
					INSERT INTO SpecText (SpecText) VALUES ( REPLICATE(' -',30) )
					LOOP
				ENDIF
			ELSE &&Dia is OK
				IF m.CertDia > 0 AND (m.CertDia = DiaMax OR m.CertDia = DiaMin)
					INSERT INTO SpecText (SpecText) VALUES ( '   -Spec states Dia '+STR(Spec_Check.DiaMin,8,3)+' Min and '+STR(Spec_Check.DiaMax,8,3)+' Max' )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Descriptio),"not listed.",ALLTRIM(STR(VAL(HPACert.Descriptio),6,3))+["Dia] ))
				ENDIF
			ENDIF
			IF !m.CertDiaPass
				m.MechPass = .F.
			ENDIF
			Release m.CertDia
		
			*Check for UTS
			m.CertUTS = (HPACert.ULT1)
			m.CertUTSPass = .F.
			DO CASE
			CASE UTSMin > 0 AND UTSMax > 0
				*Check Agianst Min AND Max
				IF m.CertUTS >= UTSMin AND m.CertUTS <= UTSMax
					m.CertUTSPass = .T.
				ELSE
					INSERT INTO SpecText (SpecText) VALUES ( "UTS is not within Spec." )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.UTSMin))+' Min. UTS. and '+ALLTRIM(STR(Spec_Check.UTSMax))+' Max.')
					INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.ULT1),"not listed.",ALLTRIM(STR(HPACert.ULT1)) ))
				ENDIF
			CASE UTSMin > 0 AND UTSMax = 0
				*Check Agianst Min ONLY
				IF m.CertUTS => UTSMin
					m.CertUTSPass = .T.
				ELSE
					INSERT INTO SpecText (SpecText) VALUES ( "UTS is not within Spec." )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.UTSMin))+' Min. UTS. Cert is '+IIF(EMPTY(HPACert.ULT1),"not listed.",ALLTRIM(STR(HPACert.ULT1)) ))
				ENDIF
			CASE UTSMin = 0 AND UTSMax > 0
				*Check Agianst Max ONLY
				IF m.CertUTS < UTSMax
					m.CertUTSPass = .T.
				ELSE
					INSERT INTO SpecText (SpecText) VALUES ( "Spec. requires "+ALLTRIM(STR(Spec_Check.UTSMax))+' Max. UTS. Cert is '+IIF(EMPTY(HPACert.ULT1),"not listed.",ALLTRIM(STR(HPACert.ULT1)) ))
					INSERT INTO SpecText (SpecText) VALUES ( "   -UTS is not within Spec." )
				ENDIF
			OTHERWISE
				*UTS not limited!
				m.CertUTSPass = .T.
		
			ENDCASE
			IF !m.CertUTSPass
				m.MechPass = .F.
			ELSE
				IF m.CertUTS > 0 AND (m.CertUTS = UTSMin OR m.CertUTS = UTSMax )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.UTSMin))+' Min. UTS. and '+ALLTRIM(STR(Spec_Check.UTSMax))+' Max.')
					INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.ULT1),"not listed.",ALLTRIM(STR(HPACert.ULT1)) ))		
				ENDIF
			ENDIF
			Release m.CertUTS
		
			*Check for YLD
			m.CertYLD = (HPACert.Yield1)
			m.CertYLDPass = .F.
			DO CASE
			CASE YLDMin > 0 AND YLDMax > 0
				*Check Agianst Min AND Max
				IF m.CertYLD >= YLDMin AND m.CertYLD <= YLDMax
					m.CertYLDPass = .T.
				ELSE
					INSERT INTO SpecText (SpecText) VALUES ( "Yield is not within Spec." )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.YLDMin))+' Min. Yield and '+ALLTRIM(STR(Spec_Check.YLDMax))+' Max.')
					INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Yield1),"not listed.",ALLTRIM(STR(HPACert.Yield1)) ))
				ENDIF
			CASE YLDMin > 0 AND YLDMax = 0
				*Check Agianst Min ONLY
				IF m.CertYLD >= YLDMin
					m.CertYLDPass = .T.
				ELSE
					INSERT INTO SpecText (SpecText) VALUES ( "Yield is not within Spec." )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.YLDMin))+' Min. Yield.  Cert is '+IIF(EMPTY(HPACert.Yield1),"not listed.",ALLTRIM(STR(HPACert.Yield1))) )
				ENDIF
			CASE YLDMin = 0 AND YLDMax > 0
				*Check Agianst Max ONLY
				IF m.CertYLD <= YLDMax
					m.CertYLDPass = .T.
				ELSE
					INSERT INTO SpecText (SpecText) VALUES ( "Yield is not within Spec." )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.YLDMax))+' Max. Yield.  Cert is '+IIF(EMPTY(HPACert.Yield1),"not listed.",ALLTRIM(STR(HPACert.Yield1)) ))
				ENDIF
			OTHERWISE
				*YLD not limited!
				m.CertYLDPass = .T.
			ENDCASE
			IF !m.CertYLDPass
				m.MechPass = .F.
			ELSE
				IF m.CertYLD > 0 AND (m.CertYLD = YLDMin OR m.CertYLD = YLDMax )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.YLDMin))+' Min. Yield and '+ALLTRIM(STR(Spec_Check.YLDMax))+' Max.')
					INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Yield1),"not listed.",ALLTRIM(STR(HPACert.Yield1)) ))
				ENDIF
			ENDIF
			Release m.CertYLD
		
			*Check for Elongation
			m.CertEL = (HPACert.ELONG1)
			m.CertELPass = .F.
			*Check Agianst Min ONLY
			IF m.CertEL >= ELMin
				m.CertELPass = .T.
			ENDIF
			IF !m.CertELPass
				INSERT INTO SpecText (SpecText) VALUES ( "Elongation is not within Spec." )
				INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.ELMin))+' Min. El.  Cert is '+IIF(EMPTY(HPACert.ELONG1),"not listed.",ALLTRIM(STR(HPACert.ELONG1)) ))
				m.MechPass = .F.
			ELSE
				IF m.CertEL > 0 AND m.CertEL = ELMin
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.ELMin))+' Min. El.  Cert is '+IIF(EMPTY(HPACert.ELONG1),"not listed.",ALLTRIM(STR(HPACert.ELONG1)) ))
				ENDIF
			ENDIF
			Release m.CertEL
		
			*Check for Reduction of Area
			m.CertRA = (HPACert.RA1)
			m.CertRAPass = .F.
			*Check Agianst Min ONLY
			IF m.CertRA >= RAMin
				m.CertRAPass = .T.
			ENDIF
			IF !m.CertRAPass
				INSERT INTO SpecText (SpecText) VALUES ( "Reduction of Area is not within Spec." )
				INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.RAMin))+' Min. RA.')
				INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.RA1),"not listed.",ALLTRIM(STR(HPACert.RA1)) ))
				m.MechPass = .F.
			ELSE
				IF m.CertRA >0 AND m.CertRA = RAMin
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.RAMin))+' Min. RA.')
					INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.RA1),"not listed.",ALLTRIM(STR(HPACert.RA1)) ))
				ENDIF
			ENDIF
			Release m.CertRA
		
			*Check for Hardness
			PRIVATE m.CertBHN, m.CertRB, m.CertRC, m.HardnessType
			IF EMPTY(HPACert.Hardness)
				IF BHNmax+BHNmin+Rbmax+Rbmin+Rcmax+Rcmin = 0
					m.CertHardnessPass = .T. &&Does not Fail, not required by spec
				ELSE
					m.CertHardnessPass = .F. &&Hardness not Listed on cert
					m.CertBHNPass = ( BHNmax+BHNmin = 0 )
					m.CertRBPass  = ( Rbmax+Rbmin   = 0 )
					m.CertRBPass  = ( Rcmax+Rcmin   = 0 )
					INSERT INTO SpecText (SpecText) VALUES ( 'No hardness reported on cert. Failed Hardness!' )
				ENDIF
			ELSE &&Cert has a Hardness value
				DO CASE &&Calculate hardness varients
				CASE 'BHN'$ UPPER(HPACert.Hardness)
					m.CertBHN = VAL(ALLTRIM(RIGHT(HPACert.Hardness,LEN(HPACert.Hardness)-(AT('BHN',UPPER(HPACert.Hardness))+2))))
					m.CertRB = ThisFormSet.CheckSpec_Hardness(m.CertBHN, 'BHN','RB')
					m.CertRC = ThisFormSet.Hardness(m.CertBHN, 'BHN','RC')
					m.HardnessType = "BHN"
				CASE 'RB'$ UPPER(HPACert.Hardness)
					m.CertRB  = VAL(ALLTRIM(RIGHT(HPACert.Hardness,LEN(HPACert.Hardness)-(AT('RB',UPPER(HPACert.Hardness))+1))))
					m.CertBHN = ThisFormSet.CheckSpec_Hardness(m.CertRb, 'RB','BHN')
					m.CertRC  = ThisFormSet.CheckSpec_Hardness(m.CertRb, 'RB','RC')
					m.HardnessType = "RB"
				CASE 'RC'$ UPPER(HPACert.Hardness)
					m.CertRC  = VAL(ALLTRIM(RIGHT(HPACert.Hardness,LEN(HPACert.Hardness)-(AT('RC',UPPER(HPACert.Hardness))+1))))
					m.CertBHN = ThisFormSet.CheckSpec_Hardness(m.CertRc, 'RC','BHN')
					m.CertRB  = ThisFormSet.CheckSpec_Hardness(m.CertRc, 'RC','RB')
					m.HardnessType = "RC"
				OTHERWISE
					*type not found but spec requires a value
					m.CertBHN = 0
					m.CertRB = 0
					m.CertRC = 0
					m.HardnessType = " "
				ENDCASE
				m.CertBHNPass = .F.
				m.CertRBPass = .F.
				m.CertRCPass = .F.
				m.CertHardnessPass = .F.
		
				DO CASE &&check Spec hardness requirements
					**********  BHN
				CASE BHNmin > 0 AND BHNmax > 0 AND m.CertBHN > 0
					*Check Agianst Min AND Max
					IF m.CertBHN >= BHNmin AND m.CertBHN <= BHNmax
						m.CertBHNPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertBHN = BHNmin OR m.CertBHN = BHNmax
							INSERT INTO SpecText (SpecText) VALUES ( "BHN is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmin))+' BHN Min. and '+ALLTRIM(STR(Spec_Check.BHNmax))+' BHN Max.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "RB" OR m.HardnessType = "RC"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as BHN"+ALLTRIM(STR(m.CertBHN)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "BHN is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmin))+' BHN Min. and '+ALLTRIM(STR(Spec_Check.BHNmax))+' BHN Max.')
						INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "RB" OR m.HardnessType = "RC"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as BHN"+ALLTRIM(STR(m.CertBHN)))
						ENDIF
					ENDIF
				CASE BHNmin > 0 AND BHNmax = 0 AND m.CertBHN > 0
					*Check Agianst Min ONLY
					IF m.CertBHN >= BHNmin
						m.CertBHNPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertBHN = BHNmin 
							INSERT INTO SpecText (SpecText) VALUES ( "BHN is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmin))+' BHN Min.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "RB" OR m.HardnessType = "RC"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as BHN"+ALLTRIM(STR(m.CertBHN)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "BHN is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmin))+' BHN Min. Cert is '+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "RB" OR m.HardnessType = "RC"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as BHN"+ALLTRIM(STR(m.CertBHN)))
						ENDIF
					ENDIF
				CASE BHNmin = 0 AND BHNmax > 0 AND m.CertBHN > 0
					*Check Agianst Max ONLY
					IF m.CertBHN <= BHNmax
						m.CertBHNPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertBHN = BHNmax
							INSERT INTO SpecText (SpecText) VALUES ( "BHN is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmax))+' BHN Max.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "RB" OR m.HardnessType = "RC"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as BHN"+ALLTRIM(STR(m.CertBHN)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "BHN is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmax))+' BHN Max. Cert is '+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "RB" OR m.HardnessType = "RC"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as BHN"+ALLTRIM(STR(m.CertBHN)))
						ENDIF
					ENDIF
					*************  Rb
				CASE Rbmin > 0 AND Rbmax > 0 AND m.CertRb > 0
					*Check Agianst Min AND Max
					IF m.CertRB >= Rbmin AND m.CertRB <= Rbmax
						m.CertRBPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertRB = Rbmin OR m.CertRB = Rbmax
							INSERT INTO SpecText (SpecText) VALUES ( "Rockwell B is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmin))+' Min. and '+ALLTRIM(STR(Spec_Check.Rbmax))+' Max.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "BHN" OR m.HardnessType = "RC"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell B "+ALLTRIM(STR(m.CertRB)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Rockwell B is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmin))+' Min. and '+ALLTRIM(STR(Spec_Check.Rbmax))+' Max.')
						INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "BHN" OR m.HardnessType = "RC"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell B "+ALLTRIM(STR(m.CertRB)))
						ENDIF
					ENDIF
				CASE Rbmin > 0 AND Rbmax = 0 AND m.CertRb > 0
					*Check Agianst Min ONLY
					IF m.CertRB >= Rbmin
						m.CertRBPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertRB = Rbmin
							INSERT INTO SpecText (SpecText) VALUES ( "Rockwell B is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmin))+' Min.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "BHN" OR m.HardnessType = "RC"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell B "+ALLTRIM(STR(m.CertRB)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Rockwell B is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmin))+' Min. Cert is '+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "BHN" OR m.HardnessType = "RC"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell B "+ALLTRIM(STR(m.CertRB)))
						ENDIF
					ENDIF
				CASE Rbmin = 0 AND Rbmax > 0 AND m.CertRb > 0
					*Check Agianst Max ONLY
					IF m.CertRB <= Rbmax
						m.CertRBPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertRB = Rbmax
							INSERT INTO SpecText (SpecText) VALUES ( "Rockwell B is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmax))+' Max.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "BHN" OR m.HardnessType = "RC"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell B "+ALLTRIM(STR(m.CertRB)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Rockwell B is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmax))+' Max. Cert is '+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "BHN" OR m.HardnessType = "RC"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell B "+ALLTRIM(STR(m.CertRB)))
						ENDIF
					ENDIF
					*************  Rc
				CASE Rcmin > 0 AND Rcmax > 0 AND m.CertRC > 0
					*Check Agianst Min AND Max
					IF m.CertRC >= Rcmin AND m.CertRC <= Rcmax
						m.CertRCPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertRC = Rcmin OR m.CertRC = Rcmax
							INSERT INTO SpecText (SpecText) VALUES ( "Rockwell C is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmin))+' Min. and '+ALLTRIM(STR(Spec_Check.Rcmax))+' Max.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "BHN" OR m.HardnessType = "RB"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell C "+ALLTRIM(STR(m.CertRC)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Rockwell C is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmin))+' Min. and '+ALLTRIM(STR(Spec_Check.Rcmax))+' Max.')
						INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "BHN" OR m.HardnessType = "RB"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell C "+ALLTRIM(STR(m.CertRC)))
						ENDIF
					ENDIF
				CASE Rcmin > 0 AND Rcmax = 0 AND m.CertRC > 0
					*Check Agianst Min ONLY
					IF m.CertRC >= Rcmin
						m.CertRCPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertRC = Rcmin
							INSERT INTO SpecText (SpecText) VALUES ( "Rockwell C is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmin))+' Min. ')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "BHN" OR m.HardnessType = "RB"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell C "+ALLTRIM(STR(m.CertRC)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Rockwell C is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmin))+' Min. Cert is '+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "BHN" OR m.HardnessType = "RB"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell C "+ALLTRIM(STR(m.CertRC)))
						ENDIF
					ENDIF
				CASE Rcmin = 0 AND Rcmax > 0 AND m.CertRC > 0
					*Check Agianst Max ONLY
					IF m.CertRC < Rcmax
						m.CertRCPass = .T.
						m.CertHardnessPass = .T.
						IF m.CertRC = Rcmax
							INSERT INTO SpecText (SpecText) VALUES ( "Rockwell C is on border of Spec." )
							INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmax))+' Max.')
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert is "+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
							IF m.HardnessType = "BHN" OR m.HardnessType = "RB"
								INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell C "+ALLTRIM(STR(m.CertRC)))
							ENDIF
						ENDIF	
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Rockwell C is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmax))+' Max. Cert is '+IIF(EMPTY(HPACert.Hardness),"not listed.",ALLTRIM(HPACert.Hardness) ))
						IF m.HardnessType = "BHN" OR m.HardnessType = "RB"
							INSERT INTO SpecText (SpecText) VALUES ( "   -Cert hardness converted as Rockwell C "+ALLTRIM(STR(m.CertRC)))
						ENDIF
					ENDIF
					************* No Spec Hardness
				CASE BHNmax+BHNmin+Rbmax+Rbmin+Rcmax+Rcmin = 0
					m.CertHardnessPass = .T. &&Does not Fail, not required by spec
					m.CertBHNPass = .T.
					m.CertRBPass  = .T.
					m.CertRBPass  = .T.
				OTHERWISE  && Spec has a limit but Could not find Cert Value
					m.msg=""
					IF BHNmin > 0
						INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Minimum BHN of "+STR(Spec_Check.BHNmin,3,0) )
						m.msg="Spec requires Minimum BHN of "+ALLTRIM(STR(BHNmin,3,0))+ CHR(13)
					ENDIF
					IF BHNmax > 0
						INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Maximum BHN of "+STR(Spec_Check.BHNmax,3,0) )
						m.msg=m.msg+"Spec requires Maximum BHN of "+ALLTRIM(STR(BHNmax,3,0))+CHR(13)
					ENDIF
					IF Rbmin > 0
						INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Minimum Rb of "+STR(Spec_Check.Rbmin,3,0) )
						m.msg="Spec requires Minimum Rb of "+ALLTRIM(STR(Rbmin,3,0))+CHR(13)
					ENDIF
					IF Rbmax > 0
						INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Maximum Rb of "+STR(Spec_Check.Rbmax,3,0) )
						m.msg=m.msg+"Spec requires Maximum Rb of "+ALLTRIM(STR(Rbmax,3,0))+CHR(13)
					ENDIF
					IF Rcmin > 0
						INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Minimum Rc of "+STR(Spec_Check.Rcmin,3,0) )
						m.msg="Spec requires Minimum Rc of "+ALLTRIM(STR(Rcmin,3,0))+CHR(13)
					ENDIF
					IF Rcmax > 0
						INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Maximum Rc of "+STR(Spec_Check.Rcmax,3,0) )
						m.msg=m.msg+"Spec requires Maximum Rc of "+ALLTRIM(STR(Rcmax,3,0))+CHR(13)
					ENDIF
					INSERT INTO SpecText (SpecText) VALUES ( "   -The Cert has "+IIF(EMPTY(HPACert.Hardness),'no value!',(HPACert.Hardness) ) )
					m.msg=m.msg+"The Cert has "+IIF(EMPTY(HPACert.Hardness),'no value!',(HPACert.Hardness) )
					m.cptn="Does the Hardness meet"
					m.msgb = MESSAGEBOX(m.msg,4+32+256,m.cptn)
					IF m.msgb = 6 &&Yes
						INSERT INTO SpecText (SpecText) VALUES ( "   -User input says Hardness does meet the spec" )
						m.CertBHNPass = .T.
						m.CertRBPass = .T.
						m.CertRCPass = .T.
						m.CertHardnessPass = .T.
					ENDIF
					IF m.msgb = 7 &&NO
						m.CertBHNPass = .F.
						m.CertRBPass = .F.
						m.CertRCPass = .F.
						m.CertHardnessPass = .F.
					ENDIF
		
				ENDCASE
			ENDIF &&Hardness
			IF !m.CertHardnessPass 
				m.MechPass = .F.
			ENDIF
		
			Release m.CertBHN
			Release m.CertRC
			Release m.CertRB
		
		
			*Check for GrainSize
			m.CertGrainPass = .F.
			IF EMPTY(GrainMin) AND EMPTY(GrainMax)
				m.CertGrainPass = .T.
			ELSE
				m.msg=""
				IF !EMPTY(GrainMin)
					INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Minimum Grain Size of "+Spec_Check.GrainMin )
					m.msg="Spec requires Minimum of "+GrainMin+CHR(13)
				ENDIF
				IF !EMPTY(GrainMax)
					INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Maximum Grain Size of "+Spec_Check.GrainMax )
					m.msg=m.msg+"Spec requires Maximum of "+GrainMax+CHR(13)
				ENDIF
				INSERT INTO SpecText (SpecText) VALUES ( "   -The Cert has "+IIF(EMPTY(HPACert.GrainSize),'no value!',HPACert.GrainSize))
				m.msg=m.msg+"The Cert has "+IIF(EMPTY(HPACert.GrainSize),'no value!',HPACert.GrainSize)
				m.cptn="Does the grain size meet"
				m.msgb = MESSAGEBOX(m.msg,4+32+256,m.cptn)
				IF m.msgb = 6 &&Yes
					INSERT INTO SpecText (SpecText) VALUES ( "   -User input says Grain Size does meet the spec" )
					m.CertGrainPass = .T.
				ENDIF
				IF m.msgb = 7 &&NO
					INSERT INTO SpecText (SpecText) VALUES ( "   -User input says Grain Size does not meet the spec" )
					INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+IIF(EMPTY(Spec_Check.GrainMin),'NO',Spec_Check.GrainMin)+' Min. and '+IIF(EMPTY(Spec_Check.GrainMax),"NO",Spec_Check.GrainMax)+' Max. Cert is '+ALLTRIM(HPACert.GrainSize) )
					m.CertGrainPass = .F.
				ENDIF
			ENDIF &&EMPTY(HPACert.Hardness)
			IF !m.CertGrainPass
				m.MechPass = .F.
			ENDIF
		
			******************************************
			******State Mechanicals
		
		
			IF m.MechPass
				INSERT INTO SpecText (SpecText) VALUES ( 'Did not fail mechanicals.' )
				WAIT WINDOW 'Did not fail mechanicals' TIMEOUT 1
			ELSE
				INSERT INTO SpecText (SpecText) VALUES ( 'Does not meet mechanicals.' )
			ENDIF
		
			************************************************************************************
			************************&&Check Chemistry*******************************************
			************************************************************************************
			
			************************************************************************************
			************************&&Check Chemistry*******************************************
			************************************************************************************
		
			************************************************************************************
			************************&&Check Chemistry*******************************************
			************************************************************************************
		
			m.ChemPass =.T.
			INSERT INTO SpecText (SpecText) VALUES ( REPLICATE(' -',30) )
			
			**Check percentage of Al
			m.CertAlPass = .T. &&True even if not required
			IF AlMax > 0 or AlMin > 0 OR AlRem
				**Al needs to be checked
		
				m.CertAl = VAL(HPACert.Al)
				m.CertAlPass = .F.
				DO CASE
				CASE EMPTY(HPACert.Al)
					m.CertAlPass = .F.
					INSERT INTO SpecText (SpecText) VALUES ( "Al is not reported on Cert." )
				CASE m.CertAl = 0 AND !EMPTY(HPACert.Al)
					*No numeric value 
					IF AlRem 
						m.CertAlPass = .T.  && must be Balance
					ENDIF
				CASE AlRem
					*Spec asks for balance and cert has a number
					IF m.CertAl > 50 &&More than 50% is balance
						m.CertAlPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Al is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.AlMin,6,3))+' Min. Cert is '+IIF(EMPTY(HPACert.Al),"not listed.",ALLTRIM(HPACert.Al) ))
					ENDIF
				CASE AlMin > 0 AND AlMax > 0
					*Check Agianst Min AND Max
					IF m.CertAl >= AlMin AND m.CertAl <= AlMax
						m.CertAlPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Al is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.AlMin,6,3))+' Min. and '+ALLTRIM(STR(Spec_Check.AlMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.Al),"not listed.",ALLTRIM(HPACert.Al) ))
					ENDIF
				CASE AlMin > 0 AND AlMax = 0
					*Check Agianst Min ONLY
					IF m.CertAl >= AlMin
						m.CertAlPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Al is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.AlMin,6,3))+' Min. Cert is '+IIF(EMPTY(HPACert.Al),"not listed.",ALLTRIM(HPACert.Al) ))
					ENDIF
				CASE AlMin = 0 AND AlMax > 0
					*Check Agianst Max ONLY
					IF m.CertAl <= AlMax
						m.CertAlPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Al is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.AlMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.Al),"not listed.",ALLTRIM(HPACert.Al) ))
					ENDIF
				OTHERWISE
					*Al not limited!
					m.CertAlPass = .T.
				ENDCASE
				Release m.CertAl
			ENDIF
		
			**Check Percentage of B
		
			m.CertBPass = .T. &&True even if not required
			IF BMax > 0 or BMin > 0
				**B needs to be checked
		
				m.CertB = VAL(HPACert.B)
				m.CertBPass = .F.
				DO CASE
				CASE EMPTY(HPACert.B)
					m.CertBPass = .F.
					INSERT INTO SpecText (SpecText) VALUES ( "B is not reported on Cert." )
				CASE BMin > 0 AND BMax > 0
					*Check Agianst Min AND Max
					IF m.CertB >= BMin AND m.CertB <= BMax
						m.CertBPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "B is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BMin,6,3))+' Min. and '+ALLTRIM(STR(Spec_Check.BMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.B),"not listed.",ALLTRIM(HPACert.B) ))
					ENDIF
				CASE BMin > 0 AND BMax = 0
					*Check Agianst Min ONLY
					IF m.CertB >= BMin
						m.CertBPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "B is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BMin,6,3))+' Min. Cert is '+IIF(EMPTY(HPACert.B),"not listed.",ALLTRIM(HPACert.B) ))
					ENDIF
				CASE BMin = 0 AND BMax > 0
					*Check Agianst Max ONLY
					IF m.CertB <= BMax
						m.CertBPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "B is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.B),"not listed.",ALLTRIM(HPACert.B) ))
					ENDIF
				OTHERWISE
					*B not limited!
					m.CertBPass = .T.
				ENDCASE
				Release m.CertB
			ENDIF
		
			**Check Percentage of Be
		
			m.CertBePass = .T. &&True even if not required
			IF BeMax > 0 or BeMin > 0
				**Be needs to be checked
		
				m.CertBe = VAL(HPACert.Be)
				m.CertBePass = .F.
				DO CASE
				CASE EMPTY(HPACert.Be)
					m.CertBEPass = .F.
					INSERT INTO SpecText (SpecText) VALUES ( "Be is not reported on Cert." )
				CASE BeMin > 0 AND BeMax > 0
					*Check Agianst Min AND Max
					IF m.CertBe >= BeMin AND m.CertBe <= BeMax
						m.CertBePass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Be is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BeMin,6,3))+' Min. and '+ALLTRIM(STR(Spec_Check.AlMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.Be),"not listed.",ALLTRIM(HPACert.Be) ))
					ENDIF
				CASE BeMin > 0 AND BeMax = 0
					*Check Agianst Min ONLY
					IF m.CertBe >= BeMin
						m.CertBePass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Be is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BeMin,6,3))+' Min. Cert is '+IIF(EMPTY(HPACert.Be),"not listed.",ALLTRIM(HPACert.Be) ))
					ENDIF
				CASE BeMin = 0 AND BeMax > 0
					*Check Agianst Max ONLY
					IF m.CertBe <= BeMax
						m.CertBePass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Be is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BeMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.Be),"not listed.",ALLTRIM(HPACert.Be) ))
					ENDIF
				OTHERWISE
					*Be not limited!
					m.CertBePass = .T.
				ENDCASE
				Release m.CertBe
			ENDIF
		
			**Check Percentage of C
		
			m.CertCPass = .T. &&True even if not required
			IF CMax > 0 or CMin > 0
				**C needs to be checked
		
				m.CertC = VAL(HPACert.C)
				m.CertCPass = .F.
				DO CASE
				CASE EMPTY(HPACert.C)
					m.CertCPass = .F.
					INSERT INTO SpecText (SpecText) VALUES ( "C is not reported on Cert." )
				CASE CMin > 0 AND CMax > 0
					*Check Agianst Min AND Max
					IF m.CertC >= CMin AND m.CertC <= CMax
						m.CertCPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "C is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CMin,6,3))+' Min. and '+ALLTRIM(STR(Spec_Check.CMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.C),"not listed.",ALLTRIM(HPACert.C) ))
					ENDIF
				CASE CMin > 0 AND CMax = 0
					*Check Agianst Min ONLY
					IF m.CertC >= CMin
						m.CertCPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "C is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CMin,6,3))+' Min. Cert is '+IIF(EMPTY(HPACert.C),"not listed.",ALLTRIM(HPACert.C) ))
					ENDIF
				CASE CMin = 0 AND CMax > 0
					*Check Agianst Max ONLY
					IF m.CertC <= CMax
						m.CertCPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "C is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CMax,6,3))+' Max. Cert is '+IIF(EMPTY(HPACert.C),"not listed.",ALLTRIM(HPACert.C) ))
					ENDIF
				OTHERWISE
					*C not limited!
					m.CertCPass = .T.
				ENDCASE
				Release m.CertC
			ENDIF
		
			**Check Percentage of Cb
		
			m.CertCbPass = .T. &&True even if not required
			IF CbMax > 0 or CbMin > 0
				**Cb needs to be checked
		
				m.CertCb = VAL(HPACert.Cb)
				m.CertCbPass = .F.
				DO CASE
				CASE EMPTY(HPACert.Cb)
					m.CertCbPass = .F.
					INSERT INTO SpecText (SpecText) VALUES ( "Cb is not reported on Cert." )
				CASE CbMin > 0 AND CbMax > 0
					*Check Agianst Min AND Max
					IF m.CertCb >= CbMin AND m.CertCb <= CbMax
						m.CertCbPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Cb is not within Spec." )
						INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CbMin,6,3))+' Min. and '+ALLTRIM(STR(Spec_Check.CbMax))+' Max. Cert is '+IIF(EMPTY(HPACert.Cb),"not listed.",ALLTRIM(HPACert.Cb) ))
					ENDIF
				CASE CbMin > 0 AND CbMax = 0
					*Check Agianst Min ONLY
					IF m.CertCb >= CbMin
						m.CertCbPass = .T.
					ELSE
						INSERT INTO SpecText (SpecText) VALUES ( "Cb is not within Spec." )
