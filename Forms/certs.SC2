	PROCEDURE hpacert.PF1.pgCert.txtID.Click
		*MESSAGEBOX("click to Search by Cert ID",64,"Single Click")
		IF This.ForeColor = RGB(255,0,0)
			*Enable Edit
			This.ReadOnly = .f.
			This.ForeColor = RGB(0,0,0)
		ENDIF
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.txtID.Valid
		IF This.ReadOnly = .F.
			*Do Search
			PRIVATE nCertID, nOldID
			nCertID = PrepareSQLnum(This.Value,'ID',-3)
			nOldID	= HPACert.ID
			
			IF nCertID > 0
				
				IF ThisFormSet.Get_Cert("ID",nCertID ) > 0
				
					IF This.parent.cmdUnFilter.Visible
						This.parent.cmdUnFilter.Visible = .F.
					ENDIF
		
				ELSE
					WAIT WINDOW ALLTRIM(STR(nCertID))+' ID Not Found'
					ThisFormSet.Get_Cert("ID",nOldID) 
				ENDIF
				
			ENDIF
				
			This.ForeColor = RGB(255,0,0)
			This.ReadOnly = .T.
		ENDIF
	ENDPROC

