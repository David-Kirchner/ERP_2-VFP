		cTestPO2	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtTestPO2.Value,'TestPO',12))
		cLabUsed2	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtLabUsed2.Value,'LabUsed',12))
		
		nMachine	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.grpMach.Value,'Machine',1,0)
		
		cXtraInfo	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.edtXtraInfo.Value,'XtraInfo',-1))
		lQA			= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkQA.Value,'QA')
		cQArev		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtQArev.Value,'QArev',20)
		lMercFree	= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkMercFree.Value,'MercFree')
		lNoWeld		= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkNoWeld.Value,'NoWeld')
		lDFARS		= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkDFARS.Value,'DFARS')
		nSrHours	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrhours.Value,'Srhours',4,1)
		cSrTemp		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSrTemp.Value,'SrTemp',10))
		nSrStress	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrStress.Value,'SrStress',10,0)
		nSrRA		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrRA.Value,'SrRA',4,1)
		nSrElong	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrElong.Value,'SrElong',4,1)
		nID			= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtID.Value,'ID',-3)
		
		
		PRIVATE lRemoveSignature
		IF EMPTY(cSignUser)
		
			lRemoveSignature = .T.	
			*Adding, Actually - No Signature yet
		ELSE
			lRemoveSignature = .F.
			*Check for Chem or Physical change, remove signature if found!
		
		
			PRIVATE cSQL	
			**Compare currect Chemistry to old!
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Cert WHERE "
			cSQL = cSQL +" Al LIKE '%"+cAl+"'"
			cSQL = cSQL +" AND B LIKE '%"+cB1+"'"
		*	cSQL = cSQL +" AND Be LIKE '%"+cBe+"'"
			cSQL = cSQL +" AND C LIKE '%"+cC+"'"
			cSQL = cSQL +" AND Cb LIKE '%"+cCb+"'"
			cSQL = cSQL +" AND Co LIKE '%"+cCo+"'"
			cSQL = cSQL +" AND Cr LIKE '%"+cCr+"'"
			cSQL = cSQL +" AND Cu LIKE '%"+cCu+"'"
			cSQL = cSQL +" AND Fe LIKE '%"+cFe+"'" 
			cSQL = cSQL +" AND H LIKE '%"+H+"'"
			cSQL = cSQL +" AND Mg LIKE '%"+cMg+"'"
			cSQL = cSQL +" AND Mo LIKE '%"+cMo+"'"
			cSQL = cSQL +" AND Mn LIKE '%"+cMn+"'"
			cSQL = cSQL +" AND N LIKE '%"+cN+"'"
			cSQL = cSQL +" AND Na LIKE '%"+cNa+"'"
			cSQL = cSQL +" AND Ni LIKE '%"+cNi+"'"
			cSQL = cSQL +" AND O LIKE '%"+cO1+"'"
			cSQL = cSQL +" AND P LIKE '%"+cP+"'"
			cSQL = cSQL +" AND S LIKE '%"+cS+"'"
			cSQL = cSQL +" AND Si LIKE '%"+cSi+"'"
			cSQL = cSQL +" AND Ta LIKE '%"+cTa+"'"
			cSQL = cSQL +" AND Ti LIKE '%"+cTi+"'"
			cSQL = cSQL +" AND V LIKE '%"+cV+"'"
			cSQL = cSQL +" AND W LIKE '%"+cW+"'"
			cSQL = cSQL +" AND Y LIKE '%"+cY+"'"
			cSQL = cSQL +" AND CbandTa LIKE '%"+cCbandTa+"'"
			cSQL = cSQL +" AND NiandCo LIKE '%"+cNiandCo+"'"
			cSQL = cSQL +" AND Other LIKE '%"+cOther +"'"
			cSQL = cSQL +" AND ID="+STR(nID)
			
			PRIVATE nSQLEXEC
		
			IF USED("tmpCertCount")
				USE IN tmpCertCount
			ENDIF
			SELECT 0
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCertCount')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCertCount')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertCount")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertCount")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCertCount')
			ENDIF
			
			IF USED('tmpCertCount')
				IF tmpCertCount.Cnt = 0
					lRemoveSignature = .T.  
					*Chemistry is different
					MESSAGEBOX('Chemistry has changed.'+CHR(13)+'This cert must be rechecked and signed!',0,'Lost Signature')
				ELSE
					lRemoveSignature = .F.
					*No Chemistry changes
				ENDIF
				USE IN tmpCertCount
			ENDIF
		
			**Compare currect Mechanicals to old!
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Cert WHERE "
			cSQL = cSQL +" Ult1 ="+STR(nUlt1)
			cSQL = cSQL +" AND Yield1="+STR(nYield1)
			cSQL = cSQL +" AND Elong1="+STR(nElong1,5,1)
			cSQL = cSQL +" AND RA1="+STR(nRA1,5,1)
			cSQL = cSQL +" AND Hardness LIKE '%"+cHardness1+"'"
			cSQL = cSQL +" AND BHN="+STR(nBHN1,4,0)
			cSQL = cSQL +" AND ElonInches LIKE '%"+cElonInches+"'"
			cSQL = cSQL +" AND tLoc1 = '"+ctLoc1+"'"
			
			cSQL = cSQL +" AND Ult2 ="+STR(nUlt2)
			cSQL = cSQL +" AND Yield2="+STR(nYield2)
			cSQL = cSQL +" AND Elong2="+STR(nElong2,5,1)
			cSQL = cSQL +" AND RA2="+STR(nRA2,5,1)
			cSQL = cSQL +" AND Hardness2 LIKE '%"+cHardness2+"'"
			cSQL = cSQL +" AND BHN2="+STR(nBHN2,4,0)
			cSQL = cSQL +" AND ElonInches2 LIKE '%"+cElonInches2+"'"
			cSQL = cSQL +" AND tLoc2 = '"+ctLoc2+"'"
			
			cSQL = cSQL +" AND Ult3 ="+STR(nUlt3)
			cSQL = cSQL +" AND Yield3="+STR(nYield3)
			cSQL = cSQL +" AND Elong3="+STR(nElong3,5,1)
			cSQL = cSQL +" AND RA3="+STR(nRA3,5,1)
			cSQL = cSQL +" AND Hardness3 LIKE '%"+cHardness3+"'"
			cSQL = cSQL +" AND BHN3="+STR(nBHN3,4,0)
			cSQL = cSQL +" AND ElonInches3 LIKE '%"+cElonInches3+"'"
			cSQL = cSQL +" AND tLoc3 = '"+ctLoc3+"'"
			
			cSQL = cSQL +" AND Ult4 ="+STR(nUlt4)
			cSQL = cSQL +" AND Yield4="+STR(nYield4)
			cSQL = cSQL +" AND Elong4="+STR(nElong4,5,1)
			cSQL = cSQL +" AND RA4="+STR(nRA4,5,1)
		*	cSQL = cSQL +" AND Hardness4 LIKE '%"+cHardness4+"'"
		*	cSQL = cSQL +" AND BHN4="+STR(nBHN4,4,0)
			cSQL = cSQL +" AND ElonInches4 LIKE '%"+cElonInches4+"'"
			cSQL = cSQL +" AND tLoc4 = '"+ctLoc4+"'"
			
			cSQL = cSQL +" AND Ult5 ="+STR(nUlt5)
			cSQL = cSQL +" AND Yield5="+STR(nYield5)
			cSQL = cSQL +" AND Elong5="+STR(nElong5,5,1)
			cSQL = cSQL +" AND RA5="+STR(nRA5,5,1)
		*	cSQL = cSQL +" AND Hardness5 LIKE '%"+cHardness5+"'"
		*	cSQL = cSQL +" AND BHN5="+STR(nBHN5,4,0)
			cSQL = cSQL +" AND ElonInches5 LIKE '%"+cElonInches5+"'"
			cSQL = cSQL +" AND tLoc5 = '"+ctLoc5+"'"
		
			cSQL = cSQL +" AND Ult6 ="+STR(nUlt6)
			cSQL = cSQL +" AND Yield6="+STR(nYield6)
			cSQL = cSQL +" AND Elong6="+STR(nElong6,5,1)
			cSQL = cSQL +" AND RA6="+STR(nRA6,5,1)
			cSQL = cSQL +" AND ElonInches6 LIKE '%"+cElonInches6+"'"
			cSQL = cSQL +" AND tLoc6 = '"+ctLoc6+"'"
		
			cSQL = cSQL +" AND Ult7 ="+STR(nUlt7)
			cSQL = cSQL +" AND Yield7="+STR(nYield7)
			cSQL = cSQL +" AND Elong7="+STR(nElong7,5,1)
			cSQL = cSQL +" AND RA7="+STR(nRA7,5,1)
			cSQL = cSQL +" AND ElonInches7 LIKE '%"+cElonInches7+"'"
			cSQL = cSQL +" AND tLoc7 = '"+ctLoc7+"'"
		
			cSQL = cSQL +" AND SpecLMA LIKE '%"+cSpecLMA+"'"
			cSQL = cSQL +" AND SpecSpaceX LIKE '%"+cSpecSpaceX+"'"
				
			cSQL = cSQL +" AND HeatTreat LIKE '%"+cHeatTreat+"'"
			cSQL = cSQL +" AND CorrosionR LIKE '%"+cCorrosionR+"'"
			cSQL = cSQL +" AND GrainSize LIKE '%"+cGrainSize+"'"
			cSQL = cSQL +" AND SrHours="+STR(nSrHours,5,1)
			cSQL = cSQL +" AND SrTemp LIKE '%"+cSrTemp+"'"
			cSQL = cSQL +" AND SrStress="+STR(nSrStress)
			cSQL = cSQL +" AND SrRA="+STR(nSrRA,5,1)
			cSQL = cSQL +" AND SrElong="+STR(nSrElong,5,1)
			cSQL = cSQL +" AND ID="+STR(nID)
		*,cTestpo,cLabused,lSigned,nMachine
		*cXtrainfo,lQA,cQArev,lMercfree,lNoWeld,lDFARS
			
			PRIVATE nSQLEXEC
		
			IF USED("tmpCertCount")
				USE IN tmpCertCount
			ENDIF
			SELECT 0
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCertCount')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCertCount')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertCount")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertCount")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCertCount')
			ENDIF
			
			IF USED('tmpCertCount')
				IF tmpCertCount.Cnt = 0
					lRemoveSignature = .T.  
					*Chemistry is different
					MESSAGEBOX('Mechanicals have changed.'+CHR(13)+'This cert must be rechecked and signed!',0,'Lost Signature')
				ELSE
					lRemoveSignature = .F.
					*No Chemistry changes
				ENDIF
				USE IN tmpCertCount
			ENDIF
		
		
		ENDIF
		*MESSAGEBOX('Cert identification has changed.'+CHR(13)+'This cert must be rechecked and signed!',0,'Lost Signature')
		
		*Check Permission to update Cert
		*must be member of WINDFALL\Certs
		
		
		*Update
		cSQL = "UPDATE dbo.Cert SET "
		cSQL = cSQL +" Reference='"+cReference+"'"
		cSQL = cSQL +",DateCert='"+IIF(dDateCert=CTOD("  /  /  "),"",DTOC(dDateCert) )+"'"
		cSQL = cSQL +",DateProd='"+IIF(dDateProd=CTOD("  /  /  "),"",DTOC(dDateProd) )+"'"
		cSQL = cSQL +",Heat='"+cHeat+"'"
		cSQL = cSQL +",Lot="+STR(nLot,5,0)
		cSQL = cSQL +",Alloy='"+cAlloy+"'"
		cSQL = cSQL +",Size='"+cSize+"'"
		cSQL = cSQL +",Spec='"+cSpec+"'"
		*cSQL = cSQL +",Spec2='"+cSpec2+"'"
		cSQL = cSQL +",UNS='"+cUNS+"'"
		cSQL = cSQL +",Al='"+cAl+"'"
		cSQL = cSQL +",B='"+cB1+"'"
		*cSQL = cSQL +",Be='"+cBe+"'"
		cSQL = cSQL +",C='"+cC+"'"
		cSQL = cSQL +",Ca='"+cCa+"'"
		cSQL = cSQL +",Cb='"+cCb+"'"
		cSQL = cSQL +",Cd='"+cCd+"'"
		cSQL = cSQL +",Cl='"+cCl+"'"
		cSQL = cSQL +",Co='"+cCo+"'"
		cSQL = cSQL +",Cr='"+cCr+"'"
		cSQL = cSQL +",Cu='"+cCu+"'"
		cSQL = cSQL +",Fe='"+cFe+"'"
		cSQL = cSQL +",H='"+cH+"'"
		cSQL = cSQL +",Hf='"+cHf+"'"
		cSQL = cSQL +",Mg='"+cMg+"'"
		cSQL = cSQL +",Mn='"+cMn+"'"
		cSQL = cSQL +",Mo='"+cMo+"'"
		cSQL = cSQL +",N='"+cN+"'"
		cSQL = cSQL +",Na='"+cNa+"'"
		cSQL = cSQL +",Ni='"+cNi+"'"
		cSQL = cSQL +",O='"+m.cO1+"'"
		cSQL = cSQL +",P='"+cP+"'"
		cSQL = cSQL +",Pb='"+cPb+"'"
		cSQL = cSQL +",S='"+cS+"'"
		cSQL = cSQL +",Si='"+cSi+"'"
		cSQL = cSQL +",Sn='"+cSn+"'"
		cSQL = cSQL +",Ta='"+cTa+"'"
		cSQL = cSQL +",Ti='"+cTi+"'"
		cSQL = cSQL +",U='"+cU1+"'"
		cSQL = cSQL +",V='"+cV+"'"
		cSQL = cSQL +",W='"+cW+"'"
		cSQL = cSQL +",Y='"+cY+"'"
		cSQL = cSQL +",Zr='"+cZr+"'"
		cSQL = cSQL +",CbandTa='"+cCbandTa+"'"
		cSQL = cSQL +",NiandCo='"+cNiandCo+"'"
		cSQL = cSQL +",Other='"+cOther+"'"
		cSQL = cSQL +",Ult1="+STR(nUlt1,10,0)
		cSQL = cSQL +",Yield1="+STR(nYield1,10,0)
		cSQL = cSQL +",Elong1="+STR(nElong1,5,1)
		cSQL = cSQL +",RA1="+STR(nRA1,5,1)
		cSQL = cSQL +",Hardness='"+cHardness1+"'"
		cSQL = cSQL +",BHN="+STR(nBHN1,4,0)
		cSQL = cSQL +",tLoc1='"+ctLoc1+"'"
		
		cSQL = cSQL +",ElonInches='"+cElonInches+"'"
		cSQL = cSQL +",HeatTreat='"+cHeatTreat+"'"
		cSQL = cSQL +",Corrosionr='"+cCorrosionR+"'"
		cSQL = cSQL +",GrainSize='"+cGrainSize+"'"
		
		cSQL = cSQL +",Ult2="+STR(nUlt2,10,0)
		cSQL = cSQL +",Yield2="+STR(nYield2,10,0)
		cSQL = cSQL +",Elong2="+STR(nElong2,5,1)
		cSQL = cSQL +",RA2="+STR(nRA2,5,1)
