	PROCEDURE addnewcert
		*ThisFormSet.AddNewCert()
		
		PRIVATE cHeat
		cHeat = ThisFormset.hpacert.PF1.pgCert.txtHeat.Value
		
		
		*ThisFormSet.ReturnLot
		DO CASE
		CASE THISFORMSET.ReturnType = "N"
			RetType = "NEW"
		CASE THISFORMSET.ReturnType = "C"
			RetType = "CLONE"
		OTHERWISE
			*From GFM, Roll or Press or Exit
			RetType = "EXIT"
		ENDCASE
		
		PRIVATE nLot,nNewLot
		nLot = PrepareSQLnum(ThisFormSet.ReturnLot,'Lot',-3)
		nNewLot = nLot
		
		IF RetType = "CLONE"
			PRIVATE cReference,dDateCert,dDateProd
			PRIVATE cHeat,nLot,cAlloy,cSize,cSpec,cUNS
			PRIVATE cAl,cB1,cBe,cC,cCa,cCb,cCd,cCl,cCo,cCr,cCu,cFe
			PRIVATE cH,cHf,cMg,cMn,cMo,cN,cNa,cNi,cO1,cP,cPb
			PRIVATE cS,cSi,cSn,cTa,cTi,cU1,cV,cW,cY,cZr
			PRIVATE cCbandTa,cNiandCo,cOther
		
			PRIVATE nUlt1,nYield1,nElong1,nRA1,cHardness1,nBHN1,cElonInches, ctLoc1
			PRIVATE nUlt2,nYield2,nElong2,nRA2,cHardness2,nBHN2,cElonInches2,ctLoc2
			PRIVATE nUlt3,nYield3,nElong3,nRA3,cHardness3,nBHN3,cElonInches3,ctLoc3
			PRIVATE nUlt4,nYield4,nElong4,nRA4,cHardness4,nBHN4,cElonInches4,ctLoc4
			PRIVATE nUlt5,nYield5,nElong5,nRA5,cHardness5,nBHN5,cElonInches5,ctLoc5
			PRIVATE nUlt6,nYield6,nElong6,nRA6,cElonInches6,ctLoc6
			PRIVATE nUlt7,nYield7,nElong7,nRA7,cElonInches7,ctLoc7
			PRIVATE cSpecLMA, cSpecSpaceX, cHeatTreat
			PRIVATE cCorrosionR,cGrainSize,cTestPO,cLabUsed,cTestPO2,cLabUsed2,nMachine
			PRIVATE cXtrainfo,lQA,cQArev,lMercFree,lNoWeld,lDFARS
			PRIVATE nSrHours,cSrTemp,nSrStress,nSrRA,nSrElong,nID,nStockLst_ID
		
			cReference	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtReference.Value,'Reference',10))
			dDateCert	= PrepareSQLdate(ThisFormset.hpacert.PF1.pgCert.txtDateCert.Value,'DateCert',.F.,.T.)
			dDateProd	= PrepareSQLdate(ThisFormset.hpacert.PF1.pgCert.txtDateProd.Value,'DateProd',.F.,.T.)
			cHeat		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHeat.Value,'Heat',40))
			nLot		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtLot.Value,'Lot',5,0)
			cAlloy		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtAlloy.Value,'Alloy',35))
			cSize		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSize.Value,'Size',10))
			cSpec		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSpec.Value,'Spec',-1))
			cSpecLMA	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSpecLMA,'SpecLMA',40))
			cSpecSpaceX	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSpecSpaceX,'SpecSpaceX',80))
			cHeatTreat	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHeatTreat.Value,'HeatTreat',200))
		
			cUNS		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtUNS.Value,'UNS',10))
		
			cAl			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtAl.Value,'Al',7))
			cB1			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtB.Value,'B',7))
			cC			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtC.Value,'C',7))
			cCa			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCa.Value,'Ca',7))
			cCb			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCb.Value,'Cb',7))
			cCd			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCd.Value,'Cd',7))
			cCl			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCl.Value,'Cl',7))
			cCo			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCo.Value,'Co',7))
			cCr			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCr.Value,'Cr',7))
			cCu			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCu.Value,'Cu',7))
			cFe			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtFe.Value,'Fe',7))
			cH			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtH.Value,'H',7))
			cHf			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHf.Value,'Hf',7))
			cMg			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtMg.Value,'Mg',7))
			cMn			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtMn.Value,'Mn',7))
			cMo			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtMo.Value,'Mo',7))
			cN			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtN.Value,'N',7))
			cNa			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtNa.Value,'Na',7))
			cNi			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtNi.Value,'Ni',7))
			cO1			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtO.Value,'O',7))
			cP			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtP.Value,'P',7))
			cPb			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtPb.Value,'Pb',7))
			cS			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtS.Value,'S',7))
			cSi			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSi.Value,'Si',7))
			cSn			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSn.Value,'Sn',7))
			cTa			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtTa.Value,'Ta',7))
			cTi			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtTi.Value,'Ti',7))
			cU1			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtU.Value,'U',7))
			cV			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtV.Value,'V',7))
			cW			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtW.Value,'W',7))
			cY			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtY.Value,'Y',7))
			cZr			= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtZr.Value,'Zr',7))
			cCbandTa	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCbandTa.Value,'CbandTa',10))
			cNiandCo	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtNiandCo.Value,'NiandCo',10))
			cOther		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtOther.Value,'Other',25))
			
			nUlt1		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtUlt.Value,'Ult',10,0)
			nYield1		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtYield.Value,'Yield',10,0)
			nElong1		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtElong.Value,'Elong',4,1)
			nRA1		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtRA.Value,'RA',4,1)
			cHardness1	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHardness.Value,'Hardness',10))
			nBHN1		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtBHN.Value,'BHN',4,0)
			cElonInches	= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtEloninches.Value,'ElonInches',5)
			ctLoc1		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txttLoc1.Value,'tLoc',1)
			
			nUlt2		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtUlt2.Value,'Ult',10,0)
			nYield2		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtYld2.Value,'Yield',10,0)
			nElong2		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtEl2.Value,'Elong',4,1)
			nRA2		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtRA2.Value,'RA',4,1)
			cHardness2	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHardness2.Value,'Hardness',10))
			nBHN2		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtBHN2.Value,'BHN',4,0)
			cElonInches2= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtEloninches2.Value,'ElonInches',5)
			ctLoc2		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txttLoc2.Value,'tLoc',1)
			
			nUlt3		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtUlt3.Value,'Ult',10,0)
			nYield3		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtYld3.Value,'Yield',10,0)
			nElong3		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtEl3.Value,'Elong',4,1)
			nRA3		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtRA3.Value,'RA',4,1)
			cHardness3	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHardness3.Value,'Hardness',10))
			nBHN3		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtBHN3.Value,'BHN',4,0)
			cElonInches3= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtEloninches3.Value,'ElonInches',5)
			ctLoc3		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txttLoc3.Value,'tLoc',1)
			
			nUlt4		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtUlt4.Value,'Ult',10,0)
			nYield4		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtYld4.Value,'Yield',10,0)
			nElong4		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtEl4.Value,'Elong',4,1)
			nRA4		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtRA4.Value,'RA',4,1)
		*	cHardness4	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHardness4.Value,'Hardness',10))
		*	nBHN4		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtBHN4.Value,'BHN',4,0)
			cElonInches4= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtEloninches4.Value,'ElonInches',5)
			ctLoc4		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txttLoc4.Value,'tLoc',1)
			
			nUlt5		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtUlt5.Value,'Ult',10,0)
			nYield5		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtYld5.Value,'Yield',10,0)
			nElong5		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtEl5.Value,'Elong',4,1)
			nRA5		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtRA5.Value,'RA',4,1)
		*	cHardness5	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtHardness5.Value,'Hardness',10))
		*	nBHN5		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtBHN5.Value,'BHN',4,0)
			cElonInches5= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtEloninches5.Value,'ElonInches',5)
			ctLoc5		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txttLoc5.Value,'tLoc',1)
			
			nUlt6		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtUlt6.Value,'Ult',10,0)
			nYield6		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtYld6.Value,'Yield',10,0)
			nElong6		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtEl6.Value,'Elong',4,1)
			nRA6		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtRA6.Value,'RA',4,1)
			cElonInches6= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtEloninches6.Value,'ElonInches',5)
			ctLoc6		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txttLoc6.Value,'tLoc',1)
		
			nUlt7		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtUlt7.Value,'Ult',10,0)
			nYield7		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtYld7.Value,'Yield',10,0)
			nElong7		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtEl7.Value,'Elong',4,1)
			nRA7		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtRA7.Value,'RA',4,1)
			cElonInches7= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtEloninches7.Value,'ElonInches',5)
			ctLoc7		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txttLoc7.Value,'tLoc',1)
		
			cCorrosionR	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtCorrosionr.Value,'Corrosionr',60))
			cGrainSize	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtGrainsize.Value,'Grainsize',10))
			cTestPO		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtTestPO.Value,'TestPO',12))
			cLabUsed	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtLabUsed.Value,'LabUsed',12))
			cTestPO2	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtTestPO2.Value,'TestPO',12))
			cLabUsed2	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtLabUsed2.Value,'LabUsed',12))
		
			nMachine	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.grpMach.Value,'Machine',1,0)
			cXtraInfo	= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.edtXtraInfo.Value,'XtraInfo',-1))
			lQA			= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkQA.Value,'QA')
			cQArev		= PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtQArev.Value,'QArev',20)
			lMercFree	= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkMercFree.Value,'MercFree')
			lNoWeld		= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkNoWeld.Value,'NoWeld')
			lDFARS		= PrepareSQLchk(ThisFormset.hpacert.PF1.pgCert.chkDFARS.Value,'DFARS')
			nSrHours	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrhours.Value,'Srhours',4,1)
			cSrTemp		= ALLTRIM(PrepareSQLtxt(ThisFormset.hpacert.PF1.pgCert.txtSrTemp.Value,'SrTemp',10))
			nSrStress	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrStress.Value,'SrStress',10,0)
			nSrRA		= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrRA.Value,'SrRA',4,1)
			nSrElong	= PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtSrElong.Value,'SrElong',4,1)
			nID			= 0
			nStockLst_ID = PrepareSQLnum(ThisFormset.hpacert.PF1.pgCert.txtStockLst_ID.Value,'StockLst_ID',-3)
		ENDIF
		
		SELECT HPACert
			
		DO CASE
		CASE ThisFormSet.ReturnWhatMach = "G" &&OR nMachine = 2
			RetMach = "GFM"
		CASE ThisFormSet.ReturnWhatMach = "R" &&OR nMachine = 3
			RetMach = "ROLL"
		CASE ThisFormSet.ReturnWhatMach = "L" &&OR nMachine = 4
			RetMach = "LakeErie"
		OTHERWISE
			RetMach = "none"	
		ENDCASE
		
		*cRetlot = LTRIM(STR( val( Right(ReturnAction, Len(ReturnAction)-2))))	
		*nRetLot = VAL( cRetLot )
		
		PRIVATE nNewCertID
		nNewCertID = 0
		
		DO CASE
		CASE RetType = "EXIT"
		**** Do not ADD
			wait window 'No records added' NOWAIT
			RETURN
		CASE RetType = "NEW" AND RetMach = "none"
		**ADD blank RECORD
			IF USED("tmpCertID")	
				USE IN tmpCertID
			ENDIF
			
			SELECT 0
			cSQL = "EXEC dbo.p_Cert_ins @Machine=0"
						
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCertID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL , 'tmpCertID')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCertID")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCertID')
			ENDIF
			
			IF USED('tmpCertID')
				IF VARTYPE(tmpCertID.ID) = 'N'
				
					nNewCertID = tmpCertID.ID
					ThisFormset.hpacert.PF1.pgCert.txtID.Value = nNewCertID
					ThisFormSet.SelectCertID(tmpCertID.ID)
					
					ThisFormSet.SetCertNew()
					
					isadding=.T.
					ThisFormSet.SetEditing()
					ThisFormset.hpacert.PF1.pgCert.grpMach.OpStandard.Value = 1
					ThisFormset.hpacert.PF1.pgCert.grpMach.OpStandard.Refresh
				ENDIF
				USE IN tmpCertID
			ENDIF
			
