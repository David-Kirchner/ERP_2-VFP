	PROCEDURE frmCustomer.cmdDelete.Click
		PRIVATE nCO_ID
		nCO_ID = ThisFormset.frmCustomer.txtCO_ID.Value
		
		IF nCO_ID > 0
		
			IF MESSAGEBOX("Are you sure you want to 'Delete' This Record "+ALLTRIM(STR(nCO_ID))+"?",4+32,"Delete?") = 6		
				PRIVATE cSQL,nSQLEXEC 
				
				cSQL = "DELETE FROM dbo.Cert_Co WHERE CO_ID ="+STR(nCO_ID)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ENDIF
					
				*refresh
				ThisFormSet.SelectCertID(ThisFormset.hpacert.PF1.pgCert.txtID.Value)
				ThisFormSet.GetCert_CO()
				
			ENDIF
		ELSE
			MESSAGEBOX("No Record to Delete",0+16,"No ID")
		ENDIF
		
		ThisFormSet.SetCert_CO_Edit(0)
		
	ENDPROC

	PROCEDURE frmCustomer.cmdEdit.Click
