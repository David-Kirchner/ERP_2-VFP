			loListener.cUserPassword=''
			loListener.lOpenViewer=.F.
		
			THISFORM.VISIBLE = .F.
					
			REPORT FORM Reports\certs11 RECORD m.currntrecrd Object loListener
			
			RELEASE loListener
			THISFORM.VISIBLE = .T.
		
			********************************
			IF FILE(cFileName)
				#DEFINE olFolderInbox 6
				#DEFINE olFolderOutbox 4
				#DEFINE olMailItem 0
				#DEFINE olRecipient 4
				#DEFINE olRecipients 17
				#DEFINE IMPORTANCENORMAL 1
				loApp=CreateObject("Outlook.Application")
				IF VARTYPE(loApp)="O"
					loNamespace = loApp.GetNamespace("MAPI")
					loFolder = loNamespace.GetDefaultFolder(olFolderInbox)
					loEMailItem = loFolder.Items.Add(olMailItem)
					loEmailItem.Subject = "HPA Cert"
					loEmailItem.Importance = IMPORTANCENORMAL
					loEmailItem.HTMLBody = [<html><font face = "Arial">];
					+ [<font size = 2> <font color = 0>High Performance Alloys Cert</font></html>]
					
					loEmailItem.Attachments.Add(cFileName)
		
					loemailitem.Display()
					*loEmailItem.Send
					*loApp.Quit()
					RELEASE loApp, loEmailItem
					
					WAIT WINDOW "Click on the blinking Outlook window to address you Email" NOWAIT
				ENDIF
			ELSE
				MESSAGEBOX("Failed to create file."+CHR(13)+cFileName,16,"File not Created.")
			ENDIF
			
			IF FILE(cFileName)
				DELETE FILE (cFileName)
			ENDIF
		
		
		ENDIF
			
		SELECT HPACert
		IF m.currntrecrd <= RECCOUNT('HPACert')
			GOTO m.currntrecrd
		ELSE
			GO TOP
		ENDIF
		
	ENDPROC

	PROCEDURE hpacert.PF1.pgCert.cmdPrintSpaceX.Valid
		local m.currntrecrd
		
		IF NOT USED("HPACert_Co")
			MESSAGEBOX("Could not load the Customer Specific Database",0,"Data load Error")
		ENDIF
		
		SELECT HPACert
		m.currntrecrd = recno('HPACert')
		PRIVATE nCertID
		nCertID = HPACert.ID
		
		************************
		*Create Pivot Table of tmpCertProfile
		
		SELECT 0
		IF USED('CertSPX')
			USE IN CertSPX
		ENDIF
		
		IF NOT ThisFormSet.CreateTable_CertSPX(nCertID)
			RETURN .F.
		ENDIF
		*SELECT * FROM HPACert WHERE HPACert=nCertID INTO CURSOR 'CertSPX' NOFILTER 
			
		
		SELECT HPACert
		
		IF PrepareSQLnum(HPACert.Ult6,'Ult6',-3) > 0
			REPORT FORM Reports\Certs_SpaceX5 TO PRINTER PROMPT NOCONSOLE
		ELSE
			*REPORT FORM Reports\certs RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
			REPORT FORM Reports\Certs_SpaceX TO PRINTER PROMPT NOCONSOLE
		ENDIF
		
		IF MESSAGEBOX("Do you want to send email from Outlook?",4+64,"Email")=6
			
			***************************************
			PRIVATE cFileName, cNewPDFName
			cFileName = EmailFileName("HPA_Cert.PDF")
			cNewPDFName = "HPA_Cert_"+ALLTRIM(STR(HPACert.ID))+".PDF"
			
			DO WHILE FILE(cFileName)
				nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
				IF nMess = 7 &&No
					DELETE FILE (cFileName)
				ENDIF
			ENDDO
			
			*****************************
			LOCAL loListener AS "PdfListener" OF "Pdfx.vcx"
		
			loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
			loListener.cCodePage="CP1252" &&CodePage
			loListener.cTargetFileName = cFileName
			loListener.QuietMode=.F.
			loListener.lCanPrint=.T.
			loListener.lCanEdit=.F.
			loListener.lCanCopy=.T.
			loListener.lCanAddNotes=.F.
			loListener.lEncryptDocument=.F.
			loListener.cMasterPassword=''
			loListener.cUserPassword=''
			loListener.lOpenViewer=.F.
		
			THISFORM.VISIBLE = .F.
		
			IF PrepareSQLnum(HPACert.Ult6,'Ult6',-3) > 0
				REPORT FORM Reports\Certs_SpaceX5 RECORD m.currntrecrd Object loListener
			ELSE
				REPORT FORM Reports\Certs_SpaceX RECORD m.currntrecrd Object loListener
			ENDIF
			
			RELEASE loListener	
			THISFORM.VISIBLE = .T.
			
			********************************
			IF FILE(cFileName)
				#DEFINE olFolderInbox 6
				#DEFINE olFolderOutbox 4
				#DEFINE olMailItem 0
				#DEFINE olRecipient 4
				#DEFINE olRecipients 17
				#DEFINE IMPORTANCENORMAL 1
				loApp=CreateObject("Outlook.Application")
				IF VARTYPE(loApp)="O"
					loNamespace = loApp.GetNamespace("MAPI")
					loFolder = loNamespace.GetDefaultFolder(olFolderInbox)
					loEMailItem = loFolder.Items.Add(olMailItem)
					loEmailItem.Subject = "HPA Cert"
					loEmailItem.Importance = IMPORTANCENORMAL
					loEmailItem.HTMLBody = [<html><font face = "Arial">];
					+ [<font size = 2> <font color = 0>High Performance Alloys Cert</font></html>]
					
					loEmailItem.Attachments.Add(cFileName)
					loemailitem.Display()
					*loEmailItem.Send
					*loApp.Quit()
					RELEASE loApp, loEmailItem
					
					WAIT WINDOW "Click on the blinking Outlook window to address you Email" NOWAIT
					IF FILE(cFileName)
						DELETE FILE (cFileName)
					ENDIF
				ELSE
					MESSAGEBOX("Could not create Object."+CHR(13)+"Outlook.Application",16,"Could not create Object.")
				ENDIF
			ELSE
				MESSAGEBOX("Failed to create file."+CHR(13)+cFileName,16,"File not Created.")
			ENDIF
			IF FILE(cFileName)
				DELETE FILE (cFileName)
			ENDIF
		ENDIF
		
		IF USED('CertSPX')
			USE IN CertSPX
		ENDIF
		
		SELECT HPACert
		IF m.currntrecrd <= RECCOUNT('HPACert')
			GOTO m.currntrecrd
		ELSE
			GO TOP
		ENDIF
		
	ENDPROC

