	PROCEDURE hpacert.PF1.pgCert.cmdBrowse.Click
		PRIVATE nID
		nID = HPACert.ID
		
		IF RECCOUNT('HPACert') < 2
		*	ThisFormSet.Get_Cert('HEATLOT',HPACert.Heat,HPACert.Lot)
			ThisFormSet.Get_Cert('HEAT',HPACert.Heat)
		ENDIF
		
		SELECT HPACert
		
		BROWSE FIELDS Alloy,size,Heat,Machine,Lot,spec,uns,ult1,yield1,Elong1,Ra1,Heattreat,Hardness,BHN NODELETE NOEDIT TITLE "Esc to leave" 
		*NOWAIT
		
		IF nID != HPACert.ID
		
			ThisFormSet.Get_Cert('ID',HPACert.ID )
			
			ThisForm.PF1.pgCert.Refresh
		ENDIF
		
	ENDPROC

