	PROCEDURE cmdSave.Click
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF WEXIST("frmWO_Detail_Notes")
			RELEASE WINDOWS frmWO_Detail_Notes
		ENDIF
		
		IF nWO_Detail > 0
		
			*Slightly move to only see the Edit screen
			PRIVATE nTop, nLeft
			nTop = ThisForm.Top -10
			nLeft = ThisForm.Left 
			
		
			*DO FORM Forms\WO_Detail_Notes WITH nWO_Detail, ThisForm.nConnHandle, nTop, nLeft LINKED
			DO FORM Forms\WO_Detail_Notes WITH nWO_Detail, nTop, nLeft 
			
			ThisForm.Refresh_WO_Detail_V()
			
		ENDIF
		
		ThisForm.Refresh
		
		*ThisForm.Release
	ENDPROC

