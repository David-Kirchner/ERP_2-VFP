	PROCEDURE txtFAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtFAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtFAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				
				ThisFormSet.Calc_Weight('FINISH',.F.)
				
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtfID_Detail.Click
		
		*cHyperLink = HTML_Stock_ID_Detail(TBL,ID_Detail,pReturnURL)
		PRIVATE cTBL,nID_Detail
		cTBL = "S"
		nID_Detail = PrepareSQLnum(This.Value,'ID_Detail',-3)
		IF nID_Detail > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_Stock_ID_Detail(cTBL,nID_Detail,.T.) &&lReturnURL --not URL is an HTML code.
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			MESSAGEBOX("No number",0,"Error")
		ENDIF
	ENDPROC

