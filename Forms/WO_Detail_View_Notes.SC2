	PROCEDURE refresh_wo_detail_v
		*ThisForm.Refresh_WO_Detail_V()
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		****
		PRIVATE lFound_WOD 
		lFound_WOD = .F.
		
		IF USED('tmpWO_DetailVN')	
			USE IN tmpWO_DetailVN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT WOD.*"
		cSQL = cSQL +", ISNULL(ACWOD.AC_ID,0) AS AC_ID_WOD "
		cSQL = cSQL +" FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.AcctCost_WOD ACWOD WITH(NOLOCK) ON WOD.WO_Detail = ACWOD.WO_Detail "
		cSQL = cSQL +" WHERE WOD.WO_Detail ="+STR(nWO_Detail)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_DetailVN')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpWO_DetailVN')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_DetailVN")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_DetailVN")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWO_DetailVN')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_DetailVN')
				IF RECCOUNT('tmpWO_DetailVN') > 0
					SELECT tmpWO_DetailVN
					LOCATE FOR WO_Detail = nWO_Detail
					IF FOUND()
						lFound_WOD = .T.
					ELSE
						GO TOP
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF USED('tmpWO_DetailVN') AND lFound_WOD 
			IF FOUND('tmpWO_DetailVN')
				ThisForm.txtWO_Detail.Value = nWO_Detail
				
				ThisForm.txtWO.Value = PrepareSQLnum(tmpWO_DetailVN.WO,'WO',-3)
				
				ThisForm.txtFPieces.Value	= PrepareSQLnum(tmpWO_DetailVN.fPieces,'Pieces',-3)
				ThisForm.txtFAlloy.Value	= PrepareSQLtxt(tmpWO_DetailVN.fAlloy,'Alloy',12)
				ThisForm.txtFForm.Value		= PrepareSQLtxt(tmpWO_DetailVN.fForm,'Form',2)
				*ThisFormSet.RefreshFForms(tmpWO_DetailVN.fForm)
				ThisForm.txtFcc.Value		= PrepareSQLtxt(tmpWO_DetailVN.fCC,'CC',1)
				*ThisFormSet.InitcmbFCL()
		
				ThisForm.txtFCL.Value		= PrepareSQLtxt(tmpWO_DetailVN.fCL,'CL',1)
				ThisForm.txtFThck.Value		= PrepareSQLnum(tmpWO_DetailVN.fThck,'Thck',10,4)
				ThisForm.txtFSz2.Value		= PrepareSQLnum(tmpWO_DetailVN.fSz2,'Sz2',9,3)
				ThisForm.txtFSz3.Value		= PrepareSQLnum(tmpWO_DetailVN.fSz3,'Sz3',9,3)
		*		ThisForm.chkPinFWeight.Value	= PrepareSQLchk(tmpWO_DetailVN.pinFWeight,'pinFWeight')
				ThisForm.txtFWeight.Value 	= PrepareSQLnum(tmpWO_DetailVN.fWeight,'Weight',9,1)
		
				ThisForm.txtFSpec.Value		= PrepareSQLtxt(tmpWO_DetailVN.fSpec,'FSpec',50)
		
				ThisForm.txtStock_Projected_ID.Value = PrepareSQLnum(tmpWO_DetailVN.Stock_Projected_ID,'Stock_Projected_ID',-3)
		
				*ThisFormSet.Refresh_Projected()
				
				ThisForm.txtFID_Detail.Value = PrepareSQLnum(tmpWO_DetailVN.fID_Detail,'ID_Detail',-3)
				IF PrepareSQLnum(tmpWO_DetailVN.fID_Detail,'ID_Detail',-3) > 0
					ThisForm.txtFID_Detail.BackColor = RGB(0,128,255)
				ELSE
					ThisForm.txtFID_Detail.BackColor = RGB(240,240,240)
				ENDIF	
				ThisForm.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWO_DetailVN.fID_Detail_Process,'ID_Detail_Process',-3)
				ThisForm.txtfTBL.Value 			= PrepareSQLtxt(tmpWO_DetailVN.fTBL,'TBL',1)
				ThisForm.txtfReceivingID.Value 	= PrepareSQLnum(tmpWO_DetailVN.fReceivingID,'ReceivingID',-3)
				
				ThisForm.txtAC_ID_WOD.Value	= PrepareSQLnum(tmpWO_DetailVN.AC_ID_WOD,'AC_ID',-3)
				
				ThisForm.txtFSOitem.Value	= PrepareSQLtxt(tmpWO_DetailVN.fSOitem,'SOitem',10)
				ThisForm.txtFPOitem.Value	= PrepareSQLtxt(tmpWO_DetailVN.fPOitem,'POitem',12)
				
				ThisForm.txtFDescript.Value	= PrepareSQLtxt(tmpWO_DetailVN.fDescript,'Descript',100)
				ThisForm.txtfCondLevel.Value= PrepareSQLtxt(tmpWO_DetailVN.fCondLevel,'fCondLevel',30)
				
				ThisForm.txtFollowM.Value	= PrepareSQLtxt(tmpWO_DetailVN.FollowM,'FollowM',20)
				ThisForm.txtFollowLot.Value	= PrepareSQLnum(tmpWO_DetailVN.FollowLot,'FollowLot',-3)
				ThisForm.txtFinishM.Value	= PrepareSQLtxt(tmpWO_DetailVN.FinishM,'FinishM',20)
				ThisForm.txtFinishLot.Value	= PrepareSQLnum(tmpWO_DetailVN.FinishLot,'FinishLot',-3)
				
				ThisForm.txtTestPO.Value	= PrepareSQLtxt(tmpWO_DetailVN.TestPO,'POitem',12)
				
		*		ThisForm.txtStartSize.Value	= PrepareSQLnum(tmpWO_DetailVN.StartSize,'StartSize',8,3)
		*		ThisForm.txtCW.Value		= PrepareSQLnum(tmpWO_DetailVN.CW,'CW',-1)
		*		ThisForm.txtRoughSize.Value = PrepareSQLnum(tmpWO_DetailVN.RoughSize,'RoughSize',8,3)
		*		ThisForm.txtOverSize.Value	= PrepareSQLnum(tmpWO_DetailVN.OverSize,'OverSize',5,3)
				
				ThisForm.edtfNotes.Value	= PrepareSQLtxt(tmpWO_DetailVN.fNotes,'Notes',-1)
				
			
				ThisForm.txtFDueDate.Value	= PrepareSQLdate(tmpWO_DetailVN.fDueDate,'DueDate')
		*		ThisForm.cmbNextCode.Value	= PrepareSQLtxt(tmpWO_DetailVN.NextCode,'NextCode',3)
		*		ThisForm.txtNextNumber.Value = PrepareSQLtxt(tmpWO_DetailVN.NextNumber,'NextNumber',10)
		
				
				ThisForm.chkfCmplt.Value 	= PrepareSQLchk(tmpWO_DetailVN.fCmplt,'fCmplt')
				ThisForm.chkfCncld.Value	= PrepareSQLchk(tmpWO_DetailVN.fCncld,'fCncld')
				
				ThisForm.chkStkListed.Value = PrepareSQLchk(tmpWO_DetailVN.StkListed,'StkListed')
				
				*************************************		
				*ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_DetailVN.fPOitem)
		
				*IF ThisFormSet.CheckFinish_ID_Detail()
				*ENDIF
				*IF ThisFormSet.CheckFinish_ID_Detail_Process()
				*ENDIF
				
				**********
				*ThisForm.lstWO_Detail.Value = RECNO('tmpWO_DetailVN')
				*ThisForm.lstWO_Detail.Value = ASCAN(gaWO_Detail, nWO_Detail)  &&gaWO_Detail was empty!!
				
				*ThisForm.lstWO_Detail.Visible = .T.
				
				*ThisFormSet.Show_frmStock_Produced(nWO_Detail)
				
				
			ELSE
				MESSAGEBOX("Could not find WO_Detail:"+ALLTRIM(STR(nWO_Detail)),0,"Error")
			ENDIF
			
		ENDIF
	ENDPROC

