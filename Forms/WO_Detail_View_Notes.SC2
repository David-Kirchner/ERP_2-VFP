	PROCEDURE lblChooseF_SOitem.Click
		PRIVATE nSalesNum, cSOItem
		cSOItem = PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		nSalesNum = VAL(cSoItem)
		
		
		PRIVATE lSelectedTheOnlySOitem, lRemoveSO
		lSelectedTheOnlySOitem = .F.
		lRemoveSO = .F.
		
		IF nSalesNum > 0
			nMess = MESSAGEBOX("A SO is listed here. '"+cSOItem +"'"+CHR(13)+"Do you want to keep this SO number?"+CHR(13)+"Answer Y to Continue."+CHR(13)+"Answer N to clear the SO Number.",4+32,"Continue with SO?")
			IF nMess = 7
				*Yes, Clear POitem field
				ThisForm.txtFSOitem.Value = ''
				
				ThisFormSet.Remove_SOitem(cSOItem,'WOD')	
				MESSAGEBOX("The SOitem '"+cSOItem+"' has been removed."+CHR(13)+"This edit needs to be saved.",0+48,"Removed SOitem.")
					
				lRemoveSO = .T.
				RETURN
			ENDIF
		ENDIF
		
		IF nSalesNum = 0 
			DO FORM Forms\ChooseSO WITH "ChooseSO" TO nSalesNum
			IF nSalesNum > 0
				IF Count_ItemsinSales (nSalesNum, ThisForm.nConnHandle, '') = 1
					lSelectedTheOnlySOitem = .T.		
					cSOItem = Proper_SO_item(STR(nSalesNum,7)+"-01")
				ENDIF
			ENDIF
		ENDIF
		
		IF nSalesNum > 0 AND NOT lSelectedTheOnlySOitem
			DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
		ENDIF
		
		***********
		PRIVATE nWO_Detail, nWO
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		IF Proper_SO_item(cSoItem) != Proper_SO_item('')
			*Have SO!
			ThisForm.txtFSOitem.Value = cSOItem
			
			*******************************
			*Update SO with WO_Detail
			cSQL = "UPDATE dbo.Sales SET WO_Detail="+STR(nWO_Detail)
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF	
			
			*******************************
			
			*UPDATE WorkOrder
			cSQLu = "UPDATE dbo.WorkOrder_Detail SET"
			cSQLu = cSQLu + " fSOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
			*cSQLu = cSQLu + " fPOitem = dbo.f_ProperPOitem('"+cPoItem+"')"
			cSQLu = cSQLu + " WHERE WO_Detail = "+STR(nWO_Detail)
			 
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
			ENDIF
			
			*******************************
			*Update the 'SELECTED Process to include the WO_Detail
			
			cSQL = "UPDATE dbo.StockLst_Process SET WO_Detail="+STR(nWO_Detail)
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'SELECTED'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF	
			
			
			
			*******************************
			nMess = MESSAGEBOX("Are you trying to import the contents of this SO?"+CHR(13)+"Answer Y to over write with SOitem data.",4+32,"Import SO data.")			
			IF nMess = 6
				ThisFormSet.cWhat2 = "FINISH"
				ThisFormSet.AddWOD_SOitem(cSOitem)
			ENDIF
				
			*******************************
			
		
		ELSE
			*No SO
			ThisForm.txtFSOitem.Value = ''
			*See ThisFormSet.Remove_SOitem(cSOItem,'WOD')	
		
			
			*UPDATE WorkOrder
			cSQLu = "UPDATE dbo.WorkOrder_Detail SET"
			cSQLu = cSQLu + " fSOitem = dbo.f_ProperSOitem('')"
			*cSQLu = cSQLu + " fPOitem = dbo.f_ProperPOitem('"+cPoItem+"')"
			cSQLu = cSQLu + " WHERE WO_Detail = "+STR(nWO_Detail)
			**cSQLu = cSQLu + " AND fSOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
			ENDIF
			
			*******************************
			
		ENDIF
		
		
	ENDPROC

