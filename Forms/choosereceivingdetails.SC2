				cSQL = cSQL + " AND M.Heat = 'DUE IN'"
			ENDIF
		ENDIF
		
		IF nWO_Detail > 0
			lHaveWO_Detail = .T.
			
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT fAlloy, '' AS Heat, fPieces AS Pieces, '' AS Comments, fWeight AS Pounds "
			cSQL = cSQL + ", ISNULL(fWeight,0) AS Acct_QTY "
			cSQL = cSQL + ",0 AS ID, 0 AS ID_Detail, 0 AS ID_Detail_Process, 'D' AS TBL "
			cSQL = cSQL + ",fDescript AS [Description],fSpec AS Specs, fCncld AS [cancelled] "
			cSQL = cSQL + ",1 AS Acct_PU "
			cSQL = cSQL + ",'' AS POitem, WO_Detail "
			cSQL = cSQL + ",0 AS RID "
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WD WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WD.WO_Detail = "+STR(nWO_Detail)
				
			IF cTBL = "S" OR LEN(cTBL) = 0
				cSQL = cSQL + " UNION "
				*Master Detail
				cSQL = cSQL + "SELECT M.Alloy,M.Heat, D.PC AS Pieces, '' AS Comments, 0 AS Pounds "
				cSQL = cSQL + ", ISNULL(D.S_QTY,0) AS Acct_QTY "
				cSQL = cSQL + ",M.ID, D.ID_Detail, 0 AS ID_Detail_Process, 'S' AS TBL "
