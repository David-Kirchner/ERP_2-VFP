	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE RcvPOi.Cancelld 
			nColor = RGB( 255, 0, 0 ) &&RED	
		*CASE RcvPOi.Cancelld 
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pvParameter, pcHeat, pcTBL
		*DO FORM Forms\ChooseReceivingDetails WITH POitem,Heat,TBL
		*DO FORM Forms\ChooseReceivingDetails WITH '   509753-04','62878-6RAA','S'
		
		PRIVATE cPOitem, nWO_Detail
		cPOitem = Proper_PO_item('')
		nWO_Detail = 0
		
		IF VARTYPE(pvParameter) = "C"
			cPOitem = Proper_PO_item(pvParameter)
		ELSE
			IF VARTYPE(pvParameter) = "N"
				nWO_Detail = pvParameter
			ELSE
				MESSAGEBOX("No ERP POitem or WO_Detail",0,"Bad Paramater")
				RETURN .F. 
			ENDIF
		ENDIF
		
		PRIVATE cHeat, cTBL
		cHeat = PrepareSQLtxt(pcHeat,'Heat',50)
		cTBL = PrepareSQLtxt(pcTBL,'TBL',1)
		
		IF USED("tmpReceivingPOitem")
			USE IN tmpReceivingPOitem
		ENDIF	
		
		*MESSAGEBOX("Table 'tmpReceivingPOitem' not open",0,"Open file first")
		*RETURN .F. 
		PRIVATE cSQL
		SELECT 0
		
		*!*		cSQL = "SELECT Heat,Description,Pieces,Specs,Comments,Init,ActualW,BillW,Vendor,pass"
		*!*		cSQL = cSQL + ",Cert,Received,Alloy,Init,[cancelled],ID "
		*!*		cSQL = cSQL + " FROM dbo.Receiving "
		*!*		cSQL = cSQL + " WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+pcPoItem+"')"
		*!*		IF NOT EMPTY(pcHeat)
		*!*			cSQL = cSQL + " AND Heat LIKE '%"+ALLTRIM(pcHeat)+"%'"
		*!*		ENDIF
		
		cSQL = "SELECT DISTINCT ISNULL(Heat,'') AS Heat, ISNULL(POitem,'') AS POitem, ISNULL(WO_Detail,0) AS WO_Detail "
		cSQL = cSQL + ",ISNULL(Pieces,1) AS Pieces, ISNULL(ID_Detail,0) AS ID_Detail, ISNULL(ID_Detail_Process,0) AS ID_Detail_Process"
		cSQL = cSQL + ",ISNULL(TBL,'') AS TBL, ISNULL([cancelled],0) AS [cancelled], ISNULL(Pounds,0) AS Pounds "
		cSQL = cSQL + ",ISNULL(Acct_QTY,0) AS Acct_QTY, ISNULL(Acct_PU,0) AS Acct_PU "
		cSQL = cSQL + ",[Description] ,Specs ,Comments "
		cSQL = cSQL + ",ISNULL(RID,0) AS RID "
		cSQL = cSQL + " FROM ( "
		*Receiving
		IF LEN(cHeat) > 0
			cSQL = cSQL + "SELECT Alloy, Heat, Pieces, Comments, ActualW AS Pounds "
			cSQL = cSQL + ", ISNULL(R_QTY,0) AS Acct_QTY "
			cSQL = cSQL + ",ID_Master AS ID, ID_Detail, 0 AS ID_Detail_Process, 'R' AS TBL "
			cSQL = cSQL + ",[Description] ,Specs , [cancelled] "
			cSQL = cSQL + ",ISNULL(R_PU,0) AS Acct_PU "
			cSQL = cSQL + ",POitem, WO_Detail "
			cSQL = cSQL + ",ID AS RID "
			cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
			cSQL = cSQL + " WHERE Heat = '"+cHeat+"'"
			*cSQL = cSQL + " WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDIF
		PRIVATE lHavePOitem, lHaveWO_Detail
		lHavePOitem = .F.
		lHaveWO_Detail = .F.
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			lHavePOitem = .T.
			IF cTBL = "S" OR LEN(cTBL) = 0
				cSQL = cSQL + " UNION "
				*Master Detail
				cSQL = cSQL + "SELECT M.Alloy,M.Heat, D.PC AS Pieces, '' AS Comments, 0 AS Pounds "
				cSQL = cSQL + ", ISNULL(D.S_QTY,0) AS Acct_QTY "
				cSQL = cSQL + ",M.ID, D.ID_Detail, 0 AS ID_Detail_Process, 'S' AS TBL "
				cSQL = cSQL + ",D.Descript AS [Description],M.Specs, 1 AS [cancelled] "
				*cSQL = cSQL + ",dbo.f_Get_nPU_Form(M.Form) AS Acct_PU "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + " AND M.Heat = 'DUE IN'"
		
				cSQL = cSQL + " UNION "
				*Archive Master Detail
				cSQL = cSQL + "SELECT M.Alloy,M.Heat, D.PC AS Pieces, '' AS Comments, 0 AS Pounds "
				cSQL = cSQL + ", ISNULL(M.mS_QTY,0) AS Acct_QTY "
				cSQL = cSQL + ",M.ID, D.ID_Detail, 0 AS ID_Detail_Process, 'H' AS TBL "
				cSQL = cSQL + ",'' AS [Description],M.Specs, 1 AS [cancelled] "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.[AR.Stocklst_Master_History] M WITH(NOLOCK) "
