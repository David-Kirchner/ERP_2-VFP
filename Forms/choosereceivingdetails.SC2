				*cSQL = cSQL + ",dbo.f_Get_nPU_Form(M.Form) AS Acct_PU "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		
				cSQL = cSQL + " UNION "
				*Archive Master Detail
				cSQL = cSQL + "SELECT M.Alloy,M.Heat, D.PC AS Pieces, '' AS Comments, 0 AS Pounds "
				cSQL = cSQL + ", ISNULL(M.mS_QTY,0) AS Acct_QTY "
				cSQL = cSQL + ",M.ID, D.ID_Detail, 0 AS ID_Detail_Process, 'H' AS TBL "
				cSQL = cSQL + ",'' AS [Description],M.Specs, 1 AS [cancelled] "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.[AR.Stocklst_Master_History] M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.[AR.Stocklst_Detail_History] D WITH(NOLOCK) ON M.ID=D.ID "
				cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		
				cSQL = cSQL + " UNION "
				*Detail Process
				cSQL = cSQL + "SELECT M.Alloy,M.Heat, P.Prc_PCs AS Pieces, P.Comment AS Comments, P.Pounds "
				cSQL = cSQL + ", ISNULL(P.QTY,0) AS Acct_QTY  "
				cSQL = cSQL + ",M.ID, D.ID_Detail, P.ID_Detail_Process, 'S' AS TBL "
				cSQL = cSQL + ",D.Descript AS [Description],M.Specs, 0 AS [cancelled] "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
			ENDIF
		
			IF cTBL = "B" OR LEN(cTBL) = 0
				cSQL = cSQL + " UNION "
				*Master 
				cSQL = cSQL + "SELECT M.Alloy, M.Heat, D.PC AS Pieces, '' AS Comments, 0 AS Pounds"
				cSQL = cSQL + ", ISNULL(M.mS_QTY,0) AS Acct_QTY "
				cSQL = cSQL + ",M.ID, 0 AS ID_Detail, 0 AS ID_Detail_Process, 'B' AS TBL "
				cSQL = cSQL + ",'' AS [Description],M.Specs, 1 AS [cancelled] "
				*cSQL = cSQL + ",dbo.f_Get_nPU_Form(M.Form) AS Acct_PU "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
				
				cSQL = cSQL + " UNION "
				*Detail Process
				cSQL = cSQL + "SELECT M.Alloy,M.Heat, P.Prc_PCs AS Pieces, P.Comment AS Comments, P.Pounds"
				cSQL = cSQL + ", ISNULL(P.QTY,0) AS Acct_QTY "
				cSQL = cSQL + ",M.ID, D.ID_Detail, P.ID_Detail_Process, 'B' AS TBL "
				cSQL = cSQL + ",D.Descript AS [Description],M.Specs, 0 AS [cancelled] "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
				
			ENDIF
		
			IF cTBL = "W" OR LEN(cTBL) = 0
				cSQL = cSQL + " UNION "
				*Master
				cSQL = cSQL + "SELECT M.Alloy, M.Heat, D.PC AS Pieces, '' AS Comments, 0 AS Pounds "
				cSQL = cSQL + ", ISNULL(M.mS_QTY,0) AS Acct_QTY "
				cSQL = cSQL + ",M.ID, 0 AS ID_Detail, 0 AS ID_Detail_Process, 'W' AS TBL "
				cSQL = cSQL + ",'' AS [Description],M.Specs, 1 AS [cancelled] "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
				
				cSQL = cSQL + " UNION "
				*Detail Process
				cSQL = cSQL + "SELECT M.Alloy,M.Heat, P.Prc_PCs AS Pieces, P.Comment AS Comments, P.Pounds"
				cSQL = cSQL + ", ISNULL(P.QTY,0) AS Acct_QTY  "
				cSQL = cSQL + ",M.ID, D.ID_Detail, P.ID_Detail_Process, 'W' AS TBL "
				cSQL = cSQL + ",D.Descript AS [Description],M.Specs, 0 AS [cancelled] "
				cSQL = cSQL + ",ISNULL(D.S_PU,dbo.f_Get_nPU_Form(M.Form)) AS Acct_PU "
				cSQL = cSQL + ",M.PO_Item AS POitem, M.WO_Detail "
				cSQL = cSQL + ",D.ReceivingID AS RID "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
				
			ENDIF
		ENDIF
		
		cSQL = cSQL + " ) t "
		
		SELECT 0  
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOitem")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN TO MASTER
		ELSE
			ThisForm.lClosetmpReceivingPOitem = .T.
		ENDIF
		
		
		*SELECT * FROM PurchaseOrders WHERE HpaPo = pnHpaPo INTO CURSOR tmpPOitems
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
			ThisForm.Caption = ThisForm.Caption+" for PO# "+ALLTRIM(cPOitem)
		ELSE
			IF nWO_Detail > 0
				ThisForm.Caption = ThisForm.Caption+" for WO Detail# "+ALLTRIM(STR(nWO_Detail))
			ELSE
			
			ENDIF
		ENDIF
		
		***********
		*Remove History if Heat is still in Stock!
		PRIVATE cHistHeat
		cHistHeat = '*'
		
		IF RECCOUNT('tmpReceivingPOitem') > 0
		
			DO WHILE .T.
				***
				*remove unwanted data
				
				SELECT tmpReceivingPOitem
				LOCATE FOR Heat != cHistHeat AND TBL = "H" AND NOT DELETED()
				IF FOUND('tmpReceivingPOitem')
					cHistHeat = PrepareSQLtxt(tmpReceivingPOitem.Heat,'Heat',50,.T.)	&&PAD 50
					
					LOCATE FOR Heat = cHistHeat AND NOT TBL = "H" AND NOT DELETED()
					IF FOUND('tmpReceivingPOitem')
					
						DELETE FOR Heat = cHistHeat AND TBL = "H"
						*PACK
						
					ENDIF
				ENDIF
				
				***
				SELECT tmpReceivingPOitem
				LOCATE FOR Heat != cHistHeat AND TBL = "H" AND NOT DELETED()
				IF NOT FOUND('tmpReceivingPOitem')
					EXIT
				ENDIF		
				***
				
			ENDDO
			*USE IN tmpReceivingPOitem
		
			***********
		*	IF NOT "\MEM" $ SYS(2003)
		*		SET DEFAULT TO ( SYS(5)+SYS(2003)+"\MEM\" )
		*		*SET DEFAULT TO (LoginAppHome+"MEM\") 
		*		TrackMess("SET DEFAULT TO ( "+SYS(5)+SYS(2003)+"\MEM\ ))" )
		*		MESSAGEBOX("SET DEFAULT TO "+CHR(13)+"( "+SYS(5)+SYS(2003)+"\MEM\ ))",0+64,"Testing")
		*	ELSE
		*		MESSAGEBOX("did not change DEFAULT \MEM\",0+64,"Testing")
		*	ENDIF
			
			SELECT 0
			CREATE CURSOR 'RcvPOi' ([Line] I, Heat C(50), POitem C(12), WO_Detail I, Pieces I, ID_Detail I, ID_D_P I, TBL C(1), Cancelld L, Pounds N(9,1);
			, Acct_QTY N(18,4), Acct_PU N(18,4), Description C(150), Specs C(150), Comments C(150), RID I )
				
			* Heat,ID_Detail,TBL ,[cancelled] 
			
			***********
			
			IF USED('RcvPOi')
				SELECT RcvPOi
				INSERT INTO RcvPOi ([Line], Heat,POitem,WO_Detail,Pieces,ID_Detail,ID_D_P,TBL,Cancelld, Pounds, Acct_QTY, Acct_PU;
						,Description, Specs, Comments, RID ) ;
					SELECT RECNO() AS [Line], Heat,POitem,WO_Detail,Pieces,ID_Detail,ID_Detail_Process,TBL,Cancelled, Pounds, Acct_QTY, Acct_PU ;
						,Description, Specs, Comments, RID ;
					FROM tmpReceivingPOitem WHERE NOT DELETED()
					
		*", Pounds, Acct_QTY, Acct_PU "
				USE IN tmpReceivingPOitem
			
			
				ThisForm.grid.RecordSource = "RcvPOi"
				*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
				
				********************************************************************************
				*ThisForm.grid.SetFocus
				PRIVATE nRecCount
				nRecCount = RECCOUNT("RcvPOi")
				IF nRecCount = 0
					IF nWO_Detail = 0
						MESSAGEBOX("PO Item is not found in the Receiving Table. "+cPOitem+CHR(13)+"This is a new Receive.",32,"No records to Show!")
					ELSE
						MESSAGEBOX("WO Detail number is not found in the Receiving Table. "+ALLTRIM(STR(nWO_Detail ))+CHR(13)+"This is a new Receive.",32,"No records to Show!")
					ENDIF
					ThisForm.cmdQuit.Click
					ThisForm.Release
					RETURN TO MASTER
				ENDIF
				IF nRecCount = 1
					ThisForm.cmdSelect.Click()
				ENDIF
				
				LOCATE FOR UPPER(Heat) = "DUE IN" AND (TBL='S' OR TBL='B' OR TBL='W')
				IF FOUND()
					*ThisForm.Refresh_RCV()
				ELSE
					
					IF LEN(pcHeat) > 0
						LOCATE FOR UPPER(Heat) = UPPER(ALLTRIM(pcHeat))
						IF FOUND()
							ThisForm.lblParaHeat.Caption = " Heat: "+pcHeat
							*ThisForm.Caption = ThisForm.Caption+" Heat: "+pcHeat
						ELSE
							WAIT WINDOW "Heat not Found!"
							GO BOTTOM
						ENDIF
					ELSE
						IF nRecCount > 7
							GO BOTTOM
							SKIP -6
						ELSE
							GO BOTTOM
						ENDIF
					ENDIF
				ENDIF
				
				*Heat,ID_Detail,TBL ,[Cancelld ] 
				ThisForm.Refresh_RCV()
			ELSE
				TrackError("Could not create temp file RcvPOi.","Could not create temp file RcvPOi.", PROGRAM(), LINENO(1))
				MESSAGEBOX("Could not create the temp file."+CHR(13)+"Cannot continue...",0+16,"ERROR")
				ThisForm.cmdQuit.Click
				ThisForm.Release
				RETURN TO MASTER
			ENDIF
		ELSE
		*	MESSAGEBOX("PO Item number is not found in the Receiving Table."+CHR(13)+"This is a new Receive.",32,"No records to Show!")
			ThisForm.cmdQuit.Click
			ThisForm.Release
			RETURN TO MASTER
		ENDIF
		
		************
		ThisForm.Visible = .T.
		SELECT RcvPOi
		GO TOP
		ThisForm.grid.Refresh
		
		ThisForm.nRecTotal = RECCOUNT("RcvPOi")
		
		IF lHavePOitem
			LOCATE FOR POitem = cPOitem
			IF NOT FOUND('RcvPOi')
				GO TOP
			ENDIF
		ENDIF
		IF lHaveWO_Detail
			LOCATE FOR WO_Detail = nWO_Detail
			IF NOT FOUND('RcvPOi')		
				GO TOP
			ENDIF
		ENDIF
		
		ThisForm.RefreshLineNumber()
		
		ThisForm.Grid.SetFocus()
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE refreshlinenumber
		*ThisForm.RefreshLineNumber()
		
		ThisForm.lblRecord.Caption = "Line "+ALLTRIM(STR(RcvPOi.Line))+" of "+ALLTRIM(STR(ThisForm.nRecTotal))
		
	ENDPROC

	PROCEDURE refresh_rcv
		*ThisForm.Refresh_RCV()
		
		IF USED('RcvPOi')
			SELECT RcvPOi
				
			ThisForm.lblCancelled.Visible 	= PrepareSQLlogic(RcvPOi.Cancelld ,'Cancelled')
			ThisForm.txtPOitem.Value 	= PrepareSQLtxt(RcvPOi.POitem,'POitem',12)
			
			DO CASE
			CASE RcvPOi.TBL = "R"
				ThisForm.txtTable.Value 		= "Table: Receving ID"
			CASE RcvPOi.TBL = "S"
				ThisForm.txtTable.Value 		= "Table: Stock"
			CASE RcvPOi.TBL = "B"
				ThisForm.txtTable.Value 		= "Table: Broker"
			CASE RcvPOi.TBL = "W"
				ThisForm.txtTable.Value 		= "Work in Progress"
			CASE RcvPOi.TBL = "H"
				ThisForm.txtTable.Value 		= "Deleted History Table"
			OTHERWISE
				ThisForm.txtTable.Value 		= ""
			ENDCASE
			ThisForm.txtTBL.Value		= PrepareSQLtxt(RcvPOi.TBL,'TBL',1)
			ThisForm.txtWO_Detail.Value = PrepareSQLnum(RcvPOi.WO_Detail,'WO_Detail',-3)
			ThisForm.txtID_D_P.Value 	= PrepareSQLnum(RcvPOi.ID_D_P,'ID_D_P',-3)
			ThisForm.txtHeat.Value 		= PrepareSQLtxt(RcvPOi.Heat,'Heat',50)
		
			ThisForm.txtS_QTY.Value 	= PrepareSQLnum(RcvPOi.Acct_QTY,'S_QTY',-5)
			ThisForm.txtS_PU.Value 		= PrepareSQLnum(RcvPOi.Acct_PU,'S_PU',-1)
			
				
			ThisForm.txtPieces.Value	= PrepareSQLnum(RcvPOi.Pieces,'Pieces',-3)
			ThisForm.txtRID.Value		= PrepareSQLnum(RcvPOi.RID,'RID',-3)
			ThisForm.txtPounds.Value	= PrepareSQLnum(RcvPOi.Pounds,'Pounds',9,1)
			
			ThisForm.txtDescript.Value	= PrepareSQLtxt(RcvPOi.Description,'Description',150)
			ThisForm.txtSpecs.Value 	= PrepareSQLtxt(RcvPOi.Specs,'Specs',150)
			ThisForm.txtComments.Value	= PrepareSQLtxt(RcvPOi.Comments,'Comments',150)
			
			DO CASE
			CASE RcvPOi.Heat = "DUE IN"
				ThisForm.lblIncoming.Visible = .T.
				ThisForm.cmdIncoming.Visible = .T.
				ThisForm.cmdSelect.Visible = .F.
			CASE RcvPOi.TBL = "R"
				ThisForm.lblIncoming.Visible = .F.
				ThisForm.cmdIncoming.Visible = .F.
				ThisForm.cmdSelect.Visible = .T.
			CASE RcvPOi.ID_D_P > 0
				ThisForm.lblIncoming.Visible = .T.
				ThisForm.cmdIncoming.Visible = .T.
				ThisForm.cmdSelect.Visible = .F.
			OTHERWISE
				ThisForm.lblIncoming.Visible = .F.
				ThisForm.cmdIncoming.Visible = .F.
				ThisForm.cmdSelect.Visible = .F.
			ENDCASE
		
		ENDIF
	ENDPROC

	PROCEDURE Unload
		*IF ThisForm.lClosetmpReceivingPOitem
			IF USED("RcvPOi")
				USE IN RcvPOi
			ENDIF
		*ENDIF
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		RETURN ThisForm.nHoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE nHoldNumber
		nHoldNumber = 0
		
		IF NOT USED('RcvPOi')
			MESSAGEBOX("Table RcvPOi NOT opened.",0,"Data Table error")
			RETURN .F.
		ENDIF
		
		nHoldNumber = RcvPOi.ID
		
		PRIVATE lCancelled
		lCancelled = PrepareSQLlogic(RcvPOi.Cancelld ,"Cancelled")
		IF lCancelled 
			IF MESSAGEBOX("Are you Sure you want to UNCancel this Receive?",4+32,"UNCancel") != 6
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you Sure you want to Cancel this Receive?",4+32,"Cancel") != 6
				RETURN .F.
			ENDIF
		ENDIF
		
		IF nHoldNumber > 0
			cSQL = "UPDATE dbo.Receiving "
			cSQL = cSQL + " SET [cancelled] = "+IIF(lCancelled,"0","1")
			cSQL = cSQL + " WHERE ID = "+STR(nHoldNumber)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				MESSAGEBOX("Could not Cancel",0,"Cannot Cancel")
			ELSE
				SELECT RcvPOi
				IF lCancelled 
					REPLACE Cancelld  WITH .F. &&WHERE ID = nHoldNumber
					ThisForm.lblCancelled.Visible = .T.
				ELSE
					REPLACE Cancelld  WITH .T. &&WHERE ID = nHoldNumber
					ThisForm.lblCancelled.Visible = .F.		
				ENDIF
			ENDIF
		ELSE 
			MESSAGEBOX("No ID",0,"Cannot Cancel")
		ENDIF
	ENDPROC

	PROCEDURE cmdIncoming.Click
		PRIVATE nHoldNumber
		nHoldNumber = 0
		
		*ThisForm.nHoldNumber = nHoldNumber 
		IF USED('RcvPOi')
			SELECT RcvPOi
			PRIVATE lCancelled
			lCancelled = PrepareSQLlogic(RcvPOi.Cancelld ,"Cancelled")
			IF lCancelled 
				MESSAGEBOX("You have selected a Cancelled Receive."+CHR(13)+"Not allowed to select.",4+32,"Cancelled") 
				RETURN .f.
			ENDIF
		
			IF RcvPOi.TBL = "R"
				*Send back ReceivingID to EDIT
				ThisForm.nHoldNumber = RcvPOi.ID_D_P
			ELSE
				*Send back NEGATIVE ID_Detail of Incoming record.
				PRIVATE nID_Detail
				nID_Detail = PrepareSQLnum(RcvPOi.ID_D_P,'ID_Detail',-3)
				IF nID_Detail = 0
					*Send back -1 to say no StockLst ID_Detail or ReceiveID is being sent!
					nID_Detail = 1
				ENDIF
				
				ThisForm.nHoldNumber = -(nID_Detail)
			ENDIF
		ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdQuit.Click
		*Create a New Receive
		IF USED('RcvPOi')
			SELECT RcvPOi
		
			LOCATE FOR UPPER(Heat) = "DUE IN" AND NOT Cancelld 
			IF FOUND('RcvPOi')
				PRIVATE nMess
				nMess = 0
				nMess = MESSAGEBOX("A 'Due In' exists."+CHR(13)+"Please Choose to receive to that record."+CHR(13)+CHR(13)+"To continue with just a NEW receive"+CHR(13)+"Type the (N) key.",4+32,"Abort New Receive")
				IF nMess <> 7
					ThisForm.Refresh_RCV()
					
					RETURN .F.
					
				ENDIF
			ENDIF			
		ENDIF
					
		ThisForm.nHoldNumber = 0
		
		ThisForm.Visible = .F.
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE nHoldNumber
		nHoldNumber = 0
		
		*ThisForm.nHoldNumber = nHoldNumber 
		IF USED('RcvPOi')
			SELECT RcvPOi
				
			PRIVATE lCancelled
			lCancelled = PrepareSQLlogic(RcvPOi.Cancelld ,"Cancelled")
			IF lCancelled 
				MESSAGEBOX("You have selected a Cancelled Receive."+CHR(13)+"Are you not allowed to Select?",4+32,"Cancelled") 
				RETURN .f.
			ENDIF
		
			IF RcvPOi.TBL = "R"
				*Send back ReceivingID to EDIT
				ThisForm.nHoldNumber = RcvPOi.RID
			ELSE
				*Send back NEGATIVE ID_Detail of Incoming record.
				PRIVATE nID_Detail
				nID_Detail = PrepareSQLnum(RcvPOi.ID_D_P,'ID_Detail',-3)
				IF nID_Detail = 0
					*Send back -1 to say no StockLst ID_Detail or ReceiveID is being sent!
					nID_Detail = 1
				ENDIF
				
				ThisForm.nHoldNumber = -(nID_Detail)
			ENDIF
		ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE Grid.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Refresh_RCV()
		ThisForm.RefreshLineNumber()
		
	ENDPROC

ENDDEFINE
