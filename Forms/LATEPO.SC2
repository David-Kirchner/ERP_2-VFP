	PROCEDURE latepo_changed
			*thisForm.LatePO_Changed()
		
			PRIVATE cPOItem
			cPOItem = LatePO.PoItem
		
			THISFORM.grdStockHistory.RECORDSOURCE = ''
			IF USED('StockHistory')
				USE IN StockHistory
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT LEFT([Who],20) AS [Who],[What],[When],'Stock ' AS STK FROM dbo.Ar_Stocklst_Master_History WHERE po_item = '"+cPOItem+"'"
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT LEFT([Who],20) AS [Who],[What],[When],'Broker' AS STK FROM dbo.Ar_BrokerLst_Master_history WHERE po_item = '"+cPOItem+"'"
		
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'StockHistory')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'StockHistory' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'StockHistory' )
			ENDIF
		
			IF USED('StockHistory')
				THISFORM.grdStockHistory.RECORDSOURCE = 'StockHistory'
				THISFORM.grdStockHistory.VISIBLE = .T.
		
			ELSE
				THISFORM.grdStockHistory.VISIBLE = .F.
			ENDIF
		
			****************************************
			PRIVATE nSalesNum, cSOitem
			nSalesNum = VAL(LatePO.Soitem)
			cSOitem	= LatePO.Soitem
		
			THISFORM.lblSales.VISIBLE = .F.
			THISFORM.lblQtyShip.VISIBLE = .F.
			THISFORM.txtSoldTo.VISIBLE = .F.
			THISFORM.txtqShipped.VISIBLE = .F.
			THISFORM.ChkSalesCncld.VISIBLE = .F.
			THISFORM.chkSalesCmplt.VISIBLE = .F.
			THISFORM.txtHeat.VISIBLE = .F.
			THISFORM.txtPartNo.VISIBLE = .F.
		
			THISFORM.lblSales_No.VISIBLE = .F.
			THISFORM.chkSales_NoCncld.VISIBLE = .F.
			THISFORM.chkSales_NoCmplt.VISIBLE = .F.
			THISFORM.chkSales_NoShopRecv.VISIBLE = .F.
		
			IF cSOitem = "STOCK"
				RETURN
			ENDIF
		
			IF USED('tmpSales')
				USE IN tmpSales
			ENDIF
			SELECT 0
		
			cSQL = "SELECT qShipped,cncld,cmplt,Heat,Partno FROM dbo.Sales WHERE SOitem ='"+cSOitem+"'"
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'tmpSales')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'tmpSales' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'tmpSales' )
			ENDIF
		
			IF USED('tmpSales')
				IF RECCOUNT('tmpSales') > 0
					THISFORM.lblSales.VISIBLE = .T.
					THISFORM.txtSoldTo.VISIBLE = .T.
					THISFORM.lblQtyShip.VISIBLE = .T.
					THISFORM.txtqShipped.VISIBLE = .T.
					THISFORM.ChkSalesCncld.VISIBLE = .T.
					THISFORM.chkSalesCmplt.VISIBLE = .T.
					THISFORM.txtHeat.VISIBLE = .T.
					THISFORM.txtPartNo.VISIBLE = .T.
		
					THISFORM.txtSoldTo.VALUE	= LatePO.Sold_To
					THISFORM.txtqShipped.VALUE	= tmpSales.qShipped
					THISFORM.ChkSalesCncld.VALUE= tmpSales.cncld
					THISFORM.chkSalesCmplt.VALUE= tmpSales.cmplt
					THISFORM.txtHeat.VALUE		= tmpSales.Heat
					THISFORM.txtPartNo.VALUE	= tmpSales.PartNo
		
					USE IN tmpSales
				ENDIF
			ENDIF
			************************************************
		
			IF USED('tmpSales_No')
				USE IN tmpSales_no
			ENDIF
			SELECT 0
		
			cSQL = "SELECT cncld,cmplt,ShopRecv FROM dbo.Sales_No WHERE Salesnum ="+STR(nSalesNum)
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'tmpSales_No')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'tmpSales_No' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'tmpSales_No' )
			ENDIF
		
			IF USED('tmpSales_No')
				IF RECCOUNT('tmpSales_No') > 0
					THISFORM.lblSales_No.VISIBLE = .T.
					THISFORM.chkSales_NoCncld.VISIBLE = .T.
					THISFORM.chkSales_NoCmplt.VISIBLE = .T.
					THISFORM.chkSales_NoShopRecv.VISIBLE = .T.
		
					THISFORM.chkSales_NoCncld.VALUE = tmpSales_no.cncld
					THISFORM.chkSales_NoCmplt.VALUE = tmpSales_no.cmplt
					THISFORM.chkSales_NoShopRecv.VALUE = tmpSales_no.ShopRecv
		
					USE IN tmpSales_no
				ENDIF
			ENDIF
		
	ENDPROC

	PROCEDURE Load
		
			IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
				SET PROCEDURE TO Progs\PROC_SQL ADDITIVE
			ENDIF
			IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
				SET PROCEDURE TO Progs\PROC_SETUP ADDITIVE
			ENDIF
		
			THISFORM.nconnhandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE refresh_latepo
			*ThisForm.Refresh_LatePO()
			THISFORM.grdLatePO.RECORDSOURCE = ''
		
			PRIVATE nRecNo
			nRecNo = 0
			IF USED('LatePO')
				nRecNo = RECNO('LatePO')
				USE IN LatePO
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT P.POitem "
			cSQL = cSQL + ",P.SalesP,P.Company AS [Buy From]"
			cSQL = cSQL + ",P.Alloy"
			cSQL = cSQL + ",dbo.ItemDescription(P.Form,P.thck,P.Sz2,P.Sz3,P.RandLen) AS Description"
			cSQL = cSQL + ",CASE LEFT(P.SOitem,8) 	WHEN '      0-' THEN 'STOCK' 	ELSE P.SOitem END AS SOitem"
			cSQL = cSQL + ",AQ.Company AS [Sold To]"
			cSQL = cSQL + ",CONVERT(CHAR(10),P.OrderDate,1) AS OrderDate"
			cSQL = cSQL + ",CONVERT(CHAR(10),P.Due_Min,1) AS Due_Min"
			cSQL = cSQL + ",CONVERT(CHAR(10),P.Due_Max,1) AS Due_Max"
			cSQL = cSQL + ",ISNULL(CASE P.Received"
			cSQL = cSQL + "	WHEN '1900-01-01 00:00:00.000' THEN ''"
			cSQL = cSQL + "	WHEN '1899-12-30 00:00:00.000' THEN ''"
			cSQL = cSQL + "	ELSE CONVERT(CHAR(10),P.Received,1) "
			cSQL = cSQL + " END,'') AS Received"
			cSQL = cSQL + ",dbo.[ShipWhereDescription](P.ShipWhere) AS ShipWhere"
			cSQL = cSQL + ",ISNULL(CONVERT(CHAR(10),P.HPA_Due_Min,1),'') AS HPA_Due_Min"
			cSQL = cSQL + ",(CASE WHEN P.HPA_Due_Max <= GETDATE() THEN '*'"
			cSQL = cSQL + "	ELSE ' ' END ) AS L"
			cSQL = cSQL + ",ISNULL(CONVERT(CHAR(10),P.HPA_Due_Max,1),'') AS HPA_Due_Max"
			cSQL = cSQL + " FROM dbo.PurchaseOrder P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ ON P.SOitem = AQ.SOitem "
			cSQL = cSQL + " WHERE ISNULL(P.Delivered,0) = 0"
			cSQL = cSQL + " AND ISNULL(P.Cancelled,0) = 0"
			cSQL = cSQL + " AND ISNULL(P.Services,0) = 0"
			cSQL = cSQL + " AND LEFT(P.SOitem,8) != '      0-'"
			cSQL = cSQL + " AND P.HPA_Due_Min < GetDate()"
		
		
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'LatePO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'LatePO' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'LatePO' )
			ENDIF
		
			IF USED('LatePO')
				THISFORM.grdLatePO.RECORDSOURCE = 'LatePO'
				THISFORM.grdLatePO.VISIBLE = .T.
		
				IF nRecNo > 0
					IF nRecNo < RECCOUNT('LatePO')
						GOTO (nRecNo)
					ELSE
						GO BOTTOM
					ENDIF
				ENDIF
		
				THISFORM.grdLatePO.SETFOCUS()
		
				THISFORM.LatePO_Changed()
		
			ELSE
				THISFORM.grdLatePO.VISIBLE = .F.
			ENDIF
	ENDPROC

	PROCEDURE Unload
		
			IF USED('LatePO')
				USE IN LatePO
			ENDIF
		
			= SQLDISCONNECT(THISFORM.nconnhandle)
	ENDPROC

	PROCEDURE cmdCancelled.Click
		
			PRIVATE cPOItem
			cPOItem = LatePO.PoItem
		
			PRIVATE cSQL, nSQLEXEC
		
			*Check for uncancelled POitem
			IF USED('tmpPOcancel')
				USE IN tmpPOcancel
			ENDIF
			SELECT 0
		
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem ='"+cPOItem+"' AND Cancelled = 0"
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'tmpPOcancel')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'tmpPOcancel' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'tmpPOcancel' )
			ENDIF
		
			IF USED('tmpPOcancel')
				IF RECCOUNT('tmpPOcancel') > 0
					IF tmpPOcancel.Cntd = 0
						USE IN tmpPOcancel
						RETURN
					ENDIF
				ENDIF
				USE IN tmpPOcancel
			ENDIF
		
			*********************************************************
			*make a history mark about cancelling poitem
			***********************
			*Test for BrokerLst
			IF USED('tmpCntBroker')
				USE IN tmpCntBroker
			ENDIF
			SELECT 0
		
			cSQL = "SELECT DISTINCT ID_Detail FROM ("
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.Ar_BrokerLst_Master_history M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.Ar_BrokerLst_Detail_History D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+" UNION"
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.BrokerLst_Master M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.BrokerLst_Detail D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+"  ) X"
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'tmpCntBroker')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'tmpCntBroker' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'tmpCntBroker' )
			ENDIF
		
			IF USED('tmpCntBroker')
				IF RECCOUNT('tmpCntBroker') > 0
					IF VARTYPE(tmpCntBroker.ID_Detail) ="N"
		
						SCAN
							*Add Reason to BrokerLst Process
							cSQL = "INSERT INTO dbo.BrokerLst_Process "
							cSQL = cSQL+"( [po_item],[SalesPerson],[comment],[process_id],[processor],[ID_Detail] )	"
							cSQL = cSQL+" VALUES("
							cSQL = cSQL+"'"+cPOItem+"'"
							cSQL = cSQL+",' '"
							cSQL = cSQL+",'Cancelled PO using Late PO screen'"
							cSQL = cSQL+",'CANCELLED'"
							cSQL = cSQL+", SUBSTRING(suser_sname(),CHARINDEX('\',suser_sname() )+1 ,20 )"
							cSQL = cSQL+","+STR(tmpCntBroker.ID_Detail)
		
							nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC )
							ELSE
								*Remove Process
								cSQL = "DELETE FROM dbo.BrokerLst_Process "
								cSQL = cSQL+" WHERE ID_Detail="+STR(tmpCntBroker.ID_Detail)
		
								nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC )
								ENDIF
		
							ENDIF
						ENDSCAN
		
					ENDIF
				ENDIF
				USE IN tmpCntBroker
			ENDIF
		
			***********************
			*Test for StockLst
			IF USED('tmpCntStock')
				USE IN tmpCntStock
			ENDIF
			SELECT 0
		
			cSQL = "SELECT DISTINCT ID_Detail FROM ("
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.Ar_Stocklst_Master_History M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.Ar_Stocklst_Detail_History D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+" UNION"
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.StockLst_Master M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.StockLst_Detail D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+"  ) X"
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'tmpCntStock')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'tmpCntStock' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'tmpCntStock' )
			ENDIF
		
			IF USED('tmpCntStock')
				IF RECCOUNT('tmpCntStock') > 0
					IF VARTYPE(tmpCntStock.ID_Detail) ="N"
		
						SCAN
							*Add Reason to StockLst Process
							cSQL = "INSERT INTO dbo.StockLst_Process "
							cSQL = cSQL+"( [po_item],[SalesPerson],[comment],[process_id],[processor],QTY,[ID_Detail] )	"
							cSQL = cSQL+" VALUES("
							cSQL = cSQL+"'"+cPOItem+"'"
							cSQL = cSQL+",' '"
							cSQL = cSQL+",'Cancelled PO using Late PO screen'"
							cSQL = cSQL+",'CANCELLED'"
							cSQL = cSQL+", SUBSTRING(suser_sname(),CHARINDEX('\',suser_sname() )+1 ,20 )"
							cSQL = cSQL+",0" &&QTY
							cSQL = cSQL+","+STR(tmpCntStock.ID_Detail)
		
							nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC )
							ELSE
								*Remove Process
								*nID_Detail_Process = tmpCntStock.ID_Detail
								*Remove_ID_Detail_Process(nID_Detail_Process,cSOitem,cTbl,ThisForm.nConnHandle,"CANCELLED")
		
								cSQL = "DELETE FROM dbo.StockLst_Process "
								cSQL = cSQL+" WHERE ID_Detail="+STR(tmpCntStock.ID_Detail)
		
								nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL )
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC )
								ENDIF
		
							ENDIF
						ENDSCAN
		
					ENDIF
				ENDIF
				USE IN tmpCntStock
			ENDIF
		
			***********************
		
			cSQL = "UPDATE dbo.PurchaseOrder SET Cancelled = 1 WHERE POitem ='"+cPOItem+"'"
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC )
			ELSE
				TrackMess(cSQL)
			ENDIF
		
			THISFORM.refresh_latepo()
	ENDPROC

	PROCEDURE cmdComplete.Click
		
			PRIVATE cPOItem
			cPOItem = LatePO.PoItem
		
			PRIVATE cSQL, nSQLEXEC
		
		
			************************************
			*Add mark to history file
			PRIVATE cSQLi
		
		
			*Test for BrokerLst
			IF USED('tmpCntBroker')
				USE IN tmpCntBroker
			ENDIF
			SELECT 0
		
			cSQL = "SELECT DISTINCT ID_Detail FROM ("
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.Ar_BrokerLst_Master_history M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.Ar_BrokerLst_Detail_History D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+" UNION"
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.BrokerLst_Master M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.BrokerLst_Detail D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+"  ) X"
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'tmpCntBroker')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'tmpCntBroker' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'tmpCntBroker' )
			ENDIF
		
			IF USED('tmpCntBroker')
				IF RECCOUNT('tmpCntBroker') > 0
					IF VARTYPE(tmpCntBroker.ID_Detail) ="N"
						SCAN
							*Add Reason to BrokerLst Process
							cSQLi = "INSERT INTO dbo.Ar_BrokerLst_Process_History (What,SOitem,PO_Item,SalesPerson"
							cSQLi = cSQLi + ",Comment,process_id,processor,ID_Detail,Validated,ReceivingID) VALUES ("
							cSQLi = cSQLi + "'RECEIVED'"
							cSQLi = cSQLi + ",''" &&SOitem
							cSQLi = cSQLi + ",'"+cPOItem+"'"
							cSQLi = cSQLi + ",' '"  &&SalesP
							cSQLi = cSQLi + ",'No Receiving. Marked Complete with Late PO screen.'"  &&Comment
							cSQLi = cSQLi + ",'CORRECTION'"   &&Process_ID
							cSQLi = cSQLi + ",'Late PO:PO Complete'"   &&Processor
							cSQLi = cSQLi + ","+ALLTRIM(STR(tmpCntBroker.ID_Detail))+"" &&ID_Detail
							cSQLi = cSQLi + ",'F'"  &&Validated
							cSQLi = cSQLi + ",0"  &&ReceivingID
							cSQLi = cSQLi + ")"
		
							nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQLi )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi, THISFORM.nconnhandle, nSQLEXEC )
							ENDIF
						ENDSCAN
					ENDIF
				ENDIF
				USE IN tmpCntBroker
			ENDIF
		
			***********************
			*Test for StockLst
			IF USED('tmpCntStock')
				USE IN tmpCntStock
			ENDIF
			SELECT 0
		
			cSQL = "SELECT DISTINCT ID_Detail FROM ("
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.Ar_Stocklst_Master_History M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.Ar_Stocklst_Detail_History D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+" UNION"
			cSQL = cSQL+" SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.StockLst_Master M"
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.StockLst_Detail D ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOItem+"'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
			cSQL = cSQL+"  ) X"
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL, 'tmpCntStock')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL, 'tmpCntStock' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC, 'tmpCntStock' )
			ENDIF
		
			IF USED('tmpCntStock')
				IF RECCOUNT('tmpCntStock') > 0
					IF VARTYPE(tmpCntStock.ID_Detail) ="N"
						SCAN
							*Add Reason to StockLst Process
							cSQLi = "INSERT INTO dbo.Ar_StockLst_Process_History (What,SOitem,PO_Item,SalesPerson"
							cSQLi = cSQLi + ",Comment,Process_ID,Processor,QTY"
							cSQLi = cSQLi + ",ID_Detail,Validated,ReceivingID) VALUES ("
							cSQLi = cSQLi + "'RECEIVED'"
							cSQLi = cSQLi + ",''" &&SOitem
							cSQLi = cSQLi + ",'"+cPOItem+"'"
							cSQLi = cSQLi + ",' '"  &&SalesP
							cSQLi = cSQLi + ",'No Receiving. Marked Complete with Late PO screen.'"  &&Comment
							cSQLi = cSQLi + ",'CORRECTION'"   &&Process_ID
							cSQLi = cSQLi + ",'Late PO:PO Complete'"   &&Processor
							cSQLi = cSQLi + ",0" &&QTY
							cSQLi = cSQLi + ","+ALLTRIM(STR(tmpCntStock.ID_Detail))+"" &&ID_Detail
							cSQLi = cSQLi + ",'F'"  &&Validated
							cSQLi = cSQLi + ",0"  &&ReceivingID
							cSQLi = cSQLi + ")"
		
		
							nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQLi )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLi, THISFORM.nconnhandle, nSQLEXEC )
							ENDIF
						ENDSCAN
		
					ENDIF
				ENDIF
				USE IN tmpCntStock
			ENDIF
		
		
			************************************
			cSQL = "UPDATE PurchaseOrder SET Delivered = 1 WHERE POitem ='"+cPOItem+"'"
		
			nSQLEXEC = SQLEXEC(THISFORM.nconnhandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nconnhandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nconnhandle, nSQLEXEC )
			ELSE
				TrackMess(cSQL)
			ENDIF
		
			THISFORM.refresh_latepo()
	ENDPROC

	PROCEDURE cmdQuit.Click
			THISFORM.RELEASE
		
	ENDPROC

	PROCEDURE cmdSendEmail.Click
			IF MESSAGEBOX("Do you want to send email from Outlook?",4+64,"Email")=6
		
				TRY
					PRIVATE cPOItem,cSalesp,cCompany,cALLOY,cDesc,cSoldTo,cOrderDate,cDue_Min,cDue_Max,cReceived,cShipWhere
					cPOItem		= LatePO.PoItem
					cSalesp		= AppSetup_Get_SalesRep_SalesP(LatePO.SalesP)
					cCompany	= LatePO.Buy_From
					cALLOY		= LatePO.Alloy
					cDesc		= LatePO.DESCRIPTION
					cSoldTo		= LatePO.Sold_To
					cOrderDate	= LatePO.OrderDate
					cDue_Min	= LatePO.Due_Min
					cDue_Max	= LatePO.Due_Max
					cReceived	= LatePO.Received
					cShipWhere	= LatePO.ShipWhere
		
					#DEFINE olFolderInbox 6
					#DEFINE olFolderOutbox 4
					#DEFINE olMailItem 0
					#DEFINE olRecipient 4
					#DEFINE olRecipients 17
					#DEFINE IMPORTANCENORMAL 1
					loApp=CREATEOBJECT("Outlook.Application")
					loNamespace = loApp.GetNamespace("MAPI")
					loFolder = loNamespace.GetDefaultFolder(olFolderInbox)
					loEMailItem = loFolder.Items.ADD(olMailItem)
					loEMailItem.Subject = "Purchase Order"+cPOItem
					loEMailItem.Importance = IMPORTANCENORMAL
		
					PRIVATE B
					B = [<html><font face = "Arial">]
					B=B+[<font size = 2> <font color = 0>Space Alloys USA PO item:]+ALLTRIM(cPOItem)+[</font><Br>]
					B=B+[Sales Person:]+cSalesp+[<Br>]
					B=B+[Company:]+cCompany+[<Br>]
					B=B+[Alloy:]+cALLOY+[ ]+cDesc+[<Br>]
					B=B+[Order Date:]+cOrderDate+[  DueMin:]+cDue_Min+[  DueMax:]+cDue_Max+[<Br>]
					B=B+[Received:]+cReceived+[<Br>]
					B=B+[</html>]
		
					loEMailItem.HTMLBody = B
					*		loEmailItem.Attachments.Add(cFileName)
		
					loEMailItem.DISPLAY()
					*loEmailItem.Send
					*loApp.Quit()
					RELEASE loApp, loEMailItem
		
					WAIT WINDOW "Click on the blinking Outlook window to address you Email" NOWAIT
				CATCH
					MESSAGEBOX("Could not start Outlook")
				ENDTRY
		
			ENDIF
	ENDPROC

	PROCEDURE cmdShowPO.Click
			PRIVATE cPOItem
			cPOItem = LatePO.PoItem
		
			DO FORM FORMS\ShowPO WITH cPOItem
		
	ENDPROC

	PROCEDURE cmdShowSO.Click
			PRIVATE cSOitem
			cSOitem	= LatePO.Soitem
		
			IF NOT EMPTY(cSOitem)
				DO FORM FORMS\ShowvSOitem WITH cSOitem
			ENDIF
	ENDPROC

