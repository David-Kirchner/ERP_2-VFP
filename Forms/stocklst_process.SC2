	PROCEDURE backcolor_grd_show_order
		*ThisForm.BackColor_grd_Show_Order
		PRIVATE nReturn
		nReturn = RGB(60,255,200)
		IF tmpOrder_Process.ID_Detail = ThisForm.ID_Detail
			nReturn = RGB(255,255,255)  &&White
		ENDIF
		RETURN nReturn
			
	ENDPROC

	PROCEDURE calc_qty
		*ThisForm.Calc_QTY()
		
		PRIVATE nPieces, cAlloy, cForm, nThck, nSz2, nSz3, nPU
		nPieces	= PrepareSQLnum(ThisForm.Prc_Pcs.Value,'Pieces',7,0)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Prc_Form.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.Prc_Dim1.Value,'Dim1',10,4)
		nSz2	= PrepareSQLnum(ThisForm.Prc_Dim2.Value,'Dim2',9,3)
		nSz3	= PrepareSQLnum(ThisForm.Prc_Dim3.Value,'Dim3',9,3)
		nPU		= PrepareSQLnum(ThisForm.S_PU.Value,'PU',-1)
		
		PRIVATE nLBS, nFeet, nQTY
		nQTY = 0
		DO CASE
		CASE nPU = 1
			nLBS = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,ThisForm.nConnHandle)
			nQTY = PrepareSQLnum(nLBS,'Weight',8,1)
		CASE nPU = 2
			nFeet = Calc_Feet(nPieces, cForm, nSz2, nSz3, ThisForm.nConnHandle ) 
			nQTY = nFeet
		CASE nPu = 3
			nQTY = nPieces
		ENDCASE
			
		ThisForm.P_QTY1.Value = nQTY
		
		ThisForm.SumProcess()
		
	ENDPROC

	PROCEDURE deleteprocess
		*ThisForm.DeleteProcess()
		*Remove by ID_Detail_Process not SOitem!!
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		
		PRIVATE cSOitem, nID_Detail_Process_OLD
		cSOitem	= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		nID_Detail_Process_OLD	= ThisForm.ID_Detail_process
		
		IF USED("StockLst_Detail_SOitem_Sub")
			USE IN StockLst_Detail_SOitem_Sub
		ENDIF
		SELECT 0
		
		IF nID_Detail_Process_OLD < 1
			ThisForm.ID_Detail_process = -2
			RETURN .F.
		ENDIF
		
		cSQLn = "SELECT COUNT(*) AS counted FROM "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQLn = cSQLn + "dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQLn = cSQLn + "dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQLn = cSQLn + "dbo.WIPLst_Process "
		ENDCASE
		*cSQLn = cSQLn + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"') "
		*cSQLn = cSQLn + " WHERE AllowSub = 'Y' "
		cSQLn = cSQLn + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process_OLD))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle , cSQLn, 'StockLst_Detail_SOitem_Sub')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_SOitem_Sub')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Detail_SOitem_Sub")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, "StockLst_Detail_SOitem_Sub")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQLn, ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_SOitem_Sub')
		ELSE
			
			IF USED('StockLst_Detail_SOitem_Sub')
				IF RECCOUNT('StockLst_Detail_SOitem_Sub') > 0
					IF StockLst_Detail_SOitem_Sub.counted > 1
						TrackError(cSQLn, "Counted more than 1 to DELETE!",'StockLst_Process.DeleteProcess',LINENO(1) )
					ENDIF
					IF StockLst_Detail_SOitem_Sub.counted >= 1
					
						*Remove old Process
						PRIVATE cSQLd 
						cSQLd = ""
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQLd = cSQLd + "DELETE FROM dbo.StockLst_Process "
						CASE ThisForm.cTBL = "B"
							cSQLd = cSQLd + "DELETE FROM dbo.BrokerLst_Process "
						CASE ThisForm.cTBL = "W"
							cSQLd = cSQLd + "DELETE FROM dbo.WIPLst_Process "
						ENDCASE
						*cSQLd = cSQLd + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"') "
						cSQLd = cSQLd + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process_OLD)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 	
						
						IF nSQLEXEC < 0
							*Could not Delete
							ThisForm.ID_Detail_process = -2
							
							SQLEXECError(cSQLd, ThisForm.nConnHandle, nSQLEXEC, '')
							*dbo.StockLst_Process_History dbo.BrokerLst_Process_History
		*!*						cSQLd = ""
		*!*						DO CASE
		*!*						CASE ThisForm.cTBL = "S"
		*!*							cSQLd = cSQLd + "UPDATE dbo.Ar_StockLst_Process_History "
		*!*						CASE ThisForm.cTBL = "B"
		*!*							cSQLd = cSQLd + "UPDATE dbo.Ar_BrokerLst_Process_History "
		*!*						CASE ThisForm.cTBL = "W"
		*!*							cSQLd = cSQLd + "UPDATE dbo.Ar_WIPLst_Process_History "
		*!*						ENDCASE
		*!*						*cSQLd = cSQLd + " SET [WHAT]='SUBED' "
		*!*						*cSQLd = cSQLd + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
		*!*						cSQLd = cSQLd + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process_OLD))
		*!*						cSQLd = cSQLd + " AND [What] = 'DELETE' "
		
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
		*!*						ENDDO
		*!*						IF nSQLEXEC < 0 &&Try again!
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
		*!*								
		*!*								IF nSQLEXEC < 0
		*!*									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*										nSQLEXEC = 0
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDDO
		*!*						ENDIF 	
		*!*						IF nSQLEXEC < 0
		*!*							SQLEXECError(cSQLd, ThisForm.nConnHandle, nSQLEXEC, '')
		*!*						ENDIF
						ELSE
							*Deleted
							ThisForm.ID_Detail_process = -3
							
							PRIVATE nMess
							nMess = 7
							nMess = MESSAGEBOX("Will you be adding a Substitute Process?",4+32,"Substitue?")
							
							IF nMess = 6
								
								cSQLd = ""
								DO CASE
								CASE ThisForm.cTBL = "S"
									cSQLd = cSQLd + "UPDATE dbo.Ar_StockLst_Process_History "
								CASE ThisForm.cTBL = "B"
									cSQLd = cSQLd + "UPDATE dbo.Ar_BrokerLst_Process_History "
								CASE ThisForm.cTBL = "W"
									cSQLd = cSQLd + "UPDATE dbo.Ar_WIPLst_Process_History "
								ENDCASE
								cSQLd = cSQLd + " SET [WHAT]='SUBED' "
								*cSQLd = cSQLd + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
								cSQLd = cSQLd + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process_OLD))
								cSQLd = cSQLd + " AND [What] = 'DELETE' "
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 	
								IF nSQLEXEC < 0
									SQLEXECError(cSQLd, ThisForm.nConnHandle, nSQLEXEC, '')
								ENDIF
							ENDIF
						ENDIF
					ENDIF	
				ELSE
					ThisForm.ID_Detail_process = -2				
				ENDIF
			ELSE
				ThisForm.ID_Detail_process = -2
			ENDIF
		ENDIF
		
		
		*USE ThisForm.ID_Detail_process to return sucsess codes!
		RETURN lOK
	ENDPROC

	PROCEDURE form_check
		PARAMETERS pFrom
		*ThisForm.Form_Check()
			
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= PrepareSQLtxt(ThisForm.Prc_Form.Value,'Form',2)
		nPrc_PCs	= PrepareSQLnum(ThisForm.Prc_PCs.Value,'PCs',-3)
		
		nPrc_Dim1	= PrepareSQLnum(ThisForm.Prc_Dim1.Value,'Dim1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisForm.Prc_Dim2.Value,'Dim2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisForm.Prc_Dim3.Value,'Dim3',9,3)
		
		*Uses3rdDim RequireSZ3LBS
		PRIVATE lHasFormTable
		lHasFormTable = .F.
		IF LEN(cPrc_Form)>0
			lHasFormTable = GetFormCaptions(cPrc_Form,ThisForm.nConnhandle)
		ENDIF
		IF lHasFormTable
			
			IF USED('tmpPQSL_FormCaptions')
		
				ThisForm.LBLTHCK1.Caption	= RTRIM(tmpFormCaptions.txt1)
				ThisForm.LBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
				ThisForm.LBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
				ThisForm.LBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
				ThisForm.LBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
				ThisForm.Prc_Dim3.Visible 		= tmpFormCaptions.use3rdDim
				ThisForm.Prc_Dim3.Enabled	 	= tmpFormCaptions.Sz3Enable
				
				ThisForm.LBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
				ThisForm.LBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
		
				USE IN tmpFormCaptions
			ELSE
				TrackMess( "tmpFormCaptions is not used!"+" "+CHR(13)+SYS(16,1))
			ENDIF
		ENDIF
						
		RETURN .T.
	ENDPROC

	PROCEDURE getbyinqnump
		*ThisForm.GetByInqNumP()
		*PRIVATE lEdit
		*lEdit = PrepareSQLlogic(nEdit,'Edit')  &&Edit Vs Add
		
		PRIVATE cSQL, nSQLEXEC
		
		*****************************
		*Overwrite with InqNumP data
		*This is the GetByInqNumP procedure!
		
		cSQL = "SELECT AQ.* "
		cSQL = cSQL+", dbo.f_DescriptCL(AQ.Alloy,AQ.CC,AQ.CL,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen)  AS DescriptCL "
		cSQL = cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK)"
		cSQL = cSQL+" WHERE AQ.InqNumP = '"+Proper_InqNumP(ThisForm.cInqNumP)+"'"
		
		IF USED("tmpProc_AQq")
			SELECT tmpProc_AQq
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_AQq')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_AQq')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_AQq")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_AQq")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle , nSQLEXEC, 'tmpProc_AQq')
		ELSE
			IF USED("tmpProc_AQq")
			
				*Data check
				PRIVATE nS_PU, nO_QTY, nS_P, nPounds
				nS_PU	= GetPUfromForm(tmpProc_AQq.Form,ThisForm.nConnHandle)
				nO_QTY	= PrepareSQLnum(tmpProc_AQq.S_QTY,'StockLst_QTY',9,1)
				nS_P	= PrepareSQLnum(tmpProc_AQq.S_P,'StockLst_P',-5)
				nPounds	 = PrepareSQLnum(tmpProc_AQq.Weight,'Pounds',9,1)
				PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
				cPrc_Form= PrepareSQLtxt(tmpProc_AQq.Form,'Form',2)
				nPrc_PCs = PrepareSQLnum(tmpProc_AQq.Pieces,'Prc_PCs',-3)
				nPrc_Dim1= PrepareSQLnum(tmpProc_AQq.Thck,'Thck',10,4)
				nPrc_Dim2= PrepareSQLnum(tmpProc_AQq.Sz2,'Dim2',-5)
				nPrc_Dim3= PrepareSQLnum(tmpProc_AQq.Sz3,'Dim3',-5)
		
				**** Usualy show these P_Qty
				ThisForm.P_QTY1.Value		= 0	&&Calc_QTY()
				*ThisForm.D_QTY1.Value --get from ID_Detail
				ThisForm.P_Pounds.Value		= 0
				ThisForm.Prc_P.Value		= 0
				
				ThisForm.S_PU.Value			= nS_PU
				ThisForm.O_QTY1.Value		= nO_QTY
				ThisForm.O_Pounds.Value		= nPounds
				ThisForm.Order_P.Value		= nS_P
				
				ThisForm.Prc_Form.Value		= cPrc_Form
				ThisForm.Prc_PCs.Value		= nPrc_PCs
				ThisForm.Prc_Dim1.Value		= nPrc_Dim1
				ThisForm.Prc_Dim2.Value		= nPrc_Dim2
				ThisForm.Prc_Dim3.Value		= nPrc_Dim3
				
				IF NOT EMPTY(cPrc_Form)
					ThisForm.RefreshForm(cPrc_Form)
				ENDIF
		
				ThisForm.Process_ID1.Value	= "QUOTED"
				ThisForm.Processor1.Value	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
				
				PRIVATE cSOitem, cPOitem 
				cSOitem = PrepareSQLtxt(tmpProc_AQq.SOitem,'SOitem',10)
				cPOitem = PrepareSQLtxt(tmpProc_AQq.POitem,'POitem',12)
				IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
					ThisForm.SOitem1.Value = cSOitem
					ThisForm.SOitem1.Visible = .T.
					ThisForm.lblSOITEM1.Visible = .T.
				ENDIF
				IF Proper_PO_Item(pPOitem) <> Proper_PO_Item('')
					ThisForm.PO_item1.Value	= cPOItem
					ThisForm.PO_item1.Visible = .T.
					ThisForm.lblPO_Item.Visible = .T.
				ENDIF
				PRIVATE nWO, nWO_Detail
				nWO = PrepareSQLnum(tmpProc_AQq.WO,'WO',-3)
				IF nWO > 0
					ThisForm.nWO = nWO
					ThisForm.txtWO.Value	= nWO
					ThisForm.txtWO.Visible	= .T.
					ThisForm.lblWO.Visible = .T.
				ENDIF
				ThisForm.txtWO_Detail.Value	= 0	&&= PrepareSQLnum(tmpProc_AQq.WO_Detail,'WO_Detail',-3)
				
				ThisForm.txtInqNumP.Value	= Proper_InqNumP(ThisForm.cInqNumP)	
				
				ThisForm.SalesPerson1.Value = AppSetup_Get_SalesRep_SalesP(tmpProc_AQq.SalesP)
				ThisForm.txtAlloy.Value = ShowSQLtxt(tmpProc_AQq.Alloy,'Alloy',12)
				ThisForm.txtSpecs.Value	= ShowSQLtxt(tmpProc_AQq.Descript,'Descript',100) 
		
		*		ThisForm.txtDescript.Value  = ShowSQLtxt(tmpProc_AQq.DescriptCL,'Descript',100) 
				ThisForm.StartDate1.Value	= DTOC(DATE())
				ThisForm.DueDate1.Value 	= DTOC(DATE()+1)
				
				ThisForm.chkAllowSub.Value	= 0	
				*ThisForm.chkAllowSub.Enabled = .F.
				
				ThisForm.txtAlloy.Visible	= .T.
				ThisForm.txtSpecs.Visible	= .T.
		*		ThisForm.txtDescript.Visible= .T.
			
				ThisForm.lblAlloy.Visible	= .T.
				ThisForm.lblSpecs.Visible	= .T.
				
				ThisForm.cmdConsume.Visible = .F.
				
			ELSE
				THISFORM.InitMemVar()
			ENDIF
		ENDIF
		
		
		*****************************
		cComment = "Stock was Quoted ["+ThisForm.cInqNumP+"], hold for a day! " +CHR(13)
		cComment = cComment + ShowSQLtxt(tmpProc_AQq.DescriptCL,'Descript',100) +CHR(13)
		ThisForm.Comment1.Value = cComment
		
		IF Proper_SO_item(pSOItem) <> Proper_SO_item('')
		*	IF LEN(ThisForm.Comment1.Value) < 80
				IF NOT "SOi#" $ cComment
					ThisForm.Comment1.Value	= ThisForm.Comment1.Value+" "+CHR(13)+ "SOi#"+ALLTRIM(Proper_SO_item(pSOItem))
				ENDIF
		*	ENDIF
		ENDIF
		
		*****************************
		
		IF USED("tmpProc_AQq")
			USE IN tmpProc_AQq
		ENDIF
		
		*******************
		*Check if New or Old
		*!*	SELECT ISNULL(P.ID_Detail_Process,0) AS ID_D_P, 'S' AS cTBL  
		*!*	FROM dbo.StockLst_Process P WITH(NOLOCK) WHERE P.Process_ID='QUOTED' 
		*!*	AND P.Comment like 'Stock was Quoted %' AND  P.Comment like '%   20098D%'
		
		*AND LEFT(Comment,28) = 'Stock was Quoted [   20098D]'
		*AND Comment like 'Stock was Quoted _   20098D_,%'  --Works
		
		DO CASE 
		CASE ThisForm.cTBL = "S"
			cSQL = "SELECT ISNULL(P.ID_Detail_Process,0) AS ID_D_P, ID_Detail "
			cSQL = cSQL+" FROM dbo.StockLst_Process P WITH(NOLOCK)"
		CASE ThisForm.cTBL = "B"
			cSQL = " SELECT ISNULL(P.ID_Detail_Process,0) AS ID_D_P, ID_Detail "
			cSQL = cSQL+" FROM dbo.BrokerLst_Process P WITH(NOLOCK)"
		CASE ThisForm.cTBL = "W"
			cSQL = " SELECT ISNULL(P.ID_Detail_Process,0) AS ID_D_P, ID_Detail "
			cSQL = cSQL+" FROM dbo.WIPLst_Process P WITH(NOLOCK)"
		OTHERWISE
			cSQL = "SELECT ISNULL(P.ID_Detail_Process,0) AS ID_D_P, ID_Detail "
			cSQL = cSQL+" FROM dbo.StockLst_Process P WITH(NOLOCK)"
		ENDCASE
		
		cSQL = cSQL+" WHERE P.Process_ID='QUOTED'"
		*cSQL = cSQL+" AND LEFT(P.Comment,28) = 'Stock was Quoted ["+Proper_InqNumP(ThisForm.cInqNumP)+"]'"
		cSQL = cSQL+" AND P.InqNumP = '"+Proper_InqNumP(ThisForm.cInqNumP)+"'"
		
		IF USED("tmpProc_AQq")
			SELECT tmpProc_AQq
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_AQq')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_AQq')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_AQq")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_AQq")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle , nSQLEXEC, 'tmpProc_AQq')
		ELSE
			IF USED("tmpProc_AQq")
				IF RECCOUNT("tmpProc_AQq") >0
		*		IF PrepareSQLnum(tmpProc_AQq.ID_D_P,'ID_Detail_Process',-3) > 0
					*Found
					SCAN
						IF ThisForm.ID_Detail = PrepareSQLnum(tmpProc_AQq.ID_Detail,'ID_Detail',-3)
							ThisForm.cmdSave.Caption = "Delete"
							ThisForm.ID_Detail_Process = PrepareSQLnum(tmpProc_AQq.ID_D_P,'ID_Detail_Process',-3)
							ThisForm.ID_Detail_Process1.Value = ThisForm.ID_Detail_Process
							ThisForm.ID_Detail_Process1.Visible = .T.
							ThisForm.lblID_Detail_Process.Visible = .T.
								
							EXIT
						ENDIF
						
					ENDSCAN
				ENDIF
				USE IN tmpProc_AQq
			ENDIF
		ENDIF
		***
	ENDPROC

	PROCEDURE getbywo
		PARAMETERS nEdit,pSOItem
		*ThisForm.GetByWO()
		*Overwrite with WO data
		
		PRIVATE lEditWO
		lEditWO = PrepareSQLlogic(nEdit,'Edit')  &&Edit Vs Add
		
		PRIVATE cDescription, cComment
		cDescription = ''
		cComment	= ''
		
		PRIVATE lFoundWO
		lFoundWO = .F.
		
		PRIVATE cSQL, nSQLEXEC
		
		*****************************
		
		*This is the getByWO procedure!
		IF NOT lFoundWO	
			*Not found by Lst_Process 
			
			cSQL = "SELECT * FROM dbo.WorkOrder WHERE WO = "+STR(ThisForm.nWO)
		
			IF USED("tmpProc_WO")
				SELECT tmpProc_WO
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_WO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_WO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_WO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_WO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle , nSQLEXEC, 'tmpProc_WO')
			ELSE
				IF USED("tmpProc_WO")
				
					*Data check
					PRIVATE csForm, nS_PU, nQTY, nP_QTY, nPounds
					csForm	= PrepareSQLtxt(tmpProc_WO.sForm,'Form',2)
					nS_PU	= GetPUfromForm(csForm,ThisForm.nConnHandle)
					nQTY	= PrepareSQLnum(tmpProc_WO.sWeight,'StockLst_QTY',9,1)
					nP_QTY	= PrepareSQLnum(tmpProc_WO.sWeight,'S_QTY',9,1)
					
					cPrc_Form= PrepareSQLtxt(tmpProc_WO.sForm,'Form',2)
					nPrc_PCs = PrepareSQLnum(tmpProc_WO.sPieces,'Prc_PCs',-3)
					nPrc_Dim1= PrepareSQLnum(tmpProc_WO.sThck,'Thck',10,4)
					nPrc_Dim2= PrepareSQLnum(tmpProc_WO.sSz2,'Dim2',-5)
					nPrc_Dim3= PrepareSQLnum(tmpProc_WO.sSz3,'Dim3',-5)
					nPounds	= PrepareSQLnum(tmpProc_WO.sWeight,'Pounds',9,1)
					
					IF NOT EMPTY(cPrc_Form)
						ThisForm.RefreshForm(cPrc_Form)
					ENDIF
		
					*cDescription = PrepareSQLtxt(tmpProc_WO.Descript,'Descript',20)  NOT HERE
					******
		
					*test Data
					IF nP_QTY < 1
						IF nQTY < 1
							*No QTY !!!
							nQTY = CalcDetail_QTY( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
							IF nQTY = 0
								nQTY = nPounds
								nP_QTY = nQTY
								RecordTest('Record Test Data.', "StockLst_Process.GetByWO()", LineNo(1), "Query did not have P_QTY or QTY. "+CHR(13)+cSQL )
							ELSE
								nP_QTY = nQTY
							ENDIF
						ELSE
							nP_QTY = nQTY
						ENDIF			
					ENDIF
							
					IF nPounds = 0
						nPounds = CalcDetail_LBS( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
						IF nPounds = 0
							RecordTest('Record Test Data.', "StockLst_Process.GetByWO()", LineNo(1), "Query did not have Weight. "+CHR(13)+cSQL )
						ENDIF
					ENDIF
					
					PRIVATE dWODueDate , dDueDate
					dtWOStartDate= PrepareSQLdateTime(tmpProc_WO.StartDate,'StartDate', .F.,.T.)
					dWODueDate	= PrepareSQLdate(tmpProc_WO.DueDate,'DueDate', .F.,.T.)
					dDueDate	= PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate', .F.,.T.)
					
					IF EMPTY( dDueDate )
						ThisForm.DueDate1.Value = dWODueDate 
					ELSE
						IF NOT EMPTY( dWODueDate )
							IF dWODueDate <> dDueDate 
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+" Process DueDate of "+DTOC(dDueDate)+CHR(13)+" with WO DueDate of "+DTOC(dWODueDate)+"?",4+32,"Replace Date?")=6
									ThisForm.DueDate1.Value = dWODueDate 
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					
					**** end test
					ThisForm.S_PU.Value			= PrepareSQLtxt(nS_PU,'StockLst_PU',1)			
					*ThisForm.O_QTY1.Value		= nQTY
					ThisForm.P_QTY1.Value		= nP_QTY
					ThisForm.P_Pounds.Value		= nPounds
					
					ThisForm.Prc_Form.Value		= cPrc_Form
					ThisForm.Prc_PCs.Value		= nPrc_PCs
					ThisForm.Prc_Dim1.Value		= nPrc_Dim1
					ThisForm.Prc_Dim2.Value		= nPrc_Dim2
					ThisForm.Prc_Dim3.Value		= nPrc_Dim3
					
					ThisForm.Process_ID1.Value	= "SELECTED"
					ThisForm.Processor1.Value	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
					Private cSOitem, cPOitem
					cSOitem = PrepareSQLtxt(tmpProc_WO.SOitem,'SOitem',10)
					cPOitem = PrepareSQLtxt(tmpProc_WO.POitem,'POItem',12)
					IF Proper_SO_Item(cSOitem ) <> Proper_SO_Item('')
						ThisForm.SOitem1.Value = cSOitem 
						ThisForm.SOitem1.Visible = .T.
						ThisForm.lblSOITEM1.Visible = .T.
					ENDIF
					IF Proper_PO_Item(cPOitem ) <> Proper_PO_Item('')
						ThisForm.PO_item1.Value = cPOitem 
						ThisForm.PO_item1.Visible = .T.
						ThisForm.lblPO_Item.Visible = .T.
					ENDIF
					PRIVATE nWO, nWO_Detail
					nWO = PrepareSQLnum(tmpProc_WO.WO,'WO',-3)
					IF nWO > 0
						ThisForm.nWO = nWO
						ThisForm.txtWO.Value	= nWO
						ThisForm.txtWO.Visible	= .T.
						ThisForm.lblWO.Visible = .T.
						*ThisForm.nWO				= PrepareSQLnum(tmpProc_WO.WO,'WO',-3) --redundant
					ENDIF
					ThisForm.SalesPerson1.Value = PrepareSQLtxt(tmpProc_WO.SalesRep,'SalesRep',20)
					ThisForm.StartDate1.Value	= dtWOStartDate
					*ThisForm.DueDate1.Value		= dWODueDate
					
						
		*			IF lEditWO 
		*				*EDIT
		*				ThisForm.chkAllowSub.Value	= PrepareSQLchk(tmpProc_WO.AllowSub,'AllowSub')
		*			ELSE
		*				*Add
						ThisForm.chkAllowSub.Value	= 0	
						ThisForm.chkAllowSub.Enabled = .F.
		*			ENDIF
					
		*			ThisForm.txtWO_Detail.Value	= 0 &&PrepareSQLnum(tmpProc_WO.WO_Detail,'WO_Detail',-3)  &&Does not exists
		*			ThisForm.nWO_Detail 		= 0
					
				ELSE
					IF lEditWO 
						THISFORM.InitMemVar()
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		
		IF EMPTY(cDescription) AND ThisForm.nWO >0
			
			cDescription = get_Description_WO( ThisForm.nWO, ThisForm.nConnHandle, .T. ) &&Add AlloyCC
			
			*cDescription = get_Description_ID_Detail( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle, .T. )
			*-- this only works in Get By ID
		ENDIF
		*ThisForm.txtDescript.Value	= cDescription
		
		cComment = PrepareSQLtxt(ThisForm.Comment1.Value,'Comment',100)
		IF NOT "WO#" $ cComment
			IF ThisForm.nWO > 0
				IF NOT "for:" $ cComment
					ThisForm.Comment1.Value	= LEFT("WO#"+ALLTRIM(STR(ThisForm.nWO))+" for: "+cDescription+" "+cComment,100)
				ELSE
					IF NOT "WO#" $ cComment
						ThisForm.Comment1.Value	= LEFT("WO#"+ALLTRIM(STR(ThisForm.nWO))+" for: "+cDescription+" "+cComment,100)
					ELSE
						*already done!
						*ThisForm.Comment1.Value	= LEFT("WO#"+ALLTRIM(STR(ThisForm.nWO))+" "+cComment,100)
					ENDIF
				ENDIF
			ELSE
				*ThisForm.Comment1.Value
			ENDIF
		ENDIF
		
		IF Proper_SO_item(pSOItem) <> Proper_SO_item('')
			IF LEN(ThisForm.Comment1.Value) < 80
				IF NOT "SOi#" $ cComment
					IF Proper_SO_item(pSOitem) <> Proper_SO_item('')
						ThisForm.Comment1.Value	= ThisForm.Comment1.Value+" "+CHR(13)+ "SOi#"+ALLTRIM(Proper_SO_item(pSOItem))
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.StartDate1.Value > ThisForm.DueDate1.Value
			ThisForm.DueDate1.Value = PrepareSQLdate(ThisForm.StartDate1.Value,'StartDate')  &&Convert to just Date
		ENDIF
		
		*****************************
		
		IF USED("tmpProc_WO")
			USE IN tmpProc_WO
		ENDIF
		
	ENDPROC

	PROCEDURE getbywo_detail
		PARAMETERS nEdit,pSOItem
		*ThisForm.GetByWO_Detail()
		*Overwrite with WO_Detail data
		
		PRIVATE lEditWOD
		lEditWOD = PrepareSQLlogic(nEdit,'Edit')  &&Edit Vs Add
		
		PRIVATE cDescription, cComment
		cDescription = ''
		cComment	= ''
		
		PRIVATE lFoundWOD
		lFoundWOD = .F.
		
		PRIVATE cSQL, nSQLEXEC
		
		*****************************
		*This is the getByWO procedure!
		IF NOT lFoundWOD	
			*Not found by Lst_Process 
			
			cSQL = "SELECT * FROM dbo.WorkOrder_Detail WOD "
			cSQL = cSQL + " INNER JOIN dbo.WorkOrder WO ON WOD.WO = WO.WO "
			cSQL = cSQL + " WHERE WOD.WO_Detail = "+STR(ThisForm.nWO_Detail)
		
			IF USED("tmpProc_WOD")
				SELECT tmpProc_WOD
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_WOD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_WOD')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_WOD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_WOD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle , nSQLEXEC, 'tmpProc_WOD')
			ELSE
				IF USED("tmpProc_WOD")
				
					*Data check
					PRIVATE csForm, nS_PU, nQTY, nP_QTY, nPounds
					csForm	= PrepareSQLtxt(tmpProc_WOD.fForm,'Form',2)
					nS_PU	= GetPUfromForm(csForm,ThisForm.nConnHandle)
					nQTY	= PrepareSQLnum(tmpProc_WOD.fWeight,'StockLst_QTY',9,1)
					nP_QTY	= PrepareSQLnum(tmpProc_WOD.fWeight,'S_QTY',9,1)
					
					cPrc_Form= PrepareSQLtxt(tmpProc_WOD.fForm,'Form',2)
					nPrc_PCs = PrepareSQLnum(tmpProc_WOD.fPieces,'Prc_PCs',-3)
					nPrc_Dim1= PrepareSQLnum(tmpProc_WOD.fThck,'Thck',10,4)
					nPrc_Dim2= PrepareSQLnum(tmpProc_WOD.fSz2,'Dim2',-5)
					nPrc_Dim3= PrepareSQLnum(tmpProc_WOD.fSz3,'Dim3',-5)
					nPounds	= PrepareSQLnum(tmpProc_WOD.fWeight,'Pounds',9,1)
					
					IF NOT EMPTY(cPrc_Form)
						ThisForm.RefreshForm(cPrc_Form)
					ENDIF
		
					*cDescription = PrepareSQLtxt(tmpProc_WOD.Descript,'Descript',20)  NOT HERE
					******
		
					*test Data
					IF nP_QTY < 1
						IF nQTY < 1
							*No QTY !!!
							nQTY = CalcDetail_QTY( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
							IF nQTY = 0
								nQTY = nPounds
								nP_QTY = nQTY
								RecordTest('Record Test Data.', "StockLst_Process.GetByWO_Detail()", LineNo(1), "Query did not have P_QTY or QTY. "+CHR(13)+cSQL )
							ELSE
								nP_QTY = nQTY
							ENDIF
						ELSE
							nP_QTY = nQTY
						ENDIF			
					ENDIF
							
					IF nPounds = 0
						nPounds = CalcDetail_LBS( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
						IF nPounds = 0
							RecordTest('Record Test Data.', "StockLst_Process.GetByWO_Detail()", LineNo(1), "Query did not have Weight. "+CHR(13)+cSQL )
						ENDIF
					ENDIF
					
					PRIVATE dWODueDate , dDueDate
					dtWOStartDate= PrepareSQLdateTime(tmpProc_WOD.fStartDate,'StartDate', .F.,.T.)
					dWODueDate	= PrepareSQLdate(tmpProc_WOD.fDueDate,'DueDate', .F.,.T.)
					dDueDate	= PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate', .F.,.T.)
					
					IF EMPTY( dDueDate )
						ThisForm.DueDate1.Value = dWODueDate 
					ELSE
						IF NOT EMPTY( dWODueDate )
							IF dWODueDate <> dDueDate 
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+" Process DueDate of "+DTOC(dDueDate)+CHR(13)+" with WO DueDate of "+DTOC(dWODueDate)+"?",4+32,"Replace?")=6
									ThisForm.DueDate1.Value = dWODueDate 
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					
					**** end test
					ThisForm.S_PU.Value			= PrepareSQLtxt(nS_PU,'StockLst_PU',1)			
					
					ThisForm.P_QTY1.Value		= nP_QTY
					ThisForm.P_Pounds.Value		= nPounds
					* same as WO P QTY
					ThisForm.O_QTY1.Value		= nP_QTY
					ThisForm.O_Pounds.Value		= nPounds
					
					ThisForm.Prc_Form.Value		= cPrc_Form
					ThisForm.Prc_PCs.Value		= nPrc_PCs
					ThisForm.Prc_Dim1.Value		= nPrc_Dim1
					ThisForm.Prc_Dim2.Value		= nPrc_Dim2
					ThisForm.Prc_Dim3.Value		= nPrc_Dim3
		
					ThisForm.Process_ID1.Value	= "SELECTED"
					ThisForm.Processor1.Value	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
					
					PRIVATE cSOitem, cPOitem 
					cSOitem = PrepareSQLtxt(tmpProc_WOD.fSOitem,'SOitem',10)
					cPOitem = PrepareSQLtxt(tmpProc_WOD.fPOitem,'POitem',12)
					IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
						ThisForm.SOitem1.Value = cSOitem
						ThisForm.SOitem1.Visible = .T.
						ThisForm.lblSOITEM1.Visible = .T.
					ENDIF
					IF Proper_PO_Item(pPOitem) <> Proper_PO_Item('')
						ThisForm.PO_item1.Value	= cPOItem
						ThisForm.PO_item1.Visible = .T.
						ThisForm.lblPO_Item.Visible = .T.
					ENDIF
					
					PRIVATE nWO, nWO_Detail
					nWO = PrepareSQLnum(tmpProc_WOD.WO,'WO',-3)
					IF nWO > 0
						ThisForm.nWO = nWO
						ThisForm.txtWO.Value	= nWO
						ThisForm.txtWO.Visible	= .T.
						ThisForm.lblWO.Visible = .T.
					ENDIF
		
					ThisForm.SalesPerson1.Value = PrepareSQLtxt(tmpProc_WOD.SalesRep,'SalesRep',20)
					ThisForm.StartDate1.Value	= dtWOStartDate
					*ThisForm.DueDate1.Value		= dWODueDate
					
						
					IF lEditWOD 
						*EDIT
						*ThisForm.txtWO_Detail.Value	= PrepareSQLnum(tmpProc_WOD.WO_Detail,'WO_Detail',-3)  &&Does not exists
						*ThisForm.nWO_Detail 		= ThisForm.txtWO_Detail.Value
						*ThisForm.chkAllowSub.Value	= PrepareSQLchk(tmpProc_WOD.AllowSub,'AllowSub')
					ELSE
						*Add
						*ThisForm.txtWO_Detail.Value	= 0 &&PrepareSQLnum(tmpProc_WOD.WO_Detail,'WO_Detail',-3)  &&Does not exists
						*ThisForm.nWO_Detail 		= 0
						ThisForm.chkAllowSub.Value	= 0	
						ThisForm.chkAllowSub.Enabled = .F.
					ENDIF
					
				ELSE
					IF lEditWOD 
						THISFORM.InitMemVar()
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		
		IF EMPTY(cDescription)
			
			cDescription = get_Description_WOD( ThisForm.nWO_Detail, ThisForm.nConnHandle, .T. )
			
			*cDescription = get_Description_ID_Detail( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle, .T. )
			*-- this only workis in Get By ID
		ENDIF
		*ThisForm.txtDescript.Value	= cDescription
		
		cComment = PrepareSQLtxt(ThisForm.Comment1.Value,'Comment',100)
		IF NOT "WO#" $ cComment
			IF ThisForm.nWO > 0
				IF NOT "for:" $ cComment
					ThisForm.Comment1.Value	= LEFT("WO#"+ALLTRIM(STR(ThisForm.nWO))+" for: "+cDescription+" "+cComment,100)
				ELSE
					IF NOT "WO#" $ cComment
						ThisForm.Comment1.Value	= LEFT("WO#"+ALLTRIM(STR(ThisForm.nWO))+" for: "+cDescription+" "+cComment,100)
					ELSE
						*already done!
						*ThisForm.Comment1.Value	= LEFT("WO#"+ALLTRIM(STR(ThisForm.nWO))+" "+cComment,100)
					ENDIF
				ENDIF
			ELSE
				*ThisForm.Comment1.Value
			ENDIF
		ENDIF
		
		IF Proper_SO_item(pSOItem) <> Proper_SO_item('')
			IF LEN(ThisForm.Comment1.Value) < 80
				IF NOT "SOi#" $ cComment
					ThisForm.Comment1.Value	= ThisForm.Comment1.Value+" "+CHR(13)+ "SOi#"+ALLTRIM(Proper_SO_item(pSOItem))
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.StartDate1.Value > ThisForm.DueDate1.Value
			ThisForm.DueDate1.Value = PrepareSQLdate(ThisForm.StartDate1.Value,'StartDate')  &&Convert to just Date
		ENDIF
		
		*****************************
		
		IF USED("tmpProc_WOD")
			USE IN tmpProc_WOD
		ENDIF
		
	ENDPROC

	PROCEDURE getfrompoitem
		PARAMETER pPoItem
		*ThisForm.GetFromPOitem()
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+pPoItem+"')"
		
		
		IF USED("tmpPO")
			USE IN tmpPO
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPO')
		ELSE
			IF USED("tmpPO")
				*ThisForm.txtAlloy.Value = PrepareSQLtxt(tmpPO.Alloy,'Alloy',12)
				*ThisForm.txtSpecs.Value	= PrepareSQLtxt(tmpPO.Cond_Spec,'Heat',35,.F.,.T.)  &&Just for display
				*ThisForm.txtHeat.Value	= PrepareSQLtxt(tmpPO.Heat,'Heat',35)
					
				PRIVATE cDescription
				PRIVATE lRL, lMetric, nSz1orig, nSz2orig, nSz3orig
				lRL = .F.
				lMetric = .F.
				nSz1orig = ''
				nSz2orig = ''
				nSz3orig = ''
				 
				cDescription = ItemDescriptionMetric(tmpPO.Form,tmpPO.Thck,tmpPO.SZ2,tmpPO.SZ3, tmpPO.Order_Qty, lRL, lMetric, nSz1orig, nSz2orig, nSz3orig)
		*		ThisForm.txtDescript.Value = cDescription
				
				ThisForm.txtAlloy.Visible	= .T.
				ThisForm.txtSpecs.Visible	= .T.
				ThisForm.txtHeat.Visible	= .T.
		*		ThisForm.txtDescript.Visible	= .T.
			
				ThisForm.lblAlloy.Visible	= .T.
				ThisForm.lblSpecs.Visible	= .T.
				ThisForm.lblHeat.Visible	= .T.
				
				******************
				ThisForm.Comment1.Value = LEFT( "POitem#'"+ALLTRIM(pPoItem)+"' for: "+cDescription ,100)
				*PrepareSQLtxt(tmpPO.Cond_Spec,'Cond_Spec',100,.F.,.T.) 
				
				ThisForm.P_QTY1.Value 	= PrepareSQLnum(tmpPO.Order_QTY,'QTY',9,1)
				ThisForm.P_Pounds.Value	= PrepareSQLnum(tmpPO.Pounds,'Pounds',8,1)
				
				*ThisForm.O_QTY1.Value 	= PrepareSQLtxt(tmpPO.StockLst_QTY,'S_QTY',9,1)
				*ThisForm.S_PU.Value		= PrepareSQLtxt(tmpPO.Order_PU,'S_PU',1)
				ThisForm.S_PU.Value	= GetPUfromForm(tmpPO.Form,ThisForm.nConnHandle)
				*Services, ConvServ, Equipment, Metric, Reconciled, BMScheck, Melt, IntP
				USE IN tmpPO
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getso_duedate
		PARAMETERS cSOitem
		*GetSO_DueDate(pSOitem)
		
		*cSOitem	= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)		
			
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			*Get DueDate for SOitem
		
			IF USED("tmpSOiDueDate")
				USE IN tmpSOiDueDate
			ENDIF
			SELECT 0
		
			cSQL = "SELECT S.ShipDue AS DueDate, SN.SalesRep FROM "
			cSQL = cSQL + " dbo.Sales S WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.Sales_No SN ON S.SalesNum = SN.SalesNum "
			cSQL = cSQL + " WHERE S.SOitem = '"+cSOItem+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOiDueDate')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOiDueDate')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOiDueDate")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOiDueDate")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOiDueDate')
		
			ELSE
				
				IF USED('tmpSOiDueDate')
					IF RECCOUNT('tmpSOiDueDate') > 0
						dDueDate = PrepareSQLdate(tmpSOiDueDate.DueDate,'DueDate',.F.,.T.)
						ThisForm.DueDate1.Value = dDueDate
						ThisForm.SalesPerson1.Value	= PrepareSQLtxt(tmpSOiDueDate.SalesRep,'SalesRep',20)
					ENDIF
					USE IN tmpSOiDueDate
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getwo_duedate
		*GetWO_DueDate()
		
		IF USED("tmpWO_DueDate")
			USE IN tmpWO_DueDate
		ENDIF
		SELECT 0
		
		cSQL = "SELECT DueDate AS DueDate, SalesRep FROM "
		cSQL = cSQL + " dbo.WorkOrder "
		cSQL = cSQL + " WHERE WO = "+STR(ThisForm.nWO)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle , cSQL, 'tmpWO_DueDate')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_DueDate')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_DueDate")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_DueDate")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpWO_DueDate')
		ELSE
			IF USED('tmpWO_DueDate')
				IF RECCOUNT('tmpWO_DueDate') > 0
					dDueDate = PrepareSQLdate(tmpWO_DueDate.DueDate,'DueDate',.F.,.T.)
					ThisForm.DueDate1.Value = dDueDate
					ThisForm.SalesPerson1.Value	= PrepareSQLtxt(tmpWO_DueDate.SalesRep,'SalesRep',20)
				ENDIF
				USE IN tmpWO_DueDate
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE get_id_d_p		&& get ID_Detail_Process
		*ThisForm.Get_ID_D_P() replaced GetByID
		PRIVATE lQuarantine
		lQuarantine = .F.
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT P.*, M.Form, D.Quarantine"
		*, dbo.f_Get_nPU_Form(M.Form) AS S_PU FROM "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
		ENDCASE
		cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(ThisForm.ID_Detail_Process)
		
		IF USED("tmpStockLst_Process")
			SELECT tmpStockLst_Process
		ELSE 
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Process')
		ELSE
			IF USED("tmpStockLst_Process")
				
				PRIVATE nS_PU, nO_QTY, nP_QTY, nPounds, nPWeight
				nS_PU	= PrepareSQLnum(tmpStockLst_Process.PU,'StockLst_PU',-1)
				nP_QTY	= PrepareSQLnum(tmpStockLst_Process.QTY,'S_QTY',9,1)	&&QTY needed from ID_Detail. ERP Acct Standard Stnadard. Think as Prc_QTY
				nO_QTY	= PrepareSQLnum(tmpStockLst_Process.Ordered_QTY,'Ordered_QTY',9,1)
				nO_P	= PrepareSQLnum(tmpStockLst_Process.Ordered_P,'Ordered_P',-5)
				nPounds	= PrepareSQLnum(tmpStockLst_Process.Pounds,'Pounds',9,1)
		*		nPWeight	= PrepareSQLnum(tmpStockLst_Process.PWeight,'Pounds',9,1)
				
				PRIVATE cPrc_Form,nPrc_PCs,nPrc_Dim1,nPrc_Dim2,nPrc_Dim3
				cPrc_Form= PrepareSQLtxt(tmpStockLst_Process.Prc_Form,'Form',2)
				nPrc_PCs = PrepareSQLnum(tmpStockLst_Process.Prc_PCs,'Prc_PCs',-3)
				nPrc_Dim1= PrepareSQLnum(tmpStockLst_Process.Prc_Dim1,'Dim1',10,4)
				nPrc_Dim2= PrepareSQLnum(tmpStockLst_Process.Prc_Dim2,'Dim2',9,3)
				nPrc_Dim3= PrepareSQLnum(tmpStockLst_Process.Prc_Dim3,'Dim3',9,3)
				
				PRIVATE cForm
				cForm = PrepareSQLtxt(tmpStockLst_Process.Form,'Form',2)
				IF EMPTY(cPrc_Form)
					cPrc_Form = cForm
				ENDIF
				IF NOT EMPTY(cPrc_Form)
					ThisForm.RefreshForm(cPrc_Form)
				ENDIF
				
				******
				IF nS_PU = 0
					nS_PU = getPUfromID_Detail(ThisForm.ID_Detail,ThisForm.cTBL,ThisForm.nConnHandle)
					RecordTest('Record Test Data.', "StockLst_Process.Get_ID_D_P()", LineNo(1), "Query did not return a PU value. Used getPUfromID_Detail() to get '"+ALLTRIM(STR(nS_PU))+"' "+CHR(13)+cSQL )
				ENDIF
		
				******
				IF nP_QTY < 1
					IF nO_QTY < 1
						*No Process QTY !!!
						*get Complete Detail QTY
						nO_QTY = CalcDetail_QTY( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
						IF nO_QTY = 0
							*nO_QTY = nPounds
							nP_QTY = nPounds
							RecordTest('Record Test Data.', "StockLst_Process.Get_ID_D_P()", LineNo(1), "Query did not have P_QTY or QTY. "+CHR(13)+cSQL )
						ELSE
							nP_QTY = nO_QTY 
						ENDIF
					ELSE
						nP_QTY = nO_QTY 
					ENDIF			
				ENDIF
						
				IF nPounds <= 1
					nPounds = CalcDetail_LBS( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
					IF nPounds = 0
						RecordTest('Record Test Data.', "StockLst_Process.Get_ID_D_P()", LineNo(1), "Query did not have Weight. "+CHR(13)+cSQL )
					ENDIF
				ENDIF
				
				******* 
				lQuarantine = PrepareSQLlogic(tmpStockLst_Process.Quarantine,'Quarantine',.F.)
				ThisForm.txtQuarantine.Visible = lQuarantine
				IF lQuarantine
					ThisForm.cmdConsume.Visible = .F.
					ThisForm.cmdSave.Visible = .F.
				ENDIF
				
				ThisForm.ID_Detail 			= PrepareSQLnum(tmpStockLst_Process.ID_Detail,'ID_Detail',-3)
				ThisForm.ID_Detail_Process1.Value = ThisForm.ID_Detail_Process
				
				PRIVATE cSOitem, cPOitem 
				cSOitem = PrepareSQLtxt(tmpStockLst_Process.SOitem,'SOitem',10)
				cPOitem = PrepareSQLtxt(tmpStockLst_Process.PO_item,'POitem',12)
				IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
					ThisForm.SOitem1.Value = cSOitem
					ThisForm.SOitem1.Visible = .T.
					ThisForm.lblSOITEM1.Visible = .T.
				ENDIF
				IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
					ThisForm.PO_item1.Value	= cPOItem
					ThisForm.PO_item1.Visible = .T.
					ThisForm.lblPO_Item.Visible = .T.
				ENDIF
				
				*WO  and WO_Detail are done in data check.
				ThisForm.SalesPerson1.Value = PrepareSQLtxt(tmpStockLst_Process.SalesPerson,'SalesPerson',20)
				ThisForm.StartDate1.Value	= PrepareSQLdateTime(tmpStockLst_Process.StartDate,'StartDate', .F.,.T.)
				ThisForm.DueDate1.Value		= PrepareSQLdate(tmpStockLst_Process.DueDate,'DueDate', .F.,.T.)
				*ThisForm.chkAllowSub.Value	= IIF(tmpStockLst_Process.AllowSub="Y",1,0 )
				ThisForm.chkAllowSub.Value	= PrepareSQLchk(tmpStockLst_Process.AllowSub,"AllowSub")
				
				
				
				IF EMPTY(cPrc_Form)
					cPrc_Form = cForm
				ENDIF
				ThisForm.Prc_Form.Value		= cPrc_Form
				
				IF NOT EMPTY(cPrc_Form)
					ThisForm.RefreshForm(cPrc_Form)
				ENDIF
				
				
				IF nS_PU > 0
					IF nS_PU <> GetPUfromForm(cForm, ThisForm.nConnHandle)
						ThisForm.S_PU.Value = GetPUfromForm(cForm, ThisForm.nConnHandle)
					ELSE
						ThisForm.S_PU.Value	= PrepareSQLtxt(nS_PU,'S_PU',1)
					ENDIF
				ELSE
					ThisForm.S_PU.Value = PrepareSQLtxt(GetPUfromForm(cForm, ThisForm.nConnHandle),'S_PU',1)
				ENDIF
				
				ThisForm.Prc_PCs.Value		= nPrc_PCs
				ThisForm.Prc_Dim1.Value		= nPrc_Dim1
				ThisForm.Prc_Dim2.Value		= nPrc_Dim2
				ThisForm.Prc_Dim3.Value		= nPrc_Dim3
				
				ThisForm.P_QTY1.Value		= nP_QTY
				*ThisForm.Prc_P.Value		= 
				
				*Check Order_QTY for changes
				PRIVATE nO_QTY2
				nO_QTY2 = Get_QTYinSales(cSOItem, ThisForm.nConnHandle)
				IF ROUND(nO_QTY,-1) <> ROUND(nO_QTY2,-1)
					IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
						nO_QTY = nO_QTY2
					ENDIF
				ENDIF
				ThisForm.O_QTY1.Value		= nO_QTY
		*		ThisForm.O_Pounds.Value		= nPWeight
				ThisForm.Order_P.Value		= nO_P
				
				
				ThisForm.Process_ID1.Value	= PrepareSQLtxt(tmpStockLst_Process.Process_ID,'Process_ID',10)
				ThisForm.Processor1.Value	= PrepareSQLtxt(tmpStockLst_Process.Processor,'Processor',20)
				ThisForm.Comment1.Value		= PrepareSQLtxt(tmpStockLst_Process.COMMENT,'Comment',100)
				
				*[SOitem],[PO_item],[SalesPerson]
		*,[StartDate],[DueDate],[Comment],[Process_ID],[Processor],[AllowSub],[PWeight],[PPc],[PFT],[PU]
		*,[QTY],[Pounds],[ID_Detail],[ID_Detail_Process],[ReceivingID],[WO],[WO_Detail]
		
				PRIVATE nWO, nWO_Detail
				nWO = PrepareSQLnum(tmpStockLst_Process.WO,'WO',-3)
				IF nWO > 0
					ThisForm.nWO = nWO
					ThisForm.txtWO.Value	= nWO
					ThisForm.txtWO.Visible	= .T.
					ThisForm.lblWO.Visible = .T.
				ENDIF
				
				IF PrepareSQLnum(tmpStockLst_Process.WO_Detail,'WO_Detail',-3) > 0
					ThisForm.nWO_Detail = PrepareSQLnum(tmpStockLst_Process.WO_Detail,'WO_Detail',-3)
					ThisForm.txtWO_Detail.Value = PrepareSQLnum(tmpStockLst_Process.WO_Detail,'WO_Detail',-3)
				ENDIF
				
		
			ELSE
				THISFORM.InitMemVar()
			ENDIF
		ENDIF
		
		IF USED("tmpStockLst_Process")
			USE IN tmpStockLst_Process
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETER cWhatDo, pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pTBL, pPoItem, pWO, pID_Detail, pInqNumP, pWO_Detail
		*DO FORM forms\Stocklst_Process WITH cWhatDo, pID_D_P,  pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pTBL, pPoItem, pWO, nID_Detail, pInqNumP, pWO_Detail
		*DO FORM Forms\StockLst_Process WITH 'ADD_SOLD',0,'108420-01' , 'T','02/13/19',2.0,1.92,'','03/14/19','StockLst','', 0,16668, '',0
		*DO FORM Forms\StockLst_Process WITH 'EDIT_WO',237027,'' , 'D','',0,0,'','','StockLst','', 1709,58669,'',0
		*DO FORM Forms\StockLst_Process WITH "QUOTE", 				0, 		 '',    "D",         '12/26/23'   ,           463.1,            0,            '1Pc                   ',       '12/31/23',     'S'  ,      '',  0 ,       7878, "   20172D" TO nID_Detail_Process
		*DO FORM forms\Stocklst_Process WITH 'SHOW', 248771,  ' 134990-01', 'G', '12/31/23', 115, 115, 'Test', '01/02/24', 'S', '', 0, 59860, '', 0
		
		*DO FORM "c:\program files (x86)\hpa\forms\Stocklst_Process.scx" WITH 'EDIT',   33258,   ' 140083-01',     'G',         '',    1,    1,       '',       '',  'B','   511740-01',   0,      13354,       '', 0
		*                                                                    cWhatDo, pID_D_P,        pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pTBL,       pPoItem, pWO, pID_Detail, pInqNumP, pWO_Detail
		*cWhatDo= ADD_SOLD ADD_WO ADD QUOTE EDIT_WO EDIT SHOW DELETE
		
		IF TYPE('cWhatDo') = "C"
			DO CASE
			CASE cWhatDo= "ADD_SOLD"
				ThisForm.WhatDo = "ADD_SOLD"	&&
			CASE cWhatDo= "ADD_WOD"
				ThisForm.WhatDo = "ADD_WOD"  &&
			CASE cWhatDo= "ADD_WO"
				ThisForm.WhatDo = "ADD_WO"  &&
			CASE cWhatDo= "ADD"
				ThisForm.WhatDo = "ADD"
				
			CASE cWhatDo == "EDIT_WOD"		
				ThisForm.WhatDo = "EDIT_WOD"
			CASE cWhatDo== "EDIT_WO"
				ThisForm.WhatDo = "EDIT_WO" &&
			CASE cWhatDo== "EDIT"
				ThisForm.WhatDo = "EDIT"
				
			CASE cWhatDo == "QUOTE"
				ThisForm.WhatDo = "QUOTE"
				*pSOItem is InqNumP
				ThisForm.cInqNumP = PrepareSQLtxt(pSOItem,'InqNumP',9)
				
				pSOItem = ''
		
			CASE cWhatDo== "SHOW"
				ThisForm.WhatDo = "SHOW"
				
			CASE cWhatDo= "DELETE"
				ThisForm.WhatDo = "DELETE"
			OTHERWISE
				MESSAGEBOX("Need PARAMETER: cWhatDo is not ADD_SOLD,ADD_WOD,ADD,EDIT_WOD,EDIT_WO,EDIT,QUOTE,SHOW,DELETE " )
				TrackError("Need PARAMETER: cWhatDo is not ADD_SOLD,ADD_WOD,ADD,EDIT_WOD,EDIT_WO,EDIT,QUOTE,SHOW,DELETE" ,"StockLst_Process.Init",LINENO(1) )
				CANC
			ENDCASE
		ELSE
			MESSAGEBOX("Need PARAMETER: cWhatDo, pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pTBL, pPoItem, pWO, nID_Detail, pInqNumP, pWO_Detail" )
			TrackError("Error","Need PARAMETER: cWhatDo, pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pTBL, pPoItem, pWO,nID_Detail, pInqNumP, pWO_Detail" ,"StockLst_Process.Init",LINENO(1) )
			CANC
		ENDIF
		
		IF TYPE("pTBL") = "U"
			pTBL = "StockLst"
			TrackError("Error with pTBL","Need PARAMETER: cWhatDo, pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pTBL, pPoItem, pWO,nID_Detail, pWO_Detail" ,"StockLst_Process.Init",LINENO(1) )
		ENDIF
		IF TYPE("pTBL") != "C"
			pTBL = "StockLst"
			TrackError("Error with pTBL","Need PARAMETER: cWhatDo, pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pTBL, pPoItem, pWO,nID_Detail, pWO_Detail" ,"StockLst_Process.Init",LINENO(1) )
		ENDIF
		IF EMPTY("pTBL")
			pTBL = "StockLst"
			TrackError("Error with pLst","Need PARAMETER: cWhatDo, pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO,nID_Detail, pWO_Detail" ,"StockLst_Process.Init",LINENO(1) )
		ENDIF
		
		************
		DO CASE
		CASE pTBL = "StockLst" OR pTBL = "S"
			ThisForm.txtLst.Value = "StockLst"
			ThisForm.cTBL		= "S"
		CASE pTBL = "BrokerLst" OR pTBL = "B"
			ThisForm.txtLst.Value = "BrokerLst"
			ThisForm.cTBL		= "B"
		CASE pTBL = "WIpTBL" OR pTBL = "W"
			ThisForm.txtLst.Value = "WIpTBL"
			ThisForm.cTBL		= "W"
		OTHERWISE
			TrackError("Did not get a TBL parameter"," TBL:"+ThisForm.cTBL ,"StockLst_Process:Init ",LINENO(1))
			RETURN
		ENDCASE
		
		ThisForm.Visible = .T.
		***********************
		PRIVATE nID_D_P, nID_Detail
		nID_D_P		= PrepareSQLnum(pID_D_P,'ID_Detail_Process',-3)
		ThisForm.ID_Detail_Process = nID_D_P
		ThisForm.ID_Detail_process1.Value = nID_D_P
		
		nID_Detail	= PrepareSQLnum(pID_Detail,'ID_Detail',-3)
		ThisForm.ID_Detail = nID_Detail 
		ThisForm.txtID_Detail.Value = nID_Detail
		
		DO CASE
		CASE ThisForm.WhatDo = "ADD_WOD"
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		CASE ThisForm.WhatDo == "ADD_WO"
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		CASE ThisForm.WhatDo = "ADD_SOLD" &&Came from StockLst_SQL_Quotes 
			ThisForm.SOitem1.Value = PrepareSQLtxt(pSOItem,'SOitem',10)
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		CASE ThisForm.WhatDo == "ADD" 
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		***********************
		* End of Add
		***********************
		CASE ThisForm.WhatDo == "EDIT_WOD" 
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		CASE ThisForm.WhatDo == "EDIT_WO" 
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		CASE ThisForm.WhatDo == "EDIT" OR ThisForm.WhatDo = "DELETE"
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		CASE ThisForm.WhatDo = "QUOTE"
			ThisForm.txtInqNumP.Value	= Proper_InqNumP(pInqNumP)
			ThisForm.cInqNumP			= Proper_InqNumP(pInqNumP)
			ThisForm.ShowID_Detail( ThisForm.ID_Detail ) &&txtAlloy
		
		CASE ThisForm.WhatDo == "SHOW" 
			ThisForm.ShowID_Detail( nID_Detail ) &&txtAlloy
		
		OTHERWISE
			*CASE ThisForm.WhatDo == "DELETE"
			ThisForm.ID_Detail = 0
			ThisForm.txtID_Detail.Value = 0
			ThisForm.ID_Detail_Process = 0
			ThisForm.ID_Detail_Process1.Value = 0
			
			TrackError("Did not get a WhatDo parameter"," WhatDo='"+ShowSQLtxt(ThisForm.WhatDo,'WhatDo',100)+"'","StockLst_Process:Init ",LINENO(1))
		
		ENDCASE
		
		*********************************
		* WorkOrder
		PRIVATE nWO, nWO_Detail
		nWO = PrepareSQLnum(pWO,'WO',-3)
		ThisForm.nWO = nWO
		nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
		ThisForm.nWO_Detail = nWO_Detail
		
		IF nWO > 0
			ThisForm.nWO = nWO
			ThisForm.txtWO.Value 		= nWO
			ThisForm.txtWO.Visible 		= .T.
			ThisForm.lblWO.Visible 		= .T.
			ThisForm.chkAllowSub.Value	= 0
			ThisForm.chkAllowSub.Enabled = .F.
		ENDIF
		IF nWO_Detail> 0
			ThisForm.txtWO_Detail.Value	  = nWO_Detail
			ThisForm.txtWO_Detail.Visible = .T.
			ThisForm.lblWO_Detail.Visible = .T.
		ENDIF
		
		*********************************
		IF VARTYPE(pPoItem) = "C"
			IF Proper_PO_item(pPoItem) = Proper_PO_item('')
				ThisForm.POitem = Proper_PO_item('')
			ELSE
				ThisForm.PO_Item1.Value = PrepareSQLtxt(pPoItem,'POItem',12)
				ThisForm.PO_Item1.Visible = .T.
				ThisForm.lblPO_Item.Visible = .T.
				ThisForm.POitem = PrepareSQLtxt(pPOitem,'POitem',12)
			ENDIF
		ELSE
			pPoItem = ''
			ThisForm.POitem = Proper_PO_item('')
		ENDIF
		
		*********************************
		PRIVATE cComment
		cComment = ShowSQLtxt(pComment,'Comment',-1)
		
		*********************************
		DO CASE
		CASE ThisForm.WhatDo == "ADD_SOLD"
			ThisForm.SoldMemVar(pSOItem, pSalesP, pSalesDate, pLBS, pQTY, cComment, pShipDue, pPoItem)
			ThisForm.cmdSave.Caption = "Save"
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
		CASE ThisForm.WhatDo == "ADD_WOD"
			ThisForm.GetByWO_Detail(.F.,pSOItem)	&&if SOItem exists this method needs to know
			ThisForm.cmdSave.Caption = "Save"
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
		CASE ThisForm.WhatDo == "ADD_WO"
			ThisForm.GetByWO(.F.,pSOItem)	&&if SOItem exists this method needs to know
			ThisForm.cmdSave.Caption = "Save"
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
		CASE ThisForm.WhatDo == "ADD" 
			ThisForm.InitMemVar()
			ThisForm.cmdSave.Caption = "Save"
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
			
		***********************************
		* Last of the Adds, now Get_ID_D_P
		***********************************
		CASE ThisForm.WhatDo == "EDIT_WO"
			ThisForm.Get_ID_D_P()
			IF nWO > 0
				ThisForm.GetByWO(.T.,nWO)
				ThisForm.cmdSave.Caption = "Save"
			ENDIF
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
		CASE ThisForm.WhatDo == "EDIT_WOD"
			ThisForm.Get_ID_D_P()
			IF nWO_Detail > 0
				ThisForm.GetByWO_Detail(.T.,nWO_Detail)
				ThisForm.cmdSave.Caption = "Save"
			ENDIF
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
		CASE ThisForm.WhatDo == "EDIT"
			ThisForm.Get_ID_D_P()
			ThisForm.cmdSave.Caption = "Save"
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
		CASE ThisForm.WhatDo == "SHOW"
			ThisForm.Get_ID_D_P()
			ThisForm.cmdSave.Caption = "Show"
			ThisForm.cmdSave.Visible = .F.
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
		CASE ThisForm.WhatDo == "QUOTE"
			ThisForm.cmdSave.Caption = "Save"
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
			ThisForm.GetByInqNumP()	&&txtAlloy
		
		CASE ThisForm.WhatDo == "DELETE"
			ThisForm.Get_ID_D_P()
			ThisForm.InitDelete()
			ThisForm.Caption = ThisForm.Caption +" - "+ThisForm.WhatDo
			
		OTHERWISE
			ThisForm.Caption = ThisForm.Caption +" - Did not understand the What Parameter"
			TrackError("Did not understand the What Parameter","Did not understand the What Parameter", PROGRAM(), LINENO(1))
		ENDCASE
		
		ThisForm.Show_Order_Process()
		
		*ThisForm.SumProcess()
		*ThisForm.cmdReport.Visible = .T.
		
		********************************************
		PRIVATE dDueDate
		dDueDate= PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate')
		IF EMPTY( dDueDate )
			IF ThisForm.nWO > 0 
				*Get DueDate for WO
				ThisForm.GetWO_DueDate()
			ENDIF
			IF Proper_SO_item(pSOitem) <> Proper_SO_item('')
				*Get DueDate for WO
				ThisForm.GetSO_DueDate(pSOitem)
			ENDIF
		ENDIF
		********************
		*Make sure Order Number are Visible
		ThisForm.OrderNumVis()
		*IF ThisForm.WhatDo == "EDIT"
			*Force All Visible to Edit
		*ENDIF
		***********************
		
		********************
		*IF ThisForm.ID_Detail_Process > 0 
		IF LEN(ThisForm.cTBL)>0
			*Shows Prc if original recording did not have.
			ThisForm.Init_Prc_Data()
		ENDIF
		
		ThisForm.Form_Check('')
		
		ThisForm.Calc_QTY()
		*Calls:ThisForm.SumProcess()
		
		*ThisForm.SalesPerson1.SetFocus()
		ThisForm.Prc_Pcs.SetFocus()
	ENDPROC

	PROCEDURE initdelete
		*InitDelete()
		ThisForm.cmdSave.Caption = "Delete"
		ThisForm.cmdSave.BackColor = RGB(255,128,128)
		ThisForm.lblDeleteProcess.Visible = .T.
		
		ThisForm.SOitem1.Enabled	= .F.
		ThisForm.PO_item1.Enabled	= .F.
		ThisForm.SalesPerson1.Enabled	= .F.
		ThisForm.StartDate1.Enabled	= .F.
		ThisForm.DueDate1.Enabled	= .F.
		
		ThisForm.chkAllowSub.Enabled	= .F.
		ThisForm.S_PU.Enabled		= .F.
		ThisForm.Process_id1.Enabled	= .F.
		ThisForm.Processor1.Enabled	= .F.
		ThisForm.Comment1.Enabled	= .F.
	ENDPROC

	PROCEDURE initmemvar
		*InitMemVar
		ThisForm.ID_Detail_Process1.Value = 0
		ThisForm.txtLst.Value 		= ''
		ThisForm.txtID_Detail.Value = 0
		ThisForm.SOitem1.Value		= SPACE(10)
		ThisForm.PO_item1.Value		= SPACE(12)
		ThisForm.txtWO.Value 		= ThisForm.nWO
		ThisForm.txtWO_Detail.Value	= ThisForm.nWO_Detail
		ThisForm.txtInqNumP.Value	= ThisForm.cInqNumP
		
		ThisForm.SalesPerson1.Value = SPACE(20)
		ThisForm.StartDate1.Value	= DATETIME()
		ThisForm.DueDate1.Value		= CTOD("  /  /  ")
		
		ThisForm.txtAlloy.Value = ''
		ThisForm.txtSPecs.Value = ''
		ThisForm.txtHeat.Value = ''
		ThisForm.Process_id1.Value	= SPACE(10)
		ThisForm.Processor1.Value	= SPACE(20)
		ThisForm.S_PU.Value		 = 0
		ThisForm.Prc_Form.Value	 = ''
		
		ThisForm.D_Pcs.Value = 0
		ThisForm.D_Descript.Value = ''
		
		ThisForm.Prc_Pcs.Value = 0
		ThisForm.Prc_Dim1.Value = 0
		ThisForm.Prc_Dim2.Value = 0
		ThisForm.Prc_Dim3.Value = 0
		ThisForm.chkAllowSub.Value = 1
		
		ThisForm.P_QTY1.Value		= 0
		ThisForm.Stk_M_QTY.Value 	= 0
		ThisForm.D_QTY1.Value		= 0
		ThisForm.Sel_QTY1.Value		= 0
		
		ThisForm.Diff_QTY1.Value	= 0
		
		ThisForm.O_QTY1.Value		= 0
		ThisForm.TO_QTY1.Value		= 0
		ThisForm.Processed_QTY.Value = 0
		Thisform.Need_QTY.Value 	= 0
		
		ThisForm.Comment1.Value		= SPACE(100)
		
		 
	ENDPROC

	PROCEDURE init_prc_data		&& Init_Prc_Data
		*ThisForm.Init_Prc_Data()
		*Adding a Prc
		
		IF NOT (ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W")
			RETURN .F.
		ENDIF 
		
		PRIVATE nS_PU 
		nS_PU = PrepareSQLnum(ThisForm.S_PU.Value,'PU',-1)
		IF nS_PU = 0
			IF ThisForm.ID_Detail > 0
				nS_PU = getPUfromID_Detail(ThisForm.ID_Detail,ThisForm.cTBL,ThisForm.nConnHandle)
				ThisForm.S_PU.Value			= PrepareSQLtxt(nS_PU,'S_PU',1)
			ENDIF
		ENDIF	
		
		PRIVATE cPrc_Form, nPrc_Pcs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim
		PRIVATE nPounds, nPrc_P, nReceivingID, nPU
		PRIVATE cSQL, nSQLEXEC
		
		PRIVATE nP_QTY, nO_QTY, nO_P
		nP_QTY	= PrepareSQLnum(ThisForm.P_QTY1.Value,'QTY',9,1)
		nO_QTY	= 0
		nO_P	= 0	&&Ordered Price
		nPrc_P	= 0
		
		IF ThisForm.ID_Detail_Process > 0
			*Should already exist:
			*ThisForm.WhatDo = "EDIT_WO"
			*ThisForm.WhatDo== "EDIT"
			*ThisForm.WhatDo = "SHOW"
			*ThisForm.WhatDo = "DELETE"
			
			*cSQL = "SELECT P.QTY, P.Prc_QTY, P.Prc_Form, P.Prc_Pcs, P.Prc_Dim1, P.Prc_Dim2, P.Prc_Dim3, P.QTY_Due, P.ReceivingID, P.Pounds "
			cSQL = "SELECT P.* "&&.PU, P.QTY, P.Pounds, P.Ordered_QTY, P.ReceivingID, P.Prc_Form, P.Prc_Pcs, P.Prc_Dim1, P.Prc_Dim2, P.Prc_Dim3"
			*---, P.QTY_Due  "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL + " FROM dbo.StockLst_Process P "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			ENDCASE	
			
			cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(ThisForm.ID_Detail_Process)
		
			IF USED("tmpEditLst_Process")
				USE IN tmpEditLst_Process
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEditLst_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEditLst_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEditLst_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEditLst_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpEditLst_Process')
			ELSE
				IF USED("tmpEditLst_Process")
					*USE nO_QTY for Complete Order QTY for the Process
					nPU			= PrepareSQLnum(tmpEditLst_Process.PU,'PU',1)
					nP_QTY		= PrepareSQLnum(tmpEditLst_Process.QTY,'QTY',9,1)
					nO_QTY		= PrepareSQLnum(tmpEditLst_Process.Ordered_QTY,'QTY',9,1)
					nO_P		= PrepareSQLnum(tmpEditLst_Process.Ordered_P,'S_P',-5)
					nPounds		= PrepareSQLnum(tmpEditLst_Process.Pounds,'Pounds',9,1)
					*nPrc_P		= PrepareSQLnum(tmpEditLst_Process.Ordered_P,'S_P',-5)
					
					nReceivingID= PrepareSQLnum(tmpEditLst_Process.ReceivingID,'ReceivingID',-3)
					
					cPrc_Form	= PrepareSQLtxt(tmpEditLst_Process.Prc_Form,'Form',2)
					nPrc_Pcs	= PrepareSQLnum(tmpEditLst_Process.Prc_Pcs, 'Pieces',-3)
					nPrc_Dim1	= PrepareSQLnum(tmpEditLst_Process.Prc_Dim1,'Dim1',-5)
					nPrc_Dim2	= PrepareSQLnum(tmpEditLst_Process.Prc_Dim2,'Dim2',-5)
					nPrc_Dim3	= PrepareSQLnum(tmpEditLst_Process.Prc_Dim3,'Dim3',-5)		
					
		*			IF ThisForm.WhatDo = "QUOTE"
		*				*ThisForm.S_QTY1.Value		= nO_QTY
		*				ThisForm.lblOrder_QTY.Caption = "Quoted QTY"
		*			ELSE
		*				ThisForm.S_QTY1.Value		= nO_QTY
		*			ENDIF
					
					ThisForm.P_QTY1.Value	= nP_QTY
					ThisForm.P_Pounds.Value	= nPounds
					*ThisForm.Prc_P.Value	= 0
					*nReceiveID
					
					ThisForm.Prc_Form.Value	= cPrc_Form
					ThisForm.Prc_Pcs.Value	= nPrc_Pcs
					ThisForm.Prc_Dim1.Value	= nPrc_Dim1
					ThisForm.Prc_Dim2.Value	= nPrc_Dim2
					ThisForm.Prc_Dim3.Value	= nPrc_Dim3
					
					IF NOT EMPTY(cPrc_Form)
						ThisForm.RefreshForm(cPrc_Form)
					ENDIF
					
					IF nPU > 0
						ThisForm.S_PU.Value	= PrepareSQLtxt(nPU,'S_PU',1)
					ENDIF
					
					IF nReceivingID > 0
						*Do not Update Received Stock ???
					ENDIF
				ENDIF	
			ENDIF
		
			IF USED("tmpEditLst_Process")
				USE IN tmpEditLst_Process
			ENDIF
			
		ELSE	&&ID_Detail_Process = 0
		
			*get FROM SO or WO
			cSQL = ''
			*Should be:
			*CASE ThisForm.WhatDo = "ADD_SOLD"
			*CASE ThisForm.WhatDo = "ADD_WO"
			*CASE ThisForm.WhatDo == "ADD"
			PRIVATE cSOitem, cPOitem, nWO, nWO_Detail, cUse
			cSOitem		= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
			cPOitem 	= PrepareSQLtxt(ThisForm.PO_Item1.Value,'POItem',12)
		*	nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		*	nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
			
			DO CASE
			CASE ThisForm.nWO_Detail > 0
				cUse = "WOD"
				cSQL = "SELECT fWeight AS P_QTY, fPieces AS Prc_Pcs, fThck AS Prc_Dim1, fSz2 AS Prc_Dim2, [fSz3] AS Prc_Dim3"
				cSQL = cSQL + ", fWeight AS Ordered_QTY, 0 AS Ordered_P, fWeight AS Pounds" 
				cSQL = cSQL + ",fReceivingID AS ReceivingID WITH(NOLOCK) "
				cSQL = cSQL + ",fForm AS [Form], dbo.f_GetFormPU(fForm) AS PU "
				cSQL = cSQL + " FROM dbo.WorkOrder_Detail"
				cSQL = cSQL + " WHERE WO_Detail="+STR(ThisForm.nWO_Detail)
			CASE ThisForm.nWO > 0
				cUse = "WO"
				cSQL = "SELECT sWeight AS P_QTY, sPieces AS Prc_Pcs, sThck AS Prc_Dim1, sSz2 AS Prc_Dim2, sSz3 AS Prc_Dim3"
				cSQL = cSQL + ", sWeight AS Ordered_QTY, 0 AS Ordered_P, sWeight AS Pounds"
				cSQL = cSQL + ",sReceivingID AS ReceivingID "
				cSQL = cSQL + ",sForm AS Prc_Form, dbo.f_GetFormPU(sForm) AS PU "
				cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE WO="+STR(ThisForm.nWO)
			CASE cPOitem <> Proper_PO_item('')
				cUse = "PO"
				cSQL = "SELECT ISNULL(StockLst_QTY,Order_QTY) AS P_QTY, Pieces AS Prc_Pcs, [Thck] AS Prc_Dim1, Sz2 AS Prc_Dim2, Sz3 AS Prc_Dim3"
				cSQL = cSQL + ", StockLst_QTY AS Ordered_QTY, StockLst_P AS Ordered_P, Pounds AS Pounds "
				cSQL = cSQL + ",( CASE Reconciled WHEN 0 THEN 1 WHEN 1 THEN 0 END ) AS ReceivingID  "
				cSQL = cSQL + ",[Form] AS Prc_Form, dbo.f_GetFormPU(Form) AS PU "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			CASE cSOitem <> Proper_SO_item('')
				cUse = "SO"
				cSQL = "SELECT ISNULL(S_QTY,0) AS P_QTY, Pieces AS Prc_Pcs, [Thck] AS Prc_Dim1, Sz2 AS Prc_Dim2, Sz3 AS Prc_Dim3"
				cSQL = cSQL + ", S_QTY AS Ordered_QTY, S_P AS Ordered_P, [Weight] AS Pounds "
				cSQL = cSQL + ",(SELECT ISNULL(Cmplt,0) FROM dbo.Sales WITH(NOLOCK) WHERE SOitem = AllQuotes.SOitem) AS ReceivingID "
				cSQL = cSQL + ",[Form] AS Prc_Form, Q_PU AS PU "
				cSQL = cSQL + " FROM dbo.AllQuotes "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			*CASE LEN(ThisForm.cInqNumP) > 2
			CASE LEN(ALLTRIM(ThisForm.cInqNumP)) > 2
				cUse = "Quotes"
				cSQL = "SELECT ISNULL(S_QTY,0) AS P_QTY "
				cSQL = cSQL + ", Pieces AS Prc_Pcs "
				cSQL = cSQL + ", [Thck] AS Prc_Dim1 "
				cSQL = cSQL + ", Sz2 AS Prc_Dim2 "
				cSQL = cSQL + ", Sz3 AS Prc_Dim3 "
				cSQL = cSQL + ", S_QTY AS Ordered_QTY "
				cSQL = cSQL + ", S_P AS Ordered_P "
				cSQL = cSQL + ", [Weight] AS Pounds "
				cSQL = cSQL + ",0 AS ReceivingID  "
				cSQL = cSQL + ",[Form] AS Prc_Form "
				cSQL = cSQL + ", S_PU AS PU "
				cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL = cSQL + " WHERE InqNumP = '"+Proper_InqNumP(ThisForm.cInqNumP)+"'"
				
			OTHERWISE
				PRIVATE cMess 
				cMess =         "No Order number found!"+CHR(10)+CHR(13)
				cMess = cMess + " SOitem: '"+cSOitem+"'"+CHR(10)+CHR(13)
				cMess = cMess + " POitem: '"+cPOitem+"'"+CHR(10)+CHR(13)
				cMess = cMess + "     WO: "+ALLTRIM(STR(ThisForm.nWO))+CHR(10)+CHR(13)
				cMess = cMess + "    WOD: "+ALLTRIM(STR(ThisForm.nWO_Detail))+CHR(10)+CHR(13)
				cMess = cMess + "InqNumP: '"+Proper_InqNumP(ThisForm.cInqNumP)+"'"+CHR(10)+CHR(13)
				
				cMess = cMess +CHR(10)+CHR(13)+"TBL: "+ThisForm.cTBL+CHR(13)+"ID_Detail: "+STR(ThisForm.ID_Detail)+CHR(13)
				cMess = cMess +"ID_Detail_Process: "+STR(ThisForm.ID_Detail_Process)+CHR(10)+CHR(13)
				cMess = cMess +" What:"+ThisForm.WhatDo+CHR(10)+CHR(13)
				cMess = cMess +"Could not INIT!"
				
				TrackError(cMess ,"Cannot get P_QTY ","StockLst_Process.Init_Prc_Data()",LINENO(1))
				MESSAGEBOX("Could not get Data.",0,"Cannot Continue")
				ThisForm.Release
				
			ENDCASE
			
			IF USED("tmpPrc_Process")
				USE IN tmpPrc_Process
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPrc_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPrc_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPrc_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPrc_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPrc_Process')
			ELSE
				IF USED("tmpPrc_Process")
					
					nPU			= GetPUfromForm(tmpPrc_Process.Prc_Form,ThisForm.nConnHandle)
					nP_QTY		= PrepareSQLnum(tmpPrc_Process.P_QTY,'QTY',9,1)
					nO_QTY		= PrepareSQLnum(tmpPrc_Process.Ordered_QTY,'QTY',9,1)
					nO_P		= PrepareSQLnum(tmpPrc_Process.Ordered_P,'S_P',-5)
					nPounds		= PrepareSQLnum(tmpPrc_Process.Pounds,'Pounds',9,1)
					*nPrc_P		= PrepareSQLnum(tmpPrc_Process.Prc_P,'S_P',-5)
					
					nReceivingID	= PrepareSQLnum(tmpPrc_Process.ReceivingID,'ReceivingID',-3)
					
					cPrc_Form	= PrepareSQLtxt(tmpPrc_Process.Prc_Form,'Form',2)
					nPrc_Pcs	= PrepareSQLnum(tmpPrc_Process.Prc_Pcs,'Pieces',-3)
					nPrc_Dim1	= PrepareSQLnum(tmpPrc_Process.Prc_Dim1,'Dim1',-5)
					nPrc_Dim2	= PrepareSQLnum(tmpPrc_Process.Prc_Dim2,'Dim2',-5)
					nPrc_Dim3	= PrepareSQLnum(tmpPrc_Process.Prc_Dim3,'Dim3',-5)
					
					IF NOT EMPTY(cPrc_Form)
						ThisForm.RefreshForm(cPrc_Form)
					ENDIF
					*********************************************
					IF ThisForm.nWO > 0
						*USE WO to find Stock $P of starting material
						*nO_P = 
					ENDIF
					
					ThisForm.P_QTY1.Value	= nP_QTY
					ThisForm.P_Pounds.Value	= nPounds
					*ThisForm.Prc_P.Value	= nPrc_P
					
					ThisForm.O_QTY1.Value	= nO_QTY
					ThisForm.O_Pounds.Value	= nPounds
					ThisForm.Order_P.Value	= nO_P
					
					ThisForm.Prc_Form.Value	= cPrc_Form
					ThisForm.Prc_Pcs.Value	= nPrc_Pcs
					ThisForm.Prc_Dim1.Value	= nPrc_Dim1
					ThisForm.Prc_Dim2.Value	= nPrc_Dim2
					ThisForm.Prc_Dim3.Value	= nPrc_Dim3
		
					
					IF NOT EMPTY(cPrc_Form)
						ThisForm.RefreshForm(cPrc_Form)
					ENDIF
		
					
					IF nPU > 0
						ThisForm.S_PU.Value	= PrepareSQLtxt(nPU,'S_PU',1)
					ENDIF
					
					IF nReceivingID > 0
						*Do not Update Received Stock ???
					ENDIF
		
				ENDIF
			ENDIF
		
			IF USED("tmpPrc_Process")
				USE IN tmpPrc_Process
			ENDIF
		ENDIF
		
		PRIVATE nID_Detail
		nID_Detail = PrepareSQLnum(ThisForm.ID_Detail,'ID_Detail',-3)
		IF nP_QTY = 0 OR ThisForm.WhatDo = "QUOTE"  &&No Acct Process QTY
			*Last try, use the ID_Detail info as the FULL Process
			
			nID_Detail = PrepareSQLnum(ThisForm.ID_Detail,'ID_Detail',-3)
			IF nID_Detail = 0
				nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
				ThisForm.ID_Detail = nID_Detail
			ENDIF
			IF nID_Detail > 0
				cSQL = "SELECT D.S_PU, D.S_QTY AS QTY, D.Weight, D.ReceivingID, D.S_QTY AS Ordered_QTY, M.Form AS Prc_Form"
				cSQL = cSQL + ", D.PC AS Prc_PCs, D.Dim1 AS Prc_Dim1, D.Dim2 AS Prc_Dim2, D.Dim3 AS Prc_Dim3, D.S_P "
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Detail D "
		 			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Detail D "
		 			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
				CASE ThisForm.cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Detail D "
		 			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
				ENDCASE
				
				cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
		
				IF USED("tmpEditLst_Process")
					USE IN tmpEditLst_Process
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEditLst_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEditLst_Process')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEditLst_Process")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEditLst_Process")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpEditLst_Process')
				ELSE
					IF USED("tmpEditLst_Process")
						
						IF ThisForm.WhatDo = "QUOTE"
							ThisForm.lblOrder_QTY.Caption = "Quoted QTY"
							*nO_QTY						= PrepareSQLnum(tmpEditLst_Process.Ordered_QTY,'QTY',9,1)
							*ThisForm.QTY1.Value		= nO_QTY	&&Do not Change
							nP_QTY					= PrepareSQLnum(tmpEditLst_Process.QTY,'QTY',9,1)
							ThisForm.P_QTY1.Value	= nP_QTY
						ELSE
							nPU			= GetPUfromForm(tmpEditLst_Process.Prc_Form,ThisForm.nConnHandle)
							nP_QTY		= PrepareSQLnum(tmpEditLst_Process.QTY,'QTY',9,1)
							nO_QTY		= PrepareSQLnum(tmpEditLst_Process.Ordered_QTY,'QTY',9,1)
							nPounds		= PrepareSQLnum(tmpEditLst_Process.Weight,'Pounds',9,1)	
									
							nReceivingID= PrepareSQLnum(tmpEditLst_Process.ReceivingID,'ReceivingID',-3)
							
							cPrc_Form	= PrepareSQLtxt(tmpEditLst_Process.Prc_Form,'Form',2)
							nPrc_Pcs	= PrepareSQLnum(tmpEditLst_Process.Prc_Pcs,'Pieces',-3)
							nPrc_Dim1	= PrepareSQLnum(tmpEditLst_Process.Prc_Dim1,'Dim1',-5)
							nPrc_Dim2	= PrepareSQLnum(tmpEditLst_Process.Prc_Dim2,'Dim2',-5)
							nPrc_Dim3	= PrepareSQLnum(tmpEditLst_Process.Prc_Dim3,'Dim3',-5)		
							
							ThisForm.P_QTY1.Value	= nP_QTY
							ThisForm.P_Pounds.Value	= nPounds
							ThisForm.O_QTY1.Value	= nO_QTY
							ThisForm.O_Pounds.Value	= nO_QTY
							
							ThisForm.Prc_Form.Value	= cPrc_Form
							ThisForm.Prc_Pcs.Value	= nPrc_Pcs
							ThisForm.Prc_Dim1.Value	= nPrc_Dim1
							ThisForm.Prc_Dim2.Value	= nPrc_Dim2
							ThisForm.Prc_Dim3.Value	= nPrc_Dim3
							
							IF NOT EMPTY(cPrc_Form)
								ThisForm.RefreshForm(cPrc_Form)
							ENDIF
							
						ENDIF
						
						IF nPU > 0
							ThisForm.S_PU.Value	= PrepareSQLtxt(nPU,'S_PU',1)
						ENDIF
						
						IF nReceivingID > 0
							
						ENDIF
		
					ENDIF
				ENDIF
			ELSE
				PRIVATE cMess
				cMess = "Did not initialize Prc data"+CHR(13)+"Trying to use the ID_Detail info to fill Process"+CHR(13)
				cMess = cMess +"nP_QTY = 0 and nID_Detail is 0 "+CHR(13)
				cMess = cMess +" What:"+ThisForm.WhatDo+CHR(13)
				TrackError(cMess, "Did not initialize Prc data", PROGRAM(),LINENO(1))
			ENDIF
		
		ENDIF
		
		IF nID_Detail > 0
			PRIVATE nID, mS_QTY 
			nID = GetIDfromID_Detail(nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
			ThisForm.nID = nID
			mS_QTY  = Calc_Master_QTY(nID, ThisForm.cTBL, ThisForm.nConnHandle)
			ThisForm.Stk_M_QTY.Value = ROUND(mS_QTY ,0)
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\PROC_QUOTES ADDITIVE
		ENDIF
		
	ENDPROC

	PROCEDURE ordernumvis
		*ThisForm.OrderNumVis()
		
		PRIVATE lWDEdit
		lWDEdit = IIF(ThisForm.WhatDo == "EDIT",.T.,.F.)
		*Used at end of code.
		
		***********************
		IF PrepareSQLnum(ThisForm.ID_Detail_Process,'ID_Detail_Process',-3) > 0
			ThisForm.ID_Detail_Process1.Value = ThisForm.ID_Detail_Process
			ThisForm.ID_Detail_Process1.Visible = .T.
			ThisForm.lblID_Detail_Process.Visible = .T.
		ELSE
			IF PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3) > 0
				ThisForm.ID_Detail_Process = ThisForm.ID_Detail_Process1.Value
				ThisForm.ID_Detail_Process1.Visible = .T.
				ThisForm.lblID_Detail_Process.Visible = .T.
			ENDIF
		ENDIF
		
		***********************
		IF PrepareSQLnum(ThisForm.ID_Detail,'ID_Detail',-3) > 0
			ThisForm.txtID_Detail.Value	= ThisForm.ID_Detail
			ThisForm.txtID_Detail.Visible = .T.
			ThisForm.lblID_Detail.Visible = .T.
		ELSE
			IF PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3) > 0
				ThisForm.ID_Detail = ThisForm.txtID_Detail.Value
				ThisForm.txtID_Detail.Visible = .T.
				ThisForm.lblID_Detail.Visible = .T.
			ENDIF
		ENDIF
		
		***********************
		IF Proper_SO_item(ThisForm.SOitem1.Value) <> Proper_SO_item('')
			ThisForm.SOitem1.Visible = .T.
			ThisForm.lblSOITEM1.Visible = .T.
		ENDIF
		
		***********************
		IF Proper_PO_item(ThisForm.PO_item1.Value) <> Proper_PO_item('')
			ThisForm.PO_item1.Visible = .T.
			ThisForm.lblPO_Item.Visible = .T.
		ENDIF
		
		***********************
		IF PrepareSQLnum(ThisForm.nWO,'WO',-3) > 0
			ThisForm.lblWO.Visible = .T.
			ThisForm.txtWO.Visible = .T.
		ENDIF
		
		***********************
		IF PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3) > 0
			ThisForm.lblWO_Detail.Visible = .T.
			ThisForm.txtWO_Detail.Visible = .T.
		ENDIF
		
		***********************
		IF LEN(Proper_InqNumP(ThisForm.cInqNumP))> 2
		
			ThisForm.lblInqNumP.Visible = .T.
			ThisForm.txtInqNumP.Visible = .T.
			
		ENDIF
		
		IF lWDEdit 
			
			ThisForm.SOitem1.Visible = .T.
			ThisForm.lblSOITEM1.Visible = .T.
			
			ThisForm.lblWO.Visible = .T.
			ThisForm.txtWO.Visible = .T.
			
			ThisForm.lblWO_Detail.Visible = .T.
			ThisForm.txtWO_Detail.Visible = .T.
		ENDIF
	ENDPROC

	PROCEDURE refreshform		&& Places Form Description Captions
		PARAMETERS pForm
		*ThisForm.RefreshForms()
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		*pForm = PrepareSQLtxt(Quotes.Form,'Form',2)
			
		IF NOT EMPTY(pForm) OR LEN(pForm) > 0
			IF GetFormCaptions(pForm,ThisForm.nConnHandle)
				IF USED('tmpFormCaptions')
					ThisForm.LBLTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.LBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
					ThisForm.LBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
					ThisForm.LBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisForm.LBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
					ThisForm.Prc_Dim3.Visible 	= tmpFormCaptions.use3rdDim
					ThisForm.Prc_Dim3.Enabled 	= tmpFormCaptions.Sz3Enable
					ThisForm.LBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
					ThisForm.LBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
					
					USE IN tmpFormCaptions
				ELSE
					TrackMess( "tmpFormCaptions is not used!")
					TrackError("Table tmpFormCaptions is not open!","tmpFormCaptions is not used!", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
		*			TrackError("GetFormCaptions returned False!"+CHR(13)+"Table tmpFormCaptions is not open!","tmpFormCaptions is not used!", PROGRAM(), LINENO(1))
		*			TrackMess("GetFormCaptions returned False!")
			ENDIF
		ELSE
		*		TrackError("GetFormCaptions did not have a Form!"+CHR(13)+"Table tmpFormCaptions is not open!","tmpFormCaptions is not used!", PROGRAM(), LINENO(1))
				TrackMess("GetFormCaptions did not have a Form!")
		ENDIF
		
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE saveprocess
		*ThisForm.SaveProcess()
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE cSOitem, cPOitem, cSalesPerson
		PRIVATE dtStartDate, dDueDate, nS_P, lAllowSub
		PRIVATE nP_QTY, cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		PRIVATE nPrc_Q_PU, nPrc_Q_QTY
		PRIVATE nS_PU, cProcess_ID, cProcessor, cComment
		PRIVATE cAllowSub
		
		cSOitem		= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		cPOitem 	= PrepareSQLtxt(ThisForm.PO_Item1.Value,'POItem',12)
		cSalesPerson= PrepareSQLtxt(ThisForm.SalesPerson1.Value,'SalesPerson',20)
		
		dtStartDate = PrepareSQLdateTime(ThisForm.StartDate1.Value,'StartDate', .F.,.T.)
		dDueDate 	= PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate', .F.,.T.)
		nPounds		= PrepareSQLnum(ThisForm.O_Pounds.Value,'Pounds',9,1)
		lAllowSub 	= PrepareSQLlogic(ThisForm.chkAllowSub.Value,'AllowSub',.T.)
		
		*USE nOrdered_QTY for Complete Order and P_QTY for the Process QTY
		PRIVATE nOrdered_QTY, nOrdered_P
		nOrdered_QTY = PrepareSQLnum(ThisForm.O_QTY1.Value,'StockLst_QTY',9,1)
		nOrdered_P	= PrepareSQLnum(ThisForm.Order_P.Value,'StockLst_P',-5)
		
		nP_QTY	= PrepareSQLnum(ThisForm.P_QTY1.Value,'QTY',9,1)
		
		PRIVATE nWO, nWO_Detail, cInqNumP
		ThisForm.nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO 		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		ThisForm.nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nWO_Detail		= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		cInqNumP	= Proper_InqNumP(ThisForm.txtInqNumP.Value) &&SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		
		cSOitem		= Proper_SO_Item(cSOitem)
		cPOitem		= Proper_PO_Item(cPOitem)
		
		IF EMPTY(ThisForm.cTBL)
			ThisForm.cTBL = PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1)
		ENDIF
		
		PRIVATE cMess
		cMess = "WO: "+ALLTRIM(STR(ThisForm.nWO))+" "
		cMess = cMess + " WO_Detail: "+ALLTRIM(STR(ThisForm.nWO_Detail))+" "
		cMess = cMess + " SOitem: "+ALLTRIM(cSOitem)+" "
		cMess = cMess + " POitem: "+ALLTRIM(cPOitem)+" "
		IF LEN(cInqNumP) > 2
			cMess = cMess + "InqNumP: '"+cInqNumP+"'"
		ENDIF
		cMess = cMess + " TBL: "+ThisForm.cTBL+" "
		
		nS_PU		= PrepareSQLnum(ThisForm.S_PU.Value,'StockLst_PU',-1)
		cProcess_ID = PrepareSQLtxt(ThisForm.PROCESS_ID1.Value,'Process_ID',10)
		cProcessor	= PrepareSQLtxt(ThisForm.PROCESSOR1.Value,'Processor',20)
		cComment	= PrepareSQLtxt(ThisForm.Comment1.Value,'Comment',100)
		cAllowSub 	= IIF(lAllowSub,'Y','N')  &&Char(1)
		
		cPrc_Form	= PrepareSQLtxt(ThisForm.Prc_Form.Value,'Form',2)
		nPrc_PCs	= PrepareSQLnum(ThisForm.Prc_PCs.Value,'PCs',-3)
		
		nPrc_Dim1	= PrepareSQLnum(ThisForm.Prc_Dim1.Value,'Dim1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisForm.Prc_Dim2.Value,'Dim2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisForm.Prc_Dim3.Value,'Dim3',9,3)
		
		*Do not use when form does not need!
		IF NOT ThisForm.Prc_Dim3.Visible
			nPrc_Dim3 = 0
		ENDIF
		******************************
		** test
		
		IF nP_QTY= 0
			RecordTest('Record Test Data.', "StockLst_Process.SaveProcess()", LineNo(1), "nP_QTY = 0 "+CHR(13)+cMess+CHR(13)+"nQTY="+ALLTRIM(STR(nOrdered_QTY )) )
		ENDIF
		
		IF ThisForm.WhatDo = "QUOTE"
			nPrc_Q_PU	= nS_PU
			nPrc_Q_QTY	= PrepareSQLnum(ThisForm.O_QTY1.Value,'S_QTY',9,1)
		ELSE
			nPrc_Q_PU	= 0
			nPrc_Q_QTY	= 0
		ENDIF
		
		PRIVATE lInsert
		lInsert = .F.
		
		PRIVATE nID_Detail_Process 
		nID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		
		nTran = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		*nTran = SQLROLLBACK(ThisForm.nConnHandle)
		*nTran = SQLCOMMIT(ThisForm.nConnHandle)
		*nTran = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
		IF nID_Detail_Process = 0
			lInsert = .T.
			
			*cProcess_ID = "SELECTED"
			
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
			cSQLi = cSQLi + " @TBL = '"+ThisForm.cTBL+"'"
			cSQLi = cSQLi + ",@ID_Detail ="+STR(ThisForm.ID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		
			cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
		
			cSQLi = cSQLi + ",@PU	= "+STR(nS_PU)
			cSQLi = cSQLi + ",@QTY	= "+STR(nP_QTY,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
		
			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
			cSQLi = cSQLi + ",@WO 	= "+STR(ThisForm.nWO)
			cSQLi = cSQLi + ",@WO_Detail= "+STR(ThisForm.nWO_Detail)	
			
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
			cSQLi = cSQLi + ",@ReceivingID ="+STR(0)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nOrdered_QTY,18,4)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(nOrdered_P,18,4)
		
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC dbo.p_Lst_Process_ins ","p_Lst_Process_ins "+CHR(13)+cSQLi,"StockLst_Process.SaveProcess()",LINENO(1))
				lOK = .F.
			ELSE
				IF USED("tmpID_Detail_Process")
					IF RECCOUNT('tmpID_Detail_Process') > 0
						ThisForm.ID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.exp,'ID_Detail_Process',-3)
						nID_Detail_Process = ThisForm.ID_Detail_Process
						IF nID_Detail_Process = 0
							lOK = .F.
						ENDIF
					ELSE 
						lOK = .F.
					ENDIF
				ELSE 
					lOK = .F.
				ENDIF
				USE IN tmpID_Detail_Process
			ENDIF
		ENDIF	
		******************************
		IF ThisForm.cTBL='S' OR ThisForm.cTBL='B' OR ThisForm.cTBL='W'
			*good
		ELSE 
			*Write Error
			TrackError("Do not have cTBL value."+CHR(13)+"checked for ThisForm.cTBL='S' OR ThisForm.cTBL='B' OR ThisForm.cTBL='W'","No cTBL", PROGRAM(), LINENO(1))
		ENDIF
		******************************
		IF NOT lOK 
			nTran = SQLROLLBACK(ThisForm.nConnHandle)
			nTran = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
			
			MESSAGEBOX("Save Failed"+CHR(13)+"Cannot Continue!",0+16,"SQL Error")
			TrackError("Could not EXEC dbo.p_Lst_Process_ins","p_Lst_Process_ins"+CHR(13)+cSQLi,"StockLst_Process.cmdSave()",LINENO(1))
			RETURN .F.
		ENDIF
		
		******************************
		IF nID_Detail_Process = 0
			nTran = SQLROLLBACK(ThisForm.nConnHandle)
			nTran = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
			
			MESSAGEBOX("No ID_Detail_Process to Update"+CHR(13)+"Cannot Continue!",0+16,"Error")
			TrackError("No ID_Detail_Process to Update","No ID_Detail_Process to Update","StockLst_Process.cmdSave()",LINENO(1))
			RETURN .F.
		ENDIF
		
		******************************
		*Check for existing nID_Detail_Process 
		
		IF USED('cntLst')
			USE IN cntLst
		ENDIF
		
		SELECT 0
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "B"
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "W"
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntLst')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntLst')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntLst")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntLst")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'cntLst')
		ENDIF 
		
		IF USED('cntLst')
			IF RECCOUNT('cntLst') > 0
				lOK = .T.
			ELSE
				lOK = .F.
			ENDIF
			USE IN cntLst
		ELSE
			lOK = .F.
		ENDIF
		
		******************************
		IF NOT lOK 
			nTran = SQLROLLBACK(ThisForm.nConnHandle)
			nTran = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
			
			MESSAGEBOX("Save Failed"+CHR(13)+"Cannot Continue!",0+16,"SQL Error")
			TrackError("Could not find ID_Detail_Process to Update","No ID_Detail_Process to Update"+CHR(13)+"ID_Detail_Process"+STR(ThisForm.ID_Detail_Process)+CHR(13)+"TBL "+ThisForm.cTBL ,"StockLst_Process.cmdSave()",LINENO(1))
			RETURN .F.
		ENDIF
		
		******************************
					
		*Now have record to update
		
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = "UPDATE dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = "UPDATE dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = "UPDATE dbo.WIPLst_Process "
		ENDCASE
		
		cSQL = cSQL+ " SET SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL+ ",PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL+ ",SalesPerson='"+cSalesPerson+"'"
		cSQL = cSQL+ ",StartDate='"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"
		cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		cSQL = cSQL+ ",Comment='"+cComment+"'"
		cSQL = cSQL+ ",Process_ID='"+cProcess_id+"'"
		cSQL = cSQL+ ",Processor='"+cProcessor+"'"
		cSQL = cSQL+ ",AllowSub='"+cAllowSub+"'"
		*pWeight, pPc, pFt, 
		cSQL = cSQL+ ",PU="+STR(nS_PU)+""
		cSQL = cSQL+ ",QTY="+STR(nP_QTY,18,4)+""
		cSQL = cSQL+ ",Pounds="+STR(nPounds,9,1)+""
		cSQL = cSQL+ ",ID_Detail="+STR(ThisForm.ID_Detail)
		
		cSQL = cSQL+ ",WO="+STR(ThisForm.nWO)+""
		cSQL = cSQL+ ",WO_Detail="+STR(ThisForm.nWO_Detail)+""
		
		cSQL = cSQL+ ",InqNumP='"+cInqNumP+"'"
		*Prc_QTY
		cSQL = cSQL+ ",Prc_Form='"+cPrc_Form+"'"
		cSQL = cSQL+ ",Prc_PCs="+STR(nPrc_PCs)+""
		cSQL = cSQL+ ",Prc_Dim1="+STR(nPrc_Dim1,10,4)+""
		cSQL = cSQL+ ",Prc_Dim2="+STR(nPrc_Dim2,8,3)+""
		cSQL = cSQL+ ",Prc_Dim3="+STR(nPrc_Dim3,8,3)+""
		cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			lOK = .F.
		ENDIF
		
		******************************
		IF NOT lOK 
			nTran = SQLROLLBACK(ThisForm.nConnHandle)
			nTran = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
			
			MESSAGEBOX("Update Failed"+CHR(13)+"Cannot Continue!",0+16,"SQL Error")
			TrackError("Update Lst_Process Failed",cSQL ,"StockLst_Process.cmdSave()",LINENO(1))
			RETURN .F.
		ENDIF
		
		******************************
				
		IF ThisForm.nWO > 0
			PRIVATE cMess
			*** caution, cMess is parsed in rtr as Oper_Note
			DO CASE
			CASE ThisForm.cTBL = "S"
				cMess = "Select S Material Select "
			CASE ThisForm.cTBL = "B"
				cMess = "Select B Material Select "
			CASE ThisForm.cTBL = "W"
				cMess = "Select W Material Select "
			OTHERWISE 
				cMess=''
			ENDCASE
			
		*	IF ThisForm.nWO > 0
				*lOK = set_rtr_Detail_Oper('WO', ThisForm.nWO, 100, 523, cMess+'ID_Detail_Process='+ALLTRIM(STR(nID_Detail_Process)),.T.,ThisForm.nConnHandle)
				set_rtr_Detail_Oper('WO', ThisForm.nWO, 100, 523, cMess+' ID_Detail_Process='+STR(nID_Detail_Process)+' ID_Detail='+ALLTRIM(STR(ThisForm.ID_Detail)) ,.T. ,ThisForm.nConnHandle)
				*set_rtr_Oper('WO', ThisForm.nWO, 100, 523, cMess+' ID_Detail='+ALLTRIM(STR(nID_Detail)) ,.T. ,ThisForm.nConnHandle)
				*ThisForm.ID_Detail
		*	ENDIF
			
		ENDIF
		
		******************************
		IF ThisForm.nWO_Detail > 0
			IF ThisForm.cTBL='S' OR ThisForm.cTBL='B' OR ThisForm.cTBL='W'
				lOK = Update_WOD_Set_TBL_IDDP(nWO_Detail, ThisForm.cTBL, nID_Detail_Process,ThisForm.nConnHandle )
			ENDIF
		ENDIF
		
		******************************
				
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
			IF ThisForm.cTBL='S' OR ThisForm.cTBL='B' OR ThisForm.cTBL='W'
				lOK = Update_PurchaseOrder_Set_TBL_IDDP(cPOitem, ThisForm.cTBL, nID_Detail_Process, ThisForm.nConnHandle )
			ENDIF
		ENDIF
		
		******************************
				
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('') AND NOT EMPTY(ThisForm.cTBL)
			
		**	lOK = Update_PurchaseOrder_Set_TBL_IDDP(ThisForm.cTBL, nID_Detail_Process,ThisForm.nConnHandle )
		
			PRIVATE cMess
			DO CASE &&*** caution, cMess is parsed in rtr as Oper_Note
			CASE ThisForm.cTBL = "S"
				cMess = "Select S Material Select "
			CASE ThisForm.cTBL = "B"
				cMess = "Select B Material Select "
			CASE ThisForm.cTBL = "W"
				cMess = "Select W Material Select "
		*		cMess = "Select Material Process W "
			OTHERWISE 
				cMess=''
			ENDCASE
			
		*	IF ThisForm.nWO > 0
				*lOK = set_rtr_Detail_Oper('WO', ThisForm.nWO, 100, 523, cMess+'ID_Detail_Process='+ALLTRIM(STR(nID_Detail_Process)),.T.,ThisForm.nConnHandle)
				set_rtr_Detail_Oper('SOi', cSOitem, 100, 523, cMess+' ID_Detail_Process='+STR(nID_Detail_Process)+' ID_Detail='+ALLTRIM(STR(ThisForm.ID_Detail)) ,.T. ,ThisForm.nConnHandle)
				*set_rtr_Oper('SOi', cSOitem, 100, 523, cMess+' ID_Detail='+ALLTRIM(STR(nID_Detail)) ,.T. ,ThisForm.nConnHandle)
				*ThisForm.ID_Detail
		*	ENDIF
			
		ENDIF
		
		******************************
		
		nTran = SQLCOMMIT(ThisForm.nConnHandle)
		nTran = SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
		RETURN lOK
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE Show
		LPARAMETERS nStyle
	ENDPROC

	PROCEDURE showid_detail		&& was ShowStockLst_Detail
		PARAMETER pnID_Detail
		*ThisForm.ShowID_Detail( nID )
		
		*********************************************
		
		IF TYPE("pnID_Detail") != "N"
			RETURN .F.
		ENDIF
		
		IF USED("tmpStockLstD")
			USE IN tmpStockLstD
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT M.Alloy,M.Form,M.Specs,M.Heat, D.*"
		cSQL = cSQL + ",dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1,D.Dim2,D.Dim3,D.[Weight],D.RandLen) AS DescriptCL"
		cSQL = cSQL + ",D.Dim1,D.Dim2,D.Dim3 "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail D "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail D"
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Detail D"
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
		OTHERWISE
			TrackError("Did not get a TBL"," TBL:"+ThisForm.cTBL,"StockLst_Process:ShowID_Detail",LINENO(1) )
		ENDCASE
		
		cSQL = cSQL + " WHERE D.ID_Detail = "+STR(pnID_Detail)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstD')
		ELSE
			IF USED("tmpStockLstD")
			 	IF RECCOUNT("tmpStockLstD") > 0
					ThisForm.txtAlloy.Value		= ShowSQLtxt(tmpStockLstD.Alloy,'Alloy',12)
					ThisForm.txtSpecs.Value		= ShowSQLtxt(tmpStockLstD.Specs,'Specs',160)
					ThisForm.txtHeat.Value		= ShowSQLtxt(tmpStockLstD.Heat,'Heat',50)
			*		ThisForm.txtDescript.Value	= ShowSQLtxt(tmpStockLstD.Descript,'Descript',100)
					ThisForm.S_PU.Value			= GetPUfromForm(tmpStockLstD.Form,ThisForm.nConnHandle)
		
					ThisForm.txtAlloy.Visible	= .T.
					ThisForm.txtSpecs.Visible	= .T.
					ThisForm.txtHeat.Visible	= .T.
			*		ThisForm.txtDescript.Visible	= .T.
				
					ThisForm.lblAlloy.Visible	= .T.
					ThisForm.lblSpecs.Visible	= .T.
					ThisForm.lblHeat.Visible	= .T.	
					
					ThisForm.D_PCs.Value		= PrepareSQLnum(tmpStockLstD.PC,'PC',-3)
					ThisForm.D_Descript.Value	= ShowSQLtxt(tmpStockLstD.DescriptCL,'DescriptCL',100)
					ThisForm.D_Descript.Value	= ALLTRIM(ThisForm.D_Descript.Value)+"  :"+STR(PrepareSQLnum(tmpStockLstD.S_QTY,'S_QTY',9,1))
					ThisForm.D_Descript.Value	= ALLTRIM(ThisForm.D_Descript.Value)+" "+Get_Label_from_nPU(PrepareSQLnum(tmpStockLstD.S_PU,'S_PU',1))+" Qty "
					
					ThisForm.D_QTY1.Value		= PrepareSQLnum(tmpStockLstD.S_QTY,'S_QTY',9,1)
					ThisForm.D_Pounds.Value		= PrepareSQLnum(tmpStockLstD.Weight,'Weight',9,1)
					ThisForm.Detail_P.Value		= PrepareSQLnum(tmpStockLstD.S_P,'S_P',-5)
		
					ThisForm.txtDim1.Value	= PrepareSQLnum(tmpStockLstD.Dim1,'Dim1',9,4)
					ThisForm.txtDim2.Value	= PrepareSQLnum(tmpStockLstD.Dim2,'Dim2',8,3)
					ThisForm.txtDim3.Value	= PrepareSQLnum(tmpStockLstD.Dim3,'Dim3',8,3)
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpStockLstD")
			USE IN tmpStockLstD
		ENDIF
		
		*********************************************
		
		ThisForm.Show_SelPrc()
		
	ENDPROC

	PROCEDURE show_order_process
		*ThisForm.Show_Order_Process()
		*Collect all process for this Order
		
		ThisForm.grd_Order_Process.RecordSource = ''
		ThisForm.TO_QTY1.Value = 0
		
		IF USED("tmpOrder_Process")
			USE IN tmpOrder_Process
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		
		PRIVATE cInqNumP
		*ThisForm.WhatDo = "QUOTE"
		cInqNumP = PrepareSQLtxt(ThisForm.cInqNumP,'InqNumP',9)
		
		PRIVATE nWO
		nWO = PrepareSQLnum(ThisForm.nWO,'WO',-3)
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cSQL, cSQL1, cSQL2 &&        1                   2       3    4     5          6             7
		cSQL1 = "SELECT CAST(QTY AS INT) AS QTY, [AllowSub] AS [Sub], SOitem, WO, DueDate, ID_Detail, 0 AS [Grab] "
		cSQL2 = "SELECT CAST(QTY AS INT) AS QTY, [AllowSub] AS [Sub], SOitem, WO, DueDate, ID_Detail, 1 AS [Grab] "
		
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL1 = cSQL1 + " FROM dbo.StockLst_Process "
			cSQL2 = cSQL2  +" FROM dbo.StockLst_Process_Grab "
		CASE ThisForm.cTBL = "B"
			cSQL1 = cSQL1 + " FROM dbo.BrokerLst_Process "
			cSQL2 = cSQL2  +" FROM dbo.BrokerLst_Process_Grab "
		CASE ThisForm.cTBL = "W"
			cSQL1 = cSQL1 + " FROM dbo.WIPLst_Process "
			cSQL2 = cSQL2  +" FROM dbo.WIPLst_Process_Grab "
		OTHERWISE
			TrackError("Did not get a TBL"," TBL:"+ThisForm.cTBL,"StockLst_Process:ShowID_Detail",LINENO(1) )
		ENDCASE
		
		PRIVATE	lSQLwhere, lSQLand
		lSQLwhere = .F.
		lSQLand = .F.
		
		*MESSAGEBOX(ThisForm.WhatDo,0,'WhatDo')
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			IF NOT lSQLwhere
				cSQL1 = cSQL1 + " WHERE "
				cSQL2 = cSQL2 + " WHERE "
				lSQLwhere = .T.
				lSQLand = .T.
			ELSE
				IF lSQLand
					cSQL1 = cSQL1 + " AND "
					cSQL2 = cSQL2 + " AND "
				ELSE 
					lSQLand = .T.
				ENDIF
			ENDIF
			cSQL1 = cSQL1 + " SOitem = '"+cSOitem+"'"
			cSQL2 = cSQL2 + " SOitem = '"+cSOitem+"'"
		ENDIF
		
		IF LEN(Proper_InqNumP(cInqNumP)) > 0
			IF NOT lSQLwhere
				cSQL1 = cSQL1 + " WHERE "
				lSQLwhere = .T.
				lSQLand = .T.
			ELSE
				IF lSQLand
					cSQL1 = cSQL1 + " AND "
				ELSE 
					lSQLand = .T.
				ENDIF
			ENDIF
			cSQL1 = cSQL1 + " InqNumP = '"+cInqNumP+"'"
		ENDIF
		
		IF nWO_Detail > 0
			IF NOT lSQLwhere
				cSQL1 = cSQL1 + " WHERE "
				lSQLwhere = .T.
				lSQLand = .T.
			ELSE
				IF lSQLand
					cSQL1 = cSQL1 + " AND "
					cSQL2 = cSQL2 + " AND "
				ELSE 
					lSQLand = .T.
				ENDIF
			ENDIF
			cSQL1 = cSQL1 + " WO_Detail = "+STR(nWO_Detail)
		ELSE
			**run only if WO_Detail is empty
			IF nWO > 0
				IF NOT lSQLwhere
					cSQL1 = cSQL1 + " WHERE "
					cSQL2 = cSQL2 + " WHERE "
					lSQLwhere = .T.
					lSQLand = .T.
				ELSE
					IF lSQLand
						cSQL1 = cSQL1 + " AND "
						cSQL2 = cSQL2 + " AND "
					ELSE 
						lSQLand = .T.
					ENDIF
				ENDIF
				cSQL1 = cSQL1 + " WO = "+STR(nWO)
				cSQL2 = cSQL2 + " WO = "+STR(nWO)
			ENDIF
		ENDIF
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('') OR ( nWO_Detail = 0 AND nWO > 0 )
			cSQL = cSQL1 + " UNION " + cSQL2
		ELSE
			cSQL = cSQL1
		ENDIF
		
		
		* and not the SO/WO listed here?
		IF lSQLwhere 
			*Found atleast 1
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrder_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrder_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrder_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrder_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOrder_Process')
			ELSE
				IF USED("tmpOrder_Process")
					PRIVATE nSel_QTY
					SET TALK OFF
					*SUM QTY TO nSel_QTY FOR ID_Detail<>ThisForm.ID_Detail
					SUM QTY TO nSel_QTY  
					ThisForm.TO_QTY1.Value = ROUND(nSel_QTY,0)
					SUM QTY TO nProcessed_QTY FOR Grab=1
					ThisForm.Processed_QTY.Value = ROUND(nProcessed_QTY,0)
					
					ThisForm.lblOrderTotNeed.Visible = .T.
					ThisForm.TO_QTY1.Visible = .T.
					ThisForm.lblProcessed_QTY.Visible = .T.
					ThisForm.Processed_QTY.Visible = .T.
					ThisForm.lblOrderProcess.Visible = .T.
					ThisForm.grd_Order_Process.Visible = .T.
					
					GO TOP
		
					ThisForm.grd_Order_Process.RecordSource = 'tmpOrder_Process'
					
					ThisForm.grd_Order_Process.column1.DynamicBackColor = "IIF(tmpOrder_Process.Grab=0, RGB(250,255,125), RGB(0,0,255))"
					ThisForm.grd_Order_Process.column2.DynamicBackColor = "ThisForm.BackColor_grd_Show_Order()"
					ThisForm.grd_Order_Process.column3.DynamicBackColor = "ThisForm.BackColor_grd_Show_Order()"
					ThisForm.grd_Order_Process.column4.DynamicBackColor = "ThisForm.BackColor_grd_Show_Order()"
					ThisForm.grd_Order_Process.column5.DynamicBackColor = "ThisForm.BackColor_grd_Show_Order()"
					ThisForm.grd_Order_Process.column6.DynamicBackColor = "ThisForm.BackColor_grd_Show_Order()"
					
					ThisForm.grd_Order_Process.Refresh
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT USED("tmpOrder_Process")
		*	ThisForm.lblOrder_QTY.Visible = .F.
		*	ThisForm.O_QTY1.Visible = .F.
			ThisForm.lblOrderTotNeed.Visible = .F.
			ThisForm.TO_QTY1.Visible = .F.
			ThisForm.lblProcessed_QTY.Visible = .F.
			ThisForm.Processed_QTY.Visible = .F.
			
			ThisForm.lblOrderProcess.Visible = .F.
			ThisForm.grd_Order_Process.Visible = .F.
		ELSE
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				*Check Order_QTY for c
				PRIVATE nO_QTY
				nO_QTY = Get_QTYinSales(cSOItem, ThisForm.nConnHandle)
				ThisForm.O_QTY1.Value		= nO_QTY
			ENDIF
			IF nWO > 0
				*Check Order_QTY for c
				PRIVATE nWO_QTY
				nWO_QTY = Get_QTYinWO(nWO, ThisForm.nConnHandle)
				ThisForm.O_QTY1.Value		= nWO_QTY
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE show_selprc
		*ThisForm.Show_SelPrc()
		
		
		* ID_Detail SELECTED Process
		PRIVATE nID_D_P
		nID_D_P = PrepareSQLnum(ThisForm.ID_Detail_process1.Value,'ID_D_P',-3)
		
		ThisForm.grdSelPrc.RecordSource = ''
		ThisForm.Sel_QTY1.Value = 0
		
		
		
		
		IF USED("tmpSelPrc")
			USE IN tmpSelPrc
		ENDIF
		
		cSQL = "SELECT CAST(QTY AS INT) AS QTY, [AllowSub] AS [Sub], SOitem, WO, DueDate, ID_Detail, 0 AS [Grab] "
		
		cSQL = cSQL + ""
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
		OTHERWISE
			TrackError("Did not get a TBL"," TBL:"+ThisForm.cTBL,"StockLst_Process:ShowID_Detail",LINENO(1) )
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail = "+STR(pnID_Detail)
		cSQL = cSQL + " AND Process_ID = 'SELECTED'"
		
		* and not the PROCESS listed here?
		IF nID_D_P > 0
			cSQL = cSQL + " AND ID_Detail_Process != "+STR(nID_D_P)
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSelPrc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSelPrc')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSelPrc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSelPrc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSelPrc')
		ELSE
			IF USED("tmpSelPrc")
				PRIVATE nSel_QTY
				SET TALK OFF
				SUM QTY TO nSel_QTY
				GO TOP
				ThisForm.Sel_QTY1.Value = ROUND(nSel_QTY,0)
				ThisForm.grdSelPrc.RecordSource = 'tmpSelPrc'
				ThisForm.grdSelPrc.Refresh
				
				IF RECCOUNT('tmpSelPrc') > 0
					ThisForm.cmdConsume.Visible = .F.
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT USED("tmpSelPrc")
			ThisForm.lblSelectedProcess.Visible = .F.
			ThisForm.grdSelPrc.Visible = .F.
			ThisForm.Sel_QTY1.Visible = .F.
			ThisForm.lblMinus.Visible = .F.
			ThisForm.lblOtherSelQTY.Visible = .F.
			ThisForm.lblOSelected.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE soldmemvar
		PARAMETER pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pPoItem
		*ThisForm.SoldMemVar()
		*Add, fill with SOitem detail
		
		IF TYPE("pSOitem") = "C"
			IF Proper_PO_item(pSOitem) != Proper_PO_item('')
				ThisForm.SOitem1.Value = pSOitem
				ThisForm.SOITEM1.Enabled = .F.
				ThisForm.PO_ITEM1.Enabled = .F.
			ELSE
				ThisForm.SOitem1.Value = SPACE(10)
			ENDIF
		ELSE
			ThisForm.SOitem1.Value = SPACE(10)
		ENDIF
		
		IF TYPE("pSalesP") = "C"
			IF NOT EMPTY(pSalesP)
				ThisForm.SalesPerson1.Value = SalesPDescription(pSalesP,'')
			ELSE
				ThisForm.SalesPerson1.Value = SPACE(20)
			ENDIF
		ELSE
			ThisForm.SalesPerson1.Value = SPACE(20)
		ENDIF
		
		IF TYPE("pSalesDate") = "D"
			IF pSalesDate>CTOD("01/01/1900")
				ThisForm.StartDate1.Value = PrepareSQLdateTime(pSalesDate,'StartDate', .F.,.T.)
			ELSE
				ThisForm.StartDate1.Value = DATETIME()
			ENDIF
		ELSE
			IF TYPE("pSalesDate") = "T"
				IF pSalesDate>CTOD("01/01/1900")
					ThisForm.StartDate1.Value = TTOD(pSalesDate)
				ELSE
					ThisForm.StartDate1.Value = DATETIME()
				ENDIF
			ELSE
				ThisForm.StartDate1.Value= DATETIME()
			ENDIF
		ENDIF
		
		
		*****
		PRIVATE cDescript, nS_QTY
		cDescript = ''
		nS_QTY = 0
		
		***********
		*Get from Sales
		IF Proper_PO_item(pSOitem) != Proper_PO_item('')
			PRIVATE cSQL
			
			IF USED('tmpSales_SD')
				USE IN tmpSales_SD
			ENDIF
			SELECT 0
			
			cSQL = "SELECT dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS Descript "
			cSQL=cSQL+" ,S.ShipDue "
			cSQL=cSQL+" ,S.S_QTY "
			cSQL=cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
			cSQL=cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON AQ.SOitem = S.SOitem "
			cSQL=cSQL+" WHERE AQ.SOItem = dbo.f_ProperSOitem('"+pSOitem+"') "
		
		
			IF USED("tmpSales_SD")
				SELECT tmpSales_SD
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_SD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_SD')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_SD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_SD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle , nSQLEXEC, 'tmpSales_SD')
			ELSE
				IF USED("tmpSales_SD")
					IF RECCOUNT('tmpSales_SD') > 0
			*			ThisForm.txtDescript.Value	= PrepareSQLtxt(tmpSales_SD.Descript,'Descript',100)
						*ThisForm.Duedate1.Value	= PrepareSQLdate(tmpSales_SD.ShipDue,'ShipDue')
						pShipDue					= PrepareSQLdate(tmpSales_SD.ShipDue,'ShipDue')
						cDescript	= ShowSQLtxt(tmpSales_SD.Descript,'Descript',100)
						nS_QTY		= PrepareSQLnum(tmpSales_SD.S_QTY,'S_QTY',9,1)		&&Total for SOitem
					ENDIF
							
					USE IN tmpSales_SD
				ENDIF
			ENDIF
		ENDIF
		
		***********
		
		IF TYPE("pShipDue") = "D"
			IF pShipDue>CTOD("01/01/1900")
				ThisForm.DueDate1.Value = pShipDue
			ELSE
				*Find in Sales
				ThisForm.DueDate1.Value = CTOD("  /  /  ")
			ENDIF
		ELSE
			IF TYPE("pShipDue") = "T"
				IF pShipDue>CTOD("01/01/1900")
					ThisForm.DueDate1.Value = TTOD(pShipDue)
				ELSE
					*Find in Sales
					ThisForm.DueDate1.Value = CTOD("  /  /  ")
				ENDIF
			ELSE
				ThisForm.DueDate1.Value = CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		
		ThisForm.chkAllowSub.Value = 1
		
		PRIVATE nLBS, nQTY
		nLBS	= PrepareSQLnum(pLBS,'Pounds',9,1)
		nQTY	= PrepareSQLnum(pQTY,'QTY',9,1)
		
		IF nQTY = 0 AND nS_QTY > 0
			nQTY = nS_QTY
		ENDIF
		
		*ThisForm.P_Qty1.Value = 
		*ThisForm.P_Pounds.Value = 
		*ThisForm.O_QTY1.Value = nOrder_QTY 		&&ERP Acct Standard QTY total for Sale
		*ThisForm.O_Pounds.Value = nLBS
		
		
		***********
		*Get from Purchase
		
		IF TYPE("pPOitem") = "C"
			IF Proper_PO_Item(pPOitem) <> Proper_PO_Item('')
				ThisForm.PO_Item1.Value = pPOitem
				ThisForm.PO_Item1.Visible = .T.
				ThisForm.lblPO_Item.Visible = .T.
				
				ThisForm.GetFromPOitem(pPOitem)
			ELSE
				ThisForm.PO_Item1.Visible = .F.
				ThisForm.PO_Item1.Value = SPACE(11)
			ENDIF
		ELSE
			ThisForm.PO_Item1.Value = SPACE(11)
			ThisForm.PO_Item1.Visible = .F.
		ENDIF
		
		
		*****
		ThisForm.Process_ID1.Value = "SELECTED"
		ThisForm.PROCESS_ID1.Enabled = .F.
		
		ThisForm.Processor1.Value = SPACE(20)
		ThisForm.PROCESSOR1.Enabled = .F.
		
		IF TYPE("pComment") = "C"
			IF NOT EMPTY(pComment)
				ThisForm.Comment1.Value = pComment
			ELSE
				ThisForm.Comment1.Value = ''
			ENDIF
		ELSE
			ThisForm.Comment1.Value = ''
		ENDIF
		
		m.ID_Detail_Process = 0
		ThisForm.ID_Detail_Process1.Value = 0
		
		IF EMPTY(ThisForm.SALESPERSON1.Value)
			PRIVATE cMach_User 
			cMach_User = SYS(0)
			ThisForm.SALESPERSON1.Value = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		ENDIF
	ENDPROC

	PROCEDURE sumprocess
		*ThisForm.SumProcess()
		
		PRIVATE nP_QTY, nD_QTY, nSel_QTY, nDiff_QTY, nO_QTY, nTO_QTY
		nP_QTY		= PrepareSQLnum(ThisForm.P_QTY1.Value,'QTY',9,1)
		nD_QTY		= PrepareSQLnum(ThisForm.D_QTY1.Value,'QTY',9,1)
		nSel_QTY	= PrepareSQLnum(ThisForm.Sel_QTY1.Value,'QTY',9,1)
		*nDiff_QTY	= PrepareSQLnum(ThisForm.Diff_QTY1.Value,'QTY',9,1)
		*nO_QTY		= PrepareSQLnum(ThisForm.O_QTY1.Value,'QTY',9,1)
		*nTO_QTY		= PrepareSQLnum(ThisForm.TO_QTY1.Value,'QTY',9,1)
		
		nDiff_QTY = nD_QTY - nSel_QTY - nP_QTY
		ThisForm.Diff_QTY1.Value = PrepareSQLnum(nDiff_QTY,'QTY',9,1)
		
		IF nD_QTY < ( nSel_QTY + nP_QTY )
			ThisForm.Diff_QTY1.DisabledForeColor = RGB(255,0,0)  &&Red
			
			ThisForm.lblNotEnoughStk.Visible = .T.
			ThisForm.lblAvailableQTY.Visible = .F.
		ELSE
			ThisForm.Diff_QTY1.DisabledForeColor = RGB(255,220,30)  &&Blackish
			
			ThisForm.lblNotEnoughStk.Visible = .F.
			ThisForm.lblAvailableQTY.Visible = .T.
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
		RETURN ThisForm.ID_Detail_Process
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.ID_Detail_Process = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdCalcQTY.Click
		ThisForm.Calc_QTY()
		ThisForm.Form_Check('')
	ENDPROC

	PROCEDURE cmdConsume.Click
		*Replace Pounds,QTY,ItemSold comment with Detail numbers
		
		
		IF RECCOUNT('tmpSelPrc') > 0
			MESSAGEBOX("Detail has other Orders Selected"+CHR(13)+"You cannot take all of this!",0,"Cannot")
			RETURN .F.
		ENDIF
		
		PRIVATE nDetail_QTY
		nDetail_QTY = PrepareSQLnum(ThisForm.D_QTY1.Value,'Detail_QTY',9,1)	&&This Stock QTY
		ThisForm.P_QTY1.Value	= PrepareSQLnum(nDetail_QTY,'Detail_QTY',9,1)	
		
		*ThisForm.Prc_Form
		
		ThisForm.Prc_Dim1.Value = PrepareSQLnum(ThisForm.txtDim1.Value,'Dim1',9,4)
		ThisForm.Prc_Dim2.Value = PrepareSQLnum(ThisForm.txtDim2.Value,'Dim2',8,3)
		ThisForm.Prc_Dim3.Value = PrepareSQLnum(ThisForm.txtDim3.Value,'Dim3',8,3)
		
		*PRIVATE nPounds
		*nPounds = get_Pounds_ID_Detail(ThisForm.txtID_Detail.Value, ThisForm.cTBL, ThisForm.nConnHandle)
		*ThisForm.P_Pounds.Value = nPounds
		
		ThisForm.chkAllowSub.Value = 0
		
		PRIVATE cComment
		cComment = ALLTRIM(PrepareSQLtxt(ThisForm.Comment1.Value,'Comment',-1))
		cComment = IIF(LEN(cComment) > 0, cComment+CHR(13),cComment ) &&Add CHR(13)
		
		
		IF ThisForm.nWO > 0
			IF NOT "WO#"+ALLTRIM(STR(ThisForm.nWO)) $ cComment
				cComment = cComment+CHR(13)+"WO#"+ALLTRIM(STR(ThisForm.nWO))+" "
			ENDIF
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		IF NOT cSOItem = Proper_SO_item("")
			IF NOT "and SOi#"+ALLTRIM(cSOItem) $ cComment
				cComment = cComment +CHR(13)+ "and SOi#"+ALLTRIM(cSOItem)+" "
			ENDIF
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.PO_item1.Value,'POitem',12)
		IF NOT Proper_PO_Item(cPOItem) = Proper_PO_item("")
			IF NOT "and POi#"+ALLTRIM(cPOItem) $ cComment
				cComment = cComment +CHR(13)+ "and POi#"+ALLTRIM(cPOItem)+" "
			ENDIF
		ENDIF
		
		PRIVATE cDescription
		cDescription = get_Description_ID_Detail( ThisForm.ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle, .T. )
		*ThisForm.txtDescript.Value = cDescription
		IF NOT "for:" $ cComment
			cComment = LEFT( cComment+CHR(13)+"for:"+cDescription ,100)
		ENDIF
		
		ThisForm.Comment1.Value = cComment
		
		PRIVATE nSOiSelQTY
		IF Proper_SO_Item(cSOItem) = Proper_SO_item("")
			nSOiSelQTY = 0	
		ELSE
			nSOiSelQTY = nDetail_QTY
		ENDIF
		
		PRIVATE nWOS_QTY
		IF ThisForm.nWO > 0
			nWOS_QTY = nDetail_QTY
		ELSE
			nWOS_QTY = 0
		ENDIF
		
		PRIVATE nPartSelect_QTY 
		nPartSelect_QTY = get_PartialPick_QTY(cSOitem,ThisForm.nWO,ThisForm.nConnHandle)
		
		
		*ThisForm.SumProcess()
		******************************************************
		***This code also exists in SumProcess and cmdConsume
		
		PRIVATE nStockLst_QTY, nSOitemQTY, nID_DetailS_QTY
		nStockLst_QTY	= PrepareSQLnum(ThisForm.Stk_M_QTY.Value,'StockLst_QTY',9,1)
		*nSOitemQTY		= PrepareSQLnum(ThisForm.txtSOitemQTY.Value,'StockLst_QTY',9,1)
		*nWOQTY 			= PrepareSQLnum(ThisForm.txtWOQTY.Value,'StockLst_QTY',9,1)
		nID_DetailS_QTY	= PrepareSQLnum(ThisForm.D_QTY1.Value,'StockLst_QTY',9,1)
		
		*ThisForm.txtSOitemQTY.Value = nSOitemQTY
		*ThisForm.txtSOS_QTY.Value	= nSOiSelQTY
		*Thisform.txtWOQTY.Value 	= nWOQTY 
		
		*ThisForm.D_QTY1.Value = nID_DetailS_QTY	&&No change
		
		IF nID_DetailS_QTY > nStockLst_QTY
			ThisForm.D_QTY1.DisabledForeColor = RGB(255,0,0)
		ENDIF
		
		*ThisForm.txtPP_QTY.Value = nPartSelect_QTY 
		
		*nBalanceQTY = nID_DetailS_QTY - nSOiSelQTY - nWOS_QTY
		*ThisForm.txtBal_QTY.Value = nBalanceQTY
		*nStockLst_QTY - nSOitemQTY - nWOQTY - nWOS_QTY + nPartSelect_QTY + nSOiSelQTY
		
		ThisForm.SumProcess()
		
		WAIT WINDOW 'Ready to Save' NOWAIT
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE lOK
		lOK = .T.
		
		IF THIS.Caption = "Save"
			lOK = ThisForm.SaveProcess()
		ENDIF
		IF THIS.Caption = "Delete"
			lOK = ThisForm.DeleteProcess()
		ENDIF
			
		**Could not Delete		ThisForm.ID_Detail_process = -2
		*Deleted			ThisForm.ID_Detail_process = -3
		
		IF lOK 
			THISFORM.RELEASE
		ELSE
			WAIT WINDOW "Problem" NOWAIT 
		ENDIF
		
	ENDPROC

	PROCEDURE LBLDUEDATE1.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.DUEDATE1.Value)
			dDate1 = ThisForm.DUEDATE1.Value 
		ELSE
			dDate1 = DATE()
		ENDIF
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		ThisForm.AlwaysOnTop = .T.
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.DUEDATE1.Value = dDate2
	ENDPROC

