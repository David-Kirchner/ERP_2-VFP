	PROCEDURE cmdAbort.Click
		IF USED('DatePicker')
			ThisForm.dReturnDate = DatePicker.DatePick
			ThisForm.txtDate.Value = ThisForm.dReturnDate
			
			USE IN DatePicker
		*	IF NOT EMPTY(ThisForm.fnDatePick)
		*		IF FILE(SYS(5)+SYS(2003)+"\"+ThisForm.fnDatePick)
		*			DELETE FILE (SYS(5)+SYS(2003)+"\"+ThisForm.fnDatePick)
		*		ENDIF
		*		IF FILE(SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnDatePick )
		*			DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnDatePick)
		*		ENDIF
		*	ENDIF
		ENDIF
		
		
		*ThisForm.fnDatePick = ''
		
		
		*ThisForm.dReturnDate = ""
		
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdAddWeeks.Click
		PRIVATE nWeeks, dDatePicked, dReturnDate
		
		nWeeks = PrepareSQLnum(ThisForm.txtweeks.Value,'Weeks',-2)
		dDatePicked = PrepareSQLdate(ThisForm.txtDate.Value,'Date')
		
		IF nWeeks = 0
			MESSAGEBOX("Weeks number field is empty!",64,"Cannot Add Weeks to Date")
			RETURN .F.
		ENDIF
		
		PRIVATE nDays
		nDays = nWeeks * 7
		
		dReturnDate = dDatePicked + nDays
		ThisForm.txtDate.Value = dReturnDate 
		SELECT DatePicker
		REPLACE DatePick WITH dReturnDate 
	ENDPROC

	PROCEDURE cmdPickDate.Click
		#DEFINE C_CALCAPTION_LOC	"Data Calendar"
		oCalForm = Create('form')
		DO CASE
		CASE FILE(HOME()+"FFC\_datetime.vcx")
			oCalForm.NewObject("oleCalendar","_olecalendar",HOME()+"FFC\_datetime.vcx")
		CASE FILE("LIBS\"+"_datetime.vcx")
			oCalForm.NewObject("oleCalendar","_olecalendar","LIBS\"+"_datetime.vcx")
		CASE FILE("\LIBS\"+"_datetime.vcx")
			oCalForm.NewObject("oleCalendar","_olecalendar","\LIBS\"+"_datetime.vcx")
		ENDCASE
		
		IF NOT VARTYPE(oCalForm) = "O"
			MESSAGEBOX("Could not find Library",0,"Error")
		ENDIF
		*oCalForm.oleCalendar.date_column = M.dDatePick &&"employee.birth_date"
		oCalForm.oleCalendar.date_column = "DatePicker.DatePick"
		oCalForm.oleCalendar.RefreshDisplay()
		oCalForm.oleCalendar.BackColor = THISFORM.BackColor
		oCalForm.oleCalendar.Visible = .T.
		
		
		oCalForm.AutoCenter = .T.
		oCalForm.BorderStyle = 2
		oCalForm.MaxButton = .F.
		oCalForm.MinButton = .F.
		oCalForm.Height = oCalForm.oleCalendar.Height+1
		oCalForm.Width = oCalForm.oleCalendar.Width+1
		oCalForm.Caption = C_CALCAPTION_LOC
		
		
		ThisForm.Visible = .F.
		
		oCalForm.Show(1)
		
		ThisForm.Visible = .T.
		IF USED('DatePicker')
			ThisForm.txtDate.Value = DatePicker.DatePick 
		ENDIF
		
		THISFORM.Refresh
	ENDPROC

	PROCEDURE cmdResetDate.Click
		ThisForm.txtDate.Value = DATE()
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		IF USED('DatePicker')
			ThisForm.dReturnDate = DatePicker.DatePick
			ThisForm.txtDate.Value = ThisForm.dReturnDate
			
			USE IN DatePicker
		*	IF NOT EMPTY(ThisForm.fnDatePick)
		*		IF FILE(SYS(5)+SYS(2003)+"\"+ThisForm.fnDatePick)
		*			DELETE FILE (SYS(5)+SYS(2003)+"\"+ThisForm.fnDatePick)
		*		ENDIF
		*		IF FILE(SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnDatePick )
		*			DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnDatePick)
		*		ENDIF
		*	ENDIF
		ENDIF
		
		
		*ThisForm.fnDatePick = ''
		
		
		PRIVATE dReturnDate
		*PRIVATE nYear,nDay,nMonth
		
		dReturnDate	= ThisForm.txtDate.Value
		
		
		IF TYPE("dReturnDate") = "D"
			ThisForm.dReturnDate = dReturnDate
		ENDIF
		
		ThisForm.Release
		
	ENDPROC

ENDDEFINE
