		MaxLength = 4, ;
		Name = "txtweeks", ;
		TabIndex = 4, ;
		Top = 66, ;
		Value = 0, ;
		Width = 31
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		IF "VFPCALENDAR" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\VFPCALENDAR"
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pStartDate, pCaption, nTop, nLeft
		
		
		*DO FORM "forms\olecalendar.scx" WITH dDate1 TO dDate2
		*DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2  --used comCtl32.ocx!!!
		
		***********************************************
		*CREATE CURSOR curDATE (dDate D)
		*Insert Into curDATE Values (DATE())
		
		*ThisForm.fnDatePick = UniqDBF("DatePick")
		*ThisForm.fnDatePick = SYS(3)+".DBF"
		
		CREATE CURSOR DatePicker (DatePick D)
		
		*IF SYS(2003) $ "\MEM\"
		*	CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnDatePick) FREE (DatePick D)
		*	USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnDatePick) EXCL ALIAS DatePicker
		*ELSE
		*	CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnDatePick) FREE (DatePick D)
		*	USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnDatePick) EXCL ALIAS DatePicker
		*ENDIF
		
		PRIVATE dStartDate
		dStartDate = DATE()
		
		IF TYPE("pStartDate") = "D"
			IF pStartDate != CTOD('')
				dStartDate = pStartDate
			ENDIF
		ENDIF
		
		IF TYPE("pStartDate") = "T"
			IF pStartDate != CTOT('')
				dStartDate = TTOD(pStartDate)
			ENDIF
		ENDIF
		ThisForm.dReturnDate = dStartDate
		ThisForm.txtDate.Value = dStartDate
		SELECT DatePicker
		INSERT INTO DatePicker (DatePick) VALUES (dStartDate)
		
		IF VARTYPE(pCaption) = "C"
			This.Caption = pCaption
		ENDIF
		
		IF VARTYPE(nTop) = "N"
			ThisForm.Top = nTop
		ENDIF
		
		IF VARTYPE(nLeft) = "N"
			ThisForm.Left = nLeft
		ENDIF
		
		*!*	IF NOT "VFPCALENDAR" $ SET("CLASSLIB")
		*!*		SET CLASSLIB TO LIBS\VFPcalendar ADDITIVE
		*!*	ENDIF
		
		*!*	IF "VFPCALENDAR" $ SET("CLASSLIB")
		*!*		WAIT WINDOW "SET CLASSLIB TO LIBS\VFPcalendar ADDITIVE" NOWAIT
		*!*	ELSE
		*!*		MESSAGEBOX("SET CLASSLIB TO LIBS\VFPcalendar ADDITIVE",16,"Failed!")
		*!*	ENDIF
		
		*!*	ThisForm.Caldatepicker1.Value = dStartDate
		
		
	ENDPROC

	PROCEDURE Load
		*IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*	SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
