	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		ThisForm.Load_PackingSli(0)
		*ThisForm.Load_AcctCosting(0)
		
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
	ENDPROC

	PROCEDURE load_id_pslip
		*ThisForm.Load_ID_PSlip()
		
		PRIVATE nPackingSli
		nPackingSli = tmpPackingSli.PackingSli
		
		IF USED('tmpID_PSlip')
		
			USE IN tmpID_PSlip
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT PS.ID_PackingSlip"
		cSQL = cSQL + " ,PS.[PCs]"
		cSQL = cSQL + " ,PS.[Descript]"
		  
		cSQL = cSQL + " ,PS.[PO_Num]"
		cSQL = cSQL + " ,PS.[Heat]"
		cSQL = cSQL + " ,PS.[Weight]"
		cSQL = cSQL + " ,PS.[Kg]"
		cSQL = cSQL + " ,PS.[Alloy]"
		cSQL = cSQL + " ,PS.[PartNo]"
		   
		cSQL = cSQL + " ,PS.[Peach]"
		cSQL = cSQL + " ,PS.[Cancld]"
		cSQL = cSQL + " ,PS.[SOitem_cmplt]"
		cSQL = cSQL + " ,PS.[Reconciled]"
		cSQL = cSQL + " ,PS.[Sales_Detail_ID]"
		
		cSQL = cSQL + " ,PS.[WhenAdd]"
		cSQL = cSQL + " ,PS.[First_RSO]"&&	--Printed and Ready to Ship Out (RSO). 
		cSQL = cSQL + " ,PS.[PT_QTY]"&&		--ERP Acct Standardoung PriceTable QTY
		cSQL = cSQL + " ,PS.[SO_QTY]"&&		--Customer QTY
		cSQL = cSQL + " ,PS.[PT_P]"&&		--Filled in when reconciled.
		cSQL = cSQL + " ,PS.[PickedUp]"&&	--PackingSli and ID_PackingSlip has beed picked up
		
		cSQL = cSQL + " ,(SELECT TOP 1 Company FROM dbo.AllQuotes AQ WITH(NOLOCK) WHERE PS.SOitem = AQ.SOitem AND dbo.f_ProperSOitem(PS.SOitem) <> dbo.f_ProperSOitem('') ) as Customer "
		cSQL = cSQL + " ,(SELECT SalesRep FROM dbo.Sales_No WITH(NOLOCK) WHERE dbo.f_ProperSO( PS.SOitem ) = Sales_No.salesnum AND dbo.f_ProperSOitem(PS.SOitem) <> dbo.f_ProperSOitem('') ) as [SalesRep]"
		
		cSQL = cSQL + " ,(SELECT ShipDue FROM dbo.Sales WITH(NOLOCK) WHERE PS.SOitem = Sales.SOitem AND dbo.f_ProperSOitem(PS.SOitem) <> dbo.f_ProperSOitem('') ) as DueDate"
		cSQL = cSQL + " ,(SELECT ShipRoute FROM dbo.Sales_No WITH(NOLOCK) WHERE dbo.f_ProperSO( PS.SOitem ) = Sales_No.salesnum AND dbo.f_ProperSOitem(PS.SOitem) <> dbo.f_ProperSOitem('') ) as ShipRoute"
		cSQL = cSQL + " ,(SELECT Hold FROM dbo.Sales WITH(NOLOCK) WHERE PS.SOitem = Sales.SOitem AND dbo.f_ProperSOitem(PS.SOitem) <> dbo.f_ProperSOitem('') ) AS Hold "
			
		cSQL = cSQL + " FROM dbo.PackingSlip PS "
		cSQL = cSQL + " WHERE PS.PackingSli="+STR(nPackingSli)
		cSQL = cSQL + " AND PS.ID_PackingSlip > 147334 "
		cSQL = cSQL + " order by PS.ID_PackingSlip desc "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_PSlip')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_PSlip' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_PSlip')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_PSlip')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_PSlip' )
		ENDIF
		
		IF USED('tmpID_PSlip')
			IF RECCOUNT('tmpID_PSlip') > 0
				ThisForm.Refresh_ID_PSlip(tmpID_PSlip.ID_PackingSlip)
			ELSE
				ThisForm.Refresh_ID_PSlip(0)
			ENDIF
		ELSE
			ThisForm.Refresh_ID_PSlip(0)
		ENDIF
	ENDPROC

	PROCEDURE load_packingsli
		PARAMETERS nPackingSli
		*ThisForm.Load_PackingSli(0)
		
		IF USED('tmpPackingSli')
			ThisForm.grdPackingSli.RecordSource = ''
			USE IN tmpPackingSli
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT PSN.PackingSli "
		cSQL = cSQL + " FROM dbo.PackingSlip_No PSN "
		*cSQL = cSQL + " WHERE (PSN.PickUpDate IS NULL OR ( ISNULL(PSN.PW_Ready,0)=1 AND NOT ISNULL(PW.Verified,0)=0 ))"
		cSQL = cSQL + " WHERE (PSN.PickUpDate IS NULL OR ( ISNULL(PSN.PW_Ready,0)=1 AND NOT ISNULL(PSN.PW_verified,0)=0 )) "
		cSQL = cSQL + " AND PSN.PackingSli > 111070 "
		cSQL = cSQL + " order by Packingsli desc "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPackingSli')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPackingSli' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPackingSli')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPackingSli')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPackingSli' )
		ENDIF
		
		IF USED('tmpPackingSli')
			IF EOF('tmpPackingSli') 
				ThisForm.grdPackingSli.Visible = .F.
		*		ThisForm.pf1.pgCustContact.cmdNotes.Visible = .F.
		*		ThisForm.pf1.pgCustContact.cmdNotes.Caption = 'Add Note'  &&'Edit Notes'
			ELSE
				ThisForm.grdPackingSli.RecordSource = 'tmpPackingSli'
				ThisForm.grdPackingSli.Visible = .T.
		*		ThisForm.pf1.pgCustContact.cmdNotes.Visible = .T.
		*		ThisForm.pf1.pgCustContact.cmdNotes.Caption = 'Add Note'  &&'Edit Notes'
			ENDIF
		ENDIF
		
		ThisForm.Refresh_PackingSli()
		
	ENDPROC

