	PROCEDURE refresh_id_pslip
		PARAMETERS nID_PSlip
		*ThisForm.Refresh_id_pslip(nID_PSlip)
		
		IF USED('tmpID_PSlip') AND nID_PSlip>0
		
		*!*	[PCs]"
		*!*	[Descript]"
		*!*	  
		*!*	[PO_Num]"
		*!*	[Heat]"
		*!*	[Weight]"
		*!*	[Kg]"
		*!*	[Alloy]"
		*!*	[PartNo]"
		*!*	   
		*!*	[Peach]"
		*!*	"[Cancld]"
		*!*	[SOitem_cmplt]"
		*!*	Reconciled]"
		*!*	Sales_Detail_ID]"
		
		*!*	[WhenAdd]"
		*!*	[First_RSO]"&&	--Printed and Ready to Ship Out (RSO). 
		*!*	[PT_QTY]"&&		--ERP Acct Standardoung PriceTable QTY
		*!*	[SO_QTY]"&&		--Customer QTY
		*!*	[PT_P]"&&		--Filled in when reconciled.
		*!*	[PickedUp]"&&	--PackingSli has beed picked up
		
		*!*	AllQuotes.Company Customer 
		*!*	Sales_No.SalesRep"
		*!*	Sales_No.PD_Date"
		*!*	Sales.DueDate"
		*!*	Sales_No.ShipRoute"
		*!*	Sales.Hold "
		*!*		
		ELSE
		
		ENDIF
	ENDPROC

	PROCEDURE refresh_packingsli
		*ThisForm.Refresh_PackingSli
		
		PRIVATE nPackingSli
		nPackingSli = tmpPackingSli.PackingSli
		
		IF USED('tmpPSlip')
		
			USE IN tmpPSlip
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT 	PSN.TotalWeight "
		cSQL = cSQL + ",PSN.Carton "
		
		cSQL = cSQL + " ,'In Progress ' AS [Ship_Status]"
		*	, 1 AS [PackingSlip]
		cSQL = cSQL + " , 0 AS [Certs]"
		cSQL = cSQL + " , 0 AS [label_BOL]"
			
		cSQL = cSQL + " ,PSN.PackingSli"
		cSQL = cSQL + " ,PSN.PackedBy"
		cSQL = cSQL + " ,PSN.checkedby"
		cSQL = cSQL + " ,PSN.ShippedVia"
		cSQL = cSQL + " ,PSN.ShipFrom"
		cSQL = cSQL + " ,PSN.[tracking]"
		cSQL = cSQL + " ,PSN.Box_Size "
		cSQL = cSQL + " ,PSN.PackedWeight "
		cSQL = cSQL + " ,PSN.RSO_Date"
		cSQL = cSQL + " ,PSN.PickUpDate"
		cSQL = cSQL + " ,PSN.PW_Ready"
		cSQL = cSQL + " ,PSN.PW_Verified"
		cSQL = cSQL + " ,PSN.HoldReason"
		
		cSQL = cSQL + " FROM dbo.PackingSlip_No PSN "
		*cSQL = cSQL + " WHERE (PSN.PickUpDate IS NULL OR ( ISNULL(PSN.PW_Ready,0)=1 AND NOT ISNULL(PW.Verified,0)=0 ))"
		cSQL = cSQL + " WHERE (PSN.PickUpDate IS NULL OR ( ISNULL(PSN.PW_Ready,0)=1 AND NOT ISNULL(PSN.PW_verified,0)=0 )) "
		cSQL = cSQL + " AND PSN.PackingSli > 111070 "
		cSQL = cSQL + " order by Packingsli desc "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSlip')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPSlip' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSlip')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPSlip')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPSlip' )
		ENDIF
		
		IF USED('tmpPSlip')
			IF RECCOUNT('tmpPSlip')=0
		*		ThisForm.grdPackingSli.Visible = .F.
			ELSE
		*		ThisForm.grdPackingSli.RecordSource = 'tmpPSlip'
		*		ThisForm.grdPackingSli.Visible = .T.
			ENDIF
		ENDIF
		
		ThisForm.Load_ID_PSlip()
	ENDPROC

