	PROCEDURE Edit1.OLEDragDrop
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
		
		IF oDataObject.GETFORMAT( 1 )
			lc = oDataObject.GETDATA( 1)
		
			IF MEMLINES(lc) = 3 AND "Subject"$MLINE(lc,1)
				lo = CREATEOBJECT("outlook.application")
				loX = lo.ActiveExplorer
				loItem = loX.SELECTION.ITEM(1)
				** loItem is now a pointer to the mail item
				lcText = loItem.Body
		
				IF "From: " $ lcText
					lnFrom = AT('From: ',lcText, 1)
					lcBody = LEFT( lcText, lnFrom - 1 )	
				ELSE
					lcBody = ALLTRIM(lcText)
				ENDIF	
				
				
				
				This.Value = "-/\-"+CHR(10)+CHR(13)+lcBody+CHR(10)+CHR(13)+"-\/-"
			ENDIF
		
		ENDIF
		
	ENDPROC

	PROCEDURE Edit1.Valid
		lcSearchStr = ALLTRIM(THIS.VALUE)
		
		
		nLen = LEN(lcSearchStr)
		cSTR = ''
		
		FOR i = 1 TO nLen
			cSTR = cSTR + "-"+ALLTRIM(STR(ASC(SUBSTR(lcSearchStr,i,1))))+"-"
		
		NEXT i
		
		?
		? cSTR 
	ENDPROC

	PROCEDURE grdPackingSli.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Refresh_PackingSli()
	ENDPROC

	PROCEDURE Text1.InteractiveChange
		
		PRIVATE lnInsertionPt, lcSearchStr
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		
		*? "-"+STR(ASC(lcSearchStr))+"-"
	ENDPROC

	PROCEDURE Text1.Valid
		
		lcSearchStr = ALLTRIM(THIS.VALUE)
		
		
		nLen = LEN(lcSearchStr)
		cSTR = ''
		
		FOR i = 1 TO nLen
			cSTR = cSTR + "-"+ALLTRIM(STR(ASC(SUBSTR(lcSearchStr,i,1))))+"-"
		
		NEXT i
		
		?
		? cSTR 
	ENDPROC

ENDDEFINE
