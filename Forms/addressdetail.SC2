	PROCEDURE Init
		Parameter cTable, nCode
		
		IF TYPE("cTable") = "U" OR TYPE("cTable") = "L"
			MESSAGEBOX( "Need PARAMETERS 'Table',AddressCode ",0+16,"")
			ThisForm.Release
			cTable = ''
			nCode = 0
		ENDIF
		
		
		This.Caption = This.Caption +": "+ cTable
		This.cSearchTable = cTable
		This.nSearchCode = nCode
		
		DO CASE
		CASE cTable = "SoldAddr"
			ThisForm.txtCode.ControlSource = "SoldCode"
		CASE cTable = "ShipAddr"
			ThisForm.txtCode.ControlSource = "ShipCode"
		CASE cTable = "Vendor"
			ThisForm.txtCode.ControlSource = "VendCode"
		OTHERWISE
		ENDCASE
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
		**Private Data
		DO Case
		CASE ThisForm.cSearchTable = "SoldAddr"
		
			cSQL="SELECT * FROM [SoldAddr] WHERE SoldCode = "+STR(This.nSearchCode)
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr' )
				messagebox("SQL Error"+CHR(13)+"Could not load Data!",0,"SQL Error")
			ENDIF
			ThisForm.Refresh	
		
		CASE ThisForm.cSearchTable = "ShipAddr"
			cSQL="SELECT * FROM [ShipAddr] WHERE ShipCode = "+STR(This.nSearchCode)
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr' )
				messagebox("SQL Error"+CHR(13)+"Could not load Data!",0,"SQL Error")
			ENDIF
		
			ThisForm.Refresh	
		CASE ThisForm.cSearchTable = "Vendor"
			cSQL="SELECT * FROM [Vendor] WHERE VendCode = "+STR(This.nSearchCode)
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Vendor' )
				messagebox("SQL Error"+CHR(13)+"Could not load Data!",0,"SQL Error")
			ENDIF
		
			ThisForm.Refresh	
		ENDCASE
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE Unload
		IF USED("SoldAddr")
			USE IN SoldAddr
		ENDIF
		IF USED("ShipAddr")
			USE IN ShipAddr
		ENDIF
		IF USED("Vendor")
			USE IN Vendor
		ENDIF
		
		 = SQLDISCONNECT(ThisForm.nConnHandle )
		 
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
	ENDPROC

ENDDEFINE

