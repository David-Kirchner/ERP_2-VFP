DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdDone" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdSOitem" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblSOitems" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSaveList" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: fnqdb
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Form1"
		DoCreate = .T.
		Height = 250
		Left = 0
		Name = "Form1"
		nconnhandle = .F.
		OLEDragPicture = ..\..\microsoft visual foxpro 9\samples\solution\
		OLEDropEffects = 1
		OLEDropMode = 1
		ShowTips = .T.
		Top = 0
		Width = 497
	*</PropValue>

	ADD OBJECT 'cmdDone' AS commandbutton WITH ;
		Caption = "Done", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 360, ;
		Name = "cmdDone", ;
		TabIndex = 13, ;
		TerminateRead = .T., ;
		Top = 156, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSaveList' AS commandbutton WITH ;
		Caption = "Save list", ;
		Height = 27, ;
		Left = 144, ;
		Name = "cmdSaveList", ;
		Top = 156, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdSOitem' AS grid WITH ;
		Height = 200, ;
		Left = 12, ;
		Name = "grdSOitem", ;
		Top = 24, ;
		Width = 108
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'lblSOitems' AS label WITH ;
		Caption = "SO Items", ;
		Height = 17, ;
		Left = 13, ;
		Name = "lblSOitems", ;
		Top = 7, ;
		Width = 60
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE fnqdb
	ENDPROC

	PROCEDURE Init
		*Parameters 
		
		IF ThisForm.nConnHandle < 0
			MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			SQLExecError("get_SQLSTRINGCONNECT()", ThisForm.nConnHandle, nSQLEXEC, "NOCONNECTION" )
		ENDIF
		
		****************************************************************
		ThisForm.fnQDB = UniqDBF(ThisForm.fnQDB)
		
		IF USED('tmpOrders')
			USE IN tmpOrders
		ENDIF
		SELECT 0
		
		IF FILE('Fix_Orders')
			USE Fix_Orders 
		
		ENDIF
		
		
		
		****************************************************************
		IF USED('tmpOrders')
			USE IN tmpOrders
		ENDIF
		SELECT 0
		
		cSQL=" SELECT AQ.SOitem, AQ.Q_Total, S_Total, ROUND((AQ.Q_P*AQ.Q_Qty),0) AS Q_Calc, Round((AQ.S_P*AQ.S_QTY),0) AS S_Calc, AQ.Q_PU, AQ.Q_P, AQ.Q_QTY, AQ.S_PU, AQ.S_P, AQ.S_QTY "
		cSQL=cSQL+" FROM dbo.AllQuotes AQ "
		cSQL=cSQL+" WHERE AQ.SalesNum > 0  "
		cSQL=cSQL+" AND dbo.[f_get_Year_Month](AQ.SaleDate) = dbo.[f_get_Year_Month](GETDATE()) "
		cSQL=cSQL+"  AND ROUND(Q_Total,0) <> ROUND(S_Total,0) "
		cSQL=cSQL+"  --AND ROUND((Q_P*Q_QTY),0) <> ROUND(Q_Total,0) "
		cSQL=cSQL+"  --AND (S_P*S_QTY) <> S_Total "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrders')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpOrders' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpOrders' )
		ENDIF
		
		IF USED('tmpOrders')
			IF RECCOUNT('tmpOrders') > 0
			
				ThisForm.grdSOitem.RecordSource = 'tmpOrders'
				
				
			ENDIF
		*	USE IN tmpOrders
		ENDIF
				
		
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
	ENDPROC

	PROCEDURE OLEDragDrop
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpOrders')
			USE IN tmpOrders
		ENDIF
		
		*UniqDBFdel(ThisForm.fnQDB)
	ENDPROC

	PROCEDURE cmdDone.Click
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSaveList.Click
		IF USED('tmpOrders')
			*CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQDBsendto) FREE ;
			
			*COPY TO 'Fix_Orders'
			*CREATE TABLE
			IF "\MEM" $ SYS(2003)
				CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQDB) FREE ;
					(NAME C(25), Company C(30), Phone C(11), Phone_Ext C(6), Fax C(11), Email C(60), PO_Num C(17);
					, SalesP C(1), InqNum N(7,0), InqNumP C(8), CountryC C(10), CustDisc N(3,2) )
				USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQDB) EXCL ALIAS QDBsendto
			ELSE
				CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQDB) FREE ;
					(NAME C(25), Company C(30), Phone C(11), Phone_Ext C(6), Fax C(11), Email C(60), PO_Num C(17);
					, SalesP C(1), InqNum N(7,0), InqNumP C(8), CountryC C(10), CustDisc N(3,2) )
				USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQDB) EXCL ALIAS QDBsendto
			ENDIF
		
			INSERT INTO (lcPath) VALUES (tmpOrders.SOitem)
			
		
		
		ENDIF
	ENDPROC

ENDDEFINE
