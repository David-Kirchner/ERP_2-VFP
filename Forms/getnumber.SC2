	PROCEDURE Init
		PARAMETER pCompany, pType
		PRIVATE nBestItem, cAlloy
		
		ThisForm.OrigTable = ALIAS()
		
		ThisForm.HoldType = IIF( TYPE("pType")="C", pType, "")
		ThisForm.txtCompany.Value = IIF( TYPE("pCompany")="C", ALLTRIM(pCompany), "")
		
		*HoldType="FAX","PHONE","PHONEFAX","EMAIL"
		IF ThisForm.HoldType="FAX" OR ThisForm.HoldType="PHONEFAX"
			ThisForm.txtFax.backcolor=RGB(255,255,128)
		ENDIF
		IF ThisForm.HoldType="PHONE" OR ThisForm.HoldType="PHONEFAX"
			ThisForm.txtPhone.backcolor=RGB(255,255,128)
		ENDIF
		IF ThisForm.HoldType="EMAIL"
			ThisForm.txtEmail.backcolor=RGB(255,255,128)
		ENDIF
		
		
		IF !EMPTY(ThisForm.txtCompany.Value)
			ThisForm.cmdSearch.Click
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		*IF VARTYPE(gnConnHandle) = "N"
		*	ThisForm.CloseConn = .F.
		*	ThisForm.nConnHandle = gnConnHandle
		*ELSE
			ThisForm.CloseConn = .T.
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		*ENDIF
		
		IF EMPTY(ThisForm.nConnHandle)
			ThisForm.CloseConn = .T.
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		
		IF USED('SourcePH')
			USE IN SourcePH
		ENDIF
		
		SELECT 0
		cSQL = "SELECT * FROM dbo.SourcePH ORDER BY Company"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"SourcePH")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'SourcePH')
		ENDIF
		
		SELECT SourcePH
		*SET ORDER TO TAG
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdAdd.Click
		PRIVATE cCompany, lFoundSource 
		lFoundSource = .F.
		cCompany = UPPER(ALLTRIM(ThisForm.txtCompany.Value))
		
		PRIVATE cPhone, cFax, cEmail
		cPhone	= ThisForm.txtPhone.Value
		cFax	= ThisForm.txtFax.Value
		cEmail	= ThisForm.txtEmail.Value
		
		IF TYPE("cCompany ")!="C"
			MESSAGEBOX("Bad company name",0,"Can not Save")
			RETURN
		ENDIF
		IF EMPTY(cCompany )
			MESSAGEBOX("Bad company name",0,"Can not Save")
			RETURN
		ENDIF
		
		IF TYPE("cPhone")!="C"
			IF !EMPTY(cPhone)
				MESSAGEBOX("Bad PHONE number",0,"Can not Save phone")
			ENDIF
			cPhone = ""
		*	RETURN
		ELSE
		ENDIF
		
		IF TYPE("cFax")!="C"
			IF !EMPTY(cFax)
				MESSAGEBOX("Bad FAX number",0,"Can not Save Fax")
			ENDIF
			cFax = ""
		*	RETURN
		ELSE
		ENDIF
		
		IF TYPE("cEmail")!="C"
			IF !EMPTY(cEmail)
				MESSAGEBOX("Bad EMAIL name",0,"Can not Save Email")
			ENDIF
		*	RETURN
			cEmail = ""
		ELSE
			IF NOT ( "@" $ cEmail )
				MESSAGEBOX("Bad EMAIL name"+CHR(13)+"An Email address should have an @ sign.",0,"Can not Save Email")
				cEmail = ""
			ENDIF
		ENDIF
		
		PRIVATE lFoundCompany, cSQL, nSQLEXEC, cSQLu, cSQLi
		lFoundCompany = .F.
		
		
		IF USED('tmpCntSourcePH')
			USE IN tmpCntSourcePH
		ENDIF
		
		SELECT 0
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SourcePH WHERE Company = '"+ALLTRIM(cCompany)+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL ,"tmpCntSourcePH")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntSourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSourcePH")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 1
			SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCntSourcePH' )
		ENDIF
		
		IF USED("tmpCntSourcePH")
			IF VARTYPE(tmpCntSourcePH.Cntd) = "N"
				lFoundCompany = .T.
			ENDIF
			USE IN tmpCntSourcePH
		ENDIF
		
		
		IF lFoundCompany 
		
			cSQLu = "UPDATE dbo.SourcePH SET "
			cSQLu = cSQLu + " phone='"+cPhone+"'"
			cSQLu = cSQLu + ",fax ='"+cFax+"'"
			cSQLu = cSQLu + ",person='"+''+"'"
			cSQLu = cSQLu + ",email='"+cEmail+"'"
			cSQLu = cSQLu + ",email2='"+''+"'"
			cSQLu = cSQLu + " WHERE Company = '"+ALLTRIM(cCompany)+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				WAIT WINDOW 'Update Saved!' NOWAIT
			ENDIF
		
		ELSE
			cSQLi = "EXEC [dbo].[p_SourcePH_ins] "
			cSQLi = cSQLi + "@Company='"+cCompany+"'"
			cSQLi = cSQLi + ",@Phone='"+cPhone+"'"
			cSQLi = cSQLi + ",@fax='"+cFax+"'"
			cSQLi = cSQLi + ",@Person='"+''+"'"
			cSQLi = cSQLi + ",@Email='"+cEmail+"'"
			cSQLi = cSQLi + ",@Email2='"+''+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQLi )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				WAIT WINDOW 'New record Saved!' NOWAIT
			ENDIF
		ENDIF
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdDone.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		IF ThisForm.HoldType="FAX"
			cHoldNumber = ThisForm.txtFax.VALUE
		ENDIF
		IF ThisForm.HoldType="PHONE"
			cHoldNumber = ThisForm.txtPhone.VALUE
		ENDIF
		IF ThisForm.HoldType="EMAIL"
			cHoldNumber = ThisForm.txtEmail.VALUE
		ENDIF
		
		*IF TYPE(cHoldNumber) = "N"
		*	cHoldNumber = STR(cHoldNumber,10,0)
		*ENDIF
		ThisForm.HoldNumber = cHoldNumber 
		IF EMPTY(ThisForm.HoldNumber)
			?? CHR(7)
			WAIT WINDOW "No number / Address !!!" TIMEOUT 3
		ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSearch.Click
		PRIVATE cComp
		
		cComp = UPPER(ThisForm.txtCompany.Value)
		SELECT SourcePH
		INDEX ON UPPER(Company) TAG uComp
		
		DO WHILE .T.
			SEEK cComp ORDER TAG uComp IN SourcePH
			IF FOUND('SourcePH')
				ThisForm.txtPhone.Value	= SourcePH.Phone
				ThisForm.txtFax.Value	= SourcePH.Fax
				ThisForm.txtEmail.Value	= SourcePH.Email
				EXIT
			ENDIF
			cComp = LEFT(cComp, LEN(cComp)-1 )
			IF LEN(cComp) = 0
				ThisForm.txtCompany.Value = cComp
				ThisForm.txtPhone.Value	= SourcePH.Phone
				ThisForm.txtFax.Value	= SourcePH.Fax
				ThisForm.txtEmail.Value	= SourcePH.Email
				EXIT
			ENDIF
		ENDDO
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE grdStockLst.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.txtCompany.Value = SourcePH.Company
		ThisForm.txtPhone.Value = SourcePH.Phone
		ThisForm.txtFax.Value = SourcePH.Fax
		ThisForm.txtEmail.Value = SourcePH.Email
		
	ENDPROC

	PROCEDURE grdStockLst.BeforeRowColChange
		LPARAMETERS nColIndex
	ENDPROC

ENDDEFINE
