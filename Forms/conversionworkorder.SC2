	PROCEDURE getconvo		&& Refresh for new Conversion Order Number
		PARAMETERS pCO
		
		IF TYPE("pCO") != "N"
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		ThisForm.pgf.pgEdit.grdStart.RecordSource = ""
		IF USED("tmpConvStart")	
			USE IN tmpConvStart
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.ConversionOrder WHERE [CO]="+STR(pCO)+" AND [Type]='S' "
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpConvStart')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle,	cSQL, 'tmpConvStart')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvStart")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvStart")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.ConnHandle, nSQLEXEC, 'vCompQHistory')
		ENDIF
		SELECT tmpConvStart
		*!*	IF RECCOUNT('tmpConvStart') = 0
		*!*		cSQL = "SELECT Pieces,Alloy,Form,'1' AS cc,Thck,sz2,sz3,Weight, 0 AS Marked, 0 AS CO, ' ' AS Type, GETDATE() AS Date, SPACE(20) AS Conv, SPACE(10) AS Person, 0 AS ID_Detail, 0 AS CO_Id FROM dbo.AllQuotes WHERE 0<0"
		*!*		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpConvStart')
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvStart")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvStart")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*		IF nSQLEXEC < 1
		*!*			SQLEXECError(cSQL)
		*!*		ENDIF
		*!*	ENDIF
		
		ThisForm.pgf.pgEdit.grdStart.RecordSource = "tmpConvStart"
		ThisForm.pgf.pgEdit.grdStart.Refresh
		
		
		ThisForm.pgf.pgEdit.grdFinish.RecordSource = ""
		IF USED("tmpConvFinish")	
			USE IN tmpConvFinish
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.ConversionOrder WHERE [CO]="+STR(pCO)+" AND [Type]='F' "
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpConvFinish')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle,	cSQL, 'tmpConvFinish')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpConvFinish')
		ENDIF
		SELECT tmpConvFinish
		*!*	IF RECCOUNT('tmpConvFinish') = 0
		*!*		cSQL = "SELECT Pieces,Alloy,Form,'1' AS cc,Thck,sz2,sz3,Weight, 0 AS Marked, 0 AS CO, ' ' AS Type, GETDATE() AS Date, SPACE(20) AS Conv, SPACE(10) AS Person, 0 AS ID_Detail, 0 AS CO_Id FROM dbo.AllQuotes WHERE 0<0"
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpConvFinish')
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*		IF nSQLEXEC < 1
		*!*			SQLEXECError(cSQL)
		*!*		ENDIF
		*!*	ENDIF
		ThisForm.pgf.pgEdit.grdFinish.RecordSource = "tmpConvFinish"
		ThisForm.pgf.pgEdit.grdFinish.Refresh
		
	ENDPROC

	PROCEDURE Init
		ThisForm.pgf.pgEdit.grdStart.RecordSource = "tmpConvStart"
		ThisForm.pgf.pgEdit.grdfinish.RecordSource = "tmpConvFinish"
		ThisForm.pgf.pgEdit.txtDate.Value = DATE()
		ThisForm.pgf.pgEdit.txtCC.Value = '1'
		ThisForm.pgf.pgEdit.txtCL.Value = ''
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_SETUP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		IF USED("tmpConvStart")	
			USE IN tmpConvStart
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT * FROM dbo.ConversionOrder WHERE 0<0"
		*(Pieces,Alloy,Form,Cc,Thck,sz2,sz3,Weight,Marked,CO,Type,Date,Conv,Person,ID_Detail)
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpConvStart')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpConvStart')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpConvStart')
		ELSE
			*See INIT
			*ThisForm.grdStart.RecordSource = "tmpConvStart"
		ENDIF
		
		
		
		
		
		IF USED("tmpConvFinish")	
			USE IN tmpConvFinish
		ENDIF
		SELECT 0
		cSQL = "SELECT * FROM dbo.ConversionOrder WHERE 0<0"
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpConvFinish')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpConvFinish')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConvFinish")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpConvFinish' )
		
			*See INIT
			*ThisForm.grdFinish.RecordSource = "tmpConvFinish"
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE pgf.pgEdit.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE pgf.pgEdit.cmbForm.Valid
		*10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined
		
		ThisForm.RefreshForms(This.Value)
		* ALSO FOUND IN Quotes,PurchaseOrder Screen
		
	ENDPROC

	PROCEDURE pgf.pgEdit.cmdGetInv.Click
		PRIVATE m.cAlloy,m.cForm,m.cCond,m.nTthck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight
		PRIVATE m.nCO
		
		m.cAlloy	= ThisForm.pgf.pgEdit.txtAlloy.Value
		m.cForm		= ThisForm.pgf.pgEdit.cmbForm.Value
		m.cCC		= ThisForm.pgf.pgEdit.txtCC.Value &&ThisForm.pgf.pgEDIT.cmbCC.Calue
		m.cCL		= ThisForm.pgf.pgEdit.txtCL.Value
		m.nTthck	= ThisForm.pgf.pgEdit.txtThck.Value
		m.nSz2		= ThisForm.pgf.pgEdit.txtSz2.Value
		m.nSz3		= ThisForm.pgf.pgEdit.txtSz3.Value
		m.cSOItem	= ''
		m.nSalesNum	= 0
		m.nPieces	= ThisForm.pgf.pgEdit.txtPieces.Value
		m.nWeight	= ThisForm.pgf.pgEdit.txtWeight.Value
		
		PRIVATE pID_Detail, m.nID
		m.nID = 0
		
		*Old DO FORM Forms\StockLst_SQL_Quotes WITH "GET",'S',m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight,'',0,.F.,'' TO pID_Detail
		*DO FORM Forms\StockLst_SQL_Browse WITH "GET",'S',m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight,'',0,.F.,'' TO pID_Detail
		DO FORM Forms\StockLst_SQL_Modal WITH "GET",'S',m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight,'',0,.F.,'' TO pID_Detail
		*                        PARAMETER pFunction,pTBL,pAlloy   ,pForm  ,pCC,  pCL,  pThck,  pSz2,   pSz3 ,pSOItem  ,pSalesNum      ,pPC,  pLBS,pHeatLot,pQTY,pRL,pPOitem
		
		IF TYPE("pID_Detail") = "N"
			IF pID_Detail > 0
				*Get StockLst
			
			
			
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT ID,PC,Dim1,Dim2,Dim3,Weight FROM dbo.StockLst_Detail WHERE ID_Detail = "+STR(pID_Detail)
		
				IF USED("tmpStockLst_Detail")
					SELECT tmpStockLst_Detail
				ELSE
					SELECT 0
				ENDIF
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
				ELSE
					IF USED("tmpStockLst_Detail")
						m.nID 							= tmpStockLst_Detail.ID
						ThisForm.pgf.pgEdit.txtPieces.Value		= tmpStockLst_Detail.PC
						ThisForm.pgf.pgEdit.txtThck.Value		= tmpStockLst_Detail.Dim1
						ThisForm.pgf.pgEdit.txtSz2.Value		= tmpStockLst_Detail.Dim2
						ThisForm.pgf.pgEdit.txtSz3.Value		= tmpStockLst_Detail.Dim3
						ThisForm.pgf.pgEdit.txtWeight.Value		= tmpStockLst_Detail.Weight
					ENDIF
				ENDIF
				IF USED("tmpStockLst_Detail")
					USE IN tmpStockLst_Detail
				ENDIF
				
				IF m.nID > 0
					cSQL = "SELECT Alloy,Form,Cc FROM dbo.StockLst_Master WHERE ID = "+STR(m.nID)
					
					IF USED("tmpStockLst_Master")
						SELECT tmpStockLst_Master
					ELSE
						SELECT 0
					ENDIF
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master')
					ELSE
						IF USED("tmpStockLst_Master")
							ThisForm.pgf.pgEdit.txtAlloy.Value		= tmpStockLst_Master.Alloy
							ThisForm.pgf.pgEdit.cmbForm.Value		= tmpStockLst_Master.Form
							ThisForm.pgf.pgEdit.txtCC.Value			= tmpStockLst_Master.CC
							ThisForm.pgf.pgEdit.txtCL.Value			= tmpStockLst_Master.CL
						ENDIF
					ENDIF
					IF USED("tmpStockLst_Master")
						USE IN tmpStockLst_Master
					ENDIF
				ENDIF	
				ThisForm.CO_Id = 0	
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pgf.pgEdit.cmdSaveFinish.Click
		PRIVATE m.nPieces,m.cAlloy,m.cForm,m.cCond,m.nTthck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nWeight
		PRIVATE m.nCO, m.nID_Detail
		PRIVATE m.cType,m.dDate,m.cConv,m.cPerson,m.nMarked
		PRIVATE m.cSOitem
		
		m.nPieces	= ThisForm.pgf.pgEdit.txtPieces.Value
		m.cAlloy	= ThisForm.pgf.pgEdit.txtAlloy.Value
		m.cForm		= ThisForm.pgf.pgEdit.cmbForm.Value
		m.cC		= '1'
		m.nTthck	= ThisForm.pgf.pgEdit.txtThck.Value
		m.nSz2		= ThisForm.pgf.pgEdit.txtSz2.Value
		m.nSz3		= ThisForm.pgf.pgEdit.txtSz3.Value
		m.nWeight	= ThisForm.pgf.pgEdit.txtWeight.Value
		m.nID_Detail= ThisForm.pgf.pgEdit.txtID_Detail.Value
		
		m.nCO		= ThisForm.pgf.pgEdit.txtConvO.Value
		m.cType		= "F"
		m.dDate		= ThisForm.pgf.pgEdit.txtdate.Value
		m.cConv		= ThisForm.pgf.pgEdit.txtConv.Value
		m.cPerson	= ThisForm.pgf.pgEdit.txtPerson.Value
		m.cSOitem	= ThisForm.pgf.pgEdit.txtSOitem.Value
		
		m.nMarked = 0
		
		*Test
		IF TYPE("m.nCO") = "U"
			MESSAGEBOX("Need Conversion Order Number!",0,"No CO")
			RETURN .F.
		ENDIF
		IF TYPE("m.nCO") = "C"
			m.nCO = VAL(m.nCO)
		ENDIF
		IF m.nCO = 0
			MESSAGEBOX("Need Conversion Order Number!",0,"No CO")
			RETURN .F.
		ENDIF
		
		IF TYPE("m.dDate") = "D"
			IF m.dDate = CTOD("  /  /  ")
				MESSAGEBOX("Check Date, Date is Empty",0,"Warning")
				ThisForm.pgf.pgEdit.txtdate.Value = DATE()
				RETURN .F.
			ELSE
				IF m.dDate+90 < DATE() OR m.dDate-90 > DATE()
					MESSAGEBOX("Check Date, more then 3 months off",0,"Warning")
				ENDIF
			ENDIF
		ELSE
			m.dDate = CTOD("  /  /  ")
			MESSAGEBOX("Check Date, Date is Empty",0,"Warning")
		ENDIF
		
		IF TYPE("m.cConv")= "U"
			MESSAGEBOX("Conversion Field is Empty",0,"Warning")
			m.cConv = ""
		ENDIF
		IF TYPE("m.cPerson")= "U"
			MESSAGEBOX("Person Field is Empty",0,"Warning")
			m.cPerson= ""
		ENDIF
		
		IF TYPE("m.cSOitem")!= "C"
			m.cSOitem = ""
		ENDIF
		
		IF TYPE("m.nID_Detail")= "U"
			m.nID_Detail= 0
		ENDIF
		
		*tmpConvFinish
		IF ThisForm.CO_Id > 0
			*UPDATE
			
			cSQLu = "UPDATE dbo.ConversionOrder SET"
			cSQLu = cSQLu + " Pieces = "+STR(m.nPieces)
			cSQLu = cSQLu + ", Alloy = '"+m.cAlloy+"'"
			cSQLu = cSQLu + ", Form = '"+m.cForm+"'"
			cSQLu = cSQLu + ", Cc = '"+m.cC+"'"
			cSQLu = cSQLu + ", Thck	= "+STR(m.nTthck,10,4)
			cSQLu = cSQLu + ", sz2 = "+STR(m.nSz2,9,3)
			cSQLu = cSQLu + ", sz3 = "+STR(m.nSz3,9,3)
			cSQLu = cSQLu + ", Weight = "+STR(m.nWeight,8,1)
			cSQLu = cSQLu + ", Marked = "+STR(m.nMarked)
			cSQLu = cSQLu + ", CO = "+STR(m.nCO)
			cSQLu = cSQLu + ", TYPE	= '"+m.cType+"'"
			cSQLu = cSQLu + ", Date	= '"+m.dDate+"'"
			cSQLu = cSQLu + ", Conv	= "+m.cConv+"'"
			cSQLu = cSQLu + ", Person = '"+m.cPerson+"'"
			cSQLu = cSQLu + ", SOitem = dbo.f_ProperSOitem('"+m.cSoItem+"')"
			cSQLu = cSQLu + ", ID_Detail = "+STR(m.nID_Detail) 
			cSQLu = cSQLu + " WHERE CO_Id = "+STR(ThisForm.CO_Id)
			 
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
			 
			UPDATE tmpConvFinish SET ;
			 Pieces = m.nPieces, ;
			 Alloy = m.cAlloy, ;
			 Form	= m.cForm, ;
			 Cc		= m.cC, ;
			 Thck	= m.nTthck, ;
			 sz2	= m.nSz2, ;
			 sz3	= m.nSz3, ;
			 Weight	= m.nWeight, ;
			 Marked	= m.nMarked, ;
			 CO		= m.nCO, ;
			 TYPE	= m.cType, ;
			 Date	= m.dDate, ;
			 Conv	= m.cConv, ;
			 Person	= m.cPerson, ;
			 SOitem = m.cSOitem, ;
			 ID_Detail	= m.nID_Detail ;
			 WHERE CO_Id = ThisForm.CO_Id
		
		
		ELSE
			*INSERT
			IF USED("tmpCO_Id")
				USE IN tmpCO_Id
			ENDIF
		
			cSQLi = "EXEC dbo.p_ConversionOrder_ins "
			cSQLi = cSQLi+ " @Pieces ="+STR(IIF(ISNULL(m.nPieces),0,m.nPieces))+""   &&NOT NULL
			cSQLi = cSQLi+ ",@Alloy ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cAlloy)," ",m.cAlloy),"'","''"))+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Form ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cForm)," ",m.cForm),"'","''"))+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@cc ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.CC),"1",m.CC),"'","''"))+"'"   &&NOT NULL	
			cSQLi = cSQLi+ ",@Thck ="+STR(IIF(ISNULL(m.nThck),0,m.nThck),10,4)+""   &&NOT NULL
			cSQLi = cSQLi+ ",@sz2 ="+STR(IIF(ISNULL(m.nsz2),0,m.nsz2),9,3)+""
			cSQLi = cSQLi+ ",@sz3 ="+STR(IIF(ISNULL(m.nsz3),0,m.nsz3),9,3)+""
			cSQLi = cSQLi+ ",@Weight ="+STR(IIF(ISNULL(m.nWeight),0,m.nWeight),9,3)+""
			cSQLi = cSQLi+ ",@Marked ="+STR(IIF(ISNULL(m.nMarked),0,m.nMarked))+""
			cSQLi = cSQLi+ ",@CO ="+STR(IIF(ISNULL(m.nCO),0,m.nCO))+""
			cSQLi = cSQLi+ ",@Type ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cType),"",m.cType),"'","''"))+"'"
			cSQLi = cSQLi+ ",@Date ='"+IIF(EMPTY(m.dDate),'',DTOC(m.dDate))+"'"
			cSQLi = cSQLi+ ",@Conv ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cConv),"",m.cConv),"'","''"))+"'"
			cSQLi = cSQLi+ ",@Person ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cPerson),"",m.cPerson),"'","''"))+"'"
			cSQLi = cSQLi+ ",@SOitem='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.SOitem),"",m.SOitem),"'","''"))+"'"
			cSQLi = cSQLi+ ",@ID_Detail ="+STR(IIF(ISNULL(m.nID_Detail),0,m.nID_Detail))+""
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpCO_Id')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpCO_Id')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpCO_Id")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpCO_Id")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpCO_Id')
			ELSE
				=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpCO_Id")
					ThisForm.CO_Id = tmpCO_Id.EXP
					USE IN tmpCO_Id 
				ENDIF
		
			ENDIF
			
			INSERT INTO tmpConvFinish (Pieces,Alloy,Form,Cc,Thck,sz2,sz3,Weight,Marked,CO,Type,Date,Conv,Person,SOitem ,ID_Detail,CO_Id) ;
			VALUES (m.nPieces,m.cAlloy,m.cForm,m.cC,m.nTthck,m.nSz2,m.nSz3,m.nWeight,m.nMarked,m.nCO,m.cType,m.dDate,m.cConv,m.cPerson,m.cSOitem,m.nID_Detail,ThisForm.CO_Id )
		ENDIF
		
		ThisForm.CO_Id = 0
		
		ThisForm.grdFinish.Refresh
		
	ENDPROC

	PROCEDURE pgf.pgEdit.cmdsaveStart.Click
		PRIVATE m.nPieces,m.cAlloy,m.cForm,m.cC,m.nTthck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nWeight
		PRIVATE m.nCO, m.nID_Detail
		PRIVATE m.cType,m.dDate,m.cConv,m.cPerson, m.nMarked
		PRIVATE m.cSOitem
		
		m.nPieces	= ThisForm.pgf.pgEdit.txtPieces.Value
		m.cAlloy	= ThisForm.pgf.pgEdit.txtAlloy.Value
		m.cForm		= ThisForm.pgf.pgEdit.cmbForm.Value
		m.cC		= '1'
		m.nTthck	= ThisForm.pgf.pgEdit.txtThck.Value
		m.nSz2		= ThisForm.pgf.pgEdit.txtSz2.Value
		m.nSz3		= ThisForm.pgf.pgEdit.txtSz3.Value
		m.nWeight	= ThisForm.pgf.pgEdit.txtWeight.Value
		m.nID_Detail= ThisForm.pgf.pgEdit.txtID_Detail.Value
		
		m.nCO		= ThisForm.pgf.pgEdit.txtConvO.Value
		m.cType		= "S"
		m.dDate		= ThisForm.pgf.pgEdit.txtdate.Value
		m.cConv		= ThisForm.pgf.pgEdit.txtConv.Value
		m.cPerson	= ThisForm.pgf.pgEdit.txtPerson.Value
		m.cSOitem	= ThisForm.pgf.pgEdit.txtSOitem.Value
		
		m.nMarked = 0
		*Test
		
		IF TYPE("m.nCO") = "U"
			MESSAGEBOX("Need Conversion Order Number!",0,"No CO")
			RETURN .F.
		ENDIF
		IF TYPE("m.nCO") = "C"
			m.nCO = VAL(m.nCO)
		ENDIF
		IF m.nCO = 0
			MESSAGEBOX("Need Conversion Order Number!",0,"No CO")
			RETURN .F.
		ENDIF
		
		IF TYPE("m.dDate") = "D"
			IF m.dDate = CTOD("  /  /  ")
				MESSAGEBOX("Check Date, Date is Empty",0,"Warning")
				ThisForm.pgf.pgEdit.txtdate.Value = DATE()
				RETURN .F.
			ELSE
				IF m.dDate+90 < DATE() OR m.dDate-90 > DATE()
					MESSAGEBOX("Check Date, more then 3 months off",0,"Warning")
				ENDIF
			ENDIF
		ELSE
			m.dDate = CTOD("  /  /  ")
			MESSAGEBOX("Check Date, Date is Empty",0,"Warning")
		ENDIF
		
		IF TYPE("m.cConv")= "U"
			MESSAGEBOX("Conversion Field is Empty",0,"Warning")
			m.cConv = ""
		ENDIF
		IF TYPE("m.cPerson")= "U"
			MESSAGEBOX("Person Field is Empty",0,"Warning")
			m.cPerson= ""
		ENDIF
		
		IF TYPE("m.cSOitem")!= "C"
			m.cSOitem = ""
		ENDIF
		
		IF TYPE("m.nID_Detail")= "U"
			m.nID_Detail= 0
		ENDIF
		
		IF ThisForm.CO_Id > 0
			*UPDATE
			
			cSQLu = "UPDATE dbo.ConversionOrder SET"
			cSQLu = cSQLu + " Pieces = "+STR(m.nPieces)
			cSQLu = cSQLu + ", Alloy = '"+m.cAlloy+"'"
			cSQLu = cSQLu + ", Form = '"+m.cForm+"'"
			cSQLu = cSQLu + ", Cc = '"+m.cC+"'"
			cSQLu = cSQLu + ", Thck	= "+STR(m.nTthck,10,4)
			cSQLu = cSQLu + ", sz2 = "+STR(m.nSz2,9,3)
			cSQLu = cSQLu + ", sz3 = "+STR(m.nSz3,9,3)
			cSQLu = cSQLu + ", Weight = "+STR(m.nWeight,8,1)
			cSQLu = cSQLu + ", Marked = "+STR(m.nMarked)
			cSQLu = cSQLu + ", CO = "+STR(m.nCO)
			cSQLu = cSQLu + ", TYPE	= '"+m.cType+"'"
			cSQLu = cSQLu + ", Date	= '"+m.dDate+"'"
			cSQLu = cSQLu + ", Conv	= "+m.cConv+"'"
			cSQLu = cSQLu + ", Person = '"+m.cPerson+"'"
			cSQLu = cSQLu + ", SOitem = dbo.f_ProperSOitem('"+m.cSoItem+"')"
			cSQLu = cSQLu + ", ID_Detail = "+STR(m.nID_Detail) 
			cSQLu = cSQLu + " WHERE CO_Id = "+STR(ThisForm.CO_Id)
			 
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError( cSQLu, ThisForm.nConnHandle , nSQLEXEC, '')
			ENDIF
			 
			UPDATE tmpConvstart SET ;
			 Pieces = m.nPieces, ;
			 Alloy = m.cAlloy, ;
			 Form	= m.cForm, ;
			 Cc		= m.cC, ;
			 Thck	= m.nTthck, ;
			 sz2	= m.nSz2, ;
			 sz3	= m.nSz3, ;
			 Weight	= m.nWeight, ;
			 Marked	= m.nMarked, ;
			 CO		= m.nCO, ;
			 TYPE	= m.cType, ;
			 Date	= m.dDate, ;
			 Conv	= m.cConv, ;
			 Person	= m.cPerson, ;
			 SOitem = m.cSOitem, ;
			 ID_Detail	= m.nID_Detail ;
			 WHERE CO_Id = ThisForm.CO_Id
		
		
		ELSE
			*INSERT
			IF USED("tmpCO_Id")
				USE IN tmpCO_Id
			ENDIF
		
			cSQLi = "EXEC dbo.p_ConversionOrder_ins "
			cSQLi = cSQLi+ " @Pieces ="+STR(IIF(ISNULL(m.nPieces),0,m.nPieces))+""   &&NOT NULL
			cSQLi = cSQLi+ ",@Alloy ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cAlloy)," ",m.cAlloy),"'","''"))+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Form ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cForm)," ",m.cForm),"'","''"))+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@cc ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.CC),"1",m.CC),"'","''"))+"'"   &&NOT NULL	
			cSQLi = cSQLi+ ",@Thck ="+STR(IIF(ISNULL(m.nThck),0,m.nThck),10,4)+""   &&NOT NULL
			cSQLi = cSQLi+ ",@sz2 ="+STR(IIF(ISNULL(m.nsz2),0,m.nsz2),9,3)+""
			cSQLi = cSQLi+ ",@sz3 ="+STR(IIF(ISNULL(m.nsz3),0,m.nsz3),9,3)+""
			cSQLi = cSQLi+ ",@Weight ="+STR(IIF(ISNULL(m.nWeight),0,m.nWeight),9,3)+""
			cSQLi = cSQLi+ ",@Marked ="+STR(IIF(ISNULL(m.nMarked),0,m.nMarked))+""
			cSQLi = cSQLi+ ",@CO ="+STR(IIF(ISNULL(m.nCO),0,m.nCO))+""
			cSQLi = cSQLi+ ",@Type ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cType),"",m.cType),"'","''"))+"'"
			cSQLi = cSQLi+ ",@Date ='"+IIF(EMPTY(m.dDate),'',DTOC(m.dDate))+"'"
			cSQLi = cSQLi+ ",@Conv ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cConv),"",m.cConv),"'","''"))+"'"
			cSQLi = cSQLi+ ",@Person ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.cPerson),"",m.cPerson),"'","''"))+"'"
			cSQLi = cSQLi+ ",@SOitem='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.SOitem),"",m.SOitem),"'","''"))+"'"
			cSQLi = cSQLi+ ",@ID_Detail ="+STR(IIF(ISNULL(m.nID_Detail),0,m.nID_Detail))+""
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpCO_Id')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpCO_Id')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpCO_Id")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpCO_Id")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpCO_Id')
			ELSE
				=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpCO_Id")
					ThisForm.CO_Id = tmpCO_Id.EXP
					USE IN tmpCO_Id 
				ENDIF
		
			ENDIF
			
			INSERT INTO tmpConvstart (Pieces,Alloy,Form,Cc,Thck,sz2,sz3,Weight,Marked,CO,Type,Date,Conv,Person,SOitem ,ID_Detail,CO_Id) ;
			VALUES (m.nPieces,m.cAlloy,m.cForm,m.cC,m.nTthck,m.nSz2,m.nSz3,m.nWeight,m.nMarked,m.nCO,m.cType,m.dDate,m.cConv,m.cPerson,m.cSOitem,m.nID_Detail,ThisForm.CO_Id )
		ENDIF
		
		ThisForm.CO_Id = 0
		
		ThisForm.grdStart.Refresh
		
	ENDPROC

	PROCEDURE pgf.pgEdit.cmdSelectInv.Click
		PRIVATE lcInvForm
		PRIVATE m.cAlloy,m.cForm,m.cCond,m.nTthck,m.nSz2,m.nSz3,m.cCOItem,m.nCO,m.nPieces,m.nWeight
		
		* SelInv, ID_Detail 
		m.cAlloy	= tmpConvStart.Alloy
		m.cForm		= tmpConvStart.Form
		m.cCond		= tmpConvStart.Cc
		m.nTthck	= tmpConvStart.Thck
		m.nSz2		= tmpConvStart.sz2
		m.nSz3		= tmpConvStart.sz3
		m.cCOItem	= '' &&tmpConvStart.
		m.nCO		= tmpConvStart.ConvS_ID
		m.nPieces	= tmpConvStart.Pieces
		m.nWeight	= tmpConvStart.Weight
		
		PRIVATE m.cCC,m.cCL
		m.cCC	= tmpConvStart.CC
		m.cCL	= tmpConvStart.CL
		
		
		
		*pHeatLot,pQTY,pRL,pPOitem
		*DO FORM Forms\StockLst_SQL_Quotes WITH "SEL_CO",'S',m.cAlloy,m.cForm,m.cCond,m.nTthck,m.nSz2,m.nSz3,m.cCOItem,m.nCO,m.nPieces,m.nWeight,'',0,.F.,''
		DO FORM Forms\StockLst_SQL_Quotes WITH "SEL_CO",'S',m.cAlloy,m.cForm,m.cCC,m.cCL,m.nTthck,m.nSz2,m.nSz3,m.cCOItem,    m.nCO,m.nPieces,m.nWeight,'',0,.F.,''
		*                           PARAMETER pFunction,pTBL,pAlloy,   pForm,  pCC,  pCL,   pThck,  pSz2,  pSz3,  pSOItem,pSalesNum,     pPC,     pLBS,pHeatLot,pQTY,pRL,pPOitem
		
	ENDPROC

	PROCEDURE pgf.pgEdit.GetNextPurchaseOrder.Click
		IF NOT EMPTY( ThisForm.pgf.pgEdit.txtConvO.Value )
			IF MESSAGEBOX("Are you sure you want a NEW Conversion Number?",4,"Already have a number") = 7
				RETURN
			ENDIF
		ENDIF
		
		ThisForm.pgf.pgEdit.txtConvO.Value = GetNextWorkOrder(ThisForm.nConnhandle)
		
	ENDPROC

	PROCEDURE pgf.pgEdit.txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE pgf.pgEdit.txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE pgf.pgEdit.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE pgf.pgEdit.txtConvO.Valid
		PRIVATE nConvO
		nConvO = This.Value
		IF TYPE("nConvO") = "C"
			nConvO = VAL(nConvO)
			IF nConvO > 0
				This.Value = nConvO 
			ENDIF
		ENDIF
		IF TYPE("nConvO")= "N"
			IF nConvO > 0
				ThisForm.GetConvO( nConvO )
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
