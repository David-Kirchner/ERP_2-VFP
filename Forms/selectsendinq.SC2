	PROCEDURE Destroy
			IF USED('tmpSources')
				USE IN tmpSources
			ENDIF
		
		IF NOT EMPTY(ThisForm.oldAlias)
			IF USED(ThisForm.oldAlias)
				SELECT (ThisForm.oldAlias)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pcAlloy, pAQrecN, pSalesP
		
		IF VARTYPE(pcAlloy)!="C"
			MESSAGEBOX('need Alloy passed as Parameter',16,'')
			
		*!*		ThisForm.cReturnValue = ""
		*!*		ThisForm.Release
		
		*!*		RETURN .F.
			pcAlloy = 'HPA N50'
		ENDIF
		
		PUBLIC paQuotesInqNo
		IF TYPE("pAQrecN")="L"
			DIMENSION paQuotesInqNo(1)
			paQuotesInqNo[1] = 0
		ELSE
			DIMENSION paQuotesInqNo( aLEN('pAQrecN') )
			aCOPY(pAQrecN,paQuotesInqNo)
		ENDIF
		
		PUBLIC pcSalesP
		IF VARTYPE(pSalesP) != "C"
			pcSalesP = " "
		ELSE
			pcSalesP = pSalesP
		ENDIF
		
		ThisForm.oldAlias = ALIAS()
		
		
		
		IF USED('tmpSources')
			USE IN tmpSources
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT CAST( 0 AS BIT) AS Mrk,Sources.Company,Alloy,Alloy_AKA,UNS,Spec,f10,f20,f30,f40,f60,f65,f70,f75,Sources.Notes,Stk,MK,Sourceph.Company,Phone,Fax,Person,Email,Sourceph.ID "
		cSQL = cSQL + " FROM dbo.sources, dbo.sourceph "
		cSQL = cSQL + " WHERE Sources.ID = Sourceph.ID "
		cSQL = cSQL + " AND Sources.Alloy = '"+pcAlloy+"'"
		cSQL = cSQL + " ORDER BY Sources.company "
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSources')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSources')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSources")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSources")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSources')
		ENDIF
		
		
		IF NOT USED('tmpSources')
			MESSAGEBOX( "Could not loading the Sources and SourcePH table.","Program Error")
			RETURN ""
		ENDIF
		IF VARTYPE(tmpSources.Company) != "C"
			MESSAGEBOX( "Could not loading the Sources and SourcePH table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT tmpSources
		
		ThisForm.grdSource.RecordSource = "tmpSources"
		ThisForm.edtNotes.Value = tmpSources.Notes
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		*RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSend.Click
		ThisForm.cReturnValue = ""
		
		SELECT tmpSources 
		WAIT WINDOW 'GATHERING THE COMPANY(S) YOU SELECTED' NOWAIT
		** RECORD SELECED RECORDS
		COUNT ALL FOR Mrk TO aCNT   &&AND (ThisForm.SalesP = q.p) TO acnt
		
		PRIVATE lnSendToLoop, asrcs
		LOCAL txtGcompany, txtGphone, txtGfax,	txtGperson,	txtGemail,	txtGemail2
		LOCAL m.ifax, m.faxnum 
		m.ifax = SPACE(10)
		m.faxnum = SPACE(11)
		
		LOCAL m.icompany, m.iphone, m.ifaxnum, m.iperson, m.iemail, m.iemail2
		PRIVATE paQuotesInqNo, pcSalesP
		paQuotesInqNo	= .F.
		pcSalesP	= .F.
		
		IF aCNT > 0
			*DO Progs\Gathersend.prg WITH ThisForm.SalesP, .F., paQuotesInqNo
			SELECT tmpSources	 
			SCAN 
				IF Mrk
					m.icompany = tmpSources.Company
					m.iphone   = tmpSources.Phone
					m.ifaxnum  = tmpSources.Fax
					m.iperson  = tmpSources.Person
					m.iemail   = tmpSources.Email
					m.iemail2  = tmpSources.Email
		
		
					m.icompany= IIF(EMPTY(m.icompany),SPACE(30),m.icompany)
					m.iphone  = IIF(EMPTY(m.iphone ),SPACE(11),"1"+m.iphone )
					m.ifaxnum = IIF(EMPTY(m.ifaxnum),SPACE(11),"1"+m.ifaxnum)
					m.iperson = IIF(EMPTY(m.iperson),SPACE(15),m.iperson)
					m.iemail  = IIF(EMPTY(m.iemail), SPACE(30),m.iemail)
					m.iemail2 = IIF(EMPTY(m.iemail2), SPACE(30),m.iemail2)
		
					txtGcompany	=m.icompany
					txtGphone	=m.iphone
					txtGfax		=m.ifaxnum
					txtGperson	=m.iperson
					txtGemail	=m.iemail
					txtGemail2	=m.iemail2
		
					DO FORM Forms\GatherSend WITH txtGcompany,txtGphone,txtGfax,txtGperson,txtGemail,txtGemail2, paQuotesInqNo, pcSalesP, tmpSources.Alloy
				ENDIF
			ENDSCAN
			
		ELSE
			msgGS = MESSAGEBOX("Do you want to address your own Inquire ?",4+32,"No names selected")
			IF msgGS = 6
				*DO Progs\Gathersend.prg WITH ThisForm.SalesP, .T., paQuotesInqNo
				txtGcompany	= SPACE(30)
				txtGphone	= SPACE(11)
				txtGfax		= SPACE(11)
				txtGperson	= "Sales"+SPACE(10)
				txtGemail	= SPACE(30)
				txtGemail2	= SPACE(30)
		
			*	SAVE ALL LIKE txtG* TO c:\GatherSend
				DO FORM Forms\GatherSend WITH txtGcompany,txtGphone,txtGfax,txtGperson,txtGemail,txtGemail2, paQuotesInqNo, pcSalesP, tmpSources.Alloy
			ENDIF
		ENDIF
		
		
		IF USED('tmpSources')
			SELECT tmpSources &&sourcePH
			USE IN tmpSources
		ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE grdSource.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.edtNotes.Value = tmpSources.Notes
		
		
		*GOTO RECORD RECNO('tmpSources') IN tmpMark
		*ThisForm.grdMark.Refresh
	ENDPROC

ENDDEFINE
