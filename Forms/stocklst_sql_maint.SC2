	PROCEDURE pgFrameProcess.pgEdit.cmdDel.Click
		*Process.pgEdit.cmdDel.Click
		PRIVATE cSQL, nSQLEXEC
		
		IF RECCOUNT("StockLst_Process")=0
			MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
		ELSE
			IF EMPTY(StockLst_Process.ID_Detail_Process)
				MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
			ELSE
				IF MESSAGEBOX("Are you sure you want to delete this Process Record?",4+32,"Confirm Delete") = 6
					
					DO CASE
					CASE ThisForm.Lst = "StockLst"
						cSQL="DELETE FROM dbo.StockLst_Process "
					CASE ThisForm.Lst = "BrokerLst"
						cSQL="DELETE FROM dbo.BrokerLst_Process "
					CASE ThisForm.Lst = "WIPLst"
						cSQL="DELETE FROM dbo.WIPLst_Process "
					OTHERWISE
						TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
						cSQL="DELETE FROM dbo.StockLst_Process "
					ENDCASE 
					cSQL=cSQL+" WHERE ID_detail_Process = "+STR(StockLst_Process.ID_Detail_Process)
					
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF		
		
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					ELSE
						=SQLCOMMIT(ThisForm.nConnHandle)
						THISFORM.ShowProcess()
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgFrameProcess.pgEdit.cmdEdit.Click
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail_Process
		
		IF RECCOUNT("StockLst_Process")=0
			MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
		ELSE
			IF EMPTY(StockLst_Process.ID_Detail_Process)
				MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
			ELSE
				
				DO FORM forms\StockLst_Process  WITH "EDIT", StockLst_Process.ID_Detail_Process, ''     , ''     , ''        , 0   , 0   , ''      , ''      , StockLst_Process.TBL, ''     ,  0, StockLst_Process.ID_Detail,     ''  ,0 TO nReturn
				*                                   cWhatDo,                            pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue,                 pLst, pPoItem, pWO,                pID_Detail, pInqNumP, pWO_Detail
				
				IF TYPE("nReturn") = "N"
					IF nReturn > 0
						THISFORM.ShowProcess(nReturn)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgFrameProcess.pgEdit.cmdNext.Click
		PRIVATE nRecNo
		nRecNo = RECNO("StockLst_Process")
		
		IF NOT EOF("StockLst_Process")
			SKIP 1 IN StockLst_Process
			IF nRecNo = RECNO("StockLst_Process")
				WAIT WINDOW "End of File" NOWAIT
			ENDIF
			IF RECNO("StockLst_Process") > RECCOUNT("StockLst_Process")
				SKIP -1 IN StockLst_Process
				WAIT WINDOW "End of File" NOWAIT
			ENDIF
		ELSE
			WAIT WINDOW "End of File" NOWAIT
		ENDIF
		
		*ThisForm.ShowProcess()
		THISFORM.pgFrameProcess.pgEdit.REFRESH
		
		THISFORM.pgFrameProcess.pgEdit.SOITEM1.REFRESH
