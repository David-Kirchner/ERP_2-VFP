	PROCEDURE pgFrameDetail.pgEdit.chkPrime.Click
		IF TYPE("StockLst_Detail.ID_Detail")="U"
			MESSAGEBOX("Cannot Change."+CHR(13)+"Add First",0,"No record")
		ELSE
			PRIVATE cSQL, nSQLEXEC, lOK, cSQLi
			lOK = .T.
		
			PRIVATE m.lnID, m.nID_Detail
			m.lnID			= StockLst_Master.ID
			m.nID_Detail	= StockLst_Detail.ID_Detail
			
			IF m.lnID = 0
				MESSAGEBOX("Master ID is 0"+CHR(13)+"Something has gone wrong."+CHR(13)+"This Detail with no Master will not be able to be saved!",0+16,"Error -Abort")
				RETURN -1
			ENDIF
		
			*********************
			PRIVATE lPrime
			lPrime = PrepareSQLlogic(This.Value,'Prime')
			
			DO CASE
			CASE ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			CASE ThisForm.Lst = "BrokerLst"
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			CASE ThisForm.Lst = "WIPLst"
				cSQL = "UPDATE dbo.WIPLst_Detail SET "
			OTHERWISE
				TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
				cSQL = cSQL + "UPDATE dbo.StockLst_Detail SET "
			ENDCASE
			IF lPrime
				cSQL = cSQL+ " Prime=1 "
			ELSE
				cSQL = cSQL+ " Prime=0 "
			ENDIF
			cSQL = cSQL+ " WHERE ID_Detail="+STR(m.nID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF		
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				This.Value = !lPrime
				RETURN .F.
			ELSE
				ThisForm.ShowDetail(m.nID_Detail) &&Retrieves from server and refreshes screen
			ENDIF
		
			
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE pgFrameDetail.pgEdit.chkQuarantine.Click
		IF TYPE("StockLst_Detail.ID_Detail")="U"
			MESSAGEBOX("Cannot Change."+CHR(13)+"Add First",0,"No record")
		ELSE
			PRIVATE cSQL, nSQLEXEC, lOK, cSQLi
			lOK = .T.
		
			PRIVATE m.lnID, m.nID_Detail
			m.lnID			= StockLst_Master.ID
			m.nID_Detail	= StockLst_Detail.ID_Detail
			
			IF m.lnID = 0
				MESSAGEBOX("Master ID is 0"+CHR(13)+"Something has gone wrong."+CHR(13)+"This Detail with no Master will not be able to be saved!",0+16,"Error -Abort")
				RETURN -1
			ENDIF
		
			*********************
			PRIVATE lQuarantine
			lQuarantine = PrepareSQLlogic(This.Value,'Quarantine')
			
			DO CASE
			CASE ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			CASE ThisForm.Lst = "BrokerLst"
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			CASE ThisForm.Lst = "WIPLst"
				cSQL = "UPDATE dbo.WIPLst_Detail SET "
			OTHERWISE
				TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
				cSQL = cSQL + "UPDATE dbo.StockLst_Detail SET "
			ENDCASE
			IF lQuarantine 
				cSQL = cSQL+ " Quarantine=1 "
			ELSE
				cSQL = cSQL+ " Quarantine=0 "
			ENDIF
			cSQL = cSQL+ " WHERE ID_Detail="+STR(m.nID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF		
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				This.Value = !lQuarantine
				RETURN .F.
			ELSE
				ThisForm.ShowDetail(m.nID_Detail)	&&Retrieves from server and refreshes screen
			ENDIF
		
			
		ENDIF
		RETURN .T.
	ENDPROC

