	PROCEDURE showdetail
		PARAMETER pnID_Detail
		*ThisForm.ShowDetail(ID_Detail)
		
		
		*********
		PRIVATE lGoodData
		IF USED("Stocklst_Master")
			IF RECCOUNT("Stocklst_Master") > 0
				lGoodData = .T.
			ELSE
				lGoodData = .F.
			ENDIF
		ELSE
			lGoodData = .F.
		ENDIF
		
		IF NOT lGoodData
			MESSAGEBOX("Error retrieving 'StockLst_Master' Data"+CHR(13)+"Press any key to try again!",0,"No Data")
			ThisForm.RefreshMaster(pnID)
		ENDIF
		**********
		
		
		PRIVATE cSQL, nSQLEXEC, nrecCount
		
		ThisForm.StockLst_Detail_RecordSource('OFF')
			
			cSQL = "SELECT"
			cSQL=cSQL+" [size_h]"
		    cSQL=cSQL+",[size_l]"
		    cSQL=cSQL+",[pc]"
		    cSQL=cSQL+",[dim1]"
		    cSQL=cSQL+",[dim2]"
		    cSQL=cSQL+",[dim3]"
		    cSQL=cSQL+",[length]"
		    cSQL=cSQL+",[S_QTY]"
		    cSQL=cSQL+",[S_P]"
		    cSQL=cSQL+",[S_Total]"
		    cSQL=cSQL+",[S_PU]"    
		    
		    cSQL=cSQL+",[descript]"
		    cSQL=cSQL+",[location]"
		    cSQL=cSQL+",[floorstatus]"
		    cSQL=cSQL+",[class]"
			cSQL=cSQL+",[costvalue]"
			cSQL=cSQL+",CAST([Weight] AS DECIMAL(7,1)) AS [weight]"
			
		    cSQL=cSQL+",[RandLen]"
		    cSQL=cSQL+",[InvCheck]"
		    cSQL=cSQL+",[ID]"
		    cSQL=cSQL+",[ID_Detail]"
		    cSQL=cSQL+",[ReceivingID]"
		    cSQL=cSQL+",[InvoiceValue]"
		    cSQL=cSQL+",[LiveCheck]"
		    cSQL=cSQL+",[AccountingCheck]"
		    cSQL=cSQL+",[Quarantine]"
		
		    cSQL=cSQL+",[Prime]"
		    
		DO CASE
		CASE ThisForm.Lst = "StockLst"
		    cSQL=cSQL+",'S' AS TBL"
			cSQL=cSQL+" FROM dbo.StockLst_Detail "
		CASE ThisForm.Lst = "BrokerLst"
		    cSQL=cSQL+",'B' AS TBL"
			cSQL=cSQL+" FROM dbo.BrokerLst_Detail "
		CASE ThisForm.Lst = "WIPLst"
		    cSQL=cSQL+",'W' AS TBL"
			cSQL=cSQL+" FROM dbo.WIPLst_Detail "
		OTHERWISE
			TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
		ENDCASE
		cSQL=cSQL+" WHERE ID = "+STR(StockLst_Master.ID)+" ORDER BY ID_Detail"
		
		
		IF USED("StockLst_Detail")
			USE IN StockLst_Detail
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail' )
		ELSE
		
			IF USED('StockLst_Detail')
				IF RECCOUNT('StockLst_Detail') > 0
					
					ThisForm.pgFrameDetail.Visible = .T.
					
					ThisForm.StockLst_Detail_RecordSource('ON')
		
					IF TYPE("pnID_Detail")= "N"
						IF pnID_Detail > 0
							SELECT StockLst_Detail
							GO TOP
							DO WHILE NOT EOF("StockLst_Detail")
								IF StockLst_Detail.ID_Detail = pnID_Detail
									EXIT
								ENDIF
								SKIP IN StockLst_Detail
							ENDDO
						ENDIF
					ELSE
						*Get Detail
						SELECT StockLst_Detail
						nRecCount = RECCOUNT("StockLst_Detail")
						THISFORM.pgFrameDetail.pgEdit.lblRecCountDetail.Caption = "-"+ALLTRIM(STR(nRecCount))
						GO TOP
					ENDIF
		
					SELECT StockLst_Detail
					IF ThisForm.pgFrameMaster.ActivePage = 1
						THISFORM.pgFrameProcess.pgBrowse.grdProcess.REFRESH	&&Only refresh this for Speed
					ELSE
						THISFORM.pgFrameProcess.pgBrowse.grdProcess.REFRESH
					ENDIF
						
					THISFORM.pgFrameMaster.pgEdit.REFRESH
					ThisForm.pgFrameDetail.pgEdit.chkRandLen.REFRESH
					THISFORM.pgFrameDetail.pgEdit.PC1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.SIZE_H1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Dim11.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Size_L1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Dim21.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Dim31.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Descript1.REFRESH
					ThisForm.pgFrameDetail.pgEdit.S_QTY.Refresh
					ThisForm.pgFrameDetail.pgEdit.S_P.Refresh
					ThisForm.pgFrameDetail.pgEdit.S_PU.Refresh
					THISFORM.pgFrameDetail.pgEdit.CostValue1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Weight1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Length1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.Location1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.FLOORSTATUS1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.CLASS1.REFRESH
					THISFORM.pgFrameDetail.pgEdit.ReceivingID1.REFRESH 
					THISFORM.pgFrameDetail.pgEdit.InvoiceValue1.REFRESH
					ThisForm.pgFrameDetail.pgEdit.chkPrime.REFRESH
					ThisForm.pgFrameDetail.pgEdit.chkQuarantine.REFRESH
					THISFORM.pgFrameDetail.pgEdit.txtID_Detail.REFRESH
					THISFORM.pgFrameDetail.pgEdit.InvCheck.REFRESH
					
					THISFORM.ShowProcess()
					
				ELSE
					ThisForm.pgFrameDetail.Visible = .F.
					ThisForm.pgFrameProcess.Visible = .F.
					*TrackError("No DETAIL record in StockLst_Detail to show"+CHR(13)+cSQL,"No DETAIL record in StockLst_Detail to show", PROGRAM(), LINENO(1))
					WAIT WINDOW "No DETAIL record in StockLst_Detail to show." NOWAIT
					*MESSAGEBOX("No DETAIL record in StockLst_Detail to show.",0,"Error")
				ENDIF
			ELSE
				ThisForm.pgFrameDetail.Visible = .F.
				ThisForm.pgFrameProcess.Visible = .F.
				*TrackError("StockLst_Detail table not found"+CHR(13)+cSQL,"StockLst_Detail table not found", PROGRAM(), LINENO(1))
				MESSAGEBOX("StockLst_Detail table not found.",0,"Error")
			ENDIF
		ENDIF
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE showdetailform
		*ThisForm.ShowDetailForm()
		
		SELECT StockLst_Detail
		ThisForm.pgFrameDetail.pgEdit.Refresh
		ThisForm.pgFrameDetail.ActivePage = 2
		
		
	ENDPROC

	PROCEDURE showmaster
		PARAMETER pnID
		*ThisForm.ShowMaster(nID)
		
		IF TYPE("pnID") = "C"
			pnID = VAL( ALLTRIM(pnID) )
		ENDIF
		
		*********
		PRIVATE lGoodData
		IF USED("Stocklst_Master")
			IF RECCOUNT("Stocklst_Master") > 0
				lGoodData = .T.
			ELSE
				lGoodData = .F.
			ENDIF
		ELSE
			lGoodData = .F.
		ENDIF
		
		IF NOT lGoodData
			MESSAGEBOX("Error retrieving 'StockLst_Master' Data"+CHR(13)+"Press any key to try again!",0,"No Data")
			ThisForm.RefreshMaster(pnID)
		ENDIF
		**********
		
		IF TYPE("pnID") = "N"
			IF pnID > 0
				SELECT StockLst_Master
				LOCATE FOR ID = pnID
		
		*		SEEK pnID ORDER TAG ID IN StockLst_Master
				IF NOT FOUND()
					WAIT WINDOW "No ID number to Show - Not Located" NOWAIT
					RETURN
				ENDIF	
			ELSE
				WAIT WINDOW "No ID number to Show, pnID = 0" NOWAIT
				RETURN
			ENDIF
		ELSE
			WAIT WINDOW "No ID number to Show, no pnID" NOWAIT
			RETURN
		ENDIF
		
		ThisForm.LockScreen = .T.
		
		IF ThisForm.pgFrameMaster.ActivePage = 1
			ThisForm.pgFrameMaster.pgBrowse.grdMast.Refresh  &&Only refresh for speed
		ELSE
			ThisForm.pgFrameMaster.pgBrowse.grdMast.Refresh
			
			ThisForm.pgFrameMaster.pgEdit.ALLOY1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Form1.Refresh
			ThisForm.pgFrameMaster.pgEdit.CC1.Refresh
			ThisForm.pgFrameMaster.pgEdit.CL1.Refresh
			ThisForm.pgFrameMaster.pgEdit.CCCL1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Cond1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Size1.Refresh
			ThisForm.pgFrameMaster.pgEdit.MWeight1.Refresh
			ThisForm.pgFrameMaster.pgEdit.mS_QTY1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Paid1.Refresh
			ThisForm.pgFrameMaster.pgEdit.specs1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Heat1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Lot1.Refresh
			ThisForm.pgFrameMaster.pgEdit.PO_Item1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Mill1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Melt1.Refresh
			ThisForm.pgFrameMaster.pgEdit.Num1.Refresh
			ThisForm.pgFrameMaster.pgEdit.FROM_ID1.Refresh
			ThisForm.pgFrameMaster.pgEdit.History1.Refresh
			ThisForm.pgFrameMaster.pgEdit.ProjID1.Refresh
			ThisForm.pgFrameMaster.pgEdit.POdueDate1.Refresh
			ThisForm.pgFrameMaster.pgEdit.StkDate1.Refresh
			ThisForm.pgFrameMaster.pgEdit.BrandName1.Refresh
			
		ENDIF
		*ThisForm.cmbAlloy.Value = ThisForm.pgFrameMaster.pgEdit.ALLOY1.Value
		*ThisForm.cmbAlloy.Refresh
		
		ThisForm.LockScreen = .F.
		
		ThisForm.ShowDetail()
	ENDPROC

	PROCEDURE showprocess
		PARAMETER pnID_Detail_Process
		
		ThisForm.pgFrameProcess.pgBrowse.grdProcess.RECORDSOURCE = ""
		PRIVATE cSQL, nSQLEXEC 
		
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL= "SELECT *, 'S' AS TBL FROM dbo.StockLst_Process "
		CASE ThisForm.Lst = "BrokerLst"
			cSQL= "SELECT *, 'B' AS TBL FROM dbo.BrokerLst_Process "
		CASE ThisForm.Lst = "WIPLst"
			cSQL= "SELECT *, 'W' AS TBL FROM dbo.WIPLst_Process "
		OTHERWISE
			TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
			cSQL= "SELECT *, 'S' AS TBL FROM dbo.StockLst_Process "
		ENDCASE
		cSQL= cSQL+ "WHERE ID_detail = "+STR(StockLst_Detail.ID_Detail)+" ORDER BY ID_Detail_Process"
			
		IF USED("StockLst_Process")
			USE IN StockLst_Process
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process')
		ELSE
		
			IF USED('StockLst_Process')
				IF RECCOUNT('StockLst_Process') > 0
					
					ThisForm.pgFrameProcess.Visible = .T.
					ThisForm.pgFrameProcess.pgBrowse.grdProcess.RECORDSOURCE = "StockLst_Process"
		
					IF TYPE("pnID_Detail_Process")= "N"
						IF pnID_Detail_Process > 0
							SELECT StockLst_Process
							GO TOP
							DO WHILE NOT EOF("StockLst_Process")
								IF StockLst_Process.ID_Detail_Process = pnID_Detail_Process
									EXIT
								ENDIF
								SKIP IN StockLst_Process
							ENDDO
						ENDIF
					ENDIF	
					IF THISFORM.pgFrameProcess.ActivePage = 1
						THISFORM.pgFrameProcess.pgBrowse.REFRESH	&&Only refresh this fro Speed
					ELSE
						THISFORM.pgFrameProcess.pgBrowse.REFRESH
						
						THISFORM.pgFrameProcess.pgEdit.REFRESH
						THISFORM.pgFrameProcess.pgEdit.SOITEM1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.SalesPerson1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.StartDate1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.Process_ID1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.Processor1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.DueDate1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.Comment1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.AllowSub1.REFRESH
						
						THISFORM.pgFrameProcess.pgEdit.Pounds1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.Prc_PCs1.REFRESH
						THISFORM.pgFrameProcess.pgEdit.txtID_Detail_Process.REFRESH
						THISFORM.pgFrameProcess.pgEdit.ReceivingID1.Refresh
						THISFORM.pgFrameProcess.pgEdit.WO1.Refresh
					ENDIF
		
				ELSE
					*Blank the Process window
					ThisForm.pgFrameProcess.Visible = .F.
					*TrackError("No PROCESS record in StockLst_Process to show"+CHR(13)+cSQL,"No PROCESS record in StockLst_Process to show", PROGRAM(), LINENO(1))
					*MESSAGEBOX("No PROCESS record in StockLst_Process to show",0,"Error")
				ENDIF
			ELSE
				ThisForm.pgFrameProcess.Visible = .F.
				*TrackError("StockLst_Process table not found"+CHR(13)+cSQL,"StockLst_Process table not found", PROGRAM(), LINENO(1))
				MESSAGEBOX("StockLst_Process table not found",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE stocklst_detail_recordsource
		PARAMETER pWhat
		*ThisForm.StockLst_Detail_recordSource('')
		
		IF TYPE("pWhat") != "C"
			RETURN
		ENDIF
		
		IF pWhat = "OFF"
			ThisForm.pgFrameDetail.pgBrowse.grdDetail.RECORDSOURCE = ""
		
			ThisForm.pgFrameDetail.pgEdit.SIZE_H1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Size_L1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.PC1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Dim11.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Dim21.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Dim31.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Length1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.S_QTY.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.S_P.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.S_PU.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.CostValue1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Weight1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Descript1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.Location1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.FLOORSTATUS1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.CLASS1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.ReceivingID1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.InvoiceValue1.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.chkPrime.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.chkQuarantine.ControlSource = ""
			ThisForm.pgFrameDetail.pgEdit.InvCheck.ControlSource = ""
		
		ENDIF
		IF pWhat = "ON"
			ThisForm.pgFrameDetail.pgBrowse.grdDetail.RECORDSOURCE = "StockLst_Detail"
		
			ThisForm.pgFrameDetail.pgEdit.SIZE_H1.ControlSource = "StockLst_Detail.SIZE_H"
			ThisForm.pgFrameDetail.pgEdit.Size_L1.ControlSource = "StockLst_Detail.Size_L"
			ThisForm.pgFrameDetail.pgEdit.PC1.ControlSource 	= "StockLst_Detail.PC"
			ThisForm.pgFrameDetail.pgEdit.Dim11.ControlSource 	= "StockLst_Detail.Dim1"
			ThisForm.pgFrameDetail.pgEdit.Dim21.ControlSource	= "StockLst_Detail.Dim2"
			ThisForm.pgFrameDetail.pgEdit.Dim31.ControlSource	= "StockLst_Detail.Dim3"
			ThisForm.pgFrameDetail.pgEdit.Length1.ControlSource = "StockLst_Detail.Length"
			ThisForm.pgFrameDetail.pgEdit.S_QTY.ControlSource	= "StockLst_Detail.S_QTY"
