	PROCEDURE Unload
		IF USED("StockLst_Process")
			USE IN StockLst_Process
		ENDIF
		
		IF USED("StockLst_Detail")
			USE IN StockLst_Detail
		ENDIF
		
		IF USED("StockLst_Master")
			USE IN StockLst_Master
		ENDIF
		
		IF ThisForm.lSetConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		*	RELEASE gnConnHandle
		ENDIF
		
	ENDPROC

	PROCEDURE cmbAlloy.Init
		*#DEFINE ALLAlloy_LOC "(All)"
		this.clear
		*this.additem(ALLAlloy_LOC)
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		SELECT DISTINCT alloy FROM StockLst_Master WHERE !EMPTY(alloy) ORDER BY Alloy INTO array aAlloys
		
		FOR EACH m.cAlloy IN aAlloys
			IF !EMPTY(m.cAlloy)
				this.additem(m.cAlloy)
			ENDIF
		ENDFOR
		
		*THIS.VALUE = ALLAlloy_LOC
		IF TYPE('aAlloys(1)') = 'C'
			THIS.VALUE = aAlloys(1)
		ELSE
			THIS.VALUE = ''
		ENDIF
		
		*ThisForm.DispAlloyFilter=aAlloys(1)
	ENDPROC

	PROCEDURE cmbAlloy.Valid
		LOCAL cDisplayValue
		PRIVATE mSQL
		*THISFORM.LockScreen = .T.
		
		*ThisForm.grdVacation.RecordSource = ""
		*SELECT Vacation
		
		*IF THIS.Value = "(All)"
