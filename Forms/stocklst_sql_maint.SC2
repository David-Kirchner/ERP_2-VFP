	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pnID,pnID_Detail,pcTBL
		*DO FORM Forms\stocklst_sql_maint WITH nID,nID_Detail
		
		PRIVATE nID,nID_Detail,cTBL
		nID		= PrepareSQLnum(pnID,'ID',-3)
		nID_Detail = PrepareSQLnum(pnID_Detail,'ID_Detail',-3)
		cTBL	= UPPER(PrepareSQLtxt(pcTBL,'TBL',1))
		IF EMPTY(cTBL)
			cTBL= 'S'
		ENDIF
		
		
		*ThisForm.ShowMaster()
		ThisForm.RefreshMasterEdit()
		ThisForm.cmbAlloy.Value = stocklst_master.Alloy
		
		*****************************
		DO CASE
		CASE cTBL = "S"
			ThisForm.ogTable.Value = 1
			ThisForm.Lst = "StockLst"
			ThisForm.Caption = "Stock List Maintenance "
			*ThisForm.ReloadSQL()
		CASE cTBL = "B"
			ThisForm.ogTable.Value = 2
			ThisForm.Lst = "BrokerLst"
			ThisForm.Caption = "Broker List Maintenance "
			ThisForm.ReloadSQL()
		CASE cTBL = "W"
			ThisForm.ogTable.Value = 3
			ThisForm.Lst = "WIPLst"
			ThisForm.Caption = "WIP List Maintenance "
			ThisForm.ReloadSQL()
		ENDCASE
		
		*****************************
		IF nID_Detail > 0
			ThisForm.txtID_Detail.Value = nID_Detail
			ThisForm.txtID_Detail.Valid
		ELSE
			IF nID > 0
				ThisForm.txtID.Value = nID
				ThisForm.txtID.Valid
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		PRIVATE  lOK
		lOK = .F.
		
		PRIVATE cSQL, nSQLEXEC
		
		IF NOT "PROC_SETUP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_SETUP ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_rtr ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		cSQL="SELECT"
		cSQL=cSQL+" [alloy]"
		cSQL=cSQL+",[form]"
		
		cSQL=cSQL+",dbo.f_CC_CLsort(CC,CL) AS CCCL "
		cSQL=cSQL+",[size]"
		cSQL=cSQL+",[cond]"
		
		cSQL=cSQL+",CAST(mS_QTY AS DECIMAL(9,1)) AS mS_QTY"
		cSQL=cSQL+",[specs]"
		cSQL=cSQL+",[heat]"
		cSQL=cSQL+",[lot]"
		cSQL=cSQL+",[Paid]"
		cSQL=cSQL+",[po_item]"
		cSQL=cSQL+",[poduedate]"
		cSQL=cSQL+",[mill]"
		cSQL=cSQL+",[Melt]"
		cSQL=cSQL+",[stkdate]"
		cSQL=cSQL+",[history]"
		cSQL=cSQL+",[num]"
		cSQL=cSQL+",[POStatus]"
		cSQL=cSQL+",[BrandName]"
		cSQL=cSQL+",[FROM_ID]"
		cSQL=cSQL+",[id]"
		
		cSQL=cSQL+",CAST(mWeight AS DECIMAL(9,1)) AS MWeight"
		cSQL=cSQL+",[CC]"
		cSQL=cSQL+",[CL]"
		
		cSQL=cSQL+",ISNULL([WO_Detail],0) AS WO_Detail"
		cSQL=cSQL+",ISNULL([ProjID],0) AS ProjID"
		
		cSQL=cSQL+" FROM dbo.StockLst_Master "
		cSQL=cSQL+" ORDER BY [Alloy],[Form],[CC],[Size] "
		
		IF USED('StockLst_Master')
			USE IN StockLst_Master
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master')
		ELSE
		
			SELECT StockLst_Master
			INDEX ON Alloy TAG Alloy
			INDEX ON Alloy+FORM TAG AlloyForm
		*	INDEX ON Alloy+FORM+STR(CCSortValue(CC),2,1)+STR(Size,9,3) TAG StockLst 
		*	INDEX ON Alloy+FORM+CC+STR(Size,9,3) TAG StockLst 
		*	INDEX ON Alloy+Form+CC_CLsort(CC,CL,ThisForm.nConnHandle)+STR(Size,9,3) TAG StockLst
			INDEX ON Alloy+Form+CCCL+STR(Size,9,3) TAG StockLst
			INDEX ON Alloy+FORM+STR(Size,9,3) TAG AllFrmSz
			INDEX ON Alloy+FORM+COND+STR(SIZE,9,3)+HEAT TAG AFCSH
			INDEX ON Heat TAG Heat
			
		*	INDEX ON Alloy+STR(GetFormSort(Form, ThisForm.nConnHandle),2,0)+STR(SIZE,9,3) TAG StockLst
		*	INDEX ON Alloy+STR(FormSort,2,0)+STR(CCSortValue,2,0)+STR(SIZE,9,3) TAG StockLstCC
		
				
			SET ORDER TO TAG StockLst
			
			***************
				
			cSQL = "SELECT"
			cSQL=cSQL+" [size_h]"
		    cSQL=cSQL+",[size_l]"
		    cSQL=cSQL+",[pc]"
		    cSQL=cSQL+",[dim1]"
		    cSQL=cSQL+",[dim2]"
		    cSQL=cSQL+",[dim3]"
		    cSQL=cSQL+",[length]"
		    cSQL=cSQL+",[S_QTY]"
		    cSQL=cSQL+",[S_P]"
		    cSQL=cSQL+",[S_Total]"
		    cSQL=cSQL+",[S_PU]"
		       
		    cSQL=cSQL+",[descript]"
		    cSQL=cSQL+",[location]"
		    cSQL=cSQL+",[floorstatus]"
		    cSQL=cSQL+",[class]"
			cSQL=cSQL+",[costvalue]"
			cSQL=cSQL+",CAST([Weight] AS DECIMAL(7,1)) AS [weight]"
			
		    cSQL=cSQL+",[RandLen]"
		    cSQL=cSQL+",[InvCheck]"
		    cSQL=cSQL+",[id]"
		    cSQL=cSQL+",[id_detail]"
		    cSQL=cSQL+",[ReceivingID]"
		    cSQL=cSQL+",[InvoiceValue]"
		    cSQL=cSQL+",[LiveCheck]"
		    cSQL=cSQL+",[AccountingCheck]"
		    cSQL=cSQL+",[Quarantine]"
		
		    cSQL=cSQL+",[Prime]"
		    cSQL=cSQL+",'S' AS TBL"
			cSQL=cSQL+" FROM dbo.StockLst_Detail WHERE ID = "+STR(StockLst_Master.ID)+" ORDER BY ID_Detail"
		
			IF USED("StockLst_Detail")
				USE IN StockLst_Detail
			ENDIF
			SELECT 0
			
			*cSQL="SELECT * FROM StockLst_Detail ORDER BY ID"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail')
			ELSE
				SELECT StockLst_Detail
				
				INDEX ON ID TAG DetailID
				SET ORDER TO DetailID
				
				*SET RELATION TO ID INTO StockLst_Detail IN StockLst_Master
		
		
				cSQL = "SELECT *, 'S' AS TBL FROM dbo.StockLst_Process WHERE ID_detail = "+;
					STR(StockLst_Detail.ID_Detail)+" ORDER BY ID_Detail_Process"
		
				IF USED("StockLst_Process")
					USE IN StockLst_Process
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process')
				ELSE
					lOK = .T.
					SELECT StockLst_Process
					INDEX ON ID_Detail TAG ID_Detail
					SET ORDER TO ID_Detail
				ENDIF
			ENDIF
		ENDIF
		
		IF lOK
		
		ELSE
			= MESSAGEBOX('Error getting Data!'+CHR(13)+"Closing NOW!", 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE refreshmaster
		PARAMETER pnID
		*ThisForm.RefreshMaster(pnID)
		
		PRIVATE nStockLst_Master_ID
		nStockLst_Master_ID = 0
		
		PRIVATE cSQL
		PRIVATE nSQLEXEC
		
		cSQL="SELECT"
		cSQL=cSQL+" [alloy]"
		cSQL=cSQL+",[form]"
		
		cSQL=cSQL+",dbo.f_CC_CLsort(CC,CL) AS CCCL "
		cSQL=cSQL+",[size]"
		cSQL=cSQL+",[cond]"
		
		cSQL=cSQL+",CAST(mS_QTY AS DECIMAL(9,1)) AS mS_QTY"
		cSQL=cSQL+",[specs]"
		cSQL=cSQL+",[heat]"
		cSQL=cSQL+",[lot]"
		cSQL=cSQL+",[Paid]"
		cSQL=cSQL+",[po_item]"
		cSQL=cSQL+",[poduedate]"
		cSQL=cSQL+",[mill]"
		cSQL=cSQL+",[STKdate]"
		cSQL=cSQL+",[history]"
		cSQL=cSQL+",[num]"
		cSQL=cSQL+",[POStatus]"
		cSQL=cSQL+",[BrandName]"
		cSQL=cSQL+",[FROM_ID]"
		cSQL=cSQL+",[Melt]"
		cSQL=cSQL+",[id]"
		
		cSQL=cSQL+",CAST(mWeight AS DECIMAL(9,1)) AS MWeight"
		cSQL=cSQL+",[CC]"
		cSQL=cSQL+",[CL]"
		
		cSQL=cSQL+",ISNULL([WO_Detail],0) AS WO_Detail"
		cSQL=cSQL+",ISNULL([ProjID],0) AS ProjID"
		
		
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL=cSQL+" FROM dbo.StockLst_Master " 
		CASE ThisForm.Lst = "BrokerLst"
			cSQL=cSQL+" FROM dbo.BrokerLst_Master " 
		CASE ThisForm.Lst = "WIPLst"
			cSQL=cSQL+" FROM dbo.WIPLst_Master " 
		OTHERWISE
			TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
			cSQL = cSQL + " FROM dbo.StockLst_Master "
		ENDCASE
		
		ThisForm.pgFrameMaster.pgBrowse.grdMast.recordSource = "" &&stocklst_master
		
		IF USED('StockLst_Master')
			USE IN StockLst_Master
		ENDIF
		SELECT 0
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master')
		ELSE
			IF USED('StockLst_Master')
				IF RECCOUNT('StockLst_Master') > 0
		
					WAIT WINDOW "Refreshing Master List" NOWAIT
					**Also Change in ThisForm.ReloadSQL
					SELECT StockLst_Master
					INDEX ON ID TAG ID
					INDEX ON Alloy TAG Alloy
					INDEX ON Alloy+FORM TAG AlloyForm
				*	INDEX ON Alloy+Form+STR(CCSortValue(CC),2,1)+STR(Size,9,3) TAG StockLst
				*	INDEX ON Alloy+Form+CC+STR(Size,9,3) TAG StockLst
				*	INDEX ON Alloy+Form+CC_CLsort(CC,CL,ThisForm.nConnHandle)+STR(Size,9,3) TAG StockLst
					INDEX ON Alloy+Form+CCCL+STR(Size,9,3) TAG StockLst
					INDEX ON Alloy+FORM+STR(Size,9,3) TAG AllFrmSz
					INDEX ON Alloy+FORM+COND+STR(SIZE,9,3)+HEAT TAG AFCSH
					INDEX ON Heat TAG Heat
					INDEX ON Lot TAG LOT
					
				*	INDEX ON Alloy+STR(FormSort,2,0)+STR(CCSortValue,2,0)+STR(SIZE,9,3) TAG StockLstCC
				*	INDEX ON Alloy+STR(GetFormSort(Form, ThisForm.nConnHandle),2,0)+STR(SIZE,9,3) TAG StockLst
						
					SET ORDER TO TAG StockLst
					
					ThisForm.pgFrameMaster.pgBrowse.grdMast.recordSource = "Stocklst_Master"
					nStockLst_Master_ID = PrepareSQLnum(StockLst_Master.ID,'ID',-3)
				
					
					PRIVATE cTBL
					cTBL = TBL_TableName(ThisForm.Lst)
					IF Count_Lst_by_ID(cTBL,nStockLst_Master_ID, ThisForm.nConnHandle) = 0
						*No Detail exists!
						ThisForm.pgFrameDetail.Visible = .F.
						ThisForm.pgFrameProcess.Visible = .F.
						*TrackError("No DETAIL record in StockLst_Detail to show"+CHR(13)+"TBL="+cTBL+" ID="+STR(nStockLst_Master_ID)+CHR(13)+cSQL,"No DETAIL record in StockLst_Detail to show", PROGRAM(), LINENO(1))
						MESSAGEBOX("No DETAIL record in StockLst_Detail to show"+CHR(13)+CHR(13)+"Do you need to Delete the Master record?",0,"Error")
						
						ThisForm.StockLst_Detail_RecordSource("OFF")
					ELSE
						
						IF TYPE("pnID") = "N"
							IF pnID > 0
								IF nStockLst_Master_ID <> pnID
									ThisForm.ShowMaster(pnID)
								ELSE
									ThisForm.ShowDetail(pnID)
								ENDIF
							ELSE
								ThisForm.ShowDetail()
							ENDIF
						ELSE
							ThisForm.ShowDetail()
						ENDIF
						
					ENDIF
				ELSE
					TrackError("No MASTER record in Stocklst_Master to show"+CHR(13)+cSQL,"No MASTER record in Stocklst_Master to show", PROGRAM(), LINENO(1))
					MESSAGEBOX("No MASTER record in Stocklst_Master to show",0,"Error")
				ENDIF
			ELSE
				TrackError("Stocklst_Master table not found"+CHR(13)+cSQL,"Stocklst_Master table not found", PROGRAM(), LINENO(1))
				MESSAGEBOX("Stocklst_Master table not found",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refreshmasterbrowse
		ThisForm.pgFrameDetail.pgBrowse.grdDetail.refresh
	ENDPROC

