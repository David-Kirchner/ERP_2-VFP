	PROCEDURE pgFrameMaster.pgBrowse.cmdMasterAdd.Click
		
		*MESSAGEBOX("The 'Add Master' from StockLst Maintenance"+CHR(13)+"has been disbled."+CHR(13)+"Use the ERP menu Sales\Receiving"+CHR(13)+"Not allowed here Add here!",48,"Must Receive")
		
		PRIVATE nReturn, nMasterID, nReturnD
		nReturn = 0 &&ID
		nMasterID = StockLst_Master.ID
		
		*IF MESSAGEBOX("Is this a completly new ADD?"+CHR(13)+CHR(13)+;
			"If no, this ID will be saved to the new record in the From_ID field,"+CHR(13)+;
			"so the add record will be able to reference back to the origen."+CHR(13)+;
			[EXAMPLE: Forged 6B worked from 3" is NOT a NEW Add.],4+32,"New ADD is not related to this record.") = 6 &&Yes
		*	
			nMasterID = 0
		*ELSE
		*	nMasterID = StockLst_Master.ID
		*ENDIF
			
		DO FORM Forms\StockLst_Master WITH "ADD", nMasterID, ThisForm.Lst TO nReturn
		
		IF TYPE("nReturn") = "N"
			IF nReturn > 0
		 		THISFORM.RefreshMaster(nReturn)
		 		
				nReturnD = 0 &&ID_Detail
				DO FORM Forms\StockLst_Detail WITH "ADD", StockLst_Master.ID, 0, ThisForm.Lst, 0 TO nReturnD
		
				IF TYPE("nReturnD") = "N"
					IF nReturnD > 0
				 		ThisForm.ShowDetail(nReturnD)
					ENDIF
				ENDIF
		
			ENDIF
			
			ThisForm.ShowMaster(stocklst_master.ID)
			ThisForm.cmbAlloy.Value = stocklst_master.Alloy
			
		ENDIF
		
	ENDPROC

	PROCEDURE pgFrameMaster.pgBrowse.cmdMasterDelete.Click
		PRIVATE cSQL_Delete, cSQL, nSQLEXEC
		PRIVATE nNextID,nID, cPOitem
		nNextID = 0
		nID = PrepareSQLnum(StockLst_Master.ID,'ID_Master',-3)
		cPOitem = PrepareSQLtxt(StockLst_Master.PO_item, 'POitem',12)
		
		PRIVATE cMess
		cMess="Are you sure you want to 'Delete'? "+CHR(13)
		cMess=cMess+"ID:"+ALLTRIM(STR(nID))+CHR(10)+CHR(13)
		cMess=cMess+"PO item:"+cPOitem
		*cMess=cMess+HTML_POitem(cPOitem,.F.)+CHR(10)+CHR(13)
		cMess=cMess+"Detail records will also be deleted."
		IF MESSAGEBOX(cMess,4+32,"Delete")= 7	
			RETURN
		ENDIF
		
		PRIVATE cTBL
		cTBL = TBL_TableName(ThisForm.Lst)
		
		IF NOT EOF('stocklst_master')
			SELECT stocklst_master
			SET ORDER TO TAG StockLst IN StockLst_Master
			
			SKIP 1 IN stocklst_master
			nNextID = StockLst_Master.ID
			SKIP -1 IN StockLst_Master
		ENDIF
				
		IF EMPTY(StockLst_Master.ID)
			MESSAGEBOX("Cannot Delete",0,"No record")
			RETURN
		ENDIF
		
		IF USED('tmpCountDetail')
			USE IN tmpCountDetail
		ENDIF
		
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Detail "
		CASE ThisForm.Lst = "BrokerLst"
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.BrokerLst_Detail "
		CASE ThisForm.Lst = "WIPLst"
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WIPLst_Detail "
		OTHERWISE
			TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
			cSQL = cSQL + "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Detail "
		ENDCASE	
		cSQL = cSQL + "	WHERE ID = "+ STR(nID)
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountDetail' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountDetail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF		
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountDetail')
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
			RETURN .F.
		ENDIF
		
				
		IF tmpCountDetail.cnt > 1
			
			cMess = "Found "+ALLTRIM(STR( tmpCountDetail.cnt ))+" Detail records that belong to this Master."+CHR(13)
			cMess=cMess+"Please remove details first!"+CHR(13)
			cMess=cMess+"Not Allowed to delete a master when it has many details."
			MESSAGEBOX(cMess,0+16,"Cannot Delete")
			
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
		
		ELSE
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
		
			PRIVATE cReason
			cReason = ""
			DO FORM Forms\AnswerForm WITH "Why do you want to Delete?","Not Found", 100 TO cReason
			
			IF TYPE("cReason") = "C"
				cReason = ALLTRIM(cReason)
			ELSE
				cReason = ""
			ENDIF
			
			IF Remove_Lst_ID(cTBL,StockLst_Master.ID,ThisForm.nConnHandle,.T.,'',cReason) &&Proc_ERP
				ThisForm.ReloadSQL()
			ENDIF
				
			ThisForm.ShowMaster(nNextID)
			
			ThisForm.cmbAlloy.Value = stocklst_master.Alloy
			
			*THISFORM.RefreshMaster(nNextID)
			
		*	IF ThisForm.pgFrameMaster.ActivePage = 2
		*		ThisForm.pgFrameMaster.ActivePage = 1
		*	ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE pgFrameMaster.pgBrowse.cmdMasterEdit.Click
		PRIVATE nReturn, nCurrID
		nReturn = 0 &&ID
		nCurrID = PrepareSQLnum(StockLst_Master.ID,'Master_ID',-3)
		
		IF RECCOUNT("StockLst_Master")=0
			MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
		ELSE
			IF nCurrID  = 0
				MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
			ELSE
				DO FORM Forms\StockLst_Master WITH "EDIT", nCurrID, ThisForm.Lst TO nReturn
		
				IF TYPE("nReturn") = "N"
					IF nReturn < 0
						*Broker was moved to Stock
						ThisForm.Lst = "StockLst"
						ThisForm.ogTable.Value = 1
						ThisForm.Caption = "Stock List Maintenance "
						ThisForm.ReloadSQL()
						THISFORM.RefreshMaster(-nReturn)				
					ENDIF
					IF nReturn > 0
						*ThisForm.ReloadSQL()
						THISFORM.RefreshMaster(nReturn)
					ENDIF
		
				ENDIF
				
				ThisForm.ShowMaster(stocklst_master.ID)
				ThisForm.cmbAlloy.Value = stocklst_master.Alloy
		
			ENDIF
		ENDIF
	ENDPROC

