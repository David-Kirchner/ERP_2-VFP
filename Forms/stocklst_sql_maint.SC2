	PROCEDURE pgFrameDetail.pgEdit.cmdClone.Click
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail
		
		DO FORM Forms\StockLst_Detail WITH "CLONE", Stocklst_Detail.ID_Detail, 0, ThisForm.Lst, 0 TO nReturn
		
		IF TYPE("nReturn") = "N"
			IF nReturn > 0
				ThisForm.RefreshMaster(StockLst_Master.ID)
		 		ThisForm.ShowDetail(nReturn)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pgFrameDetail.pgEdit.cmdDetailAdd.Click
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail
		
		DO FORM Forms\StockLst_Detail WITH "ADD", StockLst_Master.ID, 0, ThisForm.Lst, 0  TO nReturn
		
		IF TYPE("nReturn") = "N"
			IF nReturn > 0
				ThisForm.RefreshMaster(StockLst_Master.ID)
		 		ThisForm.ShowDetail(nReturn)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pgFrameDetail.pgEdit.cmdDetailBreak.Click
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail
		
		IF RECCOUNT("StockLst_Detail")=0
			MESSAGEBOX("Cannot Break Detail"+CHR(13)+"Add First",0,"No record")
		ELSE
			IF EMPTY(StockLst_Detail.ID_Detail)
				MESSAGEBOX("Cannot Break Detail"+CHR(13)+"Add First",0,"No record")
			ELSE
				DO FORM Forms\StockLst_Detail WITH "BREAK", StockLst_Detail.ID_Detail, 0, ThisForm.Lst, 0 TO nReturn
				*PARAMETER cWhatDo, nID, nProcessID, pLst, pReceivingID 
				*RETURNS ID_Detail
				
				IF TYPE("nReturn") = "N"
					IF nReturn > 0
						*ThisForm.Showmaster(nReturn)		
						THISFORM.ShowDetail(nReturn)
					ENDIF
					IF nReturn = 0
						*Abort -refresh incase it was just a 'Inventory Checked'
						THISFORM.ShowDetail(StockLst_Detail.ID_Detail)
					ENDIF
					IF nReturn < 0
						nReturn  = -nReturn &&ReturnID_Detail to positive
						*Moved from Broker to Stock
						ThisForm.Lst = "StockLst"
						ThisForm.Caption = "StockLst Maintenance "
						ThisForm.ogTable.Value = 1
						*ThisForm.ReloadSQL()
						
						PRIVATE nID
						nID = Get_ID_by_ID_Detail(nReturn,'StockLst',ThisForm.nConnHandle)
						ThisForm.RefreshMaster(nID)
						THISFORM.ShowDetail(nReturn)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgFrameDetail.pgEdit.cmdDetailDelete.Click
		PRIVATE cSQL_Delete, cSQL, nSQLEXEC
		
		
		IF EMPTY(StockLst_Detail.ID_Detail)
			MESSAGEBOX("Cannot Delete",0,"No record")
		ELSE
			*Check for Process before Allowing Delete
			IF USED('tmpCountProcess')
				USE IN tmpCountProcess
			ENDIF
			SELECT 0
			DO CASE
			CASE ThisForm.Lst = "StockLst"
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Process "
			CASE ThisForm.Lst = "BrokerLst"
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.BrokerLst_Process "
			CASE ThisForm.Lst = "WIPLst"
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WIPLst_Process "
			OTHERWISE
				TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
				cSQL = cSQL + " SELECT COUNT(*) AS CNT FROM dbo.StockLst_Process "	
			ENDCASE
			cSQL = cSQL + " WHERE ID_Detail = "+ STR(StockLst_Detail.ID_Detail)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountProcess' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountProcess' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountProcess")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountProcess")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF		
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountProcess')
			ENDIF
		
			IF USED('tmpCountProcess')
				IF tmpCountProcess.CNT > 0
					MESSAGEBOX("A process record is dependant on this Detail record."+CHR(13)+;
						"You must remove the process record first.",0,"You cannot delete!")
				ELSE
					IF MESSAGEBOX("Are you sure you want to delete this Detail Record?",4+32,"Confirm Delete") = 6
						
						
						PRIVATE cReason
						cReason = ""
						DO FORM Forms\AnswerForm WITH "Why do you want to Delete?","Not Found", 100 TO cReason
						
						IF TYPE("cReason") = "C"
							cReason = ALLTRIM(cReason)
						ELSE
							cReason = ""
						ENDIF
						
						IF Remove_Lst_Detail_by_ID_Detail(TBL_TableName(ThisForm.Lst),StockLst_Detail.ID_Detail,ThisForm.nConnHandle,.T.,cReason) &&Proc_ERP
						
							ThisForm.RefreshMaster(StockLst_Master.ID)
							THISFORM.ShowDetail()
							
						ELSE
							MESSAGEBOX("Delete failed",0,"Error")
						ENDIF
						
		
					ENDIF
		
				ENDIF
				USE IN tmpCountProcess
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pgFrameDetail.pgEdit.cmdDetailEdit.Click
		PRIVATE nReturn, nID_Detail
		nReturn = 0 &&ID_Detail
		nID_Detail = PrepareSQLnum(StockLst_Detail.ID_Detail,'ID_Detail',-3)
		
		IF RECCOUNT("StockLst_Detail")=0
			MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
		ELSE
			IF nID_Detail = 0
				MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
			ELSE
				DO FORM Forms\StockLst_Detail WITH "EDIT", nID_Detail, 0, ThisForm.Lst, StockLst_Detail.ReceivingID TO nReturn
				*PARAMETER cWhatDo, nID, nProcessID, pLst, pReceivingID 
				*RETURNS ID_Detail
				
				IF TYPE("nReturn") = "N"
					IF nReturn > 0
						*ThisForm.Showmaster(nReturn)		
						THISFORM.ShowDetail(nReturn)
					ENDIF
					IF nReturn = 0
						*Abort -refresh incase it was just a 'Inventory Checked'
						THISFORM.ShowDetail(StockLst_Detail.ID_Detail)
					ENDIF
					IF nReturn < 0
						nReturn  = -nReturn &&ReturnID_Detail to positive
						*Moved from Broker to Stock
						*What about WIP ???
						ThisForm.Lst = "StockLst"
						ThisForm.Caption = "Stock List Maintenance "
						ThisForm.ogTable.Value = 1
						
						THISFORM.ShowDetail(nReturn)
					ENDIF
					
					IF nReturn <> 0
						PRIVATE nID
						nID = Get_ID_by_ID_Detail(nReturn,'StockLst',ThisForm.nConnHandle)
						ThisForm.RefreshMaster(nID)
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgFrameDetail.pgEdit.cmdDetailHistory.Click
		IF RECCOUNT("StockLst_Detail")=0
			MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
		ELSE
			IF EMPTY(StockLst_Detail.ID_Detail)
				MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
			ELSE
			
				PRIVATE nTBL,cTBL
				nTBL = ThisForm.ogTable.Value
				DO CASE
				CASE nTBL = 1
					cTBL = 'S'
				CASE nTBL = 2
					cTBL = 'B'
				CASE nTBL = 3
					cTBL = 'W'
				ENDCASE
				
				DO FORM Forms\StockLst_History WITH cTBL,0,StockLst_Detail.ID_Detail
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pgFrameDetail.pgEdit.cmdMarkInvChecked.Click
		IF TYPE("StockLst_Detail.ID_Detail")="U"
			MESSAGEBOX("Cannot mark."+CHR(13)+"Add First",0,"No record")
		ELSE
			PRIVATE cSQL, nSQLEXEC, lOK, cSQLi
			lOK = .T.
		
			PRIVATE m.lnID
			m.lnID		= StockLst_Master.ID
		
			IF m.lnID = 0
				MESSAGEBOX("Master ID is 0"+CHR(13)+"Something has gone wrong."+CHR(13)+"This Detail with no Master will not be able to be saved!",0+16,"Error -Abort")
				RETURN -1
			ENDIF
		
		
			DO CASE
			CASE ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			CASE ThisForm.Lst = "BrokerLst"
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			CASE ThisForm.Lst = "WIPLst"
				cSQL = "UPDATE dbo.WIPLst_Detail SET "
			OTHERWISE
				TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
				cSQL = cSQL + "UPDATE dbo.StockLst_Detail SET "
			ENDCASE
			cSQL = cSQL+ " InvCheck=GETDATE()"
			cSQL = cSQL+ " WHERE ID_Detail="+STR(StockLst_Detail.ID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF		
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ELSE
				*This.parent.InvCheck.Value = DATE()
				THISFORM.ShowDetail(StockLst_Detail.ID_Detail)
				*MESSAGEBOX("Saved."+CHR(13)+"The 'Last Inv Check' field now has todays date.",0,"Todays DATE was recorded to this Detail!")
				WAIT WINDOW "The 'Last Inv Check' field now has todays date." NOWAIT
			ENDIF
		
			
		ENDIF
		
	ENDPROC

