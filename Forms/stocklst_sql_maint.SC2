		*ENDIF
		
		*ThisForm.RefreshGrd()
		*THISFORM.LockScreen = .F.
		
		*ThisForm.Show_cmbAlloy()
		SELECT StockLst_Master
		SEEK This.Value IN StockLst_Master ORDER Alloy
		
		IF FOUND( 'StockLst_Master' )
			*IF ThisForm.pgFrameMaster.ACTIVEPAGE = 1
				*ThisForm.pgFrameMaster.pgBrowse.grdMast.SetFocus
				ThisForm.pgFrameMaster.pgBrowse.grdMast.Refresh
			*ENDIF
			*ThisForm.ShowMaster() 
			ThisForm.refreshMasterBrowse()
			ThisForm.refreshMasterEdit()
		ENDIF
	ENDPROC

	PROCEDURE cmd10.Click
		PRIVATE cAlloy
		cAlloy = StockLst_Master.Alloy
		
		SELECT StockLst_Master
		SEEK cAlloy+'10' IN StockLst_Master ORDER AlloyForm
		
		IF NOT FOUND("StockLst_Master")
			SEEK cAlloy+'11' IN StockLst_Master ORDER AlloyForm
			IF NOT FOUND("StockLst_Master")
				SEEK cAlloy+'12' IN StockLst_Master ORDER AlloyForm
				IF NOT FOUND("StockLst_Master")
					SEEK cAlloy+'13' IN StockLst_Master ORDER AlloyForm
					IF NOT FOUND("StockLst_Master")
						SEEK cAlloy IN StockLst_Master ORDER Alloy
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.pgFrameMaster.ACTIVEPAGE = 1
			ThisForm.pgFrameMaster.pgBrowse.grdMast.SetFocus
		ENDIF
		*ThisForm.ShowMaster() 
		ThisForm.refreshMasterEdit()
	ENDPROC

	PROCEDURE cmd1Inch.Click
		PRIVATE cAlloy, cForm
		cAlloy = StockLst_Master.Alloy
		cForm  = StockLst_Master.Form
		
		SELECT StockLst_Master
		SEEK cAlloy+cForm+STR(1,9,3) IN StockLst_Master ORDER AllFrmSz
		
		SET ORDER TO TAG StockLst IN StockLst_Master
		
		IF NOT FOUND("StockLst_Master")
			SEEK cAlloy+cForm IN StockLst_Master ORDER AlloyForm
		
			DO WHILE StockLst_Master.Alloy = (cAlloy) AND StockLst_Master.Form = (cForm) AND StockLst_Master.Size < 1
				SKIP IN StockLst_Master
			ENDDO
		
		ENDIF
		
		IF ThisForm.pgFrameMaster.ACTIVEPAGE = 1
			ThisForm.pgFrameMaster.pgBrowse.grdMast.SetFocus
		ENDIF
		*ThisForm.ShowMaster() 
		ThisForm.refreshMasterEdit()
	ENDPROC

