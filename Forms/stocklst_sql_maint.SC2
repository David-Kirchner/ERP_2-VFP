	PROCEDURE cmdViewCert.Click
		PRIVATE cAlloy,cForm,nThck,cHeat,cLot,nID
		
		cAlloy	= PrepareSQLtxt(stocklst_master.Alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(stocklst_master.Form,'Form',2)
		nThck	= PrepareSQLnum(stocklst_master.Size,'Size',9,3)
		cHeat	= PrepareSQLtxt(stocklst_master.Heat,'Heat',40)
		cLot	= PrepareSQLtxt(stocklst_master.Lot,'Lot',10)
		nID		= PrepareSQLnum(stocklst_master.ID,'ID',-3)
		
		
		IF MESSAGEBOX("Do you want to use the new Scanned MTR screen?"+CHR(13)+"Answer No to view Recollect",4+32,"MTR")=6
			DO FORM "forms\MTR.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,ThisForm.nConnHandle
		ELSE
			DO FORM "forms\Recollect_Certs.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,ThisForm.nConnHandle
		ENDIF
		
	ENDPROC

