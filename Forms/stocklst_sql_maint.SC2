	PROCEDURE reloadsql
		PARAMETERS pID_Master
		*ThisForm.ReloadSQL()
		
		PRIVATE  lOK
		lOK = .F.
		
		PRIVATE cSQL
		PRIVATE nSQLEXEC
		
		ThisForm.pgFrameMaster.pgBrowse.grdMast.RecordSource = ''
		cSQL="SELECT"
		cSQL=cSQL+" [alloy]"
		cSQL=cSQL+",[form]"
		
		cSQL=cSQL+",dbo.f_CC_CLsort(CC,CL) AS CCCL "
		cSQL=cSQL+",[size]"
		cSQL=cSQL+",[cond]"
		
		cSQL=cSQL+",CAST(mS_QTY AS DECIMAL(9,1)) AS mS_QTY"
		cSQL=cSQL+",[specs]"
		cSQL=cSQL+",[heat]"
		cSQL=cSQL+",[lot]"
		cSQL=cSQL+",[Paid]"
		cSQL=cSQL+",[po_item]"
		cSQL=cSQL+",[poduedate]"
		cSQL=cSQL+",[mill]"
		cSQL=cSQL+",[Melt]"
		cSQL=cSQL+",[stkdate]"
		cSQL=cSQL+",[history]"
		cSQL=cSQL+",[num]"
		cSQL=cSQL+",[POStatus]"
		cSQL=cSQL+",[BrandName]"
		cSQL=cSQL+",[FROM_ID]"
		cSQL=cSQL+",[id]"
		
		cSQL=cSQL+",CAST(mWeight AS DECIMAL(9,1)) AS MWeight"
		cSQL=cSQL+",[CC]"
		cSQL=cSQL+",[CL]"
		
		cSQL=cSQL+",ISNULL([WO_Detail],0) AS WO_Detail"
		cSQL=cSQL+",ISNULL([ProjID],0) AS ProjID"
		
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL=cSQL+" FROM dbo.StockLst_Master "
		CASE ThisForm.Lst = "BrokerLst"
			cSQL=cSQL+" FROM dbo.BrokerLst_Master "
		CASE ThisForm.Lst = "WIPLst"
			cSQL=cSQL+" FROM dbo.WIPLst_Master "
		OTHERWISE
			TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
			cSQL = cSQL + " FROM dbo.StockLst_Master "
		ENDCASE
		
		IF USED('StockLst_Master')
			USE IN StockLst_Master
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master')
		ELSE
			**Also Change in ThisForm.RefreshMaster()
			SELECT StockLst_Master
			INDEX ON ID TAG ID
			INDEX ON Alloy TAG Alloy
			INDEX ON Alloy+FORM TAG AlloyForm
		*	INDEX ON Alloy+FORM+STR(CCSortValue(CC),2,1)+STR(Size,9,3) TAG StockLst
		*	INDEX ON Alloy+FORM+CC+STR(Size,9,3) TAG StockLst
		*	INDEX ON Alloy+Form+CC_CLsort(CC,CL,ThisForm.nConnHandle)+STR(Size,9,3) TAG StockLst
			INDEX ON Alloy+Form+CCCL+STR(Size,9,3) TAG StockLst
			INDEX ON Alloy+FORM+STR(Size,9,3) TAG AllFrmSz
			INDEX ON Alloy+FORM+COND+STR(SIZE,9,3)+HEAT TAG AFCSH
			INDEX ON Heat TAG Heat
			INDEX ON Lot TAG LOT
			
		*	INDEX ON Alloy+STR(GetFormSort(Form, ThisForm.nConnHandle),2,0)+STR(CCSortValue,2,0)+STR(SIZE,9,3) TAG StockLstCC
		*	INDEX ON Alloy+STR(GetFormSort(Form, ThisForm.nConnHandle),2,0)+STR(SIZE,9,3) TAG StockLst
			
			SET ORDER TO TAG StockLst
			*BROW
			
			*Go to ID if Passed in
			nID_Master = PrepareSQLnum(pID_Master,'ID_Master',-3)
			IF nID_Master > 0
				LOCATE FOR ID=nID_Master 
			ENDIF
			
			*******
			ThisForm.pgFrameMaster.pgBrowse.grdMast.RecordSource = 'StockLst_Master'
			ThisForm.pgFrameMaster.pgBrowse.grdMast.Refresh
			
			***************
			* get Detail
			ThisForm.pgFrameDetail.pgBrowse.grdDetail.RecordSource = ''
			
			cSQL = "SELECT"
			cSQL=cSQL+" [size_h]"
		    cSQL=cSQL+",[size_l]"
		    cSQL=cSQL+",[pc]"
		    cSQL=cSQL+",[dim1]"
		    cSQL=cSQL+",[dim2]"
		    cSQL=cSQL+",[dim3]"
		    cSQL=cSQL+",[length]"
		    cSQL=cSQL+",[S_QTY]"
		    cSQL=cSQL+",[S_P]"
		    cSQL=cSQL+",[S_Total]"
		    cSQL=cSQL+",[S_PU]"
		    
		    cSQL=cSQL+",[descript]"
		    cSQL=cSQL+",[location]"
		    cSQL=cSQL+",[floorstatus]"
		    cSQL=cSQL+",[class]"
		    cSQL=cSQL+",[costvalue]"
		    cSQL=cSQL+",CAST([Weight] AS DECIMAL(7,1)) AS [weight]"
		    
		    cSQL=cSQL+",[RandLen]"
		    cSQL=cSQL+",[InvCheck]"
		    cSQL=cSQL+",[ID]"
		    cSQL=cSQL+",[ID_Detail]"
		    cSQL=cSQL+",[ReceivingID]"
		    cSQL=cSQL+",[InvoiceValue]"
		    cSQL=cSQL+",[LiveCheck]" 
		    cSQL=cSQL+",[AccountingCheck]"
		    cSQL=cSQL+",[Quarantine]"
		    
		    cSQL=cSQL+",[Prime]"
		    DO CASE
			CASE ThisForm.Lst = "StockLst"	
				cSQL=cSQL+",'S' AS TBL"
				cSQL= cSQL+" FROM dbo.StockLst_Detail "
			CASE ThisForm.Lst = "BrokerLst"
				 cSQL=cSQL+",'B' AS TBL"
				cSQL= cSQL+" FROM dbo.BrokerLst_Detail "
			CASE ThisForm.Lst = "WIPLst"
				 cSQL=cSQL+",'W' AS TBL"
				cSQL= cSQL+" FROM dbo.WIPLst_Detail "
			OTHERWISE
				TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
			ENDCASE
			cSQL= cSQL+" WHERE ID = "+STR(StockLst_Master.ID)+" ORDER BY ID_Detail"
			
			IF USED("StockLst_Detail")
				USE IN StockLst_Detail
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail')
			ELSE
				*SELECT StockLst_Detail
				*INDEX ON ID TAG DetailID
		
				*SET RELATION TO ID INTO StockLst_Detail IN StockLst_Master
				ThisForm.pgFrameDetail.pgBrowse.grdDetail.RecordSource = 'StockLst_Detail'
				ThisForm.pgFrameProcess.pgBrowse.grdProcess.RecordSource = ''
				
				DO CASE
				CASE ThisForm.Lst = "StockLst"
					cSQL_Process = "SELECT *, 'S' AS TBL FROM dbo.StockLst_Process "
				CASE ThisForm.Lst = "BrokerLst"
					cSQL_Process = "SELECT *, 'B' AS TBL FROM dbo.BrokerLst_Process "
				CASE ThisForm.Lst = "WIPLst"
					cSQL_Process = "SELECT *, 'W' AS TBL FROM dbo.WIPLst_Process "
				OTHERWISE
					TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
					cSQL_Process = "SELECT *, 'S' AS TBL FROM dbo.StockLst_Process "
				ENDCASE
				cSQL_Process = cSQL_Process + " WHERE ID_Detail = "+STR(StockLst_Detail.ID_Detail)+" ORDER BY ID_Detail_Process"
				
				IF USED("StockLst_Process")
					USE IN StockLst_Process
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process, 'StockLst_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process, 'StockLst_Process')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process')
				ELSE
					lOK = .T.
					SELECT StockLst_Process
					INDEX ON ID_Detail TAG id_Detail
					SET ORDER TO ID_Detail
					ThisForm.pgFrameProcess.pgBrowse.grdProcess.RecordSource = 'StockLst_Process'
					
				ENDIF
			ENDIF
		ENDIF
		
		IF lOK
		
		ELSE
			= MESSAGEBOX('Error getting Data!'+CHR(13)+"Closing NOW!", 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

