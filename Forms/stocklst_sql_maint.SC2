	PROCEDURE pgFrameProcess.pgEdit.ReceivingID1.DblClick
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_ReceivingID(Stocklst_Process.ReceivingID,.T.) &&lReturnURL --not URL is an HTML code.
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
		MESSAGEBOX("Look for Open Web Browser for this Report",0,"Report Complete")
	ENDPROC

	PROCEDURE txtHeat.Valid
		*!*	PRIVATE lnID_Detail, lnID, cSQL, nSQLEXEC 
		PRIVATE lcHeat
		lcHeat = This.Value
		*!*	lnID_Detail = 0
		*!*	lnID = 0
		
		*!*	*Find Master First
		
		IF TYPE("lcHeat") = "N"
			lcHeat  = STR( lcHeat  )
		ENDIF
		lcHeat = ALLTRIM(lcHeat)
		IF EMPTY( lcHeat )
			WAIT WINDOW "Browse order set to the standard 'StockLst'" NOWAIT
		*	SELECT StockLst_Master
			SET ORDER TO TAG StockLst IN StockLst_Master
		
			ThisForm.pgFrameMaster.pgBrowse.grdMast.refresh
			RETURN
		ENDIF
		
		lcHeat = STRTRAN(lcHeat,"'","")
		lcHeat = STRTRAN(lcHeat,["],"")
		This.Value = lcHeat
		
		*******************************
		SELECT StockLst_Master
		SEEK lcHeat ORDER HEAT
		
		IF FOUND('StockLst_Master')
			SET ORDER TO TAG Heat
			lnID = StockLst_Master.ID
			ThisForm.ShowMaster(lnID)
			ThisForm.pgFrameDetail.ActivePage = 2
			*WAIT WINDOW "Found! Order set to Heat" NOWAIT
			ThisForm.pgFrameMaster.pgBrowse.grdMast.refresh
			MESSAGEBOX("Found!"+CHR(13)+"Browse By HEAT"+CHR(13)+"Clear the HEAT field to reset browse order to Alloy+From+Size.",0,"Browse",1000)
		ELSE
			SEEK UPPER(lcHeat) ORDER HEAT
			IF FOUND('StockLst_Master')
				SET ORDER TO TAG Heat
				lnID = StockLst_Master.ID
				ThisForm.ShowMaster(lnID)
				ThisForm.pgFrameDetail.ActivePage = 2
				*WAIT WINDOW "Found! Order set to Heat" NOWAIT
				ThisForm.pgFrameMaster.pgBrowse.grdMast.refresh
				MESSAGEBOX("Found!"+CHR(13)+"Browse By HEAT"+CHR(13)+"Clear the HEAT field to reset browse order to Alloy+From+Size.",0,"Browse",1000)
			ELSE
				*SET ORDER TO TAG StockLst IN StockLst_Master
						
						
				PRIVATE lnID_Detail, lnID, cSQL, nSQLEXEC
				lnID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
				lnID = 0
			
				cSQL= "SELECT ID "
				DO CASE
				CASE ThisForm.ogTable.Value = 1
					cSQL = cSQL + " FROM dbo.StockLst_Master "
				CASE ThisForm.Lst = "BrokerLst"
					cSQL = cSQL + " FROM dbo.BrokerLst_Master "
				CASE ThisForm.Lst = "WIPLst"
					cSQL = cSQL + " FROM dbo.WIPLst_Master "
				OTHERWISE
					TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
					cSQL = cSQL + " FROM dbo.StockLst_Master "
				ENDCASE
				cSQL = cSQL + " WHERE Heat LIKE '%"+ALLTRIM(lcHeat)+"%'"
				cSQL = cSQL + " OR LOT LIKE '%"+ALLTRIM(lcHeat)+"%'"
		
				IF USED("tmpStockHeat")
					USE IN tmpStockHeat
				ENDIF
				SELECT 0
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockHeat')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockHeat')
				ELSE
					IF RECCOUNT('tmpStockHeat') > 0
						lnID = tmpStockHeat.ID
						nStockHeat = RECCOUNT('tmpStockHeat')
						IF RECCOUNT('tmpStockHeat') > 1
							MESSAGEBOX("Found "+ALLTRIM(STR(nStockHeat))+" records by adding a search to LOT!"+CHR(13)+"Not all records can be shown here."+CHR(13)+"Only the First record is being shown",0+64,"Found")
						ENDIF
					ENDIF
				ENDIF
		
				IF lnID > 0
					ThisForm.ShowMaster(lnID)
					ThisForm.pgFrameDetail.ActivePage = 2
					*ThisForm.ShowDetailForm()
					ThisForm.cmbAlloy.Value = stocklst_master.Alloy
					
					ThisForm.ShowDetail(lnID_Detail)
					
				ELSE
					WAIT WINDOW "Not Found in Lot!" NOWAIT
					MESSAGEBOX("Not Found!"+CHR(13)+"shorten to find similair heats."+CHR(13)+"Browse By HEAT"+CHR(13)+"Clear the HEAT field to reset browse order to Alloy+From+Size.",0,"Browse",5000)
				ENDIF
				IF USED("tmpStockHeat")
					USE IN tmpStockHeat
				ENDIF		
				
				*********************
				SELECT stocklst_master
				PRIVATE nRecClose
				nRecClose = RECNO(0)
				IF nRecClose > 0
					GO nRecClose
				ENDIF
				SET ORDER TO TAG Heat
				ThisForm.pgFrameMaster.pgBrowse.grdMast.refresh
						*
				
			ENDIF	
		ENDIF
		ThisForm.cmbAlloy.Value = stocklst_master.Alloy
		
	ENDPROC

	PROCEDURE txtID.Valid
		PRIVATE lnID, cSQL, nSQLEXEC
		lnID = This.Value
		
		IF TYPE("lnID") = "C"
			lnID = VAL( ALLTRIM(lnID) )
		ENDIF
		
		IF lnID = 0
			RETURN
		ENDIF
		
		cSQL= "SELECT ID "
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL = cSQL + " FROM dbo.StockLst_Master "
		CASE ThisForm.Lst = "BrokerLst"
			cSQL = cSQL + " FROM dbo.BrokerLst_Master "
		CASE ThisForm.Lst = "WIPLst"
			cSQL = cSQL + " FROM dbo.WIPLst_Master "
		OTHERWISE
			TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
			cSQL = cSQL + " FROM dbo.StockLst_Master "
		ENDCASE
		cSQL = cSQL + " WHERE ID = "+STR(lnID)
		
		IF USED("StockLst_Master_ID")
			USE IN StockLst_Master_ID
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_ID')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master_ID')
		ELSE
			lnID = StockLst_Master_ID.ID
		ENDIF
		
		IF lnID > 0
			ThisForm.pgFrameMaster.ActivePage = 2
			ThisForm.ShowMaster(lnID)
			ThisForm.cmbAlloy.Value = stocklst_master.Alloy
		ELSE
			WAIT WINDOW "Not Found!" NOWAIT
		ENDIF
		
		IF USED("StockLst_Master_ID")
			USE IN StockLst_Master_ID
		ENDIF
	ENDPROC

	PROCEDURE txtID_Detail.Valid
		PRIVATE lnID_Detail, lnID, cSQL, nSQLEXEC
		lnID_Detail = This.Value
		lnID = 0
		
		IF TYPE("lnID_Detail") = "C"
			lnID_Detail = VAL( ALLTRIM(lnID_Detail) )
		ENDIF
		
		IF lnID_Detail = 0
			RETURN
		ENDIF
		
		cSQL= "SELECT ID FROM "
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL = cSQL + " dbo.StockLst_Detail "
		CASE ThisForm.Lst = "BrokerLst"
			cSQL = cSQL + " dbo.BrokerLst_Detail "
		CASE ThisForm.Lst = "WIPLst"
			cSQL = cSQL + " dbo.WIPLst_Detail"
		OTHERWISE
			TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
			cSQL = cSQL + " dbo.StockLst_Detail "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(lnID_Detail)
		
		IF USED("tmpStockLst_Detail_ID")
			USE IN tmpStockLst_Detail_ID
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail_ID')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail_ID')
		ELSE
			lnID = tmpStockLst_Detail_ID.ID
		ENDIF
		
		IF lnID > 0
			ThisForm.ShowMaster(lnID)
			ThisForm.pgFrameDetail.ActivePage = 2
			*ThisForm.ShowDetailForm()
			ThisForm.cmbAlloy.Value = stocklst_master.Alloy
			
			ThisForm.ShowDetail(lnID_Detail)
			
		ELSE
			WAIT WINDOW "Not Found!" NOWAIT
		*!*		cSQL= "SELECT ID FROM StockLst_Detail WHERE ID_Detail = "+STR(lnOldID_Detail)
		
		*!*		IF USED("StockLst_Detail")
		*!*			USE IN tmpStockLst_Detail_ID
		*!*		ENDIF
		*!*		SELECT 0
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail_ID')
		
		ENDIF
		IF USED("tmpStockLst_Detail_ID")
			USE IN tmpStockLst_Detail_ID
		ENDIF
	ENDPROC

	PROCEDURE txtLot.Valid
