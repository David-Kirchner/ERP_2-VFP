	PROCEDURE cmdRemoveProc.Click
		*cmdRemoveProc.click - Clean Process'
		PRIVATE nSQLEXEC, cSQL_Process, cSQLu, cSQLd
		
		WAIT WINDOW "Selecting Process'" TIMEOUT 1
		
		cSQL_Process =                "SELECT ID_Detail_Process,SOitem,PO_Item,'StockLst' AS FromTbl,SPACE(100) AS NewComment"
		cSQL_Process = cSQL_Process + " FROM dbo.StockLst_Process "
		cSQL_Process = cSQL_Process + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' OR Process_ID = 'Shipped' )"
		cSQL_Process = cSQL_Process + " UNION "
		cSQL_Process = cSQL_Process + "SELECT ID_Detail_Process,SOitem,PO_Item,'BrokerLst' AS FromTbl,SPACE(100) AS NewComment"
		cSQL_Process = cSQL_Process + " FROM dbo.BrokerLst_Process "
		cSQL_Process = cSQL_Process + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' OR Process_ID = 'Shipped' )"
		cSQL_Process = cSQL_Process + " UNION "
		cSQL_Process = cSQL_Process + "SELECT ID_Detail_Process,SOitem,PO_Item,'WIPLst' AS FromTbl,SPACE(100) AS NewComment"
		cSQL_Process = cSQL_Process + " FROM dbo.WIPLst_Process "
		cSQL_Process = cSQL_Process + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' OR Process_ID = 'Shipped' )"
		
		cSQL_Process = cSQL_Process + " ORDER BY ID_Detail_Process"
		
		IF USED("StockLst_Process_Selected")
			USE IN StockLst_Process_Selected
		ENDIF
		SELECT 0
		
		PRIVATE nTot, nRec
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process, 'StockLst_Process_Selected')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Process, 'StockLst_Process_Selected')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process_Selected')
		ELSE
			lOK = .T.
			SELECT StockLst_Process_Selected
			nTot = RECCOUNT('StockLst_Process_Selected')
			
			SCAN
				nRec = RECNO('StockLst_Process_Selected')
				WAIT WINDOW ALLTRIM(STR(nRec))+"/"+ALLTRIM(STR(nTot)) NOWAIT
				IF VAL(StockLst_Process_Selected.SOitem) = 0
					IF VAL(StockLst_Process_Selected.PO_item) = 0
						*Leave for Removale
						SELECT StockLst_Process_Selected
						REPLACE NewComment WITH "Cleaned, SO item = 0 and PO item = 0"
					ELSE
						*Track down PO
						nCntPOitem = Count_POIteminPurchaseOrder( StockLst_Process_Selected.PO_item, ThisForm.nConnHandle )
						*SELECT COUNT(*) FROM PurchaseOrder WHERE POitem = StockLst_Process_Selected.PO_item INTO ARRAY aCntPOitem
						IF nCntPOitem > 0
							nCntPOitem = Count_POIteminPurchaseOrder( StockLst_Process_Selected.PO_item, ThisForm.nConnHandle, 'Delivered') 
							*SELECT COUNT(*) FROM PurchaseOrder WHERE POitem = StockLst_Process_Selected.PO_item AND Delivered INTO ARRAY aCntPOitem
							IF nCntPOitem > 0
								*Delivered!
								*Leave for Removale
								SELECT StockLst_Process_Selected
								REPLACE NewComment WITH "Cleaned, SO item = 0 and PO item '"+ALLTRIM(StockLst_Process_Selected.PO_item)+"' was Delivered!"
							ELSE
								*Remove, Still due in
								SELECT StockLst_Process_Selected
								DELETE IN StockLst_Process_Selected
							ENDIF
						ELSE
							*PO not Found!
							*Leave for Removale
							SELECT StockLst_Process_Selected
							REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item = 0 and PO item not found!"
						ENDIF
					ENDIF
				ELSE
					*Track down SO
			
					************
		*			SELECT COUNT(*) FROM Sales WHERE StockLst_Process_Selected.SOitem = SOitem INTO ARRAY aCntSOitem
		*			IF aCntSOitem(1,1) > 0
					IF Count_SOIteminSales(StockLst_Process_Selected.SOItem, ThisForm.nConnHandle) > 0
		*				SELECT COUNT(*) FROM Sales WHERE StockLst_Process_Selected.SOitem = SOitem AND Cmplt INTO ARRAY aCntSOitem
						PRIVATE cSQLp
						cSQLp = "SELECT COUNT(*) AS Cnt FROM dbo.Sales WHERE SOitem = dbo.f_ProperSOitem('"+StockLst_Process_Selected.SOItem+"')"
						cSQLp= cSQLp+" AND cmplt=1 "
		
						IF USED("cntSales_4")
							USE IN "cntSales_4"
						ENDIF
						SELECT 0
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLp, 'cntSales_4')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLp, 'cntSales_4')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLp,ThisForm.nConnHandle, nSQLEXEC, 'cntSales_4')
						ENDIF
						PRIVATE aCntSOitem
						aCntSOitem = 0
						IF USED('cntSales_4')
							IF VARTYPE(cntSales_4.cnt) = 'N'
								aCntSOitem = cntSales_4.cnt
							ENDIF
							USE IN cntSales_4
						ENDIF
						
						IF aCntSOitem > 0
							IF VAL(StockLst_Process_Selected.PO_item) = 0
								*Complete!
								*Leave for Removale
								SELECT StockLst_Process_Selected
								REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item '"+ALLTRIM(StockLst_Process_Selected.SOitem)+"' has been completed. No PO"
							ELSE		
								*Track down PO
								nCntPOitem = Count_POIteminPurchaseOrder( StockLst_Process_Selected.PO_item, ThisForm.nConnHandle )
								*SELECT COUNT(*) FROM PurchaseOrder WHERE POitem = StockLst_Process_Selected.PO_item INTO ARRAY aCntPOitem
								IF nCntPOitem > 0
									nCntPOitem = Count_POIteminPurchaseOrder( StockLst_Process_Selected.PO_item, ThisForm.nConnHandle, 'Delivered')
									*SELECT COUNT(*) FROM PurchaseOrder WHERE POitem = StockLst_Process_Selected.PO_item AND Delivered INTO ARRAY aCntPOitem
									IF nCntPOitem > 0
										*Complate and Delivered!
										*Leave for Removale
										SELECT StockLst_Process_Selected
										REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item '"+ALLTRIM(StockLst_Process_Selected.SOitem)+"' has been completed. PO item '"+ALLTRIM(StockLst_Process_Selected.PO_item)+"' was Delivered!"
									ELSE
										SELECT StockLst_Process_Selected
										REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item '"+ALLTRIM(StockLst_Process_Selected.SOitem)+"' has been completed. PO not delivered!"
									ENDIF
								ELSE
									SELECT StockLst_Process_Selected
									REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item '"+ALLTRIM(StockLst_Process_Selected.SOitem)+"' has been completed. PO not found"
								ENDIF
							ENDIF
						ELSE
							*Remove, Still working on
							SELECT StockLst_Process_Selected
							DELETE IN StockLst_Process_Selected
						ENDIF
					ELSE
						*SO not Found!
						*Try PO
						IF VAL(StockLst_Process_Selected.PO_item) = 0
							*Leave for Removale
							SELECT StockLst_Process_Selected
							REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item Not Found and PO item = 0"
						ELSE
							*Track down PO
							nCntPOitem = Count_POIteminPurchaseOrder( StockLst_Process_Selected.PO_item, ThisForm.nConnHandle )
							*SELECT COUNT(*) FROM PurchaseOrder WHERE POitem = StockLst_Process_Selected.PO_item INTO ARRAY aCntPOitem
							IF nCntPOitem > 0
								nCntPOitem = Count_POIteminPurchaseOrder( StockLst_Process_Selected.PO_item, ThisForm.nConnHandle, 'Delivered')
								*SELECT COUNT(*) FROM PurchaseOrder WHERE POitem = StockLst_Process_Selected.PO_item AND Delivered INTO ARRAY aCntPOitem
								IF nCntPOitem > 0
									*Complete!
									*Leave for Removale
									SELECT StockLst_Process_Selected
									REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item not found and PO item '"+ALLTRIM(StockLst_Process_Selected.PO_item)+"' deleivered"
								ELSE
									*Remove, Still due in
									SELECT StockLst_Process_Selected
									DELETE IN StockLst_Process_Selected
								ENDIF
							ELSE
								*PO not Found!
								*Leave for Removale
								SELECT StockLst_Process_Selected
								REPLACE StockLst_Process_Selected.NewComment WITH "Cleaned, SO item not found and PO item not found!"
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				
				SELECT StockLst_Process_Selected
			ENDSCAN
			
			SELECT StockLst_Process_Selected
			PRIVATE nCommentCount
			nCommentCount = 0
			COUNT FOR !EMPTY( StockLst_Process_Selected.NewComment) TO nCommentCount
			
			GO TOP
			MESSAGEBOX("Found "+ALLTRIM(STR(nCommentCount))+" processes that should be cleaned out.",0,"Begin clean process")
			
			DO FORM FORMS\StockLst_Process_Clean
			
			*Loop again to collect for Report
			SELECT StockLst_Process_Selected
			GO TOP
			
			SCAN
				IF NOT DELETED('StockLst_Process_Selected')
					*Add to tmpStockProcRpt for Report
					IF USED("tmpTable2")
						USE IN tmpTable2
					ENDIF
					SELECT 0
		
					IF StockLst_Process_Selected.FromTbl = "StockLst"
						cSQL = "SELECT * "
						*FROM dbo.StockLst_Process 
						DO CASE
						CASE ThisForm.Lst = "StockLst"
							cSQL = cSQL + " FROM dbo.StockLst_Process "
						CASE ThisForm.Lst = "BrokerLst"
							cSQL = cSQL + " FROM dbo.BrokerLst_Process "
						CASE ThisForm.Lst = "WIPLst"
							cSQL = cSQL + " FROM dbo.WIPLst_Process "
						OTHERWISE
							TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
							cSQL = cSQL + " FROM dbo.StockLst_Master "
						ENDCASE
						cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(StockLst_Process_Selected.ID_Detail_Process)
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable2')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable2')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable2')
						ENDIF
						
						IF RECCOUNT('tmpTable2') > 0
							IF USED('tmpStockProcRpt')
								INSERT INTO tmpStockProcRpt SELECT * FROM tmpTable2
							ELSE
								*Create first record!
								cSQL = "SELECT * "
								*FROM dbo.StockLst_Process 
								DO CASE
								CASE ThisForm.Lst = "StockLst"
									cSQL = cSQL + " FROM dbo.StockLst_Process "
								CASE ThisForm.Lst = "BrokerLst"
									cSQL = cSQL + " FROM dbo.BrokerLst_Process "
								CASE ThisForm.Lst = "WIPLst"
									cSQL = cSQL + " FROM dbo.WIPLst_Process "
								OTHERWISE
									TrackError("Bad ThisForm.Lst ","Lost Table", PROGRAM(), LINENO(1))
									cSQL = cSQL + " FROM dbo.StockLst_Process "
								ENDCASE
								cSQL = cSQL + "WHERE ID_Detail_Process = "+STR(StockLst_Process_Selected.ID_Detail_Process)
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockProcRpt')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockProcRpt')
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockProcRpt')
								ENDIF
							ENDIF
						ENDIF
						IF USED("tmpTable2")
							USE IN tmpTable2
						ENDIF
					ELSE
						cSQL = "SELECT * FROM dbo.BrokerLst_Process WHERE ID_Detail_Process = "+STR(StockLst_Process_Selected.ID_Detail_Process)
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable2')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable2')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable2')
						ENDIF
						
						IF RECCOUNT('tmpTable2') > 0
							IF USED('tmpStockProcRpt')
								INSERT INTO tmpStockProcRpt SELECT * FROM tmpTable2
							ELSE
								*Create first record!
								cSQL = "SELECT * FROM dbo.BrokerLst_Process WHERE ID_Detail_Process = "+STR(StockLst_Process_Selected.ID_Detail_Process)
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockProcRpt')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockProcRpt')
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockProcRpt')
								ENDIF
							ENDIF
						ENDIF
						IF USED("tmpTable2")
							USE IN tmpTable2
						ENDIF
					ENDIF
				ENDIF
				SELECT StockLst_Process_Selected
			ENDSCAN
			
			IF USED('tmpStockProcRpt')
			
				SELECT tmpStockProcRpt
				SELECT t.* ,sps.NewComment FROM tmpStockProcRpt t, StockLst_Process_Selected SPS WHERE SPS.id_detail_process = t.id_detail_process INTO CURSOR tmpSPS
				SELECT tmpSPS
				REPORT FORM reports\RemovePROCESS PREVIEW
				IF USED("tmpSPS")
					USE IN tmpSPS
				ENDIF
				
				USE IN tmpStockProcRpt
			ENDIF	
			
			nMess = MESSAGEBOX("Are you sure you want to Remove Process'",4+32+256,"Removing dead Process'") 
			*6= Yes, 7 = no
			IF nMess = 7 OR nMess = -1
				RETURN
			ENDIF
			
			SELECT StockLst_Process_Selected
			*PACK
			PRIVATE lCommit
			lCommit = .F.
			
			GO TOP
			WAIT WINDOW "Removing Process'" NOWAIT
			SCAN
				nRec = RECNO('StockLst_Process_Selected')
				WAIT WINDOW ALLTRIM(STR(nRec))+"/"+ALLTRIM(STR(nTot)) NOWAIT
				
				IF DELETED()
					LOOP
				ENDIF	
				**************************************
				lCommit = .T.
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, "BEGIN TRANSACTION Remove_Process")
				**************************************
				
				m.cID_D_P = STR(StockLst_Process_Selected.ID_Detail_Process)
		
				IF StockLst_Process_Selected.FromTbl = "StockLst"
				
					*REMOVE from StockLst_Process Where not Deleted
					cSQLd = "DELETE FROM dbo.StockLst_Process WHERE ID_Detail_Process = "
					cSQLd = cSQLd + m.cID_D_P
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLd,ThisForm.nConnHandle, nSQLEXEC, '')
						lCommit = .F.
					ENDIF
								
					cSQLu = "UPDATE dbo.Ar_StockLst_Process_History "
					cSQLu = cSQLu + " SET Comment = '"+PrepareSQLtxt(StockLst_Process_Selected.NewComment,'Comment',100)+"'"
					cSQLu = cSQLu + " WHERE ID_Detail_Process = " + m.cID_D_P
					cSQLu = cSQLu + " AND What = 'DELETE'"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
						lCommit = .F.
					ENDIF
				ELSE
				
					*REMOVE from BrokerLst_Process Where not Deleted
					cSQLd = "DELETE FROM dbo.BrokerLst_Process WHERE ID_Detail_Process = "
					cSQLd = cSQLd + m.cID_D_P
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLd,ThisForm.nConnHandle, nSQLEXEC, '')
						lCommit = .F.
					ENDIF
					
					cSQLu = "UPDATE dbo.Ar_BrokerLst_Process_History "
					cSQLu = cSQLu + " SET Comment = '"+PrepareSQLtxt(StockLst_Process_Selected.NewComment,'Comment',100)+"'"
					cSQLu = cSQLu + " WHERE ID_Detail_Process = " + m.cID_D_P
					cSQLu = cSQLu + " AND What = 'DELETE'"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
						lCommit = .F.
					ENDIF
				ENDIF
				**************************************
				IF lCommit
					SQLEXEC(ThisForm.nConnHandle, "COMMIT TRANSACTION Remove_Process")
				ELSE
					SQLEXEC(ThisForm.nConnHandle, "ROLLBACK TRANSACTION Remove_Process")
				ENDIF
				*= SQLSETPROP(gnConnHandle, 'Transactions', 1) && Auto transactions		
				**************************************
			ENDSCAN
		ENDIF
		
		
		IF USED("StockLst_Process_Selected")
			USE IN StockLst_Process_Selected
		ENDIF
		
		
		WAIT WINDOW "Complete" TIMEOUT 1
	ENDPROC

