	PROCEDURE cancelpackingslip
		*CancelPackingSlip()
		PRIVATE cSOitem
		cSOitem = ''
		
		PRIVATE cSQL, nSQLEXEC
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make SQL connection', 16, 'SQL Connect Error')
			RETURN
		ENDIF
		
		PRIVATE lNeed2Ship, lOK
		lNeed2Ship = MESSAGEBOX("Will this SO item still need to be Shipped? (Y)"+CHR(13)+CHR(13)+"If you are cancelling this Packing Slip because a "+CHR(13)+"SalesRep is Cancelling the SO item then answer (No),"+CHR(13)+"becuase it will not be shipping.",4+32,"Mark item as Still needs a shipment?") = 6
		**""+CHR(13)+"Should the 'COMPLETE' mark be unchecked,"+CHR(13)+"so the next 'Packing Slip' can mark this as complete?"+CHR(13)
		lOK = .T.
		
		PRIVATE nPackingSli, pcSOitem
		nPackingSli = PrepareSQLnum(PackingSlip.PackingSli,'PackingSli',-3)
		
		IF USED( 'PS_SOitem' )
			USE IN PS_SOitem
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT DISTINCT SOitem FROM dbo.PackingSlip WITH(NOLOCK) "
		cSQL = cSQl + " WHERE PackingSlip.PackingSli = "+STR(nPackingSli)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PS_SOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PS_SOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PS_SOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PS_SOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'PS_SOitem')
			MESSAGEBOX("Could not collect SOitem's used in PackingSlip "+STR(nPackingSli),16,"No SOitem")
			lOK = .F.
		ENDIF
		
		
		PRIVATE nPS_SO_Pcs
		
		IF USED( 'PS_SOitem' )
			IF RECCOUNT('PS_SOitem') > 0
			
				SELECT SOitem FROM PS_SOitem INTO ARRAY aPS_SOitem	
				*USE IN PS_SOitem
				
				PRIVATE nSOQShip, nLine
				nLine = 0
				
				SELECT PS_SOitem
				SCAN		
					nLine = nLine + 1
		
					cSOitem = PS_SOitem.SOitem 
					IF cSOitem = Proper_SO_item('')
						LOOP
					ENDIF
					
					nPS_SO_Pcs = GET_Pcs_PackingSli(nPackingSli ,ThisFormSet.nConnHandle)
					
					IF Count_SOIteminSales(cSOitem, ThisFormSet.nConnHandle) > 0 Then
						nSOQShip = 0
						nSOQShip = Get_QShippedinSales(cSOitem, ThisFormSet.nConnHandle)
		
						*SO exists in Sales
						PRIVATE cSQLu
						cSQLu = "UPDATE dbo.Sales "
						cSQLu = cSQLu +" SET Qshipped = "+STR( nSOQShip - nPS_SO_Pcs )
						IF lNeed2Ship
							cSQLu = cSQLu +", cmplt = 0"
						ELSE
							*cSQLu = cSQLu +", cmplt = 1"
						ENDIF
						cSQLu = cSQLu +" WHERE Sales.SOItem = dbo.f_ProperSOitem('"+cSOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError( cSQLu, ThisFormSet.nConnHandle,nSQLEXEC, cSQLu )
							lOK = .F.
						ENDIF
						
						IF lNeed2Ship
							** Repeat in SOitem_Hrs
							cSQL = "UPDATE dbo.SOitem_Hrs SET "
							cSQL = cSQL + " [Cmplt] = 0"
							cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO 
							ENDIF 
							**
						ENDIF
		
					ENDIF
					*******
					*Check Ship for an existing SO-Item
		
					nSOQShip = Get_QShippedinShip(cSOitem, ThisFormSet.nConnHandle)
					
					IF nSOQShip > 0 Then
						nQshipped = getQshipped_ShipbySOitem( cSOitem, ThisFormSet.nConnHandle )
		
						cSQL = "UPDATE dbo.Ship SET "
						cSQL = cSQL + " Qshipped = "+STR( nSOQShip - nPS_SO_Pcs ,10,0)
						IF lNeed2Ship
							cSQL = cSQL + ",[COMPLETE] = 0"
						ENDIF
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
							MESSAGEBOX("ERROR Updating Ship")
						ENDIF
					ELSE
						IF lNeed2Ship
							cSQL = "UPDATE dbo.Ship SET "
							cSQL = cSQL + "[COMPLETE] = 0"
							cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO 
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
								lOK = .F.
								MESSAGEBOX("Could not set SOitem as NOT complete in Ship table.",16,"ERROR Updating Ship")
							ENDIF
						ENDIF		
					ENDIF
					****
					IF NOT lNeed2Ship
		*!*					* WHY?
		*!*					cSQL_Process_U = "UPDATE dbo.StockLst_Process SET Process_ID = 'Partl Ship' WHERE SOitem ='"+cSOitem+"'"
		
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process_U)
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process_U)
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0 &&Try again!
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process_U, "")
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process_U, "")
		*!*							
		*!*							IF nSQLEXEC < 0
		*!*								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*									nSQLEXEC = 0
		*!*								ENDIF
		*!*							ENDIF
		*!*						ENDDO 
		*!*					ENDIF 
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL_Process_U, ThisFormSet.nConnHandle,nSQLEXEC,'')
		*!*					
		*!*						MESSAGEBOX("ERROR Updating SQL StockLst process")
		*!*					ENDIF
					ENDIF
					
					****************
					
					cSQL = "UPDATE dbo.Sales_PS SET "
					cSQL = cSQL + " Cncld = 1"
					*All SOitem's in PackingSli  && dbo.f_ProperSOitem('"+cSOitem+"')"
					cSQL = cSQL + " WHERE PackingSli = "+STR( nPackingSli )
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
						*lOK = .F.
						*MESSAGEBOX("Could not set SOitem as NOT complete in Ship table.",16,"ERROR Updating Ship")
					ENDIF
				
					IF lOK AND NOT lNeed2Ship
						*Alert Sales Rep that Packing is now Cancelled
						Send_Chatter("PackingSlip_Cancel",0,cSOitem,"The Packing Slip "+STR(nPackingSli)+" has been CANCELLED for SOitem ='"+cSOitem+"'",ThisFormSet.nConnHandle)
					ENDIF
		
		
					SELECT PS_SOitem
				ENDSCAN
				
				****************************************************
				****************************************************
				cSQL = "UPDATE dbo.Sales_Stock SET "
				*cSQL = cSQL + " PackingSli = 0, " && keep as a reminder
				cSQL = cSQL + " PS_Cncl = 1 "
				cSQL = cSQL + " WHERE PackingSli = "+STR(nPackingSli)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
					*MESSAGEBOX("ERROR Updating Sales_Stock ")
				ENDIF
				******************************
						
			ENDIF &&No Packing Slip found!			
		ENDIF
		
		**************
		IF lOK
		
			*UPDATE PackingSlip SET Cancld = .T. WHERE PackingSlip.PackingSli = nPackingSli
			UPDATE_CancldinPackingSlip( .T., nPackingSli, ThisFormSet.nConnHandle)
			
		ENDIF
		**************
		
	ENDPROC

	PROCEDURE completeso
		*ThisFormSet.CompleteSO()	
		
		
		*Is_SOitem_Hold 
		
		
		*Mark_SOitem_Cmplt
		IF lPermission 
			IF MESSAGEBOX( "Are you sure you want to Mark as Complete?",4+32,"Complete SOitem") <> 6
				RETURN .F.
			ENDIF
		ELSE
			MESSAGEBOX("You do not have permision here",0,"Cannot continue")
			RETURN .F.
		ENDIF
		***********************
		***********************
		
		PRIVATE nSalesNum
		nSalesNum = PrepareSQLnum(Sales_No.SalesNum,'SalesNum',-3)
		
		IF nSalesNum > 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "UPDATE dbo.Sales_No SET Cmplt = 1"
			cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
			ELSE
				PRIVATE nAmendment
				nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisFormSet.nConnHandle)
				Track_Sales_No_Chng( "PackingSlip History.SO COMPLETE", nSalesNum, .T., nAmendment )
				
				TrackMess(cSQL)
			ENDIF
			
			
		ENDIF
	ENDPROC

	PROCEDURE completesoitem
		*ThisFormSet.CompleteSOitem()		
		
		PRIVATE lSOitemCmplt
		lSOitemCmplt= PrepareSQLlogic(ThisFormset.frmPackingSlipHistory.pf1.pgSales.chkcmplt.Value,'Cmplt')
		
		IF lSOitemCmplt = .T.
			MESSAGEBOX("This screen can only COMPLETE." +CHR(13)+"Already marked as Complete.",0,"Cannot continue")
			RETURN .F.
		ENDIF
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		PRIVATE lPermission, lPackingSlipEdit, lCompleteSO, lAdminCancelSO, lSame_SalesP
		lPermission = .F.
		lPackingSlipEdit = HavePermission('PackingSlip Edit')
		IF lPackingSlipEdit 
			lPermission = .T.
		ENDIF
		IF NOT lPermission 
			lCompleteSO  = HavePermission('CompleteSO')
			IF lCompleteSO  
				lPermission = .T.
			ENDIF
		ENDIF
		IF NOT lPermission 
			lAdminCancelSO = HavePermission('AdminCancelSO')
			IF lAdminCancelSO
				lPermission = .T.
			ENDIF
		ENDIF
		IF NOT lPermission 
			lSame_SalesP = ( AppSetup_Get_SalesP() = Get_From_AllQuote_SOitem(Ship.SOitem,"SalesP",ThisFormSet.nConnhandle) )
			IF lSame_SalesP 
				lPermission = .T.
			ENDIF
		ENDIF
		*Is_SOitem_Hold 
		*Mark_SOitem_Cmplt
		IF lPermission 
			IF MESSAGEBOX( "Are you sure you want to Mark as Complete?",4+32,"Complete SOitem") <> 6
				RETURN .F.
			ENDIF
		ELSE
			MESSAGEBOX("You do not have permision here",0,"Cannot continue")
			RETURN .F.
		ENDIF
		***********************
		***********************
		
		
		PRIVATE nSalesNum,cSOitem,lOK
		nSalesNum = PrepareSQLnum(Ship.SalesNum,'SalesNum',-3)
		cSOitem	= PrepareSQLtxt(Ship.SOitem,'SOitem',10)
		lOK = .T.
		
		IF nSalesNum > 0 AND Proper_SO_item(cSOitem) <>Proper_SO_item('')
		
			**Show Item detail screen to review Quotes to pacing slip shipped, before saving!
			PRIVATE nReturn
			nReturn = 0
			DO FORM Forms\Show_Ship_Order WITH "SOitem",cSOitem to nReturn
				*nReturn=1 Not Complete
				*nReturn=2 Complete
				*nReturn=3 Just view
				*nReturn=4 Saved as Complete
				
			nReturn = PrepareSQLnum(nReturn,'nReturn',-3)
			IF nReturn = 4
				*Now run Save_SOitem_Status() from the originating Program to list the Program used
				Save_SOitem_Status( cSOitem, nSalesNum,'Complete', 'SOitem was changed to Complete in Packing Slip History Edit.', ThisFormSet.nConnHandle)
				
				PRIVATE nAmendment
				nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisFormSet.nConnHandle)
				Track_Sales_No_Chng( "PackingSlip History.SOitem COMPLETE '"+cSOitem+"'", nSalesNum, .T., nAmendment )
			ENDIF
		
		ENDIF
		*Proc_SQL:
				*Email_PS_SONotComplete(cSOitem, nPS_No, ConnHandle )
				*IS_SOitem_Complete
				*Is_SOitem_Hold 
				*Cancel_SOitem
				*Mark_SOitem_Cmplt
				*Update_Ship_SOitem
		
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE getsql_field
		PRIVATE cSQL_field
		cSQL_field = ''
		
		DO CASE
		CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip.VISIBLE
			DO CASE
			CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip.Value = 1
				cSQL_field = "PACKINGSLIP.HEAT"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip.Value = 2
				cSQL_field = "PACKINGSLIP.SOITEM"
			ENDCASE
		CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip_No.VISIBLE
			DO CASE
			CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip_No.Value = 1
				cSQL_field = "PackingSlip_No.PACKINGSLI"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip_No.Value = 2
				cSQL_field = "PackingSlip_No.Tracking"
			ENDCASE
		CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.VISIBLE
			DO CASE
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 1
				cSQL_field = "SoldAddr.COMPANY"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 2
				cSQL_field = "SoldAddr.ADDR1"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 3
				cSQL_field = "SoldAddr.ADDR2"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 4
				cSQL_field = "SoldAddr.CITY"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 5
				cSQL_field = "SoldAddr.ST"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 6
				cSQL_field = "SoldAddr.CONTACT"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 7
				cSQL_field = "SoldAddr.TELEPHONE"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.Value = 8
				cSQL_field = "SoldAddr.FAX_NUMBER"
			ENDCASE
		CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.VISIBLE
			DO CASE
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 1
				cSQL_field = "ShipAddr.COMPANY"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 2
				cSQL_field = "ShipAddr.ADDR1"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 3
				cSQL_field = "ShipAddr.ADDR2"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 4
				cSQL_field = "ShipAddr.CITY"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 5
				cSQL_field = "ShipAddr.ST"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 6
				cSQL_field = "ShipAddr.CONTACT"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 7
				cSQL_field = "ShipAddr.TELEPHONE"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.Value = 8
				cSQL_field = "ShipAddr.FAX_NUMBER"
			ENDCASE
		CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.VISIBLE
			DO CASE
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 1
				cSQL_field = "AllQuotes.COMPANY"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 2
				cSQL_field = "AllQuotes.NAME"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 3
				cSQL_field = "AllQuotes.INQNUMP"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 4
				cSQL_field = "AllQuotes.HPAPO"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 5
				cSQL_field = "AllQuotes.BUYFROM"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 6
				cSQL_field = "AllQuotes.SALESP"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 7
				cSQL_field = "AllQuotes.PO_NUM"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 8
				cSQL_field = "AllQuotes.Alloy"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.Value = 9
				cSQL_field = "AllQuotes.Thck"
			ENDCASE
		CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.VISIBLE
			DO CASE
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.Value = 1
				cSQL_field = "Sales.SALESNUM"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.Value = 2
				cSQL_field = "Sales.PartNo"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.Value = 3
				cSQL_field = "Sales.OrderSpec"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.Value = 4
				cSQL_field = "Sales.S_Instruct"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.Value = 5
				cSQL_field = "Sales.WO"
			CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.Value = 6
				cSQL_field = "Sales.WO_Detail"		
				
			ENDCASE
		ENDCASE
		
		RETURN cSQL_field
		
	ENDPROC

	PROCEDURE getsql_order
	ENDPROC

	PROCEDURE getsql_table
		PRIVATE cReturn_Table
		cReturn_Table=""
		
		DO CASE
		CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip.VISIBLE
			cReturn_Table = "PackingSlip"
		CASE ThisFormset.frmPackingSlipHistorySearch.ogPackingSlip_No.VISIBLE
			cReturn_Table = "PackingSlip_No"
		CASE ThisFormset.frmPackingSlipHistorySearch.ogSoldAddr.VISIBLE
			cReturn_Table = "SoldAddr"
		CASE ThisFormset.frmPackingSlipHistorySearch.ogShipAddr.VISIBLE
			cReturn_Table = "ShippAddr"
		CASE ThisFormset.frmPackingSlipHistorySearch.ogAllQuotes.VISIBLE
			cReturn_Table = "AllQuotes"
		CASE ThisFormset.frmPackingSlipHistorySearch.ogSales.VISIBLE
			cReturn_Table = "Sales"
		ENDCASE
		
		RETURN 	cReturn_Table
	ENDPROC

	PROCEDURE getsql_where
		PRIVATE  cSQL_field, cSQL_table, lIsNumber, lIsTrimable, lIsFoxTable
		cSQL_field  = THISFORMSET.GetSQL_field()
		cSQL_table  = THISFORMSET.GetSQL_Table()
		lIsNumber   = THISFORMSET.IsFieldNumber( cSQL_field )
		lIsTrimable = THISFORMSET.IsTrimable( cSQL_field )
		lIsFoxTable = THISFORMSET.IsFoxTable( cSQL_table )
		
		PRIVATE vSearchText,vSearchMax,cSearchText,cSearchMax
		
		vSearchText = ThisFormset.frmPackingSlipHistorySearch.txt_search_text.VALUE
		IF TYPE("vSearchText") = "N"
			cSearchText = STR( vSearchText )
		ELSE
			cSearchText = vSearchText 
		ENDIF
		
		vSearchMax	= ThisFormset.frmPackingSlipHistorySearch.txt_search_max.VALUE
		IF TYPE("vSearchMax") = "N"
			cSearchMax = STR( vSearchMax )
		ELSE
			cSearchMax = vSearchMax
		ENDIF
		
		
		IF lIsTrimable 
			cSearchText = ALLTRIM(cSearchText)
			cSearchMax	= ALLTRIM(cSearchMax)
		ENDIF
		
		PRIVATE nSO,nItem
		IF UPPER(cSQL_field) = "PACKINGSLIP.SOITEM"
			cSearchText = Proper_SO_Item( STR(VAL( LEFT( cSearchText,7 )))+"-"+STR(VAL( RIGHT( cSearchText,2 )),2,0) )
			cSearchMax = Proper_SO_Item( STR(VAL( LEFT( cSearchMax,7 )))+"-"+STR(VAL( RIGHT( cSearchMax,2 )),2,0) )
		ENDIF
		
		
		PRIVATE cSearchTextOrig
		cSearchTextOrig = cSearchText
		
		IF EMPTY(cSearchText)
			MESSAGEBOX("Please enter something to search for!",0,"No data.")
			RETURN ''
		ENDIF
		
		PRIVATE nSearch_how, cSQL_where
		nSearch_how = ThisFormset.frmPackingSlipHistorySearch.oGrp_search_how.VALUE
		
		DIMENSION APACKINGSLI(1)
		
		IF lIsFoxTable
			IF lIsNumber
				DO CASE
				CASE nSearch_how = 1
					cSQL_where = cSQL_field + " = " + cSearchText
				CASE nSearch_how = 2
					cSQL_where = cSearchText + " $ " + cSQL_field
				CASE  nSearch_how = 3
					cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
				ENDCASE
			ELSE
				DO CASE
				CASE nSearch_how = 1
					cSQL_where = " " + cSQL_field + " LIKE '" + cSearchText +"%'"
				CASE nSearch_how = 2
					cSQL_where = '"' + cSearchText + '" $ UPPER(' + cSQL_field + ")"
				CASE  nSearch_how = 3
					cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
				ENDCASE
			ENDIF
		
		ELSE
			IF lIsNumber
				DO CASE
				CASE nSearch_how = 1
					cSQL_where = cSQL_field + " = " + cSearchText
				CASE nSearch_how = 2
					cSQL_where = cSQL_field + " LIKE '%" + cSearchText + "%'"
				CASE  nSearch_how = 3
					cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
				ENDCASE
			ELSE
				DO CASE
				CASE nSearch_how = 1
					cSQL_where = " " + cSQL_field + " LIKE '" + cSearchText +"%'"
				CASE nSearch_how = 2
					cSQL_where = " " + cSQL_field + " LIKE '%" + cSearchText +"%'"
				CASE  nSearch_how = 3
					cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
				ENDCASE
			ENDIF
		ENDIF
		
		RETURN cSQL_where 
		*****************************
		*!*	PRIVATE  cSQL_field, cSQL_table, lIsNumber, lIsFoxTable
		*!*	cSQL_field  = ThisFormset.GetSQL_field()
		*!*	cSQL_table  = ThisFormset.GetSQL_Table()
		*!*	lIsNumber   = THISFORMSet.IsFieldNumber( cSQL_field )
		*!*	lIsFoxTable = THISFORMset.IsFoxTable( cSQL_table )
		
		*!*	PRIVATE cSearchText,cSearchMax
		*!*	cSearchText = ALLTRIM(ThisFormset.frmPackingSlipHistorySearch.txt_search_text.VALUE)
		*!*	cSearchMax	= ALLTRIM(ThisFormset.frmPackingSlipHistorySearch.txt_search_max.VALUE)
		
		*!*	PRIVATE nSearch_how, cSQL_where
		*!*	nSearch_how = ThisFormset.frmPackingSlipHistorySearch.oGrp_search_how.VALUE
		
		*!*	IF lIsFoxTable
		*!*		IF plIsNumber
		*!*			DO CASE
		*!*			CASE nSearch_how = 1
		*!*				cSQL_where = cSQL_field + " = " + cSearchText
		*!*			CASE nSearch_how = 2
		*!*				cSQL_where = cSearchText + " $ " + cSQL_field
		*!*			CASE  nSearch_how = 3
		*!*				cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
		*!*			ENDCASE
		*!*		ELSE
		*!*			DO CASE
		*!*			CASE nSearch_how = 1
		*!*				cSQL_where = " " + cSQL_field + " = '" + cSearchText +"'"
		*!*			CASE nSearch_how = 2
		*!*				cSQL_where = '"' + cSearchText + '" $ UPPER(' + cSQL_field + ")"
		*!*			CASE  nSearch_how = 3
		*!*				cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
		*!*			ENDCASE
		*!*		ENDIF
		
		*!*	ELSE
		*!*		IF plIsNumber
		*!*			DO CASE
		*!*			CASE nSearch_how = 1
		*!*				cSQL_where = cSQL_field + " = " + cSearchText
		*!*			CASE nSearch_how = 2
		*!*				cSQL_where = cSQL_field + " LIKE " + cSearchText + "%"
		*!*			CASE  nSearch_how = 3
		*!*				cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
		*!*			ENDCASE
		*!*		ELSE
		*!*			DO CASE
		*!*			CASE nSearch_how = 1
		*!*				cSQL_where = " " + cSQL_field + " LIKE '" + cSearchText +"%'"
		*!*			CASE nSearch_how = 2
		*!*				cSQL_where = " " + cSQL_field + " LIKE '%" + cSearchText +"%'"
		*!*			CASE  nSearch_how = 3
		*!*				cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
		*!*			ENDCASE
		*!*		ENDIF
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETER pnSalesnum
		*DO FORM Forms\PackingSlipHistory WITH SalesNum
		
		IF TYPE("pnSalesnum") = "N"
			ThisFormset.frmPackingSlipHistorySearch.Visible = .T.
			ThisFormset.frmPackingSlipHistorySearch.cmbTables.Value = "Sales"
			ThisFormset.frmPackingSlipHistorySearch.cmbTables.InterActiveChange()
		*	ThisFormset.frmPackingSlipHistorySearch.ogSales.Value = 1
			ThisFormset.frmPackingSlipHistorySearch.txt_search_text.Value = ALLTRIM(STR(pnSalesNum))
		*	ThisFormset.frmPackingSlipHistorySearch.cmdSearch.Click()
			ThisFormSet.Searchnow()
			
			ThisFormSet.packingslip_nochange()
			
			ThisFormset.frmPackingSlipHistorySearch.cmdSearch.Click()
			ThisFormset.frmPackingSlipHistory.pf1.pgPackingSlip_NO.SetFocus()
		ENDIF
		
		* \reports\cert_conf.frx" Print When
		* USE  ALLTRIM( RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) )='Alnita Galloway'
		* Cannot use ERPCert.signature = "JohnCorra" AND ERPCert.Signed
		* HavePermission('CofC Backup')AND NOT ( ALLTRIM(RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) )='Alnita Galloway' OR ALLTRIM(RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) )='John Corra' )
	ENDPROC

	PROCEDURE isfieldnumber
		PARAMETER pSQL_Field
		
		lIsNumber = .F.
		cSQL_field = UPPER( pSQL_field )
		DO CASE
		CASE cSQL_field = "SALES.SALESNUM"  &&UPPER
			lIsNumber = .T.
		CASE cSQL_field = "PACKINGSLIP_NO.PACKINGSLI"  &&UPPER
			lIsNumber = .T.
		CASE cSQL_field = "ALLQUOTES.THCK"  &&UPPER
			lIsNumber = .T.
		EndCase
		
		RETURN lIsNumber
	ENDPROC

	PROCEDURE isfoxtable
		PARAMETER pcSQL_table
		PRIVATE lIsFoxTable 
		lIsFoxTable = .T.
		
		cSQL_table = UPPER( pcSQL_table )
		DO CASE
		CASE cSQL_table = "PACKINGSLIP"
			lIsFoxTable = .F.
		CASE cSQL_table = "PACKINGSLIP_NO"
			lIsFoxTable = .F.
		CASE cSQL_table = "SOLDADDR"
			lIsFoxTable = .F.
		CASE cSQL_table = "SHIPADDR"
			lIsFoxTable = .F.
		CASE cSQL_table = "ALLQUOTES"
			lIsFoxTable = .F.
		CASE cSQL_table = "SALES"
			lIsFoxTable = .F.
		ENDCASE
		
		
		RETURN lIsFoxTable 
	ENDPROC

	PROCEDURE istrimable
		PARAMETER pSQL_Field
		PRIVATE lIsTrimable
		lIsTrimable = .T.
		cSQL_field = UPPER( pSQL_field )
		DO CASE
		CASE cSQL_field = "SOITEM"
			lIsTrimable = .F.
		ENDCASE
		
		RETURN lIsTrimable 
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE loadpackingslip_noall
		PARAMETER pLoad
		*ThisFormSet.LoadPackingSlip_NoAll()
		
		PRIVATE lReLoad
		lReLoad = .F.
		IF VARTYPE(pLoad) = "C"
			IF pLoad = "RELOAD"
				lReLoad = .T.
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		
		IF lReLoad
			ThisFormset.frmPackingSlipHistory.grdPackingslip_no.RecordSource = ""
		ENDIF
		
		SELECT 0
		cSQL = "SELECT "
		cSQL = cSQL + " TOP 5000 "
		cSQL = cSQL + " [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&keep this order for grdPackingslip_no
		cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
		cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
		cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
		cSQL = cSQL + " FROM dbo.PackingSlip_No WITH(NOLOCK) "
		cSQL = cSQL + " ORDER BY PackingSli DESC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'PackingSlip_No')
		ENDIF
		
		SELECT PackingSlip_NO
		*GO BOTTOM
		GO TOP
		
		IF lReLoad
			ThisFormset.frmPackingSlipHistory.grdPackingslip_no.RecordSourceType = 1
			ThisFormset.frmPackingSlipHistory.grdPackingslip_no.RecordSource = "PackingSlip_NO"
		*	ThisFormset.frmPackingSlipHistory.grdPackingslip_no.clmShipVia.txtShipVia.ControlSource = "PackingSlip_NO.ShippedVia"
			ThisFormset.frmPackingSlipHistory.grdPackingslip_no.Refresh
		ELSE
		*	ThisFormset.frmPackingSlipHistory.grdPackingslip_no.RecordSource = "PackingSlip_NO"
		
		ENDIF
	ENDPROC

	PROCEDURE packingslip_nochange
		*ThisFormSet.PackingSlip_NoChange()
		*Make Changes in Search.cmdSearch also
		
		*PackingSlip_No Moved
		ThisFormSet.SeekSoldCodeInSoldAddr(PackingSlip_NO.SoldCode)
		ThisFormSet.SeekShipCodeInShipAddr(PackingSlip_NO.ShipCode)
		ThisFormSet.SeekPackingSliInPackingSlip(PackingSlip_NO.PackingSli)
		ThisFormSet.SeekPackingSliInLading(PackingSlip_No.PackingSli)
		*ThisFormSet.SeekPSiinSales_PS(PackingSlip_No.PackingSli)
		
		***
		*Now Show for movement in PackingSli
		ThisFormSet.SeekSOitemInSales(PackingSlip.SOitem)
		ThisFormSet.SeekSOitemInAllQuotes(PackingSlip.SOitem)
		ThisFormSet.SeekSOitemInShip(PackingSlip.SOItem)
		ThisFormSet.SeekSalesNumInSales_No(VAL(LEFT(PackingSlip.SOItem,8)))
		ThisFormSet.SeekPSinSales_PS(PackingSlip_No.PackingSli)
		**				
		ThisFormSet.frmPackingSlipHistory.pf1.pgItems.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgSales.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgSoldAddress.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgShipAddress.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgQuotes1.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgQuotes2.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgPackingSlip_NO.Refresh
		ThisFormSet.frmPackingSlipHistory.pf1.pgShip.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgSales_No.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgLading.Refresh()
		
	ENDPROC

	PROCEDURE searchnow
		PRIVATE  cSQL_field, cSQL_table, lIsNumber, lIsTrimable, lIsFoxTable
		cSQL_field  = THISFORMSET.GetSQL_field()
		cSQL_table  = THISFORMSET.GetSQL_Table()
		*!*	lIsNumber   = THISFORMSET.IsFieldNumber( cSQL_field )
		lIsTrimable = THISFORMSET.IsTrimable( cSQL_field )
		*!*	lIsFoxTable = THISFORMSET.IsFoxTable( cSQL_table )
		
		PRIVATE vSearchText,vSearchMax,cSearchText,cSearchMax
		
		vSearchText = ThisFormset.frmPackingSlipHistorySearch.txt_search_text.VALUE
		IF TYPE("vSearchText") = "N"
			cSearchText = STR( vSearchText )
		ELSE
			cSearchText = vSearchText 
		ENDIF
		
		vSearchMax	= ThisFormset.frmPackingSlipHistorySearch.txt_search_max.VALUE
		IF TYPE("vSearchMax") = "N"
			cSearchMax = STR( vSearchMax )
		ELSE
			cSearchMax = vSearchMax
		ENDIF
		
		
		IF lIsTrimable 
			cSearchText = ALLTRIM(cSearchText)
			cSearchMax	= ALLTRIM(cSearchMax)
		ENDIF
		
		PRIVATE nSO,nItem
		IF UPPER(cSQL_field) = "PACKINGSLIP.SOITEM"
			cSearchText = Proper_SO_Item( STR(VAL( LEFT( cSearchText,7 )))+"-"+STR(VAL( RIGHT( cSearchText,2 )),2,0) )
			cSearchMax = Proper_SO_Item( STR(VAL( LEFT( cSearchMax,7 )))+"-"+STR(VAL( RIGHT( cSearchMax,2 )),2,0) )
		ENDIF
		
		IF EMPTY(cSearchText)
			MESSAGEBOX("Please enter something to search for!",0,"No data.")
			RETURN .F.
		ENDIF
		
		PRIVATE nSearch_how
		nSearch_how = ThisFormset.frmPackingSlipHistorySearch.oGrp_search_how.VALUE
		
		PRIVATE cSQL_where,cSQL_Order
		cSQL_where = ThisFormSet.GetSQL_where()
		cSQL_Order = RIGHT(cSQL_field,LEN(cSQL_field)-AT('.',cSQL_field) )
		cSQL_Order = 'PackingSli'
		
		PRIVATE cMess
		cMess = "" 
		
		IF LEN(cSQL_where) = 0
			RETURN .F.
		ENDIF
		
		IF ThisFormSet.UseHoldAnd
			IF NOT EMPTY(ThisFormset.frmPackingSlipHistorySearch.edtHoldAnd.Value)
				cSQL_where = cSQL_where + ThisFormset.frmPackingSlipHistorySearch.edtHoldAnd.Value
			ENDIF
		ENDIF
		
		PRIVATE cPS_Where
		cPS_Where = ""
		
		PRIVATE cSQL
		PRIVATE nSQLEXEC
		
		ThisFormset.frmPackingSlipHistory.grdPackingslip_no.RecordSource = ''
		IF USED('PackingSlip_NO')
			SELECT PackingSlip_NO
		ELSE
			SELECT 0
		ENDIF
		
		DO CASE
			CASE UPPER(cSQL_table) = "PACKINGSLIP_NO"
			cSQL = "SELECT [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&Keep this order for grdPackingslip_no
			cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
			cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
			cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
			cSQL = cSQL + " FROM dbo.PackingSlip_No WITH(NOLOCK) "
			cSQL = cSQL + " WHERE "+cSQL_Where 
			cSQL = cSQL + " ORDER BY "+cSQL_Order+" DESC"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'PackingSlip_NO')
			ENDIF
				
		CASE UPPER(cSQL_table) = "PACKINGSLIP"
		
			cSQL = "SELECT [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&keep this order for grdPackingslip_no
			cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
			cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
			cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],PSn.[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
			*cSQL = cSQL + " FROM dbo.PackingSlip_No WITH(NOLOCK) "
			
			cSQL = cSQL + " FROM dbo.PackingSlip_No PSn WITH(NOLOCK) WHERE PSn.PackingSli IN "
			cSQL = cSQL + "(SELECT DISTINCT PackingSli FROM dbo.PackingSlip WITH(NOLOCK) WHERE "+cSQL_Where 
			cSQL = cSQL + "AND PackingSli > 0)"
		
			cSQL = cSQL + " ORDER BY "+cSQL_Order+" DESC"
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'PackingSlip_NO')
			ELSE
				
				IF UPPER(cSQL_field) = "PACKINGSLIP.HEAT"
					SELECT 0
					cSQL = "SELECT DISTINCT Heat FROM dbo.PackingSlip WITH(NOLOCK) WHERE "+cSQL_Where 
					cSQL = cSQL +" AND LEN(Heat) > 1 "
					cSQL = cSQL +" ORDER BY Heat "
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPS_Heat')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPS_Heat')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPS_Heat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPS_Heat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpPS_Heat')
					ENDIF
					
					IF USED('tmpPS_Heat')
						IF RECCOUNT('tmpPS_Heat') > 0
							SCAN
								IF LEN(cMess)=0
									cMess = RTRIM(tmpPS_Heat.Heat)
								ELSE
									cMess = cMess + ", "+RTRIM(tmpPS_Heat.Heat)
								ENDIF
							ENDSCAN
						ENDIF
						USE IN tmpPS_Heat
						SELECT PackingSlip_NO
					ENDIF
				ENDIF
				
				IF LEN(cMess)> 0
					MESSAGEBOX(cMess,0,"Found These")
					*WAIT WINDOW cMess NoWait
				ENDIF
			ENDIF
			
		CASE UPPER(cSQL_table) = "SALES"
			PRIVATE lcSO7, lcSO7Max
			
			lcSO7  = STR(VAL(cSearchText),7,0)
			lcSO7  = ALLTRIM(lcSO7)
			 
		 	lcSO7Max = STR(VAL(cSearchMax),7,0)
			lcSO7Max = ALLTRIM(lcSO7Max)
		
			DO CASE
			CASE nSearch_how = 1
				cSQL_where = " All_SO LIKE '%" + lcSO7 + "%'"
				*cSQL_where = " SOitem LIKE '%" + lcSO7 + "-%'"
			CASE nSearch_how = 2
				cSQL_where = " All_SO LIKE '%" + lcSO7 + "%'"
				*cSQL_where = " SOitem LIKE '%" + lcSO7 + "-%'"
			CASE  nSearch_how = 3
				cSQL_where = " All_SO LIKE '%" + lcSO7 + "%'"
				*cSQL_where = " CAST(CAST(All_SO AS CHAR(5)) AS INT) >= "+lcSO7
				*cSQL_where = cSQL_where + " AND CAST(CAST(All_SO AS CHAR(5)) AS INT) <= "+lcSO7Max 
				
				*cSQL_where = " CAST(SOitem AS INT) >= " + lcSO7 + " AND " + " CAST(SOitem AS INT) <= " + lcSO7Max + ""
			ENDCASE
			IF ThisFormSet.UseHoldAnd
				IF NOT EMPTY(ThisFormset.frmPackingSlipHistorySearch.edtHoldAnd.Value)
					cSQL_where = cSQL_where + ThisFormset.frmPackingSlipHistorySearch.edtHoldAnd.Value
				ENDIF
			ENDIF
				
			cSQL = "SELECT [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&keep this order for grdPackingslip_no
			cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
			cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
			cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
			cSQL = cSQL + " FROM dbo.PackingSlip_No WITH(NOLOCK) WHERE "+cSQL_Where 
			cSQL = cSQL + " ORDER BY "+cSQL_Order+" DESC"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'PackingSlip_NO')
			ENDIF
			
		CASE UPPER(cSQL_table) = "SOLDADDR"
		
			cSQL = "SELECT [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&keep this order for grdPackingslip_no
			cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
			cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
			cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
			cSQL = cSQL + " FROM dbo.PackingSlip_No PSn WITH(NOLOCK) WHERE PSn.SoldCode "
			cSQL = cSQL + " IN (SELECT DISTINCT SoldCode FROM dbo.SoldAddr WITH(NOLOCK) WHERE "+cSQL_Where 
			cSQL = cSQL + " AND SoldCode > 0)"
			cSQL = cSQL + " ORDER BY "+cSQL_Order+" DESC"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'PackingSlip_NO')
			ENDIF
		
		CASE UPPER(cSQL_table) = "SHIPADDR"
		
			cSQL = "SELECT [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&keep this order for grdPackingslip_no
			cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
			cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
			cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
			cSQL = cSQL + " FROM dbo.PackingSlip_No PSn WITH(NOLOCK) WHERE PSn.ShipCode "
			cSQL = cSQL + " IN (SELECT DISTINCT ShipCode FROM dbo.ShipAddr WITH(NOLOCK) WHERE "+cSQL_Where 
			cSQL = cSQL + " AND ShipCode > 0)"
			cSQL = cSQL + " ORDER BY "+cSQL_Order+" DESC"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'PackingSlip_NO')
			ENDIF
		
		CASE UPPER(cSQL_table) = "ALLQUOTES"
		
			cSQL = "SELECT [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&keep this order for grdPackingslip_no
			cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
			cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
			cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
			cSQL = cSQL + " FROM dbo.PackingSlip_No PSn WITH(NOLOCK) WHERE CAST(CAST(All_SO AS CHAR(5)) AS INT) IN ("
			cSQL = cSQL + "SELECT DISTINCT SalesNum FROM dbo.AllQuotes WITH(NOLOCK) WHERE "+cSQL_Where 
			cSQL = cSQL + " AND SalesNum > 0)"
			cSQL = cSQL + " ORDER BY "+cSQL_Order+" DESC"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'PackingSlip_NO')
			ENDIF
		
		ENDCASE
		
		****
		IF USED("PackingSlip_NO")
			IF RECCOUNT("PackingSlip_NO") > 0
				
				ThisFormset.frmPackingSlipHistory.grdPackingslip_no.RecordSource = 'PackingSlip_NO'
			*	ThisFormset.frmPackingSlipHistory.grdPackingslip_no.clmShipVia.txtShipVia.ControlSource = "PackingSlip_NO.ShippedVia"
				
				SELECT PackingSlip_NO
				COUNT ALL TO CntPackingSlip_NO
				GO TOP
				
				WAIT WINDOW "Found "+ALLTRIM(STR(CntPackingSlip_NO))+" Records in Search!" NOWAIT
				
				IF CntPackingSlip_NO = 0
					cSQL = "SELECT TOP 100 [packingsli],[ps_date],[shippedvia],[ShipFrom]"  &&keep this order for grdPackingslip_no
					cSQL = cSQL + ",[shipcode],[soldcode],[bill3code],[packedby],[checkedby]"
					cSQL = cSQL + ",[carton],[totalweight],[Kg],[all_po],[all_so],[freightcharge],CAST( LEFT([tracking],50) AS CHAR(50)) AS [Tracking]"
					cSQL = cSQL + ",[dutytax],[cod],[codcheck],[codfreightfee],[box_size],[packedweight],[PickUpDate],LEFT([WHO],50) AS [WHO]"
					cSQL = cSQL + " FROM dbo.PackingSlip_No WITH(NOLOCK) "
					cSQL = cSQL + " ORDER BY "+cSQL_Order+" DESC"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip_NO')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip_NO")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle,'PackingSlip_NO')
					ENDIF
				
					SELECT PackingSlip_NO
					GO TOP
				ELSE
					*ThisFormset.frmPackingSlipHistorySearch.cmdAddAnd.Visible = .T.
					*ThisFormset.frmPackingSlipHistorySearch.cmdORadd.Visible = .T.
					*ThisFormset.frmPackingSlipHistorySearch.cmdClearHold.Visible = .T.
					*ThisFormset.frmPackingSlipHistorySearch.edtHoldAnd.Value = cSQL_Where 
				ENDIF
			ELSE
				WAIT WINDOW "Not Found! Showing all records." NOWAIT
				ThisFormSet.LoadPackingSlip_NoAll("RELOAD")
			ENDIF
		ELSE
			WAIT WINDOW "Not Found! Showing all records." NOWAIT
			ThisFormSet.LoadPackingSlip_NoAll("RELOAD")
		ENDIF
	ENDPROC

