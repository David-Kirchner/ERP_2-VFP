	PROCEDURE seekpackingsliinlading
		PARAMETERS nPackingSli
		*ThisFormSet.SeekPackingSliInLading(PackingSlip_NO.PackingSli)
		IF EMPTY(nPackingSli)
			nPackingSli = 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('Lading')
			SELECT Lading
			*fsPS_Hist.frmPackingSlipHistory.grdPackingslip.RecordSource = ''
			*ThisFormset.frmPackingSlipHistory.grdPackingslip.RecordSource = ''
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.Lading WITH(NOLOCK) "
		*PackingSli, Pieces,DESCRIPT,NMFC,ClassRate,Weight,DecValue,bil3code,FrtCharges,DutyTax,COD,CODFrtColl,CODCertChk
		IF nPackingSli = 0
		*	cSQL = cSQL + " 0>0"
			*All
			cSQL = cSQL + " WHERE 1=1"
		ELSE
			cSQL = cSQL + " WHERE PackingSli = "+STR(nPackingSli)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Lading')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Lading')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Lading")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Lading")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Lading')
		ENDIF
		
		IF USED('Lading')
			IF VARTYPE(Lading.PackingSli)="N"
		*		ThisFormset.frmPackingSlipHistory.pf1.pgLading.Refresh
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE seekpackingsliinpackingslip
		PARAMETERS nPackingSli
		*ThisFormSet.SeekPackingSliInPackingSlip(PackingSlip_NO.PackingSli)
		IF EMPTY(nPackingSli)
			nPackingSli = 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('PackingSlip')
			SELECT PackingSlip
			*fsPS_Hist.frmPackingSlipHistory.grdPackingslip.RecordSource = ''
			ThisFormset.frmPackingSlipHistory.grdPackingslip.RecordSource = ''
			USE IN PackingSlip
		ELSE
			SELECT 0
		ENDIF
		
		*cSQL="SELECT * FROM dbo.PackingSlip "
		cSQL = "SELECT PS.* "
		cSQL = cSQL +" , (SELECT ISNULL(PartNo,'') FROM dbo.Sales WITH(NOLOCK) WHERE SOitem = PS.SOitem ) AS PartNo "
		cSQL = cSQL +" FROM dbo.PackingSlip PS WITH(NOLOCK) "
		*cSQL = cSQL +" INNER JOIN dbo.Sales S WITH(NOLOCK) ON PS.SOitem = S.SOitem "
		
		IF nPackingSli = 0
		*	cSQL = cSQL + " 0>0"
			*All
		ELSE
			cSQL = cSQL + " WHERE PS.PackingSli = "+STR(nPackingSli)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'PackingSlip')
		ENDIF
		
		IF USED('PackingSlip')
			IF VARTYPE(PackingSlip.descript)="C"
				ThisFormset.frmPackingSlipHistory.grdPackingslip.RecordSource = 'PackingSlip'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column1.ControlSource = 'packingslip.descript'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column2.ControlSource = 'packingslip.pcs'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column3.ControlSource = 'packingslip.SOitem'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column4.ControlSource = 'packingslip.Alloy'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column5.ControlSource = 'packingslip.Heat'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column6.ControlSource = 'packingslip.Lot'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column7.ControlSource = 'packingslip.Weight'
				ThisFormset.frmPackingSlipHistory.grdPackingslip.Column8.ControlSource = 'packingslip.po_num'
		
			ENDIF
		ENDIF
	ENDPROC

