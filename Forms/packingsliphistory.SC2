			ThisFormset.frmPackingSlipHistory.pf1.pgInvoice.txtSOitem.Value = ''
			ThisFormset.frmPackingSlipHistory.pf1.pgInvoice.txtHeat.Value = ''
			ThisFormset.frmPackingSlipHistory.pf1.pgInvoice.txtLot.Value = ''
			ThisFormset.frmPackingSlipHistory.pf1.pgInvoice.txtID_Detail.Value = 0
		ENDIF
