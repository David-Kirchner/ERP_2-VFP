	PROCEDURE frmPackingSlipHistory.pf1.pgItems.cmdViewCerts.Click
		
		PRIVATE cAlloy,cForm,nThck,cHeat,cLot,cLot,nID
		cAlloy	= PrepareSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
		
		*ThisFormSet.SeekSOitemInAllQuotes(PackingSlip.SOitem)
		cForm	= PrepareSQLtxt(This.parent.parent.pgQuotes1.txtForm.Value,'Form',2)
		nThck	= PrepareSQLnum(This.parent.parent.pgQuotes1.txtThck.Value,'Thck',10,4)
		
		cHeat	= PrepareSQLtxt(This.parent.txtHeat.Value,'Heat',50)
		cLot	= PrepareSQLtxt(This.parent.txtLott.Value,'Lot',10)
		IF "HPA" $ cHeat
			cTmpHeat	= ALLTRIM(LEFT( cHeat, AT("HPA",cHeat)-1))
			IF EMPTY(cLot)
				cLot		= ALLTRIM(RIGHT( cHeat, LEN(cHeat) - AT("HPA",cHeat)-2 ))
			ENDIF
			IF VAL(LEFT(cLot,1)) = 0
				cLot = RIGHT(cLot, LEN(cLot)-1)
			ENDIF
			IF VAL(LEFT(cLot,1)) = 0
				cLot = RIGHT(cLot, LEN(cLot)-1)
			ENDIF
		
			cHeat = cTmpHeat
		ELSE
		*	cLot	= ''
		ENDIF
		
		nID	= 0
		
		IF MESSAGEBOX("Do you want to use the new Scanned MTR screen?"+CHR(13)+"Answer No to view Recollect",4+32,"MTR")=6
			DO FORM "forms\MTR.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,ThisFormSet.nConnHandle
		ELSE
			DO FORM "forms\Recollect_Certs.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,ThisFormSet.nConnHandle
		ENDIF
		
	ENDPROC

