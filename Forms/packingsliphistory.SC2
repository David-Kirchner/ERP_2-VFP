		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.AllQuotes WHERE "
		
		IF EMPTY(pSOitem)
			cAll_So = ALLTRIM(PackingSlip_NO.All_So)
			cAll_So = STRTRAN( cAll_So, ";","','")
			cAll_So = IIF( LEFT(cAll_So,2) = ",'" , RIGHT(cAll_So, LEN(cAll_So)-2) , cAll_So )
		
			cSQL = cSQL + "CAST(SalesNum AS CHAR) IN ('"+cAll_So+"')"
		ELSE
			cSQL = cSQL + "SOitem = '"+pSOitem+"'"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'AllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'AllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
