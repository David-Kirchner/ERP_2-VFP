	PROCEDURE frmPackingSlipHistory.pf1.pgItems.chkCancldPkSlp.Click
		PRIVATE nPackingSli, pcSOitem, lCancledPkSlp
		nPackingSli		= PackingSlip.PackingSli 
		lCancledPkSlp	= PackingSlip.Cancld
		
		IF ISNULL(lCancledPkSlp)
			IF MESSAGEBOX( "Are you sure you want to CANCEL this Packing Slip?",4+32,"Cancel Packing Slip") = 6
				
				ThisFormSet.CancelPackingSlip()		
			ELSE
				This.Value = .F.
			ENDIF
		ELSE
			IF NOT lCancledPkSlp
				IF MESSAGEBOX( "Are you sure you want to CANCEL this Packing Slip?",4+32,"Cancel Packing Slip") = 6
					
					ThisFormSet.CancelPackingSlip()		
				ELSE
					This.Value = .F.
				ENDIF
			ELSE
				IF MESSAGEBOX( "Are you sure you want to UN-CANCEL this Packing Slip?",4+32,"UN-Cancel Packing Slip") = 6
				
					ThisFormSet.UnCancelPackingSlip()		
		
				ELSE
					This.Value = .T.
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgItems.cmdAbort.Click
		
		ThisForm.grdPackingslip_no.Enabled = .T.
		ThisForm.grdPackingslip.Enabled = .T.
		
		This.parent.txtPO_Num.enabled = .F.
		This.parent.txtAlloy.enabled = .F.
		This.parent.txtHeat.enabled = .F.
		This.parent.txtLot.enabled = .F.
		This.parent.txtPcs.enabled = .F.
		This.parent.txtDescript.enabled = .F.
		This.parent.txtWeight.enabled = .F.
		This.parent.txtPartNo.Enabled = .F.
		
		This.parent.txtPO_Num.ControlSource = 'packingslip.PO_Num'
		This.parent.txtAlloy.ControlSource = 'packingslip.alloy'
		This.parent.txtHeat.ControlSource = 'packingslip.heat'
		This.parent.txtLot.ControlSource = 'packingslip.lot'
		This.parent.txtPcs.ControlSource = 'packingslip.pcs'
		This.parent.txtDescript.ControlSource = 'packingslip.descript'
		This.parent.txtWeight.ControlSource = 'packingslip.weight'
		This.parent.txtPartNo.ControlSource = 'packingslip.PartNo'
		
		This.Parent.cmdEdit.Visible = .T.
		This.Parent.cmdEdit.Caption = "Edit"
		This.Visible = .F.
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgItems.cmdEdit.Click
		IF NOT HavePermission('PackingSlip Edit')
			MESSAGEBOX("You are not permited to Edit here!",0,"No Edit")
			TrackError("not permited to Edit here.","not permited to Edit here."+CHR(13)+"HavePermission('PackingSlip Edit').","packingsliphistory:frmPackingSlipHistory.pf1.pgItems.cmdEdit.Click",LINENO(1))
			RETURN .F.
		ENDIF
		
		IF This.Caption = "Edit"
			*Place in Edit Mode
			
			ThisForm.grdPackingslip_no.Enabled = .F.
			ThisForm.grdPackingslip.Enabled = .F.
		
			This.parent.txtPO_Num.enabled = .T.
			This.parent.txtAlloy.enabled = .T.
			This.parent.txtHeat.enabled = .T.
			This.parent.txtLot.enabled = .T.
			This.parent.txtPcs.enabled = .T.
			This.parent.txtDescript.enabled = .T.
			This.parent.txtWeight.enabled = .T.
			This.parent.txtPartNo.Enabled = .T.
			
			This.parent.txtPO_Num.ControlSource = ''
			This.parent.txtAlloy.ControlSource = ''
			This.parent.txtHeat.ControlSource = ''
			This.parent.txtLot.ControlSource = ''
			This.parent.txtPcs.ControlSource = ''
			This.parent.txtDescript.ControlSource = ''
			This.parent.txtWeight.ControlSource = ''
		
			This.parent.cmdAbort.Visible = .T.
			This.Caption = "Save"
		ELSE
		
			*Save
			PRIVATE nID_PackingSlip,nPackingSli,cPO_Num,cAlloy,cHeat,cLot,nPcs,cDescript,nWeight,cPartNo 
			nID_PackingSlip	= PrepareSQLnum(This.parent.txtID_PackingSlip.Value,'ID_PackingSlip',-3)
			nPackingSli	= PrepareSQLnum(This.parent.txtPackingSli.Value,'PackingSli',-3)
			
			cPO_Num	= PrepareSQLtxt(This.parent.txtPO_Num.Value,'PO_Num',20)
			cAlloy	= PrepareSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
			cHeat	= PrepareSQLtxt(This.parent.txtHeat.Value,'Heat',50)
			cLott	= PrepareSQLtxt(This.parent.txtLot.Value,'Lot',10)
			nPcs	= PrepareSQLnum(This.parent.txtPcs.Value,'PCS',-3)
			cDescript	= PrepareSQLtxt(This.parent.txtDescript.Value,'Descript',80)
			nWeight		= PrepareSQLnum(This.parent.txtWeight.Value,'Weight',7,1)
			cPartNo 	= PrepareSQLtxt(This.parent.txtPartNo.Value,'PartNo',100)
			
			IF nID_PackingSlip > 0
				PRIVATE cSQL
				cSQL = "UPDATE dbo.PackingSlip SET "
				cSQL = cSQL + " PO_Num='"+cPO_Num+"'"
				cSQL = cSQL + ",Alloy='"+cAlloy+"'"
				cSQL = cSQL + ",Heat='"+cHeat+"'"
				cSQL = cSQL + ",Lot='"+cLott+"'"
				cSQL = cSQL + ",Pcs="+STR(nPCS)
				cSQL = cSQL + ",Descript='"+cDescript+"'"
				cSQL = cSQL + ",Weight="+STR(nWeight,7,1)
				cSQL = cSQL + ",PartNo='"+cPartNo+"'"
				cSQL = cSQL + " WHERE ID_PackingSlip="+STR(nID_PackingSlip)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Updated!' NOWAIT
					TrackMess("UPDATE dbo.PackingSlip WHERE ID_PackingSlip="+STR(nID_PackingSlip) )
					
					SELECT PackingSlip
					**Send in 0 for nID_PackingSlip, so ALL records are quered.
					ThisFormSet.SeekPackingSliInPackingSlip( 0 )		
					LOCATE FOR ID_PackingSlip = nID_PackingSlip
						
				ENDIF
				
			ELSE
				MESSAGEBOX("Did not get the PackingSlip Number",0,"No save")
			ENDIF
			
			
			ThisForm.grdPackingslip_no.Enabled = .T.
			ThisForm.grdPackingslip.Enabled = .T.
		
			This.parent.txtPO_Num.enabled = .F.
			This.parent.txtAlloy.enabled = .F.
			This.parent.txtHeat.enabled = .F.
			This.parent.txtLot.enabled = .F.
			This.parent.txtPcs.enabled = .F.
			This.parent.txtDescript.enabled = .F.
			This.parent.txtWeight.enabled = .F.
			This.parent.txtPartNo.Enabled = .F.
			
			This.parent.txtPO_Num.ControlSource = 'packingslip.PO_Num'
			This.parent.txtAlloy.ControlSource = 'packingslip.alloy'
			This.parent.txtHeat.ControlSource = 'packingslip.heat'
			This.parent.txtlot.ControlSource = 'packingslip.Lot'
			This.parent.txtPcs.ControlSource = 'packingslip.pcs'
			This.parent.txtDescript.ControlSource = 'packingslip.descript'
			This.parent.txtWeight.ControlSource = 'packingslip.weight'
			This.parent.txtPartNo.ControlSource = 'packingslip.PartNo'
			
			This.parent.cmdAbort.Visible = .F.
			This.Caption = "Edit"
		ENDIF
		
	ENDPROC

