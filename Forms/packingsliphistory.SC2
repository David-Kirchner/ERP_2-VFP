	PROCEDURE frmPackingSlipHistory.cmdPS_BarCode.Click
		PRIVATE nPS_NO, cMEM
		nPS_NO = PackingSlip_NO.PackingSli
		cMEM = ''
		
		TRY
			cMEM = EncodeToDataMatrixString("ABC123")
			
			MESSAGEBOX("Print Bar code",0,"starting")
			
			SET DELETED ON
		
			*SELECT PackingSlipItem
			* SEEK ThisFormSet.frmPackingSlipHistory.SoldAddr ORDER TAG SoldCode IN SoldAddr
			* SEEK ThisFormSet.frmPackingSlipHistory.ShipAddr ORDER TAG ShipCode IN ShipAddr
			* SEEK ThisFormSet.frmPackingSlipHistory.Bill3Addr ORDER TAG Bill3Addr IN Bill3Addr  &&USE SoldAddr AGAIN ALIAS Bill3Addr 
			ThisFormSet.SeekSoldCodeInSoldAddr(PackingSlip_NO.SoldCode)
			ThisFormSet.SeekShipCodeInShipAddr(PackingSlip_NO.ShipCode)
		
			PRIVATE cSQL, nSQLEXEC
			IF USED('Bill3Addr')
				SELECT Bill3Addr
			ELSE
				SELECT 0
			ENDIF
		
			cSQL="SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
			*IF ThisFormSet.frmPackingSlipHistory.Bill3Addr = 0
			IF ThisForm.pf1.pgPackingSlip_NO.txtBill3code.Value = 0
				cSQL = cSQL + " WHERE 0>0"
			ELSE
				cSQL = cSQL + " WHERE SoldCode = "+STR(ThisForm.pf1.pgPackingSlip_NO.txtBill3code.Value)
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Bill3Addr')
			ENDIF
		
			SELECT PackingSlip_NO
			SELECT PackingSlip
			
			IF USED('PackingSlipItem')
				USE IN PackingSlipItem
			ENDIF
			SELECT 0
			
			cSQL = "SELECT * "
			cSQL = cSQL + " ,ISNULL(S.PartNo,'') as PartNo "
			cSQL = cSQL + " FROM dbo.PackingSlip WITH(NOLOCK) "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = PackingSlip.SOitem"
			cSQL = cSQL + " WHERE PackingSli = "+STR(nPS_NO )
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlipItem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlipItem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlipItem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlipItem")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'PackingSlipItem')
			ENDIF
			
			** Fill PackingSlipItem Table
			*SELECT * FROM PackingSlip INTO PackingSlipItem WHERE PackingSlip.PackingSli = nPS_NO 
			*INSERT INTO PackingSlipItem SELECT * FROM PackingSlip WHERE PackingSlip.PackingSli = nPS_NO 
			*CREATE SQL VIEW PackingSlipItem AS SELECT * FROM PackingSlip WHERE PackingSlip.PackingSli = nPS_NO 
			
			*******************
			IF "TWIN CITY FAN" $ UPPER(SoldAddr.Company) OR "TWIN CITY FAN" $ UPPER(ShipAddr.Company) OR "TWIN CITY FAN" $ UPPER(Bill3Addr.Company)
		*!*			IF NOT USED('PackingSlipItem')
		*!*				SELECT 0
		*!*				SELECT * FROM PackingSlip WHERE PackingSli = nPS_NO INTO CURSOR PackingSlipItem
		*!*			ENDIF
				SELECT PackingSlipItem
				REPORT FORM Reports\PackingSlip_BarCode FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			ENDIF
		
			*******************
			IF "FLOWSERVE" $ UPPER(SoldAddr.Company) OR "FLOWSERVE" $ UPPER(ShipAddr.Company) OR "FLOWSERVE" $ UPPER(Bill3Addr.Company)
				SELECT PackingSlipItem
				*REPORT FORM Reports\PackingSlip_2D FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
				REPORT FORM Reports\PackingSlip_FlowServe FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
				
				*http://peregrine.windfall.hpa.local/ReportS/report/PackingSlip/Packing%20Slip%20-%20FlowServe?Packingsli=4001
				
				IF nPS_NO > 0
					cHyperLink = HTML_PackingSli_DataMatrix( nPS_NO, "FLOWSERVE", .T. )
					IF LEN(cHyperLink)>0
		
						PRIVATE loHyperlink
						loHyperlink = CREATEOBJECT("Hyperlink")
						loHyperlink.navigateto(cHyperLink)
						RELEASE loHyperlink
						
						MESSAGEBOX("Look for a Report Server window",0,"Packing Slip with Bar Code")
						
					ELSE
						MESSAGEBOX("No Hyperlink",16,"Cannot show Packing Slip Bar Code")
						
					ENDIF
				ELSE
					MESSAGEBOX("No HPA Packing Slip number",16,"Cannot show Packing Slip")
				ENDIF
		
			ENDIF
		
			*******************
			IF "OMEGA" $ UPPER(SoldAddr.Company) OR "OMEGA" $ UPPER(ShipAddr.Company) OR "OMEGA" $ UPPER(Bill3Addr.Company)
				SELECT PackingSlipItem
				REPORT FORM Reports\PackingSlip_Omega FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			ENDIF
		
			*******************
			IF "TW METALS" $ UPPER(SoldAddr.Company) OR "TW METALS" $ UPPER(ShipAddr.Company) OR "TW METALS" $ UPPER(Bill3Addr.Company)
				*OR CustID = "FlowTN"
				SELECT PackingSlipItem
				REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
				REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
				REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
				
				MESSAGEBOX("Please note that the 'TW Metals' Bar Code label needs to be placed near Packing Slip and both ends."+CHR(13)+"Triplicate print",64,"Barcode Label")
			ENDIF
		
		
			*******************	*******************
			IF USED('PackingSlipItem')
				USE IN PackingSlipItem
			ENDIF
		
			SET DELETED OFF
		
			SELECT PackingSlip
			LOCATE FOR PackingSlip.PackingSli = nPS_NO
		
			ThisFormSet.frmPackingSlipHistory.grdPackingslip_no.SetFocus()
			This.SetFocus()
		
		CATCH
			TrackError("Could not EncodeToDataMatrixString('ABC123')"+CHR(13)+"Encoded="+cMEM+CHR(13)+"PackingSli="+STR(nPS_NO),"Could not EncodeToDataMatrixString(ABC123)", PROGRAM(), LINENO(1))
			MESSAGEBOX("Error with DLL that Encodes the text to 2D",0,"Error")
		ENDTRY
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.cmdRePrint.Click
		nPS_NO = PackingSlip_NO.PackingSli
		SET DELETED ON
		
		*SELECT PackingSlipItem
		* SEEK ThisFormSet.frmPackingSlipHistory.SoldAddr ORDER TAG SoldCode IN SoldAddr
		* SEEK ThisFormSet.frmPackingSlipHistory.ShipAddr ORDER TAG ShipCode IN ShipAddr
		* SEEK ThisFormSet.frmPackingSlipHistory.Bill3Addr ORDER TAG Bill3Addr IN Bill3Addr  &&USE SoldAddr AGAIN ALIAS Bill3Addr 
		ThisFormSet.SeekSoldCodeInSoldAddr(PackingSlip_NO.SoldCode)
		ThisFormSet.SeekShipCodeInShipAddr(PackingSlip_NO.ShipCode)
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('Bill3Addr')
			SELECT Bill3Addr
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
		*IF ThisFormSet.frmPackingSlipHistory.Bill3Addr = 0
		IF ThisForm.pf1.pgPackingSlip_NO.txtBill3code.Value = 0
			cSQL = cSQL + " WHERE 0>0"
		ELSE
			cSQL = cSQL + " WHERE SoldCode = "+STR(ThisForm.pf1.pgPackingSlip_NO.txtBill3code.Value)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Bill3Addr')
		ENDIF
		
		**********
		SELECT PackingSlip_NO  && "*PS"+ALLTRIM(STR(PACKINGSLIP_NO.PACKINGSLI,10,0))+"*"
		SELECT PackingSlip
		
		*********
		IF USED('PackingSlipItem')
			USE IN PackingSlipItem
		ENDIF
		
		SELECT 0 
		
		cSQL = " SELECT S.SalesNum "
		cSQL = cSQL+" , PS.SOItem,  PS.PCs, AQ.Alloy, PS.Heat, ISNULL(PS.Lot,'') AS Lot, PS.Descript, PS.Weight, PSN.PackingSli, S.PartNo " &&, S.Lot
		cSQL = cSQL+" , PS.PackedWeight as PackWeight, AQ.Form, AQ.CC, AQ.CL "
		cSQL = cSQL+" ,AQ.Descript as AQDescript "
		cSQL = cSQL+" ,AQ.Thck as Dim1, AQ.Sz2 as Dim2, AQ.Sz3 as Dim3, AQ.RandLen, Aq.Metric, AQ.PO_num "
		cSQL = cSQL+" ,PS.SO_QTY as QTY, AQ.S_PU, 0 as SS_ID, 0 as tmpPSnum, 0 as SOi_cmplt "
		cSQL = cSQL+" ,'' AS TBL, 0 as SL_ID, 0 as SL_ID_D, 0 as ID_D_Proc, PS.PT_P as SL_P, PS.PT_QTY as SL_QTY "
		cSQL = cSQL+" FROM PackingSlip_No PSN WITH(NOLOCK) "
		cSQL = cSQL+" INNER JOIN dbo.PackingSlip PS WITH(NOLOCK) ON PSN.Packingsli = PS.Packingsli "
		cSQL = cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON PS.SOitem = S.SOitem "
		cSQL = cSQL+" INNER JOIN dbo.AllQuotes AQ WITH(NOLOCK) ON PS.SOitem = AQ.SOitem "
		cSQL = cSQL+" WHERE PSN.PackingSli = "+STR(nPS_NO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlipItem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlipItem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlipItem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlipItem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'PackingSlipItem')
		ENDIF
		IF NOT USED('PackingSlipItem')
			TrackError("Did not create PackingSlipItem Table","Did not create PackingSlipItem", PROGRAM(), LINENO(1))
		ENDIF
			
		SELECT PackingSlip
		
		*********************
		
		IF FILE('PackingSlip_reprint.frx')
			REPORT FORM PackingSlip_reprint FOR PackingSlip.PackingSli = nPS_NO TO PRINTER PROMPT NOCONSOLE
		ELSE
			IF FILE('Reports\PackingSlip_reprint.frx')
				REPORT FORM Reports\PackingSlip_reprint FOR PackingSlip.PackingSli = nPS_NO TO PRINTER PROMPT NOCONSOLE
			ELSE
				IF FILE('Quotes\Reports\PackingSlip_reprint.frx')
					REPORT FORM Quotes\Reports\PackingSlip_reprint FOR PackingSlip.PackingSli = nPS_NO TO PRINTER PROMPT NOCONSOLE
				ENDIF
			ENDIF
		ENDIF
		SET DELETED OFF
		
		*******************
		IF "TWIN CITY FAN" $ UPPER(SoldAddr.Company) OR "TWIN CITY FAN" $ UPPER(ShipAddr.Company) OR "TWIN CITY FAN" $ UPPER(Bill3Addr.Company)
			SELECT PackingSlipItem
			REPORT FORM Reports\PackingSlip_BarCode FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
		ENDIF
		
		*******************
		IF "FLOWSERVE" $ UPPER(SoldAddr.Company) OR "FLOWSERVE" $ UPPER(ShipAddr.Company) OR "FLOWSERVE" $ UPPER(Bill3Addr.Company)
			*OR CustID = "FlowTN"
			SELECT PackingSlipItem
			REPORT FORM Reports\PackingSlip_2D FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			MESSAGEBOX("Please note that the FlowServe printed 2D Bar Code label needs to be placed with the material.",64,"2Barcode Label")
		ENDIF
		
		*******************
		IF "OMEGA" $ UPPER(SoldAddr.Company) OR "OMEGA" $ UPPER(ShipAddr.Company) OR "OMEGA" $ UPPER(Bill3Addr.Company)
			SELECT PackingSlipItem
			REPORT FORM Reports\PackingSlip_Omega FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			MESSAGEBOX("Please note that the Omega Bar Code label needs to be placed with the material.",64,"Barcode Label")
		ENDIF
		
		*******************
		IF "TW METALS" $ UPPER(SoldAddr.Company) OR "TW METALS" $ UPPER(ShipAddr.Company) OR "TW METALS" $ UPPER(Bill3Addr.Company)
			*OR CustID = "FlowTN"
			SELECT PackingSlipItem
			REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			REPORT FORM Reports\PackingSlip_TW_Metals FOR PackingSlipItem.PackingSli = nPS_NO TO PRINTER NOCONSOLE
			
			MESSAGEBOX("Please note that the 'TW Metals' Bar Code label needs to be placed near Packing Slip and both ends.",64,"Barcode Label")
		ENDIF
		
		
		*******************
		IF USED('PackingSlipItem')
			USE IN PackingSlipItem
		ENDIF
		
		SELECT PackingSlip
		LOCATE FOR PackingSlip.PackingSli = nPS_NO
		
		ThisFormSet.frmPackingSlipHistory.grdPackingslip_no.SetFocus()
		This.SetFocus()
	ENDPROC

	PROCEDURE frmPackingSlipHistory.cmdSearch.Click
		*Set Default Sales
		ThisFormset.frmPackingSlipHistorySearch.cmbTables.Value = "Sales"
		ThisFormset.frmPackingSlipHistorySearch.ogSales.Visible = .T.
		ThisFormset.frmPackingSlipHistorySearch.txt_search_text.InputMask = "999999"
		ThisFormset.frmPackingSlipHistorySearch.txt_search_max.InputMask  = "999999"
		
		ThisFormset.frmPackingSlipHistorySearch.AlwaysOnTop = .T.	
		ThisFormset.frmPackingSlipHistorySearch.Visible = .T.
		ThisFormset.frmPackingSlipHistorySearch.AlwaysOnTop = .F.
	ENDPROC

	PROCEDURE frmPackingSlipHistory.cmdSearchAll.Click
		ThisFormset.frmPackingSlipHistorySearch.Visible = .F.
		
		ThisFormSet.LoadPackingSlip_NoAll("RELOAD")
		
		SELECT PackingSlip_No
		SET FILTER TO
		ThisFormSet.PackingSlip_NoChange()
	ENDPROC

	PROCEDURE frmPackingSlipHistory.cmdTestDM.Click
		PRIVATE cPackingSli
		cPackingSli = PrepareSQLtxt(ThisForm.pf1.pgItems.txtPackingSli.Value,'PackingSli',10)
		ThisformSet.frmDataMatrix.Visible = .T.
		*ThisformSet.frmDataMatrix.Olecontrol1.Visible = .T.
		*ThisformSet.frmDataMatrix.Olecontrol1.DataToEncode = cPackingSli
		ThisformSet.frmDataMatrix.Text1.Value = cPackingSli
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisformSet.frmDataMatrix.Text2.Value = EncodeToDataMatrixString( cPackingSli )
		ThisformSet.frmDataMatrix.Text3.Value = EncodeToDataMatrixString( cPackingSli )
		
		*Source: "C:\Program Files (x86)\HPA\INCLUDE\DataMatrix.net.dll"; DestDir: "{sys}"; 
		*Filename: "C:\Windows\Microsoft.NET\Framework\v4.0.30319\RegAsm"; Parameters: "C:\Program Files (x86)\HPA\INCLUDE\DataMatrix.net.dll /codebase";   Description: "to run DataMatrix"; Flags: postinstall shellexec skipifsilent
		*cmd prompt as Administrator! "C:\Windows\Microsoft.NET\Framework\v4.0.30319\RegAsm" "C:\Program Files (x86)\HPA\INCLUDE\DataMatrix.net.dll" /codebase
		
		WAIT WINDOW "DM -DataMatrix is a 3D code, different from the 2D bar code." NOWAIT
	ENDPROC

	PROCEDURE frmPackingSlipHistory.Destroy
		IF ThisFormSet.SetDeleted = "ON"
			SET DELETED ON
		ENDIF
		
		IF USED('PackingSlip_NO') AND ThisFormSet.close_PackingSlip_NO
			USE IN PackingSlip_NO
		ENDIF
		IF USED('ShipAddr') AND ThisFormSet.close_ShipAddr
			USE IN ShipAddr
		ENDIF
		IF USED('Bill3Addr') AND ThisFormSet.close_Bill3Addr
			*close Bill3Addr Before SoldAddr
			USE IN Bill3Addr
		ENDIF
		IF USED('SoldAddr') AND ThisFormSet.close_SoldAddr
			USE IN SoldAddr
		ENDIF
		IF USED('PackingSlip') AND ThisFormSet.close_PackingSlip
			USE IN PackingSlip
		ENDIF
		IF USED('Sales') AND ThisFormSet.close_Sales
			USE IN Sales
		ENDIF
		IF USED('AllQuotes') AND ThisFormSet.close_AllQuotes
			USE IN AllQuotes
		ENDIF
		IF USED('Ship') AND ThisFormSet.close_Ship
			USE IN Ship
		ENDIF
		IF USED('Sales_NO') AND ThisFormSet.close_Sales_NO
			USE IN Sales_NO
		ENDIF
		IF USED('Lading') AND ThisFormSet.close_Lading
			USE IN Lading
		ENDIF
		
		*!*	IF USED("UPSTracking") AND ThisFormSet.close_UPSTracking
		*!*		USE IN UPSTracking
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.grdPackingslip.AfterRowColChange
		LPARAMETERS nColIndex
		*SEEK PackingSlip.SOItem IN Sales ORDER TAG SOItem
		*SEEK PackingSlip.SOItem IN AllQuotes ORDER AQ_SOItm
		*SEEK VAL(LEFT(PackingSlip.SOItem,8)) IN Sales_No ORDER TAG SalesNum
		ThisFormSet.SeekSOitemInSales(PackingSlip.SOitem)
		ThisFormSet.SeekSOitemInAllQuotes(PackingSlip.SOitem)
		ThisFormSet.SeekSOitemInShip(PackingSlip.SOItem)
		ThisFormSet.SeekSalesNumInSales_No(VAL(LEFT(PackingSlip.SOItem,8)))
		ThisFormSet.SeekPSinSales_PS(PackingSlip_No.PackingSli)
		**
		ThisFormSet.frmPackingSlipHistory.pf1.pgItems.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgSales.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgSoldAddress.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgShipAddress.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgQuotes1.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgQuotes2.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgPackingSlip_NO.Refresh
		ThisFormSet.frmPackingSlipHistory.pf1.pgShip.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgSales_No.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgLading.Refresh()
		ThisFormSet.frmPackingSlipHistory.pf1.pgSales_PS.Refresh()
		
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.grdPackingslip_no.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.PackingSlip_NoChange()
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.Init
		
		ThisFormSet.SetDeleted = SET("DELETED")
		SET DELETED ON
		
		ThisFormSet.PackingSlip_NoChange()
	ENDPROC

	PROCEDURE frmPackingSlipHistory.Load
		
		ThisFormSet.close_PackingSlip_NO = .F.
		ThisFormSet.close_ShipAddr		= .F.
		ThisFormSet.close_SoldAddr		= .F.
		ThisFormSet.close_Bill3Addr		= .F.
		ThisFormSet.close_PackingSlip	= .F.
		ThisFormSet.close_Sales			= .F.
		ThisFormSet.close_AllQuotes		= .F.
		ThisFormSet.close_Ship			= .F.
		ThisFormSet.close_Sales_NO		= .F.
		ThisFormSet.close_Lading		= .F.
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED('PackingSlip_NO')
			USE IN PackingSlip_No
		ELSE
			ThisFormSet.close_PackingSlip_NO = .T.
		ENDIF
		
		ThisFormSet.LoadPackingSlip_NoAll()
		*ThisFormset.frmPackingSlipHistory.grdPackingslip_no.clmShipVia.txtShipVia.ControlSource = "PackingSlip_NO.ShippedVia"
		
		*******************************
		
		IF USED('ShipAddr')
			USE IN ShipAddr
			*USE HPA!ShipAddr IN 0 SHARED ORDER TAG shipcode
		ENDIF
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'ShipAddr')
		ENDIF
		
		ThisFormSet.close_ShipAddr = .T.
		
		*********************************
		
		IF USED('SoldAddr')
			USE IN SoldAddr
			*USE HPA!SoldAddr IN 0 SHARED ORDER TAG soldcode
		ENDIF
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'SoldAddr')
		ENDIF
		
		ThisFormSet.close_SoldAddr = .T.
		
		IF USED('Bill3Addr') 
			USE IN Bill3Addr
		*	USE HPA!SoldAddr AGAIN ALIAS Bill3Addr IN 0 ORDER TAG Bill3Addr 
		ENDIF
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Bill3Addr')
		ENDIF
		
		ThisFormSet.close_Bill3Addr = .T.
			
		IF USED('PackingSlip')
			USE IN PackingSlip
		ELSE
			ThisFormSet.close_PackingSlip = .T.
		ENDIF
		
		SELECT 0
		cSQL = "SELECT PS.*, S.PartNo FROM dbo.PackingSlip PS WITH(NOLOCK) " 
		cSQL = cSQL +" INNER JOIN dbo.Sales S WITH(NOLOCK) ON PS.SOitem = S.SOitem "
		cSQL = cSQL + " WHERE 0>0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PackingSlip')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PackingSlip")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'PackingSlip')
		ENDIF
		
		************************
		IF USED('Sales')
			*USE HPA!Sales IN 0 SHARED ORDER TAG SOITEM
			USE IN Sales
		EndIf
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.Sales WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Sales')
		ENDIF
		
		ThisFormSet.close_Sales = .T.
		************************
		IF USED('Sales_PS')
			USE IN Sales_PS
		EndIf
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.Sales_PS WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_PS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_PS')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_PS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_PS")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Sales_PS')
		ENDIF
		
		*ThisFormSet.close_Sales = .T
		************************
		
		
		IF !USED('AllQuotes')
			ThisFormSet.close_AllQuotes = .T.
			
			IF ThisFormSet.nConnHandle < 0
				*= MESSAGEBOX('Cannot make FAST connection', 16, 'SQL Connect Error')
		*		USE HPA!AllQuotes SHARED IN 0 ORDER TAG SOITEM
			ELSE
				SELECT 0
				cSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) WHERE 0 > 0"
				*cSQL="SELECT TOP 1 * FROM dbo.AllQuotes ORDER BY SalesNum DESC"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'AllQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'AllQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
		*			USE HPA!AllQuotes SHARED IN 0 ORDER TAG SOITEM
		*		ELSE
		*			SELECT AllQuotes
		*			INDEX ON SOitem TAG SOItem
				ENDIF
			ENDIF
		
		ENDIF
		
		*!*	***************************
		*!*	*Clean UPS Tracking  - now done with SQL trigger on UPStracking!!
		*!*	***************************
		*!*	PRIVATE lDELETEUPSTracking 
		*!*	lDELETEUPSTracking = .F.
		
		*!*	IF USED('UPSTracking')
		*!*		USE IN UPSTracking
		*!*	ENDIF
		*!*	IF USED('tUPSTracking')
		*!*		USE IN tUPSTracking
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "DELETE FROM dbo.UPSTracking WHERE VOID = 'Y'"
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO 
		*!*			ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
		*!*	ENDIF
		
		*!*	cSQL = "SELECT * FROM dbo.UPSTracking "
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tUPSTracking")
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tUPSTracking")
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO 
		*!*			ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, "tUPSTracking")
		*!*	ENDIF
		*!*			
		*!*	*IF NOT USED('UPSTracking')
		*!*	*	USE HPA!UPSTracking IN 0 
		*!*		SELECT tUPSTracking
		
		*!*	*	WAIT WINDOW "UPSTracking" NOWAIT
		*!*	*	INDEX ON UPSTrack TAG UPSTrack 
		*!*		PRIVATE nPackingSli
		*!*		SCAN
		*!*		IF tUPSTracking.void = "N"
		*!*			IF NOT ISNULL(tUPSTracking.PackingSli)
		*!*				IF ALLTRIM(tUPSTracking.PackingSli) = ALLTRIM(STR(VAL(tUPSTracking.PackingSli)))
		*!*					IF NOT EMPTY(tUPSTracking.TrackID)
		*!*						*SEEK tUPSTracking.PackingSli ORDER PackingSli IN PackingSlip_NO
		*!*						*IF FOUND("PackingSlip_NO")
		*!*						nPackingSli = VAL(tUPSTracking.PackingSli)
		*!*						IF nPackingSli > 0
		*!*							IF Count_PackingSliinPackingSlip_No( nPackingSli,ThisFormSet.nConnhandle ) > 0
		*!*								*UPDATE PackingSlip_NO SET Tracking = tUPSTracking.TrackID WHERE PackingSli = VAL(tUPSTracking.PackingSli)
		*!*								UPDATE_TrackinginPackingSlip_No(tUPSTracking.TrackID, nPackingSli, ThisFormSet.nConnHandle)
		*!*								lDELETEUPSTracking = .T.
		*!*							ELSE
		*!*								*DELETE IN UPSTracking
		*!*								*do not delete to show what was not found!!
		*!*								lDELETEUPSTracking = .F.
		*!*							ENDIF
		*!*						ELSE
		*!*							*Not a PackingSlip NUMBER!
		*!*							lDELETEUPSTracking = .T.
		*!*						ENDIF
		*!*					ELSE
		*!*						*EMPTY, Not a PackingSlip NUMBER!
		*!*						lDELETEUPSTracking = .T.
		*!*					ENDIF
		*!*				ELSE
		*!*					lDELETEUPSTracking = .T.
		*!*					*Not a PackingSli Number!!
		*!*				ENDIF
		*!*			ELSE
		*!*				*null
		*!*				lDELETEUPSTracking = .F.
		*!*			ENDIF
		*!*		ELSE
		*!*			IF ISNULL(tUPSTracking.PackingSli)
		*!*				*null
		*!*				lDELETEUPSTracking = .F.
		*!*			ELSE
		*!*				lDELETEUPSTracking = .T.
		*!*				*delete voided
		*!*			ENDIF
		*!*		ENDIF	
		*!*		
		*!*		IF lDELETEUPSTracking
		*!*			PRIVATE cPackingSlip
		*!*			cPackingSlip = PrepareSQLtxt(tUPSTracking.PackingSli, 'PackingSli', 50)
		*!*			cSQL = "DELETE FROM dbo.UPSTracking WHERE PackingSli = '"+cPackingSlip+"'"
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "AllQuotes")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO 
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		SELECT tUPSTracking
		*!*		ENDSCAN
		*!*		
		*!*		
		*!*		WAIT WINDOW "PackingSli" NOWAIT
		*!*	*	INDEX ON PackingSli TAG PackingSli
		*!*	*	SET ORDER TO TAG PackingSli
		
		*!*	IF USED('tUPSTracking')
		*!*		USE IN tUPSTracking
		*!*	ENDIF	
				
		*ENDIF
		**************
		*!*	IF NOT USED('Ship')
		*!*		USE HPA!Ship IN 0 SHARED ORDER TAG SOITEM
		*!*		ThisFormSet.close_Ship	= .T.
		*!*	EndIf
		IF USED('Ship')
			USE IN Ship
		ENDIF
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.Ship WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Ship')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Ship')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Ship")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Ship")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Ship')
		ENDIF
		
		ThisFormSet.close_Ship = .T.
		
		**************
		IF USED('Sales_NO')
			USE IN Sales_No
		ENDIF
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.Sales_NO WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_NO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_NO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_NO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_NO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Sales_NO')
		ENDIF
		
		ThisFormSet.close_Sales_NO = .T.
		
		**************
		
		IF USED('Lading')
			USE IN Lading
		ENDIF
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.Lading WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Lading')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Lading')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Lading")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Lading")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Lading')
		ENDIF
		
		ThisFormSet.close_Lading = .T.
		
		**************
		
		IF USED('tmpSales_PS')
			USE IN tmpSales_PS
		ENDIF
			
		SELECT 0
		cSQL = "SELECT * FROM dbo.Sales_PS WITH(NOLOCK) WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_PS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_PS')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_PS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_PS")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSales_PS')
		ENDIF
		
		ThisFormSet.close_Sales_PS = .T.
		
		**************
		*SET SAFETY OFF
		*WAIT WINDOW "Building SOItem Index - Please Wait !" NOWAIT
		*SELECT AllQuotes
		*INDEX ON SOItem TAG SOItem OF AllQuotes
		*SET ORDER TO TAG SOItem
		*INDEX ON SOItem TO SYS(5)+SYS(2003)+"\AQ_SOItm"
		*SET ORDER TO AQ_SOItm
		
		**************
		SELECT PackingSlip_NO
		GO TOP
		*SEEK PackingSlip_NO.SoldCode IN SoldAddr ORDER TAG SoldCode
		*SEEK PackingSlip_NO.ShipCode IN ShipAddr ORDER TAG ShipCode
		*SEEK PackingSlip_NO.PackingSli IN PackingSlip ORDER TAG PackingSli
		*SEEK PackingSlip.SOItem IN Sales ORDER TAG SOItem
		*SEEK PackingSlip.SOItem IN AllQuotes ORDER AQ_SOItm
		*SEEK VAL(LEFT(PackingSlip.SOItem,8)) IN Sales_No ORDER TAG SalesNum
		*SEEK PackingSlip_NO.PackingSli IN Lading ORDER TAG PackingSli
		
		*ThisFormSet.SeekSoldCodeInSoldAddr(PackingSlip_NO.SoldCode)
		*ThisFormSet.SeekShipCodeInShipAddr(PackingSlip_NO.ShipCode)
		*ThisFormSet.SeekPackingSliInPackingSlip(PackingSlip_NO.PackingSli)
		*ThisFormSet.SeekSOitemInSales(PackingSlip.SOitem)
		*ThisFormSet.SeekSOitemInAllQuotes(PackingSlip.SOitem)
		*ThisFormSet.SeekSalesNumInSales_No(VAL(LEFT(PackingSlip.SOItem,8)))
		
		*ThisFormSet.SeekPackingSliInPackingSlip(PackingSlip_NO.PackingSli)
		WAIT CLEAR
		
	ENDPROC

