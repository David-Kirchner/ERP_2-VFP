	PROCEDURE frmPackingSlipHistory.cmdDue.Click
		
		WAIT WINDOW 'Please wait while selecting records.' NOWAIT
		SELECT Ship
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('Ship')
			SELECT Ship
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * FROM dbo.Ship WITH(NOLOCK) WHERE "
		cSQL = cSQL + " ShipDate IS NULL OR "
		cSQL = cSQL + " shipdate = '1999-12-30'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Ship')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Ship')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Ship")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Ship")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Ship')
		ENDIF
		
		
		*SET DELETED ON
		IF FILE('Reports\ShipOrdersDue.frx')
			REPORT FORM Reports\ShipOrdersDue PREVIEW FOR ISNULL(Ship.shipdate)
			*AND NOT EMPTY(Ship.duedate) AND Ship.duedate <= DATE()
		ELSE
			IF FILE('Quotes\Reports\ShipOrdersDue.frx')
				REPORT FORM Quotes\Reports\ShipOrdersDue PREVIEW FOR ISNULL(Ship.shipdate)
				*AND NOT EMPTY(Ship.duedate) AND Ship.duedate <= DATE()
			ENDIF
		ENDIF
		SET DELETED OFF
		*WAIT CLEAR
	ENDPROC

	PROCEDURE frmPackingSlipHistory.cmdEmailPS.Click
		nPS_NO = PackingSlip_NO.PackingSli
		SET DELETED ON
		
		*SELECT PackingSlipItem
		* SEEK ThisFormSet.frmPackingSlipHistory.SoldAddr ORDER TAG SoldCode IN SoldAddr
		* SEEK ThisFormSet.frmPackingSlipHistory.ShipAddr ORDER TAG ShipCode IN ShipAddr
		* SEEK ThisFormSet.frmPackingSlipHistory.Bill3Addr ORDER TAG Bill3Addr IN Bill3Addr  &&USE SoldAddr AGAIN ALIAS Bill3Addr 
		ThisFormSet.SeekSoldCodeInSoldAddr(PackingSlip_NO.SoldCode)
		ThisFormSet.SeekShipCodeInShipAddr(PackingSlip_NO.ShipCode)
		ThisFormSet.SeekBill3inSoldAddr(PackingSlip_NO.Bill3Code)
		
		
		SELECT PackingSlip_NO
		SELECT PackingSlip
		
		*IF FILE('PackingSlip_reprint.frx')
		*	REPORT FORM PackingSlip_reprint FOR PackingSlip.PackingSli = nPS_NO TO PRINTER PROMPT NOCONSOLE
		*ENDIF
		
		PRIVATE cEmailAddress, cEmailName, cShipEmail, cSoldEmail 
		cEmailAddress = ALLTRIM(PrepareSQLtxt(AllQuotes.Email,'Email',60))
		cEmailName = ALLTRIM(PrepareSQLtxt(AllQuotes.Name,'Name',25))
		cShipEmail = ALLTRIM(PrepareSQLtxt(ShipAddr.Email,'Email',60))
		cSoldEmail = ALLTRIM(PrepareSQLtxt(SoldAddr.Email,'Email',60))
		
		IF NOT EMPTY(cShipEmail + cSoldEmail)
			IF cEmailAddress<>IIF(EMPTY(cShipEmail),cEmailAddress,cShipEmail) OR cEmailAddress<>IIF(EMPTY(cSoldEmail),cEmailAddress,cSoldEmail)
				PRIVATE cNewEmail
				DO FORM Forms\SelectEmail WITH cEmailAddress ,cEmailName,cShipEmail ,'ShipTo',cSoldEmail,'SoldTo'  TO cNewEmail
				IF EMPTY(cNewEmail)
					lSendEmail = .F.
				ELSE
					cEmailAddress = cNewEmail
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nShipAddr, nBillAddr, cSalesRep, cEmailHPA
		nShipAddr = PrepareSQLnum(PackingSlip_NO.ShipCode,'ShipCode',-3)
		nBillAddr = PrepareSQLnum(PackingSlip_NO.SoldCode,'SoldCode',-3)
		cSalesRep = PrepareSQLtxt(Sales_No.SalesRep,'SalesRep',20)
		IF EMPTY(cSalesRep)
			cSalesRep = SalesRepfromSO(Sales.SalesNum)	
		ENDIF
		cEmailHPA = ALLTRIM( AppSetup_Get_Email( cSalesRep) )
		*Send_HTML_Email(cEmailHPA,'plant.manager@SpaceAlloysUSA.com',cTitle,cBody,pConn,.T.,.T.)	
		*Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, pConn, lQuiet, lNoHeadder)
		
		PRIVATE m.MsgNoteHTML
		m.MsgNoteHTML = CreateHTML_PS_Conf( nPS_NO , cEmailAddress, cEmailHPA, nShipAddr, cSalesRep, nBillAddr  )
		
		PRIVATE m.MsgSubject 
		m.MsgSubject = "HPAlloy PackingSlip #"+ALLTRIM(STR(nPS_NO))
		
		IF MESSAGEBOX("Are you sure want to Email this Packingslip?",4,"Send Email?") = 6
			PRIVATE lQuiet, lNoHeadder
			lQuiet = .F.
			lNoHeadder = .T.  &&already have the Address Header 
			
			Send_HTML_Email(cEmailAddress, cEmailHPA, m.MsgSubject, m.MsgNoteHTML, ThisFormSet.nConnHandle, lQuiet, lNoHeadder )   &&Proc_SQL
		ENDIF
		
		SET DELETED OFF
		
		SELECT PackingSlip
		LOCATE FOR PackingSlip.PackingSli = nPS_NO
		
		ThisFormSet.frmPackingSlipHistory.grdPackingslip_no.SetFocus()
		This.SetFocus()
		
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.cmdExit.Click
		*ThisFormset.frmPackingSlipHistorySearch.Release
		ThisForm.Release
		ThisFormSet.Release
		
	ENDPROC

