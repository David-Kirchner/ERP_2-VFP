	PROCEDURE frmPackingSlipHistorySearch.ogrp_Search_How.InteractiveChange
		*ThisForm.txt_search_text.Value = ""
		ThisForm.txt_search_max.Value  = ""
		
		PRIVATE  nSearch_how
		nSearch_how = This.Value
		
		Do Case
		Case nSearch_how = 1
			*Equals
			ThisForm.txt_search_max.Enabled = .F.
			ThisForm.txt_search_text.SetFocus()
		Case nSearch_how = 2
			*Contains
			ThisForm.txt_search_max.Enabled = .F.
			ThisForm.txt_search_text.SetFocus()
		Case nSearch_how = 3
			*Between
			ThisForm.txt_search_max.Enabled = .T.
			ThisForm.txt_search_max.SetFocus()
		ENDCASE
		
	ENDPROC

	PROCEDURE frmPackingSlipHistorySearch.ogSales.InteractiveChange
		ThisForm.txt_search_text.Value = ""
		ThisForm.txt_search_max.Value  = ""
		
		DO CASE
