	PROCEDURE uncancelpackingslip
		*UnCancelPackingSlip()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make SQL connection', 16, 'SQL Connect Error')
			RETURN
		ENDIF
		
		PRIVATE lNeed2Ship
		lNeed2Ship = MESSAGEBOX("Will this SO item still need to be Shipped?"+CHR(13)+"Should the 'COMPLETE' mark be unchecked?",4+32,"Mark item as incomplete?") = 6
		
		PRIVATE nPackingSli, pcSOitem
		nPackingSli = PackingSlip.PackingSli
		
		*SELECT UNIQUE SOitem FROM PackingSlip WHERE PackingSlip.PackingSli = nPackingSli INTO ARRAY aPS_SOitem
		IF USED( 'PS_SOitem' )
			USE IN PS_SOitem
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT DISTINCT SOitem FROM dbo.PackingSlip WITH(NOLOCK) "
		cSQL = cSQl + " WHERE PackingSlip.PackingSli = "+STR(nPackingSli)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PS_SOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PS_SOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PS_SOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PS_SOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'PS_SOitem')
		ENDIF
		PRIVATE nPS_SO_Pcs, cSOitem
		
		IF USED( 'PS_SOitem' )
			IF RECCOUNT('PS_SOitem') > 0
				SELECT SOitem FROM PS_SOitem INTO ARRAY aPS_SOitem	
				USE IN PS_SOitem
		
				FOR I = 1 TO ALEN( aPS_SOitem ,1)
					cSOitem = aPS_SOitem(I)
		
		*			nPS_SO_Pcs = GET_Pcs_soiteminPackingSlip(cSOitem,ThisFormSet.nConnHandle)
					IF Count_SOIteminSales(cSOitem, ThisFormSet.nConnHandle) > 0 Then
						PRIVATE nSOQShip
						nSOQShip = 0
						nSOQShip = Get_QShippedinSales(cSOItem, ThisFormSet.nConnHandle)
		
						PRIVATE cSQLu
						cSQLu = "UPDATE dbo.Sales "
		*				cSQLu = cSQLu +" SET Qshipped = "+STR( nSOQShip + nPS_SO_Pcs )+","
						cSQLu = cSQLu +" SET Qshipped = "+STR( nSOQShip )+","
				*		cSQLu = cSQLu +" shipped = '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate))+"',"
						cSQLu = cSQLu +" cmplt = "+IIF(lNeed2Ship ,'0','1')
						cSQLu = cSQLu +" WHERE Sales.SOItem = dbo.f_ProperSOitem('"+cSOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError( cSQLu, ThisFormSet.nConnHandle,nSQLEXEC,'' )
						ENDIF
		
						IF PrepareSQLlogic(lNeed2Ship,'Complete')
							** Repeat in SOitem_Hrs
							cSQL = "UPDATE dbo.SOitem_Hrs SET "
							cSQL = cSQL + " [Cmplt] = 1"
							cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO 
							ENDIF
							**
						ENDIF
					ENDIF
					*******
					*Check Ship for an existing SO-Item
					PRIVATE nCountShip, nQshipped 
					nCountShip = Count_ShipbySOitem( cSOitem, ThisFormSet.nConnHandle, '' )
					IF nCountShip  > 0 Then
						nQshipped = getQshipped_ShipbySOitem( cSOitem, ThisFormSet.nConnHandle )
		
						cSQL = "UPDATE dbo.Ship SET "
						cSQL = cSQL + " Qshipped = "+STR( nQshipped )
						cSQL = cSQL + ",[COMPLETE] = "+IIF(lNeed2Ship,'0','1')
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
							MESSAGEBOX("ERROR Updating dbo.Ship")
						ENDIF
					ENDIF
					*******
					*Update Sales_Stock
		
					cSQL = "UPDATE dbo.Sales_Stock SET "
					cSQL = cSQL + " PackingSli=0"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					cSQL = cSQL + " AND PackingSli="+STR(nPackingSli)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
						MESSAGEBOX("ERROR Updating dbo.Sales_Stock")
					ENDIF
					
		*************************
					
		*!*				IF lNeed2Ship
		
		*!*					cSQL_Process_U = "UPDATE dbo.StockLst_Process SET Process_ID = 'Shipped' WHERE SOitem ='"+cSOitem+"'"
		
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process_U)
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process_U)
		*!*					ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PS_SOitem")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PS_SOitem")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO 
		*!*	ENDIF
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL_Process_U, ThisFormSet.nConnHandle,nSQLEXEC,'')
		*!*						MESSAGEBOX("ERROR Updating SQL StockLst process")
		*!*					ENDIF
		*!*				ENDIF
		
		
				NEXT I
			ENDIF
		ENDIF
		
		****************
		
		cSQL = "UPDATE dbo.Sales_PS SET "
		cSQL = cSQL + " Cncld = 0"
		cSQL = cSQL + " WHERE PackingSli = "+STR(nPackingSli )
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO 
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
			MESSAGEBOX("ERROR Updating Ship")
		ENDIF
		
		**************
		*UPDATE PackingSlip SET Cancld = .F. WHERE PackingSlip.PackingSli = nPackingSli 
		UPDATE_CancldinPackingSlip( .F., nPackingSli, ThisFormSet.nConnHandle)
		**************
	ENDPROC

