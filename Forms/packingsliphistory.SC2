	PROCEDURE frmPackingSlipHistory.pf1.pgShipAddress.cmdSearchShipTo.Click
		PRIVATE matchCodes, nNewShipToCodem, lcCurrTable
		nNewShipToCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		
		PRIVATE cComp
		cComp = THIS.PARENT.txtCompany.VALUE
		IF EMPTY(cComp)
			cComp = AllQuotes.Company
		ENDIF
		
		DO FORM Forms\SearchForm WITH "ShipAddr",cComp TO nNewShipToCode
		*DO FORM SearchForm WITH "ShipAddr",Quotes.company TO nNewShipToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		ENDIF
		
		IF nNewShipToCode > 0 AND MESSAGEBOX("Are you sure you want to use this new address?",4,"Replacing old address.")=6
		*	DIMENSION aShipAddr(1,1)
		*	SELECT ShipCode,Company,Addr1,Addr2,City,ST,Zip,Country,Contact,Telephone,Fax_Number,Email,LastEdit,shiproute,instrct 
		*	FROM HPA!ShipAddr INTO ARRAY aShipAddr WHERE ShipAddr.ShipCode = nNewShipToCode
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE ShipCode = "+STR(nNewShipToCode)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aShipAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'aShipAddr')
			ENDIF
					
			IF USED('aShipAddr')
				IF VARTYPE( aShipAddr.ShipCode ) = 'N'
					
					*save current Packing slip ID
					PRIVATE nID_PackingSlip
					nID_PackingSlip = PackingSlip_NO.PackingSli
					
					IF aShipAddr.ShipCode > 0	
						PRIVATE cSQL
						cSQL = "UPDATE dbo.PackingSlip_No SET "
						cSQL = cSQL + " ShipCode = "+STR(aShipAddr.ShipCode)
						cSQL = cSQL + " WHERE PackingSli ="+STR(nID_PackingSlip)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
						ELSE
							WAIT WINDOW 'Updated!' NOWAIT
							TrackMess("UPDATE dbo.PackingSlip ShipCode WHERE ID_PackingSlip="+STR(nID_PackingSlip) )
							
							ThisFormSet.LoadPackingSlip_NoAll("RELOAD")
											
							SELECT PackingSlip_No
							LOCATE FOR PackingSli = nID_PackingSlip
							IF FOUND('PackingSlip_No')
								ThisFormSet.SeekPackingSliInPackingSlip( nID_PackingSlip )	
								ThisFormSet.seekshipcodeinshipaddr(nNewShipToCode)
							ENDIF
						ENDIF
					ENDIF
					
					This.Parent.txtShipCode.Value = aShipAddr.ShipCode
					This.Parent.txtCompany.Value = aShipAddr.Company
					This.Parent.txtAddr1.Value = aShipAddr.Addr1
					This.Parent.txtAddr2.Value = aShipAddr.Addr2
					This.Parent.txtCity.Value = aShipAddr.City
					This.Parent.txtST.Value = aShipAddr.ST
					This.Parent.txtZip.Value = aShipAddr.Zip
					This.Parent.txtCountry.Value = aShipAddr.Country
					This.Parent.txtContact.Value = aShipAddr.Contact
					This.Parent.txtTelephone.Value = aShipAddr.Telephone
					This.Parent.txtFax_Number.Value = aShipAddr.Fax_Number
					This.Parent.txtEmail.Value = aShipAddr.Email
					This.Parent.txtLastEdit.Value = CTOD(DTOC(aShipAddr.LastEdit))
				ENDIF
				
				USE IN aShipAddr
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgSoldAddress.cmdSearchSoldTo.Click
		Private matchCodes, nNewSoldToCode, lcCurrTable 
		nNewSoldToCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		
		PRIVATE cComp
		cComp = THIS.PARENT.txtCompany.VALUE
		IF EMPTY(cComp)
			cComp = AllQuotes.Company
		ENDIF
		
		DO FORM Forms\SearchForm WITH "SoldAddr",cComp  TO nNewSoldToCode
		*DO FORM SearchForm WITH "SoldAddr",Quotes.company  TO nNewSoldToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nNewSoldToCode > 0 AND MESSAGEBOX("Are you sure you want to use this new address?",4,"Replacing old address.")=6
		*	DIMENSION aSoldAddr(1,1)
		*	SELECT SoldCode,Company,Addr1,Addr2,City,ST,Zip,Country,Contact,Telephone,Fax_Number,Email,LastEdit ;
		*		FROM HPA!SoldAddr ;
		*		INTO ARRAY aSoldAddr ;
		*		WHERE SoldAddr.SoldCode = nNewSoldToCode
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
			cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nNewSoldToCode)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'aSoldAddr')
			ENDIF
			
			IF USED( 'aSoldAddr' )
				IF VARTYPE(aSoldAddr.SoldCode) = 'N'
				
					IF aSoldAddr.SoldCode > 0
						*Save to Packingslip_No
						PRIVATE nID_PackingSlip
						nID_PackingSlip = PackingSlip_NO.PackingSli
		
						cSQL = "UPDATE dbo.PackingSlip_No Set SoldCode = "+STR(nNewSoldToCode)
						cSQL = cSQl + " WHERE PackingSli = "++STR(nID_PackingSlip)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO 
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
						ELSE
							WAIT WINDOW 'Updated!' NOWAIT
							TrackMess("UPDATE dbo.PackingSlip SoldCode WHERE ID_PackingSlip="+STR(nID_PackingSlip) )
							
							ThisFormSet.LoadPackingSlip_NoAll("RELOAD")
											
							SELECT PackingSlip_No
							LOCATE FOR PackingSli = nID_PackingSlip
							IF FOUND('PackingSlip_No')
								ThisFormSet.SeekPackingSliInPackingSlip( nID_PackingSlip )	
								ThisFormSet.SeekSoldCodeinSoldAddr(nNewSoldToCode)
							ENDIF
						ENDIF				
					ENDIF
		
					*ThisFormSet.SoldAddr = aSoldAddr.SoldCode
					*packingslip_no.SoldCode = aSoldAddr.SoldCode
					
					THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
					THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
					THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
					THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
					THIS.PARENT.txtCity.VALUE = aSoldAddr.City
					THIS.PARENT.txtST.VALUE = aSoldAddr.ST
					THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
					THIS.PARENT.txtCountry.VALUE = aSoldAddr.Country
					THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
					THIS.PARENT.txtTelephone.VALUE = aSoldAddr.Telephone
					THIS.PARENT.txtFax_number.VALUE = aSoldAddr.Fax_number
					THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
					THIS.PARENT.txtLastEdit.VALUE = CTOD(DTOC(aSoldAddr.LastEdit))
				ENDIF
		
				USE IN aSoldAddr
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPackingSlipHistorySearch.cmbTables.InteractiveChange
		ThisForm.ogPackingSlip.Visible = .F.
		ThisForm.ogPackingSlip_No.Visible = .F.
		ThisForm.ogSoldAddr.Visible = .F.
		ThisForm.ogShipAddr.Visible = .F.
		ThisForm.ogAllQuotes.Visible = .F.
		ThisForm.ogSales.Visible = .F.
		
		*PackingSlip,PackingSlip Number,Sold Address,Ship Address,Sales,All Quotes
		
		ThisForm.txt_search_text.Value = ""
		ThisForm.txt_search_max.Value  = ""
		
		
		**Also Sets Default Mask!, Check Interactive Change for Each og
		DO CASE
		CASE This.Value = "PackingSlip Number"
			ThisForm.ogPackingSlip_No.Visible = .T.
			*PackingSli
			ThisForm.txt_search_text.InputMask = "99999999"
			ThisForm.txt_search_max.InputMask  = "99999999"
		CASE This.Value = "PackingSlip"
			ThisForm.ogPackingSlip.Visible = .T.
			*Heat
			ThisForm.txt_search_text.InputMask = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			ThisForm.txt_search_max.InputMask  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
		CASE This.Value = "Sold Address"
			ThisForm.ogSoldAddr.Visible = .T.
			*Company
			ThisForm.txt_search_text.InputMask = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			ThisForm.txt_search_max.InputMask  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
		CASE This.Value = "Ship Address"
			ThisForm.ogShipAddr.Visible = .T.
			*Company
			ThisForm.txt_search_text.InputMask = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			ThisForm.txt_search_max.InputMask  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
		CASE This.Value = "All Quotes"
			ThisForm.ogAllQuotes.Visible = .T.
			*Company
			ThisForm.txt_search_text.InputMask = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			ThisForm.txt_search_max.InputMask  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
		CASE This.Value = "Sales"
			ThisForm.ogSales.Visible = .T.
			*SalesNum
			ThisForm.txt_search_text.InputMask = "999999"
			ThisForm.txt_search_max.InputMask  = "999999"
		ENDCASE
	ENDPROC

	PROCEDURE frmPackingSlipHistorySearch.cmdAddAnd.Click
		PRIVATE cSQL_Add, cSQL_where 
		cSQL_where = ThisFormSet.GetSQL_where( )
		IF LEN(cSQL_where) = 0
			RETURN .F.
		ENDIF
		
		cSQL_Add = " AND " + cSQL_where 
		
		ThisForm.edtHoldAnd.Value = ThisForm.edtHoldAnd.Value + cSQL_Add 
		ThisForm.txt_search_text.Value = ''
		ThisForm.txt_search_max.Value = ''
		
		ThisFormSet.UseHoldAnd = .T.
	ENDPROC

