	PROCEDURE frmPackingSlipHistory.pf1.pgItems.txtPo_num.DblClick
		PRIVATE loIE, nPO
		nPO = PrepareSQLnum(This.Value,'HPAPO',-3)
		IF nPO > 0
		*	loIE.Navigate(get_Report_Server()+"%2fHPA+Purchasing+Reports%2fPurchaseOrders&rs:Command=Render&hpapo="+ALLTRIM(STR(nPO)) )
		
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_PO(nPO,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgLading.cmdReprintLading.Click
		PRIVATE nPackingSli
		nPackingSli = lading.packingsli
		
		IF VARTYPE(plBOLWindfall) = 'U'
			PUBLIC plBOLWindfall
			plBOLWindfall = .F.
		ENDIF
		*!*	IF MESSAGEBOX("Will this BoL be from Windfall?"+CHR(13)+"Answer No to be from Tipton.",4+32,"BoL from Windfall?") = 6
		*!*		plBOLWindfall = .T.
		*!*	ELSE
		*!*		plBOLWindfall = .F.
		*!*	ENDIF		
		
		
		
		IF !EMPTY(nPackingSli)
			****
		*	SELECT Bill3Addr
		*	SEEK Bil3Code ORDER TAG Bill3Addr IN Bill3Addr  &&USE SoldAddr AGAIN ALIAS Bill3Addr
			IF USED('Bill3Addr')
				SELECT Bill3Addr
			ELSE
				SELECT 0
			ENDIF
		
			cSQL="SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
			
			IF This.parent.txtBil3code.Value = 0
				cSQL = cSQL + " WHERE 0>0"
			ELSE
				cSQL = cSQL + " WHERE SoldCode = "+STR(This.parent.txtBil3code.Value)
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Bill3Addr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Bill3Addr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'Bill3Addr')
			ENDIF
			*****
			
			SELECT Lading
			REPORT FORM Reports\BillofLading FOR PackingSli = nPackingSli TO PRINTER PROMPT NOCONSOLE
			
			*SEEK nPackingSli IN Lading ORDER TAG PackingSli
			GO TOP IN Lading
		
			IF USED('Bill3Addr')
				USE IN Bill3Addr
			ENDIF
		ENDIF
		
		
		RELEASE plBOLWindfall
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgPackingSlip_NO.cmdAbort.Click
		*pg_PackingSlip_No
		ThisForm.grdPackingslip_no.Enabled = .T.
		ThisForm.grdPackingslip.Enabled = .T.
		
		This.parent.txtPackedBy.enabled = .F.
		This.parent.txtCheckedBy.enabled = .F.
		This.parent.txtBox_Size.enabled = .F.
		This.parent.txtCarton.enabled = .F.
		This.parent.txtPS_Date.enabled = .F.
		This.parent.txtPickUpDate.enabled = .F.
		This.parent.txtShippedVia.enabled = .F.
		This.parent.txtShipFrom.enabled = .F.
		
		This.parent.txtTracking.enabled = .F.
		This.parent.txtPackedWeight.Enabled = .T.
		This.parent.txtTotalWeight.enabled = .F.
		This.parent.chkKG.enabled = .F.
		This.parent.chkCOD.enabled = .F.
		This.parent.txtCodcheck.enabled = .F.
		This.parent.txtCodfreightfee.enabled = .F.
		This.parent.txtFreightcharge.enabled = .F.
		This.parent.txtDutyTax.enabled = .F.
		
		*This.parent.txtPO_Num.ControlSource = 'packingslip.PO_Num'
		
		
		This.Parent.cmdEdit.Visible = .T.
		This.Parent.cmdEdit.Caption = "Edit"
		This.Visible = .F.
		
		ThisFormSet.Show_cmd_buttons(.T.)	
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgPackingSlip_NO.cmdEdit.Click
		*pgPackingSlip_No
		IF NOT HavePermission('PackingSlip Edit')
			MESSAGEBOX("You are not permited to Edit here!",0,"No Edit")
			RETURN .F.
		ENDIF
		
		IF This.Caption = "Edit"
			*Place in Edit Mode
			
			ThisForm.grdPackingslip_no.Enabled = .F.
			ThisForm.grdPackingslip.Enabled = .F.
		
		
			This.parent.txtPackedBy.enabled = .T.
			This.parent.txtCheckedBy.enabled = .T.
			This.parent.txtBox_Size.enabled = .T.
			This.parent.txtCarton.enabled = .T.
			This.parent.txtPS_Date.enabled = .T.
			This.parent.txtPickUpDate.enabled = .T.
			This.parent.txtShippedVia.enabled = .T.
			This.parent.txtShipFrom.enabled = .T.
			
			This.parent.txtTracking.enabled = .T.
			This.parent.txtPackedWeight.Enabled = .T.
			This.parent.txtTotalWeight.enabled = .T.
			This.parent.chkKG.enabled = .T.
			This.parent.chkCOD.enabled = .T.
			This.parent.txtCodcheck.enabled = .T.
			This.parent.txtCodfreightfee.enabled = .T.
			This.parent.txtFreightcharge.enabled = .T.
			This.parent.txtDutyTax.enabled = .T.
		
			This.Parent.cmdPickUpNow.Visible = .F.
			This.parent.cmdAbort.Visible = .T.
		
			ThisFormSet.Show_cmd_buttons(.F.)	
			
			This.Caption = "Save"
		ELSE
			*Save
			PRIVATE nPackingSli
			nPackingSli	= PrepareSQLnum(packingslip_no.PackingSli,'PackingSli',-3)
			
			PRIVATE dPS_Date, cPackedBy, cCheckeBy, cCarton, nTotalPackedWeight, cTotalWeight, lKg 
			PRIVATE cShippedVia, cShipFrom, cTracking, nFreightCharge, nDutyTax
			PRIVATE lCOD ,nCODCheck, nCODfreightFee, cBox_Size, nPackedWeight
			
			
			cCheckeBy	= PrepareSQLtxt(This.parent.txtPackedBy.Value,'PackedBy',10)
			cPackedBy	= PrepareSQLtxt(This.parent.txtCheckedBy.Value,'CheckedBy',10)
			cBox_Size	= PrepareSQLtxt(This.parent.txtBox_Size.Value,'Box_Size',60)
			cCarton		= PrepareSQLtxt(This.parent.txtCarton.Value,'Carton',10)
			dPS_Date 	= PrepareSQLdate(This.parent.txtPS_Date.Value,'PS_Date')
			dPickUpDate	= PrepareSQLdate(This.parent.txtPickUpDate.Value,'PickUpDate')
			cShippedVia	= PrepareSQLtxt(This.parent.txtShippedVia.Value,'ShippedVia',20)
			cShipFrom	= PrepareSQLtxt(This.parent.txtShipFrom.Value,'ShipFrom',20)
			
			cTracking	= PrepareSQLtxt(This.parent.txtTracking.Value,'Tracking',50)
			nTotalPackedWeight	= PrepareSQLnum(This.parent.txtPackedWeight.Value,'PackedWeigth',-3)
			cTotalWeight	= PrepareSQLtxt(This.parent.txtTotalWeight.Value,'TotalWeight',10)
			lKg			= PrepareSQLlogic(This.parent.chkKG.Value,'KG')
			lCOD		= PrepareSQLlogic(This.Parent.chkCOD.Value,'COD')
			nCODCheck	= PrepareSQLnum(This.parent.txtCodCheck.Value,'CODcheck',1,0)
			nCODfreightFee	= PrepareSQLnum(This.parent.txtCodfreightfee.Value,'CODfreightFee',1,0)
			nFreightCharge	= PrepareSQLnum(This.parent.txtFreightcharge.Value,'FreightCharge',1,0)
			nDutyTax	= PrepareSQLnum(This.parent.txtDutyTax.Value,'DutyTax',1,0)
		
		
			
			IF nPackingSli> 0
				PRIVATE cSQL
				cSQL = "UPDATE dbo.PackingSlip_No SET "
				*cSQL = cSQL + " PS_Date='"+TTOC(dPS_Date)+"'"
				cSQL = cSQL + " PS_Date='"+IIF(dPS_Date=CTOT("  /  /  "),'',TTOC(dPS_Date))+"'"
				cSQL = cSQL + ",PackedBy='"+cPackedBy+"'"
				cSQL = cSQL + ",CheckedBy='"+cCheckeBy+"'"
				cSQL = cSQL + ",Carton='"+cCarton+"'"
				cSQL = cSQL + ",TotalWeight='"+cTotalWeight+"'"
				cSQL = cSQL + ",KG="+ IIF(lKg,'1','0')
				cSQL = cSQL + ",ShippedVia='"+cShippedVia+"'"
				
				cSQL = cSQL + ",ShipFrom='"+cShipFrom+"'"
				*cSQL = cSQL + ",PickUpDate='"+TTOC(dPickUpDate)+"'"
				cSQL = cSQL + ",PickUpDate='"+IIF(dPickUpDate=CTOT("  /  /  "),'',TTOC(dPickUpDate))+"'"
				cSQL = cSQL + ",Tracking='"+ cTracking +"'"
				cSQL = cSQL + ",FreightCharge="+STR(nFreightCharge,1,0)
				cSQL = cSQL + ",DutyTax="+ STR(nDutyTax,1,0)
				cSQL = cSQL + ",COD="+ IIF(lCOD,'1','0')
				cSQL = cSQL + ",CODcheck="+ STR(nCODCheck,1,0)
				cSQL = cSQL + ",CODfreightFee="+ STR(nCODfreightFee,1,0)
				cSQL = cSQL + ",Box_Size='"+cBox_Size+"'"
				cSQL = cSQL + ",PackedWeight="+STR(nTotalPackedWeight,10,0)
				
				cSQL = cSQL + " WHERE PackingSli ="+STR(nPackingSli)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO 
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Updated!' NOWAIT
					TrackMess("UPDATE dbo.PackingSlip_No WHERE PackingSli="+STR(nPackingSli) )
					
					*SELECT PackingSlip
					*LOCATE FOR ID_PackingSlip = nID_PackingSlip
					*IF FOUND('PackingSlip')
					*	REPLACE PO_Num WITH cPO_Num
					*	REPLACE Alloy WITH cAlloy
					*	REPLACE Heat WITH cHeat
					*	REPLACE Lott WITH cLot
					*	REPLACE Pcs WITH nPcs
					*	REPLACE Descript WITH cDescript
					*	REPLACE Weight WITH nWeight
						WAIT WINDOW "Ready for reprint" NOWAIT
					*ENDIF
				ENDIF
				
			ELSE
				MESSAGEBOX("Did not get the PackingSlip Number",0,"No save")
			ENDIF
			
			
			ThisForm.grdPackingslip_no.Enabled = .T.
			ThisForm.grdPackingslip.Enabled = .T.
		
			This.parent.txtPackedBy.enabled = .F.
			This.parent.txtCheckedBy.enabled = .F.
			This.parent.txtBox_Size.enabled = .F.
			This.parent.txtCarton.enabled = .F.
			This.parent.txtPS_Date.enabled = .F.
			This.parent.txtPickUpDate.enabled = .F.
			This.parent.txtShippedVia.enabled = .F.
			This.parent.txtShipFrom.enabled = .F.
			
			This.parent.txtTracking.enabled = .F.
			This.parent.txtPackedWeight.Enabled = .T.
			This.parent.txtTotalWeight.enabled = .F.
			This.parent.chkKG.enabled = .F.
			This.parent.chkCOD.enabled = .F.
			This.parent.txtCodcheck.enabled = .F.
			This.parent.txtCodfreightfee.enabled = .F.
			This.parent.txtFreightcharge.enabled = .F.
			This.parent.txtDutyTax.enabled = .F.
			
			
			IF nPackingSli> 0
				PRIVATE cSOitem
				cSOitem = PrepareSQLtxt(Ship.SOitem,'SOitem',10)
				
				IF MESSAGEBOX("Do you also want to update the ShipVia "+CHR(13)+"in the Ship table"+CHR(13)+"for the SOitem "+cSOitem,4+32,"Changed ShipVia") = 6
					
					cSQL = "UPDATE dbo.Ship SET "
					cSQL = cSQL + " ShipVia='"+cShippedVia+"'"
					cSQL = cSQL + " WHERE SOitem = '"+cSOitem +"'"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO 
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ELSE
						SELECT Ship
						REPLACE ShipVia WITH cShippedVia
						ThisForm.pf1.pgShip.txtShipVia.Value = cShippedVia
						
					ENDIF	
					
					
				ENDIF
			ENDIF
			
			
			
			
			This.Parent.cmdPickUpNow.Visible = .T.
			This.parent.cmdAbort.Visible = .F.
			This.Caption = "Edit"
			
			ThisFormSet.Show_cmd_buttons(.T.)
			
		ENDIF
		
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgPackingSlip_NO.cmdPickUpNow.Click
		PRIVATE dPickUpDate, nPackingSlipNo
		dPickUpDate		= PrepareSQLDate(This.parent.txtPickUpDate.Value,'PickUpDate')
		nPackingSlipNo	= PrepareSQLnum(This.parent.txtPackingsli.Value,'PackingSli',-3)
		
		IF nPackingSlipNo > 0
			IF EMPTY(dPickUpDate)
				IF PackingSlipPickUp(nPackingSlipNo,ThisFormSet.nConnHandle)
					*UPDATE packingslip_No SET PickUpDate = DATETIME() WHERE PackingSli = nPackingSlipNo
					ThisFormSet.LoadPackingSlip_NoAll(.T.)
					
					SELECT PackingSlip_No
					LOCATE FOR PackingSli = nPackingSlipNo
					IF FOUND('PackingSlip_No')
						ThisFormSet.SeekPackingSliInPackingSlip( nPackingSlipNo )	
						*ThisFormSet.SeekSoldCodeinSoldAddr(nNewSoldToCode)
					ENDIF
		
					This.parent.parent.pgItems.txtPickUpDate.Refresh
					This.parent.txtPickUpDate.Refresh
				ENDIF
			ELSE
				IF MESSAGEBOX("This item has already been scanned as 'PickedUp'"+CHR(13)+CHR(13)+"Do you want to replace with a new PickUp sateTime?",4+64,"Already marked.") = 6
					*Update dPickUpDate
					IF PackingSlipPickUp(nPackingSlipNo,ThisFormSet.nConnHandle)
						TrackMess( "PackingSlip#"+ALLTRIM(STR(nPackingSlipNo))+" was updated!"+CHR(13)+"Old date was '"+TTOC(dPickUpDate)+"'")
						*UPDATE packingslip_No SET PickUpDate = DATETIME() WHERE PackingSli = nPackingSlipNo
						This.parent.parent.pgItems.txtPickUpDate.Refresh
						This.parent.txtPickUpDate.Refresh
					ENDIF
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Lost Packing Slip Number",0,"Error")
		ENDIF
	ENDPROC

	PROCEDURE frmPackingSlipHistory.pf1.pgPackingSlip_NO.cmdTrackingBrowser.Click
		PRIVATE cText
		PRIVATE cShipVia, cTracking, cShipFrom
		
		cShipVia = ALLTRIM(UPPER(This.Parent.txtShippedvia.Value))
		cTracking = ALLTRIM( This.Parent.txtTracking.Value )
		cShipFrom = ALLTRIM( This.Parent.txtShipFrom.Value )
		
		DO CASE
		**http://verysimple.com/2011/07/06/ups-tracking-url/
		CASE "FED" $ cShipVia AND "EX" $ cShipVia
		*	cText = "http://www.fedex.com/cgi-bin/tracking?action=track&language=english&last_action=alttrack&ascend_header=1&cntry_code=us&initial=x&mps=y&tracknumbers="
			cText = "http://www.fedex.com/Tracking?action=track&tracknumbers="
			cTracking = PADR(cTracking, 27 )
			cTracking = STRTRAN(cTracking," ","+")
			**"4845+7674+7205++++++++++++"
			cText = cText + cTracking 
		
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		CASE "USPS" $ cShipVia 
			cText = "https://tools.usps.com/go/TrackConfirmAction_input?qtc_tLabels1="
			cText = cText + cTracking 
		
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		CASE "UPS" $ cShipVia 
			*cText = "http://wwwapps.ups.com/WebTracking/processInputRequest?HTMLVersion=5.0&sort_by=status&term_warn=yes&Requester=UPSHome&tracknums_displayed=5&TypeOfInquiryNumber=T&loc=en_US&InquiryNumber1="
			cText = "http://wwwapps.ups.com/WebTracking/track?track=yes&trackNums="
			cText = cText + cTracking 
			*cText = cText + "&InquiryNumber2=&InquiryNumber3=&InquiryNumber4=&InquiryNumber5=&AgreeToTermsAndConditions=yes&track.x=40&track.y=4"
		
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		CASE "DHL " $ cShipVia
			cText = "http://track.dhl-usa.com/TrackByNbr.asp?ShipmentNumber="  &&US
			cText = "http://webtrack.dhlglobalmail.com/?mobile=&trackingnumber="  &&Global
			cText = cText + cTracking
			
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		CASE "CONWAY " $ cShipVia
			cText = "https://www.con-way.com/webapp/manifestrpts_p_app/shipmentTracking.do?PRO="
			cText = cText + cTracking
			
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		CASE "CCX " $ cShipVia
			cText = "https://www.con-way.com/webapp/manifestrpts_p_app/shipmentTracking.do?PRO="
			cText = cText + cTracking
			
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		CASE "ROADWAY" $ cShipVia
			cText = "http://www.quiktrak.roadway.com/cgi-bin/quiktrak?type=0&pro0="
			cText = cText + cTracking
			
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		
		CASE "EMERY" $ cShipVia
			cText = "http://www.emeryworld.com/eww/emeryapplications/tracking/trackformaction.asp?&pro1="
			cText = cText + LEFT(cTracking,10)
			
			PRIVATE loHyperlink 
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cText)
			RELEASE loHyperlink 
		
		OTHERWISE
			MESSAGEBOX("Unkown Shipper")
		ENDCASE
	ENDPROC

