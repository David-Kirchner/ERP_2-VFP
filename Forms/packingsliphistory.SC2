	PROCEDURE frmPackingSlipHistory.pf1.pgSales_No.chkcmplt.Click
		*!*	SELECT Count(*) FROM HPA!Ship WHERE Ship.SOItem = Sales.SOItem INTO ARRAY aCountShip
		*!*	IF aCountShip(1) > 0
		*!*	UPDATE HPA!Ship ;
		*!*		SET Ship.complete = Sales.cmplt ;
		*!*		WHERE Ship.SOItem = Sales.SOItem
		*!*	ENDIF
		PRIVATE nCountShip 
		nCountShip = Count_ShipbySOitem( Sales.SOItem, ThisFormSet.nConnHandle, '' )
		
		IF nCountShip  > 0
		*!*		UPDATE HPA!Ship ;
		*!*			SET Ship.complete = Sales.cmplt ;
		*!*			WHERE Ship.SOItem = Sales.SOItem
			cSQL = "UPDATE dbo.Ship SET "
			cSQL = cSQL + "[COMPLETE] = "+IIF(Sales.cmplt,'1','0')
			cSQL = cSQL + "WHERE SOitem = dbo.f_ProperSOitem('"+Sales.SOItem+"')"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO 
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
				MESSAGEBOX("ERROR Updating Ship")
			ENDIF	
		ELSE
			*Not in Ship table!!
		ENDIF
	ENDPROC

